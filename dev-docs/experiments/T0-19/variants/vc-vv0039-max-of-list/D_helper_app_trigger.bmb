#[summary("t019 variant")]
mod tasks {
spec fn at(lst: &[i64], i: usize, r: i64) -> bool { i < lst.len() && lst[i] == r }
#[uses(at)]
spec fn contains(lst: &[i64], r: i64) -> bool { !(forall|i: usize| !#[trigger] at(lst, i, r)) }
spec fn ge_all(lst: &[i64], r: i64) -> bool { forall|j: usize| j < lst.len() ==> #[trigger] lst[j] <= r }
spec fn upto(lst: &[i64], m: i64, p: usize, n: usize) -> bool { p < n && lst[p] == m && (forall|j: usize| j < n ==> #[trigger] lst[j] <= m) }
spec fn nonempty(lst: &[i64]) -> bool { lst.len() > 0 }
#[effects(pure)]
#[uses(at, contains, ge_all, nonempty, upto)]
fn max_of_list(lst: &[i64]) -> (r: i64)
    requires nonempty(lst),
    ensures contains(lst, r), ge_all(lst, r),
{
    let mut m: i64 = lst[0];
    let mut p: usize = 0;
    let mut i: usize = 1;
    while i < lst.len()
        invariant 1 <= i, i <= lst.len(), upto(lst, m, p, i),
        decreases lst.len() - i,
    {
        if lst[i] > m {
            m = lst[i];
            p = i;
        }
        i = i + 1;
    }
    m
}
}
