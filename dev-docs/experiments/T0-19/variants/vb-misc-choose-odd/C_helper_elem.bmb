#[summary("t019 variant")]
mod tasks {
spec fn is_odd(x: u64) -> bool { x % 2 == 1 }
#[uses(is_odd)]
spec fn has_odd(v: &[u64]) -> bool { !(forall|q: usize| q < v.len() ==> !is_odd(#[trigger] v[q])) }
#[uses(is_odd)]
spec fn even_below(v: &[u64], n: usize) -> bool { forall|q: usize| q < n ==> !is_odd(#[trigger] v[q]) }
spec fn valid(v: &[u64], r: usize) -> bool { r < v.len() }
#[effects(pure)]
#[uses(even_below, has_odd, is_odd, valid)]
fn choose_odd(v: &[u64]) -> (r: usize)
    requires has_odd(v),
    ensures valid(v, r),
{
    let mut j: usize = 0;
    while j < v.len() && v[j] % 2 != 1
        invariant j <= v.len(), has_odd(v), even_below(v, j),
        decreases v.len() - j,
    {
        j = j + 1;
    }
    j
}
}
