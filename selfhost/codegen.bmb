#[summary("코드 생성 (stage0 compiler/src/codegen.rs의 포트, 백로그 4D-05). 전체 검사 모드: 증명된 의무가 없다고 보고 검사를 모두 남긴다. 타입의 배치와 LLVM 타입 정의 (4D-05b), 스칼라 프로그램 (4D-05c), 스칼라 원소의 배열과 슬라이스 (4D-05d1). 옮기지 않은 구문은 Gen.todo에 까닭을 남긴다. 타입은 낮춘 것이다 (lowered). 타입을 걷는 함수의 f는 남은 깊이다 (ADR-0140)")]
mod codegen {
    #[summary("배열이나 슬라이스인 지역 이름의 자리 (stage0 Slot::Arr): 첫 원소의 주소, 길이의 글, 원소 종류, 원소 타입")]
    struct ArrSlot { ptr: String, len: String, elem: String, ety: ast::TypeKind }

    #[summary("스칼라 참조 인자의 임시 자리를 호출 뒤에 원소로 되돌려 쓸 곳 (stage0 Back::Elem): 임시 자리, 원소 종류, 원소의 주소, 레지스터 타입")]
    struct Back { tmp: String, elem: String, ptr: String, lt: String }

    #[summary("식의 값 (stage0 CVal): 레지스터 값이나 상수의 글, 배열이나 슬라이스(첫 원소의 주소와 길이의 글), 단위 값, 끝나지 않는 식의 값")]
    enum CVal { Imm(String), Arr(String, String), Unit, Never }

    #[summary("배열 리터럴의 상수 원소: 부호와 크기")]
    struct ConstElem { neg: bool, mag: u64 }

    #[summary("정수 변환 T::try_from(x)의 대상 타입과 인자")]
    struct Conv { target: ast::IntTy, arg: ast::Expr }

    #[summary("낮출 정의 하나: 경로, 단위, 구문")]
    struct Def { path: String, unit: String, d: ast::FnDef }

    #[summary("원소의 주소와 원소 종류 (stage0 elem_ptr의 결과)")]
    struct ElemPtr { ptr: String, elem: String }

    #[summary("break나 continue가 떠날 수 있는 루프 (stage0 GLoop): 레이블(없으면 빈 글), continue가 가는 곳, break가 가는 곳, loop의 break e가 값을 두는 자리와 그 레지스터 타입")]
    struct GLoop { label: String, head: String, end: String, slot: Option<String>, lt: String }

    #[summary("함수 하나를 낮추는 상태 (stage0 Gen). out은 몸의 글, allocas는 entry의 자리들, tmp와 label은 %tN과 레이블의 번호, slots는 지역 이름의 자리, todo는 아직 옮기지 않은 구문을 만난 까닭들 (비어 있지 않으면 모듈을 내지 않는다), print_f64는 print_f64를 불렀는가 (그 런타임 조각을 모듈에 붙인다), loops는 지금 낮추는 코드를 둘러싼 루프들 (안쪽이 뒤), globals는 이 함수의 상수들이고 consts는 그 줄 수")]
    struct Gen { path: String, base: String, unit: String, out: String, allocas: String, tmp: u32, label: u32, slots: table::Table<Slot>, checks: u32, globals: String, consts: u32, ret: ast::TypeKind, todo: Vec<String>, print_f64: bool, loops: Vec<GLoop> }

    impl Gen {
        #[summary("entry에 ty의 자리를 하나 두고 그 이름을 준다")]
        #[effects(alloc)]
        fn alloca(self: &mut Gen, ty: &str) -> String {
            let p: String = self.t();
            self.allocas.push_str("  ");
            self.allocas.push_str(p.as_str());
            self.allocas.push_str(" = alloca ");
            self.allocas.push_str(ty);
            self.allocas.push_str("\n");
            p
        }

        #[summary("산술 (stage0 arith): 넘침을 재고 넘치면 멈춘다 (전체 검사 모드: 증명된 의무가 없다)")]
        #[effects(alloc)]
        fn arith(self: &mut Gen, inst: &str, a: &str, b: &str, signed: bool) -> CVal {
            let r: String = self.t();
            let s: String = if signed {
                String::from("s")
            } else {
                String::from("u")
            };
            let pair: String = self.t();
            let ovf: String = self.t();
            let ok: String = self.t();
            let mut call: String = types::cat5(pair.as_str(), " = call {i64, i1} @llvm.", s.as_str(), inst, ".with.overflow.i64(i64 ");
            call.push_str(a);
            call.push_str(", i64 ");
            call.push_str(b);
            call.push_str(")");
            self.emit(call.as_str());
            self.emit(types::cat4(ovf.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 1").as_str());
            self.emit(types::cat4(ok.as_str(), " = xor i1 ", ovf.as_str(), ", true").as_str());
            self.check(ok.as_str(), types::cat3("`", inst, "` may overflow").as_str());
            self.emit(types::cat4(r.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 0").as_str());
            CVal::Imm(r)
        }

        #[summary("배열이나 슬라이스인 지역 변수 name의 자리")]
        #[effects(alloc)]
        fn arr_slot(self: &Gen, name: &str) -> Option<ArrSlot> {
            match self.slots.find(name) {
                None => None,
                Some(at) => { match &self.slots.items[at] { Slot::Scalar(as_p, as_t) => None, Slot::Arr(sl) => Some(ArrSlot { ptr: sl.ptr.clone(), len: sl.len.clone(), elem: sl.elem.clone(), ety: sl.ety.clone() }), } },
            }
        }

        #[summary("배열 리터럴과 반복 (stage0 expr의 Array·Repeat): 스칼라 원소의 배열을 entry의 자리에 두고 채운다")]
        #[effects(alloc)]
        fn array_lit(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            match body::array_elem(&ty) {
                None => self.todo_expr("an array literal whose type is not an array", e),
                Some(el) => { if !is_scalar_ty(&el) { return self.todo_expr("an array of values that are not scalars", e); } let elem: String = elem_kind(&el); let n: String = array_len_text(&ty); let ptr: String = self.alloca(types::cat5("[", n.as_str(), " x ", mem(elem.as_str()).as_str(), "]").as_str()); self.init_array(e, ptr.as_str(), elem.as_str(), ck, tb, f - 1); CVal::Arr(ptr, n) },
            }
        }

        #[summary("배열이나 슬라이스의 값 (stage0 array_of). Vec의 원소들은 아직 옮기지 않았다")]
        #[effects(alloc)]
        fn array_of(self: &mut Gen, base: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", base);
            }
            if is_vec(&self.ty(base, tb)) {
                return self.todo_expr("the elements of a `Vec`", base);
            }
            self.expr(base, ck, tb, f - 1)
        }

        #[summary("대입 (stage0 stmt의 Assign): 스칼라 지역 변수, 단위 값의 지역 변수, 배열 지역 변수 전체, 스칼라 원소, 스칼라 참조 매개변수를 지나는 *x")]
        #[effects(alloc)]
        fn assign(self: &mut Gen, a: &ast::Assign, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", a.span);
                return;
            }
            match &a.target.kind {
                ast::ExprKind::Int(as_int0, as_int1) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Float(as_float0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::ByteLit(as_bytelit0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::ByteStr(as_bytestr0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::StrLit(as_strlit0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::CharLit(as_charlit0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Bool(as_bool0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Unit => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Var(id) => { if decls::is_unit(&self.ty(&a.target, tb)) { let unit_v: CVal = self.expr(&a.value, ck, tb, f - 1); return; } match self.arr_slot(id.name.as_str()) { None => {}, Some(asl) => { if is_mem_elem(&asl.ety) { self.todo_at("an assignment to an array of values in memory", a.span); } else { self.init_array(&a.value, asl.ptr.as_str(), asl.elem.as_str(), ck, tb, f - 1); } return; }, } match self.scalar_slot(id.name.as_str()) { None => self.todo_at("an assignment to a local that is not a scalar or an array", a.span), Some(slot) => { let v: String = imm(&self.expr(&a.value, ck, tb, f - 1)); self.emit(types::cat7("store ", slot.ty.as_str(), " ", v.as_str(), ", ptr ", slot.ptr.as_str(), "").as_str()); }, } },
                ast::ExprKind::Call(as_call0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Method(as_method0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Index(ib, ii) => { match var_name(&**ib) { None => self.todo_at("an assignment to an element of a place that is not a local", a.span), Some(bn) => { match self.arr_slot(bn.as_str()) { None => self.todo_at("an assignment to an element of a local that is not an array", a.span), Some(isl) => { if is_mem_elem(&isl.ety) { self.todo_at("an assignment to an element in memory", a.span); } else { let ep: ElemPtr = self.elem_ptr(&a.target, &**ib, &**ii, ck, tb, f - 1); let ev: String = imm(&self.expr(&a.value, ck, tb, f - 1)); self.store_elem(ep.elem.as_str(), ev.as_str(), ep.ptr.as_str()); } }, } }, } },
                ast::ExprKind::Unary(as_unary0, as_unary1) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Binary(as_binary0, as_binary1, as_binary2) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Ref(as_ref0, as_ref1) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::If(as_if0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Block(as_block0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Array(as_array0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Repeat(as_repeat0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Old(as_old0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Quant(as_quant0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Trigger(as_trigger0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Closure(as_closure0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::StructLit(as_structlit0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Path(as_path0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Deref(dx) => { match var_name(&**dx) { None => self.todo_at("an assignment through a place that is not a scalar reference", a.span), Some(dn) => { match self.scalar_slot(dn.as_str()) { None => self.todo_at("an assignment through a reference that is not of a scalar", a.span), Some(dslot) => { let dv: String = imm(&self.expr(&a.value, ck, tb, f - 1)); self.emit(types::cat7("store ", dslot.ty.as_str(), " ", dv.as_str(), ", ptr ", dslot.ptr.as_str(), "").as_str()); }, } }, } },
                ast::ExprKind::Field(as_field0, as_field1) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Match(as_match0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Return(as_return0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Try(as_try0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Loop(as_loop0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Break(as_break0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Continue(as_continue0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Range(as_range0) => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
                ast::ExprKind::Error => self.todo_at("an assignment to a place that is not a local, an element or `*x`", a.span),
            }
        }

        #[summary("이항 연산 (stage0 expr의 Binary 갈래들): 짧은 회로, f64, 정수의 비교·비트·시프트·산술·나눗셈")]
        #[effects(alloc)]
        fn binary(self: &mut Gen, e: &ast::Expr, op: ast::BinOp, l: &ast::Expr, r: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            if is_and(op) || is_or(op) {
                let slot: String = self.alloca("i1");
                let lv: String = imm(&self.expr(l, ck, tb, f - 1));
                self.emit(types::cat4("store i1 ", lv.as_str(), ", ptr ", slot.as_str()).as_str());
                let rhs: String = self.l("rhs");
                let end: String = self.l("sc");
                if is_and(op) {
                    self.emit(types::cat7("br i1 ", lv.as_str(), ", label %", rhs.as_str(), ", label %", end.as_str(), "").as_str());
                } else {
                    self.emit(types::cat7("br i1 ", lv.as_str(), ", label %", end.as_str(), ", label %", rhs.as_str(), "").as_str());
                }
                self.block(rhs.as_str());
                let rv: String = imm(&self.expr(r, ck, tb, f - 1));
                self.emit(types::cat4("store i1 ", rv.as_str(), ", ptr ", slot.as_str()).as_str());
                self.emit(types::cat2("br label %", end.as_str()).as_str());
                self.block(end.as_str());
                let out: String = self.t();
                self.emit(types::cat3(out.as_str(), " = load i1, ptr ", slot.as_str()).as_str());
                return CVal::Imm(out);
            }
            if body::is_cmp(op) && (self.is_text_expr(l, tb) || self.is_text_expr(r, tb)) {
                return self.todo_expr("a comparison of text", e);
            }
            let lt: ast::TypeKind = self.ty(l, tb);
            let a: String = imm(&self.expr(l, ck, tb, f - 1));
            let b: String = imm(&self.expr(r, ck, tb, f - 1));
            if body::is_f64(&lt) {
                let fop: String = float_op(op);
                if fop.len() == 0 {
                    return self.todo_expr("an `f64` operator", e);
                }
                let res: String = self.t();
                self.emit(types::cat7(res.as_str(), " = ", fop.as_str(), " double ", a.as_str(), ", ", b.as_str()).as_str());
                return CVal::Imm(res);
            }
            let signed: bool = is_signed(&lt);
            let ty: String = llty(&lt);
            let c: String = int_cmp(op, signed);
            if c.len() > 0 {
                let cres: String = self.t();
                let mut cl: String = types::cat5(cres.as_str(), " = icmp ", c.as_str(), " ", ty.as_str());
                cl.push_str(" ");
                cl.push_str(a.as_str());
                cl.push_str(", ");
                cl.push_str(b.as_str());
                self.emit(cl.as_str());
                return CVal::Imm(cres);
            }
            if body::is_bit(op) {
                let bres: String = self.t();
                let mut bl: String = types::cat5(bres.as_str(), " = ", bit_inst(op).as_str(), " ", ty.as_str());
                bl.push_str(" ");
                bl.push_str(a.as_str());
                bl.push_str(", ");
                bl.push_str(b.as_str());
                self.emit(bl.as_str());
                return CVal::Imm(bres);
            }
            match body::int_of(&lt) {
                None => self.todo_expr("an operator on a type that is not an integer", e),
                Some(i) => { if body::is_shift(op) { return self.shift(op, i, a.as_str(), r, b.as_str()); } match op { ast::BinOp::Add => { if body::bits(i) < 64 { self.narrow_arith("add", a.as_str(), b.as_str(), i) } else { self.arith("add", a.as_str(), b.as_str(), signed) } }, ast::BinOp::Sub => { if body::bits(i) < 64 { self.narrow_arith("sub", a.as_str(), b.as_str(), i) } else { self.arith("sub", a.as_str(), b.as_str(), signed) } }, ast::BinOp::Mul => { if body::bits(i) < 64 { self.narrow_arith("mul", a.as_str(), b.as_str(), i) } else { self.arith("mul", a.as_str(), b.as_str(), signed) } }, ast::BinOp::Div => self.div_rem(true, i, a.as_str(), b.as_str()), ast::BinOp::Rem => self.div_rem(false, i, a.as_str(), b.as_str()), ast::BinOp::Eq => self.todo_expr("an operator outside executable code", e), ast::BinOp::Ne => self.todo_expr("an operator outside executable code", e), ast::BinOp::Lt => self.todo_expr("an operator outside executable code", e), ast::BinOp::Le => self.todo_expr("an operator outside executable code", e), ast::BinOp::Gt => self.todo_expr("an operator outside executable code", e), ast::BinOp::Ge => self.todo_expr("an operator outside executable code", e), ast::BinOp::And => self.todo_expr("an operator outside executable code", e), ast::BinOp::Or => self.todo_expr("an operator outside executable code", e), ast::BinOp::Implies => self.todo_expr("an operator outside executable code", e), ast::BinOp::BitAnd => self.todo_expr("an operator outside executable code", e), ast::BinOp::BitOr => self.todo_expr("an operator outside executable code", e), ast::BinOp::BitXor => self.todo_expr("an operator outside executable code", e), ast::BinOp::Shl => self.todo_expr("an operator outside executable code", e), ast::BinOp::Shr => self.todo_expr("an operator outside executable code", e), } },
            }
        }

        #[summary("비트 메서드 (stage0 bit_method): 제 폭으로 잘라 LLVM의 내장 함수를 부르고 다시 넓힌다. 세는 메서드의 결과는 0으로 넓힌다")]
        #[effects(alloc)]
        fn bit_method(self: &mut Gen, m: &str, i: ast::IntTy, a: &str, n: &str) -> CVal {
            let w: u32 = body::bits(i);
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, w as u64);
            if m == "wrapping_shl" || m == "wrapping_shr" {
                let k: String = self.t();
                let mut mask: String = String::new();
                std::num::push_u64(&mut mask, w.wrapping_sub(1) as u64);
                self.emit(types::cat5(k.as_str(), " = and i64 ", n, ", ", mask.as_str()).as_str());
                let sop: ast::BinOp = if m == "wrapping_shl" {
                    ast::BinOp::Shl
                } else {
                    ast::BinOp::Shr
                };
                return self.shift_inst(sop, i, a, k.as_str());
            }
            if m == "swap_bytes" && w == 8 {
                return CVal::Imm(String::from(a));
            }
            let it: String = types::cat2("i", wt.as_str());
            let x: String = self.narrowed(a, w, it.as_str());
            let r: String = self.t();
            let head: String = types::cat4(r.as_str(), " = call ", it.as_str(), " @llvm.");
            if m == "rotate_left" || m == "rotate_right" {
                let k2: String = self.narrowed(n, w, it.as_str());
                let rot: String = if m == "rotate_left" {
                    String::from("fshl")
                } else {
                    String::from("fshr")
                };
                let mut line: String = types::cat5(head.as_str(), rot.as_str(), ".", it.as_str(), "(");
                line.push_str(types::cat7(it.as_str(), " ", x.as_str(), ", ", it.as_str(), " ", x.as_str()).as_str());
                line.push_str(types::cat5(", ", it.as_str(), " ", k2.as_str(), ")").as_str());
                self.emit(line.as_str());
            } else if m == "count_ones" || m == "count_zeros" {
                self.emit(types::cat7(head.as_str(), "ctpop.", it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ")").as_str()).as_str());
            } else if m == "leading_zeros" || m == "trailing_zeros" {
                let zf: String = if m == "leading_zeros" {
                    String::from("ctlz.")
                } else {
                    String::from("cttz.")
                };
                self.emit(types::cat7(head.as_str(), zf.as_str(), it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ", i1 false)").as_str()).as_str());
            } else if m == "leading_ones" || m == "trailing_ones" {
                let of: String = if m == "leading_ones" {
                    String::from("ctlz.")
                } else {
                    String::from("cttz.")
                };
                let inv: String = self.t();
                self.emit(types::cat7(inv.as_str(), " = xor ", it.as_str(), " ", x.as_str(), ", -1", "").as_str());
                self.emit(types::cat7(head.as_str(), of.as_str(), it.as_str(), "(", it.as_str(), " ", types::cat2(inv.as_str(), ", i1 false)").as_str()).as_str());
            } else if m == "reverse_bits" {
                self.emit(types::cat7(head.as_str(), "bitreverse.", it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ")").as_str()).as_str());
            } else if m == "swap_bytes" {
                self.emit(types::cat7(head.as_str(), "bswap.", it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ")").as_str()).as_str());
            } else {
                self.todo.push(types::cat4("the bit method `", m, "` in ", self.path.as_str()));
                return CVal::Never;
            }
            let res: String = if m == "count_zeros" {
                let z: String = self.t();
                self.emit(types::cat7(z.as_str(), " = sub ", it.as_str(), " ", wt.as_str(), ", ", r.as_str()).as_str());
                z
            } else {
                r
            };
            if w == 64 {
                return CVal::Imm(res);
            }
            let ext: String = if body::bit_count(m) || !body::signed(i) {
                String::from("zext")
            } else {
                String::from("sext")
            };
            let back: String = self.t();
            self.emit(types::cat7(back.as_str(), " = ", ext.as_str(), " ", it.as_str(), " ", types::cat2(res.as_str(), " to i64").as_str()).as_str());
            CVal::Imm(back)
        }

        #[summary("레이블 한 줄")]
        #[effects(alloc)]
        fn block(self: &mut Gen, label: &str) -> () {
            self.out.push_str(label);
            self.out.push_str(":\n");
        }

        #[summary("블록의 값 (stage0 block_expr): 문장들, 이어서 꼬리 식")]
        #[effects(alloc)]
        fn block_expr(self: &mut Gen, b: &ast::Block, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", b.span);
                return CVal::Never;
            }
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                self.stmt(&b.stmts[i], ck, tb, f - 1);
            }
            let v: CVal = match &b.tail {
                None => CVal::Unit,
                Some(e) => self.expr(&**e, ck, tb, f - 1),
            };
            if self.drops_at(b.span, ck) {
                self.todo_at("a block that drops owned values", b.span);
            }
            v
        }

        #[summary("갈래 자리 s에서 놓는 값이 있는가 (검사기의 MoveInfo.branch_drops)")]
        #[effects(alloc)]
        fn branch_drops_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => ck.b.needs.items[at].moves.branch_drops.has(body::span_key(s).as_str()),
            }
        }

        #[summary("바이트열의 상수 (stage0 byte_const): 이 함수의 비공개 상수로 두고 그 주소와 길이를 준다")]
        #[effects(alloc)]
        fn byte_const(self: &mut Gen, v: &[u8]) -> CVal {
            let mut name: String = types::cat3("@\"", self.path.as_str(), ".bytes.");
            std::num::push_u64(&mut name, self.consts as u64);
            name.push_str("\"");
            let mut n: String = String::new();
            std::num::push_u64(&mut n, v.len() as u64);
            self.globals.push_str(name.as_str());
            self.globals.push_str(" = private unnamed_addr constant [");
            self.globals.push_str(n.as_str());
            self.globals.push_str(" x i8] c\"");
            for i in 0..v.len()
                invariant 0 <= i && i <= v.len(),
            {
                self.globals.push_str("\\");
                let hi: u32 = (v[i] / 16) as u32;
                let lo: u32 = (v[i] % 16) as u32;
                if hi < 10 {
                    lexer::push_code(&mut self.globals, 48 + hi);
                } else {
                    lexer::push_code(&mut self.globals, 55 + hi);
                }
                if lo < 10 {
                    lexer::push_code(&mut self.globals, 48 + lo);
                } else {
                    lexer::push_code(&mut self.globals, 55 + lo);
                }
            }
            self.globals.push_str("\", align 1\n");
            self.consts = self.consts.wrapping_add(1);
            CVal::Arr(name, n)
        }

        #[summary("제네릭 아닌 함수의 호출 (stage0 call). 인자: 스칼라, 스칼라 원소의 슬라이스(주소와 길이)와 값으로 넘기는 배열(주소), 스칼라 참조(자리의 주소). 결과: 스칼라, 스칼라 원소의 배열(부른 쪽의 메모리). 내장은 print_i64·print_u64·print_f64·print_str·print_bytes")]
        #[effects(alloc)]
        fn call(self: &mut Gen, e: &ast::Expr, c: &ast::Call, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            if c.path.len() == 2 && c.path[0].name == "u32" && c.path[1].name == "from" && c.args.len() == 1 {
                return self.expr(&c.args[0], ck, tb, f - 1);
            }
            if body::is_f64_from(c.path.as_slice()) && c.args.len() == 1 {
                return self.f64_from(&c.args[0], ck, tb, f - 1);
            }
            match body::from_bytes_int(c.path.as_slice()) {
                None => {},
                Some(bi) => { return self.from_bytes(e, c, bi, ck, tb, f - 1); },
            }
            let target: String = self.resolve(c.path.as_slice(), tb);
            match tb.fns.find(target.as_str()) {
                None => self.todo_expr("a call that is not of a function (a variant or a built-in)", e),
                Some(at) => { let bytes_out: bool = target == "print_str" || target == "print_bytes"; let print: bool = target == "print_i64" || target == "print_u64" || target == "print_f64" || bytes_out; if tb.fns.items[at].builtin && !print || tb.fns.items[at].generics.len() > 0 || has_trait(&tb.fns.items[at]) || tb.targs.has(body::span_key(e.span).as_str()) { return self.todo_expr("a call of a built-in, a generic function or a trait method", e); } let mut flat: Vec<String> = Vec::new(); let mut backs: Vec<Back> = Vec::new(); for k in 0..c.args.len() invariant 0 <= k && k <= c.args.len(), { let aty: ast::TypeKind = self.ty(&c.args[k], tb); let pk: u32 = if k < tb.fns.items[at].params.len() { param_kind(&tb.fns.items[at].params[k]) } else { 0 }; if pk == 9 { return self.todo_expr("an argument that is not a scalar, a slice or an array of scalars, or a scalar reference", &c.args[k]); } if pk == 2 && k < tb.fns.items[at].params.len() { match body::ref_inner(&tb.fns.items[at].params[k]) { None => {}, Some(inner) => { let rp: String = self.scalar_ref(&c.args[k], &inner, types::is_ref_mut(&tb.fns.items[at].params[k]), &mut backs, ck, tb, f - 1); flat.push(types::cat2("ptr ", rp.as_str())); }, } } else { let av: CVal = self.expr(&c.args[k], ck, tb, f - 1); match &av { CVal::Imm(v) => flat.push(types::cat3(llty(&aty).as_str(), " ", v.as_str())), CVal::Arr(ap, an) => { flat.push(types::cat2("ptr ", ap.as_str())); if pk != 3 { flat.push(types::cat2("i64 ", an.as_str())); } }, CVal::Unit => {}, CVal::Never => { if pk == 1 { flat.push(String::from("ptr undef")); flat.push(String::from("i64 undef")); } else if pk == 3 { flat.push(String::from("ptr undef")); } else if llty(&aty) != "void" { flat.push(types::cat2(llty(&aty).as_str(), " undef")); } }, } } } if target == "print_f64" { if flat.len() != 2 { return self.todo_expr("a `print_f64` whose arguments are not two values", e); } let pc: String = self.t(); self.emit(types::cat4(pc.as_str(), " = icmp ule ", flat[1].as_str(), ", 65535").as_str()); self.check(pc.as_str(), "`print_f64` decimals above 65535"); self.print_f64 = true; } let ret: ast::TypeKind = if print { ast::TypeKind::Unit } else { tb.fns.items[at].ret.clone() }; let callee: String = if bytes_out { String::from("@bmb_print_bytes") } else if print { types::cat2("@bmb_", target.as_str()) } else { fn_sym(target.as_str()) }; let args: String = types::join(flat.as_slice(), ", "); let res: CVal = if ret_in_memory(&ret) { if !scalar_array(&ret) { return self.todo_expr("a call with a result in memory that is not an array of scalars", e); } let out: String = self.temp(&ret); let sep: String = if flat.len() > 0 { String::from(", ") } else { String::new() }; self.emit(types::cat7("call void ", callee.as_str(), "(ptr ", out.as_str(), sep.as_str(), args.as_str(), ")").as_str()); CVal::Arr(out, array_len_text(&ret)) } else if decls::is_unit(&ret) { self.emit(types::cat5("call void ", callee.as_str(), "(", args.as_str(), ")").as_str()); CVal::Unit } else { let r: String = self.t(); self.emit(types::cat7(r.as_str(), " = call ", llty(&ret).as_str(), " ", callee.as_str(), "(", types::cat2(args.as_str(), ")").as_str()).as_str()); CVal::Imm(r) }; for b in 0..backs.len() invariant 0 <= b && b <= backs.len(), { let x: String = self.t(); self.emit(types::cat5(x.as_str(), " = load ", backs[b].lt.as_str(), ", ptr ", backs[b].tmp.as_str()).as_str()); let be: String = backs[b].elem.clone(); let bp: String = backs[b].ptr.clone(); self.store_elem(be.as_str(), x.as_str(), bp.as_str()); } res },
            }
        }

        #[summary("실행 중 검사 (stage0 check): cond가 거짓이면 멈춘다")]
        #[effects(alloc)]
        fn check(self: &mut Gen, cond: &str, what: &str) -> () {
            self.checks = self.checks.wrapping_add(1);
            let ok: String = self.l("ok");
            let bad: String = self.l("trap");
            let mut line: String = types::cat7("br i1 ", cond, ", label %", ok.as_str(), ", label %", bad.as_str(), " ; unproved: ");
            line.push_str(what);
            self.emit(line.as_str());
            self.block(bad.as_str());
            self.emit("call void @bmb_trap()");
            self.emit("unreachable");
            self.block(ok.as_str());
        }

        #[summary("값을 옮긴다 (stage0 copy): memmove라 x = x도 된다")]
        #[effects(alloc)]
        fn copy(self: &mut Gen, dst: &str, src: &str, t: &ast::TypeKind) -> () {
            let mut line: String = types::cat5("call void @llvm.memmove.p0.p0.i64(ptr ", dst, ", ptr ", src, ", i64 ");
            line.push_str(size_of(t).as_str());
            line.push_str(", i1 false)");
            self.emit(line.as_str());
        }

        #[summary("나눗셈과 나머지 (stage0 expr의 Div·Rem): 0으로 나눔과 부호 있는 타입의 MIN / -1을 잰다")]
        #[effects(alloc)]
        fn div_rem(self: &mut Gen, div: bool, i: ast::IntTy, a: &str, b: &str) -> CVal {
            let c: String = self.t();
            self.emit(types::cat4(c.as_str(), " = icmp ne i64 ", b, ", 0").as_str());
            self.check(c.as_str(), "divisor may be zero");
            let signed: bool = body::signed(i);
            if signed {
                let m: String = self.t();
                let n: String = self.t();
                let both: String = self.t();
                let ok: String = self.t();
                self.emit(types::cat5(m.as_str(), " = icmp eq i64 ", a, ", ", int_min(i).as_str()).as_str());
                self.emit(types::cat4(n.as_str(), " = icmp eq i64 ", b, ", -1").as_str());
                self.emit(types::cat5(both.as_str(), " = and i1 ", m.as_str(), ", ", n.as_str()).as_str());
                self.emit(types::cat4(ok.as_str(), " = xor i1 ", both.as_str(), ", true").as_str());
                self.check(ok.as_str(), types::cat2(body::int_text(i).as_str(), "::MIN / -1").as_str());
            }
            let inst: String = if div {
                if signed {
                    String::from("sdiv")
                } else {
                    String::from("udiv")
                }
            } else if signed {
                String::from("srem")
            } else {
                String::from("urem")
            };
            let res: String = self.t();
            self.emit(types::cat7(res.as_str(), " = ", inst.as_str(), " i64 ", a, ", ", b).as_str());
            CVal::Imm(res)
        }

        #[summary("블록 자리 s에서 놓는 값이 있는가 (검사기의 MoveInfo.drops)")]
        #[effects(alloc)]
        fn drops_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => ck.b.needs.items[at].moves.drops.has(body::span_key(s).as_str()),
            }
        }

        #[summary("원소의 주소 (stage0 elem_ptr): 색인이 길이 안인지 재고 (전체 검사 모드) 그 원소를 가리킨다. 대입의 대상은 타입의 기록이 없어 변수의 자리에서 원소 종류를 읽는다")]
        #[effects(alloc)]
        fn elem_ptr(self: &mut Gen, e: &ast::Expr, base: &ast::Expr, index: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ElemPtr
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return ElemPtr { ptr: String::from("undef"), elem: String::from("i64") };
            }
            let elem: String = match var_name(base) {
                None => elem_kind(&elem_of(&self.ty(base, tb))),
                Some(bn) => { match self.arr_slot(bn.as_str()) { None => { self.todo_at("an index into a local that is not an array or a slice", e.span); String::from("i64") }, Some(sl) => sl.elem, } },
            };
            let av: CVal = self.array_of(base, ck, tb, f - 1);
            let i: String = imm(&self.expr(index, ck, tb, f - 1));
            if !is_arr(&av) {
                if !is_never(&av) {
                    self.todo_at("an index into a value that is not an array or a slice", e.span);
                }
                return ElemPtr { ptr: String::from("undef"), elem: elem };
            }
            let c: String = self.t();
            self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", i.as_str(), ", ", arr_len(&av).as_str()).as_str());
            self.check(c.as_str(), "index may be out of bounds");
            let p: String = self.t();
            self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", mem(elem.as_str()).as_str(), ", ptr ", arr_ptr(&av).as_str(), ", i64 ", i.as_str()).as_str());
            ElemPtr { ptr: p, elem: elem }
        }

        #[summary("&v[a..b] (stage0 elem_slice): 범위가 길이 안인지 재고 그 조각의 주소와 길이를 준다")]
        #[effects(alloc)]
        fn elem_slice(self: &mut Gen, idx: &ast::Expr, base: &ast::Expr, lo: &ast::Expr, hi: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", idx);
            }
            let vt: ast::TypeKind = lowered::value_ty(&self.ty(base, tb));
            let whole: ast::TypeKind = match body::ref_inner(&vt) {
                None => vt.clone(),
                Some(inner) => inner,
            };
            let et: ast::TypeKind = match body::array_elem(&whole) {
                None => { match body::slice_elem(&whole) { None => { return self.todo_expr("a range of a value that is not an array or a slice", idx); }, Some(se) => se, } },
                Some(ae) => ae,
            };
            if !is_scalar_ty(&et) {
                return self.todo_expr("a range of values that are not scalars", idx);
            }
            let av: CVal = self.array_of(base, ck, tb, f - 1);
            let a: String = imm(&self.expr(lo, ck, tb, f - 1));
            let b: String = imm(&self.expr(hi, ck, tb, f - 1));
            if !is_arr(&av) {
                if !is_never(&av) {
                    self.todo_at("a range of a value that is not an array or a slice", idx.span);
                }
                return CVal::Never;
            }
            let ord: String = self.t();
            let end: String = self.t();
            let c: String = self.t();
            self.emit(types::cat5(ord.as_str(), " = icmp ule i64 ", a.as_str(), ", ", b.as_str()).as_str());
            self.emit(types::cat5(end.as_str(), " = icmp ule i64 ", b.as_str(), ", ", arr_len(&av).as_str()).as_str());
            self.emit(types::cat5(c.as_str(), " = and i1 ", ord.as_str(), ", ", end.as_str()).as_str());
            self.check(c.as_str(), "the range may be out of bounds");
            let ptr: String = self.t();
            let len: String = self.t();
            self.emit(types::cat7(ptr.as_str(), " = getelementptr ", mem_ty(&et).as_str(), ", ptr ", arr_ptr(&av).as_str(), ", i64 ", a.as_str()).as_str());
            self.emit(types::cat5(len.as_str(), " = sub nuw i64 ", b.as_str(), ", ", a.as_str()).as_str());
            CVal::Arr(ptr, len)
        }

        #[summary("몸에 명령 한 줄")]
        #[effects(alloc)]
        fn emit(self: &mut Gen, line: &str) -> () {
            self.out.push_str("  ");
            self.out.push_str(line);
            self.out.push_str("\n");
        }

        #[summary("함수를 끝낸다 (stage0 emit_return): ()는 ret void, 스칼라는 그 값, 배열은 부른 쪽의 메모리에 옮기고 ret void")]
        #[effects(alloc)]
        fn emit_return(self: &mut Gen, rv: &CVal) -> () {
            if ret_in_memory(&self.ret) {
                if !scalar_array(&self.ret) {
                    self.todo.push(types::cat2("a result in memory that is not an array of scalars in ", self.path.as_str()));
                    return;
                }
                if is_arr(rv) {
                    let rt: ast::TypeKind = self.ret.clone();
                    self.copy("%\"ret.out\"", arr_ptr(rv).as_str(), &rt);
                }
                self.emit("ret void");
                return;
            }
            let ret: String = llty(&self.ret);
            if ret == "void" {
                self.emit("ret void");
            } else {
                self.emit(types::cat4("ret ", ret.as_str(), " ", imm(rv).as_str()).as_str());
            }
        }

        #[summary("자리 s에서 함수나 루프를 떠나며 놓는 값이 있는가 (검사기의 MoveInfo.exits)")]
        #[effects(alloc)]
        fn exits_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => ck.b.needs.items[at].moves.exits.has(body::span_key(s).as_str()),
            }
        }

        #[summary("식의 값 (stage0 expr). 지금은 리터럴, 스칼라 지역 변수, 단항·이항 연산, 블록, 스칼라의 if, 제네릭 아닌 함수의 호출")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn expr(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            match &e.kind {
                ast::ExprKind::Int(v, ex_r) => { let mut s: String = String::new(); wide::push_radix(&mut s, *v, 10); CVal::Imm(s) },
                ast::ExprKind::Float(bits) => CVal::Imm(f64_const(*bits)),
                ast::ExprKind::ByteLit(bl) => { let mut s: String = String::new(); std::num::push_u64(&mut s, *bl as u64); CVal::Imm(s) },
                ast::ExprKind::ByteStr(bs) => self.byte_const(bs.as_slice()),
                ast::ExprKind::StrLit(sl) => self.byte_const(sl.as_bytes()),
                ast::ExprKind::CharLit(ch) => { let mut s: String = String::new(); std::num::push_u64(&mut s, *ch as u64); CVal::Imm(s) },
                ast::ExprKind::Bool(on) => { if *on { CVal::Imm(String::from("true")) } else { CVal::Imm(String::from("false")) } },
                ast::ExprKind::Unit => CVal::Unit,
                ast::ExprKind::Var(id) => { if decls::is_unit(&self.ty(e, tb)) { return CVal::Unit; } match self.arr_slot(id.name.as_str()) { None => {}, Some(asl) => { return CVal::Arr(asl.ptr, asl.len); }, } match self.scalar_slot(id.name.as_str()) { None => self.todo_expr("a name that is not a scalar or array local", e), Some(slot) => { let r: String = self.t(); self.emit(types::cat5(r.as_str(), " = load ", slot.ty.as_str(), ", ptr ", slot.ptr.as_str()).as_str()); CVal::Imm(r) }, } },
                ast::ExprKind::Call(c) => self.call(e, c, ck, tb, f - 1),
                ast::ExprKind::Method(mc) => self.method(e, mc, ck, tb, f - 1),
                ast::ExprKind::Index(ib, ii) => self.index_expr(e, &**ib, &**ii, ck, tb, f - 1),
                ast::ExprKind::Unary(uop, ux) => self.unary(e, *uop, &**ux, ck, tb, f - 1),
                ast::ExprKind::Binary(bop, lhs, rhs) => self.binary(e, *bop, &**lhs, &**rhs, ck, tb, f - 1),
                ast::ExprKind::Ref(ref_m, ref_x) => self.expr(&**ref_x, ck, tb, f - 1),
                ast::ExprKind::If(ifx) => self.if_expr(e, ifx, ck, tb, f - 1),
                ast::ExprKind::Block(b) => self.block_expr(b, ck, tb, f - 1),
                ast::ExprKind::Array(ex_items) => self.array_lit(e, ck, tb, f - 1),
                ast::ExprKind::Repeat(ex_rp) => self.array_lit(e, ck, tb, f - 1),
                ast::ExprKind::Old(ex_old0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Quant(ex_quant0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Trigger(ex_trigger0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Closure(ex_closure0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::StructLit(ex_structlit0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Path(segs) => self.path_const(e, segs.as_slice()),
                ast::ExprKind::Deref(dx) => { if is_box(&self.ty(&**dx, tb)) { self.todo_expr("the value of a `Box`", e) } else { self.expr(&**dx, ck, tb, f - 1) } },
                ast::ExprKind::Field(ex_field0, ex_field1) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Match(ex_match0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Return(rx) => self.return_expr(e, rx, ck, tb, f - 1),
                ast::ExprKind::Try(ex_try0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Loop(lp) => self.loop_expr(e, lp, ck, tb, f - 1),
                ast::ExprKind::Break(bk) => self.jump(e, &bk.label, &bk.value, true, ck, tb, f - 1),
                ast::ExprKind::Continue(cl) => { let no_value: Option<Box<ast::Expr>> = None; self.jump(e, cl, &no_value, false, ck, tb, f - 1) },
                ast::ExprKind::Range(ex_range0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Error => self.todo_expr("an expression not lowered yet", e),
            }
        }

        #[summary("f64::from(x) (stage0 f64_from): 64비트 정수는 정확히 옮겨지는 범위(2^53까지)를 잰다")]
        #[effects(alloc)]
        fn f64_from(self: &mut Gen, x: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", x);
            }
            let st: ast::TypeKind = self.ty(x, tb);
            let v: String = imm(&self.expr(x, ck, tb, f - 1));
            match body::int_of(&st) {
                None => CVal::Imm(v),
                Some(i) => { if body::bits(i) == 64 { let c: String = self.t(); if body::signed(i) { let sh: String = self.t(); self.emit(types::cat4(sh.as_str(), " = add i64 ", v.as_str(), ", 9007199254740992").as_str()); self.emit(types::cat4(c.as_str(), " = icmp ule i64 ", sh.as_str(), ", 18014398509481984").as_str()); } else { self.emit(types::cat4(c.as_str(), " = icmp ule i64 ", v.as_str(), ", 9007199254740992").as_str()); } self.check(c.as_str(), "`f64::from` may not be exact"); } let r: String = self.t(); let inst: String = if body::signed(i) { String::from("sitofp") } else { String::from("uitofp") }; self.emit(types::cat7(r.as_str(), " = ", inst.as_str(), " i64 ", v.as_str(), " to double", "").as_str()); CVal::Imm(r) },
            }
        }

        #[summary("f64의 메서드 (stage0 f64_method): sqrt, abs, min, max, is_nan, is_finite")]
        #[effects(alloc)]
        fn f64_method(self: &mut Gen, m: &str, a: &str, b: &str, has_b: bool) -> CVal {
            let r: String = self.t();
            if (m == "sqrt" || m == "abs") && !has_b {
                let fname: String = if m == "sqrt" {
                    String::from("sqrt")
                } else {
                    String::from("fabs")
                };
                self.emit(types::cat7(r.as_str(), " = call double @llvm.", fname.as_str(), ".f64(double ", a, ")", "").as_str());
            } else if (m == "min" || m == "max") && has_b {
                let mm: String = if m == "min" {
                    String::from("minnum")
                } else {
                    String::from("maxnum")
                };
                self.emit(types::cat7(r.as_str(), " = call double @llvm.", mm.as_str(), ".f64(double ", a, ", double ", types::cat2(b, ")").as_str()).as_str());
            } else if m == "is_nan" && !has_b {
                self.emit(types::cat5(r.as_str(), " = fcmp uno double ", a, ", ", a).as_str());
            } else if m == "is_finite" && !has_b {
                let x: String = self.t();
                self.emit(types::cat4(x.as_str(), " = call double @llvm.fabs.f64(double ", a, ")").as_str());
                self.emit(types::cat4(r.as_str(), " = fcmp olt double ", x.as_str(), ", 0x7FF0000000000000").as_str());
            } else {
                self.todo.push(types::cat4("the `f64` method `", m, "` in ", self.path.as_str()));
                return CVal::Never;
            }
            CVal::Imm(r)
        }

        #[summary("값 v가 정수 타입 i의 범위 안인가 (stage0 fits): 그 판정의 레지스터")]
        #[effects(alloc)]
        fn fits(self: &mut Gen, v: &str, i: ast::IntTy) -> String {
            self.in_range_of(v, body::signed(i), i)
        }

        #[summary("for 문장 (stage0 stmt의 For): 끝 값을 한 번 재고, i를 lo부터 i < hi(<=)인 동안. continue는 걸음으로 간다. lo..=hi는 i == hi에서 떠나 i + 1이 타입의 끝을 넘지 않는다")]
        #[effects(alloc)]
        fn for_stmt(self: &mut Gen, x: &ast::For, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", x.span);
                return;
            }
            match self.local_ty(x.var.name.as_str(), tb) {
                None => self.todo_at("a `for` variable without a type", x.span),
                Some(t) => { let lt: String = llty(&t); let signed: bool = is_signed(&t); let ptr: String = self.alloca(lt.as_str()); let a: String = imm(&self.expr(&x.lo, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", a.as_str(), ", ptr ", ptr.as_str(), "").as_str()); let b: String = imm(&self.expr(&x.hi, ck, tb, f - 1)); self.slots.insert(x.var.name.as_str(), Slot::Scalar(ptr.clone(), lt.clone())); let head: String = self.l("for"); let lb: String = self.l("body"); let next: String = self.l("next"); let end: String = self.l("endfor"); self.emit(types::cat2("br label %", head.as_str()).as_str()); self.block(head.as_str()); let i1: String = self.t(); self.emit(types::cat5(i1.as_str(), " = load ", lt.as_str(), ", ptr ", ptr.as_str()).as_str()); let c: String = self.t(); let op: String = if x.inclusive { if signed { String::from("sle") } else { String::from("ule") } } else if signed { String::from("slt") } else { String::from("ult") }; let mut cmp: String = types::cat5(c.as_str(), " = icmp ", op.as_str(), " ", lt.as_str()); cmp.push_str(" "); cmp.push_str(i1.as_str()); cmp.push_str(", "); cmp.push_str(b.as_str()); self.emit(cmp.as_str()); self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str()); self.block(lb.as_str()); let depth: usize = self.loops.len(); self.loops.push(GLoop { label: label_name(&x.label), head: next.clone(), end: end.clone(), slot: None, lt: String::new() }); let body_v: CVal = self.block_expr(&x.body, ck, tb, f - 1); self.loops.truncate(depth); self.emit(types::cat2("br label %", next.as_str()).as_str()); self.block(next.as_str()); let i2: String = self.t(); self.emit(types::cat5(i2.as_str(), " = load ", lt.as_str(), ", ptr ", ptr.as_str()).as_str()); if x.inclusive { let at_end: String = self.t(); let step: String = self.l("step"); let mut eq: String = types::cat5(at_end.as_str(), " = icmp eq ", lt.as_str(), " ", i2.as_str()); eq.push_str(", "); eq.push_str(b.as_str()); self.emit(eq.as_str()); self.emit(types::cat7("br i1 ", at_end.as_str(), ", label %", end.as_str(), ", label %", step.as_str(), "").as_str()); self.block(step.as_str()); } let n: String = self.t(); self.emit(types::cat7(n.as_str(), " = add ", lt.as_str(), " ", i2.as_str(), ", 1", "").as_str()); self.emit(types::cat7("store ", lt.as_str(), " ", n.as_str(), ", ptr ", ptr.as_str(), "").as_str()); self.emit(types::cat2("br label %", head.as_str()).as_str()); self.block(end.as_str()); },
            }
        }

        #[summary("바이트들에서 정수 (stage0 expr의 from_bytes_call, 백로그 2N-09c): 바이트마다 읽어 제자리로 밀고 합친다. 좁은 부호 있는 타입은 제 폭의 부호를 넓힌다")]
        #[effects(alloc)]
        fn from_bytes(self: &mut Gen, e: &ast::Expr, c: &ast::Call, i: ast::IntTy, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 || c.args.len() != 1 || c.path.len() != 2 {
                return self.todo_expr("a byte conversion without one argument", e);
            }
            let le: bool = c.path[1].name == "from_le_bytes";
            let av: CVal = self.expr(&c.args[0], ck, tb, f - 1);
            if !is_arr(&av) {
                if !is_never(&av) {
                    self.todo_at("bytes that are not an array", e.span);
                }
                return CVal::Never;
            }
            let ptr: String = arr_ptr(&av);
            let w: u32 = body::bits(i);
            let n: u32 = w / 8;
            let mut nt: String = String::new();
            std::num::push_u64(&mut nt, n as u64);
            let mut acc: String = String::from("0");
            for k in 0..n
                invariant 0 <= k && k <= n,
            {
                let sh: u32 = if le {
                    k.wrapping_mul(8)
                } else {
                    n.wrapping_sub(1).wrapping_sub(k).wrapping_mul(8)
                };
                let p: String = self.t();
                let mut kt: String = String::new();
                std::num::push_u64(&mut kt, k as u64);
                self.emit(types::cat7(p.as_str(), " = getelementptr inbounds [", nt.as_str(), " x i8], ptr ", ptr.as_str(), ", i64 0, i64 ", kt.as_str()).as_str());
                let b0: String = self.load_elem("u8", p.as_str());
                let b1: String = if sh == 0 {
                    b0
                } else {
                    let sb: String = self.t();
                    let mut st: String = String::new();
                    std::num::push_u64(&mut st, sh as u64);
                    self.emit(types::cat5(sb.as_str(), " = shl i64 ", b0.as_str(), ", ", st.as_str()).as_str());
                    sb
                };
                let r: String = self.t();
                self.emit(types::cat5(r.as_str(), " = or i64 ", acc.as_str(), ", ", b1.as_str()).as_str());
                acc = r;
            }
            if body::signed(i) && w < 64 {
                let tr: String = self.t();
                let sx: String = self.t();
                let mut wt: String = String::new();
                std::num::push_u64(&mut wt, w as u64);
                self.emit(types::cat5(tr.as_str(), " = trunc i64 ", acc.as_str(), " to i", wt.as_str()).as_str());
                self.emit(types::cat5(sx.as_str(), " = sext i", wt.as_str(), " ", types::cat2(tr.as_str(), " to i64").as_str()).as_str());
                acc = sx;
            }
            CVal::Imm(acc)
        }

        #[summary("배열 값의 if (stage0 expr의 If, 백로그 1B-25): 두 갈래가 제 배열을 한 자리에 옮긴다")]
        #[effects(alloc)]
        fn if_array(self: &mut Gen, e: &ast::Expr, x: &ast::If, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            match body::array_elem(&ty) {
                None => self.todo_expr("an `if` whose value is not an array", e),
                Some(el) => { if !is_scalar_ty(&el) { return self.todo_expr("an `if` whose value is an array of values that are not scalars", e); } let elem: String = elem_kind(&el); let n: String = array_len_text(&ty); let buf: String = self.alloca(types::cat5("[", n.as_str(), " x ", mem(elem.as_str()).as_str(), "]").as_str()); let bytes: u64 = dec(n.as_str()).wrapping_mul(align(elem.as_str()) as u64); let c: String = imm(&self.expr(&*x.cond, ck, tb, f - 1)); let lthen: String = self.l("then"); let lelse: String = self.l("else"); let end: String = self.l("endif"); self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lthen.as_str(), ", label %", lelse.as_str(), "").as_str()); self.block(lthen.as_str()); let tv: CVal = self.block_expr(&x.then, ck, tb, f - 1); if is_arr(&tv) { self.memcpy(buf.as_str(), arr_ptr(&tv).as_str(), bytes); } if self.branch_drops_at(x.then.span, ck) { self.todo_at("a branch that drops owned values", x.then.span); } self.emit(types::cat2("br label %", end.as_str()).as_str()); self.block(lelse.as_str()); match &x.els { None => self.todo_at("an array `if` without an else", e.span), Some(other) => { let ev: CVal = self.expr(&**other, ck, tb, f - 1); if is_arr(&ev) { self.memcpy(buf.as_str(), arr_ptr(&ev).as_str(), bytes); } if self.branch_drops_at(other.span, ck) { self.todo_at("a branch that drops owned values", other.span); } }, } self.emit(types::cat2("br label %", end.as_str()).as_str()); self.block(end.as_str()); CVal::Arr(buf, n) },
            }
        }

        #[summary("스칼라나 단위 값의 if (stage0 expr의 If): 결과의 자리에 두 갈래가 쓰고 끝에서 읽는다")]
        #[effects(alloc)]
        fn if_expr(self: &mut Gen, e: &ast::Expr, x: &ast::If, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            if body::is_array(&ty) {
                return self.if_array(e, x, ck, tb, f - 1);
            }
            if is_mem(&ty) || body::is_ref(&ty) {
                return self.todo_expr("an `if` whose value is not a scalar or an array", e);
            }
            let lt: String = llty(&ty);
            let slot: Option<String> = if decls::is_unit(&ty) || types::is_error(&ty) {
                None
            } else {
                Some(self.alloca(lt.as_str()))
            };
            let c: String = imm(&self.expr(&*x.cond, ck, tb, f - 1));
            let lthen: String = self.l("then");
            let lelse: String = self.l("else");
            let end: String = self.l("endif");
            self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lthen.as_str(), ", label %", lelse.as_str(), "").as_str());
            self.block(lthen.as_str());
            let tv: CVal = self.block_expr(&x.then, ck, tb, f - 1);
            self.store_result(&slot, &tv, lt.as_str());
            if self.branch_drops_at(x.then.span, ck) {
                self.todo_at("a branch that drops owned values", x.then.span);
            }
            self.emit(types::cat2("br label %", end.as_str()).as_str());
            self.block(lelse.as_str());
            match &x.els {
                None => {},
                Some(other) => { let ev: CVal = self.expr(&**other, ck, tb, f - 1); self.store_result(&slot, &ev, lt.as_str()); if self.branch_drops_at(other.span, ck) { self.todo_at("a branch that drops owned values", other.span); } },
            }
            self.emit(types::cat2("br label %", end.as_str()).as_str());
            self.block(end.as_str());
            match &slot {
                None => CVal::Unit,
                Some(sl) => { let r: String = self.t(); self.emit(types::cat5(r.as_str(), " = load ", lt.as_str(), ", ptr ", sl.as_str()).as_str()); CVal::Imm(r) },
            }
        }

        #[summary("값 v가 정수 타입 i의 범위 안인가 (stage0 in_range_of). from_signed는 v가 부호 있는 값인가")]
        #[effects(alloc)]
        fn in_range_of(self: &mut Gen, v: &str, from_signed: bool, i: ast::IntTy) -> String {
            let c: String = self.t();
            let to_signed: bool = body::signed(i);
            let wide: bool = body::bits(i) == 64;
            if !from_signed || !to_signed {
                if from_signed && !to_signed && wide || !from_signed && to_signed && wide {
                    self.emit(types::cat4(c.as_str(), " = icmp sge i64 ", v, ", 0").as_str());
                } else {
                    self.emit(types::cat5(c.as_str(), " = icmp ule i64 ", v, ", ", int_max(i).as_str()).as_str());
                }
            } else {
                let d: String = self.t();
                self.emit(types::cat5(d.as_str(), " = sub i64 ", v, ", ", int_min(i).as_str()).as_str());
                self.emit(types::cat5(c.as_str(), " = icmp ule i64 ", d.as_str(), ", ", all_ones(body::bits(i)).as_str()).as_str());
            }
            c
        }

        #[summary("색인 식 (stage0 expr의 Index 갈래들): 범위면 조각, 아니면 스칼라 원소를 읽는다")]
        #[effects(alloc)]
        fn index_expr(self: &mut Gen, e: &ast::Expr, base: &ast::Expr, index: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            match range_of(index) {
                None => {},
                Some(r) => { if self.is_text_expr(base, tb) { return self.todo_expr("a range of text", e); } return self.elem_slice(e, base, &*r.lo, &*r.hi, ck, tb, f - 1); },
            }
            if !is_scalar_ty(&self.ty(e, tb)) {
                return self.todo_expr("an element that is not a scalar", e);
            }
            let ep: ElemPtr = self.elem_ptr(e, base, index, ck, tb, f - 1);
            if ep.ptr == "undef" {
                return CVal::Never;
            }
            CVal::Imm(self.load_elem(ep.elem.as_str(), ep.ptr.as_str()))
        }

        #[summary("스칼라 원소의 배열을 ptr에 채운다 (stage0 init_array): 리터럴, 반복, 다른 배열 값의 복사")]
        #[effects(alloc)]
        fn init_array(self: &mut Gen, e: &ast::Expr, ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return;
            }
            match &e.kind {
                ast::ExprKind::Int(ia_int0, ia_int1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Float(ia_float0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::ByteLit(ia_bytelit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::ByteStr(ia_bytestr0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::StrLit(ia_strlit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::CharLit(ia_charlit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Bool(ia_bool0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Unit => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Var(ia_var0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Call(ia_call0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Method(ia_method0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Index(ia_index0, ia_index1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Unary(ia_unary0, ia_unary1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Binary(ia_binary0, ia_binary1, ia_binary2) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Ref(ia_ref0, ia_ref1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::If(ia_if0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Block(ia_block0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Array(items) => self.init_items(items.as_slice(), ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Repeat(rp) => self.init_repeat(rp, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Old(ia_old0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Quant(ia_quant0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Trigger(ia_trigger0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Closure(ia_closure0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::StructLit(ia_structlit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Path(ia_path0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Deref(ia_deref0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Field(ia_field0, ia_field1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Match(ia_match0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Return(ia_return0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Try(ia_try0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Loop(ia_loop0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Break(ia_break0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Continue(ia_continue0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Range(ia_range0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Error => self.init_copy(e, ptr, elem, ck, tb, f - 1),
            }
        }

        #[summary("다른 배열 값에서 옮겨 채운다 (stage0 init_array의 마지막 갈래)")]
        #[effects(alloc)]
        fn init_copy(self: &mut Gen, e: &ast::Expr, ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return;
            }
            let v: CVal = self.expr(e, ck, tb, f - 1);
            if is_arr(&v) {
                let bytes: u64 = dec(arr_len(&v).as_str()).wrapping_mul(align(elem) as u64);
                self.memcpy(ptr, arr_ptr(&v).as_str(), bytes);
            } else if !is_never(&v) {
                self.todo_at("an array filled from a value that is not an array", e.span);
            }
        }

        #[summary("배열 리터럴로 채운다 (stage0 init_array의 Array 갈래들). 원소가 모두 리터럴이고 둘 이상이면 비공개 상수 하나와 그 복사다. 아니면 원소를 모두 셈한 뒤에 쓴다 (a = [a[1], a[0]]의 오른쪽은 옛 a를 읽는다)")]
        #[effects(alloc)]
        fn init_items(self: &mut Gen, items: &[ast::Expr], ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo.push(types::cat2("nesting too deep in ", self.path.as_str()));
                return;
            }
            let m: String = mem(elem);
            if items.len() > 1 {
                match const_elems(items) {
                    None => {},
                    Some(vals) => { let bits: u32 = if elem == "i1" { 8 } else if narrow_bits(elem) > 0 { narrow_bits(elem) } else { 64 }; let mut body_t: Vec<String> = Vec::new(); for k in 0..vals.len() invariant 0 <= k && k <= vals.len(), { body_t.push(types::cat3(m.as_str(), " ", const_text(&vals[k], bits).as_str())); } let mut name: String = types::cat3("@\"", self.path.as_str(), ".const."); std::num::push_u64(&mut name, self.consts as u64); name.push_str("\""); let mut nt: String = String::new(); std::num::push_u64(&mut nt, vals.len() as u64); let mut al: String = String::new(); std::num::push_u64(&mut al, align(elem) as u64); self.globals.push_str(types::cat7(name.as_str(), " = private unnamed_addr constant [", nt.as_str(), " x ", m.as_str(), "] [", types::join(body_t.as_slice(), ", ").as_str()).as_str()); self.globals.push_str(types::cat3("], align ", al.as_str(), "\n").as_str()); self.consts = self.consts.wrapping_add(1); self.memcpy(ptr, name.as_str(), (vals.len() as u64).wrapping_mul(align(elem) as u64)); return; },
                }
            }
            let mut regs: Vec<String> = Vec::new();
            for j in 0..items.len()
                invariant 0 <= j && j <= items.len(),
            {
                regs.push(imm(&self.expr(&items[j], ck, tb, f - 1)));
            }
            for j2 in 0..regs.len()
                invariant 0 <= j2 && j2 <= regs.len(),
            {
                let p: String = self.t();
                let mut jt: String = String::new();
                std::num::push_u64(&mut jt, j2 as u64);
                self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", m.as_str(), ", ptr ", ptr, ", i64 ", jt.as_str()).as_str());
                self.store_elem(elem, regs[j2].as_str(), p.as_str());
            }
        }

        #[summary("반복으로 채운다 (stage0 init_array의 Repeat 갈래): 값을 한 번 셈하고 루프로 쓴다")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn init_repeat(self: &mut Gen, rp: &ast::Repeat, ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo.push(types::cat2("nesting too deep in ", self.path.as_str()));
                return;
            }
            let v: String = imm(&self.expr(&*rp.value, ck, tb, f - 1));
            let mut count: String = String::new();
            wide::push_radix(&mut count, rp.count, 10);
            let i: String = self.alloca("i64");
            self.emit(types::cat2("store i64 0, ptr ", i.as_str()).as_str());
            let head: String = self.l("fill");
            let lb: String = self.l("fillb");
            let end: String = self.l("filled");
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(head.as_str());
            let k: String = self.t();
            let c: String = self.t();
            self.emit(types::cat3(k.as_str(), " = load i64, ptr ", i.as_str()).as_str());
            self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", k.as_str(), ", ", count.as_str()).as_str());
            self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str());
            self.block(lb.as_str());
            let p: String = self.t();
            let k2: String = self.t();
            self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", mem(elem).as_str(), ", ptr ", ptr, ", i64 ", k.as_str()).as_str());
            self.store_elem(elem, v.as_str(), p.as_str());
            self.emit(types::cat4(k2.as_str(), " = add nuw i64 ", k.as_str(), ", 1").as_str());
            self.emit(types::cat4("store i64 ", k2.as_str(), ", ptr ", i.as_str()).as_str());
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(end.as_str());
        }

        #[summary("정수 메서드 (stage0 int_method, narrow_method): wrapping_*은 64비트에서 셈하고 제 폭으로 자르고, saturating_*은 내장 함수나 넘침 깃발로 끝 값에 붙인다. checked_*은 Option이라 아직 옮기지 않았다")]
        #[effects(alloc)]
        fn int_method(self: &mut Gen, e: &ast::Expr, op: &str, a: &str, b: &str, i: ast::IntTy) -> CVal {
            let signed: bool = body::signed(i);
            let sg: String = if signed {
                String::from("s")
            } else {
                String::from("u")
            };
            let wrapping: bool = op == "wrapping_add" || op == "wrapping_sub" || op == "wrapping_mul";
            let saturating: bool = op == "saturating_add" || op == "saturating_sub" || op == "saturating_mul";
            if !wrapping && !saturating {
                return self.todo_expr("an integer method that is not wrapping or saturating", e);
            }
            let base: String = if op == "wrapping_add" || op == "saturating_add" {
                String::from("add")
            } else if op == "wrapping_sub" || op == "saturating_sub" {
                String::from("sub")
            } else {
                String::from("mul")
            };
            let r: String = self.t();
            if wrapping {
                self.emit(types::cat7(r.as_str(), " = ", base.as_str(), " i64 ", a, ", ", b).as_str());
            } else if base != "mul" {
                let mut line: String = types::cat5(r.as_str(), " = call i64 @llvm.", sg.as_str(), base.as_str(), ".sat.i64(i64 ");
                line.push_str(a);
                line.push_str(", i64 ");
                line.push_str(b);
                line.push_str(")");
                self.emit(line.as_str());
            } else {
                let pair: String = self.t();
                let v: String = self.t();
                let ovf: String = self.t();
                let mut pl: String = types::cat5(pair.as_str(), " = call {i64, i1} @llvm.", sg.as_str(), "mul", ".with.overflow.i64(i64 ");
                pl.push_str(a);
                pl.push_str(", i64 ");
                pl.push_str(b);
                pl.push_str(")");
                self.emit(pl.as_str());
                self.emit(types::cat4(v.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 0").as_str());
                self.emit(types::cat4(ovf.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 1").as_str());
                let bound: String = if signed {
                    let x: String = self.t();
                    let neg: String = self.t();
                    let lim: String = self.t();
                    self.emit(types::cat5(x.as_str(), " = xor i64 ", a, ", ", b).as_str());
                    self.emit(types::cat4(neg.as_str(), " = icmp slt i64 ", x.as_str(), ", 0").as_str());
                    self.emit(types::cat4(lim.as_str(), " = select i1 ", neg.as_str(), ", i64 -9223372036854775808, i64 9223372036854775807").as_str());
                    lim
                } else {
                    String::from("-1")
                };
                self.emit(types::cat7(r.as_str(), " = select i1 ", ovf.as_str(), ", i64 ", bound.as_str(), ", i64 ", v.as_str()).as_str());
            }
            if body::bits(i) == 64 {
                return CVal::Imm(r);
            }
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, body::bits(i) as u64);
            if wrapping {
                let t1: String = self.t();
                let w1: String = self.t();
                let ext: String = if signed {
                    String::from("sext")
                } else {
                    String::from("zext")
                };
                self.emit(types::cat5(t1.as_str(), " = trunc i64 ", r.as_str(), " to i", wt.as_str()).as_str());
                self.emit(types::cat7(w1.as_str(), " = ", ext.as_str(), " i", wt.as_str(), " ", types::cat2(t1.as_str(), " to i64").as_str()).as_str());
                return CVal::Imm(w1);
            }
            let w2: String = self.t();
            if signed {
                let lo: String = self.t();
                self.emit(types::cat7(lo.as_str(), " = call i64 @llvm.smax.i64(i64 ", r.as_str(), ", i64 ", int_min(i).as_str(), ")", "").as_str());
                self.emit(types::cat7(w2.as_str(), " = call i64 @llvm.smin.i64(i64 ", lo.as_str(), ", i64 ", int_max(i).as_str(), ")", "").as_str());
            } else {
                self.emit(types::cat7(w2.as_str(), " = call i64 @llvm.umin.i64(i64 ", r.as_str(), ", i64 ", int_max(i).as_str(), ")", "").as_str());
            }
            CVal::Imm(w2)
        }

        #[summary("식 e의 값이 글인가 (stage0 is_text_expr): 낮추기 전의 타입으로")]
        #[effects(alloc)]
        fn is_text_expr(self: &Gen, e: &ast::Expr, tb: &lowered::Tables) -> bool {
            types::has(tb.text.as_slice(), body::span_key(e.span).as_str())
        }

        #[summary("break와 continue (stage0 jump): 레이블의 루프(없으면 가장 안쪽)로. break e는 값을 루프의 자리에 둔다")]
        #[effects(alloc)]
        fn jump(self: &mut Gen, e: &ast::Expr, label: &Option<ast::Ident>, value: &Option<Box<ast::Expr>>, brk: bool, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let want: String = label_name(label);
            let mut k: usize = self.loops.len();
            let mut found: bool = false;
            while k > 0 && !found
                invariant k <= self.loops.len(),
                decreases k,
            {
                k = k - 1;
                if want.len() == 0 || self.loops[k].label == want {
                    found = true;
                }
            }
            if !found || k >= self.loops.len() {
                return self.todo_expr("a `break` or `continue` outside a loop", e);
            }
            let v: CVal = match value {
                None => CVal::Unit,
                Some(x) => self.expr(&**x, ck, tb, f - 1),
            };
            if k >= self.loops.len() {
                return CVal::Never;
            }
            let slot: Option<String> = self.loops[k].slot.clone();
            let lt: String = self.loops[k].lt.clone();
            let target: String = if brk {
                self.loops[k].end.clone()
            } else {
                self.loops[k].head.clone()
            };
            if brk {
                self.store_result(&slot, &v, lt.as_str());
            }
            if self.exits_at(e.span, ck) {
                self.todo_at("a jump that drops owned values", e.span);
            }
            self.emit(types::cat2("br label %", target.as_str()).as_str());
            let after: String = self.l("after_jump");
            self.block(after.as_str());
            CVal::Never
        }

        #[summary("다음 레이블: base와 번호")]
        #[effects(alloc)]
        fn l(self: &mut Gen, base: &str) -> String {
            self.label = self.label.wrapping_add(1);
            let mut s: String = String::from(base);
            std::num::push_u64(&mut s, self.label as u64);
            s
        }

        #[summary("let 문장 (stage0 stmt의 Let): 스칼라, 단위 값, 스칼라 원소의 배열인 지역 변수")]
        #[effects(alloc)]
        fn let_stmt(self: &mut Gen, x: &ast::Let, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", x.span);
                return;
            }
            let t: ast::TypeKind = match self.local_ty(x.name.name.as_str(), tb) {
                None => lowered::lower(&x.ty.kind),
                Some(known) => known,
            };
            if body::is_array(&t) {
                if !scalar_array(&t) {
                    self.todo_at("a local array of values that are not scalars", x.span);
                    return;
                }
                let elem: String = elem_kind(&elem_of(&t));
                let n: String = array_len_text(&t);
                let aptr: String = self.alloca(types::cat5("[", n.as_str(), " x ", mem(elem.as_str()).as_str(), "]").as_str());
                self.init_array(&x.init, aptr.as_str(), elem.as_str(), ck, tb, f - 1);
                self.slots.insert(x.name.name.as_str(), Slot::Arr(ArrSlot { ptr: aptr, len: n, elem: elem, ety: elem_of(&t) }));
                return;
            }
            if is_mem(&t) || body::is_ref(&t) {
                self.todo_at("a local that is not a scalar or an array", x.span);
                return;
            }
            if decls::is_unit(&t) {
                let unit_v: CVal = self.expr(&x.init, ck, tb, f - 1);
                return;
            }
            let lt: String = llty(&t);
            let ptr: String = self.alloca(lt.as_str());
            let v: String = imm(&self.expr(&x.init, ck, tb, f - 1));
            self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", ptr.as_str(), "").as_str());
            self.slots.insert(x.name.name.as_str(), Slot::Scalar(ptr, lt));
        }

        #[summary("원소를 읽는다 (stage0 load_elem): bool과 좁은 정수는 메모리에서 제 폭이고 레지스터로 넓힌다. 넓히지 않아도 번호 하나를 쓴다 (stage0과 같은 번호)")]
        #[effects(alloc)]
        fn load_elem(self: &mut Gen, elem: &str, ptr: &str) -> String {
            let r: String = self.t();
            let mut al: String = String::new();
            std::num::push_u64(&mut al, align(elem) as u64);
            self.emit(types::cat7(r.as_str(), " = load ", mem(elem).as_str(), ", ptr ", ptr, ", align ", al.as_str()).as_str());
            let b: String = self.t();
            if elem == "i1" {
                self.emit(types::cat4(b.as_str(), " = trunc i8 ", r.as_str(), " to i1").as_str());
                return b;
            }
            let bits: u32 = narrow_bits(elem);
            if bits == 0 {
                return r;
            }
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, bits as u64);
            let ext: String = if narrow_signed(elem) {
                String::from("sext")
            } else {
                String::from("zext")
            };
            self.emit(types::cat7(b.as_str(), " = ", ext.as_str(), " i", wt.as_str(), " ", types::cat2(r.as_str(), " to i64").as_str()).as_str());
            b
        }

        #[summary("지역 변수 name의 타입 (낮춘 표에서)")]
        #[effects(alloc)]
        fn local_ty(self: &Gen, name: &str, tb: &lowered::Tables) -> Option<ast::TypeKind> {
            match tb.locals.find(self.base.as_str()) {
                None => None,
                Some(at) => { match tb.locals.items[at].find(name) { None => None, Some(i) => Some(tb.locals.items[at].items[i].clone()), } },
            }
        }

        #[summary("loop 식 (stage0 loop_expr): break e의 값은 결과의 자리로. 끝나지 않는 loop의 값은 없다")]
        #[effects(alloc)]
        fn loop_expr(self: &mut Gen, e: &ast::Expr, x: &ast::Loop, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            let never: bool = body::is_never(&ty);
            if !never && (is_mem(&ty) || body::is_array(&ty) || body::is_ref(&ty)) {
                return self.todo_expr("a `loop` whose value is not a scalar", e);
            }
            let lt: String = llty(&ty);
            let slot: Option<String> = if never || decls::is_unit(&ty) || types::is_error(&ty) {
                None
            } else {
                Some(self.alloca(lt.as_str()))
            };
            let head: String = self.l("loop");
            let end: String = self.l("endloop");
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(head.as_str());
            let depth: usize = self.loops.len();
            self.loops.push(GLoop { label: label_name(&x.label), head: head.clone(), end: end.clone(), slot: slot.clone(), lt: lt.clone() });
            let body_v: CVal = self.block_expr(&x.body, ck, tb, f - 1);
            self.loops.truncate(depth);
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(end.as_str());
            if never {
                return CVal::Never;
            }
            match &slot {
                None => CVal::Unit,
                Some(sl) => { let r: String = self.t(); self.emit(types::cat5(r.as_str(), " = load ", lt.as_str(), ", ptr ", sl.as_str()).as_str()); CVal::Imm(r) },
            }
        }

        #[summary("바이트 bytes개를 옮긴다 (겹치지 않는 자리 사이)")]
        #[effects(alloc)]
        fn memcpy(self: &mut Gen, dst: &str, src: &str, bytes: u64) -> () {
            let mut line: String = types::cat5("call void @llvm.memcpy.p0.p0.i64(ptr ", dst, ", ptr ", src, ", i64 ");
            std::num::push_u64(&mut line, bytes);
            line.push_str(", i1 false)");
            self.emit(line.as_str());
        }

        #[summary("메서드 호출 (stage0 expr의 Method 갈래들). 지금은 정수 변환의 unwrap, f64의 메서드, 정수의 비트·wrapping·saturating 메서드")]
        #[effects(alloc)]
        fn method(self: &mut Gen, e: &ast::Expr, mc: &ast::Method, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let name: String = mc.name.name.clone();
            match conv_parts(&*mc.recv) {
                None => {},
                Some(cv) => { if name != "unwrap" { return self.todo_expr("a conversion whose `Option` is kept", e); } let st: ast::TypeKind = self.ty(&cv.arg, tb); let v: String = imm(&self.expr(&cv.arg, ck, tb, f - 1)); if body::conv_obligation(&st, &ast::TypeKind::Int(cv.target)) { let c: String = self.in_range_of(v.as_str(), is_signed(&st), cv.target); self.check(c.as_str(), "conversion may be out of range"); } return CVal::Imm(v); },
            }
            let rt: ast::TypeKind = self.ty(&*mc.recv, tb);
            let vt: ast::TypeKind = lowered::value_ty(&rt);
            if name == "len" && mc.args.len() == 0 && (body::is_array(&vt) || is_array(&vt)) {
                let lv: CVal = self.expr(&*mc.recv, ck, tb, f - 1);
                if is_arr(&lv) {
                    return CVal::Imm(arr_len(&lv));
                }
                if is_never(&lv) {
                    return CVal::Never;
                }
                return self.todo_expr("the length of a value that is not an array or a slice", e);
            }
            if self.is_text_expr(&*mc.recv, tb) || body::is_ref(&rt) {
                return self.todo_expr("a method of text or of a reference", e);
            }
            if body::is_f64(&vt) {
                let fa: String = imm(&self.expr(&*mc.recv, ck, tb, f - 1));
                let fb: String = if mc.args.len() > 0 {
                    imm(&self.expr(&mc.args[0], ck, tb, f - 1))
                } else {
                    String::new()
                };
                return self.f64_method(name.as_str(), fa.as_str(), fb.as_str(), mc.args.len() > 0);
            }
            match body::int_of(&rt) {
                None => self.todo_expr("a method of a value that is not a scalar", e),
                Some(i) => { if name == "checked_shl" || name == "checked_shr" || name == "len" { return self.todo_expr("an integer method whose value is not a scalar", e); } let rv: String = imm(&self.expr(&*mc.recv, ck, tb, f - 1)); if name == "to_be_bytes" || name == "to_le_bytes" { return self.to_bytes(rv.as_str(), i, name == "to_le_bytes"); } if name == "is_power_of_two" { let ones: String = imm(&self.bit_method("count_ones", i, rv.as_str(), "")); let pr: String = self.t(); self.emit(types::cat4(pr.as_str(), " = icmp eq i64 ", ones.as_str(), ", 1").as_str()); return CVal::Imm(pr); } if body::bit_method(name.as_str()) > 0 { let n: String = if mc.args.len() > 0 { imm(&self.expr(&mc.args[0], ck, tb, f - 1)) } else { String::new() }; return self.bit_method(name.as_str(), i, rv.as_str(), n.as_str()); } if mc.args.len() != 1 { return self.todo_expr("an integer method without one argument", e); } let b: String = imm(&self.expr(&mc.args[0], ck, tb, f - 1)); self.int_method(e, name.as_str(), rv.as_str(), b.as_str(), i) },
            }
        }

        #[summary("64비트보다 좁은 정수의 산술 (stage0 narrow_arith): 64비트에서 셈하고 타입의 범위를 잰다")]
        #[effects(alloc)]
        fn narrow_arith(self: &mut Gen, inst: &str, a: &str, b: &str, i: ast::IntTy) -> CVal {
            let r: String = self.t();
            let flag: String = if inst == "mul" && !body::signed(i) {
                String::from("nuw")
            } else {
                String::from("nsw")
            };
            let mut line: String = types::cat5(r.as_str(), " = ", inst, " ", flag.as_str());
            line.push_str(" i64 ");
            line.push_str(a);
            line.push_str(", ");
            line.push_str(b);
            self.emit(line.as_str());
            let c: String = self.fits(r.as_str(), i);
            self.check(c.as_str(), types::cat5("`", inst, "` may overflow `", body::int_text(i).as_str(), "`").as_str());
            CVal::Imm(r)
        }

        #[summary("v를 제 폭 it로 자른 값 (stage0 bit_method의 narrow): 64비트면 그대로")]
        #[effects(alloc)]
        fn narrowed(self: &mut Gen, v: &str, w: u32, it: &str) -> String {
            if w == 64 {
                return String::from(v);
            }
            let t: String = self.t();
            self.emit(types::cat5(t.as_str(), " = trunc i64 ", v, " to ", it).as_str());
            t
        }

        #[summary("경로로 쓴 상수 (stage0 expr의 Path 갈래들): 정수 타입의 MIN·MAX, f64의 상수. 변형은 아직 옮기지 않았다")]
        #[effects(alloc)]
        fn path_const(self: &mut Gen, e: &ast::Expr, segs: &[ast::Ident]) -> CVal {
            if segs.len() == 2 {
                match ast::int_of(segs[0].name.as_str()) {
                    None => {},
                    Some(i) => { if segs[1].name == "MIN" { return CVal::Imm(int_min(i)); } if segs[1].name == "MAX" { return CVal::Imm(int_max(i)); } },
                }
                if segs[0].name == "f64" {
                    let bits: u64 = f64_named(segs[1].name.as_str());
                    if bits != 0 {
                        return CVal::Imm(f64_const(bits));
                    }
                }
            }
            self.todo_expr("a path that is not a scalar constant", e)
        }

        #[summary("호출의 경로가 가리키는 함수 (stage0 resolve): 제 단위의 것이 먼저")]
        #[effects(alloc)]
        fn resolve(self: &Gen, path: &[ast::Ident], tb: &lowered::Tables) -> String {
            let mut names: Vec<String> = Vec::new();
            for i in 0..path.len()
                invariant 0 <= i && i <= path.len(),
            {
                names.push(path[i].name.clone());
            }
            let name: String = types::join(names.as_slice(), "::");
            let local: String = types::cat3(self.unit.as_str(), "::", name.as_str());
            match tb.fns.find(local.as_str()) {
                None => name,
                Some(at) => { if path.len() == 1 || path.len() == 2 && (tb.fns.items[at].in_impl || has_trait(&tb.fns.items[at])) { local } else { name } },
            }
        }

        #[summary("return (stage0 return_expr): 값을 돌려주고, 뒤의 코드는 닿지 않는 블록에 둔다")]
        #[effects(alloc)]
        fn return_expr(self: &mut Gen, e: &ast::Expr, x: &Option<Box<ast::Expr>>, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let v: CVal = match x {
                None => CVal::Unit,
                Some(rv) => self.expr(&**rv, ck, tb, f - 1),
            };
            if self.exits_at(e.span, ck) {
                self.todo_at("a `return` that drops owned values", e.span);
            }
            self.emit_return(&v);
            let after: String = self.l("after_return");
            self.block(after.as_str());
            CVal::Never
        }

        #[summary("스칼라 참조 인자로 넘길 주소 (stage0 scalar_ref, 백로그 2T-08): 지역 변수나 참조 매개변수는 제 자리, 원소는 그 값을 담은 임시 자리이고 mutable이면 호출 뒤에 되돌려 쓴다, 값은 임시 자리. 필드는 아직 옮기지 않았다")]
        #[effects(alloc)]
        fn scalar_ref(self: &mut Gen, a: &ast::Expr, t: &ast::TypeKind, mutable: bool, backs: &mut Vec<Back>, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", a.span);
                return String::from("undef");
            }
            match &a.kind {
                ast::ExprKind::Int(sr_int0, sr_int1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Float(sr_float0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::ByteLit(sr_bytelit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::ByteStr(sr_bytestr0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::StrLit(sr_strlit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::CharLit(sr_charlit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Bool(sr_bool0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Unit => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Var(sr_var0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Call(sr_call0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Method(sr_method0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Index(sr_index0, sr_index1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Unary(sr_unary0, sr_unary1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Binary(sr_binary0, sr_binary1, sr_binary2) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Ref(sr_m, sr_x) => self.scalar_ref_of(&**sr_x, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::If(sr_if0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Block(sr_block0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Array(sr_array0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Repeat(sr_repeat0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Old(sr_old0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Quant(sr_quant0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Trigger(sr_trigger0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Closure(sr_closure0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::StructLit(sr_structlit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Path(sr_path0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Deref(sr_deref0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Field(sr_field0, sr_field1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Match(sr_match0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Return(sr_return0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Try(sr_try0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Loop(sr_loop0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Break(sr_break0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Continue(sr_continue0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Range(sr_range0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Error => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
            }
        }

        #[summary("scalar_ref의 &를 벗긴 식")]
        #[effects(alloc)]
        fn scalar_ref_of(self: &mut Gen, inner: &ast::Expr, t: &ast::TypeKind, mutable: bool, backs: &mut Vec<Back>, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", inner.span);
                return String::from("undef");
            }
            match var_name(inner) {
                None => {},
                Some(name) => { match self.scalar_slot(name.as_str()) { None => {}, Some(slot) => { return slot.ptr; }, } },
            }
            let lt: String = llty(t);
            let tmp: String = self.alloca(lt.as_str());
            match &inner.kind {
                ast::ExprKind::Int(so_int0, so_int1) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Float(so_float0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::ByteLit(so_bytelit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::ByteStr(so_bytestr0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::StrLit(so_strlit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::CharLit(so_charlit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Bool(so_bool0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Unit => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Var(so_id) => { self.todo_at("a reference to a local that is not a scalar", inner.span); tmp },
                ast::ExprKind::Call(so_call0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Method(so_method0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Index(ib, ii) => { match var_name(&**ib) { None => { self.todo_at("a reference to an element of a place that is not a local", inner.span); tmp }, Some(bn) => { let ep: ElemPtr = self.elem_ptr(inner, &**ib, &**ii, ck, tb, f - 1); if ep.ptr == "undef" { return tmp; } let ev: String = self.load_elem(ep.elem.as_str(), ep.ptr.as_str()); self.emit(types::cat7("store ", lt.as_str(), " ", ev.as_str(), ", ptr ", tmp.as_str(), "").as_str()); if mutable { backs.push(Back { tmp: tmp.clone(), elem: ep.elem.clone(), ptr: ep.ptr.clone(), lt: lt.clone() }); } tmp }, } },
                ast::ExprKind::Unary(so_unary0, so_unary1) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Binary(so_binary0, so_binary1, so_binary2) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Ref(so_m, so_r) => { self.todo_at("a reference to a reference", inner.span); tmp },
                ast::ExprKind::If(so_if0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Block(so_block0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Array(so_array0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Repeat(so_repeat0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Old(so_old0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Quant(so_quant0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Trigger(so_trigger0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Closure(so_closure0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::StructLit(so_structlit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Path(so_path0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Deref(so_d) => { self.todo_at("a reference to a place behind a reference", inner.span); tmp },
                ast::ExprKind::Field(so_b, so_n) => { self.todo_at("a reference to a field", inner.span); tmp },
                ast::ExprKind::Match(so_match0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Return(so_return0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Try(so_try0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Loop(so_loop0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Break(so_break0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Continue(so_continue0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Range(so_range0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Error => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
            }
        }

        #[summary("스칼라 지역 변수 name의 자리와 레지스터 타입")]
        #[effects(alloc)]
        fn scalar_slot(self: &Gen, name: &str) -> Option<ScalarSlot> {
            match self.slots.find(name) {
                None => None,
                Some(at) => { match &self.slots.items[at] { Slot::Scalar(ptr, ty) => Some(ScalarSlot { ptr: ptr.clone(), ty: ty.clone() }), Slot::Arr(sl_a) => None, } },
            }
        }

        #[summary("시프트 (stage0 shift, shift_inst): 양이 폭보다 작은 리터럴이 아니면 잰다. 좁은 타입의 왼쪽 시프트는 제 폭으로 자르고 다시 넓힌다")]
        #[effects(alloc)]
        fn shift(self: &mut Gen, op: ast::BinOp, i: ast::IntTy, a: &str, r: &ast::Expr, b: &str) -> CVal {
            let w: u32 = body::bits(i);
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, w as u64);
            let literal: bool = match int_lit(r) {
                None => false,
                Some(k) => k.hi == 0 && k.lo < w as u64,
            };
            if !literal {
                let c: String = self.t();
                self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", b, ", ", wt.as_str()).as_str());
                self.check(c.as_str(), types::cat2("shift amount out of 0..", wt.as_str()).as_str());
            }
            self.shift_inst(op, i, a, b)
        }

        #[summary("시프트의 명령 (stage0 shift_inst): 좁은 타입의 왼쪽 시프트는 제 폭으로 자르고 다시 넓힌다")]
        #[effects(alloc)]
        fn shift_inst(self: &mut Gen, op: ast::BinOp, i: ast::IntTy, a: &str, b: &str) -> CVal {
            let w: u32 = body::bits(i);
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, w as u64);
            let res: String = self.t();
            if is_shr(op) {
                let inst: String = if body::signed(i) {
                    String::from("ashr")
                } else {
                    String::from("lshr")
                };
                self.emit(types::cat7(res.as_str(), " = ", inst.as_str(), " i64 ", a, ", ", b).as_str());
            } else if w == 64 {
                self.emit(types::cat5(res.as_str(), " = shl i64 ", a, ", ", b).as_str());
            } else {
                let wide: String = self.t();
                let narrow: String = self.t();
                self.emit(types::cat5(wide.as_str(), " = shl i64 ", a, ", ", b).as_str());
                self.emit(types::cat5(narrow.as_str(), " = trunc i64 ", wide.as_str(), " to i", wt.as_str()).as_str());
                let ext: String = if body::signed(i) {
                    String::from("sext")
                } else {
                    String::from("zext")
                };
                let mut line: String = types::cat5(res.as_str(), " = ", ext.as_str(), " i", wt.as_str());
                line.push_str(" ");
                line.push_str(narrow.as_str());
                line.push_str(" to i64");
                self.emit(line.as_str());
            }
            CVal::Imm(res)
        }

        #[summary("문장 (stage0 stmt). 지금은 let, 대입, 식 문장, 코드가 없는 증명 문장")]
        #[effects(alloc)]
        fn stmt(self: &mut Gen, st: &ast::Stmt, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo.push(types::cat2("nesting too deep in ", self.path.as_str()));
                return;
            }
            match st {
                ast::Stmt::Let(x) => self.let_stmt(x, ck, tb, f - 1),
                ast::Stmt::Assign(a) => self.assign(a, ck, tb, f - 1),
                ast::Stmt::While(w) => self.while_stmt(w, ck, tb, f - 1),
                ast::Stmt::For(fo) => self.for_stmt(fo, ck, tb, f - 1),
                ast::Stmt::Assert(st_a) => {},
                ast::Stmt::Assume(st_u) => {},
                ast::Stmt::Proof(st_p) => {},
                ast::Stmt::LetFields(lf) => self.todo_at("a `let` of fields", lf.span),
                ast::Stmt::Expr(ex) => { let v: CVal = self.expr(ex, ck, tb, f - 1); },
            }
        }

        #[summary("원소를 쓴다 (stage0 store_elem): bool과 좁은 정수는 제 폭으로 줄여 쓴다")]
        #[effects(alloc)]
        fn store_elem(self: &mut Gen, elem: &str, v: &str, ptr: &str) -> () {
            let mut al: String = String::new();
            std::num::push_u64(&mut al, align(elem) as u64);
            if elem == "i1" || narrow_bits(elem) > 0 {
                let z: String = self.t();
                let m: String = mem(elem);
                let op: String = if elem == "i1" {
                    String::from("zext i1")
                } else {
                    String::from("trunc i64")
                };
                self.emit(types::cat7(z.as_str(), " = ", op.as_str(), " ", v, " to ", m.as_str()).as_str());
                self.emit(types::cat7("store ", m.as_str(), " ", z.as_str(), ", ptr ", ptr, types::cat2(", align ", al.as_str()).as_str()).as_str());
            } else {
                self.emit(types::cat7("store ", elem, " ", v, ", ptr ", ptr, types::cat2(", align ", al.as_str()).as_str()).as_str());
            }
        }

        #[summary("if의 한 갈래의 값을 결과의 자리에 (stage0 store_result): 끝나지 않는 값과 자리 없는 결과는 쓰지 않는다")]
        #[effects(alloc)]
        fn store_result(self: &mut Gen, slot: &Option<String>, v: &CVal, lt: &str) -> () {
            match slot {
                None => {},
                Some(sl) => { match v { CVal::Imm(x) => self.emit(types::cat7("store ", lt, " ", x.as_str(), ", ptr ", sl.as_str(), "").as_str()), CVal::Arr(sr_p, sr_n) => {}, CVal::Unit => self.emit(types::cat5("store ", lt, " 0, ptr ", sl.as_str(), "").as_str()), CVal::Never => {}, } },
            }
        }

        #[summary("다음 %tN")]
        #[effects(alloc)]
        fn t(self: &mut Gen) -> String {
            self.tmp = self.tmp.wrapping_add(1);
            let mut s: String = String::from("%t");
            std::num::push_u64(&mut s, self.tmp as u64);
            s
        }

        #[summary("t의 값 하나의 자리 (stage0 temp)")]
        #[effects(alloc)]
        fn temp(self: &mut Gen, t: &ast::TypeKind) -> String {
            self.alloca(mem_ty(t).as_str())
        }

        #[summary("정수의 바이트들 (stage0 expr의 to_be_bytes·to_le_bytes, 백로그 2N-09c): 바이트마다 레지스터를 오른쪽으로 밀어 잘라 쓴다")]
        #[effects(alloc)]
        fn to_bytes(self: &mut Gen, a: &str, i: ast::IntTy, le: bool) -> CVal {
            let n: u32 = body::bits(i) / 8;
            let mut nt: String = String::new();
            std::num::push_u64(&mut nt, n as u64);
            let ptr: String = self.alloca(types::cat3("[", nt.as_str(), " x i8]").as_str());
            for k in 0..n
                invariant 0 <= k && k <= n,
            {
                let sh: u32 = if le {
                    k.wrapping_mul(8)
                } else {
                    n.wrapping_sub(1).wrapping_sub(k).wrapping_mul(8)
                };
                let v: String = if sh == 0 {
                    String::from(a)
                } else {
                    let sv: String = self.t();
                    let mut st: String = String::new();
                    std::num::push_u64(&mut st, sh as u64);
                    self.emit(types::cat5(sv.as_str(), " = lshr i64 ", a, ", ", st.as_str()).as_str());
                    sv
                };
                let p: String = self.t();
                let mut kt: String = String::new();
                std::num::push_u64(&mut kt, k as u64);
                self.emit(types::cat7(p.as_str(), " = getelementptr inbounds [", nt.as_str(), " x i8], ptr ", ptr.as_str(), ", i64 0, i64 ", kt.as_str()).as_str());
                self.store_elem("u8", v.as_str(), p.as_str());
            }
            CVal::Arr(ptr, nt)
        }

        #[summary("옮기지 않은 구문 what을 자리 s에서 만났다고 적는다")]
        #[effects(alloc)]
        fn todo_at(self: &mut Gen, what: &str, s: source::Span) -> () {
            let mut m: String = String::from(what);
            m.push_str(" in ");
            m.push_str(self.path.as_str());
            m.push_str(" at bytes ");
            std::num::push_u64(&mut m, s.lo as u64);
            m.push_str("..");
            std::num::push_u64(&mut m, s.hi as u64);
            self.todo.push(m);
        }

        #[summary("옮기지 않은 식: 까닭을 적고 끝나지 않는 값으로 둔다")]
        #[effects(alloc)]
        fn todo_expr(self: &mut Gen, what: &str, e: &ast::Expr) -> CVal {
            self.todo_at(what, e.span);
            CVal::Never
        }

        #[summary("식 e의 타입 (낮춘 표에서)")]
        #[effects(alloc)]
        fn ty(self: &Gen, e: &ast::Expr, tb: &lowered::Tables) -> ast::TypeKind {
            match tb.types.find(body::span_key(e.span).as_str()) {
                None => ast::TypeKind::Error,
                Some(at) => tb.types.items[at].clone(),
            }
        }

        #[summary("단항 연산 (stage0 expr의 Unary 갈래들): 부호 바꿈은 리터럴이면 그 글, f64면 fneg, 정수면 0에서 뺀다. !는 bool이면 뒤집고 정수면 제 폭의 비트를 뒤집는다")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn unary(self: &mut Gen, e: &ast::Expr, op: ast::UnOp, x: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let xt: ast::TypeKind = self.ty(x, tb);
            if is_neg(op) {
                if body::is_f64(&xt) {
                    match float_lit(x) {
                        None => {},
                        Some(bits) => { return CVal::Imm(f64_const(bits ^ 9223372036854775808)); },
                    }
                    let fv: String = imm(&self.expr(x, ck, tb, f - 1));
                    let fr: String = self.t();
                    self.emit(types::cat3(fr.as_str(), " = fneg double ", fv.as_str()).as_str());
                    return CVal::Imm(fr);
                }
                match int_lit(x) {
                    None => {},
                    Some(k) => { let mut s: String = String::from("-"); wide::push_radix(&mut s, k, 10); return CVal::Imm(s); },
                }
                let v: String = imm(&self.expr(x, ck, tb, f - 1));
                return match body::int_of(&self.ty(e, tb)) { None => self.arith("sub", "0", v.as_str(), true), Some(i) => { if body::bits(i) < 64 { self.narrow_arith("sub", "0", v.as_str(), i) } else { self.arith("sub", "0", v.as_str(), true) } }, };
            }
            let nv: String = imm(&self.expr(x, ck, tb, f - 1));
            let r: String = self.t();
            match body::int_of(&xt) {
                None => self.emit(types::cat4(r.as_str(), " = xor i1 ", nv.as_str(), ", true").as_str()),
                Some(i) => { if body::signed(i) { self.emit(types::cat4(r.as_str(), " = xor i64 ", nv.as_str(), ", -1").as_str()); } else { self.emit(types::cat5(r.as_str(), " = xor i64 ", nv.as_str(), ", ", int_max(i).as_str()).as_str()); } },
            }
            CVal::Imm(r)
        }

        #[summary("while 문장 (stage0 stmt의 While)")]
        #[effects(alloc)]
        fn while_stmt(self: &mut Gen, x: &ast::While, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", x.span);
                return;
            }
            let head: String = self.l("while");
            let lb: String = self.l("body");
            let end: String = self.l("endwhile");
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(head.as_str());
            let c: String = imm(&self.expr(&x.cond, ck, tb, f - 1));
            self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str());
            self.block(lb.as_str());
            let depth: usize = self.loops.len();
            self.loops.push(GLoop { label: label_name(&x.label), head: head.clone(), end: end.clone(), slot: None, lt: String::new() });
            let body_v: CVal = self.block_expr(&x.body, ck, tb, f - 1);
            self.loops.truncate(depth);
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(end.as_str());
        }
    }

    #[summary("메모리에서의 크기와 정렬 (x86-64의 C 배치)")]
    struct Lay { size: u64, align: u64 }

    #[summary("모듈 (stage0 Module): IR의 글, 진입점, 옮기지 않은 구문을 만난 까닭들")]
    struct Module { ir: String, main: Option<String>, todo: Vec<String> }

    #[summary("스칼라 지역 변수의 자리: 자리의 이름과 레지스터 타입")]
    struct ScalarSlot { ptr: String, ty: String }

    #[summary("지역 이름의 자리 (stage0 Slot). 스칼라: 자리의 이름과 레지스터 타입. 배열과 슬라이스: ArrSlot")]
    enum Slot { Scalar(String, String), Arr(ArrSlot) }

    #[summary("원소 종류 elem의 메모리 정렬 (stage0 align): i1은 1, 좁은 정수는 제 폭, 나머지는 8")]
    #[effects(pure)]
    fn align(elem: &str) -> u32 {
        if elem == "i1" {
            return 1;
        }
        let b: u32 = narrow_bits(elem);
        if b == 0 {
            8
        } else {
            b / 8
        }
    }

    #[summary("bits 비트가 모두 1인 수의 글 (2^bits - 1)")]
    #[effects(alloc)]
    fn all_ones(bits: u32) -> String {
        if bits == 8 {
            return String::from("255");
        }
        if bits == 16 {
            return String::from("65535");
        }
        if bits == 32 {
            return String::from("4294967295");
        }
        String::from("18446744073709551615")
    }

    #[summary("프로그램의 값들의 타입 (stage0 all_types): 식, 지역 변수, 내장이 아닌 함수의 시그니처에 나오는 타입을 한 번씩, 타입의 글 순서로 (소스의 자리 순서가 아니다: fmt 전후의 IR이 같다, 백로그 4D-38)")]
    #[effects(alloc)]
    fn all_types(tb: &lowered::Tables) -> Vec<ast::TypeKind> {
        let mut by_text: table::Table<ast::TypeKind> = table::new::<ast::TypeKind>();
        for n in 0..tb.types.len()
            invariant 0 <= n,
        {
            match tb.types.nth(n) {
                None => {},
                Some(at) => by_text.insert(types::text(&tb.types.items[at]).as_str(), tb.types.items[at].clone()),
            }
        }
        for n in 0..tb.locals.len()
            invariant 0 <= n,
        {
            match tb.locals.nth(n) {
                None => {},
                Some(at) => { for v in 0..tb.locals.items[at].len() invariant 0 <= v, { match tb.locals.items[at].nth(v) { None => {}, Some(i) => by_text.insert(types::text(&tb.locals.items[at].items[i]).as_str(), tb.locals.items[at].items[i].clone()), } } },
            }
        }
        for n in 0..tb.fns.len()
            invariant 0 <= n,
        {
            match tb.fns.nth(n) {
                None => {},
                Some(at) => { if !tb.fns.items[at].builtin { for k in 0..tb.fns.items[at].params.len() invariant 0 <= k && k <= tb.fns.items[at].params.len(), { by_text.insert(types::text(&tb.fns.items[at].params[k]).as_str(), tb.fns.items[at].params[k].clone()); } by_text.insert(types::text(&tb.fns.items[at].ret).as_str(), tb.fns.items[at].ret.clone()); } },
            }
        }
        let mut all: Vec<ast::TypeKind> = Vec::new();
        for n in 0..by_text.len()
            invariant 0 <= n,
        {
            match by_text.nth(n) {
                None => {},
                Some(at) => all.push(by_text.items[at].clone()),
            }
        }
        all
    }

    #[summary("배열 값의 길이의 글. 배열 값이 아니면 undef")]
    #[effects(alloc)]
    fn arr_len(v: &CVal) -> String {
        match v {
            CVal::Imm(al_x) => String::from("undef"),
            CVal::Arr(p, n) => n.clone(),
            CVal::Unit => String::from("undef"),
            CVal::Never => String::from("undef"),
        }
    }

    #[summary("배열 값의 첫 원소의 주소. 배열 값이 아니면 undef")]
    #[effects(alloc)]
    fn arr_ptr(v: &CVal) -> String {
        match v {
            CVal::Imm(ap_x) => String::from("undef"),
            CVal::Arr(p, n) => p.clone(),
            CVal::Unit => String::from("undef"),
            CVal::Never => String::from("undef"),
        }
    }

    #[summary("배열 타입의 길이의 글. 배열 타입이 아니면 0")]
    #[effects(alloc)]
    fn array_len_text(t: &ast::TypeKind) -> String {
        let mut s: String = String::new();
        match t {
            ast::TypeKind::Int(alt_int0) => s.push_str("0"),
            ast::TypeKind::F64 => s.push_str("0"),
            ast::TypeKind::Bool => s.push_str("0"),
            ast::TypeKind::Unit => s.push_str("0"),
            ast::TypeKind::Char => s.push_str("0"),
            ast::TypeKind::String => s.push_str("0"),
            ast::TypeKind::Str => s.push_str("0"),
            ast::TypeKind::Array(alt_e, n) => std::num::push_u64(&mut s, *n),
            ast::TypeKind::ArrayN(alt_arrayn0, alt_arrayn1) => s.push_str("0"),
            ast::TypeKind::Slice(alt_slice0) => s.push_str("0"),
            ast::TypeKind::Ref(alt_ref0, alt_ref1) => s.push_str("0"),
            ast::TypeKind::Named(alt_named0, alt_named1) => s.push_str("0"),
            ast::TypeKind::Vec(alt_vec0) => s.push_str("0"),
            ast::TypeKind::Box(alt_box0) => s.push_str("0"),
            ast::TypeKind::Param(alt_param0) => s.push_str("0"),
            ast::TypeKind::Never => s.push_str("0"),
            ast::TypeKind::Error => s.push_str("0"),
        }
        s
    }

    #[summary("비트 연산의 명령: and, or, xor")]
    #[effects(alloc)]
    fn bit_inst(op: ast::BinOp) -> String {
        match op {
            ast::BinOp::Add => String::from("xor"),
            ast::BinOp::Sub => String::from("xor"),
            ast::BinOp::Mul => String::from("xor"),
            ast::BinOp::Div => String::from("xor"),
            ast::BinOp::Rem => String::from("xor"),
            ast::BinOp::Eq => String::from("xor"),
            ast::BinOp::Ne => String::from("xor"),
            ast::BinOp::Lt => String::from("xor"),
            ast::BinOp::Le => String::from("xor"),
            ast::BinOp::Gt => String::from("xor"),
            ast::BinOp::Ge => String::from("xor"),
            ast::BinOp::And => String::from("xor"),
            ast::BinOp::Or => String::from("xor"),
            ast::BinOp::Implies => String::from("xor"),
            ast::BinOp::BitAnd => String::from("and"),
            ast::BinOp::BitOr => String::from("or"),
            ast::BinOp::BitXor => String::from("xor"),
            ast::BinOp::Shl => String::from("xor"),
            ast::BinOp::Shr => String::from("xor"),
        }
    }

    #[summary("상수 원소 하나 (stage0 const_elems의 한 원소): 정수 리터럴과 그 부호 바꿈 (i128에 드는 것), bool, char, 바이트 리터럴. 아니면 None")]
    #[effects(alloc)]
    fn const_elem(e: &ast::Expr) -> Option<ConstElem> {
        match &e.kind {
            ast::ExprKind::Int(v, ce_r) => { if v.hi < 9223372036854775808 { Some(ConstElem { neg: false, mag: v.lo }) } else { None } },
            ast::ExprKind::Float(ce_float0) => None,
            ast::ExprKind::ByteLit(b) => Some(ConstElem { neg: false, mag: *b as u64 }),
            ast::ExprKind::ByteStr(ce_bytestr0) => None,
            ast::ExprKind::StrLit(ce_strlit0) => None,
            ast::ExprKind::CharLit(c) => Some(ConstElem { neg: false, mag: *c as u64 }),
            ast::ExprKind::Bool(on) => { if *on { Some(ConstElem { neg: false, mag: 1 }) } else { Some(ConstElem { neg: false, mag: 0 }) } },
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(ce_var0) => None,
            ast::ExprKind::Call(ce_call0) => None,
            ast::ExprKind::Method(ce_method0) => None,
            ast::ExprKind::Index(ce_index0, ce_index1) => None,
            ast::ExprKind::Unary(op, x) => { if is_neg(*op) { match int_lit(&**x) { None => None, Some(k) => { if k.hi < 9223372036854775808 { Some(ConstElem { neg: true, mag: k.lo }) } else { None } }, } } else { None } },
            ast::ExprKind::Binary(ce_binary0, ce_binary1, ce_binary2) => None,
            ast::ExprKind::Ref(ce_ref0, ce_ref1) => None,
            ast::ExprKind::If(ce_if0) => None,
            ast::ExprKind::Block(ce_block0) => None,
            ast::ExprKind::Array(ce_array0) => None,
            ast::ExprKind::Repeat(ce_repeat0) => None,
            ast::ExprKind::Old(ce_old0) => None,
            ast::ExprKind::Quant(ce_quant0) => None,
            ast::ExprKind::Trigger(ce_trigger0) => None,
            ast::ExprKind::Closure(ce_closure0) => None,
            ast::ExprKind::StructLit(ce_structlit0) => None,
            ast::ExprKind::Path(ce_path0) => None,
            ast::ExprKind::Deref(ce_deref0) => None,
            ast::ExprKind::Field(ce_field0, ce_field1) => None,
            ast::ExprKind::Match(ce_match0) => None,
            ast::ExprKind::Return(ce_return0) => None,
            ast::ExprKind::Try(ce_try0) => None,
            ast::ExprKind::Loop(ce_loop0) => None,
            ast::ExprKind::Break(ce_break0) => None,
            ast::ExprKind::Continue(ce_continue0) => None,
            ast::ExprKind::Range(ce_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("배열 리터럴의 원소가 모두 상수면 그 값들 (stage0 const_elems)")]
    #[effects(alloc)]
    fn const_elems(items: &[ast::Expr]) -> Option<Vec<ConstElem>> {
        let mut out: Vec<ConstElem> = Vec::new();
        for i in 0..items.len()
            invariant 0 <= i && i <= items.len(),
        {
            match const_elem(&items[i]) {
                None => { return None; },
                Some(c) => out.push(c),
            }
        }
        Some(out)
    }

    #[summary("상수 원소의 글 (stage0 init_array의 상수 갈래): bits 비트로 감은 값을 부호 있는 수로 적는다")]
    #[effects(alloc)]
    fn const_text(c: &ConstElem, bits: u32) -> String {
        let raw: u64 = if c.neg {
            (0 as u64).wrapping_sub(c.mag)
        } else {
            c.mag
        };
        let mut s: String = String::new();
        if bits >= 64 {
            if raw >= 9223372036854775808 {
                s.push_str("-");
                std::num::push_u64(&mut s, (0 as u64).wrapping_sub(raw));
            } else {
                std::num::push_u64(&mut s, raw);
            }
            return s;
        }
        let mask: u64 = if bits == 8 {
            255
        } else if bits == 16 {
            65535
        } else {
            4294967295
        };
        let r: u64 = raw & mask;
        let half: u64 = (mask / 2).wrapping_add(1);
        if r >= half {
            s.push_str("-");
            std::num::push_u64(&mut s, mask.wrapping_sub(r).wrapping_add(1));
        } else {
            std::num::push_u64(&mut s, r);
        }
        s
    }

    #[summary("e가 T::try_from(x)면 (T는 정수 타입) T와 x (stage0 check::conv_call)")]
    #[effects(alloc)]
    fn conv_parts(e: &ast::Expr) -> Option<Conv> {
        match &e.kind {
            ast::ExprKind::Int(cp_int0, cp_int1) => None,
            ast::ExprKind::Float(cp_float0) => None,
            ast::ExprKind::ByteLit(cp_bytelit0) => None,
            ast::ExprKind::ByteStr(cp_bytestr0) => None,
            ast::ExprKind::StrLit(cp_strlit0) => None,
            ast::ExprKind::CharLit(cp_charlit0) => None,
            ast::ExprKind::Bool(cp_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(cp_var0) => None,
            ast::ExprKind::Call(c) => { if c.path.len() == 2 && c.path[1].name == "try_from" && c.args.len() == 1 { match ast::int_of(c.path[0].name.as_str()) { None => None, Some(i) => Some(Conv { target: i, arg: c.args[0].clone() }), } } else { None } },
            ast::ExprKind::Method(cp_method0) => None,
            ast::ExprKind::Index(cp_index0, cp_index1) => None,
            ast::ExprKind::Unary(cp_unary0, cp_unary1) => None,
            ast::ExprKind::Binary(cp_binary0, cp_binary1, cp_binary2) => None,
            ast::ExprKind::Ref(cp_ref0, cp_ref1) => None,
            ast::ExprKind::If(cp_if0) => None,
            ast::ExprKind::Block(cp_block0) => None,
            ast::ExprKind::Array(cp_array0) => None,
            ast::ExprKind::Repeat(cp_repeat0) => None,
            ast::ExprKind::Old(cp_old0) => None,
            ast::ExprKind::Quant(cp_quant0) => None,
            ast::ExprKind::Trigger(cp_trigger0) => None,
            ast::ExprKind::Closure(cp_closure0) => None,
            ast::ExprKind::StructLit(cp_structlit0) => None,
            ast::ExprKind::Path(cp_path0) => None,
            ast::ExprKind::Deref(cp_deref0) => None,
            ast::ExprKind::Field(cp_field0, cp_field1) => None,
            ast::ExprKind::Match(cp_match0) => None,
            ast::ExprKind::Return(cp_return0) => None,
            ast::ExprKind::Try(cp_try0) => None,
            ast::ExprKind::Loop(cp_loop0) => None,
            ast::ExprKind::Break(cp_break0) => None,
            ast::ExprKind::Continue(cp_continue0) => None,
            ast::ExprKind::Range(cp_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("구조체나 열거형의 LLVM 타입 (stage0 data_ty): %\"geo::Point\"")]
    #[effects(alloc)]
    fn data_ty(t: &ast::TypeKind) -> String {
        types::cat3("%\"", types::text(&lowered::value_ty(t)).as_str(), "\"")
    }

    #[summary("십진수의 글의 값 (넘치면 감긴다). 숫자가 아닌 글자가 있으면 0 (stage0의 parse().unwrap_or(0))")]
    #[effects(pure)]
    fn dec(s: &str) -> u64 {
        let mut v: u64 = 0;
        for i in 0..s.len()
            invariant 0 <= i && i <= s.len(),
        {
            let b: u8 = s.as_bytes()[i];
            if b < 48 || b > 57 {
                return 0;
            }
            v = v.wrapping_mul(10).wrapping_add((b - 48) as u64);
        }
        v
    }

    #[summary("원소 종류 (stage0 elem_kind): 64비트보다 좁은 정수는 제 이름, 나머지는 레지스터 타입")]
    #[effects(alloc)]
    fn elem_kind(t: &ast::TypeKind) -> String {
        match t {
            ast::TypeKind::Int(it) => { if body::bits(*it) < 64 { body::int_text(*it) } else { llty(t) } },
            ast::TypeKind::F64 => llty(t),
            ast::TypeKind::Bool => llty(t),
            ast::TypeKind::Unit => llty(t),
            ast::TypeKind::Char => llty(t),
            ast::TypeKind::String => llty(t),
            ast::TypeKind::Str => llty(t),
            ast::TypeKind::Array(ek_array0, ek_array1) => llty(t),
            ast::TypeKind::ArrayN(ek_arrayn0, ek_arrayn1) => llty(t),
            ast::TypeKind::Slice(ek_slice0) => llty(t),
            ast::TypeKind::Ref(ek_ref0, ek_ref1) => llty(t),
            ast::TypeKind::Named(ek_named0, ek_named1) => llty(t),
            ast::TypeKind::Vec(ek_vec0) => llty(t),
            ast::TypeKind::Box(ek_box0) => llty(t),
            ast::TypeKind::Param(ek_param0) => llty(t),
            ast::TypeKind::Never => llty(t),
            ast::TypeKind::Error => llty(t),
        }
    }

    #[summary("배열, 슬라이스, Vec의 원소 타입 (stage0 elem_of). 다른 참조는 가리키는 타입, 나머지는 그대로")]
    #[effects(alloc)]
    fn elem_of(t: &ast::TypeKind) -> ast::TypeKind {
        match t {
            ast::TypeKind::Int(eo_int0) => t.clone(),
            ast::TypeKind::F64 => t.clone(),
            ast::TypeKind::Bool => t.clone(),
            ast::TypeKind::Unit => t.clone(),
            ast::TypeKind::Char => t.clone(),
            ast::TypeKind::String => t.clone(),
            ast::TypeKind::Str => t.clone(),
            ast::TypeKind::Array(ae, eo_n) => ae.kind.clone(),
            ast::TypeKind::ArrayN(eo_arrayn0, eo_arrayn1) => t.clone(),
            ast::TypeKind::Slice(eo_slice0) => t.clone(),
            ast::TypeKind::Ref(eo_m, ri) => { match body::slice_elem(&ri.kind) { None => { match body::vec_elem(&ri.kind) { None => ri.kind.clone(), Some(e2) => e2, } }, Some(e1) => e1, } },
            ast::TypeKind::Named(eo_named0, eo_named1) => t.clone(),
            ast::TypeKind::Vec(ve) => ve.kind.clone(),
            ast::TypeKind::Box(eo_box0) => t.clone(),
            ast::TypeKind::Param(eo_param0) => t.clone(),
            ast::TypeKind::Never => t.clone(),
            ast::TypeKind::Error => t.clone(),
        }
    }

    #[summary("프로그램의 모듈 (stage0 emit_with, 전체 검사 모드): 머리, 타입 정의, 제네릭 아닌 실행 함수를 경로 순서로, @main. 옮기지 않은 구문을 만나면 todo에 까닭이 남는다")]
    #[effects(alloc)]
    fn emit(ck: &body::Checked, tb: &lowered::Tables) -> Module {
        let mut todo: Vec<String> = Vec::new();
        let mut ir: String = codegen_text::head();
        let all: Vec<ast::TypeKind> = all_types(tb);
        let none: Vec<String> = Vec::new();
        let mut heap: bool = false;
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            if holds_vec(&all[i], tb) || types::is_move_in(&lowered::value_ty(&all[i]), &tb.adts, none.as_slice()) {
                heap = true;
            }
        }
        if heap {
            todo.push(String::from("a program with owned heap values (backlog 4D-05e)"));
        }
        ir.push_str(type_defs(tb).as_str());
        ir.push_str(codegen_text::head_rest().as_str());
        let defs: Vec<Def> = sorted_defs(&ck.program, tb);
        let mut main: Option<String> = None;
        let mut print_f64: bool = false;
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            match tb.fns.find(defs[i].path.as_str()) {
                None => {},
                Some(at) => { if is_exec(defs[i].d.kind) && tb.fns.items[at].generics.len() == 0 { if defs[i].d.name.name == "main" && defs[i].path == types::cat2(defs[i].unit.as_str(), "::main") { main = Some(defs[i].path.clone()); } let mut g: Gen = lower_fn(&defs[i], &tb.fns.items[at], ck, tb); ir.push_str(g.out.as_str()); if g.print_f64 { print_f64 = true; } for k in 0..g.todo.len() invariant 0 <= k && k <= g.todo.len(), { todo.push(g.todo[k].clone()); } } },
            }
        }
        if print_f64 {
            ir.push_str(codegen_text::print_f64().as_str());
        }
        match &main {
            None => {},
            Some(m) => { if has_recursive_exec(ck, tb) { todo.push(String::from("a program with recursion: the large stack (backlog 4D-05h)")); } ir.push_str("\ndefine i32 @main() {\n  call ptr @signal(i32 13, ptr inttoptr (i64 1 to ptr))\n  call void "); ir.push_str(fn_sym(m.as_str()).as_str()); ir.push_str("()\n  call void @bmb_flush_out()\n  ret i32 0\n}\n"); },
        }
        Module { ir: ir, main: main, todo: todo }
    }

    #[summary("진입점 (stage0 emit_with의 main): 단위의 main인 제네릭 아닌 실행 함수. 여럿이면 경로가 가장 뒤인 것")]
    #[effects(alloc)]
    fn entry(p: &ast::Program, tb: &lowered::Tables) -> Option<String> {
        let rows: Vec<body::DefRow> = body::defs_of(p, &tb.fns);
        let mut found: Option<String> = None;
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            if rows[i].path == types::cat2(rows[i].unit.as_str(), "::main") {
                match tb.fns.find(rows[i].path.as_str()) {
                    None => {},
                    Some(at) => { if is_exec(tb.fns.items[at].kind) && tb.fns.items[at].generics.len() == 0 { let later: bool = match &found { None => true, Some(prev) => rows[i].path.as_str() > prev.as_str(), }; if later { found = Some(rows[i].path.clone()); } } },
                }
            }
        }
        found
    }

    #[summary("f64 상수의 LLVM 16진 꼴 (stage0 f64_const): 0x와 대문자 16진 열여섯 자리")]
    #[effects(alloc)]
    fn f64_const(bits: u64) -> String {
        let mut s: String = String::from("0x");
        let mut k: u64 = 16;
        while k > 0
            invariant k <= 16,
            decreases k,
        {
            k = k - 1;
            let d: u32 = (bits >> 4 * k & 15) as u32;
            if d < 10 {
                lexer::push_code(&mut s, 48 + d);
            } else {
                lexer::push_code(&mut s, 55 + d);
            }
        }
        s
    }

    #[summary("f64의 이름 붙은 상수의 비트 (stage0 check::F64_CONSTS). 모르는 이름이면 0")]
    #[effects(pure)]
    fn f64_named(name: &str) -> u64 {
        if name == "INFINITY" {
            return 9218868437227405312;
        }
        if name == "NEG_INFINITY" {
            return 18442240474082181120;
        }
        if name == "NAN" {
            return 9221120237041090560;
        }
        if name == "MAX" {
            return 9218868437227405311;
        }
        if name == "MIN" {
            return 18442240474082181119;
        }
        if name == "MIN_POSITIVE" {
            return 4503599627370496;
        }
        if name == "EPSILON" {
            return 4372995238176751616;
        }
        0
    }

    #[summary("e가 실수 리터럴이면 그 비트")]
    #[effects(pure)]
    fn float_lit(e: &ast::Expr) -> Option<u64> {
        match &e.kind {
            ast::ExprKind::Int(fl_int0, fl_int1) => None,
            ast::ExprKind::Float(bits) => Some(*bits),
            ast::ExprKind::ByteLit(fl_bytelit0) => None,
            ast::ExprKind::ByteStr(fl_bytestr0) => None,
            ast::ExprKind::StrLit(fl_strlit0) => None,
            ast::ExprKind::CharLit(fl_charlit0) => None,
            ast::ExprKind::Bool(fl_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(fl_var0) => None,
            ast::ExprKind::Call(fl_call0) => None,
            ast::ExprKind::Method(fl_method0) => None,
            ast::ExprKind::Index(fl_index0, fl_index1) => None,
            ast::ExprKind::Unary(fl_unary0, fl_unary1) => None,
            ast::ExprKind::Binary(fl_binary0, fl_binary1, fl_binary2) => None,
            ast::ExprKind::Ref(fl_ref0, fl_ref1) => None,
            ast::ExprKind::If(fl_if0) => None,
            ast::ExprKind::Block(fl_block0) => None,
            ast::ExprKind::Array(fl_array0) => None,
            ast::ExprKind::Repeat(fl_repeat0) => None,
            ast::ExprKind::Old(fl_old0) => None,
            ast::ExprKind::Quant(fl_quant0) => None,
            ast::ExprKind::Trigger(fl_trigger0) => None,
            ast::ExprKind::Closure(fl_closure0) => None,
            ast::ExprKind::StructLit(fl_structlit0) => None,
            ast::ExprKind::Path(fl_path0) => None,
            ast::ExprKind::Deref(fl_deref0) => None,
            ast::ExprKind::Field(fl_field0, fl_field1) => None,
            ast::ExprKind::Match(fl_match0) => None,
            ast::ExprKind::Return(fl_return0) => None,
            ast::ExprKind::Try(fl_try0) => None,
            ast::ExprKind::Loop(fl_loop0) => None,
            ast::ExprKind::Break(fl_break0) => None,
            ast::ExprKind::Continue(fl_continue0) => None,
            ast::ExprKind::Range(fl_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("f64의 연산 (stage0 expr의 f64 갈래): 산술은 명령, 비교는 fcmp와 술어. 다른 연산이면 빈 글")]
    #[effects(alloc)]
    fn float_op(op: ast::BinOp) -> String {
        match op {
            ast::BinOp::Add => String::from("fadd"),
            ast::BinOp::Sub => String::from("fsub"),
            ast::BinOp::Mul => String::from("fmul"),
            ast::BinOp::Div => String::from("fdiv"),
            ast::BinOp::Rem => String::new(),
            ast::BinOp::Eq => String::from("fcmp oeq"),
            ast::BinOp::Ne => String::from("fcmp une"),
            ast::BinOp::Lt => String::from("fcmp olt"),
            ast::BinOp::Le => String::from("fcmp ole"),
            ast::BinOp::Gt => String::from("fcmp ogt"),
            ast::BinOp::Ge => String::from("fcmp oge"),
            ast::BinOp::And => String::new(),
            ast::BinOp::Or => String::new(),
            ast::BinOp::Implies => String::new(),
            ast::BinOp::BitAnd => String::new(),
            ast::BinOp::BitOr => String::new(),
            ast::BinOp::BitXor => String::new(),
            ast::BinOp::Shl => String::new(),
            ast::BinOp::Shr => String::new(),
        }
    }

    #[summary("m의 몸 있는 함수를 이름의 자리로 모은다 (body::defs_walk와 같은 것을 걷는다)")]
    #[effects(alloc)]
    fn fn_defs(m: &ast::Mod, out: &mut table::Table<ast::FnDef>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..m.mods.len()
            invariant 0 <= i && i <= m.mods.len(),
        {
            fn_defs(&m.mods[i], out, f - 1);
        }
        for i in 0..m.fns.len()
            invariant 0 <= i && i <= m.fns.len(),
        {
            out.insert(body::span_key(m.fns[i].name.span).as_str(), m.fns[i].clone());
        }
        for i in 0..m.impls.len()
            invariant 0 <= i && i <= m.impls.len(),
        {
            for j in 0..m.impls[i].fns.len()
                invariant 0 <= j && j <= m.impls[i].fns.len(),
            {
                out.insert(body::span_key(m.impls[i].fns[j].name.span).as_str(), m.impls[i].fns[j].clone());
            }
        }
        for i in 0..m.trait_impls.len()
            invariant 0 <= i && i <= m.trait_impls.len(),
        {
            for j in 0..m.trait_impls[i].fns.len()
                invariant 0 <= j && j <= m.trait_impls[i].fns.len(),
            {
                out.insert(body::span_key(m.trait_impls[i].fns[j].name.span).as_str(), m.trait_impls[i].fns[j].clone());
            }
        }
        for i in 0..m.traits.len()
            invariant 0 <= i && i <= m.traits.len(),
        {
            for j in 0..m.traits[i].fns.len()
                invariant 0 <= j && j <= m.traits[i].fns.len(),
            {
                if m.traits[i].fns[j].has_body {
                    out.insert(body::span_key(m.traits[i].fns[j].f.name.span).as_str(), m.traits[i].fns[j].f.clone());
                }
            }
        }
    }

    #[summary("함수의 LLVM 이름 (stage0 fn_sym): @\"경로\"")]
    #[effects(alloc)]
    fn fn_sym(path: &str) -> String {
        types::cat3("@\"", path, "\"")
    }

    #[summary("재귀하는 실행 함수가 있는가 (stage0 emit_with의 deep)")]
    #[effects(alloc)]
    fn has_recursive_exec(ck: &body::Checked, tb: &lowered::Tables) -> bool {
        for n in 0..ck.b.recursive.len()
            invariant 0 <= n,
        {
            match tb.fns.find(ck.b.recursive.key(n).as_str()) {
                None => {},
                Some(at) => { if is_exec(tb.fns.items[at].kind) { return true; } },
            }
        }
        false
    }

    #[summary("trait의 메서드인가")]
    #[effects(pure)]
    fn has_trait(sig: &types::FnSig) -> bool {
        match &sig.trait_of {
            None => false,
            Some(ht_t) => true,
        }
    }

    #[summary("값이 Vec을 어디엔가 드는가 (stage0 holds_vec): 참조, 필드, 페이로드, Box, 배열, 타입 인자를 지나")]
    #[effects(alloc)]
    fn holds_vec(t: &ast::TypeKind, tb: &lowered::Tables) -> bool {
        let mut seen: Vec<String> = Vec::new();
        holds_vec_in(t, tb, &mut seen, 100000)
    }

    #[effects(alloc)]
    fn holds_vec_in(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match t {
            ast::TypeKind::Int(hv_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(ae, hv_n) => holds_vec_in(&ae.kind, tb, seen, f - 1),
            ast::TypeKind::ArrayN(hv_arrayn0, hv_arrayn1) => false,
            ast::TypeKind::Slice(se) => holds_vec_in(&se.kind, tb, seen, f - 1),
            ast::TypeKind::Ref(hv_m, ri) => holds_vec_in(&ri.kind, tb, seen, f - 1),
            ast::TypeKind::Named(hv_path, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if holds_vec_in(&args[i].kind, tb, seen, f - 1) { return true; } } if !types::add(seen, types::text(t).as_str()) { return false; } match lowered::struct_fields(t, tb) { None => {}, Some(fs) => { for j in 0..fs.len() invariant 0 <= j && j <= fs.len(), { if holds_vec_in(&fs[j].ty, tb, seen, f - 1) { return true; } } return false; }, } match lowered::enum_variants(t, tb) { None => false, Some(vs) => { for a in 0..vs.len() invariant 0 <= a && a <= vs.len(), { for b in 0..vs[a].tys.len() invariant 0 <= b && b <= vs[a].tys.len(), { if holds_vec_in(&vs[a].tys[b], tb, seen, f - 1) { return true; } } } false }, } },
            ast::TypeKind::Vec(hv_e) => true,
            ast::TypeKind::Box(be) => holds_vec_in(&be.kind, tb, seen, f - 1),
            ast::TypeKind::Param(hv_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("스칼라로 쓰는 값의 글 (stage0 CVal::imm): 단위 값은 0, 끝나지 않는 값은 undef")]
    #[effects(alloc)]
    fn imm(v: &CVal) -> String {
        match v {
            CVal::Imm(s) => s.clone(),
            CVal::Arr(im_p, im_n) => String::from("undef"),
            CVal::Unit => String::from("0"),
            CVal::Never => String::from("undef"),
        }
    }

    #[summary("정수 비교의 술어 (stage0 expr의 cmp): 부호에 따라. 비교가 아니면 빈 글")]
    #[effects(alloc)]
    fn int_cmp(op: ast::BinOp, signed: bool) -> String {
        match op {
            ast::BinOp::Add => String::new(),
            ast::BinOp::Sub => String::new(),
            ast::BinOp::Mul => String::new(),
            ast::BinOp::Div => String::new(),
            ast::BinOp::Rem => String::new(),
            ast::BinOp::Eq => String::from("eq"),
            ast::BinOp::Ne => String::from("ne"),
            ast::BinOp::Lt => { if signed { String::from("slt") } else { String::from("ult") } },
            ast::BinOp::Le => { if signed { String::from("sle") } else { String::from("ule") } },
            ast::BinOp::Gt => { if signed { String::from("sgt") } else { String::from("ugt") } },
            ast::BinOp::Ge => { if signed { String::from("sge") } else { String::from("uge") } },
            ast::BinOp::And => String::new(),
            ast::BinOp::Or => String::new(),
            ast::BinOp::Implies => String::new(),
            ast::BinOp::BitAnd => String::new(),
            ast::BinOp::BitOr => String::new(),
            ast::BinOp::BitXor => String::new(),
            ast::BinOp::Shl => String::new(),
            ast::BinOp::Shr => String::new(),
        }
    }

    #[summary("e가 정수 리터럴이면 그 값")]
    #[effects(pure)]
    fn int_lit(e: &ast::Expr) -> Option<wide::U128> {
        match &e.kind {
            ast::ExprKind::Int(v, il_r) => Some(*v),
            ast::ExprKind::Float(il_float0) => None,
            ast::ExprKind::ByteLit(il_bytelit0) => None,
            ast::ExprKind::ByteStr(il_bytestr0) => None,
            ast::ExprKind::StrLit(il_strlit0) => None,
            ast::ExprKind::CharLit(il_charlit0) => None,
            ast::ExprKind::Bool(il_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(il_var0) => None,
            ast::ExprKind::Call(il_call0) => None,
            ast::ExprKind::Method(il_method0) => None,
            ast::ExprKind::Index(il_index0, il_index1) => None,
            ast::ExprKind::Unary(il_unary0, il_unary1) => None,
            ast::ExprKind::Binary(il_binary0, il_binary1, il_binary2) => None,
            ast::ExprKind::Ref(il_ref0, il_ref1) => None,
            ast::ExprKind::If(il_if0) => None,
            ast::ExprKind::Block(il_block0) => None,
            ast::ExprKind::Array(il_array0) => None,
            ast::ExprKind::Repeat(il_repeat0) => None,
            ast::ExprKind::Old(il_old0) => None,
            ast::ExprKind::Quant(il_quant0) => None,
            ast::ExprKind::Trigger(il_trigger0) => None,
            ast::ExprKind::Closure(il_closure0) => None,
            ast::ExprKind::StructLit(il_structlit0) => None,
            ast::ExprKind::Path(il_path0) => None,
            ast::ExprKind::Deref(il_deref0) => None,
            ast::ExprKind::Field(il_field0, il_field1) => None,
            ast::ExprKind::Match(il_match0) => None,
            ast::ExprKind::Return(il_return0) => None,
            ast::ExprKind::Try(il_try0) => None,
            ast::ExprKind::Loop(il_loop0) => None,
            ast::ExprKind::Break(il_break0) => None,
            ast::ExprKind::Continue(il_continue0) => None,
            ast::ExprKind::Range(il_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("정수 타입의 가장 큰 값의 글")]
    #[effects(alloc)]
    fn int_max(i: ast::IntTy) -> String {
        match i {
            ast::IntTy::I8 => String::from("127"),
            ast::IntTy::I16 => String::from("32767"),
            ast::IntTy::I32 => String::from("2147483647"),
            ast::IntTy::I64 => String::from("9223372036854775807"),
            ast::IntTy::Isize => String::from("9223372036854775807"),
            ast::IntTy::U8 => String::from("255"),
            ast::IntTy::U16 => String::from("65535"),
            ast::IntTy::U32 => String::from("4294967295"),
            ast::IntTy::U64 => String::from("18446744073709551615"),
            ast::IntTy::Usize => String::from("18446744073709551615"),
        }
    }

    #[summary("정수 타입의 가장 작은 값의 글")]
    #[effects(alloc)]
    fn int_min(i: ast::IntTy) -> String {
        match i {
            ast::IntTy::I8 => String::from("-128"),
            ast::IntTy::I16 => String::from("-32768"),
            ast::IntTy::I32 => String::from("-2147483648"),
            ast::IntTy::I64 => String::from("-9223372036854775808"),
            ast::IntTy::Isize => String::from("-9223372036854775808"),
            ast::IntTy::U8 => String::from("0"),
            ast::IntTy::U16 => String::from("0"),
            ast::IntTy::U32 => String::from("0"),
            ast::IntTy::U64 => String::from("0"),
            ast::IntTy::Usize => String::from("0"),
        }
    }

    #[effects(pure)]
    fn is_and(op: ast::BinOp) -> bool {
        match op {
            ast::BinOp::Add => false,
            ast::BinOp::Sub => false,
            ast::BinOp::Mul => false,
            ast::BinOp::Div => false,
            ast::BinOp::Rem => false,
            ast::BinOp::Eq => false,
            ast::BinOp::Ne => false,
            ast::BinOp::Lt => false,
            ast::BinOp::Le => false,
            ast::BinOp::Gt => false,
            ast::BinOp::Ge => false,
            ast::BinOp::And => true,
            ast::BinOp::Or => false,
            ast::BinOp::Implies => false,
            ast::BinOp::BitAnd => false,
            ast::BinOp::BitOr => false,
            ast::BinOp::BitXor => false,
            ast::BinOp::Shl => false,
            ast::BinOp::Shr => false,
        }
    }

    #[summary("배열 값인가")]
    #[effects(pure)]
    fn is_arr(v: &CVal) -> bool {
        match v {
            CVal::Imm(ia_x) => false,
            CVal::Arr(ia_p, ia_n) => true,
            CVal::Unit => false,
            CVal::Never => false,
        }
    }

    #[summary("슬라이스의 참조인가 (stage0 is_array)")]
    #[effects(alloc)]
    fn is_array(t: &ast::TypeKind) -> bool {
        match body::ref_inner(t) {
            None => false,
            Some(inner) => body::is_slice(&inner),
        }
    }

    #[summary("Box인가 (참조를 지나)")]
    #[effects(alloc)]
    fn is_box(t: &ast::TypeKind) -> bool {
        body::is_box(&lowered::value_ty(t))
    }

    #[summary("구조체나 열거형인가 (참조를 지나)")]
    #[effects(alloc)]
    fn is_data(t: &ast::TypeKind) -> bool {
        body::is_named(&lowered::value_ty(t))
    }

    #[effects(pure)]
    fn is_exec(k: ast::FnKind) -> bool {
        match k {
            ast::FnKind::Exec => true,
            ast::FnKind::Spec => false,
            ast::FnKind::Proof => false,
        }
    }

    #[summary("값이 메모리에 살고 주소로 넘겨지는가: 구조체, 열거형, Vec의 머리, Box")]
    #[effects(alloc)]
    fn is_mem(t: &ast::TypeKind) -> bool {
        is_data(t) || is_vec(t) || is_box(t)
    }

    #[summary("배열의 원소로서 메모리에 덩어리로 사는가: is_mem이거나 고정 길이 배열")]
    #[effects(alloc)]
    fn is_mem_elem(t: &ast::TypeKind) -> bool {
        is_mem(t) || body::is_array(&lowered::value_ty(t))
    }

    #[effects(pure)]
    fn is_neg(op: ast::UnOp) -> bool {
        match op {
            ast::UnOp::Neg => true,
            ast::UnOp::Not => false,
        }
    }

    #[summary("끝나지 않는 식의 값인가")]
    #[effects(pure)]
    fn is_never(v: &CVal) -> bool {
        match v {
            CVal::Imm(in_x) => false,
            CVal::Arr(in_p, in_n) => false,
            CVal::Unit => false,
            CVal::Never => true,
        }
    }

    #[effects(pure)]
    fn is_or(op: ast::BinOp) -> bool {
        match op {
            ast::BinOp::Add => false,
            ast::BinOp::Sub => false,
            ast::BinOp::Mul => false,
            ast::BinOp::Div => false,
            ast::BinOp::Rem => false,
            ast::BinOp::Eq => false,
            ast::BinOp::Ne => false,
            ast::BinOp::Lt => false,
            ast::BinOp::Le => false,
            ast::BinOp::Gt => false,
            ast::BinOp::Ge => false,
            ast::BinOp::And => false,
            ast::BinOp::Or => true,
            ast::BinOp::Implies => false,
            ast::BinOp::BitAnd => false,
            ast::BinOp::BitOr => false,
            ast::BinOp::BitXor => false,
            ast::BinOp::Shl => false,
            ast::BinOp::Shr => false,
        }
    }

    #[summary("정수, bool, f64인가")]
    #[effects(pure)]
    fn is_scalar_ty(t: &ast::TypeKind) -> bool {
        match t {
            ast::TypeKind::Int(sc_i) => true,
            ast::TypeKind::F64 => true,
            ast::TypeKind::Bool => true,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(sc_array0, sc_array1) => false,
            ast::TypeKind::ArrayN(sc_arrayn0, sc_arrayn1) => false,
            ast::TypeKind::Slice(sc_slice0) => false,
            ast::TypeKind::Ref(sc_ref0, sc_ref1) => false,
            ast::TypeKind::Named(sc_named0, sc_named1) => false,
            ast::TypeKind::Vec(sc_vec0) => false,
            ast::TypeKind::Box(sc_box0) => false,
            ast::TypeKind::Param(sc_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[effects(pure)]
    fn is_shr(op: ast::BinOp) -> bool {
        match op {
            ast::BinOp::Add => false,
            ast::BinOp::Sub => false,
            ast::BinOp::Mul => false,
            ast::BinOp::Div => false,
            ast::BinOp::Rem => false,
            ast::BinOp::Eq => false,
            ast::BinOp::Ne => false,
            ast::BinOp::Lt => false,
            ast::BinOp::Le => false,
            ast::BinOp::Gt => false,
            ast::BinOp::Ge => false,
            ast::BinOp::And => false,
            ast::BinOp::Or => false,
            ast::BinOp::Implies => false,
            ast::BinOp::BitAnd => false,
            ast::BinOp::BitOr => false,
            ast::BinOp::BitXor => false,
            ast::BinOp::Shl => false,
            ast::BinOp::Shr => true,
        }
    }

    #[summary("부호 있는 정수 타입인가")]
    #[effects(pure)]
    fn is_signed(t: &ast::TypeKind) -> bool {
        match body::int_of(t) {
            None => false,
            Some(i) => body::signed(i),
        }
    }

    #[summary("Vec인가 (참조를 지나)")]
    #[effects(alloc)]
    fn is_vec(t: &ast::TypeKind) -> bool {
        body::is_vec(&lowered::value_ty(t))
    }

    #[summary("루프의 레이블의 이름. 없으면 빈 글")]
    #[effects(alloc)]
    fn label_name(l: &Option<ast::Ident>) -> String {
        match l {
            None => String::new(),
            Some(id) => id.name.clone(),
        }
    }

    #[summary("ts를 차례로 놓은 구조체의 배치 (stage0 layout의 fields). tag이면 i64 꼬리표가 앞에 온다")]
    #[effects(alloc)]
    fn lay_fields(ts: &[ast::TypeKind], tag: bool, tb: &lowered::Tables, f: usize) -> Lay
        decreases f * 2 + 1,
    {
        let mut size: u64 = 0;
        let mut al: u64 = 1;
        if tag {
            size = 8;
            al = 8;
        }
        for i in 0..ts.len()
            invariant 0 <= i && i <= ts.len(),
        {
            let l: Lay = layout_in(&ts[i], tb, f);
            size = round_up(size, l.align).wrapping_add(l.size);
            if l.align > al {
                al = l.align;
            }
        }
        Lay { size: round_up(size, al), align: al }
    }

    #[summary("t의 메모리에서의 크기와 정렬 (stage0 layout): 열거형의 페이로드 자리를 재는 데만 쓴다")]
    #[effects(alloc)]
    fn layout(t: &ast::TypeKind, tb: &lowered::Tables) -> Lay {
        layout_in(t, tb, 100000)
    }

    #[effects(alloc)]
    fn layout_in(t: &ast::TypeKind, tb: &lowered::Tables, f: usize) -> Lay
        decreases f * 2,
    {
        let word: Lay = Lay { size: 8, align: 8 };
        if f == 0 {
            return word;
        }
        let v: ast::TypeKind = lowered::value_ty(t);
        match &v {
            ast::TypeKind::Int(ly_int0) => word,
            ast::TypeKind::F64 => word,
            ast::TypeKind::Bool => Lay { size: 1, align: 1 },
            ast::TypeKind::Unit => Lay { size: 0, align: 1 },
            ast::TypeKind::Char => word,
            ast::TypeKind::String => word,
            ast::TypeKind::Str => word,
            ast::TypeKind::Array(ae, an) => { let el: Lay = layout_in(&ae.kind, tb, f - 1); Lay { size: el.size.wrapping_mul(*an), align: el.align } },
            ast::TypeKind::ArrayN(ly_arrayn0, ly_arrayn1) => word,
            ast::TypeKind::Slice(ly_slice0) => word,
            ast::TypeKind::Ref(ly_ref0, ly_ref1) => word,
            ast::TypeKind::Named(ly_path, ly_args) => { match lowered::struct_fields(&v, tb) { None => {}, Some(fs) => { let mut fts: Vec<ast::TypeKind> = Vec::new(); for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { fts.push(fs[i].ty.clone()); } return lay_fields(fts.as_slice(), false, tb, f - 1); }, } let mut size: u64 = 8; match lowered::enum_variants(&v, tb) { None => {}, Some(vs) => { for k in 0..vs.len() invariant 0 <= k && k <= vs.len(), { let one: Lay = lay_fields(vs[k].tys.as_slice(), true, tb, f - 1); if one.size > size { size = one.size; } } }, } Lay { size: round_up(size, 8), align: 8 } },
            ast::TypeKind::Vec(ly_e) => Lay { size: 24, align: 8 },
            ast::TypeKind::Box(ly_box0) => word,
            ast::TypeKind::Param(ly_param0) => word,
            ast::TypeKind::Never => word,
            ast::TypeKind::Error => word,
        }
    }

    #[summary("스칼라의 레지스터 타입 (stage0 llty): bool은 i1, f64는 double, ()는 void, 나머지는 i64")]
    #[effects(alloc)]
    fn llty(t: &ast::TypeKind) -> String {
        match t {
            ast::TypeKind::Int(ll_int0) => String::from("i64"),
            ast::TypeKind::F64 => String::from("double"),
            ast::TypeKind::Bool => String::from("i1"),
            ast::TypeKind::Unit => String::from("void"),
            ast::TypeKind::Char => String::from("i64"),
            ast::TypeKind::String => String::from("i64"),
            ast::TypeKind::Str => String::from("i64"),
            ast::TypeKind::Array(ll_array0, ll_array1) => String::from("i64"),
            ast::TypeKind::ArrayN(ll_arrayn0, ll_arrayn1) => String::from("i64"),
            ast::TypeKind::Slice(ll_slice0) => String::from("i64"),
            ast::TypeKind::Ref(ll_ref0, ll_ref1) => String::from("i64"),
            ast::TypeKind::Named(ll_named0, ll_named1) => String::from("i64"),
            ast::TypeKind::Vec(ll_vec0) => String::from("i64"),
            ast::TypeKind::Box(ll_box0) => String::from("i64"),
            ast::TypeKind::Param(ll_param0) => String::from("i64"),
            ast::TypeKind::Never => String::from("i64"),
            ast::TypeKind::Error => String::from("i64"),
        }
    }

    #[summary("정의 하나를 낮춘다 (stage0 emit_with의 한 바퀴): 매개변수의 자리, 몸, 반환. g.out이 그 정의의 글 전체다")]
    #[effects(alloc)]
    fn lower_fn(def: &Def, sig: &types::FnSig, ck: &body::Checked, tb: &lowered::Tables) -> Gen {
        let mut g: Gen = Gen { path: def.path.clone(), base: def.path.clone(), unit: def.unit.clone(), out: String::new(), allocas: String::new(), tmp: 0, label: 0, slots: table::new::<Slot>(), checks: 0, globals: String::new(), consts: 0, ret: sig.ret.clone(), todo: Vec::new(), print_f64: false, loops: Vec::new() };
        let mut params: Vec<String> = Vec::new();
        for i in 0..def.d.params.len()
            invariant 0 <= i && i <= def.d.params.len(),
        {
            if i < sig.params.len() {
                let n: String = def.d.params[i].name.name.clone();
                let pk: u32 = param_kind(&sig.params[i]);
                let attr: String = if types::is_ref_mut(&sig.params[i]) {
                    String::from("noalias ")
                } else {
                    String::from("readonly ")
                };
                if pk == 9 {
                    g.todo_at("a parameter that is not a scalar, a slice or an array of scalars, or a scalar reference", def.d.params[i].name.span);
                } else if pk == 1 {
                    let sp: String = types::cat3("%\"", n.as_str(), ".ptr\"");
                    let sn: String = types::cat3("%\"", n.as_str(), ".len\"");
                    params.push(types::cat3("ptr ", attr.as_str(), sp.as_str()));
                    params.push(types::cat2("i64 ", sn.as_str()));
                    let sety: ast::TypeKind = elem_of(&sig.params[i]);
                    g.slots.insert(n.as_str(), Slot::Arr(ArrSlot { ptr: sp, len: sn, elem: elem_kind(&sety), ety: sety }));
                } else if pk == 2 {
                    let rp: String = types::cat3("%\"", n.as_str(), ".ptr\"");
                    params.push(types::cat3("ptr ", attr.as_str(), rp.as_str()));
                    g.slots.insert(n.as_str(), Slot::Scalar(rp, llty(&elem_of(&sig.params[i]))));
                } else if pk == 3 {
                    let ain: String = types::cat3("%\"", n.as_str(), ".in\"");
                    params.push(types::cat2("ptr ", ain.as_str()));
                    let ap: String = g.temp(&sig.params[i]);
                    g.copy(ap.as_str(), ain.as_str(), &sig.params[i]);
                    let aety: ast::TypeKind = elem_of(&sig.params[i]);
                    g.slots.insert(n.as_str(), Slot::Arr(ArrSlot { ptr: ap, len: array_len_text(&sig.params[i]), elem: elem_kind(&aety), ety: aety }));
                } else if !decls::is_unit(&sig.params[i]) {
                    let lt: String = llty(&sig.params[i]);
                    let reg: String = types::cat3("%\"", n.as_str(), "\"");
                    params.push(types::cat3(lt.as_str(), " ", reg.as_str()));
                    let ptr: String = g.alloca(lt.as_str());
                    g.emit(types::cat7("store ", lt.as_str(), " ", reg.as_str(), ", ptr ", ptr.as_str(), "").as_str());
                    g.slots.insert(n.as_str(), Slot::Scalar(ptr, lt));
                }
            }
        }
        let rv: CVal = g.block_expr(&def.d.body, ck, tb, 100000);
        g.emit_return(&rv);
        let mut frag: String = String::from("\n");
        frag.push_str(g.globals.as_str());
        frag.push_str("define internal ");
        if ret_in_memory(&sig.ret) {
            frag.push_str("void");
        } else {
            frag.push_str(llty(&sig.ret).as_str());
        }
        frag.push_str(" ");
        frag.push_str(fn_sym(def.path.as_str()).as_str());
        frag.push_str("(");
        if ret_in_memory(&sig.ret) {
            frag.push_str("ptr noalias %\"ret.out\"");
            if params.len() > 0 {
                frag.push_str(", ");
            }
        }
        frag.push_str(types::join(params.as_slice(), ", ").as_str());
        frag.push_str(") {\nentry:\n");
        frag.push_str(g.allocas.as_str());
        frag.push_str(g.out.as_str());
        frag.push_str("}\n");
        g.out = frag;
        g
    }

    #[summary("배열 원소의 메모리 타입 (stage0 mem): bool과 좁은 정수는 제 폭")]
    #[effects(alloc)]
    fn mem(elem: &str) -> String {
        if elem == "i1" {
            return String::from("i8");
        }
        let b: u32 = narrow_bits(elem);
        if b == 8 {
            return String::from("i8");
        }
        if b == 16 {
            return String::from("i16");
        }
        if b == 32 {
            return String::from("i32");
        }
        String::from(elem)
    }

    #[summary("t의 값의 메모리에서의 LLVM 타입 (stage0 mem_ty): bool은 한 바이트")]
    #[effects(alloc)]
    fn mem_ty(t: &ast::TypeKind) -> String {
        mem_ty_in(t, 100000)
    }

    #[effects(alloc)]
    fn mem_ty_in(t: &ast::TypeKind, f: usize) -> String
        decreases f,
    {
        if f == 0 {
            return String::from("i64");
        }
        let v: ast::TypeKind = lowered::value_ty(t);
        match &v {
            ast::TypeKind::Int(it) => { let mut s: String = String::from("i"); std::num::push_u64(&mut s, body::bits(*it) as u64); s },
            ast::TypeKind::F64 => String::from("double"),
            ast::TypeKind::Bool => String::from("i8"),
            ast::TypeKind::Unit => String::from("i64"),
            ast::TypeKind::Char => String::from("i64"),
            ast::TypeKind::String => String::from("i64"),
            ast::TypeKind::Str => String::from("i64"),
            ast::TypeKind::Array(ae, an) => { let mut s: String = String::from("["); std::num::push_u64(&mut s, *an); s.push_str(" x "); s.push_str(mem_ty_in(&ae.kind, f - 1).as_str()); s.push_str("]"); s },
            ast::TypeKind::ArrayN(mt_arrayn0, mt_arrayn1) => String::from("i64"),
            ast::TypeKind::Slice(mt_slice0) => String::from("i64"),
            ast::TypeKind::Ref(mt_ref0, mt_ref1) => String::from("i64"),
            ast::TypeKind::Named(mt_p, mt_a) => data_ty(&v),
            ast::TypeKind::Vec(mt_e) => String::from("%bmb.vec"),
            ast::TypeKind::Box(mt_b) => String::from("ptr"),
            ast::TypeKind::Param(mt_param0) => String::from("i64"),
            ast::TypeKind::Never => String::from("i64"),
            ast::TypeKind::Error => String::from("i64"),
        }
    }

    #[summary("원소 종류가 이름하는 좁은 정수의 폭 (stage0 narrow). 아니면 0")]
    #[effects(pure)]
    fn narrow_bits(elem: &str) -> u32 {
        if elem == "i8" || elem == "u8" {
            return 8;
        }
        if elem == "i16" || elem == "u16" {
            return 16;
        }
        if elem == "i32" || elem == "u32" {
            return 32;
        }
        0
    }

    #[summary("원소 종류가 부호 있는 좁은 정수인가 (stage0 narrow의 signed)")]
    #[effects(pure)]
    fn narrow_signed(elem: &str) -> bool {
        elem == "i8" || elem == "i16" || elem == "i32"
    }

    #[summary("매개변수가 넘겨지는 꼴. 0: 값으로 넘기는 스칼라나 단위 값, 1: 스칼라 원소의 슬라이스 (주소와 길이), 2: 스칼라의 참조 (자리의 주소), 3: 값으로 넘기는 스칼라 원소의 배열 (주소, 받는 쪽이 옮긴다), 9: 아직 옮기지 않은 것 (메모리에 사는 값과 그 참조·슬라이스·배열)")]
    #[effects(alloc)]
    fn param_kind(t: &ast::TypeKind) -> u32 {
        if is_mem(t) {
            return 9;
        }
        match body::ref_inner(t) {
            None => { match body::array_elem(t) { None => 0, Some(ael) => { if is_scalar_ty(&ael) { 3 } else { 9 } }, } },
            Some(inner) => { match body::slice_elem(&inner) { None => { if is_scalar_ty(&inner) { 2 } else { 9 } }, Some(sel) => { if is_scalar_ty(&sel) { 1 } else { 9 } }, } },
        }
    }

    #[summary("식이 범위면 그 범위")]
    #[effects(alloc)]
    fn range_of(e: &ast::Expr) -> Option<ast::Range> {
        match &e.kind {
            ast::ExprKind::Int(ro_int0, ro_int1) => None,
            ast::ExprKind::Float(ro_float0) => None,
            ast::ExprKind::ByteLit(ro_bytelit0) => None,
            ast::ExprKind::ByteStr(ro_bytestr0) => None,
            ast::ExprKind::StrLit(ro_strlit0) => None,
            ast::ExprKind::CharLit(ro_charlit0) => None,
            ast::ExprKind::Bool(ro_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(ro_var0) => None,
            ast::ExprKind::Call(ro_call0) => None,
            ast::ExprKind::Method(ro_method0) => None,
            ast::ExprKind::Index(ro_index0, ro_index1) => None,
            ast::ExprKind::Unary(ro_unary0, ro_unary1) => None,
            ast::ExprKind::Binary(ro_binary0, ro_binary1, ro_binary2) => None,
            ast::ExprKind::Ref(ro_ref0, ro_ref1) => None,
            ast::ExprKind::If(ro_if0) => None,
            ast::ExprKind::Block(ro_block0) => None,
            ast::ExprKind::Array(ro_array0) => None,
            ast::ExprKind::Repeat(ro_repeat0) => None,
            ast::ExprKind::Old(ro_old0) => None,
            ast::ExprKind::Quant(ro_quant0) => None,
            ast::ExprKind::Trigger(ro_trigger0) => None,
            ast::ExprKind::Closure(ro_closure0) => None,
            ast::ExprKind::StructLit(ro_structlit0) => None,
            ast::ExprKind::Path(ro_path0) => None,
            ast::ExprKind::Deref(ro_deref0) => None,
            ast::ExprKind::Field(ro_field0, ro_field1) => None,
            ast::ExprKind::Match(ro_match0) => None,
            ast::ExprKind::Return(ro_return0) => None,
            ast::ExprKind::Try(ro_try0) => None,
            ast::ExprKind::Loop(ro_loop0) => None,
            ast::ExprKind::Break(ro_break0) => None,
            ast::ExprKind::Continue(ro_continue0) => None,
            ast::ExprKind::Range(r) => Some(r.clone()),
            ast::ExprKind::Error => None,
        }
    }

    #[summary("결과를 부른 쪽의 메모리에 쓰는가 (stage0 ret_in_memory): 메모리에 사는 값이거나 배열")]
    #[effects(alloc)]
    fn ret_in_memory(ret: &ast::TypeKind) -> bool {
        is_mem(ret) || body::is_array(ret)
    }

    #[summary("x를 a의 배수로 올린다 (stage0의 x.div_ceil(a) * a, 넘치면 감긴다). a가 0이면 x")]
    #[effects(pure)]
    fn round_up(x: u64, a: u64) -> u64 {
        if a == 0 {
            return x;
        }
        let r: u64 = x % a;
        if r == 0 {
            x
        } else {
            x.wrapping_add(a - r)
        }
    }

    #[summary("스칼라 원소의 배열 타입인가")]
    #[effects(alloc)]
    fn scalar_array(t: &ast::TypeKind) -> bool {
        match body::array_elem(t) {
            None => false,
            Some(el) => is_scalar_ty(&el),
        }
    }

    #[summary("t의 값의 바이트 수를 주는 상수 식 (stage0 size_of)")]
    #[effects(alloc)]
    fn size_of(t: &ast::TypeKind) -> String {
        types::cat3("ptrtoint (ptr getelementptr (", mem_ty(t).as_str(), ", ptr null, i32 1) to i64)")
    }

    #[summary("몸 있는 정의를 경로 순서로 (stage0 emit_with의 defs): body::defs_of의 줄마다 그 구문")]
    #[effects(alloc)]
    fn sorted_defs(p: &ast::Program, tb: &lowered::Tables) -> Vec<Def> {
        let mut by_span: table::Table<ast::FnDef> = table::new::<ast::FnDef>();
        for i in 0..p.mods.len()
            invariant 0 <= i && i <= p.mods.len(),
        {
            fn_defs(&p.mods[i], &mut by_span, 100000);
        }
        let rows: Vec<body::DefRow> = body::defs_of(p, &tb.fns);
        let mut by_path: table::Table<Def> = table::new::<Def>();
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            match by_span.find(body::span_key(rows[i].span).as_str()) {
                None => {},
                Some(at) => { if !by_path.has(rows[i].path.as_str()) { by_path.insert(rows[i].path.as_str(), Def { path: rows[i].path.clone(), unit: rows[i].unit.clone(), d: by_span.items[at].clone() }); } },
            }
        }
        let mut out: Vec<Def> = Vec::new();
        for n in 0..by_path.len()
            invariant 0 <= n,
        {
            match by_path.nth(n) {
                None => {},
                Some(at) => out.push(by_path.items[at].clone()),
            }
        }
        out
    }

    #[summary("프로그램이 쓰는 구조체와 열거형(인스턴스)의 LLVM 타입 정의 (stage0 type_defs): 구조체는 필드를 선언 순서로, 열거형은 꼬리표와 페이로드 자리, 페이로드 있는 변형마다 보는 타입 하나")]
    #[effects(alloc)]
    fn type_defs(tb: &lowered::Tables) -> String {
        let mut seen: Vec<String> = Vec::new();
        let mut out: String = String::new();
        let all: Vec<ast::TypeKind> = all_types(tb);
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            visit(&all[i], tb, &mut seen, &mut out, 100000);
        }
        out
    }

    #[summary("프로그램이 힙 값을 갖는가 (stage0 emit_with의 uses_heap): Vec을 들거나, 식이나 지역 변수의 타입이 옮겨지는 값이다 (시그니처는 세지 않는다)")]
    #[effects(alloc)]
    fn uses_heap(tb: &lowered::Tables, uses_vec: bool) -> bool {
        if uses_vec {
            return true;
        }
        let none: Vec<String> = Vec::new();
        for n in 0..tb.types.len()
            invariant 0 <= n,
        {
            match tb.types.nth(n) {
                None => {},
                Some(at) => { if types::is_move_in(&lowered::value_ty(&tb.types.items[at]), &tb.adts, none.as_slice()) { return true; } },
            }
        }
        for n in 0..tb.locals.len()
            invariant 0 <= n,
        {
            match tb.locals.nth(n) {
                None => {},
                Some(at) => { for v in 0..tb.locals.items[at].len() invariant 0 <= v, { match tb.locals.items[at].nth(v) { None => {}, Some(i) => { if types::is_move_in(&lowered::value_ty(&tb.locals.items[at].items[i]), &tb.adts, none.as_slice()) { return true; } }, } } },
            }
        }
        false
    }

    #[summary("e가 지역 이름이면 그 이름")]
    #[effects(alloc)]
    fn var_name(e: &ast::Expr) -> Option<String> {
        match &e.kind {
            ast::ExprKind::Int(vn_int0, vn_int1) => None,
            ast::ExprKind::Float(vn_float0) => None,
            ast::ExprKind::ByteLit(vn_bytelit0) => None,
            ast::ExprKind::ByteStr(vn_bytestr0) => None,
            ast::ExprKind::StrLit(vn_strlit0) => None,
            ast::ExprKind::CharLit(vn_charlit0) => None,
            ast::ExprKind::Bool(vn_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(id) => Some(id.name.clone()),
            ast::ExprKind::Call(vn_call0) => None,
            ast::ExprKind::Method(vn_method0) => None,
            ast::ExprKind::Index(vn_index0, vn_index1) => None,
            ast::ExprKind::Unary(vn_unary0, vn_unary1) => None,
            ast::ExprKind::Binary(vn_binary0, vn_binary1, vn_binary2) => None,
            ast::ExprKind::Ref(vn_ref0, vn_ref1) => None,
            ast::ExprKind::If(vn_if0) => None,
            ast::ExprKind::Block(vn_block0) => None,
            ast::ExprKind::Array(vn_array0) => None,
            ast::ExprKind::Repeat(vn_repeat0) => None,
            ast::ExprKind::Old(vn_old0) => None,
            ast::ExprKind::Quant(vn_quant0) => None,
            ast::ExprKind::Trigger(vn_trigger0) => None,
            ast::ExprKind::Closure(vn_closure0) => None,
            ast::ExprKind::StructLit(vn_structlit0) => None,
            ast::ExprKind::Path(vn_path0) => None,
            ast::ExprKind::Deref(vn_deref0) => None,
            ast::ExprKind::Field(vn_field0, vn_field1) => None,
            ast::ExprKind::Match(vn_match0) => None,
            ast::ExprKind::Return(vn_return0) => None,
            ast::ExprKind::Try(vn_try0) => None,
            ast::ExprKind::Loop(vn_loop0) => None,
            ast::ExprKind::Break(vn_break0) => None,
            ast::ExprKind::Continue(vn_continue0) => None,
            ast::ExprKind::Range(vn_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("열거형 t의 변형 v를 보는 타입 (stage0 view_ty): 꼬리표와 페이로드")]
    #[effects(alloc)]
    fn view_ty(t: &ast::TypeKind, v: &str) -> String {
        types::cat5("%\"", types::text(&lowered::value_ty(t)).as_str(), "::", v, "\"")
    }

    #[effects(alloc)]
    fn visit(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, out: &mut String, f: usize) -> ()
        decreases f,
    {
        if f == 0 || body::has_param(t, 100000) {
            return;
        }
        match t {
            ast::TypeKind::Int(vi_int0) => {},
            ast::TypeKind::F64 => {},
            ast::TypeKind::Bool => {},
            ast::TypeKind::Unit => {},
            ast::TypeKind::Char => {},
            ast::TypeKind::String => {},
            ast::TypeKind::Str => {},
            ast::TypeKind::Array(ae, vi_n) => visit(&ae.kind, tb, seen, out, f - 1),
            ast::TypeKind::ArrayN(vi_arrayn0, vi_arrayn1) => {},
            ast::TypeKind::Slice(se) => visit(&se.kind, tb, seen, out, f - 1),
            ast::TypeKind::Ref(vi_m, ri) => visit(&ri.kind, tb, seen, out, f - 1),
            ast::TypeKind::Named(vi_p, vi_a) => visit_data(t, tb, seen, out, f - 1),
            ast::TypeKind::Vec(ve) => visit(&ve.kind, tb, seen, out, f - 1),
            ast::TypeKind::Box(be) => visit(&be.kind, tb, seen, out, f - 1),
            ast::TypeKind::Param(vi_param0) => {},
            ast::TypeKind::Never => {},
            ast::TypeKind::Error => {},
        }
    }

    #[summary("타입 정의를 낼 구조체나 열거형 t (visit의 Named 갈래): 처음 볼 때만")]
    #[effects(alloc)]
    fn visit_data(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, out: &mut String, f: usize) -> ()
        decreases f,
    {
        if f == 0 || !types::add(seen, types::text(t).as_str()) {
            return;
        }
        match lowered::struct_fields(t, tb) {
            None => {},
            Some(fs) => { out.push_str(data_ty(t).as_str()); out.push_str(" = type { "); for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { if i > 0 { out.push_str(", "); } out.push_str(mem_ty(&fs[i].ty).as_str()); } out.push_str(" }\n"); for j in 0..fs.len() invariant 0 <= j && j <= fs.len(), { visit(&fs[j].ty, tb, seen, out, f - 1); } return; },
        }
        match lowered::enum_variants(t, tb) {
            None => {},
            Some(vs) => { let words: u64 = layout(t, tb).size.wrapping_sub(8) / 8; out.push_str(data_ty(t).as_str()); out.push_str(" = type { i64, ["); std::num::push_u64(out, words); out.push_str(" x i64] }\n"); for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { if vs[i].tys.len() > 0 { out.push_str(view_ty(t, vs[i].name.as_str()).as_str()); out.push_str(" = type { i64"); for k in 0..vs[i].tys.len() invariant 0 <= k && k <= vs[i].tys.len(), { out.push_str(", "); out.push_str(mem_ty(&vs[i].tys[k]).as_str()); } out.push_str(" }\n"); } for p in 0..vs[i].tys.len() invariant 0 <= p && p <= vs[i].tys.len(), { visit(&vs[i].tys[p], tb, seen, out, f - 1); } } },
        }
    }
}
