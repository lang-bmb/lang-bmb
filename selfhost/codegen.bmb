#[summary("코드 생성 (stage0 compiler/src/codegen.rs의 포트, 백로그 4D-05). 전체 검사 모드: 증명된 의무가 없다고 보고 검사를 모두 남긴다. 타입의 배치와 LLVM 타입 정의 (4D-05b), 스칼라 프로그램 (4D-05c), 스칼라 원소의 배열과 슬라이스 (4D-05d1), 구조체와 메모리 값 (4D-05d2), 열거형·match·? (4D-05d3), 힙의 값과 그 해제·복제 (4D-05e). 옮기지 않은 구문은 Gen.todo에 까닭을 남긴다. 타입은 낮춘 것이다 (lowered). 타입을 걷는 함수의 f는 남은 깊이다 (ADR-0140)")]
mod codegen {
    #[summary("어떤 타입이든의 자리 (stage0 any_place의 결과): 주소, 타입, 스칼라 자리면 그 레지스터 타입 (아니면 빈 글: 메모리 꼴), ok가 거짓이면 옮기지 않은 자리")]
    struct AnyPlace { ptr: String, ty: ast::TypeKind, reg: String, ok: bool }

    #[summary("배열이나 슬라이스인 지역 이름의 자리 (stage0 Slot::Arr): 첫 원소의 주소, 길이의 글, 원소 종류, 원소 타입")]
    struct ArrSlot { ptr: String, len: String, elem: String, ety: ast::TypeKind }

    #[summary("스칼라 참조 인자의 임시 자리를 호출 뒤에 원소로 되돌려 쓸 곳 (stage0 Back): 임시 자리, 원소 종류, 원소나 자리의 주소, 레지스터 타입, 메모리 꼴의 자리인가 (필드 따위), 그 타입")]
    struct Back { tmp: String, elem: String, ptr: String, lt: String, mem: bool, ty: ast::TypeKind }

    #[summary("식의 값 (stage0 CVal): 레지스터 값이나 상수의 글, 배열이나 슬라이스(첫 원소의 주소와 길이의 글), 메모리에 사는 구조체나 열거형의 값(주소와 타입: 간직하는 쪽이 옮긴다), 단위 값, 끝나지 않는 식의 값")]
    enum CVal { Imm(String), Arr(String, String), Ptr(String, ast::TypeKind), Unit, Never }

    #[summary("배열 리터럴의 상수 원소: 부호와 크기")]
    struct ConstElem { neg: bool, mag: u64 }

    #[summary("정수 변환 T::try_from(x)의 대상 타입과 인자")]
    struct Conv { target: ast::IntTy, arg: ast::Expr }

    #[summary("구조체나 열거형인 지역 이름의 자리 (stage0 Slot::Data): 주소와 타입")]
    struct DataSlot { ptr: String, ty: ast::TypeKind }

    #[summary("낮출 정의 하나: 경로, 단위, 구문")]
    struct Def { path: String, unit: String, d: ast::FnDef }

    #[summary("원소의 주소와 원소 종류 (stage0 elem_ptr의 결과)")]
    struct ElemPtr { ptr: String, elem: String }

    #[summary("구조체의 필드: 차례와 타입")]
    struct FieldAt { k: usize, ty: ast::TypeKind }

    #[summary("break나 continue가 떠날 수 있는 루프 (stage0 GLoop): 레이블(없으면 빈 글), continue가 가는 곳, break가 가는 곳, loop의 break e가 값을 두는 자리와 그 타입, 루프가 시작할 때의 pending의 길이 (그 뒤의 임시값은 루프 안의 구역의 것이다)")]
    struct GLoop { label: String, head: String, end: String, slot: Option<String>, ty: ast::TypeKind, mark: usize }

    #[summary("함수 하나를 낮추는 상태 (stage0 Gen). out은 몸의 글, allocas는 entry의 자리들, tmp와 label은 %tN과 레이블의 번호, slots는 지역 이름의 자리, todo는 아직 옮기지 않은 구문을 만난 까닭들 (비어 있지 않으면 모듈을 내지 않는다), print_f64는 print_f64를 불렀는가 (그 런타임 조각을 모듈에 붙인다), loops는 지금 낮추는 코드를 둘러싼 루프들 (안쪽이 뒤), globals는 이 함수의 상수들이고 consts는 그 줄 수, pending은 힙 메모리를 가진 임시값들 (구역이 끝날 때 놓는다), clones는 복제 코드를 부른 타입의 글들")]
    struct Gen { path: String, base: String, unit: String, out: String, allocas: String, tmp: u32, label: u32, slots: table::Table<Slot>, checks: u32, globals: String, consts: u32, ret: ast::TypeKind, todo: Vec<String>, print_f64: bool, loops: Vec<GLoop>, pending: Vec<Pend>, clones: Vec<String> }

    impl Gen {
        #[summary("entry에 ty의 자리를 하나 두고 그 이름을 준다")]
        #[effects(alloc)]
        fn alloca(self: &mut Gen, ty: &str) -> String {
            let p: String = self.t();
            self.allocas.push_str("  ");
            self.allocas.push_str(p.as_str());
            self.allocas.push_str(" = alloca ");
            self.allocas.push_str(ty);
            self.allocas.push_str("\n");
            p
        }

        #[summary("any_place의 변수 아닌 갈래: place의 자리 (메모리 꼴)")]
        #[effects(alloc)]
        fn any_other(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> AnyPlace
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return AnyPlace { ptr: String::from("undef"), ty: ast::TypeKind::Error, reg: String::new(), ok: false };
            }
            let pl: Place = self.place(e, ck, tb, f - 1);
            AnyPlace { ptr: pl.ptr, ty: pl.ty, reg: String::new(), ok: pl.ok }
        }

        #[summary("어떤 타입이든의 자리 (stage0 any_place): 변수와 스칼라 참조를 지난 *x는 제 자리 (스칼라면 레지스터 꼴), 나머지는 place. &는 벗긴다")]
        #[effects(alloc)]
        fn any_place(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> AnyPlace
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return AnyPlace { ptr: String::from("undef"), ty: ast::TypeKind::Error, reg: String::new(), ok: false };
            }
            match &e.kind {
                ast::ExprKind::Int(ap_int0, ap_int1) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Float(ap_float0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::ByteLit(ap_bytelit0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::ByteStr(ap_bytestr0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::StrLit(ap_strlit0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::CharLit(ap_charlit0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Bool(ap_bool0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Unit => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Var(id) => self.any_var(e, id.name.as_str(), ck, tb, f - 1),
                ast::ExprKind::Call(ap_call0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Method(ap_method0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Index(ap_index0, ap_index1) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Unary(ap_unary0, ap_unary1) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Binary(ap_binary0, ap_binary1, ap_binary2) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Ref(ap_m, rx) => self.any_place(&**rx, ck, tb, f - 1),
                ast::ExprKind::If(ap_if0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Block(ap_block0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Array(ap_array0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Repeat(ap_repeat0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Old(ap_old0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Quant(ap_quant0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Trigger(ap_trigger0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Closure(ap_closure0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::StructLit(ap_structlit0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Path(ap_path0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Deref(dx) => { let through: bool = match var_name(&**dx) { None => false, Some(dn) => { match self.scalar_slot(dn.as_str()) { None => false, Some(ds) => true, } }, }; if through { match var_name(&**dx) { None => self.any_other(e, ck, tb, f - 1), Some(dn2) => self.any_var(e, dn2.as_str(), ck, tb, f - 1), } } else { self.any_other(e, ck, tb, f - 1) } },
                ast::ExprKind::Field(ap_field0, ap_field1) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Match(ap_match0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Return(ap_return0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Try(ap_try0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Loop(ap_loop0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Break(ap_break0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Continue(ap_continue0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Range(ap_range0) => self.any_other(e, ck, tb, f - 1),
                ast::ExprKind::Error => self.any_other(e, ck, tb, f - 1),
            }
        }

        #[summary("any_place의 변수 갈래: 스칼라 자리는 레지스터 꼴, 배열과 메모리 값은 제 자리")]
        #[effects(alloc)]
        fn any_var(self: &mut Gen, e: &ast::Expr, name: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> AnyPlace
            decreases f,
        {
            let t: ast::TypeKind = match self.local_ty(name, tb) {
                None => ast::TypeKind::Error,
                Some(lt) => lowered::value_ty(&lt),
            };
            match self.scalar_slot(name) {
                None => {},
                Some(ss) => { return AnyPlace { ptr: ss.ptr, ty: t, reg: ss.ty, ok: true }; },
            }
            match self.arr_slot(name) {
                None => {},
                Some(asl) => { return AnyPlace { ptr: asl.ptr, ty: t, reg: String::new(), ok: true }; },
            }
            match self.data_slot(name) {
                None => {},
                Some(dsl) => { return AnyPlace { ptr: dsl.ptr, ty: dsl.ty, reg: String::new(), ok: true }; },
            }
            self.todo_at("a place that is a local without a slot", e.span);
            AnyPlace { ptr: String::from("undef"), ty: ast::TypeKind::Error, reg: String::new(), ok: false }
        }

        #[summary("산술 (stage0 arith): 넘침을 재고 넘치면 멈춘다 (전체 검사 모드: 증명된 의무가 없다)")]
        #[effects(alloc)]
        fn arith(self: &mut Gen, inst: &str, a: &str, b: &str, signed: bool) -> CVal {
            let r: String = self.t();
            let s: String = if signed {
                String::from("s")
            } else {
                String::from("u")
            };
            let pair: String = self.t();
            let ovf: String = self.t();
            let ok: String = self.t();
            let mut call: String = types::cat5(pair.as_str(), " = call {i64, i1} @llvm.", s.as_str(), inst, ".with.overflow.i64(i64 ");
            call.push_str(a);
            call.push_str(", i64 ");
            call.push_str(b);
            call.push_str(")");
            self.emit(call.as_str());
            self.emit(types::cat4(ovf.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 1").as_str());
            self.emit(types::cat4(ok.as_str(), " = xor i1 ", ovf.as_str(), ", true").as_str());
            self.check(ok.as_str(), types::cat3("`", inst, "` may overflow").as_str());
            self.emit(types::cat4(r.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 0").as_str());
            CVal::Imm(r)
        }

        #[summary("갈래의 몸 자리 s에서 놓는 값이 있는가 (검사기의 MoveInfo.arm_drops)")]
        #[effects(alloc)]
        fn arm_drops_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => ck.b.needs.items[at].moves.arm_drops.has(body::span_key(s).as_str()),
            }
        }

        #[summary("배열이나 슬라이스인 지역 변수 name의 자리")]
        #[effects(alloc)]
        fn arr_slot(self: &Gen, name: &str) -> Option<ArrSlot> {
            match self.slots.find(name) {
                None => None,
                Some(at) => { match &self.slots.items[at] { Slot::Scalar(as_p, as_t) => None, Slot::Arr(sl) => Some(ArrSlot { ptr: sl.ptr.clone(), len: sl.len.clone(), elem: sl.elem.clone(), ety: sl.ety.clone() }), Slot::Data(as_d) => None, } },
            }
        }

        #[summary("배열 리터럴과 반복 (stage0 expr의 Array·Repeat): 배열을 entry의 자리에 두고 채운다. 원소가 메모리 값이면 init_data_array")]
        #[effects(alloc)]
        fn array_lit(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            if !body::is_array(&ty) {
                return self.todo_expr("an array literal whose type is not an array", e);
            }
            let el: ast::TypeKind = elem_of(&ty);
            let n: String = array_len_text(&ty);
            if is_mem_elem(&el) {
                let dptr: String = self.temp(&ty);
                self.init_data_array(e, dptr.as_str(), &ty, ck, tb, f - 1);
                return CVal::Arr(dptr, n);
            }
            if !is_scalar_ty(&el) {
                return self.todo_expr("an array of values that are not scalars", e);
            }
            let elem: String = elem_kind(&el);
            let ptr: String = self.alloca(types::cat5("[", n.as_str(), " x ", mem(elem.as_str()).as_str(), "]").as_str());
            self.init_array(e, ptr.as_str(), elem.as_str(), ck, tb, f - 1);
            CVal::Arr(ptr, n)
        }

        #[summary("배열이나 슬라이스의 값, 또는 Vec의 원소들 (stage0 array_of): 임시 Vec은 구역이 끝날 때 놓는다")]
        #[effects(alloc)]
        fn array_of(self: &mut Gen, base: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", base);
            }
            if !is_vec(&self.ty(base, tb)) && !self.vec_var(base) {
                return self.expr(base, ck, tb, f - 1);
            }
            let hdr: String = self.vec_hdr(base, ck, tb, f - 1);
            if hdr == "undef" {
                return CVal::Never;
            }
            self.vec_view(hdr.as_str())
        }

        #[summary("대입 (stage0 stmt의 Assign): 스칼라 지역 변수, 단위 값의 지역 변수, 배열 지역 변수 전체, 메모리 값의 지역 변수, 스칼라 원소, 스칼라 참조 매개변수를 지나는 *x, 그 밖의 자리 (필드, 메모리 원소, 참조를 지난 자리)는 값을 먼저 셈하고 자리에 쓴다")]
        #[effects(alloc)]
        fn assign(self: &mut Gen, a: &ast::Assign, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", a.span);
                return;
            }
            match &a.target.kind {
                ast::ExprKind::Int(as_int0, as_int1) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Float(as_float0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::ByteLit(as_bytelit0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::ByteStr(as_bytestr0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::StrLit(as_strlit0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::CharLit(as_charlit0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Bool(as_bool0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Unit => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Var(id) => { if decls::is_unit(&self.ty(&a.target, tb)) { let unit_v: CVal = self.expr(&a.value, ck, tb, f - 1); return; } match self.arr_slot(id.name.as_str()) { None => {}, Some(asl) => { if is_mem_elem(&asl.ety) { match self.local_ty(id.name.as_str(), tb) { None => self.todo_at("an assignment to an array without a type", a.span), Some(alt) => self.init_data_array(&a.value, asl.ptr.as_str(), &alt, ck, tb, f - 1), } } else { self.init_array(&a.value, asl.ptr.as_str(), asl.elem.as_str(), ck, tb, f - 1); } return; }, } match self.data_slot(id.name.as_str()) { None => {}, Some(dsl) => { let dval: CVal = self.expr(&a.value, ck, tb, f - 1); if self.replaces(a.span, ck) { self.drop_at(dsl.ptr.as_str(), &dsl.ty, tb); } self.drop_moves(4, a.span, ck, tb); self.put(&dval, dsl.ptr.as_str(), &dsl.ty); return; }, } match self.scalar_slot(id.name.as_str()) { None => self.todo_at("an assignment to a local without a slot", a.span), Some(slot) => { let v: String = imm(&self.expr(&a.value, ck, tb, f - 1)); self.emit(types::cat7("store ", slot.ty.as_str(), " ", v.as_str(), ", ptr ", slot.ptr.as_str(), "").as_str()); }, } },
                ast::ExprKind::Call(as_call0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Method(as_method0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Index(ib, ii) => { let scalar_elem: bool = match var_name(&**ib) { None => false, Some(bn) => { match self.arr_slot(bn.as_str()) { None => { match self.data_slot(bn.as_str()) { None => true, Some(vsl) => { match body::vec_elem(&lowered::value_ty(&vsl.ty)) { None => true, Some(vel) => !is_mem_elem(&vel), } }, } }, Some(isl) => !is_mem_elem(&isl.ety), } }, }; if scalar_elem { let ep: ElemPtr = self.elem_ptr(&a.target, &**ib, &**ii, ck, tb, f - 1); let ev: String = imm(&self.expr(&a.value, ck, tb, f - 1)); self.store_elem(ep.elem.as_str(), ev.as_str(), ep.ptr.as_str()); } else { self.assign_place(a, false, ck, tb, f - 1); } },
                ast::ExprKind::Unary(as_unary0, as_unary1) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Binary(as_binary0, as_binary1, as_binary2) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Ref(as_ref0, as_ref1) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::If(as_if0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Block(as_block0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Array(as_array0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Repeat(as_repeat0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Old(as_old0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Quant(as_quant0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Trigger(as_trigger0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Closure(as_closure0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::StructLit(as_structlit0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Path(as_path0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Deref(dx) => { let through: Option<ScalarSlot> = match var_name(&**dx) { None => None, Some(dn) => self.scalar_slot(dn.as_str()), }; match through { None => self.assign_place(a, true, ck, tb, f - 1), Some(dslot) => { let dv: String = imm(&self.expr(&a.value, ck, tb, f - 1)); self.emit(types::cat7("store ", dslot.ty.as_str(), " ", dv.as_str(), ", ptr ", dslot.ptr.as_str(), "").as_str()); }, } },
                ast::ExprKind::Field(as_field0, as_field1) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Match(as_match0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Return(as_return0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Try(as_try0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Loop(as_loop0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Break(as_break0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Continue(as_continue0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Range(as_range0) => self.assign_place(a, true, ck, tb, f - 1),
                ast::ExprKind::Error => self.assign_place(a, true, ck, tb, f - 1),
            }
        }

        #[summary("자리로의 대입 (stage0 stmt의 Assign의 마지막 갈래들): 값을 먼저 셈하고, 자리를 셈하고, 갈아치우는 옛 값을 놓고 (partial이면 일부가 옮겨진 자리의 남은 필드도), 쓴다 (Rust의 차례)")]
        #[effects(alloc)]
        fn assign_place(self: &mut Gen, a: &ast::Assign, partial: bool, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", a.span);
                return;
            }
            let v: CVal = self.expr(&a.value, ck, tb, f - 1);
            let pl: Place = self.place(&a.target, ck, tb, f - 1);
            if pl.ok {
                if self.replaces(a.span, ck) {
                    self.drop_at(pl.ptr.as_str(), &pl.ty, tb);
                }
                if partial {
                    self.drop_moves(4, a.span, ck, tb);
                }
                self.put(&v, pl.ptr.as_str(), &pl.ty);
            }
        }

        #[summary("이항 연산 (stage0 expr의 Binary 갈래들): 짧은 회로, f64, 정수의 비교·비트·시프트·산술·나눗셈")]
        #[effects(alloc)]
        fn binary(self: &mut Gen, e: &ast::Expr, op: ast::BinOp, l: &ast::Expr, r: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            if is_and(op) || is_or(op) {
                let slot: String = self.alloca("i1");
                let lv: String = imm(&self.expr(l, ck, tb, f - 1));
                self.emit(types::cat4("store i1 ", lv.as_str(), ", ptr ", slot.as_str()).as_str());
                let rhs: String = self.l("rhs");
                let end: String = self.l("sc");
                if is_and(op) {
                    self.emit(types::cat7("br i1 ", lv.as_str(), ", label %", rhs.as_str(), ", label %", end.as_str(), "").as_str());
                } else {
                    self.emit(types::cat7("br i1 ", lv.as_str(), ", label %", end.as_str(), ", label %", rhs.as_str(), "").as_str());
                }
                self.block(rhs.as_str());
                let rv: String = imm(&self.region_expr(r, ck, tb, f - 1));
                self.emit(types::cat4("store i1 ", rv.as_str(), ", ptr ", slot.as_str()).as_str());
                self.emit(types::cat2("br label %", end.as_str()).as_str());
                self.block(end.as_str());
                let out: String = self.t();
                self.emit(types::cat3(out.as_str(), " = load i1, ptr ", slot.as_str()).as_str());
                return CVal::Imm(out);
            }
            if body::is_cmp(op) && (self.is_text_expr(l, tb) || self.is_text_expr(r, tb)) {
                return self.todo_expr("a comparison of text", e);
            }
            let lt: ast::TypeKind = self.ty(l, tb);
            let a: String = imm(&self.expr(l, ck, tb, f - 1));
            let b: String = imm(&self.expr(r, ck, tb, f - 1));
            if body::is_f64(&lt) {
                let fop: String = float_op(op);
                if fop.len() == 0 {
                    return self.todo_expr("an `f64` operator", e);
                }
                let res: String = self.t();
                self.emit(types::cat7(res.as_str(), " = ", fop.as_str(), " double ", a.as_str(), ", ", b.as_str()).as_str());
                return CVal::Imm(res);
            }
            let signed: bool = is_signed(&lt);
            let ty: String = llty(&lt);
            let c: String = int_cmp(op, signed);
            if c.len() > 0 {
                let cres: String = self.t();
                let mut cl: String = types::cat5(cres.as_str(), " = icmp ", c.as_str(), " ", ty.as_str());
                cl.push_str(" ");
                cl.push_str(a.as_str());
                cl.push_str(", ");
                cl.push_str(b.as_str());
                self.emit(cl.as_str());
                return CVal::Imm(cres);
            }
            if body::is_bit(op) {
                let bres: String = self.t();
                let mut bl: String = types::cat5(bres.as_str(), " = ", bit_inst(op).as_str(), " ", ty.as_str());
                bl.push_str(" ");
                bl.push_str(a.as_str());
                bl.push_str(", ");
                bl.push_str(b.as_str());
                self.emit(bl.as_str());
                return CVal::Imm(bres);
            }
            match body::int_of(&lt) {
                None => self.todo_expr("an operator on a type that is not an integer", e),
                Some(i) => { if body::is_shift(op) { return self.shift(op, i, a.as_str(), r, b.as_str()); } match op { ast::BinOp::Add => { if body::bits(i) < 64 { self.narrow_arith("add", a.as_str(), b.as_str(), i) } else { self.arith("add", a.as_str(), b.as_str(), signed) } }, ast::BinOp::Sub => { if body::bits(i) < 64 { self.narrow_arith("sub", a.as_str(), b.as_str(), i) } else { self.arith("sub", a.as_str(), b.as_str(), signed) } }, ast::BinOp::Mul => { if body::bits(i) < 64 { self.narrow_arith("mul", a.as_str(), b.as_str(), i) } else { self.arith("mul", a.as_str(), b.as_str(), signed) } }, ast::BinOp::Div => self.div_rem(true, i, a.as_str(), b.as_str()), ast::BinOp::Rem => self.div_rem(false, i, a.as_str(), b.as_str()), ast::BinOp::Eq => self.todo_expr("an operator outside executable code", e), ast::BinOp::Ne => self.todo_expr("an operator outside executable code", e), ast::BinOp::Lt => self.todo_expr("an operator outside executable code", e), ast::BinOp::Le => self.todo_expr("an operator outside executable code", e), ast::BinOp::Gt => self.todo_expr("an operator outside executable code", e), ast::BinOp::Ge => self.todo_expr("an operator outside executable code", e), ast::BinOp::And => self.todo_expr("an operator outside executable code", e), ast::BinOp::Or => self.todo_expr("an operator outside executable code", e), ast::BinOp::Implies => self.todo_expr("an operator outside executable code", e), ast::BinOp::BitAnd => self.todo_expr("an operator outside executable code", e), ast::BinOp::BitOr => self.todo_expr("an operator outside executable code", e), ast::BinOp::BitXor => self.todo_expr("an operator outside executable code", e), ast::BinOp::Shl => self.todo_expr("an operator outside executable code", e), ast::BinOp::Shr => self.todo_expr("an operator outside executable code", e), } },
            }
        }

        #[summary("새 지역 변수 name에 src에 있는 타입 t의 값의 사본 (stage0 bind): 단위 값은 자리가 없다")]
        #[effects(alloc)]
        fn bind(self: &mut Gen, name: &str, src: &str, t: &ast::TypeKind) -> () {
            let vt: ast::TypeKind = lowered::value_ty(t);
            if decls::is_unit(&vt) {
                return;
            }
            if is_mem(&vt) {
                let mp: String = self.temp(&vt);
                self.copy(mp.as_str(), src, &vt);
                self.slots.insert(name, Slot::Data(DataSlot { ptr: mp, ty: vt }));
                return;
            }
            if body::is_array(&vt) {
                let ap: String = self.temp(&vt);
                self.copy(ap.as_str(), src, &vt);
                let ety: ast::TypeKind = elem_of(&vt);
                self.slots.insert(name, Slot::Arr(ArrSlot { ptr: ap, len: array_len_text(&vt), elem: elem_kind(&ety), ety: ety }));
                return;
            }
            let v: String = self.load_mem(src, &vt);
            let lt: String = llty(&vt);
            let ptr: String = self.alloca(lt.as_str());
            self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", ptr.as_str(), "").as_str());
            self.slots.insert(name, Slot::Scalar(ptr, lt));
        }

        #[summary("비트 메서드 (stage0 bit_method): 제 폭으로 잘라 LLVM의 내장 함수를 부르고 다시 넓힌다. 세는 메서드의 결과는 0으로 넓힌다")]
        #[effects(alloc)]
        fn bit_method(self: &mut Gen, m: &str, i: ast::IntTy, a: &str, n: &str) -> CVal {
            let w: u32 = body::bits(i);
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, w as u64);
            if m == "wrapping_shl" || m == "wrapping_shr" {
                let k: String = self.t();
                let mut mask: String = String::new();
                std::num::push_u64(&mut mask, w.wrapping_sub(1) as u64);
                self.emit(types::cat5(k.as_str(), " = and i64 ", n, ", ", mask.as_str()).as_str());
                let sop: ast::BinOp = if m == "wrapping_shl" {
                    ast::BinOp::Shl
                } else {
                    ast::BinOp::Shr
                };
                return self.shift_inst(sop, i, a, k.as_str());
            }
            if m == "swap_bytes" && w == 8 {
                return CVal::Imm(String::from(a));
            }
            let it: String = types::cat2("i", wt.as_str());
            let x: String = self.narrowed(a, w, it.as_str());
            let r: String = self.t();
            let head: String = types::cat4(r.as_str(), " = call ", it.as_str(), " @llvm.");
            if m == "rotate_left" || m == "rotate_right" {
                let k2: String = self.narrowed(n, w, it.as_str());
                let rot: String = if m == "rotate_left" {
                    String::from("fshl")
                } else {
                    String::from("fshr")
                };
                let mut line: String = types::cat5(head.as_str(), rot.as_str(), ".", it.as_str(), "(");
                line.push_str(types::cat7(it.as_str(), " ", x.as_str(), ", ", it.as_str(), " ", x.as_str()).as_str());
                line.push_str(types::cat5(", ", it.as_str(), " ", k2.as_str(), ")").as_str());
                self.emit(line.as_str());
            } else if m == "count_ones" || m == "count_zeros" {
                self.emit(types::cat7(head.as_str(), "ctpop.", it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ")").as_str()).as_str());
            } else if m == "leading_zeros" || m == "trailing_zeros" {
                let zf: String = if m == "leading_zeros" {
                    String::from("ctlz.")
                } else {
                    String::from("cttz.")
                };
                self.emit(types::cat7(head.as_str(), zf.as_str(), it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ", i1 false)").as_str()).as_str());
            } else if m == "leading_ones" || m == "trailing_ones" {
                let of: String = if m == "leading_ones" {
                    String::from("ctlz.")
                } else {
                    String::from("cttz.")
                };
                let inv: String = self.t();
                self.emit(types::cat7(inv.as_str(), " = xor ", it.as_str(), " ", x.as_str(), ", -1", "").as_str());
                self.emit(types::cat7(head.as_str(), of.as_str(), it.as_str(), "(", it.as_str(), " ", types::cat2(inv.as_str(), ", i1 false)").as_str()).as_str());
            } else if m == "reverse_bits" {
                self.emit(types::cat7(head.as_str(), "bitreverse.", it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ")").as_str()).as_str());
            } else if m == "swap_bytes" {
                self.emit(types::cat7(head.as_str(), "bswap.", it.as_str(), "(", it.as_str(), " ", types::cat2(x.as_str(), ")").as_str()).as_str());
            } else {
                self.todo.push(types::cat4("the bit method `", m, "` in ", self.path.as_str()));
                return CVal::Never;
            }
            let res: String = if m == "count_zeros" {
                let z: String = self.t();
                self.emit(types::cat7(z.as_str(), " = sub ", it.as_str(), " ", wt.as_str(), ", ", r.as_str()).as_str());
                z
            } else {
                r
            };
            if w == 64 {
                return CVal::Imm(res);
            }
            let ext: String = if body::bit_count(m) || !body::signed(i) {
                String::from("zext")
            } else {
                String::from("sext")
            };
            let back: String = self.t();
            self.emit(types::cat7(back.as_str(), " = ", ext.as_str(), " ", it.as_str(), " ", types::cat2(res.as_str(), " to i64").as_str()).as_str());
            CVal::Imm(back)
        }

        #[summary("레이블 한 줄")]
        #[effects(alloc)]
        fn block(self: &mut Gen, label: &str) -> () {
            self.out.push_str(label);
            self.out.push_str(":\n");
        }

        #[summary("블록의 값 (stage0 block_expr): 문장들 (문장마다 그 임시값을 놓는다), 이어서 꼬리 식. 블록 끝에서 아직 가진 지역 변수를 놓는다 (값은 먼저 제 메모리로 옮긴다)")]
        #[effects(alloc)]
        fn block_expr(self: &mut Gen, b: &ast::Block, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", b.span);
                return CVal::Never;
            }
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                let mark: usize = self.pending.len();
                self.stmt(&b.stmts[i], ck, tb, f - 1);
                let done: CVal = self.release(mark, CVal::Unit, tb);
            }
            let v: CVal = match &b.tail {
                None => CVal::Unit,
                Some(e) => self.region_expr(&**e, ck, tb, f - 1),
            };
            if !self.drops_at(b.span, ck) {
                return v;
            }
            let kept: CVal = self.detach(v);
            self.drop_moves(0, b.span, ck, tb);
            kept
        }

        #[summary("Box::new(v) (stage0 box_new): v를 셈하고, malloc의 메모리에 옮기고, 그 주소를 담은 칸이 값이다")]
        #[effects(alloc)]
        fn box_new(self: &mut Gen, e: &ast::Expr, c: &ast::Call, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 || c.args.len() != 1 {
                return self.todo_expr("a `Box::new` without one argument", e);
            }
            let t: ast::TypeKind = self.ty(e, tb);
            match body::box_inner(&t) {
                None => self.todo_expr("a `Box::new` whose type is not a `Box`", e),
                Some(inner) => { let v: CVal = self.expr(&c.args[0], ck, tb, f - 1); let h: String = self.t(); self.emit(types::cat4(h.as_str(), " = call ptr @bmb_box_alloc(i64 ", size_of(&inner).as_str(), ")").as_str()); self.put(&v, h.as_str(), &inner); let cell: String = self.temp(&t); self.emit(types::cat4("store ptr ", h.as_str(), ", ptr ", cell.as_str()).as_str()); CVal::Ptr(cell, t) },
            }
        }

        #[summary("갈래 자리 s에서 놓는 값이 있는가 (검사기의 MoveInfo.branch_drops)")]
        #[effects(alloc)]
        fn branch_drops_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => ck.b.needs.items[at].moves.branch_drops.has(body::span_key(s).as_str()),
            }
        }

        #[summary("바이트열의 상수 (stage0 byte_const): 이 함수의 비공개 상수로 두고 그 주소와 길이를 준다")]
        #[effects(alloc)]
        fn byte_const(self: &mut Gen, v: &[u8]) -> CVal {
            let mut name: String = types::cat3("@\"", self.path.as_str(), ".bytes.");
            std::num::push_u64(&mut name, self.consts as u64);
            name.push_str("\"");
            let mut n: String = String::new();
            std::num::push_u64(&mut n, v.len() as u64);
            self.globals.push_str(name.as_str());
            self.globals.push_str(" = private unnamed_addr constant [");
            self.globals.push_str(n.as_str());
            self.globals.push_str(" x i8] c\"");
            for i in 0..v.len()
                invariant 0 <= i && i <= v.len(),
            {
                self.globals.push_str("\\");
                let hi: u32 = (v[i] / 16) as u32;
                let lo: u32 = (v[i] % 16) as u32;
                if hi < 10 {
                    lexer::push_code(&mut self.globals, 48 + hi);
                } else {
                    lexer::push_code(&mut self.globals, 55 + hi);
                }
                if lo < 10 {
                    lexer::push_code(&mut self.globals, 48 + lo);
                } else {
                    lexer::push_code(&mut self.globals, 55 + lo);
                }
            }
            self.globals.push_str("\", align 1\n");
            self.consts = self.consts.wrapping_add(1);
            CVal::Arr(name, n)
        }

        #[summary("제네릭 아닌 함수의 호출 (stage0 call). 인자: 스칼라, 스칼라 원소의 슬라이스(주소와 길이)와 값으로 넘기는 배열(주소), 스칼라 참조(자리의 주소). 결과: 스칼라, 스칼라 원소의 배열(부른 쪽의 메모리). 내장은 print_i64·print_u64·print_f64·print_str·print_bytes")]
        #[effects(alloc)]
        fn call(self: &mut Gen, e: &ast::Expr, c: &ast::Call, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            if c.path.len() == 2 && c.path[0].name == "u32" && c.path[1].name == "from" && c.args.len() == 1 {
                return self.expr(&c.args[0], ck, tb, f - 1);
            }
            if body::is_f64_from(c.path.as_slice()) && c.args.len() == 1 {
                return self.f64_from(&c.args[0], ck, tb, f - 1);
            }
            match body::from_bytes_int(c.path.as_slice()) {
                None => {},
                Some(bi) => { return self.from_bytes(e, c, bi, ck, tb, f - 1); },
            }
            if body::mem_op(c.path.as_slice()) && c.path.len() == 3 {
                return self.mem_call(e, c, c.path[2].name == "replace", ck, tb, f - 1);
            }
            if c.path.len() == 2 && (c.path[0].name == "Vec" || c.path[0].name == "String") && (c.path[1].name == "new" || c.path[1].name == "with_capacity") {
                return self.vec_new(e, c, ck, tb, f - 1);
            }
            if body::text_builtin(c.path.as_slice()) {
                return self.todo_expr("a call of a built-in of text (backlog 4D-05f)", e);
            }
            if body::is_box_new(c.path.as_slice()) {
                return self.box_new(e, c, ck, tb, f - 1);
            }
            let target: String = self.resolve(c.path.as_slice(), tb);
            match tb.fns.find(target.as_str()) {
                None => { if c.path.len() == 0 { return self.todo_expr("a call without a path", e); } let vt: ast::TypeKind = self.ty(e, tb); self.variant(e, &vt, c.path[c.path.len() - 1].name.as_str(), c.args.as_slice(), ck, tb, f - 1) },
                Some(at) => { let bytes_out: bool = target == "print_str" || target == "print_bytes"; let print: bool = target == "print_i64" || target == "print_u64" || target == "print_f64" || bytes_out; if tb.fns.items[at].builtin && !print || tb.fns.items[at].generics.len() > 0 || has_trait(&tb.fns.items[at]) || tb.targs.has(body::span_key(e.span).as_str()) { return self.todo_expr("a call of a built-in, a generic function or a trait method", e); } let mut flat: Vec<String> = Vec::new(); let mut backs: Vec<Back> = Vec::new(); for k in 0..c.args.len() invariant 0 <= k && k <= c.args.len(), { let aty: ast::TypeKind = self.ty(&c.args[k], tb); let pk: u32 = if k < tb.fns.items[at].params.len() { param_kind(&tb.fns.items[at].params[k]) } else { 0 }; if pk == 9 { return self.todo_expr("an argument for a parameter that is not ported (a reference to an array or to a reference)", &c.args[k]); } if pk == 2 && k < tb.fns.items[at].params.len() { match body::ref_inner(&tb.fns.items[at].params[k]) { None => {}, Some(inner) => { let rp: String = self.scalar_ref(&c.args[k], &inner, types::is_ref_mut(&tb.fns.items[at].params[k]), &mut backs, ck, tb, f - 1); flat.push(types::cat2("ptr ", rp.as_str())); }, } } else { let av: CVal = self.expr(&c.args[k], ck, tb, f - 1); match &av { CVal::Imm(v) => flat.push(types::cat3(llty(&aty).as_str(), " ", v.as_str())), CVal::Arr(ap, an) => { flat.push(types::cat2("ptr ", ap.as_str())); if pk != 3 { flat.push(types::cat2("i64 ", an.as_str())); } }, CVal::Ptr(pp, pt) => { if pk == 5 { let ptmp: String = self.temp(pt); self.copy(ptmp.as_str(), pp.as_str(), pt); flat.push(types::cat2("ptr ", ptmp.as_str())); } else { flat.push(types::cat2("ptr ", pp.as_str())); } }, CVal::Unit => {}, CVal::Never => { if pk == 1 { flat.push(String::from("ptr undef")); flat.push(String::from("i64 undef")); } else if pk == 3 || pk == 4 || pk == 5 { flat.push(String::from("ptr undef")); } else if llty(&aty) != "void" { flat.push(types::cat2(llty(&aty).as_str(), " undef")); } }, } } } if target == "print_f64" { if flat.len() != 2 { return self.todo_expr("a `print_f64` whose arguments are not two values", e); } let pc: String = self.t(); self.emit(types::cat4(pc.as_str(), " = icmp ule ", flat[1].as_str(), ", 65535").as_str()); self.check(pc.as_str(), "`print_f64` decimals above 65535"); self.print_f64 = true; } let ret: ast::TypeKind = if print { ast::TypeKind::Unit } else { tb.fns.items[at].ret.clone() }; let callee: String = if bytes_out { String::from("@bmb_print_bytes") } else if print { types::cat2("@bmb_", target.as_str()) } else { fn_sym(target.as_str()) }; let args: String = types::join(flat.as_slice(), ", "); let res: CVal = if ret_in_memory(&ret) { let out: String = self.temp(&ret); let sep: String = if flat.len() > 0 { String::from(", ") } else { String::new() }; self.emit(types::cat7("call void ", callee.as_str(), "(ptr ", out.as_str(), sep.as_str(), args.as_str(), ")").as_str()); self.read(out.as_str(), &ret) } else if decls::is_unit(&ret) { self.emit(types::cat5("call void ", callee.as_str(), "(", args.as_str(), ")").as_str()); CVal::Unit } else { let r: String = self.t(); self.emit(types::cat7(r.as_str(), " = call ", llty(&ret).as_str(), " ", callee.as_str(), "(", types::cat2(args.as_str(), ")").as_str()).as_str()); CVal::Imm(r) }; for b in 0..backs.len() invariant 0 <= b && b <= backs.len(), { let x: String = self.t(); self.emit(types::cat5(x.as_str(), " = load ", backs[b].lt.as_str(), ", ptr ", backs[b].tmp.as_str()).as_str()); let be: String = backs[b].elem.clone(); let bp: String = backs[b].ptr.clone(); if backs[b].mem { let bt: ast::TypeKind = backs[b].ty.clone(); self.put(&CVal::Imm(x), bp.as_str(), &bt); } else { self.store_elem(be.as_str(), x.as_str(), bp.as_str()); } } res },
            }
        }

        #[summary("실행 중 검사 (stage0 check): cond가 거짓이면 멈춘다")]
        #[effects(alloc)]
        fn check(self: &mut Gen, cond: &str, what: &str) -> () {
            self.checks = self.checks.wrapping_add(1);
            let ok: String = self.l("ok");
            let bad: String = self.l("trap");
            let mut line: String = types::cat7("br i1 ", cond, ", label %", ok.as_str(), ", label %", bad.as_str(), " ; unproved: ");
            line.push_str(what);
            self.emit(line.as_str());
            self.block(bad.as_str());
            self.emit("call void @bmb_trap()");
            self.emit("unreachable");
            self.block(ok.as_str());
        }

        #[summary("checked_* (stage0 int_method의 checked 갈래들과 narrow_method의 마지막 갈래): 덧셈·뺄셈·곱셈은 넘치지 않을 때 Some, 나눗셈·나머지는 나누는 수가 0이 아니고 MIN / -1이 아닐 때 Some. 좁은 타입은 값이 제 범위 안일 때만 Some")]
        #[effects(alloc)]
        fn checked_method(self: &mut Gen, e: &ast::Expr, op: &str, a: &str, b: &str, i: ast::IntTy, tb: &lowered::Tables) -> CVal {
            let signed: bool = body::signed(i);
            let sg: String = if signed {
                String::from("s")
            } else {
                String::from("u")
            };
            let r: String = self.t();
            let res: CVal = if op == "checked_add" || op == "checked_sub" || op == "checked_mul" {
                let base: String = if op == "checked_add" {
                    String::from("add")
                } else if op == "checked_sub" {
                    String::from("sub")
                } else {
                    String::from("mul")
                };
                let pair: String = self.t();
                let v: String = self.t();
                let ovf: String = self.t();
                let mut pl: String = types::cat5(pair.as_str(), " = call {i64, i1} @llvm.", sg.as_str(), base.as_str(), ".with.overflow.i64(i64 ");
                pl.push_str(a);
                pl.push_str(", i64 ");
                pl.push_str(b);
                pl.push_str(")");
                self.emit(pl.as_str());
                self.emit(types::cat4(v.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 0").as_str());
                self.emit(types::cat4(ovf.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 1").as_str());
                self.emit(types::cat4(r.as_str(), " = xor i1 ", ovf.as_str(), ", true").as_str());
                self.option(e, r.as_str(), v.as_str(), tb)
            } else {
                self.emit(types::cat4(r.as_str(), " = icmp ne i64 ", b, ", 0").as_str());
                let ok: String = if signed {
                    let m: String = self.t();
                    let n: String = self.t();
                    let both: String = self.t();
                    let fine: String = self.t();
                    let ok2: String = self.t();
                    self.emit(types::cat5(m.as_str(), " = icmp eq i64 ", a, ", ", int_min(i).as_str()).as_str());
                    self.emit(types::cat4(n.as_str(), " = icmp eq i64 ", b, ", -1").as_str());
                    self.emit(types::cat5(both.as_str(), " = and i1 ", m.as_str(), ", ", n.as_str()).as_str());
                    self.emit(types::cat4(fine.as_str(), " = xor i1 ", both.as_str(), ", true").as_str());
                    self.emit(types::cat5(ok2.as_str(), " = and i1 ", r.as_str(), ", ", fine.as_str()).as_str());
                    ok2
                } else {
                    r.clone()
                };
                let d: String = self.t();
                let q: String = self.t();
                let inst: String = if op == "checked_div" {
                    String::from("div")
                } else {
                    String::from("rem")
                };
                self.emit(types::cat7(d.as_str(), " = select i1 ", ok.as_str(), ", i64 ", b, ", i64 1", "").as_str());
                self.emit(types::cat7(q.as_str(), " = ", sg.as_str(), inst.as_str(), " i64 ", a, types::cat2(", ", d.as_str()).as_str()).as_str());
                self.option(e, ok.as_str(), q.as_str(), tb)
            };
            if body::bits(i) == 64 || !is_ptr(&res) {
                return res;
            }
            let ptr: String = ptr_of(&res);
            let ty: ast::TypeKind = ptr_ty(&res);
            let p: String = self.t();
            self.emit(types::cat5(p.as_str(), " = getelementptr inbounds ", view_ty(&ty, "Some").as_str(), ", ptr ", types::cat2(ptr.as_str(), ", i32 0, i32 1").as_str()).as_str());
            let nv: String = self.t();
            let tagp: String = self.t();
            let tag: String = self.t();
            let some: String = self.t();
            let k: String = self.t();
            self.emit(types::cat3(nv.as_str(), " = load i64, ptr ", p.as_str()).as_str());
            let fits: String = self.fits(nv.as_str(), i);
            self.emit(types::cat5(tagp.as_str(), " = getelementptr inbounds ", data_ty(&ty).as_str(), ", ptr ", types::cat2(ptr.as_str(), ", i32 0, i32 0").as_str()).as_str());
            self.emit(types::cat3(tag.as_str(), " = load i64, ptr ", tagp.as_str()).as_str());
            self.emit(types::cat4(some.as_str(), " = icmp ne i64 ", tag.as_str(), ", 0").as_str());
            let both2: String = self.t();
            self.emit(types::cat5(both2.as_str(), " = and i1 ", some.as_str(), ", ", fits.as_str()).as_str());
            self.emit(types::cat4(k.as_str(), " = zext i1 ", both2.as_str(), " to i64").as_str());
            self.emit(types::cat4("store i64 ", k.as_str(), ", ptr ", tagp.as_str()).as_str());
            res
        }

        #[summary("match나 ?가 그 값을 옮기는가 (검사기의 MoveInfo.consumed)")]
        #[effects(alloc)]
        fn consumed_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => types::has(ck.b.needs.items[at].moves.consumed.as_slice(), body::span_key(s).as_str()),
            }
        }

        #[summary("값을 옮긴다 (stage0 copy): memmove라 x = x도 된다")]
        #[effects(alloc)]
        fn copy(self: &mut Gen, dst: &str, src: &str, t: &ast::TypeKind) -> () {
            let mut line: String = types::cat5("call void @llvm.memmove.p0.p0.i64(ptr ", dst, ", ptr ", src, ", i64 ");
            line.push_str(size_of(t).as_str());
            line.push_str(", i1 false)");
            self.emit(line.as_str());
        }

        #[summary("a.copy_within(lo..hi, dest) (stage0 copy_within, ADR-0083): 범위들을 재고 memmove 한 번 (겹쳐도 된다)")]
        #[effects(alloc)]
        fn copy_within(self: &mut Gen, e: &ast::Expr, mc: &ast::Method, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 || mc.args.len() != 2 {
                return self.todo_expr("a `copy_within` without two arguments", e);
            }
            let t: ast::TypeKind = self.ty(&*mc.recv, tb);
            let el: ast::TypeKind = if is_vec(&t) {
                elem_of(&lowered::value_ty(&t))
            } else {
                elem_of(&t)
            };
            let av: CVal = self.array_of(&*mc.recv, ck, tb, f - 1);
            match range_of(&mc.args[0]) {
                None => self.todo_expr("a `copy_within` whose first argument is not a range", e),
                Some(r) => { let lo: String = imm(&self.expr(&*r.lo, ck, tb, f - 1)); let hi: String = imm(&self.expr(&*r.hi, ck, tb, f - 1)); let dest: String = imm(&self.expr(&mc.args[1], ck, tb, f - 1)); if !is_arr(&av) { if !is_never(&av) { self.todo_at("a `copy_within` of a value that is not an array, a slice or a `Vec`", e.span); } return CVal::Never; } let ptr: String = arr_ptr(&av); let len: String = arr_len(&av); let a: String = self.t(); let b: String = self.t(); self.emit(types::cat5(a.as_str(), " = icmp ule i64 ", lo.as_str(), ", ", hi.as_str()).as_str()); self.emit(types::cat5(b.as_str(), " = icmp ule i64 ", hi.as_str(), ", ", len.as_str()).as_str()); let srcok: String = self.t(); self.emit(types::cat5(srcok.as_str(), " = and i1 ", a.as_str(), ", ", b.as_str()).as_str()); self.check(srcok.as_str(), "`copy_within` source range may be out of bounds"); let n0: String = self.t(); let room: String = self.t(); let c: String = self.t(); self.emit(types::cat5(n0.as_str(), " = sub nuw i64 ", hi.as_str(), ", ", lo.as_str()).as_str()); self.emit(types::cat5(room.as_str(), " = sub nuw i64 ", len.as_str(), ", ", n0.as_str()).as_str()); self.emit(types::cat5(c.as_str(), " = icmp ule i64 ", dest.as_str(), ", ", room.as_str()).as_str()); self.check(c.as_str(), "`copy_within` destination may be out of bounds"); let n: String = self.t(); let bytes: String = self.t(); let src: String = self.t(); let dst: String = self.t(); let et: String = mem_ty(&el); self.emit(types::cat5(n.as_str(), " = sub nuw i64 ", hi.as_str(), ", ", lo.as_str()).as_str()); self.emit(types::cat5(bytes.as_str(), " = mul nuw i64 ", n.as_str(), ", ", size_of(&el).as_str()).as_str()); self.emit(types::cat7(src.as_str(), " = getelementptr inbounds ", et.as_str(), ", ptr ", ptr.as_str(), ", i64 ", lo.as_str()).as_str()); self.emit(types::cat7(dst.as_str(), " = getelementptr inbounds ", et.as_str(), ", ptr ", ptr.as_str(), ", i64 ", dest.as_str()).as_str()); self.emit(types::cat7("call void @llvm.memmove.p0.p0.i64(ptr ", dst.as_str(), ", ptr ", src.as_str(), ", i64 ", bytes.as_str(), ", i1 false)").as_str()); CVal::Unit },
            }
        }

        #[summary("메모리 값의 원소의 주소 (stage0 data_elem): 색인이 길이 안인지 잰다")]
        #[effects(alloc)]
        fn data_elem(self: &mut Gen, ptr: &str, len: &str, i: &str, ety: &ast::TypeKind) -> String {
            let c: String = self.t();
            self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", i, ", ", len).as_str());
            self.check(c.as_str(), "index may be out of bounds");
            let p: String = self.t();
            self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", mem_ty(ety).as_str(), ", ptr ", ptr, ", i64 ", i).as_str());
            p
        }

        #[summary("구조체나 열거형인 지역 변수 name의 자리")]
        #[effects(alloc)]
        fn data_slot(self: &Gen, name: &str) -> Option<DataSlot> {
            match self.slots.find(name) {
                None => None,
                Some(at) => { match &self.slots.items[at] { Slot::Scalar(ds_p, ds_t) => None, Slot::Arr(ds_a) => None, Slot::Data(sl) => Some(DataSlot { ptr: sl.ptr.clone(), ty: sl.ty.clone() }), } },
            }
        }

        #[summary("*b (stage0 expr의 Deref, Box의 것): 그 주소에 있는 값. 임시 Box에서 읽은 배열은 옮겨 둔다")]
        #[effects(alloc)]
        fn deref_box(self: &mut Gen, e: &ast::Expr, x: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let bv: CVal = self.expr(x, ck, tb, f - 1);
            if is_never(&bv) {
                return CVal::Never;
            }
            if !is_ptr(&bv) {
                return self.todo_expr("a `Box` value that is not in memory", e);
            }
            let bt: ast::TypeKind = ptr_ty(&bv);
            let temp: bool = self.read_temp(x, &bv, &bt, tb);
            match body::box_inner(&bt) {
                None => self.todo_expr("a `*` of a value that is not a `Box`", e),
                Some(inner) => { let h: String = self.unbox(ptr_of(&bv).as_str()); let v: CVal = self.read(h.as_str(), &inner); if temp { self.keep(v, &inner) } else { v } },
            }
        }

        #[summary("구조체나 열거형의 값을 제 메모리로 옮긴다 (stage0 detach)")]
        #[effects(alloc)]
        fn detach(self: &mut Gen, v: CVal) -> CVal {
            match &v {
                CVal::Imm(dt_x) => {},
                CVal::Arr(dt_p, dt_n) => {},
                CVal::Ptr(ptr, ty) => { if is_data(ty) { let tmp: String = self.temp(ty); self.copy(tmp.as_str(), ptr.as_str(), ty); return CVal::Ptr(tmp, ty.clone()); } },
                CVal::Unit => {},
                CVal::Never => {},
            }
            v
        }

        #[summary("나눗셈과 나머지 (stage0 expr의 Div·Rem): 0으로 나눔과 부호 있는 타입의 MIN / -1을 잰다")]
        #[effects(alloc)]
        fn div_rem(self: &mut Gen, div: bool, i: ast::IntTy, a: &str, b: &str) -> CVal {
            let c: String = self.t();
            self.emit(types::cat4(c.as_str(), " = icmp ne i64 ", b, ", 0").as_str());
            self.check(c.as_str(), "divisor may be zero");
            let signed: bool = body::signed(i);
            if signed {
                let m: String = self.t();
                let n: String = self.t();
                let both: String = self.t();
                let ok: String = self.t();
                self.emit(types::cat5(m.as_str(), " = icmp eq i64 ", a, ", ", int_min(i).as_str()).as_str());
                self.emit(types::cat4(n.as_str(), " = icmp eq i64 ", b, ", -1").as_str());
                self.emit(types::cat5(both.as_str(), " = and i1 ", m.as_str(), ", ", n.as_str()).as_str());
                self.emit(types::cat4(ok.as_str(), " = xor i1 ", both.as_str(), ", true").as_str());
                self.check(ok.as_str(), types::cat2(body::int_text(i).as_str(), "::MIN / -1").as_str());
            }
            let inst: String = if div {
                if signed {
                    String::from("sdiv")
                } else {
                    String::from("udiv")
                }
            } else if signed {
                String::from("srem")
            } else {
                String::from("urem")
            };
            let res: String = self.t();
            self.emit(types::cat7(res.as_str(), " = ", inst.as_str(), " i64 ", a, ", ", b).as_str());
            CVal::Imm(res)
        }

        #[summary("ptr에 있는 타입 t의 값이 힙 메모리를 가지면 놓는다 (stage0 drop_at)")]
        #[effects(alloc)]
        fn drop_at(self: &mut Gen, ptr: &str, t: &ast::TypeKind, tb: &lowered::Tables) -> () {
            let vt: ast::TypeKind = lowered::value_ty(t);
            if self.owns(&vt, tb) {
                self.emit(types::cat5("call void ", glue(&vt).as_str(), "(ptr ", ptr, ")").as_str());
            }
        }

        #[summary("자리 s에 적힌 경로들을 놓는다 (stage0 drop_block·drop_branch와 exits·partial_replaces의 루프). kind: 0 블록 끝, 1 갈래 끝, 2 함수나 루프를 떠남, 3 match의 갈래, 4 일부가 옮겨진 자리의 대입")]
        #[effects(alloc)]
        fn drop_moves(self: &mut Gen, kind: u8, s: source::Span, ck: &body::Checked, tb: &lowered::Tables) -> () {
            let names: Vec<String> = self.move_names(kind, s, ck);
            for i in 0..names.len()
                invariant 0 <= i && i <= names.len(),
            {
                self.drop_path(names[i].as_str(), tb);
            }
        }

        #[summary("지역 변수나 필드의 경로 p (s, s.buf)를 놓는다 (stage0 drop_path)")]
        #[effects(alloc)]
        fn drop_path(self: &mut Gen, p: &str, tb: &lowered::Tables) -> () {
            let parts: Vec<String> = moves::split_dots(p);
            if parts.len() == 0 {
                return;
            }
            let mut ptr: String = String::new();
            let mut ty: ast::TypeKind = ast::TypeKind::Error;
            match self.data_slot(parts[0].as_str()) {
                None => { match self.arr_slot(parts[0].as_str()) { None => { return; }, Some(asl) => { match self.local_ty(parts[0].as_str(), tb) { None => { return; }, Some(lt) => { ptr = asl.ptr; ty = lowered::value_ty(&lt); }, } }, } },
                Some(dsl) => { ptr = dsl.ptr; ty = dsl.ty; },
            }
            for k in 1..parts.len()
                invariant 1 <= k && k <= parts.len(),
            {
                match self.field_of(&ty, parts[k].as_str(), tb) {
                    None => { self.todo.push(types::cat4("a drop of a field path that is not of structs: ", p, " in ", self.path.as_str())); return; },
                    Some(fa) => { ptr = self.field_ptr(ptr.as_str(), &ty, fa.k); ty = fa.ty; },
                }
            }
            self.drop_at(ptr.as_str(), &ty, tb);
        }

        #[summary("mark부터의 임시값을 놓는다 (지우지는 않는다: return과 break의 길에서, 그 구역은 다른 길에서 끝난다)")]
        #[effects(alloc)]
        fn drop_pending_from(self: &mut Gen, mark: usize, tb: &lowered::Tables) -> () {
            for i in mark..self.pending.len()
                invariant mark <= i,
            {
                if i < self.pending.len() {
                    let pp: String = self.pending[i].ptr.clone();
                    let pt: ast::TypeKind = self.pending[i].ty.clone();
                    self.drop_at(pp.as_str(), &pt, tb);
                }
            }
        }

        #[summary("블록 자리 s에서 놓는 값이 있는가 (검사기의 MoveInfo.drops)")]
        #[effects(alloc)]
        fn drops_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => ck.b.needs.items[at].moves.drops.has(body::span_key(s).as_str()),
            }
        }

        #[summary("원소의 주소 (stage0 elem_ptr): 색인이 길이 안인지 재고 (전체 검사 모드) 그 원소를 가리킨다. 대입의 대상은 타입의 기록이 없어 변수의 자리에서 원소 종류를 읽는다")]
        #[effects(alloc)]
        fn elem_ptr(self: &mut Gen, e: &ast::Expr, base: &ast::Expr, index: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ElemPtr
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return ElemPtr { ptr: String::from("undef"), elem: String::from("i64") };
            }
            let elem: String = match var_name(base) {
                None => elem_kind(&elem_of(&self.ty(base, tb))),
                Some(bn) => { match self.arr_slot(bn.as_str()) { None => { match self.data_slot(bn.as_str()) { None => { self.todo_at("an index into a local that is not an array, a slice or a `Vec`", e.span); String::from("i64") }, Some(vsl) => { match body::vec_elem(&lowered::value_ty(&vsl.ty)) { None => { self.todo_at("an index into a local that is not an array, a slice or a `Vec`", e.span); String::from("i64") }, Some(vel) => elem_kind(&vel), } }, } }, Some(sl) => sl.elem, } },
            };
            let av: CVal = self.array_of(base, ck, tb, f - 1);
            let i: String = imm(&self.expr(index, ck, tb, f - 1));
            if !is_arr(&av) {
                if !is_never(&av) {
                    self.todo_at("an index into a value that is not an array or a slice", e.span);
                }
                return ElemPtr { ptr: String::from("undef"), elem: elem };
            }
            let c: String = self.t();
            self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", i.as_str(), ", ", arr_len(&av).as_str()).as_str());
            self.check(c.as_str(), "index may be out of bounds");
            let p: String = self.t();
            self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", mem(elem.as_str()).as_str(), ", ptr ", arr_ptr(&av).as_str(), ", i64 ", i.as_str()).as_str());
            ElemPtr { ptr: p, elem: elem }
        }

        #[summary("&v[a..b] (stage0 elem_slice): 범위가 길이 안인지 재고 그 조각의 주소와 길이를 준다")]
        #[effects(alloc)]
        fn elem_slice(self: &mut Gen, idx: &ast::Expr, base: &ast::Expr, lo: &ast::Expr, hi: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", idx);
            }
            let vt: ast::TypeKind = lowered::value_ty(&self.ty(base, tb));
            let whole: ast::TypeKind = match body::ref_inner(&vt) {
                None => vt.clone(),
                Some(inner) => inner,
            };
            let et: ast::TypeKind = match body::array_elem(&whole) {
                None => { match body::slice_elem(&whole) { None => { match body::vec_elem(&whole) { None => { return self.todo_expr("a range of a value that is not an array, a slice or a `Vec`", idx); }, Some(ve) => ve, } }, Some(se) => se, } },
                Some(ae) => ae,
            };
            let av: CVal = self.array_of(base, ck, tb, f - 1);
            let a: String = imm(&self.expr(lo, ck, tb, f - 1));
            let b: String = imm(&self.expr(hi, ck, tb, f - 1));
            if !is_arr(&av) {
                if !is_never(&av) {
                    self.todo_at("a range of a value that is not an array or a slice", idx.span);
                }
                return CVal::Never;
            }
            let ord: String = self.t();
            let end: String = self.t();
            let c: String = self.t();
            self.emit(types::cat5(ord.as_str(), " = icmp ule i64 ", a.as_str(), ", ", b.as_str()).as_str());
            self.emit(types::cat5(end.as_str(), " = icmp ule i64 ", b.as_str(), ", ", arr_len(&av).as_str()).as_str());
            self.emit(types::cat5(c.as_str(), " = and i1 ", ord.as_str(), ", ", end.as_str()).as_str());
            self.check(c.as_str(), "the range may be out of bounds");
            let ptr: String = self.t();
            let len: String = self.t();
            self.emit(types::cat7(ptr.as_str(), " = getelementptr ", mem_ty(&et).as_str(), ", ptr ", arr_ptr(&av).as_str(), ", i64 ", a.as_str()).as_str());
            self.emit(types::cat5(len.as_str(), " = sub nuw i64 ", b.as_str(), ", ", a.as_str()).as_str());
            CVal::Arr(ptr, len)
        }

        #[summary("몸에 명령 한 줄")]
        #[effects(alloc)]
        fn emit(self: &mut Gen, line: &str) -> () {
            self.out.push_str("  ");
            self.out.push_str(line);
            self.out.push_str("\n");
        }

        #[summary("함수를 끝낸다 (stage0 emit_return): ()는 ret void, 스칼라는 그 값, 배열과 메모리 값은 부른 쪽의 메모리에 옮기고 ret void")]
        #[effects(alloc)]
        fn emit_return(self: &mut Gen, rv: &CVal) -> () {
            if ret_in_memory(&self.ret) {
                let rt: ast::TypeKind = self.ret.clone();
                self.put(rv, "%\"ret.out\"", &rt);
                self.emit("ret void");
                return;
            }
            let ret: String = llty(&self.ret);
            if ret == "void" {
                self.emit("ret void");
            } else {
                self.emit(types::cat4("ret ", ret.as_str(), " ", imm(rv).as_str()).as_str());
            }
        }

        #[summary("자리 s에서 함수나 루프를 떠나며 놓는 값이 있는가 (검사기의 MoveInfo.exits)")]
        #[effects(alloc)]
        fn exits_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => ck.b.needs.items[at].moves.exits.has(body::span_key(s).as_str()),
            }
        }

        #[summary("식의 값 (stage0 expr). 지금은 리터럴, 스칼라 지역 변수, 단항·이항 연산, 블록, 스칼라의 if, 제네릭 아닌 함수의 호출")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn expr(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            match &e.kind {
                ast::ExprKind::Int(v, ex_r) => { let mut s: String = String::new(); wide::push_radix(&mut s, *v, 10); CVal::Imm(s) },
                ast::ExprKind::Float(bits) => CVal::Imm(f64_const(*bits)),
                ast::ExprKind::ByteLit(bl) => { let mut s: String = String::new(); std::num::push_u64(&mut s, *bl as u64); CVal::Imm(s) },
                ast::ExprKind::ByteStr(bs) => self.byte_const(bs.as_slice()),
                ast::ExprKind::StrLit(sl) => self.byte_const(sl.as_bytes()),
                ast::ExprKind::CharLit(ch) => { let mut s: String = String::new(); std::num::push_u64(&mut s, *ch as u64); CVal::Imm(s) },
                ast::ExprKind::Bool(on) => { if *on { CVal::Imm(String::from("true")) } else { CVal::Imm(String::from("false")) } },
                ast::ExprKind::Unit => CVal::Unit,
                ast::ExprKind::Var(id) => { if decls::is_unit(&self.ty(e, tb)) { return CVal::Unit; } if id.name == "None" && !self.slots.has("None") { let no_args: Vec<ast::Expr> = Vec::new(); let nt: ast::TypeKind = self.ty(e, tb); return self.variant(e, &nt, "None", no_args.as_slice(), ck, tb, f - 1); } match self.arr_slot(id.name.as_str()) { None => {}, Some(asl) => { return CVal::Arr(asl.ptr, asl.len); }, } match self.data_slot(id.name.as_str()) { None => {}, Some(dsl) => { return CVal::Ptr(dsl.ptr, dsl.ty); }, } match self.scalar_slot(id.name.as_str()) { None => self.todo_expr("a name that is not a scalar or array local", e), Some(slot) => { let r: String = self.t(); self.emit(types::cat5(r.as_str(), " = load ", slot.ty.as_str(), ", ptr ", slot.ptr.as_str()).as_str()); CVal::Imm(r) }, } },
                ast::ExprKind::Call(c) => self.call(e, c, ck, tb, f - 1),
                ast::ExprKind::Method(mc) => self.method(e, mc, ck, tb, f - 1),
                ast::ExprKind::Index(ib, ii) => self.index_expr(e, &**ib, &**ii, ck, tb, f - 1),
                ast::ExprKind::Unary(uop, ux) => self.unary(e, *uop, &**ux, ck, tb, f - 1),
                ast::ExprKind::Binary(bop, lhs, rhs) => self.binary(e, *bop, &**lhs, &**rhs, ck, tb, f - 1),
                ast::ExprKind::Ref(ref_m, ref_x) => self.ref_expr(&**ref_x, ck, tb, f - 1),
                ast::ExprKind::If(ifx) => self.if_expr(e, ifx, ck, tb, f - 1),
                ast::ExprKind::Block(b) => self.block_expr(b, ck, tb, f - 1),
                ast::ExprKind::Array(ex_items) => self.array_lit(e, ck, tb, f - 1),
                ast::ExprKind::Repeat(ex_rp) => self.array_lit(e, ck, tb, f - 1),
                ast::ExprKind::Old(ex_old0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Quant(ex_quant0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Trigger(ex_trigger0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Closure(ex_closure0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::StructLit(lit) => self.struct_lit(e, lit, ck, tb, f - 1),
                ast::ExprKind::Path(segs) => self.path_expr(e, segs.as_slice(), ck, tb, f - 1),
                ast::ExprKind::Deref(dx) => { if body::is_box(&self.ty(&**dx, tb)) { self.deref_box(e, &**dx, ck, tb, f - 1) } else { self.expr(&**dx, ck, tb, f - 1) } },
                ast::ExprKind::Field(fb, fname) => self.field_expr(e, &**fb, fname.name.as_str(), ck, tb, f - 1),
                ast::ExprKind::Match(mx) => self.match_expr(e, mx, ck, tb, f - 1),
                ast::ExprKind::Return(rx) => self.return_expr(e, rx, ck, tb, f - 1),
                ast::ExprKind::Try(tx) => self.try_expr(e, &**tx, ck, tb, f - 1),
                ast::ExprKind::Loop(lp) => self.loop_expr(e, lp, ck, tb, f - 1),
                ast::ExprKind::Break(bk) => self.jump(e, &bk.label, &bk.value, true, ck, tb, f - 1),
                ast::ExprKind::Continue(cl) => { let no_value: Option<Box<ast::Expr>> = None; self.jump(e, cl, &no_value, false, ck, tb, f - 1) },
                ast::ExprKind::Range(ex_range0) => self.todo_expr("an expression not lowered yet", e),
                ast::ExprKind::Error => self.todo_expr("an expression not lowered yet", e),
            }
        }

        #[summary("f64::from(x) (stage0 f64_from): 64비트 정수는 정확히 옮겨지는 범위(2^53까지)를 잰다")]
        #[effects(alloc)]
        fn f64_from(self: &mut Gen, x: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", x);
            }
            let st: ast::TypeKind = self.ty(x, tb);
            let v: String = imm(&self.expr(x, ck, tb, f - 1));
            match body::int_of(&st) {
                None => CVal::Imm(v),
                Some(i) => { if body::bits(i) == 64 { let c: String = self.t(); if body::signed(i) { let sh: String = self.t(); self.emit(types::cat4(sh.as_str(), " = add i64 ", v.as_str(), ", 9007199254740992").as_str()); self.emit(types::cat4(c.as_str(), " = icmp ule i64 ", sh.as_str(), ", 18014398509481984").as_str()); } else { self.emit(types::cat4(c.as_str(), " = icmp ule i64 ", v.as_str(), ", 9007199254740992").as_str()); } self.check(c.as_str(), "`f64::from` may not be exact"); } let r: String = self.t(); let inst: String = if body::signed(i) { String::from("sitofp") } else { String::from("uitofp") }; self.emit(types::cat7(r.as_str(), " = ", inst.as_str(), " i64 ", v.as_str(), " to double", "").as_str()); CVal::Imm(r) },
            }
        }

        #[summary("f64의 메서드 (stage0 f64_method): sqrt, abs, min, max, is_nan, is_finite")]
        #[effects(alloc)]
        fn f64_method(self: &mut Gen, m: &str, a: &str, b: &str, has_b: bool) -> CVal {
            let r: String = self.t();
            if (m == "sqrt" || m == "abs") && !has_b {
                let fname: String = if m == "sqrt" {
                    String::from("sqrt")
                } else {
                    String::from("fabs")
                };
                self.emit(types::cat7(r.as_str(), " = call double @llvm.", fname.as_str(), ".f64(double ", a, ")", "").as_str());
            } else if (m == "min" || m == "max") && has_b {
                let mm: String = if m == "min" {
                    String::from("minnum")
                } else {
                    String::from("maxnum")
                };
                self.emit(types::cat7(r.as_str(), " = call double @llvm.", mm.as_str(), ".f64(double ", a, ", double ", types::cat2(b, ")").as_str()).as_str());
            } else if m == "is_nan" && !has_b {
                self.emit(types::cat5(r.as_str(), " = fcmp uno double ", a, ", ", a).as_str());
            } else if m == "is_finite" && !has_b {
                let x: String = self.t();
                self.emit(types::cat4(x.as_str(), " = call double @llvm.fabs.f64(double ", a, ")").as_str());
                self.emit(types::cat4(r.as_str(), " = fcmp olt double ", x.as_str(), ", 0x7FF0000000000000").as_str());
            } else {
                self.todo.push(types::cat4("the `f64` method `", m, "` in ", self.path.as_str()));
                return CVal::Never;
            }
            CVal::Imm(r)
        }

        #[summary("필드 읽기 (stage0 expr의 Field): 구조체 값의 주소에서 (Box를 지나) 필드를 가리켜 읽는다. 임시값에서 읽은 배열은 그 임시값이 놓이기 전에 옮겨 둔다")]
        #[effects(alloc)]
        fn field_expr(self: &mut Gen, e: &ast::Expr, base: &ast::Expr, name: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let bv: CVal = self.expr(base, ck, tb, f - 1);
            if is_never(&bv) {
                return CVal::Never;
            }
            if !is_ptr(&bv) {
                return self.todo_expr("a field of a value that is not in memory", e);
            }
            let mut bt: ast::TypeKind = ptr_ty(&bv);
            let mut bp: String = ptr_of(&bv);
            let temp: bool = self.read_temp(base, &bv, &bt, tb);
            let mut n: usize = 64;
            while n > 0 && body::is_box(&bt)
                invariant n <= 64,
                decreases n,
            {
                n = n - 1;
                match body::box_inner(&bt) {
                    None => {},
                    Some(inner) => { bp = self.unbox(bp.as_str()); bt = inner; },
                }
            }
            match self.field_of(&bt, name, tb) {
                None => self.todo_expr("a field of a type that is not a struct", e),
                Some(fa) => { let p: String = self.field_ptr(bp.as_str(), &bt, fa.k); let v: CVal = self.read(p.as_str(), &fa.ty); if temp { self.keep(v, &fa.ty) } else { v } },
            }
        }

        #[summary("구조체 t의 필드 name의 차례와 타입 (stage0 field_of)")]
        #[effects(alloc)]
        fn field_of(self: &Gen, t: &ast::TypeKind, name: &str, tb: &lowered::Tables) -> Option<FieldAt> {
            match lowered::struct_fields(t, tb) {
                None => None,
                Some(fs) => { for k in 0..fs.len() invariant 0 <= k && k <= fs.len(), { if fs[k].name == name { return Some(FieldAt { k: k, ty: fs[k].ty.clone() }); } } None },
            }
        }

        #[summary("base에 있는 구조체 t의 k째 필드의 주소 (stage0 field_ptr)")]
        #[effects(alloc)]
        fn field_ptr(self: &mut Gen, base: &str, t: &ast::TypeKind, k: usize) -> String {
            let p: String = self.t();
            let mut kt: String = String::new();
            std::num::push_u64(&mut kt, k as u64);
            self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", data_ty(t).as_str(), ", ptr ", base, ", i32 0, i32 ", kt.as_str()).as_str());
            p
        }

        #[summary("값 v가 정수 타입 i의 범위 안인가 (stage0 fits): 그 판정의 레지스터")]
        #[effects(alloc)]
        fn fits(self: &mut Gen, v: &str, i: ast::IntTy) -> String {
            self.in_range_of(v, body::signed(i), i)
        }

        #[summary("for 문장 (stage0 stmt의 For): 끝 값을 한 번 재고, i를 lo부터 i < hi(<=)인 동안. continue는 걸음으로 간다. lo..=hi는 i == hi에서 떠나 i + 1이 타입의 끝을 넘지 않는다")]
        #[effects(alloc)]
        fn for_stmt(self: &mut Gen, x: &ast::For, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", x.span);
                return;
            }
            match self.local_ty(x.var.name.as_str(), tb) {
                None => self.todo_at("a `for` variable without a type", x.span),
                Some(t) => { let lt: String = llty(&t); let signed: bool = is_signed(&t); let ptr: String = self.alloca(lt.as_str()); let a: String = imm(&self.region_expr(&x.lo, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", a.as_str(), ", ptr ", ptr.as_str(), "").as_str()); let b: String = imm(&self.region_expr(&x.hi, ck, tb, f - 1)); self.slots.insert(x.var.name.as_str(), Slot::Scalar(ptr.clone(), lt.clone())); let head: String = self.l("for"); let lb: String = self.l("body"); let next: String = self.l("next"); let end: String = self.l("endfor"); self.emit(types::cat2("br label %", head.as_str()).as_str()); self.block(head.as_str()); let i1: String = self.t(); self.emit(types::cat5(i1.as_str(), " = load ", lt.as_str(), ", ptr ", ptr.as_str()).as_str()); let c: String = self.t(); let op: String = if x.inclusive { if signed { String::from("sle") } else { String::from("ule") } } else if signed { String::from("slt") } else { String::from("ult") }; let mut cmp: String = types::cat5(c.as_str(), " = icmp ", op.as_str(), " ", lt.as_str()); cmp.push_str(" "); cmp.push_str(i1.as_str()); cmp.push_str(", "); cmp.push_str(b.as_str()); self.emit(cmp.as_str()); self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str()); self.block(lb.as_str()); let depth: usize = self.loops.len(); self.loops.push(GLoop { label: label_name(&x.label), head: next.clone(), end: end.clone(), slot: None, ty: ast::TypeKind::Unit, mark: self.pending.len() }); let body_v: CVal = self.block_expr(&x.body, ck, tb, f - 1); self.loops.truncate(depth); self.emit(types::cat2("br label %", next.as_str()).as_str()); self.block(next.as_str()); let i2: String = self.t(); self.emit(types::cat5(i2.as_str(), " = load ", lt.as_str(), ", ptr ", ptr.as_str()).as_str()); if x.inclusive { let at_end: String = self.t(); let step: String = self.l("step"); let mut eq: String = types::cat5(at_end.as_str(), " = icmp eq ", lt.as_str(), " ", i2.as_str()); eq.push_str(", "); eq.push_str(b.as_str()); self.emit(eq.as_str()); self.emit(types::cat7("br i1 ", at_end.as_str(), ", label %", end.as_str(), ", label %", step.as_str(), "").as_str()); self.block(step.as_str()); } let n: String = self.t(); self.emit(types::cat7(n.as_str(), " = add ", lt.as_str(), " ", i2.as_str(), ", 1", "").as_str()); self.emit(types::cat7("store ", lt.as_str(), " ", n.as_str(), ", ptr ", ptr.as_str(), "").as_str()); self.emit(types::cat2("br label %", head.as_str()).as_str()); self.block(end.as_str()); },
            }
        }

        #[summary("바이트들에서 정수 (stage0 expr의 from_bytes_call, 백로그 2N-09c): 바이트마다 읽어 제자리로 밀고 합친다. 좁은 부호 있는 타입은 제 폭의 부호를 넓힌다")]
        #[effects(alloc)]
        fn from_bytes(self: &mut Gen, e: &ast::Expr, c: &ast::Call, i: ast::IntTy, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 || c.args.len() != 1 || c.path.len() != 2 {
                return self.todo_expr("a byte conversion without one argument", e);
            }
            let le: bool = c.path[1].name == "from_le_bytes";
            let av: CVal = self.expr(&c.args[0], ck, tb, f - 1);
            if !is_arr(&av) {
                if !is_never(&av) {
                    self.todo_at("bytes that are not an array", e.span);
                }
                return CVal::Never;
            }
            let ptr: String = arr_ptr(&av);
            let w: u32 = body::bits(i);
            let n: u32 = w / 8;
            let mut nt: String = String::new();
            std::num::push_u64(&mut nt, n as u64);
            let mut acc: String = String::from("0");
            for k in 0..n
                invariant 0 <= k && k <= n,
            {
                let sh: u32 = if le {
                    k.wrapping_mul(8)
                } else {
                    n.wrapping_sub(1).wrapping_sub(k).wrapping_mul(8)
                };
                let p: String = self.t();
                let mut kt: String = String::new();
                std::num::push_u64(&mut kt, k as u64);
                self.emit(types::cat7(p.as_str(), " = getelementptr inbounds [", nt.as_str(), " x i8], ptr ", ptr.as_str(), ", i64 0, i64 ", kt.as_str()).as_str());
                let b0: String = self.load_elem("u8", p.as_str());
                let b1: String = if sh == 0 {
                    b0
                } else {
                    let sb: String = self.t();
                    let mut st: String = String::new();
                    std::num::push_u64(&mut st, sh as u64);
                    self.emit(types::cat5(sb.as_str(), " = shl i64 ", b0.as_str(), ", ", st.as_str()).as_str());
                    sb
                };
                let r: String = self.t();
                self.emit(types::cat5(r.as_str(), " = or i64 ", acc.as_str(), ", ", b1.as_str()).as_str());
                acc = r;
            }
            if body::signed(i) && w < 64 {
                let tr: String = self.t();
                let sx: String = self.t();
                let mut wt: String = String::new();
                std::num::push_u64(&mut wt, w as u64);
                self.emit(types::cat5(tr.as_str(), " = trunc i64 ", acc.as_str(), " to i", wt.as_str()).as_str());
                self.emit(types::cat5(sx.as_str(), " = sext i", wt.as_str(), " ", types::cat2(tr.as_str(), " to i64").as_str()).as_str());
                acc = sx;
            }
            CVal::Imm(acc)
        }

        #[summary("배열 값의 if (stage0 expr의 If, 백로그 1B-25): 두 갈래가 제 배열을 한 자리에 옮긴다")]
        #[effects(alloc)]
        fn if_array(self: &mut Gen, e: &ast::Expr, x: &ast::If, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            match body::array_elem(&ty) {
                None => self.todo_expr("an `if` whose value is not an array", e),
                Some(el) => { if !is_scalar_ty(&el) { return self.todo_expr("an `if` whose value is an array of values that are not scalars", e); } let elem: String = elem_kind(&el); let n: String = array_len_text(&ty); let buf: String = self.alloca(types::cat5("[", n.as_str(), " x ", mem(elem.as_str()).as_str(), "]").as_str()); let bytes: u64 = dec(n.as_str()).wrapping_mul(align(elem.as_str()) as u64); let c: String = imm(&self.region_expr(&*x.cond, ck, tb, f - 1)); let lthen: String = self.l("then"); let lelse: String = self.l("else"); let end: String = self.l("endif"); self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lthen.as_str(), ", label %", lelse.as_str(), "").as_str()); self.block(lthen.as_str()); let tv: CVal = self.block_expr(&x.then, ck, tb, f - 1); if is_arr(&tv) { self.memcpy(buf.as_str(), arr_ptr(&tv).as_str(), bytes); } self.drop_moves(1, x.then.span, ck, tb); self.emit(types::cat2("br label %", end.as_str()).as_str()); self.block(lelse.as_str()); match &x.els { None => self.todo_at("an array `if` without an else", e.span), Some(other) => { let ev: CVal = self.expr(&**other, ck, tb, f - 1); if is_arr(&ev) { self.memcpy(buf.as_str(), arr_ptr(&ev).as_str(), bytes); } self.drop_moves(1, other.span, ck, tb); }, } self.emit(types::cat2("br label %", end.as_str()).as_str()); self.block(end.as_str()); CVal::Arr(buf, n) },
            }
        }

        #[summary("if (stage0 expr의 If): 결과의 자리에 두 갈래가 쓰고 끝에서 읽는다. 배열 값은 if_array")]
        #[effects(alloc)]
        fn if_expr(self: &mut Gen, e: &ast::Expr, x: &ast::If, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            if body::is_array(&ty) {
                return self.if_array(e, x, ck, tb, f - 1);
            }
            if body::is_ref(&ty) {
                return self.todo_expr("an `if` whose value is a reference", e);
            }
            let slot: Option<String> = self.result_slot(&ty);
            let c: String = imm(&self.region_expr(&*x.cond, ck, tb, f - 1));
            let lthen: String = self.l("then");
            let lelse: String = self.l("else");
            let end: String = self.l("endif");
            self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lthen.as_str(), ", label %", lelse.as_str(), "").as_str());
            self.block(lthen.as_str());
            let tv: CVal = self.block_expr(&x.then, ck, tb, f - 1);
            self.store_result(&slot, &tv, &ty);
            self.drop_moves(1, x.then.span, ck, tb);
            self.emit(types::cat2("br label %", end.as_str()).as_str());
            self.block(lelse.as_str());
            match &x.els {
                None => {},
                Some(other) => { let ev: CVal = self.expr(&**other, ck, tb, f - 1); self.store_result(&slot, &ev, &ty); self.drop_moves(1, other.span, ck, tb); },
            }
            self.emit(types::cat2("br label %", end.as_str()).as_str());
            self.block(end.as_str());
            self.load_result(&slot, &ty)
        }

        #[summary("값 v가 정수 타입 i의 범위 안인가 (stage0 in_range_of). from_signed는 v가 부호 있는 값인가")]
        #[effects(alloc)]
        fn in_range_of(self: &mut Gen, v: &str, from_signed: bool, i: ast::IntTy) -> String {
            let c: String = self.t();
            let to_signed: bool = body::signed(i);
            let wide: bool = body::bits(i) == 64;
            if !from_signed || !to_signed {
                if from_signed && !to_signed && wide || !from_signed && to_signed && wide {
                    self.emit(types::cat4(c.as_str(), " = icmp sge i64 ", v, ", 0").as_str());
                } else {
                    self.emit(types::cat5(c.as_str(), " = icmp ule i64 ", v, ", ", int_max(i).as_str()).as_str());
                }
            } else {
                let d: String = self.t();
                self.emit(types::cat5(d.as_str(), " = sub i64 ", v, ", ", int_min(i).as_str()).as_str());
                self.emit(types::cat5(c.as_str(), " = icmp ule i64 ", d.as_str(), ", ", all_ones(body::bits(i)).as_str()).as_str());
            }
            c
        }

        #[summary("색인 식 (stage0 expr의 Index 갈래들): 범위면 조각, 아니면 스칼라 원소를 읽는다")]
        #[effects(alloc)]
        fn index_expr(self: &mut Gen, e: &ast::Expr, base: &ast::Expr, index: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            match range_of(index) {
                None => {},
                Some(r) => { if self.is_text_expr(base, tb) { return self.todo_expr("a range of text", e); } return self.elem_slice(e, base, &*r.lo, &*r.hi, ck, tb, f - 1); },
            }
            let ety: ast::TypeKind = self.ty(e, tb);
            if is_mem_elem(&ety) {
                let av: CVal = self.array_of(base, ck, tb, f - 1);
                let bt: ast::TypeKind = self.ty(base, tb);
                if is_arr(&av) && body::is_array(&bt) && fresh(base) && self.owns(&bt, tb) {
                    self.pending.push(Pend { ptr: arr_ptr(&av), ty: bt.clone() });
                }
                let di: String = imm(&self.expr(index, ck, tb, f - 1));
                if !is_arr(&av) {
                    if !is_never(&av) {
                        self.todo_at("an index into a value that is not an array or a slice", e.span);
                    }
                    return CVal::Never;
                }
                let dp: String = self.data_elem(arr_ptr(&av).as_str(), arr_len(&av).as_str(), di.as_str(), &ety);
                return self.read(dp.as_str(), &ety);
            }
            if !is_scalar_ty(&ety) {
                return self.todo_expr("an element that is not a scalar", e);
            }
            let ep: ElemPtr = self.elem_ptr(e, base, index, ck, tb, f - 1);
            if ep.ptr == "undef" {
                return CVal::Never;
            }
            CVal::Imm(self.load_elem(ep.elem.as_str(), ep.ptr.as_str()))
        }

        #[summary("스칼라 원소의 배열을 ptr에 채운다 (stage0 init_array): 리터럴, 반복, 다른 배열 값의 복사")]
        #[effects(alloc)]
        fn init_array(self: &mut Gen, e: &ast::Expr, ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return;
            }
            match &e.kind {
                ast::ExprKind::Int(ia_int0, ia_int1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Float(ia_float0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::ByteLit(ia_bytelit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::ByteStr(ia_bytestr0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::StrLit(ia_strlit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::CharLit(ia_charlit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Bool(ia_bool0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Unit => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Var(ia_var0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Call(ia_call0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Method(ia_method0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Index(ia_index0, ia_index1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Unary(ia_unary0, ia_unary1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Binary(ia_binary0, ia_binary1, ia_binary2) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Ref(ia_ref0, ia_ref1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::If(ia_if0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Block(ia_block0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Array(items) => self.init_items(items.as_slice(), ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Repeat(rp) => self.init_repeat(rp, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Old(ia_old0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Quant(ia_quant0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Trigger(ia_trigger0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Closure(ia_closure0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::StructLit(ia_structlit0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Path(ia_path0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Deref(ia_deref0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Field(ia_field0, ia_field1) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Match(ia_match0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Return(ia_return0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Try(ia_try0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Loop(ia_loop0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Break(ia_break0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Continue(ia_continue0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Range(ia_range0) => self.init_copy(e, ptr, elem, ck, tb, f - 1),
                ast::ExprKind::Error => self.init_copy(e, ptr, elem, ck, tb, f - 1),
            }
        }

        #[summary("다른 배열 값에서 옮겨 채운다 (stage0 init_array의 마지막 갈래)")]
        #[effects(alloc)]
        fn init_copy(self: &mut Gen, e: &ast::Expr, ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return;
            }
            let v: CVal = self.expr(e, ck, tb, f - 1);
            if is_arr(&v) {
                let bytes: u64 = dec(arr_len(&v).as_str()).wrapping_mul(align(elem) as u64);
                self.memcpy(ptr, arr_ptr(&v).as_str(), bytes);
            } else if !is_never(&v) {
                self.todo_at("an array filled from a value that is not an array", e.span);
            }
        }

        #[summary("메모리 값의 배열을 ptr에 채운다 (stage0 init_data_array): 리터럴은 원소를 모두 셈해 제 메모리로 옮긴 뒤에 쓰고, 반복은 값을 한 번 셈하고, 다른 배열 값은 통째로 옮긴다")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn init_data_array(self: &mut Gen, e: &ast::Expr, ptr: &str, t: &ast::TypeKind, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return;
            }
            let et: ast::TypeKind = elem_of(t);
            let mt: String = mem_ty(&et);
            match &e.kind {
                ast::ExprKind::Int(id_int0, id_int1) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Float(id_float0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::ByteLit(id_bytelit0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::ByteStr(id_bytestr0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::StrLit(id_strlit0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::CharLit(id_charlit0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Bool(id_bool0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Unit => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Var(id_var0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Call(id_call0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Method(id_method0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Index(id_index0, id_index1) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Unary(id_unary0, id_unary1) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Binary(id_binary0, id_binary1, id_binary2) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Ref(id_ref0, id_ref1) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::If(id_if0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Block(id_block0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Array(items) => { let mut vals: Vec<CVal> = Vec::new(); for j in 0..items.len() invariant 0 <= j && j <= items.len(), { let iv: CVal = self.expr(&items[j], ck, tb, f - 1); vals.push(self.detach(iv)); } for j2 in 0..vals.len() invariant 0 <= j2 && j2 <= vals.len(), { let p: String = self.t(); let mut jt: String = String::new(); std::num::push_u64(&mut jt, j2 as u64); self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", mt.as_str(), ", ptr ", ptr, ", i64 ", jt.as_str()).as_str()); let pv: CVal = vals[j2].clone(); self.put(&pv, p.as_str(), &et); } },
                ast::ExprKind::Repeat(rp) => { let rv0: CVal = self.expr(&*rp.value, ck, tb, f - 1); let rv: CVal = self.detach(rv0); let mut count: String = String::new(); wide::push_radix(&mut count, rp.count, 10); let i: String = self.alloca("i64"); self.emit(types::cat2("store i64 0, ptr ", i.as_str()).as_str()); let head: String = self.l("fill"); let lb: String = self.l("fillb"); let end: String = self.l("filled"); self.emit(types::cat2("br label %", head.as_str()).as_str()); self.block(head.as_str()); let k: String = self.t(); let c: String = self.t(); self.emit(types::cat3(k.as_str(), " = load i64, ptr ", i.as_str()).as_str()); self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", k.as_str(), ", ", count.as_str()).as_str()); self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str()); self.block(lb.as_str()); let rp_p: String = self.t(); self.emit(types::cat7(rp_p.as_str(), " = getelementptr inbounds ", mt.as_str(), ", ptr ", ptr, ", i64 ", k.as_str()).as_str()); self.put(&rv, rp_p.as_str(), &et); let k2: String = self.t(); self.emit(types::cat4(k2.as_str(), " = add nuw i64 ", k.as_str(), ", 1").as_str()); self.emit(types::cat4("store i64 ", k2.as_str(), ", ptr ", i.as_str()).as_str()); self.emit(types::cat2("br label %", head.as_str()).as_str()); self.block(end.as_str()); },
                ast::ExprKind::Old(id_old0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Quant(id_quant0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Trigger(id_trigger0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Closure(id_closure0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::StructLit(id_structlit0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Path(id_path0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Deref(id_deref0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Field(id_field0, id_field1) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Match(id_match0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Return(id_return0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Try(id_try0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Loop(id_loop0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Break(id_break0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Continue(id_continue0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Range(id_range0) => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
                ast::ExprKind::Error => { let whole: CVal = self.expr(e, ck, tb, f - 1); self.put(&whole, ptr, t); },
            }
        }

        #[summary("배열 리터럴로 채운다 (stage0 init_array의 Array 갈래들). 원소가 모두 리터럴이고 둘 이상이면 비공개 상수 하나와 그 복사다. 아니면 원소를 모두 셈한 뒤에 쓴다 (a = [a[1], a[0]]의 오른쪽은 옛 a를 읽는다)")]
        #[effects(alloc)]
        fn init_items(self: &mut Gen, items: &[ast::Expr], ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo.push(types::cat2("nesting too deep in ", self.path.as_str()));
                return;
            }
            let m: String = mem(elem);
            if items.len() > 1 {
                match const_elems(items) {
                    None => {},
                    Some(vals) => { let bits: u32 = if elem == "i1" { 8 } else if narrow_bits(elem) > 0 { narrow_bits(elem) } else { 64 }; let mut body_t: Vec<String> = Vec::new(); for k in 0..vals.len() invariant 0 <= k && k <= vals.len(), { body_t.push(types::cat3(m.as_str(), " ", const_text(&vals[k], bits).as_str())); } let mut name: String = types::cat3("@\"", self.path.as_str(), ".const."); std::num::push_u64(&mut name, self.consts as u64); name.push_str("\""); let mut nt: String = String::new(); std::num::push_u64(&mut nt, vals.len() as u64); let mut al: String = String::new(); std::num::push_u64(&mut al, align(elem) as u64); self.globals.push_str(types::cat7(name.as_str(), " = private unnamed_addr constant [", nt.as_str(), " x ", m.as_str(), "] [", types::join(body_t.as_slice(), ", ").as_str()).as_str()); self.globals.push_str(types::cat3("], align ", al.as_str(), "\n").as_str()); self.consts = self.consts.wrapping_add(1); self.memcpy(ptr, name.as_str(), (vals.len() as u64).wrapping_mul(align(elem) as u64)); return; },
                }
            }
            let mut regs: Vec<String> = Vec::new();
            for j in 0..items.len()
                invariant 0 <= j && j <= items.len(),
            {
                regs.push(imm(&self.expr(&items[j], ck, tb, f - 1)));
            }
            for j2 in 0..regs.len()
                invariant 0 <= j2 && j2 <= regs.len(),
            {
                let p: String = self.t();
                let mut jt: String = String::new();
                std::num::push_u64(&mut jt, j2 as u64);
                self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", m.as_str(), ", ptr ", ptr, ", i64 ", jt.as_str()).as_str());
                self.store_elem(elem, regs[j2].as_str(), p.as_str());
            }
        }

        #[summary("반복으로 채운다 (stage0 init_array의 Repeat 갈래): 값을 한 번 셈하고 루프로 쓴다")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn init_repeat(self: &mut Gen, rp: &ast::Repeat, ptr: &str, elem: &str, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo.push(types::cat2("nesting too deep in ", self.path.as_str()));
                return;
            }
            let v: String = imm(&self.expr(&*rp.value, ck, tb, f - 1));
            let mut count: String = String::new();
            wide::push_radix(&mut count, rp.count, 10);
            let i: String = self.alloca("i64");
            self.emit(types::cat2("store i64 0, ptr ", i.as_str()).as_str());
            let head: String = self.l("fill");
            let lb: String = self.l("fillb");
            let end: String = self.l("filled");
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(head.as_str());
            let k: String = self.t();
            let c: String = self.t();
            self.emit(types::cat3(k.as_str(), " = load i64, ptr ", i.as_str()).as_str());
            self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", k.as_str(), ", ", count.as_str()).as_str());
            self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str());
            self.block(lb.as_str());
            let p: String = self.t();
            let k2: String = self.t();
            self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", mem(elem).as_str(), ", ptr ", ptr, ", i64 ", k.as_str()).as_str());
            self.store_elem(elem, v.as_str(), p.as_str());
            self.emit(types::cat4(k2.as_str(), " = add nuw i64 ", k.as_str(), ", 1").as_str());
            self.emit(types::cat4("store i64 ", k2.as_str(), ", ptr ", i.as_str()).as_str());
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(end.as_str());
        }

        #[summary("정수 메서드 (stage0 int_method, narrow_method): wrapping_*은 64비트에서 셈하고 제 폭으로 자르고, saturating_*은 내장 함수나 넘침 깃발로 끝 값에 붙인다. checked_*은 checked_method")]
        #[effects(alloc)]
        fn int_method(self: &mut Gen, e: &ast::Expr, op: &str, a: &str, b: &str, i: ast::IntTy, tb: &lowered::Tables) -> CVal {
            let signed: bool = body::signed(i);
            let sg: String = if signed {
                String::from("s")
            } else {
                String::from("u")
            };
            let wrapping: bool = op == "wrapping_add" || op == "wrapping_sub" || op == "wrapping_mul";
            let saturating: bool = op == "saturating_add" || op == "saturating_sub" || op == "saturating_mul";
            let checked: bool = op == "checked_add" || op == "checked_sub" || op == "checked_mul" || op == "checked_div" || op == "checked_rem";
            if checked {
                return self.checked_method(e, op, a, b, i, tb);
            }
            if !wrapping && !saturating {
                return self.todo_expr("an integer method that is not wrapping, saturating or checked", e);
            }
            let base: String = if op == "wrapping_add" || op == "saturating_add" {
                String::from("add")
            } else if op == "wrapping_sub" || op == "saturating_sub" {
                String::from("sub")
            } else {
                String::from("mul")
            };
            let r: String = self.t();
            if wrapping {
                self.emit(types::cat7(r.as_str(), " = ", base.as_str(), " i64 ", a, ", ", b).as_str());
            } else if base != "mul" {
                let mut line: String = types::cat5(r.as_str(), " = call i64 @llvm.", sg.as_str(), base.as_str(), ".sat.i64(i64 ");
                line.push_str(a);
                line.push_str(", i64 ");
                line.push_str(b);
                line.push_str(")");
                self.emit(line.as_str());
            } else {
                let pair: String = self.t();
                let v: String = self.t();
                let ovf: String = self.t();
                let mut pl: String = types::cat5(pair.as_str(), " = call {i64, i1} @llvm.", sg.as_str(), "mul", ".with.overflow.i64(i64 ");
                pl.push_str(a);
                pl.push_str(", i64 ");
                pl.push_str(b);
                pl.push_str(")");
                self.emit(pl.as_str());
                self.emit(types::cat4(v.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 0").as_str());
                self.emit(types::cat4(ovf.as_str(), " = extractvalue {i64, i1} ", pair.as_str(), ", 1").as_str());
                let bound: String = if signed {
                    let x: String = self.t();
                    let neg: String = self.t();
                    let lim: String = self.t();
                    self.emit(types::cat5(x.as_str(), " = xor i64 ", a, ", ", b).as_str());
                    self.emit(types::cat4(neg.as_str(), " = icmp slt i64 ", x.as_str(), ", 0").as_str());
                    self.emit(types::cat4(lim.as_str(), " = select i1 ", neg.as_str(), ", i64 -9223372036854775808, i64 9223372036854775807").as_str());
                    lim
                } else {
                    String::from("-1")
                };
                self.emit(types::cat7(r.as_str(), " = select i1 ", ovf.as_str(), ", i64 ", bound.as_str(), ", i64 ", v.as_str()).as_str());
            }
            if body::bits(i) == 64 {
                return CVal::Imm(r);
            }
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, body::bits(i) as u64);
            if wrapping {
                let t1: String = self.t();
                let w1: String = self.t();
                let ext: String = if signed {
                    String::from("sext")
                } else {
                    String::from("zext")
                };
                self.emit(types::cat5(t1.as_str(), " = trunc i64 ", r.as_str(), " to i", wt.as_str()).as_str());
                self.emit(types::cat7(w1.as_str(), " = ", ext.as_str(), " i", wt.as_str(), " ", types::cat2(t1.as_str(), " to i64").as_str()).as_str());
                return CVal::Imm(w1);
            }
            let w2: String = self.t();
            if signed {
                let lo: String = self.t();
                self.emit(types::cat7(lo.as_str(), " = call i64 @llvm.smax.i64(i64 ", r.as_str(), ", i64 ", int_min(i).as_str(), ")", "").as_str());
                self.emit(types::cat7(w2.as_str(), " = call i64 @llvm.smin.i64(i64 ", lo.as_str(), ", i64 ", int_max(i).as_str(), ")", "").as_str());
            } else {
                self.emit(types::cat7(w2.as_str(), " = call i64 @llvm.umin.i64(i64 ", r.as_str(), ", i64 ", int_max(i).as_str(), ")", "").as_str());
            }
            CVal::Imm(w2)
        }

        #[summary("식 e의 값이 글인가 (stage0 is_text_expr): 낮추기 전의 타입으로")]
        #[effects(alloc)]
        fn is_text_expr(self: &Gen, e: &ast::Expr, tb: &lowered::Tables) -> bool {
            types::has(tb.text.as_slice(), body::span_key(e.span).as_str())
        }

        #[summary("break와 continue (stage0 jump): 레이블의 루프(없으면 가장 안쪽)로. break e는 값을 루프의 자리에 둔다")]
        #[effects(alloc)]
        fn jump(self: &mut Gen, e: &ast::Expr, label: &Option<ast::Ident>, value: &Option<Box<ast::Expr>>, brk: bool, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let want: String = label_name(label);
            let mut k: usize = self.loops.len();
            let mut found: bool = false;
            while k > 0 && !found
                invariant k <= self.loops.len(),
                decreases k,
            {
                k = k - 1;
                if want.len() == 0 || self.loops[k].label == want {
                    found = true;
                }
            }
            if !found || k >= self.loops.len() {
                return self.todo_expr("a `break` or `continue` outside a loop", e);
            }
            let v0: CVal = match value {
                None => CVal::Unit,
                Some(x) => self.expr(&**x, ck, tb, f - 1),
            };
            let v: CVal = self.detach(v0);
            if k >= self.loops.len() {
                return CVal::Never;
            }
            let slot: Option<String> = self.loops[k].slot.clone();
            let lt: ast::TypeKind = self.loops[k].ty.clone();
            let jm: usize = self.loops[k].mark;
            let target: String = if brk {
                self.loops[k].end.clone()
            } else {
                self.loops[k].head.clone()
            };
            if brk {
                self.store_result(&slot, &v, &lt);
            }
            self.drop_pending_from(jm, tb);
            self.drop_moves(2, e.span, ck, tb);
            self.emit(types::cat2("br label %", target.as_str()).as_str());
            let after: String = self.l("after_jump");
            self.block(after.as_str());
            CVal::Never
        }

        #[summary("놓일지도 모르는 메모리에서 읽은 값 v를 간직한다 (stage0 keep): 배열은 지금 옮겨 둔다 (메모리 값은 detach가 옮긴다)")]
        #[effects(alloc)]
        fn keep(self: &mut Gen, v: CVal, t: &ast::TypeKind) -> CVal {
            if is_arr(&v) {
                let tmp: String = self.temp(t);
                self.copy(tmp.as_str(), arr_ptr(&v).as_str(), t);
                return CVal::Arr(tmp, arr_len(&v));
            }
            v
        }

        #[summary("다음 레이블: base와 번호")]
        #[effects(alloc)]
        fn l(self: &mut Gen, base: &str) -> String {
            self.label = self.label.wrapping_add(1);
            let mut s: String = String::from(base);
            std::num::push_u64(&mut s, self.label as u64);
            s
        }

        #[summary("let 문장 (stage0 stmt의 Let): 스칼라, 단위 값, 스칼라 원소의 배열인 지역 변수")]
        #[effects(alloc)]
        fn let_stmt(self: &mut Gen, x: &ast::Let, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", x.span);
                return;
            }
            let t: ast::TypeKind = match self.local_ty(x.name.name.as_str(), tb) {
                None => lowered::lower(&x.ty.kind),
                Some(known) => known,
            };
            if body::is_array(&t) {
                if is_mem_elem(&elem_of(&t)) {
                    let dptr: String = self.temp(&t);
                    self.init_data_array(&x.init, dptr.as_str(), &t, ck, tb, f - 1);
                    self.slots.insert(x.name.name.as_str(), Slot::Arr(ArrSlot { ptr: dptr, len: array_len_text(&t), elem: elem_kind(&elem_of(&t)), ety: elem_of(&t) }));
                    return;
                }
                if !scalar_array(&t) {
                    self.todo_at("a local array of values that are not scalars", x.span);
                    return;
                }
                let elem: String = elem_kind(&elem_of(&t));
                let n: String = array_len_text(&t);
                let aptr: String = self.alloca(types::cat5("[", n.as_str(), " x ", mem(elem.as_str()).as_str(), "]").as_str());
                self.init_array(&x.init, aptr.as_str(), elem.as_str(), ck, tb, f - 1);
                self.slots.insert(x.name.name.as_str(), Slot::Arr(ArrSlot { ptr: aptr, len: n, elem: elem, ety: elem_of(&t) }));
                return;
            }
            if body::is_ref(&t) {
                self.todo_at("a local that is a reference", x.span);
                return;
            }
            if is_mem(&t) {
                let mptr: String = self.temp(&t);
                let mv: CVal = self.expr(&x.init, ck, tb, f - 1);
                self.put(&mv, mptr.as_str(), &t);
                self.slots.insert(x.name.name.as_str(), Slot::Data(DataSlot { ptr: mptr, ty: t }));
                return;
            }
            if decls::is_unit(&t) {
                let unit_v: CVal = self.expr(&x.init, ck, tb, f - 1);
                return;
            }
            let lt: String = llty(&t);
            let ptr: String = self.alloca(lt.as_str());
            let v: String = imm(&self.expr(&x.init, ck, tb, f - 1));
            self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", ptr.as_str(), "").as_str());
            self.slots.insert(x.name.name.as_str(), Slot::Scalar(ptr, lt));
        }

        #[summary("원소를 읽는다 (stage0 load_elem): bool과 좁은 정수는 메모리에서 제 폭이고 레지스터로 넓힌다. 넓히지 않아도 번호 하나를 쓴다 (stage0과 같은 번호)")]
        #[effects(alloc)]
        fn load_elem(self: &mut Gen, elem: &str, ptr: &str) -> String {
            let r: String = self.t();
            let mut al: String = String::new();
            std::num::push_u64(&mut al, align(elem) as u64);
            self.emit(types::cat7(r.as_str(), " = load ", mem(elem).as_str(), ", ptr ", ptr, ", align ", al.as_str()).as_str());
            let b: String = self.t();
            if elem == "i1" {
                self.emit(types::cat4(b.as_str(), " = trunc i8 ", r.as_str(), " to i1").as_str());
                return b;
            }
            let bits: u32 = narrow_bits(elem);
            if bits == 0 {
                return r;
            }
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, bits as u64);
            let ext: String = if narrow_signed(elem) {
                String::from("sext")
            } else {
                String::from("zext")
            };
            self.emit(types::cat7(b.as_str(), " = ", ext.as_str(), " i", wt.as_str(), " ", types::cat2(r.as_str(), " to i64").as_str()).as_str());
            b
        }

        #[summary("메모리의 스칼라를 읽는다 (stage0 load_mem): bool은 한 바이트, 좁은 정수는 제 폭이고 레지스터로 넓힌다")]
        #[effects(alloc)]
        fn load_mem(self: &mut Gen, ptr: &str, t: &ast::TypeKind) -> String {
            let r: String = self.t();
            if body::is_bool(t) {
                self.emit(types::cat3(r.as_str(), " = load i8, ptr ", ptr).as_str());
                let b: String = self.t();
                self.emit(types::cat4(b.as_str(), " = trunc i8 ", r.as_str(), " to i1").as_str());
                return b;
            }
            if body::is_f64(t) {
                self.emit(types::cat3(r.as_str(), " = load double, ptr ", ptr).as_str());
                return r;
            }
            match body::int_of(t) {
                None => {},
                Some(i) => { if body::bits(i) < 64 { let mut wt: String = String::new(); std::num::push_u64(&mut wt, body::bits(i) as u64); self.emit(types::cat5(r.as_str(), " = load i", wt.as_str(), ", ptr ", ptr).as_str()); let x: String = self.t(); let ext: String = if body::signed(i) { String::from("sext") } else { String::from("zext") }; self.emit(types::cat7(x.as_str(), " = ", ext.as_str(), " i", wt.as_str(), " ", types::cat2(r.as_str(), " to i64").as_str()).as_str()); return x; } },
            }
            self.emit(types::cat3(r.as_str(), " = load i64, ptr ", ptr).as_str());
            r
        }

        #[summary("if나 loop의 결과를 자리에서 읽는다 (stage0 load_result): 메모리 값은 그 자리가 값이다")]
        #[effects(alloc)]
        fn load_result(self: &mut Gen, slot: &Option<String>, t: &ast::TypeKind) -> CVal {
            match slot {
                None => CVal::Unit,
                Some(sl) => { if is_mem(t) { return CVal::Ptr(sl.clone(), lowered::value_ty(t)); } let r: String = self.t(); self.emit(types::cat5(r.as_str(), " = load ", llty(t).as_str(), ", ptr ", sl.as_str()).as_str()); CVal::Imm(r) },
            }
        }

        #[summary("지역 변수 name의 타입 (낮춘 표에서)")]
        #[effects(alloc)]
        fn local_ty(self: &Gen, name: &str, tb: &lowered::Tables) -> Option<ast::TypeKind> {
            match tb.locals.find(self.base.as_str()) {
                None => None,
                Some(at) => { match tb.locals.items[at].find(name) { None => None, Some(i) => Some(tb.locals.items[at].items[i].clone()), } },
            }
        }

        #[summary("loop 식 (stage0 loop_expr): break e의 값은 결과의 자리로. 끝나지 않는 loop의 값은 없다")]
        #[effects(alloc)]
        fn loop_expr(self: &mut Gen, e: &ast::Expr, x: &ast::Loop, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let ty: ast::TypeKind = self.ty(e, tb);
            let never: bool = body::is_never(&ty);
            if !never && (body::is_array(&ty) || body::is_ref(&ty)) {
                return self.todo_expr("a `loop` whose value is an array or a reference", e);
            }
            let slot: Option<String> = if never {
                None
            } else {
                self.result_slot(&ty)
            };
            let head: String = self.l("loop");
            let end: String = self.l("endloop");
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(head.as_str());
            let depth: usize = self.loops.len();
            self.loops.push(GLoop { label: label_name(&x.label), head: head.clone(), end: end.clone(), slot: slot.clone(), ty: ty.clone(), mark: self.pending.len() });
            let body_v: CVal = self.block_expr(&x.body, ck, tb, f - 1);
            self.loops.truncate(depth);
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(end.as_str());
            if never {
                return CVal::Never;
            }
            self.load_result(&slot, &ty)
        }

        #[summary("match (stage0 match_expr): 꼬리표가 갈래를 고르고, 묶는 이름은 페이로드 자리의 사본이고 (&mut의 match에서는 그 자리 자체: 스칼라는 레지스터 자리로 읽고 갈래 끝에 되돌려 쓴다), 갈래들의 값은 한 자리에서 만난다")]
        #[effects(alloc)]
        fn match_expr(self: &mut Gen, e: &ast::Expr, mx: &ast::Match, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let rt: ast::TypeKind = self.ty(e, tb);
            if body::is_array(&rt) || body::is_ref(&rt) {
                return self.todo_expr("a `match` whose value is an array or a reference", e);
            }
            if mx.arms.len() == 0 {
                return self.todo_expr("a `match` without arms", e);
            }
            let slot: Option<String> = self.result_slot(&rt);
            let sv: CVal = self.expr(&*mx.scrut, ck, tb, f - 1);
            if is_never(&sv) {
                return CVal::Never;
            }
            if !is_ptr(&sv) {
                return self.todo_expr("a `match` on a value that is not in memory", e);
            }
            let sp: String = ptr_of(&sv);
            let st: ast::TypeKind = ptr_ty(&sv);
            let consumed: bool = self.consumed_at(e.span, ck);
            if !consumed {
                let kept: bool = self.read_temp(&*mx.scrut, &sv, &st, tb);
            }
            match lowered::enum_variants(&st, tb) {
                None => self.todo_expr("a `match` on a value that is not an enum", e),
                Some(vs) => { let tagp: String = self.field_ptr(sp.as_str(), &st, 0); let tag: String = self.t(); self.emit(types::cat3(tag.as_str(), " = load i64, ptr ", tagp.as_str()).as_str()); let mut labels: Vec<String> = Vec::new(); for a0 in 0..mx.arms.len() invariant 0 <= a0 && a0 <= mx.arms.len(), { labels.push(self.l("arm")); } let end: String = self.l("endmatch"); let mut cases: Vec<String> = Vec::new(); let mut ks: Vec<usize> = Vec::new(); for a1 in 0..mx.arms.len() invariant 0 <= a1 && a1 <= mx.arms.len(), { let k: usize = variant_at(vs.as_slice(), pat_name(&mx.arms[a1].pat).as_str()); if k >= vs.len() || a1 >= labels.len() { return self.todo_expr("a `match` arm of a variant the enum does not have", e); } let mut cs: String = String::from("i64 "); std::num::push_u64(&mut cs, k as u64); cs.push_str(", label %"); cs.push_str(labels[a1].as_str()); cases.push(cs); ks.push(k); } if labels.len() == 0 { return self.todo_expr("a `match` without arms", e); } self.emit(types::cat7("switch i64 ", tag.as_str(), ", label %", labels[labels.len() - 1].as_str(), " [ ", types::join(cases.as_slice(), " ").as_str(), " ]").as_str()); for a2 in 0..mx.arms.len() invariant 0 <= a2 && a2 <= mx.arms.len(), { if a2 < labels.len() && a2 < ks.len() && ks[a2] < vs.len() { self.block(labels[a2].as_str()); let vname: String = pat_name(&mx.arms[a2].pat); let mut backs: Vec<Back> = Vec::new(); for j in 0..mx.arms[a2].pat.binds.len() invariant 0 <= j && j <= mx.arms[a2].pat.binds.len(), { if j < vs[ks[a2]].tys.len() { let pt: ast::TypeKind = vs[ks[a2]].tys[j].clone(); match &mx.arms[a2].pat.binds[j] { None => { if consumed && self.owns(&pt, tb) { let np: String = self.t(); let mut nj: String = String::new(); std::num::push_u64(&mut nj, (j as u64).wrapping_add(1)); self.emit(types::cat7(np.as_str(), " = getelementptr inbounds ", view_ty(&st, vname.as_str()).as_str(), ", ptr ", sp.as_str(), ", i32 0, i32 ", nj.as_str()).as_str()); self.drop_at(np.as_str(), &pt, tb); } }, Some(id) => { let fp: String = self.t(); let mut jt: String = String::new(); std::num::push_u64(&mut jt, (j as u64).wrapping_add(1)); self.emit(types::cat7(fp.as_str(), " = getelementptr inbounds ", view_ty(&st, vname.as_str()).as_str(), ", ptr ", sp.as_str(), ", i32 0, i32 ", jt.as_str()).as_str()); let by_mut: bool = match self.local_ty(id.name.as_str(), tb) { None => false, Some(blt) => types::is_ref_mut(&blt), }; if by_mut { let vt: ast::TypeKind = lowered::value_ty(&pt); if is_mem(&vt) { self.slots.insert(id.name.as_str(), Slot::Data(DataSlot { ptr: fp, ty: vt })); } else if body::is_array(&vt) { let bety: ast::TypeKind = elem_of(&vt); self.slots.insert(id.name.as_str(), Slot::Arr(ArrSlot { ptr: fp, len: array_len_text(&vt), elem: elem_kind(&bety), ety: bety })); } else { let blt2: String = llty(&vt); let btmp: String = self.alloca(blt2.as_str()); let bx: String = self.load_mem(fp.as_str(), &vt); self.emit(types::cat7("store ", blt2.as_str(), " ", bx.as_str(), ", ptr ", btmp.as_str(), "").as_str()); backs.push(Back { tmp: btmp.clone(), elem: String::new(), ptr: fp, lt: blt2.clone(), mem: true, ty: vt }); self.slots.insert(id.name.as_str(), Slot::Scalar(btmp, blt2)); } } else { self.bind(id.name.as_str(), fp.as_str(), &pt); } }, } } } let av: CVal = self.region_expr(&mx.arms[a2].body, ck, tb, f - 1); for b in 0..backs.len() invariant 0 <= b && b <= backs.len(), { let wx: String = self.t(); self.emit(types::cat5(wx.as_str(), " = load ", backs[b].lt.as_str(), ", ptr ", backs[b].tmp.as_str()).as_str()); let wp: String = backs[b].ptr.clone(); let wt: ast::TypeKind = backs[b].ty.clone(); self.put(&CVal::Imm(wx), wp.as_str(), &wt); } self.store_result(&slot, &av, &rt); let owned: Vec<String> = self.move_names(3, mx.arms[a2].body.span, ck); for o in 0..owned.len() invariant 0 <= o && o <= owned.len(), { if has_dot(owned[o].as_str()) { self.drop_path(owned[o].as_str(), tb); } else { match self.data_slot(owned[o].as_str()) { None => {}, Some(osl) => self.drop_at(osl.ptr.as_str(), &osl.ty, tb), } } } self.drop_moves(1, mx.arms[a2].body.span, ck, tb); self.emit(types::cat2("br label %", end.as_str()).as_str()); } } self.block(end.as_str()); self.load_result(&slot, &rt) },
            }
        }

        #[summary("std::mem::replace(&mut p, v)와 std::mem::swap(&mut a, &mut b) (stage0 mem_call): 값이 자리 사이를 옮겨 다닌다. 옛 값이 덩어리면 제 메모리에 둔다")]
        #[effects(alloc)]
        fn mem_call(self: &mut Gen, e: &ast::Expr, c: &ast::Call, replace: bool, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 || c.args.len() != 2 {
                return self.todo_expr("a memory operation without two arguments", e);
            }
            let p0: AnyPlace = self.any_place(&c.args[0], ck, tb, f - 1);
            if !p0.ok {
                return CVal::Never;
            }
            let prev: CVal = if p0.reg.len() > 0 {
                self.read_any(&p0)
            } else if is_scalar_ty(&lowered::value_ty(&p0.ty)) {
                self.read(p0.ptr.as_str(), &p0.ty)
            } else {
                let tmp: String = self.temp(&p0.ty);
                self.copy(tmp.as_str(), p0.ptr.as_str(), &p0.ty);
                self.read(tmp.as_str(), &p0.ty)
            };
            if replace {
                let v: CVal = self.expr(&c.args[1], ck, tb, f - 1);
                self.write_any(&p0, &v);
                return prev;
            }
            let p1: AnyPlace = self.any_place(&c.args[1], ck, tb, f - 1);
            if !p1.ok {
                return CVal::Never;
            }
            let v1: CVal = self.read_any(&p1);
            self.write_any(&p0, &v1);
            self.write_any(&p1, &prev);
            CVal::Unit
        }

        #[summary("바이트 bytes개를 옮긴다 (겹치지 않는 자리 사이)")]
        #[effects(alloc)]
        fn memcpy(self: &mut Gen, dst: &str, src: &str, bytes: u64) -> () {
            let mut line: String = types::cat5("call void @llvm.memcpy.p0.p0.i64(ptr ", dst, ", ptr ", src, ", i64 ");
            std::num::push_u64(&mut line, bytes);
            line.push_str(", i1 false)");
            self.emit(line.as_str());
        }

        #[summary("메서드 호출 (stage0 expr의 Method 갈래들). 지금은 정수 변환의 unwrap, f64의 메서드, 정수의 비트·wrapping·saturating 메서드")]
        #[effects(alloc)]
        fn method(self: &mut Gen, e: &ast::Expr, mc: &ast::Method, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let name: String = mc.name.name.clone();
            match conv_parts(&*mc.recv) {
                None => {},
                Some(cv) => { let st: ast::TypeKind = self.ty(&cv.arg, tb); let v: String = imm(&self.expr(&cv.arg, ck, tb, f - 1)); let needs: bool = body::conv_obligation(&st, &ast::TypeKind::Int(cv.target)); if name == "unwrap" { if needs { let c: String = self.in_range_of(v.as_str(), is_signed(&st), cv.target); self.check(c.as_str(), "conversion may be out of range"); } return CVal::Imm(v); } let kept: String = if needs { self.in_range_of(v.as_str(), is_signed(&st), cv.target) } else { String::from("true") }; return self.option(e, kept.as_str(), v.as_str(), tb); },
            }
            if name == "copy_within" {
                return self.copy_within(e, mc, ck, tb, f - 1);
            }
            if self.is_text_expr(&*mc.recv, tb) && (name == "push_str" || name == "push" || name == "as_str" || name == "as_bytes" || name == "is_char_boundary") || name == "len_utf8" {
                return self.todo_expr("a method of text (backlog 4D-05f)", e);
            }
            let rt: ast::TypeKind = self.ty(&*mc.recv, tb);
            let vt: ast::TypeKind = lowered::value_ty(&rt);
            if name == "clone" && self.owns(&vt, tb) && !plain_vec(&vt, tb) {
                let csrc: String = self.vec_hdr(&*mc.recv, ck, tb, f - 1);
                if csrc == "undef" {
                    return CVal::Never;
                }
                let cdst: String = self.temp(&vt);
                self.emit(types::cat7("call void ", clone_name(&vt).as_str(), "(ptr ", cdst.as_str(), ", ptr ", csrc.as_str(), ")").as_str());
                self.clones.push(types::text(&vt));
                return CVal::Ptr(cdst, vt);
            }
            if is_vec(&rt) {
                return self.vec_method(e, mc, ck, tb, f - 1);
            }
            if name == "len" && mc.args.len() == 0 && (body::is_array(&vt) || is_array(&vt)) {
                let lv: CVal = self.expr(&*mc.recv, ck, tb, f - 1);
                if is_arr(&lv) {
                    return CVal::Imm(arr_len(&lv));
                }
                if is_never(&lv) {
                    return CVal::Never;
                }
                return self.todo_expr("the length of a value that is not an array or a slice", e);
            }
            if self.is_text_expr(&*mc.recv, tb) || body::is_ref(&rt) {
                return self.todo_expr("a method of text or of a reference", e);
            }
            if body::is_f64(&vt) {
                let fa: String = imm(&self.expr(&*mc.recv, ck, tb, f - 1));
                let fb: String = if mc.args.len() > 0 {
                    imm(&self.expr(&mc.args[0], ck, tb, f - 1))
                } else {
                    String::new()
                };
                return self.f64_method(name.as_str(), fa.as_str(), fb.as_str(), mc.args.len() > 0);
            }
            match body::int_of(&rt) {
                None => self.todo_expr("a method of a value that is not a scalar", e),
                Some(i) => { if name == "len" { return self.todo_expr("the length of an integer", e); } let rv: String = imm(&self.expr(&*mc.recv, ck, tb, f - 1)); if (name == "checked_shl" || name == "checked_shr") && mc.args.len() == 1 { let sn: String = imm(&self.expr(&mc.args[0], ck, tb, f - 1)); let sok: String = self.t(); let mut sw: String = String::new(); std::num::push_u64(&mut sw, body::bits(i) as u64); self.emit(types::cat5(sok.as_str(), " = icmp ult i64 ", sn.as_str(), ", ", sw.as_str()).as_str()); let wname: String = if name == "checked_shl" { String::from("wrapping_shl") } else { String::from("wrapping_shr") }; let sv: String = imm(&self.bit_method(wname.as_str(), i, rv.as_str(), sn.as_str())); return self.option(e, sok.as_str(), sv.as_str(), tb); } if name == "to_be_bytes" || name == "to_le_bytes" { return self.to_bytes(rv.as_str(), i, name == "to_le_bytes"); } if name == "is_power_of_two" { let ones: String = imm(&self.bit_method("count_ones", i, rv.as_str(), "")); let pr: String = self.t(); self.emit(types::cat4(pr.as_str(), " = icmp eq i64 ", ones.as_str(), ", 1").as_str()); return CVal::Imm(pr); } if body::bit_method(name.as_str()) > 0 { let n: String = if mc.args.len() > 0 { imm(&self.expr(&mc.args[0], ck, tb, f - 1)) } else { String::new() }; return self.bit_method(name.as_str(), i, rv.as_str(), n.as_str()); } if mc.args.len() != 1 { return self.todo_expr("an integer method without one argument", e); } let b: String = imm(&self.expr(&mc.args[0], ck, tb, f - 1)); self.int_method(e, name.as_str(), rv.as_str(), b.as_str(), i, tb) },
            }
        }

        #[summary("자리 s에 적힌 경로들 (검사기의 MoveInfo). kind는 drop_moves의 것")]
        #[effects(alloc)]
        fn move_names(self: &Gen, kind: u8, s: source::Span, ck: &body::Checked) -> Vec<String> {
            let none: Vec<String> = Vec::new();
            let key: String = body::span_key(s);
            match ck.b.needs.find(self.base.as_str()) {
                None => none,
                Some(at) => { if kind == 0 { match ck.b.needs.items[at].moves.drops.find(key.as_str()) { None => none, Some(i) => ck.b.needs.items[at].moves.drops.items[i].clone(), } } else if kind == 1 { match ck.b.needs.items[at].moves.branch_drops.find(key.as_str()) { None => none, Some(i) => ck.b.needs.items[at].moves.branch_drops.items[i].clone(), } } else if kind == 2 { match ck.b.needs.items[at].moves.exits.find(key.as_str()) { None => none, Some(i) => ck.b.needs.items[at].moves.exits.items[i].clone(), } } else if kind == 3 { match ck.b.needs.items[at].moves.arm_drops.find(key.as_str()) { None => none, Some(i) => ck.b.needs.items[at].moves.arm_drops.items[i].clone(), } } else { match ck.b.needs.items[at].moves.partial_replaces.find(key.as_str()) { None => none, Some(i) => ck.b.needs.items[at].moves.partial_replaces.items[i].clone(), } } },
            }
        }

        #[summary("64비트보다 좁은 정수의 산술 (stage0 narrow_arith): 64비트에서 셈하고 타입의 범위를 잰다")]
        #[effects(alloc)]
        fn narrow_arith(self: &mut Gen, inst: &str, a: &str, b: &str, i: ast::IntTy) -> CVal {
            let r: String = self.t();
            let flag: String = if inst == "mul" && !body::signed(i) {
                String::from("nuw")
            } else {
                String::from("nsw")
            };
            let mut line: String = types::cat5(r.as_str(), " = ", inst, " ", flag.as_str());
            line.push_str(" i64 ");
            line.push_str(a);
            line.push_str(", ");
            line.push_str(b);
            self.emit(line.as_str());
            let c: String = self.fits(r.as_str(), i);
            self.check(c.as_str(), types::cat5("`", inst, "` may overflow `", body::int_text(i).as_str(), "`").as_str());
            CVal::Imm(r)
        }

        #[summary("v를 제 폭 it로 자른 값 (stage0 bit_method의 narrow): 64비트면 그대로")]
        #[effects(alloc)]
        fn narrowed(self: &mut Gen, v: &str, w: u32, it: &str) -> String {
            if w == 64 {
                return String::from(v);
            }
            let t: String = self.t();
            self.emit(types::cat5(t.as_str(), " = trunc i64 ", v, " to ", it).as_str());
            t
        }

        #[summary("ok면 Some(v), 아니면 None인 e의 Option 값 (stage0 option)")]
        #[effects(alloc)]
        fn option(self: &mut Gen, e: &ast::Expr, ok: &str, v: &str, tb: &lowered::Tables) -> CVal {
            let t: ast::TypeKind = self.ty(e, tb);
            if !is_data(&t) {
                return self.todo_expr("an `Option` whose type is not known", e);
            }
            let tmp: String = self.temp(&t);
            let tag: String = self.field_ptr(tmp.as_str(), &t, 0);
            let k: String = self.t();
            self.emit(types::cat4(k.as_str(), " = zext i1 ", ok, " to i64").as_str());
            self.emit(types::cat4("store i64 ", k.as_str(), ", ptr ", tag.as_str()).as_str());
            let p: String = self.t();
            self.emit(types::cat5(p.as_str(), " = getelementptr inbounds ", view_ty(&t, "Some").as_str(), ", ptr ", types::cat2(tmp.as_str(), ", i32 0, i32 1").as_str()).as_str());
            self.emit(types::cat4("store i64 ", v, ", ptr ", p.as_str()).as_str());
            CVal::Ptr(tmp, t)
        }

        #[summary("타입 t의 값이 힙 메모리를 갖는가 (stage0 check::is_move)")]
        #[effects(alloc)]
        fn owns(self: &Gen, t: &ast::TypeKind, tb: &lowered::Tables) -> bool {
            let none: Vec<String> = Vec::new();
            types::is_move_in(t, &tb.adts, none.as_slice())
        }

        #[summary("경로 식 (stage0 expr의 Path 갈래들): 정수 타입의 MIN·MAX, f64의 상수, 아니면 페이로드 없는 변형")]
        #[effects(alloc)]
        fn path_expr(self: &mut Gen, e: &ast::Expr, segs: &[ast::Ident], ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 || segs.len() == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            if segs.len() == 2 {
                match ast::int_of(segs[0].name.as_str()) {
                    None => {},
                    Some(i) => { if segs[1].name == "MIN" { return CVal::Imm(int_min(i)); } if segs[1].name == "MAX" { return CVal::Imm(int_max(i)); } },
                }
                if segs[0].name == "f64" {
                    let bits: u64 = f64_named(segs[1].name.as_str());
                    if bits != 0 {
                        return CVal::Imm(f64_const(bits));
                    }
                }
            }
            let no_args: Vec<ast::Expr> = Vec::new();
            let t: ast::TypeKind = self.ty(e, tb);
            self.variant(e, &t, segs[segs.len() - 1].name.as_str(), no_args.as_slice(), ck, tb, f - 1)
        }

        #[summary("자리의 주소와 타입 (stage0 place): 메모리 값의 변수, 필드, *p, &p, 메모리 값의 원소. Box와 Vec을 지나는 자리는 아직 옮기지 않았다")]
        #[effects(alloc)]
        fn place(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> Place
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false };
            }
            match &e.kind {
                ast::ExprKind::Int(pl_int0, pl_int1) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Float(pl_float0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::ByteLit(pl_bytelit0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::ByteStr(pl_bytestr0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::StrLit(pl_strlit0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::CharLit(pl_charlit0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Bool(pl_bool0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Unit => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Var(id) => { match self.data_slot(id.name.as_str()) { None => { self.todo_at("a place that is a local not in memory", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } }, Some(sl) => Place { ptr: sl.ptr, ty: sl.ty, ok: true }, } },
                ast::ExprKind::Call(pl_call0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Method(pl_method0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Index(ib, ii) => { match var_name(&**ib) { None => { let ap: Place = self.place(&**ib, ck, tb, f - 1); if !ap.ok { return ap; } let avt: ast::TypeKind = lowered::value_ty(&ap.ty); if !body::is_array(&avt) && !body::is_vec(&avt) { self.todo_at("an element of a place that is not an array or a `Vec`", e.span); return Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false }; } let ael: ast::TypeKind = elem_of(&avt); let aview: CVal = if body::is_vec(&avt) { self.vec_view(ap.ptr.as_str()) } else { CVal::Arr(ap.ptr.clone(), array_len_text(&avt)) }; let ai: String = imm(&self.expr(&**ii, ck, tb, f - 1)); let aep: String = self.data_elem(arr_ptr(&aview).as_str(), arr_len(&aview).as_str(), ai.as_str(), &ael); Place { ptr: aep, ty: ael, ok: true } }, Some(bn) => { match self.arr_slot(bn.as_str()) { None => { match self.data_slot(bn.as_str()) { None => { self.todo_at("an element of a local that is not an array, a slice or a `Vec`", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } }, Some(vsl) => { match body::vec_elem(&lowered::value_ty(&vsl.ty)) { None => { self.todo_at("an element of a local that is not an array, a slice or a `Vec`", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } }, Some(vel) => { let vview: CVal = self.vec_view(vsl.ptr.as_str()); let wi: String = imm(&self.expr(&**ii, ck, tb, f - 1)); let wep: String = self.data_elem(arr_ptr(&vview).as_str(), arr_len(&vview).as_str(), wi.as_str(), &vel); Place { ptr: wep, ty: vel, ok: true } }, } }, } }, Some(asl) => { let vi: String = imm(&self.expr(&**ii, ck, tb, f - 1)); let vep: String = self.data_elem(asl.ptr.as_str(), asl.len.as_str(), vi.as_str(), &asl.ety); Place { ptr: vep, ty: asl.ety, ok: true } }, } }, } },
                ast::ExprKind::Unary(pl_unary0, pl_unary1) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Binary(pl_binary0, pl_binary1, pl_binary2) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Ref(pl_m, rx) => self.place(&**rx, ck, tb, f - 1),
                ast::ExprKind::If(pl_if0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Block(pl_block0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Array(pl_array0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Repeat(pl_repeat0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Old(pl_old0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Quant(pl_quant0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Trigger(pl_trigger0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Closure(pl_closure0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::StructLit(pl_structlit0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Path(pl_path0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Deref(dx) => { let dp: Place = self.place(&**dx, ck, tb, f - 1); let reference: bool = match var_name(&**dx) { None => false, Some(rn) => { match self.local_ty(rn.as_str(), tb) { None => false, Some(rlt) => body::is_ref(&rlt), } }, }; if dp.ok && !reference { match body::box_inner(&dp.ty) { None => {}, Some(binner) => { let bh: String = self.unbox(dp.ptr.as_str()); return Place { ptr: bh, ty: binner, ok: true }; }, } } dp },
                ast::ExprKind::Field(fb, fname) => { let bp: Place = self.place(&**fb, ck, tb, f - 1); if !bp.ok { return bp; } let mut fbt: ast::TypeKind = bp.ty.clone(); let mut fbp: String = bp.ptr.clone(); let mut n: usize = 64; while n > 0 && body::is_box(&fbt) invariant n <= 64, decreases n, { n = n - 1; match body::box_inner(&fbt) { None => {}, Some(finner) => { fbp = self.unbox(fbp.as_str()); fbt = finner; }, } } match self.field_of(&fbt, fname.name.as_str(), tb) { None => { self.todo_at("a field of a type that is not a struct", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } }, Some(fa) => { let fp: String = self.field_ptr(fbp.as_str(), &fbt, fa.k); Place { ptr: fp, ty: fa.ty, ok: true } }, } },
                ast::ExprKind::Match(pl_match0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Return(pl_return0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Try(pl_try0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Loop(pl_loop0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Break(pl_break0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Continue(pl_continue0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Range(pl_range0) => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
                ast::ExprKind::Error => { self.todo_at("an expression that is not a place", e.span); Place { ptr: String::from("undef"), ty: ast::TypeKind::Error, ok: false } },
            }
        }

        #[summary("값 v를 메모리 ptr에 쓴다 (stage0 put): 스칼라는 메모리 꼴로 (bool은 한 바이트, 좁은 정수는 제 폭), 배열과 메모리 값은 옮긴다")]
        #[effects(alloc)]
        fn put(self: &mut Gen, v: &CVal, ptr: &str, t: &ast::TypeKind) -> () {
            match v {
                CVal::Imm(x) => { let vt: ast::TypeKind = lowered::value_ty(t); if body::is_bool(&vt) { let z: String = self.t(); self.emit(types::cat4(z.as_str(), " = zext i1 ", x.as_str(), " to i8").as_str()); self.emit(types::cat4("store i8 ", z.as_str(), ", ptr ", ptr).as_str()); return; } match body::int_of(&vt) { None => {}, Some(i) => { if body::bits(i) < 64 { let mut wt: String = String::new(); std::num::push_u64(&mut wt, body::bits(i) as u64); let n: String = self.t(); self.emit(types::cat5(n.as_str(), " = trunc i64 ", x.as_str(), " to i", wt.as_str()).as_str()); self.emit(types::cat7("store i", wt.as_str(), " ", n.as_str(), ", ptr ", ptr, "").as_str()); return; } }, } if body::is_f64(&vt) { self.emit(types::cat4("store double ", x.as_str(), ", ptr ", ptr).as_str()); } else { self.emit(types::cat4("store i64 ", x.as_str(), ", ptr ", ptr).as_str()); } },
                CVal::Arr(asrc, pu_n) => self.copy(ptr, asrc.as_str(), t),
                CVal::Ptr(psrc, pu_t) => self.copy(ptr, psrc.as_str(), t),
                CVal::Unit => {},
                CVal::Never => {},
            }
        }

        #[summary("ptr에 있는 타입 t의 값 (stage0 read): 스칼라는 읽고, 배열과 메모리 값은 그 주소다")]
        #[effects(alloc)]
        fn read(self: &mut Gen, ptr: &str, t: &ast::TypeKind) -> CVal {
            let vt: ast::TypeKind = lowered::value_ty(t);
            if is_mem(&vt) {
                return CVal::Ptr(String::from(ptr), vt);
            }
            if body::is_array(&vt) {
                return CVal::Arr(String::from(ptr), array_len_text(&vt));
            }
            if decls::is_unit(&vt) {
                return CVal::Unit;
            }
            CVal::Imm(self.load_mem(ptr, &vt))
        }

        #[summary("any_place의 자리의 값 (stage0 read_any)")]
        #[effects(alloc)]
        fn read_any(self: &mut Gen, p: &AnyPlace) -> CVal {
            if p.reg.len() > 0 {
                let r: String = self.t();
                self.emit(types::cat5(r.as_str(), " = load ", p.reg.as_str(), ", ptr ", p.ptr.as_str()).as_str());
                return CVal::Imm(r);
            }
            self.read(p.ptr.as_str(), &p.ty)
        }

        #[summary("식 e에서 나온, 읽히기만 하는 임시값 v (stage0 read_temp): 힙 메모리를 가지면 구역이 끝날 때 놓게 적는다. 적었으면 참")]
        #[effects(alloc)]
        fn read_temp(self: &mut Gen, e: &ast::Expr, v: &CVal, t: &ast::TypeKind, tb: &lowered::Tables) -> bool {
            if is_ptr(v) && fresh(e) && self.owns(t, tb) {
                self.pending.push(Pend { ptr: ptr_of(v), ty: t.clone() });
                return true;
            }
            false
        }

        #[summary("&e (stage0 expr의 Ref): 임시값은 구역이 끝날 때까지 산다")]
        #[effects(alloc)]
        fn ref_expr(self: &mut Gen, x: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", x);
            }
            let v: CVal = self.expr(x, ck, tb, f - 1);
            let vt: ast::TypeKind = lowered::value_ty(&self.ty(x, tb));
            let kept: bool = self.read_temp(x, &v, &vt, tb);
            v
        }

        #[summary("구역 하나로서의 식 (stage0 region): 그 안에서 남긴 임시값을 끝에서 놓는다")]
        #[effects(alloc)]
        fn region_expr(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let mark: usize = self.pending.len();
            let v: CVal = self.expr(e, ck, tb, f - 1);
            self.release(mark, v, tb)
        }

        #[summary("mark부터의 임시값을 놓고 지운다 (stage0 release). 놓이는 메모리를 가리킬지 모르는 메모리 값은 먼저 제 메모리로 옮긴다")]
        #[effects(alloc)]
        fn release(self: &mut Gen, mark: usize, v: CVal, tb: &lowered::Tables) -> CVal {
            if self.pending.len() <= mark {
                return v;
            }
            let kept: CVal = self.detach(v);
            self.drop_pending_from(mark, tb);
            self.pending.truncate(mark);
            kept
        }

        #[summary("대입 자리 s가 가진 옛 값을 갈아치우는가 (검사기의 MoveInfo.replaces)")]
        #[effects(alloc)]
        fn replaces(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => types::has(ck.b.needs.items[at].moves.replaces.as_slice(), body::span_key(s).as_str()),
            }
        }

        #[summary("대입 자리 s에서 놓는 값이 있는가 (검사기의 MoveInfo.replaces와 partial_replaces)")]
        #[effects(alloc)]
        fn replaces_at(self: &Gen, s: source::Span, ck: &body::Checked) -> bool {
            match ck.b.needs.find(self.base.as_str()) {
                None => false,
                Some(at) => types::has(ck.b.needs.items[at].moves.replaces.as_slice(), body::span_key(s).as_str()) || ck.b.needs.items[at].moves.partial_replaces.has(body::span_key(s).as_str()),
            }
        }

        #[summary("호출의 경로가 가리키는 함수 (stage0 resolve): 제 단위의 것이 먼저")]
        #[effects(alloc)]
        fn resolve(self: &Gen, path: &[ast::Ident], tb: &lowered::Tables) -> String {
            let mut names: Vec<String> = Vec::new();
            for i in 0..path.len()
                invariant 0 <= i && i <= path.len(),
            {
                names.push(path[i].name.clone());
            }
            let name: String = types::join(names.as_slice(), "::");
            let local: String = types::cat3(self.unit.as_str(), "::", name.as_str());
            match tb.fns.find(local.as_str()) {
                None => name,
                Some(at) => { if path.len() == 1 || path.len() == 2 && (tb.fns.items[at].in_impl || has_trait(&tb.fns.items[at])) { local } else { name } },
            }
        }

        #[summary("if나 loop의 갈래들이 값을 두는 자리 (stage0 result_slot): 단위 값은 자리가 없고, 메모리 값은 그 타입의 자리, 스칼라는 레지스터 타입의 자리")]
        #[effects(alloc)]
        fn result_slot(self: &mut Gen, t: &ast::TypeKind) -> Option<String> {
            if decls::is_unit(t) || types::is_error(t) {
                return None;
            }
            if is_mem(t) {
                return Some(self.temp(t));
            }
            Some(self.alloca(llty(t).as_str()))
        }

        #[summary("return (stage0 return_expr): 값을 돌려주고, 뒤의 코드는 닿지 않는 블록에 둔다")]
        #[effects(alloc)]
        fn return_expr(self: &mut Gen, e: &ast::Expr, x: &Option<Box<ast::Expr>>, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let v0: CVal = match x {
                None => CVal::Unit,
                Some(rv) => self.expr(&**rv, ck, tb, f - 1),
            };
            let v: CVal = self.detach(v0);
            self.drop_pending_from(0, tb);
            self.drop_moves(2, e.span, ck, tb);
            self.emit_return(&v);
            let after: String = self.l("after_return");
            self.block(after.as_str());
            CVal::Never
        }

        #[summary("스칼라 참조 인자로 넘길 주소 (stage0 scalar_ref, 백로그 2T-08): 지역 변수나 참조 매개변수는 제 자리, 원소는 그 값을 담은 임시 자리이고 mutable이면 호출 뒤에 되돌려 쓴다, 값은 임시 자리. 필드는 아직 옮기지 않았다")]
        #[effects(alloc)]
        fn scalar_ref(self: &mut Gen, a: &ast::Expr, t: &ast::TypeKind, mutable: bool, backs: &mut Vec<Back>, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", a.span);
                return String::from("undef");
            }
            match &a.kind {
                ast::ExprKind::Int(sr_int0, sr_int1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Float(sr_float0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::ByteLit(sr_bytelit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::ByteStr(sr_bytestr0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::StrLit(sr_strlit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::CharLit(sr_charlit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Bool(sr_bool0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Unit => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Var(sr_var0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Call(sr_call0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Method(sr_method0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Index(sr_index0, sr_index1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Unary(sr_unary0, sr_unary1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Binary(sr_binary0, sr_binary1, sr_binary2) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Ref(sr_m, sr_x) => self.scalar_ref_of(&**sr_x, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::If(sr_if0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Block(sr_block0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Array(sr_array0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Repeat(sr_repeat0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Old(sr_old0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Quant(sr_quant0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Trigger(sr_trigger0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Closure(sr_closure0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::StructLit(sr_structlit0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Path(sr_path0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Deref(sr_deref0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Field(sr_field0, sr_field1) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Match(sr_match0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Return(sr_return0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Try(sr_try0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Loop(sr_loop0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Break(sr_break0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Continue(sr_continue0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Range(sr_range0) => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
                ast::ExprKind::Error => self.scalar_ref_of(a, t, mutable, backs, ck, tb, f - 1),
            }
        }

        #[summary("scalar_ref의 &를 벗긴 식")]
        #[effects(alloc)]
        fn scalar_ref_of(self: &mut Gen, inner: &ast::Expr, t: &ast::TypeKind, mutable: bool, backs: &mut Vec<Back>, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", inner.span);
                return String::from("undef");
            }
            match var_name(inner) {
                None => {},
                Some(name) => { match self.scalar_slot(name.as_str()) { None => {}, Some(slot) => { return slot.ptr; }, } },
            }
            let lt: String = llty(t);
            let tmp: String = self.alloca(lt.as_str());
            match &inner.kind {
                ast::ExprKind::Int(so_int0, so_int1) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Float(so_float0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::ByteLit(so_bytelit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::ByteStr(so_bytestr0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::StrLit(so_strlit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::CharLit(so_charlit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Bool(so_bool0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Unit => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Var(so_id) => self.scalar_ref_place(inner, t, mutable, tmp, backs, ck, tb, f - 1),
                ast::ExprKind::Call(so_call0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Method(so_method0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Index(ib, ii) => { match var_name(&**ib) { None => self.scalar_ref_place(inner, t, mutable, tmp, backs, ck, tb, f - 1), Some(bn) => { let ep: ElemPtr = self.elem_ptr(inner, &**ib, &**ii, ck, tb, f - 1); if ep.ptr == "undef" { return tmp; } let ev: String = self.load_elem(ep.elem.as_str(), ep.ptr.as_str()); self.emit(types::cat7("store ", lt.as_str(), " ", ev.as_str(), ", ptr ", tmp.as_str(), "").as_str()); if mutable { backs.push(Back { tmp: tmp.clone(), elem: ep.elem.clone(), ptr: ep.ptr.clone(), lt: lt.clone(), mem: false, ty: t.clone() }); } tmp }, } },
                ast::ExprKind::Unary(so_unary0, so_unary1) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Binary(so_binary0, so_binary1, so_binary2) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Ref(so_m, so_r) => self.scalar_ref_place(inner, t, mutable, tmp, backs, ck, tb, f - 1),
                ast::ExprKind::If(so_if0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Block(so_block0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Array(so_array0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Repeat(so_repeat0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Old(so_old0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Quant(so_quant0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Trigger(so_trigger0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Closure(so_closure0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::StructLit(so_structlit0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Path(so_path0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Deref(so_d) => self.scalar_ref_place(inner, t, mutable, tmp, backs, ck, tb, f - 1),
                ast::ExprKind::Field(so_b, so_n) => self.scalar_ref_place(inner, t, mutable, tmp, backs, ck, tb, f - 1),
                ast::ExprKind::Match(so_match0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Return(so_return0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Try(so_try0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Loop(so_loop0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Break(so_break0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Continue(so_continue0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Range(so_range0) => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
                ast::ExprKind::Error => { let v: String = imm(&self.expr(inner, ck, tb, f - 1)); self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str()); tmp },
            }
        }

        #[summary("scalar_ref의 자리 갈래: 메모리 꼴의 자리(필드, 메모리 값의 원소, 참조를 지난 자리)의 값을 임시 자리 tmp에 담고, mutable이면 호출 뒤에 되돌려 쓴다")]
        #[effects(alloc)]
        fn scalar_ref_place(self: &mut Gen, inner: &ast::Expr, t: &ast::TypeKind, mutable: bool, tmp: String, backs: &mut Vec<Back>, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", inner.span);
                return tmp;
            }
            let pl: Place = self.place(inner, ck, tb, f - 1);
            if !pl.ok {
                return tmp;
            }
            let lt: String = llty(t);
            let v: String = imm(&self.read(pl.ptr.as_str(), t));
            self.emit(types::cat7("store ", lt.as_str(), " ", v.as_str(), ", ptr ", tmp.as_str(), "").as_str());
            if mutable {
                backs.push(Back { tmp: tmp.clone(), elem: String::new(), ptr: pl.ptr.clone(), lt: lt.clone(), mem: true, ty: t.clone() });
            }
            tmp
        }

        #[summary("스칼라 지역 변수 name의 자리와 레지스터 타입")]
        #[effects(alloc)]
        fn scalar_slot(self: &Gen, name: &str) -> Option<ScalarSlot> {
            match self.slots.find(name) {
                None => None,
                Some(at) => { match &self.slots.items[at] { Slot::Scalar(ptr, ty) => Some(ScalarSlot { ptr: ptr.clone(), ty: ty.clone() }), Slot::Arr(sl_a) => None, Slot::Data(sl_d) => None, } },
            }
        }

        #[summary("시프트 (stage0 shift, shift_inst): 양이 폭보다 작은 리터럴이 아니면 잰다. 좁은 타입의 왼쪽 시프트는 제 폭으로 자르고 다시 넓힌다")]
        #[effects(alloc)]
        fn shift(self: &mut Gen, op: ast::BinOp, i: ast::IntTy, a: &str, r: &ast::Expr, b: &str) -> CVal {
            let w: u32 = body::bits(i);
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, w as u64);
            let literal: bool = match int_lit(r) {
                None => false,
                Some(k) => k.hi == 0 && k.lo < w as u64,
            };
            if !literal {
                let c: String = self.t();
                self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", b, ", ", wt.as_str()).as_str());
                self.check(c.as_str(), types::cat2("shift amount out of 0..", wt.as_str()).as_str());
            }
            self.shift_inst(op, i, a, b)
        }

        #[summary("시프트의 명령 (stage0 shift_inst): 좁은 타입의 왼쪽 시프트는 제 폭으로 자르고 다시 넓힌다")]
        #[effects(alloc)]
        fn shift_inst(self: &mut Gen, op: ast::BinOp, i: ast::IntTy, a: &str, b: &str) -> CVal {
            let w: u32 = body::bits(i);
            let mut wt: String = String::new();
            std::num::push_u64(&mut wt, w as u64);
            let res: String = self.t();
            if is_shr(op) {
                let inst: String = if body::signed(i) {
                    String::from("ashr")
                } else {
                    String::from("lshr")
                };
                self.emit(types::cat7(res.as_str(), " = ", inst.as_str(), " i64 ", a, ", ", b).as_str());
            } else if w == 64 {
                self.emit(types::cat5(res.as_str(), " = shl i64 ", a, ", ", b).as_str());
            } else {
                let wide: String = self.t();
                let narrow: String = self.t();
                self.emit(types::cat5(wide.as_str(), " = shl i64 ", a, ", ", b).as_str());
                self.emit(types::cat5(narrow.as_str(), " = trunc i64 ", wide.as_str(), " to i", wt.as_str()).as_str());
                let ext: String = if body::signed(i) {
                    String::from("sext")
                } else {
                    String::from("zext")
                };
                let mut line: String = types::cat5(res.as_str(), " = ", ext.as_str(), " i", wt.as_str());
                line.push_str(" ");
                line.push_str(narrow.as_str());
                line.push_str(" to i64");
                self.emit(line.as_str());
            }
            CVal::Imm(res)
        }

        #[summary("문장 (stage0 stmt). 지금은 let, 대입, 식 문장, 코드가 없는 증명 문장")]
        #[effects(alloc)]
        fn stmt(self: &mut Gen, st: &ast::Stmt, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo.push(types::cat2("nesting too deep in ", self.path.as_str()));
                return;
            }
            match st {
                ast::Stmt::Let(x) => self.let_stmt(x, ck, tb, f - 1),
                ast::Stmt::Assign(a) => self.assign(a, ck, tb, f - 1),
                ast::Stmt::While(w) => self.while_stmt(w, ck, tb, f - 1),
                ast::Stmt::For(fo) => self.for_stmt(fo, ck, tb, f - 1),
                ast::Stmt::Assert(st_a) => {},
                ast::Stmt::Assume(st_u) => {},
                ast::Stmt::Proof(st_p) => {},
                ast::Stmt::LetFields(lf) => self.todo_at("a `let` of fields", lf.span),
                ast::Stmt::Expr(ex) => { let v: CVal = self.expr(ex, ck, tb, f - 1); if is_ptr(&v) { let dt: ast::TypeKind = ptr_ty(&v); self.drop_at(ptr_of(&v).as_str(), &dt, tb); } },
            }
        }

        #[summary("원소를 쓴다 (stage0 store_elem): bool과 좁은 정수는 제 폭으로 줄여 쓴다")]
        #[effects(alloc)]
        fn store_elem(self: &mut Gen, elem: &str, v: &str, ptr: &str) -> () {
            let mut al: String = String::new();
            std::num::push_u64(&mut al, align(elem) as u64);
            if elem == "i1" || narrow_bits(elem) > 0 {
                let z: String = self.t();
                let m: String = mem(elem);
                let op: String = if elem == "i1" {
                    String::from("zext i1")
                } else {
                    String::from("trunc i64")
                };
                self.emit(types::cat7(z.as_str(), " = ", op.as_str(), " ", v, " to ", m.as_str()).as_str());
                self.emit(types::cat7("store ", m.as_str(), " ", z.as_str(), ", ptr ", ptr, types::cat2(", align ", al.as_str()).as_str()).as_str());
            } else {
                self.emit(types::cat7("store ", elem, " ", v, ", ptr ", ptr, types::cat2(", align ", al.as_str()).as_str()).as_str());
            }
        }

        #[summary("갈래의 값을 결과의 자리에 (stage0 store_result): 끝나지 않는 값과 자리 없는 결과는 쓰지 않는다. 메모리 값은 옮긴다")]
        #[effects(alloc)]
        fn store_result(self: &mut Gen, slot: &Option<String>, v: &CVal, t: &ast::TypeKind) -> () {
            if is_never(v) {
                return;
            }
            match slot {
                None => {},
                Some(sl) => { if is_mem(t) { self.put(v, sl.as_str(), t); } else { self.emit(types::cat7("store ", llty(t).as_str(), " ", imm(v).as_str(), ", ptr ", sl.as_str(), "").as_str()); } },
            }
        }

        #[summary("구조체 리터럴 (stage0 expr의 StructLit): 필드를 쓴 차례로 셈하고 옮긴다")]
        #[effects(alloc)]
        fn struct_lit(self: &mut Gen, e: &ast::Expr, lit: &ast::StructLit, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            match &lit.rest {
                None => {},
                Some(rest) => { return self.todo_expr("a struct literal with a rest", e); },
            }
            let t: ast::TypeKind = self.ty(e, tb);
            if !is_data(&t) {
                return self.todo_expr("a struct literal whose type is not a struct", e);
            }
            let tmp: String = self.temp(&t);
            for i in 0..lit.fields.len()
                invariant 0 <= i && i <= lit.fields.len(),
            {
                let v: CVal = self.expr(&lit.fields[i].value, ck, tb, f - 1);
                match self.field_of(&t, lit.fields[i].name.name.as_str(), tb) {
                    None => self.todo_at("a field that the struct does not have", e.span),
                    Some(fa) => { let p: String = self.field_ptr(tmp.as_str(), &t, fa.k); self.put(&v, p.as_str(), &fa.ty); },
                }
            }
            CVal::Ptr(tmp, t)
        }

        #[summary("다음 %tN")]
        #[effects(alloc)]
        fn t(self: &mut Gen) -> String {
            self.tmp = self.tmp.wrapping_add(1);
            let mut s: String = String::from("%t");
            std::num::push_u64(&mut s, self.tmp as u64);
            s
        }

        #[summary("t의 값 하나의 자리 (stage0 temp)")]
        #[effects(alloc)]
        fn temp(self: &mut Gen, t: &ast::TypeKind) -> String {
            self.alloca(mem_ty(t).as_str())
        }

        #[summary("정수의 바이트들 (stage0 expr의 to_be_bytes·to_le_bytes, 백로그 2N-09c): 바이트마다 레지스터를 오른쪽으로 밀어 잘라 쓴다")]
        #[effects(alloc)]
        fn to_bytes(self: &mut Gen, a: &str, i: ast::IntTy, le: bool) -> CVal {
            let n: u32 = body::bits(i) / 8;
            let mut nt: String = String::new();
            std::num::push_u64(&mut nt, n as u64);
            let ptr: String = self.alloca(types::cat3("[", nt.as_str(), " x i8]").as_str());
            for k in 0..n
                invariant 0 <= k && k <= n,
            {
                let sh: u32 = if le {
                    k.wrapping_mul(8)
                } else {
                    n.wrapping_sub(1).wrapping_sub(k).wrapping_mul(8)
                };
                let v: String = if sh == 0 {
                    String::from(a)
                } else {
                    let sv: String = self.t();
                    let mut st: String = String::new();
                    std::num::push_u64(&mut st, sh as u64);
                    self.emit(types::cat5(sv.as_str(), " = lshr i64 ", a, ", ", st.as_str()).as_str());
                    sv
                };
                let p: String = self.t();
                let mut kt: String = String::new();
                std::num::push_u64(&mut kt, k as u64);
                self.emit(types::cat7(p.as_str(), " = getelementptr inbounds [", nt.as_str(), " x i8], ptr ", ptr.as_str(), ", i64 0, i64 ", kt.as_str()).as_str());
                self.store_elem("u8", v.as_str(), p.as_str());
            }
            CVal::Arr(ptr, nt)
        }

        #[summary("옮기지 않은 구문 what을 자리 s에서 만났다고 적는다")]
        #[effects(alloc)]
        fn todo_at(self: &mut Gen, what: &str, s: source::Span) -> () {
            let mut m: String = String::from(what);
            m.push_str(" in ");
            m.push_str(self.path.as_str());
            m.push_str(" at bytes ");
            std::num::push_u64(&mut m, s.lo as u64);
            m.push_str("..");
            std::num::push_u64(&mut m, s.hi as u64);
            self.todo.push(m);
        }

        #[summary("옮기지 않은 식: 까닭을 적고 끝나지 않는 값으로 둔다")]
        #[effects(alloc)]
        fn todo_expr(self: &mut Gen, what: &str, e: &ast::Expr) -> CVal {
            self.todo_at(what, e.span);
            CVal::Never
        }

        #[summary("x? (stage0 try_expr): 꼬리표를 재고, None이나 Err면 그것을 (Err의 값은 옮겨) 돌려주고, 아니면 값은 페이로드다")]
        #[effects(alloc)]
        fn try_expr(self: &mut Gen, e: &ast::Expr, x: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let sv: CVal = self.expr(x, ck, tb, f - 1);
            if is_never(&sv) {
                return CVal::Never;
            }
            if !is_ptr(&sv) {
                return self.todo_expr("a `?` on a value that is not in memory", e);
            }
            let sp: String = ptr_of(&sv);
            let st: ast::TypeKind = ptr_ty(&sv);
            if !self.consumed_at(e.span, ck) {
                let kept: bool = self.read_temp(x, &sv, &st, tb);
            }
            let kind: u8 = body::try_variants(&st);
            if kind == 0 {
                return self.todo_expr("a `?` on a value that is not an `Option` or a `Result`", e);
            }
            let ok: String = if kind == 1 {
                String::from("Some")
            } else {
                String::from("Ok")
            };
            let bad: String = if kind == 1 {
                String::from("None")
            } else {
                String::from("Err")
            };
            let rt: ast::TypeKind = self.ret.clone();
            match lowered::enum_variants(&st, tb) {
                None => self.todo_expr("a `?` on a value that is not an enum", e),
                Some(vs) => { match lowered::enum_variants(&rt, tb) { None => self.todo_expr("a `?` in a function whose result is not an enum", e), Some(rvs) => { let k_ok: usize = variant_at(vs.as_slice(), ok.as_str()); let k_bad_in: usize = variant_at(vs.as_slice(), bad.as_str()); let k_bad: usize = variant_at(rvs.as_slice(), bad.as_str()); if k_ok >= vs.len() || k_bad_in >= vs.len() || k_bad >= rvs.len() || vs[k_ok].tys.len() == 0 { return self.todo_expr("a `?` whose variants are not found", e); } let tagp: String = self.field_ptr(sp.as_str(), &st, 0); let tag: String = self.t(); self.emit(types::cat3(tag.as_str(), " = load i64, ptr ", tagp.as_str()).as_str()); let is_ok: String = self.t(); let mut kt: String = String::new(); std::num::push_u64(&mut kt, k_ok as u64); self.emit(types::cat5(is_ok.as_str(), " = icmp eq i64 ", tag.as_str(), ", ", kt.as_str()).as_str()); let ok_l: String = self.l("try_ok"); let bad_l: String = self.l("try_out"); self.emit(types::cat7("br i1 ", is_ok.as_str(), ", label %", ok_l.as_str(), ", label %", bad_l.as_str(), "").as_str()); self.block(bad_l.as_str()); let out: String = self.temp(&rt); let out_tag: String = self.field_ptr(out.as_str(), &rt, 0); let mut bt: String = String::new(); std::num::push_u64(&mut bt, k_bad as u64); self.emit(types::cat4("store i64 ", bt.as_str(), ", ptr ", out_tag.as_str()).as_str()); if vs[k_bad_in].tys.len() == 1 { let src: String = self.t(); let dst: String = self.t(); self.emit(types::cat5(src.as_str(), " = getelementptr inbounds ", view_ty(&st, bad.as_str()).as_str(), ", ptr ", types::cat2(sp.as_str(), ", i32 0, i32 1").as_str()).as_str()); self.emit(types::cat5(dst.as_str(), " = getelementptr inbounds ", view_ty(&rt, bad.as_str()).as_str(), ", ptr ", types::cat2(out.as_str(), ", i32 0, i32 1").as_str()).as_str()); let bpt: ast::TypeKind = vs[k_bad_in].tys[0].clone(); self.copy(dst.as_str(), src.as_str(), &bpt); } self.drop_pending_from(0, tb); self.drop_moves(2, e.span, ck, tb); self.emit_return(&CVal::Ptr(out, rt.clone())); self.block(ok_l.as_str()); let pt: ast::TypeKind = lowered::value_ty(&vs[k_ok].tys[0]); let fp: String = self.t(); self.emit(types::cat5(fp.as_str(), " = getelementptr inbounds ", view_ty(&st, ok.as_str()).as_str(), ", ptr ", types::cat2(sp.as_str(), ", i32 0, i32 1").as_str()).as_str()); if is_mem(&pt) { let mtmp: String = self.temp(&pt); self.copy(mtmp.as_str(), fp.as_str(), &pt); return CVal::Ptr(mtmp, pt); } if body::is_array(&pt) { let atmp: String = self.temp(&pt); self.copy(atmp.as_str(), fp.as_str(), &pt); return CVal::Arr(atmp, array_len_text(&pt)); } CVal::Imm(self.load_mem(fp.as_str(), &pt)) }, } },
            }
        }

        #[summary("식 e의 타입 (낮춘 표에서)")]
        #[effects(alloc)]
        fn ty(self: &Gen, e: &ast::Expr, tb: &lowered::Tables) -> ast::TypeKind {
            match tb.types.find(body::span_key(e.span).as_str()) {
                None => ast::TypeKind::Error,
                Some(at) => tb.types.items[at].clone(),
            }
        }

        #[summary("단항 연산 (stage0 expr의 Unary 갈래들): 부호 바꿈은 리터럴이면 그 글, f64면 fneg, 정수면 0에서 뺀다. !는 bool이면 뒤집고 정수면 제 폭의 비트를 뒤집는다")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn unary(self: &mut Gen, e: &ast::Expr, op: ast::UnOp, x: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let xt: ast::TypeKind = self.ty(x, tb);
            if is_neg(op) {
                if body::is_f64(&xt) {
                    match float_lit(x) {
                        None => {},
                        Some(bits) => { return CVal::Imm(f64_const(bits ^ 9223372036854775808)); },
                    }
                    let fv: String = imm(&self.expr(x, ck, tb, f - 1));
                    let fr: String = self.t();
                    self.emit(types::cat3(fr.as_str(), " = fneg double ", fv.as_str()).as_str());
                    return CVal::Imm(fr);
                }
                match int_lit(x) {
                    None => {},
                    Some(k) => { let mut s: String = String::from("-"); wide::push_radix(&mut s, k, 10); return CVal::Imm(s); },
                }
                let v: String = imm(&self.expr(x, ck, tb, f - 1));
                return match body::int_of(&self.ty(e, tb)) { None => self.arith("sub", "0", v.as_str(), true), Some(i) => { if body::bits(i) < 64 { self.narrow_arith("sub", "0", v.as_str(), i) } else { self.arith("sub", "0", v.as_str(), true) } }, };
            }
            let nv: String = imm(&self.expr(x, ck, tb, f - 1));
            let r: String = self.t();
            match body::int_of(&xt) {
                None => self.emit(types::cat4(r.as_str(), " = xor i1 ", nv.as_str(), ", true").as_str()),
                Some(i) => { if body::signed(i) { self.emit(types::cat4(r.as_str(), " = xor i64 ", nv.as_str(), ", -1").as_str()); } else { self.emit(types::cat5(r.as_str(), " = xor i64 ", nv.as_str(), ", ", int_max(i).as_str()).as_str()); } },
            }
            CVal::Imm(r)
        }

        #[summary("Box의 칸 cell이 가리키는 값의 주소 (stage0 unbox)")]
        #[effects(alloc)]
        fn unbox(self: &mut Gen, cell: &str) -> String {
            let h: String = self.t();
            self.emit(types::cat3(h.as_str(), " = load ptr, ptr ", cell).as_str());
            h
        }

        #[summary("열거형 t의 변형 vname을 인자들로 짓는다 (stage0 variant): 페이로드는 셈하는 차례로 옮긴다")]
        #[effects(alloc)]
        fn variant(self: &mut Gen, e: &ast::Expr, t: &ast::TypeKind, vname: &str, args: &[ast::Expr], ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            match lowered::enum_variants(t, tb) {
                None => self.todo_expr("a call or a path that is not a function, a constant or a variant", e),
                Some(vs) => { let k: usize = variant_at(vs.as_slice(), vname); if k >= vs.len() { return self.todo_expr("a variant the enum does not have", e); } let tmp: String = self.temp(t); let tag: String = self.field_ptr(tmp.as_str(), t, 0); let mut kt: String = String::new(); std::num::push_u64(&mut kt, k as u64); self.emit(types::cat4("store i64 ", kt.as_str(), ", ptr ", tag.as_str()).as_str()); for j in 0..args.len() invariant 0 <= j && j <= args.len(), { if j < vs[k].tys.len() { let val: CVal = self.expr(&args[j], ck, tb, f - 1); let p: String = self.t(); let mut jt: String = String::new(); std::num::push_u64(&mut jt, (j as u64).wrapping_add(1)); self.emit(types::cat7(p.as_str(), " = getelementptr inbounds ", view_ty(t, vname).as_str(), ", ptr ", tmp.as_str(), ", i32 0, i32 ", jt.as_str()).as_str()); let pty: ast::TypeKind = vs[k].tys[j].clone(); self.put(&val, p.as_str(), &pty); } } CVal::Ptr(tmp, lowered::value_ty(t)) },
            }
        }

        #[summary("Vec의 머리 hdr의 k째 칸의 주소 (stage0 vec_field): 0 버퍼, 1 길이, 2 용량")]
        #[effects(alloc)]
        fn vec_field(self: &mut Gen, hdr: &str, k: u32) -> String {
            let p: String = self.t();
            let mut kt: String = String::new();
            std::num::push_u64(&mut kt, k as u64);
            self.emit(types::cat5(p.as_str(), " = getelementptr inbounds %bmb.vec, ptr ", hdr, ", i32 0, i32 ", kt.as_str()).as_str());
            p
        }

        #[summary("읽히기만 하는 Vec 식의 머리 (stage0 vec_hdr): 자리면 제 머리, 임시값이면 구역이 끝날 때 놓는다. 옮기지 못하면 undef")]
        #[effects(alloc)]
        fn vec_hdr(self: &mut Gen, e: &ast::Expr, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", e.span);
                return String::from("undef");
            }
            let v: CVal = self.expr(e, ck, tb, f - 1);
            if !is_ptr(&v) {
                if !is_never(&v) {
                    self.todo_at("a `Vec` value that is not in memory", e.span);
                }
                return String::from("undef");
            }
            if fresh(e) {
                self.pending.push(Pend { ptr: ptr_of(&v), ty: lowered::value_ty(&self.ty(e, tb)) });
            }
            ptr_of(&v)
        }

        #[summary("Vec의 메서드 (stage0 vec_method): len, as_slice, as_mut_slice, clone (원소가 힙을 갖지 않는 것), truncate, push, pop")]
        #[effects(alloc)]
        fn vec_method(self: &mut Gen, e: &ast::Expr, mc: &ast::Method, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let vt: ast::TypeKind = lowered::value_ty(&self.ty(&*mc.recv, tb));
            let el: ast::TypeKind = elem_of(&vt);
            let hdr: String = self.vec_hdr(&*mc.recv, ck, tb, f - 1);
            if hdr == "undef" {
                return CVal::Never;
            }
            let m: String = mc.name.name.clone();
            if m == "len" {
                let lp: String = self.vec_field(hdr.as_str(), 1);
                let r: String = self.t();
                self.emit(types::cat3(r.as_str(), " = load i64, ptr ", lp.as_str()).as_str());
                return CVal::Imm(r);
            }
            if m == "as_slice" || m == "as_mut_slice" {
                return self.vec_view(hdr.as_str());
            }
            if m == "clone" {
                let dst: String = self.temp(&vt);
                self.emit(types::cat7("call void @bmb_vec_clone(ptr ", dst.as_str(), ", ptr ", hdr.as_str(), ", i64 ", size_of(&el).as_str(), ")").as_str());
                return CVal::Ptr(dst, vt);
            }
            if m == "truncate" && mc.args.len() == 1 {
                let n: String = imm(&self.expr(&mc.args[0], ck, tb, f - 1));
                let lp2: String = self.vec_field(hdr.as_str(), 1);
                let len: String = self.t();
                let r2: String = self.t();
                self.emit(types::cat3(len.as_str(), " = load i64, ptr ", lp2.as_str()).as_str());
                self.emit(types::cat7(r2.as_str(), " = call i64 @llvm.umin.i64(i64 ", len.as_str(), ", i64 ", n.as_str(), ")", "").as_str());
                if self.owns(&el, tb) {
                    let buf: String = self.t();
                    self.emit(types::cat3(buf.as_str(), " = load ptr, ptr ", hdr.as_str()).as_str());
                    let i: String = self.alloca("i64");
                    self.emit(types::cat4("store i64 ", r2.as_str(), ", ptr ", i.as_str()).as_str());
                    let head: String = self.l("cut");
                    let lb: String = self.l("cutb");
                    let end: String = self.l("cutd");
                    self.emit(types::cat2("br label %", head.as_str()).as_str());
                    self.block(head.as_str());
                    let k: String = self.t();
                    let c: String = self.t();
                    self.emit(types::cat3(k.as_str(), " = load i64, ptr ", i.as_str()).as_str());
                    self.emit(types::cat5(c.as_str(), " = icmp ult i64 ", k.as_str(), ", ", len.as_str()).as_str());
                    self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str());
                    self.block(lb.as_str());
                    let ep: String = self.t();
                    self.emit(types::cat7(ep.as_str(), " = getelementptr inbounds ", mem_ty(&el).as_str(), ", ptr ", buf.as_str(), ", i64 ", k.as_str()).as_str());
                    self.drop_at(ep.as_str(), &el, tb);
                    let k2: String = self.t();
                    self.emit(types::cat4(k2.as_str(), " = add nuw i64 ", k.as_str(), ", 1").as_str());
                    self.emit(types::cat4("store i64 ", k2.as_str(), ", ptr ", i.as_str()).as_str());
                    self.emit(types::cat2("br label %", head.as_str()).as_str());
                    self.block(end.as_str());
                }
                self.emit(types::cat4("store i64 ", r2.as_str(), ", ptr ", lp2.as_str()).as_str());
                return CVal::Unit;
            }
            if m == "push" && mc.args.len() == 1 {
                let x0: CVal = self.expr(&mc.args[0], ck, tb, f - 1);
                let x: CVal = self.detach(x0);
                let lp3: String = self.vec_field(hdr.as_str(), 1);
                let cp: String = self.vec_field(hdr.as_str(), 2);
                let len3: String = self.t();
                let cap: String = self.t();
                let full: String = self.t();
                self.emit(types::cat3(len3.as_str(), " = load i64, ptr ", lp3.as_str()).as_str());
                self.emit(types::cat3(cap.as_str(), " = load i64, ptr ", cp.as_str()).as_str());
                self.emit(types::cat5(full.as_str(), " = icmp eq i64 ", len3.as_str(), ", ", cap.as_str()).as_str());
                let grow: String = self.l("grow");
                let put: String = self.l("put");
                self.emit(types::cat7("br i1 ", full.as_str(), ", label %", grow.as_str(), ", label %", put.as_str(), "").as_str());
                self.block(grow.as_str());
                self.emit(types::cat5("call void @bmb_vec_grow(ptr ", hdr.as_str(), ", i64 ", size_of(&el).as_str(), ")").as_str());
                self.emit(types::cat2("br label %", put.as_str()).as_str());
                self.block(put.as_str());
                let buf3: String = self.t();
                self.emit(types::cat3(buf3.as_str(), " = load ptr, ptr ", hdr.as_str()).as_str());
                let p3: String = self.t();
                self.emit(types::cat7(p3.as_str(), " = getelementptr inbounds ", mem_ty(&el).as_str(), ", ptr ", buf3.as_str(), ", i64 ", len3.as_str()).as_str());
                self.put(&x, p3.as_str(), &el);
                let n3: String = self.t();
                self.emit(types::cat4(n3.as_str(), " = add nuw i64 ", len3.as_str(), ", 1").as_str());
                self.emit(types::cat4("store i64 ", n3.as_str(), ", ptr ", lp3.as_str()).as_str());
                return CVal::Unit;
            }
            if m == "pop" {
                let ot: ast::TypeKind = self.ty(e, tb);
                if !is_data(&ot) {
                    return self.todo_expr("a `pop` whose type is not known", e);
                }
                let out: String = self.temp(&ot);
                let lp4: String = self.vec_field(hdr.as_str(), 1);
                let len4: String = self.t();
                let some: String = self.t();
                self.emit(types::cat3(len4.as_str(), " = load i64, ptr ", lp4.as_str()).as_str());
                self.emit(types::cat4(some.as_str(), " = icmp ne i64 ", len4.as_str(), ", 0").as_str());
                let tag: String = self.field_ptr(out.as_str(), &ot, 0);
                let k4: String = self.t();
                self.emit(types::cat4(k4.as_str(), " = zext i1 ", some.as_str(), " to i64").as_str());
                self.emit(types::cat4("store i64 ", k4.as_str(), ", ptr ", tag.as_str()).as_str());
                let take: String = self.l("pop");
                let done: String = self.l("popped");
                self.emit(types::cat7("br i1 ", some.as_str(), ", label %", take.as_str(), ", label %", done.as_str(), "").as_str());
                self.block(take.as_str());
                let last: String = self.t();
                self.emit(types::cat4(last.as_str(), " = sub nuw i64 ", len4.as_str(), ", 1").as_str());
                self.emit(types::cat4("store i64 ", last.as_str(), ", ptr ", lp4.as_str()).as_str());
                let buf4: String = self.t();
                self.emit(types::cat3(buf4.as_str(), " = load ptr, ptr ", hdr.as_str()).as_str());
                let src: String = self.t();
                self.emit(types::cat7(src.as_str(), " = getelementptr inbounds ", mem_ty(&el).as_str(), ", ptr ", buf4.as_str(), ", i64 ", last.as_str()).as_str());
                let dst4: String = self.t();
                self.emit(types::cat5(dst4.as_str(), " = getelementptr inbounds ", view_ty(&ot, "Some").as_str(), ", ptr ", types::cat2(out.as_str(), ", i32 0, i32 1").as_str()).as_str());
                self.copy(dst4.as_str(), src.as_str(), &el);
                self.emit(types::cat2("br label %", done.as_str()).as_str());
                self.block(done.as_str());
                return CVal::Ptr(out, ot);
            }
            self.todo_expr("a `Vec` method that is not ported", e)
        }

        #[summary("Vec::new()와 Vec::with_capacity(n), String의 것도 (stage0 vec_new): 용량이 최대 길이 안인지 재고 버퍼를 잡는다")]
        #[effects(alloc)]
        fn vec_new(self: &mut Gen, e: &ast::Expr, c: &ast::Call, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> CVal
            decreases f,
        {
            if f == 0 {
                return self.todo_expr("nesting too deep", e);
            }
            let t: ast::TypeKind = self.ty(e, tb);
            if !body::is_vec(&t) {
                return self.todo_expr("a `Vec::new` whose type is not a `Vec`", e);
            }
            let el: ast::TypeKind = elem_of(&t);
            let hdr: String = self.temp(&t);
            let n: String = if c.args.len() > 0 {
                let nv: String = imm(&self.expr(&c.args[0], ck, tb, f - 1));
                let cc: String = self.t();
                self.emit(types::cat5(cc.as_str(), " = icmp ule i64 ", nv.as_str(), ", ", vec_len_max(&el).as_str()).as_str());
                self.check(cc.as_str(), "the capacity may exceed the maximum length");
                nv
            } else {
                String::from("0")
            };
            self.emit(types::cat7("call void @bmb_vec_alloc(ptr ", hdr.as_str(), ", i64 ", n.as_str(), ", i64 ", size_of(&el).as_str(), ")").as_str());
            CVal::Ptr(hdr, t)
        }

        #[summary("e가 Vec인 지역 변수나 매개변수를 이름하는가 (stage0 vec_var): 대입의 대상은 타입의 기록이 없다")]
        #[effects(alloc)]
        fn vec_var(self: &Gen, e: &ast::Expr) -> bool {
            match var_name(e) {
                None => false,
                Some(n) => { match self.data_slot(n.as_str()) { None => false, Some(sl) => is_vec(&sl.ty), } },
            }
        }

        #[summary("Vec의 머리 hdr의 버퍼와 길이를 지금 읽는다 (stage0 vec_view): push가 버퍼를 옮길 수 있다")]
        #[effects(alloc)]
        fn vec_view(self: &mut Gen, hdr: &str) -> CVal {
            let buf: String = self.t();
            self.emit(types::cat3(buf.as_str(), " = load ptr, ptr ", hdr).as_str());
            let lp: String = self.vec_field(hdr, 1);
            let len: String = self.t();
            self.emit(types::cat3(len.as_str(), " = load i64, ptr ", lp.as_str()).as_str());
            CVal::Arr(buf, len)
        }

        #[summary("while 문장 (stage0 stmt의 While)")]
        #[effects(alloc)]
        fn while_stmt(self: &mut Gen, x: &ast::While, ck: &body::Checked, tb: &lowered::Tables, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                self.todo_at("nesting too deep", x.span);
                return;
            }
            let head: String = self.l("while");
            let lb: String = self.l("body");
            let end: String = self.l("endwhile");
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(head.as_str());
            let c: String = imm(&self.region_expr(&x.cond, ck, tb, f - 1));
            self.emit(types::cat7("br i1 ", c.as_str(), ", label %", lb.as_str(), ", label %", end.as_str(), "").as_str());
            self.block(lb.as_str());
            let depth: usize = self.loops.len();
            self.loops.push(GLoop { label: label_name(&x.label), head: head.clone(), end: end.clone(), slot: None, ty: ast::TypeKind::Unit, mark: self.pending.len() });
            let body_v: CVal = self.block_expr(&x.body, ck, tb, f - 1);
            self.loops.truncate(depth);
            self.emit(types::cat2("br label %", head.as_str()).as_str());
            self.block(end.as_str());
        }

        #[summary("any_place의 자리에 값을 쓴다 (stage0 write_any): 덩어리는 옮긴다")]
        #[effects(alloc)]
        fn write_any(self: &mut Gen, p: &AnyPlace, v: &CVal) -> () {
            if p.reg.len() > 0 {
                self.emit(types::cat7("store ", p.reg.as_str(), " ", imm(v).as_str(), ", ptr ", p.ptr.as_str(), "").as_str());
            } else {
                self.put(v, p.ptr.as_str(), &p.ty);
            }
        }
    }

    #[summary("메모리에서의 크기와 정렬 (x86-64의 C 배치)")]
    struct Lay { size: u64, align: u64 }

    #[summary("모듈 (stage0 Module): IR의 글, 진입점, 옮기지 않은 구문을 만난 까닭들")]
    struct Module { ir: String, main: Option<String>, todo: Vec<String> }

    #[summary("힙 메모리를 가진 임시값 (stage0 Gen.pending의 한 칸): 주소와 타입. 읽히기만 하고 옮겨지지 않았으니 그 구역이 끝날 때 놓는다")]
    struct Pend { ptr: String, ty: ast::TypeKind }

    #[summary("자리 (stage0 place의 결과): 주소와 타입. ok가 거짓이면 옮기지 않은 자리다")]
    struct Place { ptr: String, ty: ast::TypeKind, ok: bool }

    #[summary("스칼라 지역 변수의 자리: 자리의 이름과 레지스터 타입")]
    struct ScalarSlot { ptr: String, ty: String }

    #[summary("지역 이름의 자리 (stage0 Slot). 스칼라: 자리의 이름과 레지스터 타입. 배열과 슬라이스: ArrSlot. 구조체와 열거형: DataSlot")]
    enum Slot { Scalar(String, String), Arr(ArrSlot), Data(DataSlot) }

    #[summary("원소 종류 elem의 메모리 정렬 (stage0 align): i1은 1, 좁은 정수는 제 폭, 나머지는 8")]
    #[effects(pure)]
    fn align(elem: &str) -> u32 {
        if elem == "i1" {
            return 1;
        }
        let b: u32 = narrow_bits(elem);
        if b == 0 {
            8
        } else {
            b / 8
        }
    }

    #[summary("bits 비트가 모두 1인 수의 글 (2^bits - 1)")]
    #[effects(alloc)]
    fn all_ones(bits: u32) -> String {
        if bits == 8 {
            return String::from("255");
        }
        if bits == 16 {
            return String::from("65535");
        }
        if bits == 32 {
            return String::from("4294967295");
        }
        String::from("18446744073709551615")
    }

    #[summary("프로그램의 값들의 타입 (stage0 all_types): 식, 지역 변수, 내장이 아닌 함수의 시그니처에 나오는 타입을 한 번씩, 타입의 글 순서로 (소스의 자리 순서가 아니다: fmt 전후의 IR이 같다, 백로그 4D-38)")]
    #[effects(alloc)]
    fn all_types(tb: &lowered::Tables) -> Vec<ast::TypeKind> {
        let mut by_text: table::Table<ast::TypeKind> = table::new::<ast::TypeKind>();
        for n in 0..tb.types.len()
            invariant 0 <= n,
        {
            match tb.types.nth(n) {
                None => {},
                Some(at) => by_text.insert(types::text(&tb.types.items[at]).as_str(), tb.types.items[at].clone()),
            }
        }
        for n in 0..tb.locals.len()
            invariant 0 <= n,
        {
            match tb.locals.nth(n) {
                None => {},
                Some(at) => { for v in 0..tb.locals.items[at].len() invariant 0 <= v, { match tb.locals.items[at].nth(v) { None => {}, Some(i) => by_text.insert(types::text(&tb.locals.items[at].items[i]).as_str(), tb.locals.items[at].items[i].clone()), } } },
            }
        }
        for n in 0..tb.fns.len()
            invariant 0 <= n,
        {
            match tb.fns.nth(n) {
                None => {},
                Some(at) => { if !tb.fns.items[at].builtin { for k in 0..tb.fns.items[at].params.len() invariant 0 <= k && k <= tb.fns.items[at].params.len(), { by_text.insert(types::text(&tb.fns.items[at].params[k]).as_str(), tb.fns.items[at].params[k].clone()); } by_text.insert(types::text(&tb.fns.items[at].ret).as_str(), tb.fns.items[at].ret.clone()); } },
            }
        }
        let mut all: Vec<ast::TypeKind> = Vec::new();
        for n in 0..by_text.len()
            invariant 0 <= n,
        {
            match by_text.nth(n) {
                None => {},
                Some(at) => all.push(by_text.items[at].clone()),
            }
        }
        all
    }

    #[summary("배열 값의 길이의 글. 배열 값이 아니면 undef")]
    #[effects(alloc)]
    fn arr_len(v: &CVal) -> String {
        match v {
            CVal::Imm(al_x) => String::from("undef"),
            CVal::Arr(p, n) => n.clone(),
            CVal::Ptr(al_q, al_t) => String::from("undef"),
            CVal::Unit => String::from("undef"),
            CVal::Never => String::from("undef"),
        }
    }

    #[summary("배열 값의 첫 원소의 주소. 배열 값이 아니면 undef")]
    #[effects(alloc)]
    fn arr_ptr(v: &CVal) -> String {
        match v {
            CVal::Imm(ap_x) => String::from("undef"),
            CVal::Arr(p, n) => p.clone(),
            CVal::Ptr(ap_q, ap_t) => String::from("undef"),
            CVal::Unit => String::from("undef"),
            CVal::Never => String::from("undef"),
        }
    }

    #[summary("배열 타입의 길이의 글. 배열 타입이 아니면 0")]
    #[effects(alloc)]
    fn array_len_text(t: &ast::TypeKind) -> String {
        let mut s: String = String::new();
        match t {
            ast::TypeKind::Int(alt_int0) => s.push_str("0"),
            ast::TypeKind::F64 => s.push_str("0"),
            ast::TypeKind::Bool => s.push_str("0"),
            ast::TypeKind::Unit => s.push_str("0"),
            ast::TypeKind::Char => s.push_str("0"),
            ast::TypeKind::String => s.push_str("0"),
            ast::TypeKind::Str => s.push_str("0"),
            ast::TypeKind::Array(alt_e, n) => std::num::push_u64(&mut s, *n),
            ast::TypeKind::ArrayN(alt_arrayn0, alt_arrayn1) => s.push_str("0"),
            ast::TypeKind::Slice(alt_slice0) => s.push_str("0"),
            ast::TypeKind::Ref(alt_ref0, alt_ref1) => s.push_str("0"),
            ast::TypeKind::Named(alt_named0, alt_named1) => s.push_str("0"),
            ast::TypeKind::Vec(alt_vec0) => s.push_str("0"),
            ast::TypeKind::Box(alt_box0) => s.push_str("0"),
            ast::TypeKind::Param(alt_param0) => s.push_str("0"),
            ast::TypeKind::Never => s.push_str("0"),
            ast::TypeKind::Error => s.push_str("0"),
        }
        s
    }

    #[summary("재귀가 있는 프로그램의 스택 (stage0 sys::big_stack, ADR-0091 §5): main을 256 MiB 스택의 스레드에서 돌리고 기다린다. 스레드가 뜨지 않으면 프로세스의 스택에서 돌린다")]
    #[effects(alloc)]
    fn big_stack(main: &str) -> String {
        let mut s: String = String::from("declare i32 @pthread_attr_init(ptr)\ndeclare i32 @pthread_attr_setstacksize(ptr, i64)\ndeclare i32 @pthread_create(ptr, ptr, ptr, ptr)\ndeclare i32 @pthread_join(i64, ptr)\ndefine internal ptr @bmb_main_thread(ptr %u) {\n  call void ");
        s.push_str(main);
        s.push_str("()\n  ret ptr null\n}\ndefine internal void @bmb_big_stack() {\nentry:\n  %attr = alloca [64 x i8]\n  call i32 @pthread_attr_init(ptr %attr)\n  call i32 @pthread_attr_setstacksize(ptr %attr, i64 268435456)\n  %t = alloca i64\n  %rc = call i32 @pthread_create(ptr %t, ptr %attr, ptr @bmb_main_thread, ptr null)\n  %fail = icmp ne i32 %rc, 0\n  br i1 %fail, label %direct, label %join\ndirect:\n  call void ");
        s.push_str(main);
        s.push_str("()\n  ret void\njoin:\n  %tv = load i64, ptr %t\n  call i32 @pthread_join(i64 %tv, ptr null)\n  ret void\n}\n");
        s
    }

    #[summary("비트 연산의 명령: and, or, xor")]
    #[effects(alloc)]
    fn bit_inst(op: ast::BinOp) -> String {
        match op {
            ast::BinOp::Add => String::from("xor"),
            ast::BinOp::Sub => String::from("xor"),
            ast::BinOp::Mul => String::from("xor"),
            ast::BinOp::Div => String::from("xor"),
            ast::BinOp::Rem => String::from("xor"),
            ast::BinOp::Eq => String::from("xor"),
            ast::BinOp::Ne => String::from("xor"),
            ast::BinOp::Lt => String::from("xor"),
            ast::BinOp::Le => String::from("xor"),
            ast::BinOp::Gt => String::from("xor"),
            ast::BinOp::Ge => String::from("xor"),
            ast::BinOp::And => String::from("xor"),
            ast::BinOp::Or => String::from("xor"),
            ast::BinOp::Implies => String::from("xor"),
            ast::BinOp::BitAnd => String::from("and"),
            ast::BinOp::BitOr => String::from("or"),
            ast::BinOp::BitXor => String::from("xor"),
            ast::BinOp::Shl => String::from("xor"),
            ast::BinOp::Shr => String::from("xor"),
        }
    }

    #[summary("복제 코드의 원소마다 도는 루프 (stage0 clone_glue의 each): n개의 원소를 dp와 sp에서 가리켜 e의 복제 코드를 부른다")]
    #[effects(alloc)]
    fn clone_each(n: &str, dp: &str, sp: &str, e: &ast::TypeKind) -> String {
        let mut s: String = String::from("  br label %head\nhead:\n  %i = phi i64 [ 0, %entry ], [ %j, %body ]\n  %more = icmp ult i64 %i, ");
        s.push_str(n);
        s.push_str("\n  br i1 %more, label %body, label %done\nbody:\n  %de = getelementptr inbounds ");
        s.push_str(dp);
        s.push_str(", i64 %i\n  %se = getelementptr inbounds ");
        s.push_str(sp);
        s.push_str(", i64 %i\n  call void ");
        s.push_str(clone_name(e).as_str());
        s.push_str("(ptr %de, ptr %se)\n  %j = add nuw i64 %i, 1\n  br label %head\ndone:\n");
        s
    }

    #[summary("프로그램이 복제하는 타입과 그것이 든 타입의 복제 코드 (stage0 clone_glue, ADR-0141 §4): @\"bmb_clone.<타입>\"(ptr %dst, ptr %src)가 %src의 값과 같고 제 메모리를 가진 값을 %dst에 짓는다. called는 함수들이 복제 코드를 부른 타입의 글들")]
    #[effects(alloc)]
    fn clone_glue(tb: &lowered::Tables, called: &[String]) -> String {
        let mut seen: Vec<String> = Vec::new();
        let mut out: String = String::new();
        if called.len() == 0 {
            return out;
        }
        let all: Vec<ast::TypeKind> = all_types(tb);
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            let vt: ast::TypeKind = lowered::value_ty(&all[i]);
            if types::has(called, types::text(&vt).as_str()) {
                clone_visit(&vt, tb, &mut seen, &mut out, 100000);
            }
        }
        out
    }

    #[summary("타입 t의 복제 코드의 이름 (stage0 clone_glue_name)")]
    #[effects(alloc)]
    fn clone_name(t: &ast::TypeKind) -> String {
        types::cat3("@\"bmb_clone.", types::text(t).as_str(), "\"")
    }

    #[summary("clone_glue의 한 타입: 바이트를 옮기고, 메모리를 가진 부분을 다시 짓는다. 그것이 부르는 타입들로 내려간다")]
    #[effects(alloc)]
    fn clone_visit(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, out: &mut String, f: usize) -> ()
        decreases f,
    {
        let none: Vec<String> = Vec::new();
        let name: String = types::text(t);
        if f == 0 || !types::is_move_in(t, &tb.adts, none.as_slice()) || types::has(seen.as_slice(), name.as_str()) {
            return;
        }
        seen.push(name);
        let mut text: String = String::new();
        let mut inner: Vec<ast::TypeKind> = Vec::new();
        if body::is_array(t) {
            let ae: ast::TypeKind = elem_of(t);
            let m: String = mem_ty(t);
            text.push_str(clone_each(array_len_text(t).as_str(), types::cat2(m.as_str(), ", ptr %dst, i64 0").as_str(), types::cat2(m.as_str(), ", ptr %src, i64 0").as_str(), &ae).as_str());
            inner.push(ae.clone());
        } else if body::is_vec(t) {
            let ve: ast::TypeKind = elem_of(t);
            text.push_str(types::cat3("  call void @bmb_vec_clone(ptr %dst, ptr %src, i64 ", size_of(&ve).as_str(), ")\n").as_str());
            if types::is_move_in(&ve, &tb.adts, none.as_slice()) {
                let vm: String = mem_ty(&ve);
                text.push_str("  %db = load ptr, ptr %dst\n  %sb = load ptr, ptr %src\n  %lp = getelementptr inbounds %bmb.vec, ptr %src, i32 0, i32 1\n  %n = load i64, ptr %lp\n");
                text.push_str(clone_each("%n", types::cat2(vm.as_str(), ", ptr %db").as_str(), types::cat2(vm.as_str(), ", ptr %sb").as_str(), &ve).as_str());
                inner.push(ve.clone());
            }
        } else if body::is_box(t) {
            match body::box_inner(t) {
                None => {},
                Some(be) => { text.push_str(types::cat3("  %h = load ptr, ptr %src\n  %n = call ptr @bmb_box_alloc(i64 ", size_of(&be).as_str(), ")\n").as_str()); if types::is_move_in(&be, &tb.adts, none.as_slice()) { text.push_str(types::cat3("  call void ", clone_name(&be).as_str(), "(ptr %n, ptr %h)\n").as_str()); inner.push(be.clone()); } else { text.push_str(types::cat3("  call void @llvm.memcpy.p0.p0.i64(ptr %n, ptr %h, i64 ", size_of(&be).as_str(), ", i1 false)\n").as_str()); } text.push_str("  store ptr %n, ptr %dst\n"); },
            }
        } else {
            text.push_str(types::cat3("  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %src, i64 ", size_of(t).as_str(), ", i1 false)\n").as_str());
            match lowered::struct_fields(t, tb) {
                None => { let vs: Vec<types::VariantSig> = match lowered::enum_variants(t, tb) { None => Vec::new(), Some(found) => found, }; text.push_str("  %tag = load i64, ptr %src\n"); let mut cases: String = String::new(); let mut arms: String = String::new(); for k in 0..vs.len() invariant 0 <= k && k <= vs.len(), { let mut any: bool = false; for j in 0..vs[k].tys.len() invariant 0 <= j && j <= vs[k].tys.len(), { if types::is_move_in(&vs[k].tys[j], &tb.adts, none.as_slice()) { any = true; } } if any { let mut kt2: String = String::new(); std::num::push_u64(&mut kt2, k as u64); cases.push_str(types::cat4(" i64 ", kt2.as_str(), ", label %v", kt2.as_str()).as_str()); arms.push_str(types::cat3("v", kt2.as_str(), ":\n").as_str()); let w: String = view_ty(t, vs[k].name.as_str()); for j2 in 0..vs[k].tys.len() invariant 0 <= j2 && j2 <= vs[k].tys.len(), { if types::is_move_in(&vs[k].tys[j2], &tb.adts, none.as_slice()) { let mut jt: String = String::new(); std::num::push_u64(&mut jt, j2 as u64); let mut j1: String = String::new(); std::num::push_u64(&mut j1, (j2 as u64).wrapping_add(1)); let dreg: String = types::cat4("%d", kt2.as_str(), ".", jt.as_str()); let sreg: String = types::cat4("%s", kt2.as_str(), ".", jt.as_str()); arms.push_str(types::cat7("  ", dreg.as_str(), " = getelementptr inbounds ", w.as_str(), ", ptr %dst, i32 0, i32 ", j1.as_str(), "\n").as_str()); arms.push_str(types::cat7("  ", sreg.as_str(), " = getelementptr inbounds ", w.as_str(), ", ptr %src, i32 0, i32 ", j1.as_str(), "\n").as_str()); arms.push_str(types::cat7("  call void ", clone_name(&vs[k].tys[j2]).as_str(), "(ptr ", dreg.as_str(), ", ptr ", sreg.as_str(), ")\n").as_str()); inner.push(vs[k].tys[j2].clone()); } } arms.push_str("  br label %done\n"); } } text.push_str(types::cat5("  switch i64 %tag, label %done [", cases.as_str(), " ]\n", arms.as_str(), "done:\n").as_str()); },
                Some(fs) => { let d: String = data_ty(t); for k3 in 0..fs.len() invariant 0 <= k3 && k3 <= fs.len(), { if types::is_move_in(&fs[k3].ty, &tb.adts, none.as_slice()) { let mut kt: String = String::new(); std::num::push_u64(&mut kt, k3 as u64); text.push_str(types::cat7("  %d", kt.as_str(), " = getelementptr inbounds ", d.as_str(), ", ptr %dst, i32 0, i32 ", kt.as_str(), "\n").as_str()); text.push_str(types::cat7("  %s", kt.as_str(), " = getelementptr inbounds ", d.as_str(), ", ptr %src, i32 0, i32 ", kt.as_str(), "\n").as_str()); text.push_str(types::cat7("  call void ", clone_name(&fs[k3].ty).as_str(), "(ptr %d", kt.as_str(), ", ptr %s", kt.as_str(), ")\n").as_str()); inner.push(fs[k3].ty.clone()); } } },
            }
        }
        out.push_str(types::cat5("define internal void ", clone_name(t).as_str(), "(ptr %dst, ptr %src) {\nentry:\n", text.as_str(), "  ret void\n}\n").as_str());
        for x in 0..inner.len()
            invariant 0 <= x && x <= inner.len(),
        {
            clone_visit(&inner[x], tb, seen, out, f - 1);
        }
    }

    #[summary("상수 원소 하나 (stage0 const_elems의 한 원소): 정수 리터럴과 그 부호 바꿈 (i128에 드는 것), bool, char, 바이트 리터럴. 아니면 None")]
    #[effects(alloc)]
    fn const_elem(e: &ast::Expr) -> Option<ConstElem> {
        match &e.kind {
            ast::ExprKind::Int(v, ce_r) => { if v.hi < 9223372036854775808 { Some(ConstElem { neg: false, mag: v.lo }) } else { None } },
            ast::ExprKind::Float(ce_float0) => None,
            ast::ExprKind::ByteLit(b) => Some(ConstElem { neg: false, mag: *b as u64 }),
            ast::ExprKind::ByteStr(ce_bytestr0) => None,
            ast::ExprKind::StrLit(ce_strlit0) => None,
            ast::ExprKind::CharLit(c) => Some(ConstElem { neg: false, mag: *c as u64 }),
            ast::ExprKind::Bool(on) => { if *on { Some(ConstElem { neg: false, mag: 1 }) } else { Some(ConstElem { neg: false, mag: 0 }) } },
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(ce_var0) => None,
            ast::ExprKind::Call(ce_call0) => None,
            ast::ExprKind::Method(ce_method0) => None,
            ast::ExprKind::Index(ce_index0, ce_index1) => None,
            ast::ExprKind::Unary(op, x) => { if is_neg(*op) { match int_lit(&**x) { None => None, Some(k) => { if k.hi < 9223372036854775808 { Some(ConstElem { neg: true, mag: k.lo }) } else { None } }, } } else { None } },
            ast::ExprKind::Binary(ce_binary0, ce_binary1, ce_binary2) => None,
            ast::ExprKind::Ref(ce_ref0, ce_ref1) => None,
            ast::ExprKind::If(ce_if0) => None,
            ast::ExprKind::Block(ce_block0) => None,
            ast::ExprKind::Array(ce_array0) => None,
            ast::ExprKind::Repeat(ce_repeat0) => None,
            ast::ExprKind::Old(ce_old0) => None,
            ast::ExprKind::Quant(ce_quant0) => None,
            ast::ExprKind::Trigger(ce_trigger0) => None,
            ast::ExprKind::Closure(ce_closure0) => None,
            ast::ExprKind::StructLit(ce_structlit0) => None,
            ast::ExprKind::Path(ce_path0) => None,
            ast::ExprKind::Deref(ce_deref0) => None,
            ast::ExprKind::Field(ce_field0, ce_field1) => None,
            ast::ExprKind::Match(ce_match0) => None,
            ast::ExprKind::Return(ce_return0) => None,
            ast::ExprKind::Try(ce_try0) => None,
            ast::ExprKind::Loop(ce_loop0) => None,
            ast::ExprKind::Break(ce_break0) => None,
            ast::ExprKind::Continue(ce_continue0) => None,
            ast::ExprKind::Range(ce_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("배열 리터럴의 원소가 모두 상수면 그 값들 (stage0 const_elems)")]
    #[effects(alloc)]
    fn const_elems(items: &[ast::Expr]) -> Option<Vec<ConstElem>> {
        let mut out: Vec<ConstElem> = Vec::new();
        for i in 0..items.len()
            invariant 0 <= i && i <= items.len(),
        {
            match const_elem(&items[i]) {
                None => { return None; },
                Some(c) => out.push(c),
            }
        }
        Some(out)
    }

    #[summary("상수 원소의 글 (stage0 init_array의 상수 갈래): bits 비트로 감은 값을 부호 있는 수로 적는다")]
    #[effects(alloc)]
    fn const_text(c: &ConstElem, bits: u32) -> String {
        let raw: u64 = if c.neg {
            (0 as u64).wrapping_sub(c.mag)
        } else {
            c.mag
        };
        let mut s: String = String::new();
        if bits >= 64 {
            if raw >= 9223372036854775808 {
                s.push_str("-");
                std::num::push_u64(&mut s, (0 as u64).wrapping_sub(raw));
            } else {
                std::num::push_u64(&mut s, raw);
            }
            return s;
        }
        let mask: u64 = if bits == 8 {
            255
        } else if bits == 16 {
            65535
        } else {
            4294967295
        };
        let r: u64 = raw & mask;
        let half: u64 = (mask / 2).wrapping_add(1);
        if r >= half {
            s.push_str("-");
            std::num::push_u64(&mut s, mask.wrapping_sub(r).wrapping_add(1));
        } else {
            std::num::push_u64(&mut s, r);
        }
        s
    }

    #[summary("e가 T::try_from(x)면 (T는 정수 타입) T와 x (stage0 check::conv_call)")]
    #[effects(alloc)]
    fn conv_parts(e: &ast::Expr) -> Option<Conv> {
        match &e.kind {
            ast::ExprKind::Int(cp_int0, cp_int1) => None,
            ast::ExprKind::Float(cp_float0) => None,
            ast::ExprKind::ByteLit(cp_bytelit0) => None,
            ast::ExprKind::ByteStr(cp_bytestr0) => None,
            ast::ExprKind::StrLit(cp_strlit0) => None,
            ast::ExprKind::CharLit(cp_charlit0) => None,
            ast::ExprKind::Bool(cp_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(cp_var0) => None,
            ast::ExprKind::Call(c) => { if c.path.len() == 2 && c.path[1].name == "try_from" && c.args.len() == 1 { match ast::int_of(c.path[0].name.as_str()) { None => None, Some(i) => Some(Conv { target: i, arg: c.args[0].clone() }), } } else { None } },
            ast::ExprKind::Method(cp_method0) => None,
            ast::ExprKind::Index(cp_index0, cp_index1) => None,
            ast::ExprKind::Unary(cp_unary0, cp_unary1) => None,
            ast::ExprKind::Binary(cp_binary0, cp_binary1, cp_binary2) => None,
            ast::ExprKind::Ref(cp_ref0, cp_ref1) => None,
            ast::ExprKind::If(cp_if0) => None,
            ast::ExprKind::Block(cp_block0) => None,
            ast::ExprKind::Array(cp_array0) => None,
            ast::ExprKind::Repeat(cp_repeat0) => None,
            ast::ExprKind::Old(cp_old0) => None,
            ast::ExprKind::Quant(cp_quant0) => None,
            ast::ExprKind::Trigger(cp_trigger0) => None,
            ast::ExprKind::Closure(cp_closure0) => None,
            ast::ExprKind::StructLit(cp_structlit0) => None,
            ast::ExprKind::Path(cp_path0) => None,
            ast::ExprKind::Deref(cp_deref0) => None,
            ast::ExprKind::Field(cp_field0, cp_field1) => None,
            ast::ExprKind::Match(cp_match0) => None,
            ast::ExprKind::Return(cp_return0) => None,
            ast::ExprKind::Try(cp_try0) => None,
            ast::ExprKind::Loop(cp_loop0) => None,
            ast::ExprKind::Break(cp_break0) => None,
            ast::ExprKind::Continue(cp_continue0) => None,
            ast::ExprKind::Range(cp_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("구조체나 열거형의 LLVM 타입 (stage0 data_ty): %\"geo::Point\"")]
    #[effects(alloc)]
    fn data_ty(t: &ast::TypeKind) -> String {
        types::cat3("%\"", types::text(&lowered::value_ty(t)).as_str(), "\"")
    }

    #[summary("십진수의 글의 값 (넘치면 감긴다). 숫자가 아닌 글자가 있으면 0 (stage0의 parse().unwrap_or(0))")]
    #[effects(pure)]
    fn dec(s: &str) -> u64 {
        let mut v: u64 = 0;
        for i in 0..s.len()
            invariant 0 <= i && i <= s.len(),
        {
            let b: u8 = s.as_bytes()[i];
            if b < 48 || b > 57 {
                return 0;
            }
            v = v.wrapping_mul(10).wrapping_add((b - 48) as u64);
        }
        v
    }

    #[summary("힙 메모리를 가진 모든 타입의 놓는 코드 (stage0 drop_glue, ADR-0047 §4): @\"bmb_drop.<타입>\"(ptr %p)가 %p의 값을 놓는다. Vec은 원소들과 버퍼, Box는 값과 메모리, 구조체는 필드를 선언 순서로, 열거형은 제 변형의 페이로드를 차례로")]
    #[effects(alloc)]
    fn drop_glue(tb: &lowered::Tables, todo: &mut Vec<String>) -> String {
        let mut seen: Vec<String> = Vec::new();
        let mut out: String = String::new();
        let all: Vec<ast::TypeKind> = all_types(tb);
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            drop_visit(&all[i], tb, &mut seen, &mut out, todo, 100000);
        }
        out
    }

    #[summary("drop_glue의 한 타입: 제 코드를 내고, 그것이 부르는 타입들로 내려간다")]
    #[effects(alloc)]
    fn drop_visit(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, out: &mut String, todo: &mut Vec<String>, f: usize) -> ()
        decreases f,
    {
        if f == 0 || body::has_param(t, 100000) {
            return;
        }
        match body::slice_elem(t) {
            None => {},
            Some(se) => { drop_visit(&se, tb, seen, out, todo, f - 1); return; },
        }
        match body::ref_inner(t) {
            None => {},
            Some(ri) => { drop_visit(&ri, tb, seen, out, todo, f - 1); return; },
        }
        if !body::is_vec(t) && !body::is_box(t) && !body::is_named(t) && !body::is_array(t) {
            return;
        }
        let none: Vec<String> = Vec::new();
        let name: String = types::text(t);
        if !types::is_move_in(t, &tb.adts, none.as_slice()) || types::has(seen.as_slice(), name.as_str()) {
            return;
        }
        seen.push(name);
        let mut text: String = String::new();
        let mut inner: Vec<ast::TypeKind> = Vec::new();
        let each: String = String::from("  br i1 %more, label %body, label %done\nbody:\n");
        if body::is_array(t) {
            let ae: ast::TypeKind = elem_of(t);
            text.push_str("  br label %head\nhead:\n  %i = phi i64 [ 0, %entry ], [ %j, %body ]\n  %more = icmp ult i64 %i, ");
            text.push_str(array_len_text(t).as_str());
            text.push_str("\n");
            text.push_str(each.as_str());
            text.push_str(types::cat5("  %ep = getelementptr inbounds ", mem_ty(t).as_str(), ", ptr %p, i64 0, i64 %i\n  call void ", glue(&ae).as_str(), "(ptr %ep)\n  %j = add nuw i64 %i, 1\n  br label %head\ndone:\n").as_str());
            inner.push(ae);
        } else if body::is_vec(t) {
            let ve: ast::TypeKind = elem_of(t);
            if types::is_move_in(&ve, &tb.adts, none.as_slice()) {
                text.push_str("  %b0 = load ptr, ptr %p\n  %lp = getelementptr inbounds %bmb.vec, ptr %p, i32 0, i32 1\n  %n = load i64, ptr %lp\n  br label %head\nhead:\n  %i = phi i64 [ 0, %entry ], [ %j, %body ]\n  %more = icmp ult i64 %i, %n\n");
                text.push_str(each.as_str());
                text.push_str(types::cat5("  %ep = getelementptr inbounds ", mem_ty(&ve).as_str(), ", ptr %b0, i64 %i\n  call void ", glue(&ve).as_str(), "(ptr %ep)\n  %j = add nuw i64 %i, 1\n  br label %head\ndone:\n").as_str());
                inner.push(ve.clone());
            }
            text.push_str("  %b = load ptr, ptr %p\n  call void @free(ptr %b)\n");
        } else if body::is_box(t) {
            text.push_str("  %h = load ptr, ptr %p\n");
            match body::box_inner(t) {
                None => {},
                Some(be) => { if types::is_move_in(&be, &tb.adts, none.as_slice()) { text.push_str(types::cat3("  call void ", glue(&be).as_str(), "(ptr %h)\n").as_str()); inner.push(be.clone()); } },
            }
            text.push_str("  call void @free(ptr %h)\n");
        } else if body::is_child(t) {
            todo.push(String::from("a child process value (the system interface)"));
        } else {
            match lowered::struct_fields(t, tb) {
                None => { let vs: Vec<types::VariantSig> = match lowered::enum_variants(t, tb) { None => Vec::new(), Some(found) => found, }; text.push_str("  %tag = load i64, ptr %p\n"); let mut cases: String = String::new(); let mut arms: String = String::new(); for k in 0..vs.len() invariant 0 <= k && k <= vs.len(), { let mut any: bool = false; for j in 0..vs[k].tys.len() invariant 0 <= j && j <= vs[k].tys.len(), { if types::is_move_in(&vs[k].tys[j], &tb.adts, none.as_slice()) { any = true; } } if any { let mut kt2: String = String::new(); std::num::push_u64(&mut kt2, k as u64); cases.push_str(types::cat4(" i64 ", kt2.as_str(), ", label %v", kt2.as_str()).as_str()); arms.push_str(types::cat3("v", kt2.as_str(), ":\n").as_str()); for j2 in 0..vs[k].tys.len() invariant 0 <= j2 && j2 <= vs[k].tys.len(), { if types::is_move_in(&vs[k].tys[j2], &tb.adts, none.as_slice()) { let mut jt: String = String::new(); std::num::push_u64(&mut jt, j2 as u64); let mut j1: String = String::new(); std::num::push_u64(&mut j1, (j2 as u64).wrapping_add(1)); let reg: String = types::cat4("%v", kt2.as_str(), ".", jt.as_str()); arms.push_str(types::cat7("  ", reg.as_str(), " = getelementptr inbounds ", view_ty(t, vs[k].name.as_str()).as_str(), ", ptr %p, i32 0, i32 ", j1.as_str(), "\n").as_str()); arms.push_str(types::cat5("  call void ", glue(&vs[k].tys[j2]).as_str(), "(ptr ", reg.as_str(), ")\n").as_str()); inner.push(vs[k].tys[j2].clone()); } } arms.push_str("  br label %done\n"); } } text.push_str(types::cat5("  switch i64 %tag, label %done [", cases.as_str(), " ]\n", arms.as_str(), "done:\n").as_str()); },
                Some(fs) => { for k in 0..fs.len() invariant 0 <= k && k <= fs.len(), { if types::is_move_in(&fs[k].ty, &tb.adts, none.as_slice()) { let mut kt: String = String::new(); std::num::push_u64(&mut kt, k as u64); text.push_str(types::cat7("  %f", kt.as_str(), " = getelementptr inbounds ", data_ty(t).as_str(), ", ptr %p, i32 0, i32 ", kt.as_str(), "\n").as_str()); text.push_str(types::cat5("  call void ", glue(&fs[k].ty).as_str(), "(ptr %f", kt.as_str(), ")\n").as_str()); inner.push(fs[k].ty.clone()); } } },
            }
        }
        out.push_str(types::cat5("define internal void ", glue(t).as_str(), "(ptr %p) {\nentry:\n", text.as_str(), "  ret void\n}\n").as_str());
        for x in 0..inner.len()
            invariant 0 <= x && x <= inner.len(),
        {
            drop_visit(&inner[x], tb, seen, out, todo, f - 1);
        }
    }

    #[summary("원소 종류 (stage0 elem_kind): 64비트보다 좁은 정수는 제 이름, 나머지는 레지스터 타입")]
    #[effects(alloc)]
    fn elem_kind(t: &ast::TypeKind) -> String {
        match t {
            ast::TypeKind::Int(it) => { if body::bits(*it) < 64 { body::int_text(*it) } else { llty(t) } },
            ast::TypeKind::F64 => llty(t),
            ast::TypeKind::Bool => llty(t),
            ast::TypeKind::Unit => llty(t),
            ast::TypeKind::Char => llty(t),
            ast::TypeKind::String => llty(t),
            ast::TypeKind::Str => llty(t),
            ast::TypeKind::Array(ek_array0, ek_array1) => llty(t),
            ast::TypeKind::ArrayN(ek_arrayn0, ek_arrayn1) => llty(t),
            ast::TypeKind::Slice(ek_slice0) => llty(t),
            ast::TypeKind::Ref(ek_ref0, ek_ref1) => llty(t),
            ast::TypeKind::Named(ek_named0, ek_named1) => llty(t),
            ast::TypeKind::Vec(ek_vec0) => llty(t),
            ast::TypeKind::Box(ek_box0) => llty(t),
            ast::TypeKind::Param(ek_param0) => llty(t),
            ast::TypeKind::Never => llty(t),
            ast::TypeKind::Error => llty(t),
        }
    }

    #[summary("배열, 슬라이스, Vec의 원소 타입 (stage0 elem_of). 다른 참조는 가리키는 타입, 나머지는 그대로")]
    #[effects(alloc)]
    fn elem_of(t: &ast::TypeKind) -> ast::TypeKind {
        match t {
            ast::TypeKind::Int(eo_int0) => t.clone(),
            ast::TypeKind::F64 => t.clone(),
            ast::TypeKind::Bool => t.clone(),
            ast::TypeKind::Unit => t.clone(),
            ast::TypeKind::Char => t.clone(),
            ast::TypeKind::String => t.clone(),
            ast::TypeKind::Str => t.clone(),
            ast::TypeKind::Array(ae, eo_n) => ae.kind.clone(),
            ast::TypeKind::ArrayN(eo_arrayn0, eo_arrayn1) => t.clone(),
            ast::TypeKind::Slice(eo_slice0) => t.clone(),
            ast::TypeKind::Ref(eo_m, ri) => { match body::slice_elem(&ri.kind) { None => { match body::vec_elem(&ri.kind) { None => ri.kind.clone(), Some(e2) => e2, } }, Some(e1) => e1, } },
            ast::TypeKind::Named(eo_named0, eo_named1) => t.clone(),
            ast::TypeKind::Vec(ve) => ve.kind.clone(),
            ast::TypeKind::Box(eo_box0) => t.clone(),
            ast::TypeKind::Param(eo_param0) => t.clone(),
            ast::TypeKind::Never => t.clone(),
            ast::TypeKind::Error => t.clone(),
        }
    }

    #[summary("프로그램의 모듈 (stage0 emit_with, 전체 검사 모드): 머리, 타입 정의, 제네릭 아닌 실행 함수를 경로 순서로, @main. 옮기지 않은 구문을 만나면 todo에 까닭이 남는다")]
    #[effects(alloc)]
    fn emit(ck: &body::Checked, tb: &lowered::Tables) -> Module {
        let mut todo: Vec<String> = Vec::new();
        let mut ir: String = String::new();
        let all: Vec<ast::TypeKind> = all_types(tb);
        let none: Vec<String> = Vec::new();
        let mut heap: bool = false;
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            if holds_vec(&all[i], tb) || types::is_move_in(&lowered::value_ty(&all[i]), &tb.adts, none.as_slice()) {
                heap = true;
            }
        }
        let mut uses_vec: bool = false;
        for j in 0..all.len()
            invariant 0 <= j && j <= all.len(),
        {
            if holds_vec(&all[j], tb) {
                uses_vec = true;
            }
        }
        if uses_heap(tb, uses_vec) {
            ir.push_str(codegen_text::heap_runtime().as_str());
        }
        if uses_vec {
            ir.push_str(codegen_text::vec_runtime().as_str());
        }
        ir.push_str(codegen_text::head_rest().as_str());
        let defs: Vec<Def> = sorted_defs(&ck.program, tb);
        let mut main: Option<String> = None;
        let mut print_f64: bool = false;
        let mut clones: Vec<String> = Vec::new();
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            match tb.fns.find(defs[i].path.as_str()) {
                None => {},
                Some(at) => { if is_exec(defs[i].d.kind) && tb.fns.items[at].generics.len() == 0 { if defs[i].d.name.name == "main" && defs[i].path == types::cat2(defs[i].unit.as_str(), "::main") { main = Some(defs[i].path.clone()); } let mut g: Gen = lower_fn(&defs[i], &tb.fns.items[at], ck, tb); ir.push_str(g.out.as_str()); if g.print_f64 { print_f64 = true; } for q in 0..g.clones.len() invariant 0 <= q && q <= g.clones.len(), { clones.push(g.clones[q].clone()); } for k in 0..g.todo.len() invariant 0 <= k && k <= g.todo.len(), { todo.push(g.todo[k].clone()); } } },
            }
        }
        if print_f64 {
            ir.push_str(codegen_text::print_f64().as_str());
        }
        match &main {
            None => {},
            Some(m) => { let run: String = if has_recursive_exec(ck, tb) { ir.push_str(big_stack(fn_sym(m.as_str()).as_str()).as_str()); String::from("@bmb_big_stack") } else { fn_sym(m.as_str()) }; ir.push_str("\ndefine i32 @main() {\n  call ptr @signal(i32 13, ptr inttoptr (i64 1 to ptr))\n  call void "); ir.push_str(run.as_str()); ir.push_str("()\n  call void @bmb_flush_out()\n  ret i32 0\n}\n"); },
        }
        let mut whole: String = codegen_text::head();
        if uses_vec {
            whole.push_str("%bmb.vec = type { ptr, i64, i64 }\n");
        }
        whole.push_str(type_defs(tb).as_str());
        whole.push_str(drop_glue(tb, &mut todo).as_str());
        whole.push_str(clone_glue(tb, clones.as_slice()).as_str());
        whole.push_str(ir.as_str());
        Module { ir: whole, main: main, todo: todo }
    }

    #[summary("진입점 (stage0 emit_with의 main): 단위의 main인 제네릭 아닌 실행 함수. 여럿이면 경로가 가장 뒤인 것")]
    #[effects(alloc)]
    fn entry(p: &ast::Program, tb: &lowered::Tables) -> Option<String> {
        let rows: Vec<body::DefRow> = body::defs_of(p, &tb.fns);
        let mut found: Option<String> = None;
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            if rows[i].path == types::cat2(rows[i].unit.as_str(), "::main") {
                match tb.fns.find(rows[i].path.as_str()) {
                    None => {},
                    Some(at) => { if is_exec(tb.fns.items[at].kind) && tb.fns.items[at].generics.len() == 0 { let later: bool = match &found { None => true, Some(prev) => rows[i].path.as_str() > prev.as_str(), }; if later { found = Some(rows[i].path.clone()); } } },
                }
            }
        }
        found
    }

    #[summary("f64 상수의 LLVM 16진 꼴 (stage0 f64_const): 0x와 대문자 16진 열여섯 자리")]
    #[effects(alloc)]
    fn f64_const(bits: u64) -> String {
        let mut s: String = String::from("0x");
        let mut k: u64 = 16;
        while k > 0
            invariant k <= 16,
            decreases k,
        {
            k = k - 1;
            let d: u32 = (bits >> 4 * k & 15) as u32;
            if d < 10 {
                lexer::push_code(&mut s, 48 + d);
            } else {
                lexer::push_code(&mut s, 55 + d);
            }
        }
        s
    }

    #[summary("f64의 이름 붙은 상수의 비트 (stage0 check::F64_CONSTS). 모르는 이름이면 0")]
    #[effects(pure)]
    fn f64_named(name: &str) -> u64 {
        if name == "INFINITY" {
            return 9218868437227405312;
        }
        if name == "NEG_INFINITY" {
            return 18442240474082181120;
        }
        if name == "NAN" {
            return 9221120237041090560;
        }
        if name == "MAX" {
            return 9218868437227405311;
        }
        if name == "MIN" {
            return 18442240474082181119;
        }
        if name == "MIN_POSITIVE" {
            return 4503599627370496;
        }
        if name == "EPSILON" {
            return 4372995238176751616;
        }
        0
    }

    #[summary("e가 실수 리터럴이면 그 비트")]
    #[effects(pure)]
    fn float_lit(e: &ast::Expr) -> Option<u64> {
        match &e.kind {
            ast::ExprKind::Int(fl_int0, fl_int1) => None,
            ast::ExprKind::Float(bits) => Some(*bits),
            ast::ExprKind::ByteLit(fl_bytelit0) => None,
            ast::ExprKind::ByteStr(fl_bytestr0) => None,
            ast::ExprKind::StrLit(fl_strlit0) => None,
            ast::ExprKind::CharLit(fl_charlit0) => None,
            ast::ExprKind::Bool(fl_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(fl_var0) => None,
            ast::ExprKind::Call(fl_call0) => None,
            ast::ExprKind::Method(fl_method0) => None,
            ast::ExprKind::Index(fl_index0, fl_index1) => None,
            ast::ExprKind::Unary(fl_unary0, fl_unary1) => None,
            ast::ExprKind::Binary(fl_binary0, fl_binary1, fl_binary2) => None,
            ast::ExprKind::Ref(fl_ref0, fl_ref1) => None,
            ast::ExprKind::If(fl_if0) => None,
            ast::ExprKind::Block(fl_block0) => None,
            ast::ExprKind::Array(fl_array0) => None,
            ast::ExprKind::Repeat(fl_repeat0) => None,
            ast::ExprKind::Old(fl_old0) => None,
            ast::ExprKind::Quant(fl_quant0) => None,
            ast::ExprKind::Trigger(fl_trigger0) => None,
            ast::ExprKind::Closure(fl_closure0) => None,
            ast::ExprKind::StructLit(fl_structlit0) => None,
            ast::ExprKind::Path(fl_path0) => None,
            ast::ExprKind::Deref(fl_deref0) => None,
            ast::ExprKind::Field(fl_field0, fl_field1) => None,
            ast::ExprKind::Match(fl_match0) => None,
            ast::ExprKind::Return(fl_return0) => None,
            ast::ExprKind::Try(fl_try0) => None,
            ast::ExprKind::Loop(fl_loop0) => None,
            ast::ExprKind::Break(fl_break0) => None,
            ast::ExprKind::Continue(fl_continue0) => None,
            ast::ExprKind::Range(fl_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("f64의 연산 (stage0 expr의 f64 갈래): 산술은 명령, 비교는 fcmp와 술어. 다른 연산이면 빈 글")]
    #[effects(alloc)]
    fn float_op(op: ast::BinOp) -> String {
        match op {
            ast::BinOp::Add => String::from("fadd"),
            ast::BinOp::Sub => String::from("fsub"),
            ast::BinOp::Mul => String::from("fmul"),
            ast::BinOp::Div => String::from("fdiv"),
            ast::BinOp::Rem => String::new(),
            ast::BinOp::Eq => String::from("fcmp oeq"),
            ast::BinOp::Ne => String::from("fcmp une"),
            ast::BinOp::Lt => String::from("fcmp olt"),
            ast::BinOp::Le => String::from("fcmp ole"),
            ast::BinOp::Gt => String::from("fcmp ogt"),
            ast::BinOp::Ge => String::from("fcmp oge"),
            ast::BinOp::And => String::new(),
            ast::BinOp::Or => String::new(),
            ast::BinOp::Implies => String::new(),
            ast::BinOp::BitAnd => String::new(),
            ast::BinOp::BitOr => String::new(),
            ast::BinOp::BitXor => String::new(),
            ast::BinOp::Shl => String::new(),
            ast::BinOp::Shr => String::new(),
        }
    }

    #[summary("m의 몸 있는 함수를 이름의 자리로 모은다 (body::defs_walk와 같은 것을 걷는다)")]
    #[effects(alloc)]
    fn fn_defs(m: &ast::Mod, out: &mut table::Table<ast::FnDef>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..m.mods.len()
            invariant 0 <= i && i <= m.mods.len(),
        {
            fn_defs(&m.mods[i], out, f - 1);
        }
        for i in 0..m.fns.len()
            invariant 0 <= i && i <= m.fns.len(),
        {
            out.insert(body::span_key(m.fns[i].name.span).as_str(), m.fns[i].clone());
        }
        for i in 0..m.impls.len()
            invariant 0 <= i && i <= m.impls.len(),
        {
            for j in 0..m.impls[i].fns.len()
                invariant 0 <= j && j <= m.impls[i].fns.len(),
            {
                out.insert(body::span_key(m.impls[i].fns[j].name.span).as_str(), m.impls[i].fns[j].clone());
            }
        }
        for i in 0..m.trait_impls.len()
            invariant 0 <= i && i <= m.trait_impls.len(),
        {
            for j in 0..m.trait_impls[i].fns.len()
                invariant 0 <= j && j <= m.trait_impls[i].fns.len(),
            {
                out.insert(body::span_key(m.trait_impls[i].fns[j].name.span).as_str(), m.trait_impls[i].fns[j].clone());
            }
        }
        for i in 0..m.traits.len()
            invariant 0 <= i && i <= m.traits.len(),
        {
            for j in 0..m.traits[i].fns.len()
                invariant 0 <= j && j <= m.traits[i].fns.len(),
            {
                if m.traits[i].fns[j].has_body {
                    out.insert(body::span_key(m.traits[i].fns[j].f.name.span).as_str(), m.traits[i].fns[j].f.clone());
                }
            }
        }
    }

    #[summary("함수의 LLVM 이름 (stage0 fn_sym): @\"경로\"")]
    #[effects(alloc)]
    fn fn_sym(path: &str) -> String {
        types::cat3("@\"", path, "\"")
    }

    #[summary("식이 제 값을 내는가 (stage0 fresh): 호출, 리터럴, 블록 따위. 자리나 그 일부(변수, 필드, *, 색인, &)가 아니다")]
    #[effects(pure)]
    fn fresh(e: &ast::Expr) -> bool {
        match &e.kind {
            ast::ExprKind::Int(fr_int0, fr_int1) => true,
            ast::ExprKind::Float(fr_float0) => true,
            ast::ExprKind::ByteLit(fr_bytelit0) => true,
            ast::ExprKind::ByteStr(fr_bytestr0) => true,
            ast::ExprKind::StrLit(fr_strlit0) => true,
            ast::ExprKind::CharLit(fr_charlit0) => true,
            ast::ExprKind::Bool(fr_bool0) => true,
            ast::ExprKind::Unit => true,
            ast::ExprKind::Var(fr_v) => false,
            ast::ExprKind::Call(fr_call0) => true,
            ast::ExprKind::Method(fr_method0) => true,
            ast::ExprKind::Index(fr_i, fr_j) => false,
            ast::ExprKind::Unary(fr_unary0, fr_unary1) => true,
            ast::ExprKind::Binary(fr_binary0, fr_binary1, fr_binary2) => true,
            ast::ExprKind::Ref(fr_m, fr_r) => false,
            ast::ExprKind::If(fr_if0) => true,
            ast::ExprKind::Block(fr_block0) => true,
            ast::ExprKind::Array(fr_array0) => true,
            ast::ExprKind::Repeat(fr_repeat0) => true,
            ast::ExprKind::Old(fr_old0) => true,
            ast::ExprKind::Quant(fr_quant0) => true,
            ast::ExprKind::Trigger(fr_trigger0) => true,
            ast::ExprKind::Closure(fr_closure0) => true,
            ast::ExprKind::StructLit(fr_structlit0) => true,
            ast::ExprKind::Path(fr_path0) => true,
            ast::ExprKind::Deref(fr_d) => false,
            ast::ExprKind::Field(fr_b, fr_n) => false,
            ast::ExprKind::Match(fr_match0) => true,
            ast::ExprKind::Return(fr_return0) => true,
            ast::ExprKind::Try(fr_try0) => true,
            ast::ExprKind::Loop(fr_loop0) => true,
            ast::ExprKind::Break(fr_break0) => true,
            ast::ExprKind::Continue(fr_continue0) => true,
            ast::ExprKind::Range(fr_range0) => true,
            ast::ExprKind::Error => true,
        }
    }

    #[summary("타입 t의 놓는 코드의 이름 (stage0 glue)")]
    #[effects(alloc)]
    fn glue(t: &ast::TypeKind) -> String {
        types::cat3("@\"bmb_drop.", types::text(t).as_str(), "\"")
    }

    #[summary("경로에 점이 있는가 (필드의 경로)")]
    #[effects(pure)]
    fn has_dot(p: &str) -> bool {
        for i in 0..p.len()
            invariant 0 <= i && i <= p.len(),
        {
            if p.as_bytes()[i] == 46 {
                return true;
            }
        }
        false
    }

    #[summary("재귀하는 실행 함수가 있는가 (stage0 emit_with의 deep)")]
    #[effects(alloc)]
    fn has_recursive_exec(ck: &body::Checked, tb: &lowered::Tables) -> bool {
        for n in 0..ck.b.recursive.len()
            invariant 0 <= n,
        {
            match tb.fns.find(ck.b.recursive.key(n).as_str()) {
                None => {},
                Some(at) => { if is_exec(tb.fns.items[at].kind) { return true; } },
            }
        }
        false
    }

    #[summary("trait의 메서드인가")]
    #[effects(pure)]
    fn has_trait(sig: &types::FnSig) -> bool {
        match &sig.trait_of {
            None => false,
            Some(ht_t) => true,
        }
    }

    #[summary("값이 Vec을 어디엔가 드는가 (stage0 holds_vec): 참조, 필드, 페이로드, Box, 배열, 타입 인자를 지나")]
    #[effects(alloc)]
    fn holds_vec(t: &ast::TypeKind, tb: &lowered::Tables) -> bool {
        let mut seen: Vec<String> = Vec::new();
        holds_vec_in(t, tb, &mut seen, 100000)
    }

    #[effects(alloc)]
    fn holds_vec_in(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match t {
            ast::TypeKind::Int(hv_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(ae, hv_n) => holds_vec_in(&ae.kind, tb, seen, f - 1),
            ast::TypeKind::ArrayN(hv_arrayn0, hv_arrayn1) => false,
            ast::TypeKind::Slice(se) => holds_vec_in(&se.kind, tb, seen, f - 1),
            ast::TypeKind::Ref(hv_m, ri) => holds_vec_in(&ri.kind, tb, seen, f - 1),
            ast::TypeKind::Named(hv_path, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if holds_vec_in(&args[i].kind, tb, seen, f - 1) { return true; } } if !types::add(seen, types::text(t).as_str()) { return false; } match lowered::struct_fields(t, tb) { None => {}, Some(fs) => { for j in 0..fs.len() invariant 0 <= j && j <= fs.len(), { if holds_vec_in(&fs[j].ty, tb, seen, f - 1) { return true; } } return false; }, } match lowered::enum_variants(t, tb) { None => false, Some(vs) => { for a in 0..vs.len() invariant 0 <= a && a <= vs.len(), { for b in 0..vs[a].tys.len() invariant 0 <= b && b <= vs[a].tys.len(), { if holds_vec_in(&vs[a].tys[b], tb, seen, f - 1) { return true; } } } false }, } },
            ast::TypeKind::Vec(hv_e) => true,
            ast::TypeKind::Box(be) => holds_vec_in(&be.kind, tb, seen, f - 1),
            ast::TypeKind::Param(hv_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("스칼라로 쓰는 값의 글 (stage0 CVal::imm): 단위 값은 0, 끝나지 않는 값은 undef")]
    #[effects(alloc)]
    fn imm(v: &CVal) -> String {
        match v {
            CVal::Imm(s) => s.clone(),
            CVal::Arr(im_p, im_n) => String::from("undef"),
            CVal::Ptr(im_q, im_t) => String::from("undef"),
            CVal::Unit => String::from("0"),
            CVal::Never => String::from("undef"),
        }
    }

    #[summary("정수 비교의 술어 (stage0 expr의 cmp): 부호에 따라. 비교가 아니면 빈 글")]
    #[effects(alloc)]
    fn int_cmp(op: ast::BinOp, signed: bool) -> String {
        match op {
            ast::BinOp::Add => String::new(),
            ast::BinOp::Sub => String::new(),
            ast::BinOp::Mul => String::new(),
            ast::BinOp::Div => String::new(),
            ast::BinOp::Rem => String::new(),
            ast::BinOp::Eq => String::from("eq"),
            ast::BinOp::Ne => String::from("ne"),
            ast::BinOp::Lt => { if signed { String::from("slt") } else { String::from("ult") } },
            ast::BinOp::Le => { if signed { String::from("sle") } else { String::from("ule") } },
            ast::BinOp::Gt => { if signed { String::from("sgt") } else { String::from("ugt") } },
            ast::BinOp::Ge => { if signed { String::from("sge") } else { String::from("uge") } },
            ast::BinOp::And => String::new(),
            ast::BinOp::Or => String::new(),
            ast::BinOp::Implies => String::new(),
            ast::BinOp::BitAnd => String::new(),
            ast::BinOp::BitOr => String::new(),
            ast::BinOp::BitXor => String::new(),
            ast::BinOp::Shl => String::new(),
            ast::BinOp::Shr => String::new(),
        }
    }

    #[summary("e가 정수 리터럴이면 그 값")]
    #[effects(pure)]
    fn int_lit(e: &ast::Expr) -> Option<wide::U128> {
        match &e.kind {
            ast::ExprKind::Int(v, il_r) => Some(*v),
            ast::ExprKind::Float(il_float0) => None,
            ast::ExprKind::ByteLit(il_bytelit0) => None,
            ast::ExprKind::ByteStr(il_bytestr0) => None,
            ast::ExprKind::StrLit(il_strlit0) => None,
            ast::ExprKind::CharLit(il_charlit0) => None,
            ast::ExprKind::Bool(il_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(il_var0) => None,
            ast::ExprKind::Call(il_call0) => None,
            ast::ExprKind::Method(il_method0) => None,
            ast::ExprKind::Index(il_index0, il_index1) => None,
            ast::ExprKind::Unary(il_unary0, il_unary1) => None,
            ast::ExprKind::Binary(il_binary0, il_binary1, il_binary2) => None,
            ast::ExprKind::Ref(il_ref0, il_ref1) => None,
            ast::ExprKind::If(il_if0) => None,
            ast::ExprKind::Block(il_block0) => None,
            ast::ExprKind::Array(il_array0) => None,
            ast::ExprKind::Repeat(il_repeat0) => None,
            ast::ExprKind::Old(il_old0) => None,
            ast::ExprKind::Quant(il_quant0) => None,
            ast::ExprKind::Trigger(il_trigger0) => None,
            ast::ExprKind::Closure(il_closure0) => None,
            ast::ExprKind::StructLit(il_structlit0) => None,
            ast::ExprKind::Path(il_path0) => None,
            ast::ExprKind::Deref(il_deref0) => None,
            ast::ExprKind::Field(il_field0, il_field1) => None,
            ast::ExprKind::Match(il_match0) => None,
            ast::ExprKind::Return(il_return0) => None,
            ast::ExprKind::Try(il_try0) => None,
            ast::ExprKind::Loop(il_loop0) => None,
            ast::ExprKind::Break(il_break0) => None,
            ast::ExprKind::Continue(il_continue0) => None,
            ast::ExprKind::Range(il_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("정수 타입의 가장 큰 값의 글")]
    #[effects(alloc)]
    fn int_max(i: ast::IntTy) -> String {
        match i {
            ast::IntTy::I8 => String::from("127"),
            ast::IntTy::I16 => String::from("32767"),
            ast::IntTy::I32 => String::from("2147483647"),
            ast::IntTy::I64 => String::from("9223372036854775807"),
            ast::IntTy::Isize => String::from("9223372036854775807"),
            ast::IntTy::U8 => String::from("255"),
            ast::IntTy::U16 => String::from("65535"),
            ast::IntTy::U32 => String::from("4294967295"),
            ast::IntTy::U64 => String::from("18446744073709551615"),
            ast::IntTy::Usize => String::from("18446744073709551615"),
        }
    }

    #[summary("정수 타입의 가장 작은 값의 글")]
    #[effects(alloc)]
    fn int_min(i: ast::IntTy) -> String {
        match i {
            ast::IntTy::I8 => String::from("-128"),
            ast::IntTy::I16 => String::from("-32768"),
            ast::IntTy::I32 => String::from("-2147483648"),
            ast::IntTy::I64 => String::from("-9223372036854775808"),
            ast::IntTy::Isize => String::from("-9223372036854775808"),
            ast::IntTy::U8 => String::from("0"),
            ast::IntTy::U16 => String::from("0"),
            ast::IntTy::U32 => String::from("0"),
            ast::IntTy::U64 => String::from("0"),
            ast::IntTy::Usize => String::from("0"),
        }
    }

    #[effects(pure)]
    fn is_and(op: ast::BinOp) -> bool {
        match op {
            ast::BinOp::Add => false,
            ast::BinOp::Sub => false,
            ast::BinOp::Mul => false,
            ast::BinOp::Div => false,
            ast::BinOp::Rem => false,
            ast::BinOp::Eq => false,
            ast::BinOp::Ne => false,
            ast::BinOp::Lt => false,
            ast::BinOp::Le => false,
            ast::BinOp::Gt => false,
            ast::BinOp::Ge => false,
            ast::BinOp::And => true,
            ast::BinOp::Or => false,
            ast::BinOp::Implies => false,
            ast::BinOp::BitAnd => false,
            ast::BinOp::BitOr => false,
            ast::BinOp::BitXor => false,
            ast::BinOp::Shl => false,
            ast::BinOp::Shr => false,
        }
    }

    #[summary("배열 값인가")]
    #[effects(pure)]
    fn is_arr(v: &CVal) -> bool {
        match v {
            CVal::Imm(ia_x) => false,
            CVal::Arr(ia_p, ia_n) => true,
            CVal::Ptr(ia_q, ia_t) => false,
            CVal::Unit => false,
            CVal::Never => false,
        }
    }

    #[summary("슬라이스의 참조인가 (stage0 is_array)")]
    #[effects(alloc)]
    fn is_array(t: &ast::TypeKind) -> bool {
        match body::ref_inner(t) {
            None => false,
            Some(inner) => body::is_slice(&inner),
        }
    }

    #[summary("Box인가 (참조를 지나)")]
    #[effects(alloc)]
    fn is_box(t: &ast::TypeKind) -> bool {
        body::is_box(&lowered::value_ty(t))
    }

    #[summary("구조체나 열거형인가 (참조를 지나)")]
    #[effects(alloc)]
    fn is_data(t: &ast::TypeKind) -> bool {
        body::is_named(&lowered::value_ty(t))
    }

    #[effects(pure)]
    fn is_exec(k: ast::FnKind) -> bool {
        match k {
            ast::FnKind::Exec => true,
            ast::FnKind::Spec => false,
            ast::FnKind::Proof => false,
        }
    }

    #[summary("값이 메모리에 살고 주소로 넘겨지는가: 구조체, 열거형, Vec의 머리, Box")]
    #[effects(alloc)]
    fn is_mem(t: &ast::TypeKind) -> bool {
        is_data(t) || is_vec(t) || is_box(t)
    }

    #[summary("배열의 원소로서 메모리에 덩어리로 사는가: is_mem이거나 고정 길이 배열")]
    #[effects(alloc)]
    fn is_mem_elem(t: &ast::TypeKind) -> bool {
        is_mem(t) || body::is_array(&lowered::value_ty(t))
    }

    #[effects(pure)]
    fn is_neg(op: ast::UnOp) -> bool {
        match op {
            ast::UnOp::Neg => true,
            ast::UnOp::Not => false,
        }
    }

    #[summary("끝나지 않는 식의 값인가")]
    #[effects(pure)]
    fn is_never(v: &CVal) -> bool {
        match v {
            CVal::Imm(in_x) => false,
            CVal::Arr(in_p, in_n) => false,
            CVal::Ptr(in_q, in_t) => false,
            CVal::Unit => false,
            CVal::Never => true,
        }
    }

    #[effects(pure)]
    fn is_or(op: ast::BinOp) -> bool {
        match op {
            ast::BinOp::Add => false,
            ast::BinOp::Sub => false,
            ast::BinOp::Mul => false,
            ast::BinOp::Div => false,
            ast::BinOp::Rem => false,
            ast::BinOp::Eq => false,
            ast::BinOp::Ne => false,
            ast::BinOp::Lt => false,
            ast::BinOp::Le => false,
            ast::BinOp::Gt => false,
            ast::BinOp::Ge => false,
            ast::BinOp::And => false,
            ast::BinOp::Or => true,
            ast::BinOp::Implies => false,
            ast::BinOp::BitAnd => false,
            ast::BinOp::BitOr => false,
            ast::BinOp::BitXor => false,
            ast::BinOp::Shl => false,
            ast::BinOp::Shr => false,
        }
    }

    #[summary("메모리에 사는 값인가")]
    #[effects(pure)]
    fn is_ptr(v: &CVal) -> bool {
        match v {
            CVal::Imm(ip_x) => false,
            CVal::Arr(ip_p, ip_n) => false,
            CVal::Ptr(ip_q, ip_t) => true,
            CVal::Unit => false,
            CVal::Never => false,
        }
    }

    #[summary("정수, bool, f64인가")]
    #[effects(pure)]
    fn is_scalar_ty(t: &ast::TypeKind) -> bool {
        match t {
            ast::TypeKind::Int(sc_i) => true,
            ast::TypeKind::F64 => true,
            ast::TypeKind::Bool => true,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(sc_array0, sc_array1) => false,
            ast::TypeKind::ArrayN(sc_arrayn0, sc_arrayn1) => false,
            ast::TypeKind::Slice(sc_slice0) => false,
            ast::TypeKind::Ref(sc_ref0, sc_ref1) => false,
            ast::TypeKind::Named(sc_named0, sc_named1) => false,
            ast::TypeKind::Vec(sc_vec0) => false,
            ast::TypeKind::Box(sc_box0) => false,
            ast::TypeKind::Param(sc_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[effects(pure)]
    fn is_shr(op: ast::BinOp) -> bool {
        match op {
            ast::BinOp::Add => false,
            ast::BinOp::Sub => false,
            ast::BinOp::Mul => false,
            ast::BinOp::Div => false,
            ast::BinOp::Rem => false,
            ast::BinOp::Eq => false,
            ast::BinOp::Ne => false,
            ast::BinOp::Lt => false,
            ast::BinOp::Le => false,
            ast::BinOp::Gt => false,
            ast::BinOp::Ge => false,
            ast::BinOp::And => false,
            ast::BinOp::Or => false,
            ast::BinOp::Implies => false,
            ast::BinOp::BitAnd => false,
            ast::BinOp::BitOr => false,
            ast::BinOp::BitXor => false,
            ast::BinOp::Shl => false,
            ast::BinOp::Shr => true,
        }
    }

    #[summary("부호 있는 정수 타입인가")]
    #[effects(pure)]
    fn is_signed(t: &ast::TypeKind) -> bool {
        match body::int_of(t) {
            None => false,
            Some(i) => body::signed(i),
        }
    }

    #[summary("Vec인가 (참조를 지나)")]
    #[effects(alloc)]
    fn is_vec(t: &ast::TypeKind) -> bool {
        body::is_vec(&lowered::value_ty(t))
    }

    #[summary("루프의 레이블의 이름. 없으면 빈 글")]
    #[effects(alloc)]
    fn label_name(l: &Option<ast::Ident>) -> String {
        match l {
            None => String::new(),
            Some(id) => id.name.clone(),
        }
    }

    #[summary("ts를 차례로 놓은 구조체의 배치 (stage0 layout의 fields). tag이면 i64 꼬리표가 앞에 온다")]
    #[effects(alloc)]
    fn lay_fields(ts: &[ast::TypeKind], tag: bool, tb: &lowered::Tables, f: usize) -> Lay
        decreases f * 2 + 1,
    {
        let mut size: u64 = 0;
        let mut al: u64 = 1;
        if tag {
            size = 8;
            al = 8;
        }
        for i in 0..ts.len()
            invariant 0 <= i && i <= ts.len(),
        {
            let l: Lay = layout_in(&ts[i], tb, f);
            size = round_up(size, l.align).wrapping_add(l.size);
            if l.align > al {
                al = l.align;
            }
        }
        Lay { size: round_up(size, al), align: al }
    }

    #[summary("t의 메모리에서의 크기와 정렬 (stage0 layout): 열거형의 페이로드 자리를 재는 데만 쓴다")]
    #[effects(alloc)]
    fn layout(t: &ast::TypeKind, tb: &lowered::Tables) -> Lay {
        layout_in(t, tb, 100000)
    }

    #[effects(alloc)]
    fn layout_in(t: &ast::TypeKind, tb: &lowered::Tables, f: usize) -> Lay
        decreases f * 2,
    {
        let word: Lay = Lay { size: 8, align: 8 };
        if f == 0 {
            return word;
        }
        let v: ast::TypeKind = lowered::value_ty(t);
        match &v {
            ast::TypeKind::Int(ly_int0) => word,
            ast::TypeKind::F64 => word,
            ast::TypeKind::Bool => Lay { size: 1, align: 1 },
            ast::TypeKind::Unit => Lay { size: 0, align: 1 },
            ast::TypeKind::Char => word,
            ast::TypeKind::String => word,
            ast::TypeKind::Str => word,
            ast::TypeKind::Array(ae, an) => { let el: Lay = layout_in(&ae.kind, tb, f - 1); Lay { size: el.size.wrapping_mul(*an), align: el.align } },
            ast::TypeKind::ArrayN(ly_arrayn0, ly_arrayn1) => word,
            ast::TypeKind::Slice(ly_slice0) => word,
            ast::TypeKind::Ref(ly_ref0, ly_ref1) => word,
            ast::TypeKind::Named(ly_path, ly_args) => { match lowered::struct_fields(&v, tb) { None => {}, Some(fs) => { let mut fts: Vec<ast::TypeKind> = Vec::new(); for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { fts.push(fs[i].ty.clone()); } return lay_fields(fts.as_slice(), false, tb, f - 1); }, } let mut size: u64 = 8; match lowered::enum_variants(&v, tb) { None => {}, Some(vs) => { for k in 0..vs.len() invariant 0 <= k && k <= vs.len(), { let one: Lay = lay_fields(vs[k].tys.as_slice(), true, tb, f - 1); if one.size > size { size = one.size; } } }, } Lay { size: round_up(size, 8), align: 8 } },
            ast::TypeKind::Vec(ly_e) => Lay { size: 24, align: 8 },
            ast::TypeKind::Box(ly_box0) => word,
            ast::TypeKind::Param(ly_param0) => word,
            ast::TypeKind::Never => word,
            ast::TypeKind::Error => word,
        }
    }

    #[summary("스칼라의 레지스터 타입 (stage0 llty): bool은 i1, f64는 double, ()는 void, 나머지는 i64")]
    #[effects(alloc)]
    fn llty(t: &ast::TypeKind) -> String {
        match t {
            ast::TypeKind::Int(ll_int0) => String::from("i64"),
            ast::TypeKind::F64 => String::from("double"),
            ast::TypeKind::Bool => String::from("i1"),
            ast::TypeKind::Unit => String::from("void"),
            ast::TypeKind::Char => String::from("i64"),
            ast::TypeKind::String => String::from("i64"),
            ast::TypeKind::Str => String::from("i64"),
            ast::TypeKind::Array(ll_array0, ll_array1) => String::from("i64"),
            ast::TypeKind::ArrayN(ll_arrayn0, ll_arrayn1) => String::from("i64"),
            ast::TypeKind::Slice(ll_slice0) => String::from("i64"),
            ast::TypeKind::Ref(ll_ref0, ll_ref1) => String::from("i64"),
            ast::TypeKind::Named(ll_named0, ll_named1) => String::from("i64"),
            ast::TypeKind::Vec(ll_vec0) => String::from("i64"),
            ast::TypeKind::Box(ll_box0) => String::from("i64"),
            ast::TypeKind::Param(ll_param0) => String::from("i64"),
            ast::TypeKind::Never => String::from("i64"),
            ast::TypeKind::Error => String::from("i64"),
        }
    }

    #[summary("정의 하나를 낮춘다 (stage0 emit_with의 한 바퀴): 매개변수의 자리, 몸, 반환. g.out이 그 정의의 글 전체다")]
    #[effects(alloc)]
    fn lower_fn(def: &Def, sig: &types::FnSig, ck: &body::Checked, tb: &lowered::Tables) -> Gen {
        let mut g: Gen = Gen { path: def.path.clone(), base: def.path.clone(), unit: def.unit.clone(), out: String::new(), allocas: String::new(), tmp: 0, label: 0, slots: table::new::<Slot>(), checks: 0, globals: String::new(), consts: 0, ret: sig.ret.clone(), todo: Vec::new(), print_f64: false, loops: Vec::new(), pending: Vec::new(), clones: Vec::new() };
        let mut params: Vec<String> = Vec::new();
        for i in 0..def.d.params.len()
            invariant 0 <= i && i <= def.d.params.len(),
        {
            if i < sig.params.len() {
                let n: String = def.d.params[i].name.name.clone();
                let pk: u32 = param_kind(&sig.params[i]);
                let attr: String = if types::is_ref_mut(&sig.params[i]) {
                    String::from("noalias ")
                } else {
                    String::from("readonly ")
                };
                if pk == 9 {
                    g.todo_at("a parameter that is not ported (a reference to an array or to a reference)", def.d.params[i].name.span);
                } else if pk == 1 {
                    let sp: String = types::cat3("%\"", n.as_str(), ".ptr\"");
                    let sn: String = types::cat3("%\"", n.as_str(), ".len\"");
                    params.push(types::cat3("ptr ", attr.as_str(), sp.as_str()));
                    params.push(types::cat2("i64 ", sn.as_str()));
                    let sety: ast::TypeKind = elem_of(&sig.params[i]);
                    g.slots.insert(n.as_str(), Slot::Arr(ArrSlot { ptr: sp, len: sn, elem: elem_kind(&sety), ety: sety }));
                } else if pk == 2 {
                    let rp: String = types::cat3("%\"", n.as_str(), ".ptr\"");
                    params.push(types::cat3("ptr ", attr.as_str(), rp.as_str()));
                    g.slots.insert(n.as_str(), Slot::Scalar(rp, llty(&elem_of(&sig.params[i]))));
                } else if pk == 4 {
                    let dp: String = types::cat3("%\"", n.as_str(), ".ptr\"");
                    params.push(types::cat3("ptr ", attr.as_str(), dp.as_str()));
                    g.slots.insert(n.as_str(), Slot::Data(DataSlot { ptr: dp, ty: lowered::value_ty(&sig.params[i]) }));
                } else if pk == 5 {
                    let din: String = types::cat3("%\"", n.as_str(), ".in\"");
                    params.push(types::cat2("ptr readonly ", din.as_str()));
                    g.slots.insert(n.as_str(), Slot::Data(DataSlot { ptr: din, ty: sig.params[i].clone() }));
                } else if pk == 3 {
                    let ain: String = types::cat3("%\"", n.as_str(), ".in\"");
                    params.push(types::cat2("ptr ", ain.as_str()));
                    let ap: String = g.temp(&sig.params[i]);
                    g.copy(ap.as_str(), ain.as_str(), &sig.params[i]);
                    let aety: ast::TypeKind = elem_of(&sig.params[i]);
                    g.slots.insert(n.as_str(), Slot::Arr(ArrSlot { ptr: ap, len: array_len_text(&sig.params[i]), elem: elem_kind(&aety), ety: aety }));
                } else if !decls::is_unit(&sig.params[i]) {
                    let lt: String = llty(&sig.params[i]);
                    let reg: String = types::cat3("%\"", n.as_str(), "\"");
                    params.push(types::cat3(lt.as_str(), " ", reg.as_str()));
                    let ptr: String = g.alloca(lt.as_str());
                    g.emit(types::cat7("store ", lt.as_str(), " ", reg.as_str(), ", ptr ", ptr.as_str(), "").as_str());
                    g.slots.insert(n.as_str(), Slot::Scalar(ptr, lt));
                }
            }
        }
        let rv: CVal = g.block_expr(&def.d.body, ck, tb, 100000);
        g.emit_return(&rv);
        let mut frag: String = String::from("\n");
        frag.push_str(g.globals.as_str());
        frag.push_str("define internal ");
        if ret_in_memory(&sig.ret) {
            frag.push_str("void");
        } else {
            frag.push_str(llty(&sig.ret).as_str());
        }
        frag.push_str(" ");
        frag.push_str(fn_sym(def.path.as_str()).as_str());
        frag.push_str("(");
        if ret_in_memory(&sig.ret) {
            frag.push_str("ptr noalias %\"ret.out\"");
            if params.len() > 0 {
                frag.push_str(", ");
            }
        }
        frag.push_str(types::join(params.as_slice(), ", ").as_str());
        frag.push_str(") {\nentry:\n");
        frag.push_str(g.allocas.as_str());
        frag.push_str(g.out.as_str());
        frag.push_str("}\n");
        g.out = frag;
        g
    }

    #[summary("배열 원소의 메모리 타입 (stage0 mem): bool과 좁은 정수는 제 폭")]
    #[effects(alloc)]
    fn mem(elem: &str) -> String {
        if elem == "i1" {
            return String::from("i8");
        }
        let b: u32 = narrow_bits(elem);
        if b == 8 {
            return String::from("i8");
        }
        if b == 16 {
            return String::from("i16");
        }
        if b == 32 {
            return String::from("i32");
        }
        String::from(elem)
    }

    #[summary("t의 값의 메모리에서의 LLVM 타입 (stage0 mem_ty): bool은 한 바이트")]
    #[effects(alloc)]
    fn mem_ty(t: &ast::TypeKind) -> String {
        mem_ty_in(t, 100000)
    }

    #[effects(alloc)]
    fn mem_ty_in(t: &ast::TypeKind, f: usize) -> String
        decreases f,
    {
        if f == 0 {
            return String::from("i64");
        }
        let v: ast::TypeKind = lowered::value_ty(t);
        match &v {
            ast::TypeKind::Int(it) => { let mut s: String = String::from("i"); std::num::push_u64(&mut s, body::bits(*it) as u64); s },
            ast::TypeKind::F64 => String::from("double"),
            ast::TypeKind::Bool => String::from("i8"),
            ast::TypeKind::Unit => String::from("i64"),
            ast::TypeKind::Char => String::from("i64"),
            ast::TypeKind::String => String::from("i64"),
            ast::TypeKind::Str => String::from("i64"),
            ast::TypeKind::Array(ae, an) => { let mut s: String = String::from("["); std::num::push_u64(&mut s, *an); s.push_str(" x "); s.push_str(mem_ty_in(&ae.kind, f - 1).as_str()); s.push_str("]"); s },
            ast::TypeKind::ArrayN(mt_arrayn0, mt_arrayn1) => String::from("i64"),
            ast::TypeKind::Slice(mt_slice0) => String::from("i64"),
            ast::TypeKind::Ref(mt_ref0, mt_ref1) => String::from("i64"),
            ast::TypeKind::Named(mt_p, mt_a) => data_ty(&v),
            ast::TypeKind::Vec(mt_e) => String::from("%bmb.vec"),
            ast::TypeKind::Box(mt_b) => String::from("ptr"),
            ast::TypeKind::Param(mt_param0) => String::from("i64"),
            ast::TypeKind::Never => String::from("i64"),
            ast::TypeKind::Error => String::from("i64"),
        }
    }

    #[summary("원소 종류가 이름하는 좁은 정수의 폭 (stage0 narrow). 아니면 0")]
    #[effects(pure)]
    fn narrow_bits(elem: &str) -> u32 {
        if elem == "i8" || elem == "u8" {
            return 8;
        }
        if elem == "i16" || elem == "u16" {
            return 16;
        }
        if elem == "i32" || elem == "u32" {
            return 32;
        }
        0
    }

    #[summary("원소 종류가 부호 있는 좁은 정수인가 (stage0 narrow의 signed)")]
    #[effects(pure)]
    fn narrow_signed(elem: &str) -> bool {
        elem == "i8" || elem == "i16" || elem == "i32"
    }

    #[summary("매개변수가 넘겨지는 꼴 (stage0 emit_with의 매개변수 갈래들). 0: 값으로 넘기는 스칼라나 단위 값, 1: 슬라이스 (주소와 길이), 2: 스칼라의 참조 (자리의 주소), 3: 값으로 넘기는 배열 (주소, 받는 쪽이 옮긴다), 4: 메모리 값의 참조 (자리의 주소), 5: 값으로 넘기는 메모리 값 (부른 쪽이 만든 사본의 주소), 9: 아직 옮기지 않은 것 (배열의 참조, 참조의 참조)")]
    #[effects(alloc)]
    fn param_kind(t: &ast::TypeKind) -> u32 {
        match body::ref_inner(t) {
            None => { if is_mem(t) { 5 } else if body::is_array(t) { 3 } else { 0 } },
            Some(inner) => { if body::is_slice(&inner) { 1 } else if is_mem(t) { 4 } else if is_scalar_ty(&inner) { 2 } else { 9 } },
        }
    }

    #[summary("패턴이 가리키는 변형의 이름 (경로의 마지막 마디)")]
    #[effects(alloc)]
    fn pat_name(p: &ast::Pat) -> String {
        if p.path.len() == 0 {
            return String::new();
        }
        p.path[p.path.len() - 1].name.clone()
    }

    #[summary("원소가 힙 메모리를 갖지 않는 Vec인가 (그 clone은 Vec의 것이다)")]
    #[effects(alloc)]
    fn plain_vec(t: &ast::TypeKind, tb: &lowered::Tables) -> bool {
        let none: Vec<String> = Vec::new();
        match body::vec_elem(t) {
            None => false,
            Some(el) => !types::is_move_in(&el, &tb.adts, none.as_slice()),
        }
    }

    #[summary("메모리에 사는 값의 주소. 아니면 undef")]
    #[effects(alloc)]
    fn ptr_of(v: &CVal) -> String {
        match v {
            CVal::Imm(po_x) => String::from("undef"),
            CVal::Arr(po_p, po_n) => String::from("undef"),
            CVal::Ptr(p, po_t) => p.clone(),
            CVal::Unit => String::from("undef"),
            CVal::Never => String::from("undef"),
        }
    }

    #[summary("메모리에 사는 값의 타입. 아니면 Error")]
    #[effects(alloc)]
    fn ptr_ty(v: &CVal) -> ast::TypeKind {
        match v {
            CVal::Imm(pt_x) => ast::TypeKind::Error,
            CVal::Arr(pt_p, pt_n) => ast::TypeKind::Error,
            CVal::Ptr(pt_q, t) => t.clone(),
            CVal::Unit => ast::TypeKind::Error,
            CVal::Never => ast::TypeKind::Error,
        }
    }

    #[summary("식이 범위면 그 범위")]
    #[effects(alloc)]
    fn range_of(e: &ast::Expr) -> Option<ast::Range> {
        match &e.kind {
            ast::ExprKind::Int(ro_int0, ro_int1) => None,
            ast::ExprKind::Float(ro_float0) => None,
            ast::ExprKind::ByteLit(ro_bytelit0) => None,
            ast::ExprKind::ByteStr(ro_bytestr0) => None,
            ast::ExprKind::StrLit(ro_strlit0) => None,
            ast::ExprKind::CharLit(ro_charlit0) => None,
            ast::ExprKind::Bool(ro_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(ro_var0) => None,
            ast::ExprKind::Call(ro_call0) => None,
            ast::ExprKind::Method(ro_method0) => None,
            ast::ExprKind::Index(ro_index0, ro_index1) => None,
            ast::ExprKind::Unary(ro_unary0, ro_unary1) => None,
            ast::ExprKind::Binary(ro_binary0, ro_binary1, ro_binary2) => None,
            ast::ExprKind::Ref(ro_ref0, ro_ref1) => None,
            ast::ExprKind::If(ro_if0) => None,
            ast::ExprKind::Block(ro_block0) => None,
            ast::ExprKind::Array(ro_array0) => None,
            ast::ExprKind::Repeat(ro_repeat0) => None,
            ast::ExprKind::Old(ro_old0) => None,
            ast::ExprKind::Quant(ro_quant0) => None,
            ast::ExprKind::Trigger(ro_trigger0) => None,
            ast::ExprKind::Closure(ro_closure0) => None,
            ast::ExprKind::StructLit(ro_structlit0) => None,
            ast::ExprKind::Path(ro_path0) => None,
            ast::ExprKind::Deref(ro_deref0) => None,
            ast::ExprKind::Field(ro_field0, ro_field1) => None,
            ast::ExprKind::Match(ro_match0) => None,
            ast::ExprKind::Return(ro_return0) => None,
            ast::ExprKind::Try(ro_try0) => None,
            ast::ExprKind::Loop(ro_loop0) => None,
            ast::ExprKind::Break(ro_break0) => None,
            ast::ExprKind::Continue(ro_continue0) => None,
            ast::ExprKind::Range(r) => Some(r.clone()),
            ast::ExprKind::Error => None,
        }
    }

    #[summary("결과를 부른 쪽의 메모리에 쓰는가 (stage0 ret_in_memory): 메모리에 사는 값이거나 배열")]
    #[effects(alloc)]
    fn ret_in_memory(ret: &ast::TypeKind) -> bool {
        is_mem(ret) || body::is_array(ret)
    }

    #[summary("x를 a의 배수로 올린다 (stage0의 x.div_ceil(a) * a, 넘치면 감긴다). a가 0이면 x")]
    #[effects(pure)]
    fn round_up(x: u64, a: u64) -> u64 {
        if a == 0 {
            return x;
        }
        let r: u64 = x % a;
        if r == 0 {
            x
        } else {
            x.wrapping_add(a - r)
        }
    }

    #[summary("스칼라 원소의 배열 타입인가")]
    #[effects(alloc)]
    fn scalar_array(t: &ast::TypeKind) -> bool {
        match body::array_elem(t) {
            None => false,
            Some(el) => is_scalar_ty(&el),
        }
    }

    #[summary("t의 값의 바이트 수를 주는 상수 식 (stage0 size_of)")]
    #[effects(alloc)]
    fn size_of(t: &ast::TypeKind) -> String {
        types::cat3("ptrtoint (ptr getelementptr (", mem_ty(t).as_str(), ", ptr null, i32 1) to i64)")
    }

    #[summary("몸 있는 정의를 경로 순서로 (stage0 emit_with의 defs): body::defs_of의 줄마다 그 구문")]
    #[effects(alloc)]
    fn sorted_defs(p: &ast::Program, tb: &lowered::Tables) -> Vec<Def> {
        let mut by_span: table::Table<ast::FnDef> = table::new::<ast::FnDef>();
        for i in 0..p.mods.len()
            invariant 0 <= i && i <= p.mods.len(),
        {
            fn_defs(&p.mods[i], &mut by_span, 100000);
        }
        let rows: Vec<body::DefRow> = body::defs_of(p, &tb.fns);
        let mut by_path: table::Table<Def> = table::new::<Def>();
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            match by_span.find(body::span_key(rows[i].span).as_str()) {
                None => {},
                Some(at) => { if !by_path.has(rows[i].path.as_str()) { by_path.insert(rows[i].path.as_str(), Def { path: rows[i].path.clone(), unit: rows[i].unit.clone(), d: by_span.items[at].clone() }); } },
            }
        }
        let mut out: Vec<Def> = Vec::new();
        for n in 0..by_path.len()
            invariant 0 <= n,
        {
            match by_path.nth(n) {
                None => {},
                Some(at) => out.push(by_path.items[at].clone()),
            }
        }
        out
    }

    #[summary("프로그램이 쓰는 구조체와 열거형(인스턴스)의 LLVM 타입 정의 (stage0 type_defs): 구조체는 필드를 선언 순서로, 열거형은 꼬리표와 페이로드 자리, 페이로드 있는 변형마다 보는 타입 하나")]
    #[effects(alloc)]
    fn type_defs(tb: &lowered::Tables) -> String {
        let mut seen: Vec<String> = Vec::new();
        let mut out: String = String::new();
        let all: Vec<ast::TypeKind> = all_types(tb);
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            visit(&all[i], tb, &mut seen, &mut out, 100000);
        }
        out
    }

    #[summary("프로그램이 힙 값을 갖는가 (stage0 emit_with의 uses_heap): Vec을 들거나, 식이나 지역 변수의 타입이 옮겨지는 값이다 (시그니처는 세지 않는다)")]
    #[effects(alloc)]
    fn uses_heap(tb: &lowered::Tables, uses_vec: bool) -> bool {
        if uses_vec {
            return true;
        }
        let none: Vec<String> = Vec::new();
        for n in 0..tb.types.len()
            invariant 0 <= n,
        {
            match tb.types.nth(n) {
                None => {},
                Some(at) => { if types::is_move_in(&lowered::value_ty(&tb.types.items[at]), &tb.adts, none.as_slice()) { return true; } },
            }
        }
        for n in 0..tb.locals.len()
            invariant 0 <= n,
        {
            match tb.locals.nth(n) {
                None => {},
                Some(at) => { for v in 0..tb.locals.items[at].len() invariant 0 <= v, { match tb.locals.items[at].nth(v) { None => {}, Some(i) => { if types::is_move_in(&lowered::value_ty(&tb.locals.items[at].items[i]), &tb.adts, none.as_slice()) { return true; } }, } } },
            }
        }
        false
    }

    #[summary("e가 지역 이름이면 그 이름")]
    #[effects(alloc)]
    fn var_name(e: &ast::Expr) -> Option<String> {
        match &e.kind {
            ast::ExprKind::Int(vn_int0, vn_int1) => None,
            ast::ExprKind::Float(vn_float0) => None,
            ast::ExprKind::ByteLit(vn_bytelit0) => None,
            ast::ExprKind::ByteStr(vn_bytestr0) => None,
            ast::ExprKind::StrLit(vn_strlit0) => None,
            ast::ExprKind::CharLit(vn_charlit0) => None,
            ast::ExprKind::Bool(vn_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(id) => Some(id.name.clone()),
            ast::ExprKind::Call(vn_call0) => None,
            ast::ExprKind::Method(vn_method0) => None,
            ast::ExprKind::Index(vn_index0, vn_index1) => None,
            ast::ExprKind::Unary(vn_unary0, vn_unary1) => None,
            ast::ExprKind::Binary(vn_binary0, vn_binary1, vn_binary2) => None,
            ast::ExprKind::Ref(vn_ref0, vn_ref1) => None,
            ast::ExprKind::If(vn_if0) => None,
            ast::ExprKind::Block(vn_block0) => None,
            ast::ExprKind::Array(vn_array0) => None,
            ast::ExprKind::Repeat(vn_repeat0) => None,
            ast::ExprKind::Old(vn_old0) => None,
            ast::ExprKind::Quant(vn_quant0) => None,
            ast::ExprKind::Trigger(vn_trigger0) => None,
            ast::ExprKind::Closure(vn_closure0) => None,
            ast::ExprKind::StructLit(vn_structlit0) => None,
            ast::ExprKind::Path(vn_path0) => None,
            ast::ExprKind::Deref(vn_deref0) => None,
            ast::ExprKind::Field(vn_field0, vn_field1) => None,
            ast::ExprKind::Match(vn_match0) => None,
            ast::ExprKind::Return(vn_return0) => None,
            ast::ExprKind::Try(vn_try0) => None,
            ast::ExprKind::Loop(vn_loop0) => None,
            ast::ExprKind::Break(vn_break0) => None,
            ast::ExprKind::Continue(vn_continue0) => None,
            ast::ExprKind::Range(vn_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("변형들에서 이름 name의 차례. 없으면 길이")]
    #[effects(pure)]
    fn variant_at(vs: &[types::VariantSig], name: &str) -> usize {
        for k in 0..vs.len()
            invariant 0 <= k && k <= vs.len(),
        {
            if vs[k].name == name {
                return k;
            }
        }
        vs.len()
    }

    #[summary("Vec<T>의 최대 길이 (stage0 vec_len_max, ADR-0017 §3)")]
    #[effects(alloc)]
    fn vec_len_max(e: &ast::TypeKind) -> String {
        if body::is_bool(e) || body::is_named(e) {
            String::from("9223372036854775807")
        } else {
            String::from("1152921504606846975")
        }
    }

    #[summary("열거형 t의 변형 v를 보는 타입 (stage0 view_ty): 꼬리표와 페이로드")]
    #[effects(alloc)]
    fn view_ty(t: &ast::TypeKind, v: &str) -> String {
        types::cat5("%\"", types::text(&lowered::value_ty(t)).as_str(), "::", v, "\"")
    }

    #[effects(alloc)]
    fn visit(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, out: &mut String, f: usize) -> ()
        decreases f,
    {
        if f == 0 || body::has_param(t, 100000) {
            return;
        }
        match t {
            ast::TypeKind::Int(vi_int0) => {},
            ast::TypeKind::F64 => {},
            ast::TypeKind::Bool => {},
            ast::TypeKind::Unit => {},
            ast::TypeKind::Char => {},
            ast::TypeKind::String => {},
            ast::TypeKind::Str => {},
            ast::TypeKind::Array(ae, vi_n) => visit(&ae.kind, tb, seen, out, f - 1),
            ast::TypeKind::ArrayN(vi_arrayn0, vi_arrayn1) => {},
            ast::TypeKind::Slice(se) => visit(&se.kind, tb, seen, out, f - 1),
            ast::TypeKind::Ref(vi_m, ri) => visit(&ri.kind, tb, seen, out, f - 1),
            ast::TypeKind::Named(vi_p, vi_a) => visit_data(t, tb, seen, out, f - 1),
            ast::TypeKind::Vec(ve) => visit(&ve.kind, tb, seen, out, f - 1),
            ast::TypeKind::Box(be) => visit(&be.kind, tb, seen, out, f - 1),
            ast::TypeKind::Param(vi_param0) => {},
            ast::TypeKind::Never => {},
            ast::TypeKind::Error => {},
        }
    }

    #[summary("타입 정의를 낼 구조체나 열거형 t (visit의 Named 갈래): 처음 볼 때만")]
    #[effects(alloc)]
    fn visit_data(t: &ast::TypeKind, tb: &lowered::Tables, seen: &mut Vec<String>, out: &mut String, f: usize) -> ()
        decreases f,
    {
        if f == 0 || !types::add(seen, types::text(t).as_str()) {
            return;
        }
        match lowered::struct_fields(t, tb) {
            None => {},
            Some(fs) => { out.push_str(data_ty(t).as_str()); out.push_str(" = type { "); for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { if i > 0 { out.push_str(", "); } out.push_str(mem_ty(&fs[i].ty).as_str()); } out.push_str(" }\n"); for j in 0..fs.len() invariant 0 <= j && j <= fs.len(), { visit(&fs[j].ty, tb, seen, out, f - 1); } return; },
        }
        match lowered::enum_variants(t, tb) {
            None => {},
            Some(vs) => { let words: u64 = layout(t, tb).size.wrapping_sub(8) / 8; out.push_str(data_ty(t).as_str()); out.push_str(" = type { i64, ["); std::num::push_u64(out, words); out.push_str(" x i64] }\n"); for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { if vs[i].tys.len() > 0 { out.push_str(view_ty(t, vs[i].name.as_str()).as_str()); out.push_str(" = type { i64"); for k in 0..vs[i].tys.len() invariant 0 <= k && k <= vs[i].tys.len(), { out.push_str(", "); out.push_str(mem_ty(&vs[i].tys[k]).as_str()); } out.push_str(" }\n"); } for p in 0..vs[i].tys.len() invariant 0 <= p && p <= vs[i].tys.len(), { visit(&vs[i].tys[p], tb, seen, out, f - 1); } } },
        }
    }
}
