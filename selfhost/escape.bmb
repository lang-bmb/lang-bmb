#[summary("Escapes and their rationales in a checked program (port of stage0 compiler/src/escape.rs, ADR-0029 §1, §3): where they are, the hash a rationale is bound to, and whether the hash it carries is still that one. The rewriting of a rationale with another hash (stage0 with_hash) is not ported yet")]
mod escape {
    #[summary("The escapes of one definition (stage0 DefEscapes): the number of its `assume` statements, whether it is #[external_body], and its rationales")]
    struct DefEscapes { assumes: usize, external: bool, rationales: Vec<Rationale> }

    #[summary("What the hashes of rationales read (stage0 Hashes): the definitions with a body, at maps a path to its definition, and heads are the impl heads of the qualified text")]
    struct Hashes { defs: Vec<codegen::Def>, at: table::Table<usize>, heads: table::Table<String> }

    #[summary("One #[rationale(..)] (stage0 Rationale): where it is, its kind, and the hash it carries")]
    struct Rationale { span: source::Span, kind: Option<String>, hash: Option<String> }

    #[summary("The escapes in block b (block of stage0 of): an `assume` with its rationale, and every expression of every statement is entered in the order written")]
    #[effects(alloc)]
    fn block(b: &ast::Block, out: &mut DefEscapes, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..b.stmts.len()
            invariant 0 <= i && i <= b.stmts.len(),
        {
            match &b.stmts[i] {
                ast::Stmt::Let(l) => expr(&l.init, out, f - 1),
                ast::Stmt::Assign(a) => { expr(&a.target, out, f - 1); expr(&a.value, out, f - 1); },
                ast::Stmt::While(w) => { expr(&w.cond, out, f - 1); exprs(w.invariants.as_slice(), out, f - 1); match &w.measure { None => {}, Some(wm) => expr(wm, out, f - 1), } block(&w.body, out, f - 1); },
                ast::Stmt::For(x) => { expr(&x.lo, out, f - 1); expr(&x.hi, out, f - 1); exprs(x.invariants.as_slice(), out, f - 1); block(&x.body, out, f - 1); },
                ast::Stmt::Assert(at) => expr(&at.cond, out, f - 1),
                ast::Stmt::Assume(am) => { out.assumes = out.assumes.saturating_add(1); match &am.rationale { None => {}, Some(r) => out.rationales.push(rationale(r)), } expr(&am.cond, out, f - 1); },
                ast::Stmt::Proof(p) => block(&p.body, out, f - 1),
                ast::Stmt::LetFields(lf) => expr(&lf.init, out, f - 1),
                ast::Stmt::Expr(e) => expr(e, out, f - 1),
            }
        }
        match &b.tail {
            None => {},
            Some(t) => expr(&**t, out, f - 1),
        }
    }

    #[summary("Whether every rationale of e carries hash (stage0 confirmed, for a definition that has rationales)")]
    #[effects(pure)]
    fn confirmed(e: &DefEscapes, hash: &str) -> bool {
        for i in 0..e.rationales.len()
            invariant 0 <= i && i <= e.rationales.len(),
        {
            let same: bool = match &e.rationales[i].hash {
                None => false,
                Some(h) => h.as_str() == hash,
            };
            if !same {
                return false;
            }
        }
        true
    }

    #[summary("The escapes in expression e (expr of stage0 of): every expression inside it is entered in the order written, since a block with an `assume` can stand wherever an expression can")]
    #[effects(alloc)]
    fn expr(e: &ast::Expr, out: &mut DefEscapes, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match &e.kind {
            ast::ExprKind::Int(xv, xr) => {},
            ast::ExprKind::Float(xf) => {},
            ast::ExprKind::ByteLit(xb) => {},
            ast::ExprKind::ByteStr(xbs) => {},
            ast::ExprKind::StrLit(xs) => {},
            ast::ExprKind::CharLit(xc) => {},
            ast::ExprKind::Bool(xbo) => {},
            ast::ExprKind::Unit => {},
            ast::ExprKind::Var(var) => {},
            ast::ExprKind::Call(c) => exprs(c.args.as_slice(), out, f - 1),
            ast::ExprKind::Method(m) => { expr(&*m.recv, out, f - 1); exprs(m.args.as_slice(), out, f - 1); },
            ast::ExprKind::Index(ib, ii) => { expr(&**ib, out, f - 1); expr(&**ii, out, f - 1); },
            ast::ExprKind::Unary(uo, ux) => expr(&**ux, out, f - 1),
            ast::ExprKind::Binary(bo, bl, br) => { expr(&**bl, out, f - 1); expr(&**br, out, f - 1); },
            ast::ExprKind::Ref(rm, rx) => expr(&**rx, out, f - 1),
            ast::ExprKind::If(ife) => { expr(&*ife.cond, out, f - 1); block(&ife.then, out, f - 1); match &ife.els { None => {}, Some(el) => expr(&**el, out, f - 1), } },
            ast::ExprKind::Block(blk) => block(blk, out, f - 1),
            ast::ExprKind::Array(arr) => exprs(arr.as_slice(), out, f - 1),
            ast::ExprKind::Repeat(rp) => expr(&*rp.value, out, f - 1),
            ast::ExprKind::Old(ox) => expr(&**ox, out, f - 1),
            ast::ExprKind::Quant(qu) => expr(&*qu.body, out, f - 1),
            ast::ExprKind::Trigger(tx) => expr(&**tx, out, f - 1),
            ast::ExprKind::Closure(clo) => { exprs(clo.pre.as_slice(), out, f - 1); exprs(clo.post.as_slice(), out, f - 1); block(&clo.body, out, f - 1); },
            ast::ExprKind::StructLit(sl) => { for i in 0..sl.fields.len() invariant 0 <= i && i <= sl.fields.len(), { expr(&sl.fields[i].value, out, f - 1); } match &sl.rest { None => {}, Some(sr) => expr(&**sr, out, f - 1), } },
            ast::ExprKind::Path(pa) => {},
            ast::ExprKind::Deref(dx) => expr(&**dx, out, f - 1),
            ast::ExprKind::Field(fb, fname) => expr(&**fb, out, f - 1),
            ast::ExprKind::Match(ma) => { expr(&*ma.scrut, out, f - 1); for i in 0..ma.arms.len() invariant 0 <= i && i <= ma.arms.len(), { expr(&ma.arms[i].body, out, f - 1); } },
            ast::ExprKind::Return(ret) => { match ret { None => {}, Some(rv) => expr(&**rv, out, f - 1), } },
            ast::ExprKind::Try(trx) => expr(&**trx, out, f - 1),
            ast::ExprKind::Loop(lo) => { exprs(lo.invariants.as_slice(), out, f - 1); match &lo.measure { None => {}, Some(lm) => expr(&**lm, out, f - 1), } block(&lo.body, out, f - 1); },
            ast::ExprKind::Break(br2) => { match &br2.value { None => {}, Some(bv) => expr(&**bv, out, f - 1), } },
            ast::ExprKind::Continue(cl) => {},
            ast::ExprKind::Range(ra) => { expr(&*ra.lo, out, f - 1); expr(&*ra.hi, out, f - 1); },
            ast::ExprKind::Error => {},
        }
    }

    #[summary("The escapes in each expression of es, in order")]
    #[effects(alloc)]
    fn exprs(es: &[ast::Expr], out: &mut DefEscapes, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..es.len()
            invariant 0 <= i && i <= es.len(),
        {
            expr(&es[i], out, f - 1);
        }
    }

    #[summary("The hash every rationale of the definition at path is bound to (stage0 Hashes::of, ADR-0029 §3): of the definition's qualified normal form, which leaves rationales out, and the whole text of each `spec fn` it names, in path order; 16 hex digits of a SHA-256. None when the program has no such definition. pr is the printer of qualified texts (fmt::qualifying)")]
    #[effects(alloc)]
    fn hash_of(h: &Hashes, pr: &mut fmt::Printer, fns: &table::Table<types::FnSig>, path: &str) -> Option<String> {
        let k: usize = match h.at.find(path) {
            None => { return None; },
            Some(a) => h.at.items[a],
        };
        if k >= h.defs.len() {
            return None;
        }
        let own: String = fmt::qualified_text(pr, &h.heads, &h.defs[k].d, h.defs[k].unit.as_str(), true);
        let words: Vec<String> = body::sorted_set(words_of(own.as_str()).as_slice());
        let mut text: String = own.clone();
        for i in 0..words.len()
            invariant 0 <= i && i <= words.len(),
        {
            let named: bool = words[i].as_str() != path && (match fns.find(words[i].as_str()) { None => false, Some(s) => body::is_spec(fns.items[s].kind) && !fns.items[s].builtin, });
            if named {
                match h.at.find(words[i].as_str()) {
                    None => {},
                    Some(g) => { let n: usize = h.at.items[g]; if n < h.defs.len() { text.push_str("\n"); text.push_str(words[i].as_str()); text.push_str("\n"); let other: String = fmt::qualified_text(pr, &h.heads, &h.defs[n].d, h.defs[n].unit.as_str(), true); text.push_str(other.as_str()); } },
                }
            }
        }
        let full: String = identity::sha(text.as_str());
        Some(lexer::cut(full.as_str(), 7, 23))
    }

    #[summary("What the hashes of the rationales of a program read (stage0 Hashes::new): defs are its definitions with a body, a later one of the same path in place of an earlier one")]
    #[effects(alloc)]
    fn hashes(defs: &[codegen::Def], fns: &table::Table<types::FnSig>) -> Hashes {
        let mut at: table::Table<usize> = table::new::<usize>();
        let mut own: Vec<codegen::Def> = Vec::new();
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            at.insert(defs[i].path.as_str(), i);
            own.push(defs[i].clone());
        }
        Hashes { defs: own, at: at, heads: fmt::impl_heads(fns) }
    }

    #[summary("The escapes of definition d (stage0 of): its `assume` statements with their rationales, #[external_body], and its own #[rationale(..)], which comes first")]
    #[effects(alloc)]
    fn of(d: &ast::FnDef) -> DefEscapes {
        let mut out: DefEscapes = DefEscapes { assumes: 0, external: false, rationales: Vec::new() };
        let mut own: bool = false;
        for i in 0..d.attrs.len()
            invariant 0 <= i && i <= d.attrs.len(),
        {
            if d.attrs[i].name.name == "external_body" {
                out.external = true;
            }
            if !own && d.attrs[i].name.name == "rationale" {
                own = true;
                out.rationales.push(rationale(&d.attrs[i]));
            }
        }
        block(&d.body, &mut out, 1000000000);
        out
    }

    #[summary("The rationale attribute a read (stage0 rationale): `kind = K` with a name and `hash = \"..\"` with a string, the last of each")]
    #[effects(alloc)]
    fn rationale(a: &ast::Attr) -> Rationale {
        let mut kind: Option<String> = None;
        let mut hash: Option<String> = None;
        for i in 0..a.args.len()
            invariant 0 <= i && i <= a.args.len(),
        {
            match &a.args[i] {
                ast::AttrArg::Ident(id) => {},
                ast::AttrArg::Str(s, sp) => {},
                ast::AttrArg::Pair(k, v) => { match &**v { ast::AttrArg::Ident(vi) => { if k.name == "kind" { kind = Some(vi.name.clone()); } }, ast::AttrArg::Str(vs, vsp) => { if k.name == "hash" { hash = Some(vs.clone()); } }, ast::AttrArg::Pair(vk, vv) => {}, } },
            }
        }
        Rationale { span: a.span, kind: kind, hash: hash }
    }

    #[summary("The words of text: the longest runs of letters and digits (Unicode), `_` and `:` (the split of stage0 Hashes::of)")]
    #[effects(alloc)]
    fn words_of(text: &str) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        let mut from: usize = 0;
        let mut i: usize = 0;
        while i < text.len()
            invariant from <= i,
            decreases text.len() - i,
        {
            match std::str::decode_utf8(text, i) {
                None => { i = text.len(); },
                Some(dc) => { if dc.next <= i { i = text.len(); } else { let c: u32 = u32::from(dc.ch); if !(unicode::alphanumeric(c) || c == 95 || c == 58) { if from < i { out.push(lexer::cut(text, from, i)); } from = dc.next; } i = dc.next; } },
            }
        }
        if from < text.len() {
            out.push(lexer::cut(text, from, text.len()));
        }
        out
    }
}
