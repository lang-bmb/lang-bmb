#[summary("유니코드 글자 분류: Rust의 char::is_alphabetic·is_alphanumeric·is_whitespace와 같은 답. 표는 stage0을 짓는 Rust 도구 사슬(rust-toolchain.toml)의 것을 옮겼고 차등 시험 unicode-classes가 모든 코드 포인트에서 견준다 (백로그 4D-19)")]
mod unicode {
    #[summary("char::is_alphabetic: 유니코드 속성 Alphabetic")]
    #[effects(pure)]
    fn alphabetic(c: u32) -> bool {
        if c < 128 {
            return c >= 65 && c <= 90 || c >= 97 && c <= 122;
        }
        within(b"", c)
    }

    #[summary("char::is_alphanumeric")]
    #[effects(pure)]
    fn alphanumeric(c: u32) -> bool {
        alphabetic(c) || numeric(c)
    }

    #[summary("t의 p에서 시작하는 16진 여섯 자리의 값")]
    #[effects(pure)]
    fn hex_at(t: &[u8], p: usize) -> u32
        requires p + 6 <= t.len(),
    {
        let mut v: u32 = 0;
        let mut k: usize = 0;
        while k < 6
            invariant k <= 6, v < 16777216,
            decreases 6 - k,
        {
            let c: u8 = t[p + k];
            let mut d: u32 = 0;
            if c >= 48 && c <= 57 {
                d = (c - 48) as u32;
            } else if c >= 97 && c <= 102 {
                d = (c - 87) as u32;
            }
            v = v % 1048576 * 16 + d;
            k = k + 1;
        }
        v
    }

    #[summary("char::is_numeric: 일반 범주 Nd, Nl, No")]
    #[effects(pure)]
    fn numeric(c: u32) -> bool {
        if c < 128 {
            return c >= 48 && c <= 57;
        }
        within(b"", c)
    }

    #[summary("char::is_whitespace: 유니코드 속성 White_Space")]
    #[effects(pure)]
    fn whitespace(c: u32) -> bool {
        if c < 128 {
            return c >= 9 && c <= 13 || c == 32;
        }
        within(b"0000850000850000a00000a000168000168000200000200a00202800202900202f00202f00205f00205f003000003000", c)
    }

    #[summary("c가 표 t의 구간 가운데 하나에 드는가. t는 구간마다 처음과 끝(둘 다 포함)의 16진 여섯 자리, 오름차순")]
    #[effects(pure)]
    fn within(t: &[u8], c: u32) -> bool {
        let n: usize = t.len() / 12;
        let mut lo: usize = 0;
        let mut hi: usize = n;
        while lo < hi
            invariant hi <= n, n == t.len() / 12,
            decreases hi - lo,
        {
            let mid: usize = lo + (hi - lo) / 2;
            if c < hex_at(t, mid * 12) {
                hi = mid;
            } else if c > hex_at(t, mid * 12 + 6) {
                lo = mid + 1;
            } else {
                return true;
            }
        }
        false
    }
}
