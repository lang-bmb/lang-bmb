#[summary("Walks every position where the program refers to another definition by name and every declaration name (port of stage0 compiler/src/refs.rs). At each position the visitor can rewrite the name")]
mod refs {
    #[summary("The walking visitor (stage0's trait Rewrite)")]
    trait Rewrite {
        #[summary("Declaration name")]
        #[effects(alloc)]
        fn decl(self: &mut Self, unit: &[String], kind: DeclKind, owner: &[String], name: &mut ast::Ident) -> ();

        #[summary("Name of a method call x.f(..): refers to a function only through the receiver's type (ADR-0051)")]
        #[effects(alloc)]
        fn method(self: &mut Self, call: source::Span, name: &mut ast::Ident) -> ();

        #[summary("Path segs written at site site in unit unit, where type parameters tparams are visible. The segments and their number can be changed")]
        #[effects(alloc)]
        fn path(self: &mut Self, segs: &mut Vec<String>, site: Site, unit: &[String], tparams: &[String]) -> ();

        #[summary("Variable read")]
        #[effects(alloc)]
        fn var(self: &mut Self, name: &mut String) -> ();
    }

    #[summary("Kind of a declaration name met while walking. owner is the single name of the type for ImplFn, the single name of the trait for TraitFn, the trait path as written for TraitImplFn, and empty for the rest")]
    enum DeclKind { Fn, Type, ImplTy, ImplFn, Trait, TraitFn, TraitImplFn }

    #[summary("Site where a path is written: determines how the path can refer to a definition")]
    enum Site { Call, Type, Struct, Variant, Bound }

    #[summary("Where the walk is: the current unit and the visible type parameters")]
    struct Walker { unit: Vec<String>, tparams: Vec<String> }

    #[summary("The spec fns an attribute refers to (#[uses(..)], #[invariant(..)])")]
    #[effects(alloc)]
    fn attr_targets<R: Rewrite>(w: &Walker, r: &mut R, a: &mut ast::Attr) -> () {
        let n: usize = a.args.len();
        for i in 0..n
            invariant a.args.len() == n,
        {
            match &mut a.args[i] {
                ast::AttrArg::Ident(id) => { let mut s: Vec<String> = split_path(id.name.as_str()); r.path(&mut s, Site::Call, w.unit.as_slice(), w.tparams.as_slice()); id.name = join_path(s.as_slice()); },
                ast::AttrArg::Str(st, sp) => {},
                ast::AttrArg::Pair(pk, pv) => {},
            }
        }
    }

    #[summary("attr_targets for each attribute named name")]
    #[effects(alloc)]
    fn attrs_named<R: Rewrite>(w: &Walker, r: &mut R, attrs: &mut Vec<ast::Attr>, name: &str) -> () {
        let n: usize = attrs.len();
        for i in 0..n
            invariant attrs.len() == n,
        {
            if attrs[i].name.name.as_str() == name {
                attr_targets::<R>(w, r, &mut attrs[i]);
            }
        }
    }

    #[summary("Statements and tail expression of a block")]
    #[effects(alloc)]
    fn block<R: Rewrite>(w: &Walker, r: &mut R, b: &mut ast::Block, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = b.stmts.len();
        for i in 0..n
            invariant b.stmts.len() == n,
        {
            match &mut b.stmts[i] {
                ast::Stmt::Let(sl) => { ty::<R>(w, r, &mut sl.ty, f - 1); expr::<R>(w, r, &mut sl.init, f - 1); },
                ast::Stmt::Assign(sa) => { expr::<R>(w, r, &mut sa.target, f - 1); expr::<R>(w, r, &mut sa.value, f - 1); },
                ast::Stmt::While(sw) => { expr::<R>(w, r, &mut sw.cond, f - 1); exprs::<R>(w, r, &mut sw.invariants, f - 1); opt::<R>(w, r, &mut sw.measure, f - 1); block::<R>(w, r, &mut sw.body, f - 1); },
                ast::Stmt::For(sf) => { expr::<R>(w, r, &mut sf.lo, f - 1); expr::<R>(w, r, &mut sf.hi, f - 1); exprs::<R>(w, r, &mut sf.invariants, f - 1); block::<R>(w, r, &mut sf.body, f - 1); },
                ast::Stmt::Assert(st) => expr::<R>(w, r, &mut st.cond, f - 1),
                ast::Stmt::Assume(su) => expr::<R>(w, r, &mut su.cond, f - 1),
                ast::Stmt::Proof(sp) => block::<R>(w, r, &mut sp.body, f - 1),
                ast::Stmt::LetFields(lf) => { idents::<R>(w, r, &mut lf.path, Site::Struct); expr::<R>(w, r, &mut lf.init, f - 1); },
                ast::Stmt::Expr(se) => expr::<R>(w, r, se, f - 1),
            }
        }
        opt_box::<R>(w, r, &mut b.tail, f - 1);
    }

    #[summary("One expression and its inside")]
    #[effects(alloc)]
    fn expr<R: Rewrite>(w: &Walker, r: &mut R, e: &mut ast::Expr, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let span: source::Span = e.span;
        match &mut e.kind {
            ast::ExprKind::Int(iv, ir) => {},
            ast::ExprKind::Float(fb) => {},
            ast::ExprKind::ByteLit(by) => {},
            ast::ExprKind::ByteStr(bys) => {},
            ast::ExprKind::StrLit(st) => {},
            ast::ExprKind::CharLit(ch) => {},
            ast::ExprKind::Bool(bo) => {},
            ast::ExprKind::Unit => {},
            ast::ExprKind::Var(id) => r.var(&mut id.name),
            ast::ExprKind::Call(ca) => { let before: usize = ca.path.len(); idents::<R>(w, r, &mut ca.path, Site::Call); let after: usize = ca.path.len(); let nt: usize = ca.targs.len(); for i in 0..nt invariant ca.targs.len() == nt, { if after >= before { ca.targs[i].seg = ca.targs[i].seg.saturating_add(after - before); } else { ca.targs[i].seg = ca.targs[i].seg.saturating_sub(before - after); } } for j in 0..nt invariant ca.targs.len() == nt, { types::<R>(w, r, &mut ca.targs[j].args, f - 1); } exprs::<R>(w, r, &mut ca.args, f - 1); },
            ast::ExprKind::Method(me) => { r.method(span, &mut me.name); expr::<R>(w, r, &mut *me.recv, f - 1); exprs::<R>(w, r, &mut me.args, f - 1); },
            ast::ExprKind::Index(ib, ii) => { expr::<R>(w, r, &mut **ib, f - 1); expr::<R>(w, r, &mut **ii, f - 1); },
            ast::ExprKind::Unary(uo, ux) => expr::<R>(w, r, &mut **ux, f - 1),
            ast::ExprKind::Binary(bop, bl, br) => { expr::<R>(w, r, &mut **bl, f - 1); expr::<R>(w, r, &mut **br, f - 1); },
            ast::ExprKind::Ref(rm, rx) => expr::<R>(w, r, &mut **rx, f - 1),
            ast::ExprKind::If(ife) => { expr::<R>(w, r, &mut *ife.cond, f - 1); block::<R>(w, r, &mut ife.then, f - 1); opt_box::<R>(w, r, &mut ife.els, f - 1); },
            ast::ExprKind::Block(blk) => block::<R>(w, r, blk, f - 1),
            ast::ExprKind::Array(ar) => exprs::<R>(w, r, ar, f - 1),
            ast::ExprKind::Repeat(rp) => expr::<R>(w, r, &mut *rp.value, f - 1),
            ast::ExprKind::Old(ox) => expr::<R>(w, r, &mut **ox, f - 1),
            ast::ExprKind::Quant(qu) => { let nb: usize = qu.binders.len(); for k in 0..nb invariant qu.binders.len() == nb, { ty::<R>(w, r, &mut qu.binders[k].ty, f - 1); } expr::<R>(w, r, &mut *qu.body, f - 1); },
            ast::ExprKind::Trigger(tx) => expr::<R>(w, r, &mut **tx, f - 1),
            ast::ExprKind::Closure(cl) => {},
            ast::ExprKind::StructLit(sl) => { idents::<R>(w, r, &mut sl.path, Site::Struct); let nf: usize = sl.fields.len(); for q in 0..nf invariant sl.fields.len() == nf, { expr::<R>(w, r, &mut sl.fields[q].value, f - 1); } opt_box::<R>(w, r, &mut sl.rest, f - 1); },
            ast::ExprKind::Path(pa) => idents::<R>(w, r, pa, Site::Variant),
            ast::ExprKind::Deref(dx) => expr::<R>(w, r, &mut **dx, f - 1),
            ast::ExprKind::Field(fx, fnm) => expr::<R>(w, r, &mut **fx, f - 1),
            ast::ExprKind::Match(ma) => { expr::<R>(w, r, &mut *ma.scrut, f - 1); let na: usize = ma.arms.len(); for m in 0..na invariant ma.arms.len() == na, { idents::<R>(w, r, &mut ma.arms[m].pat.path, Site::Variant); expr::<R>(w, r, &mut ma.arms[m].body, f - 1); } },
            ast::ExprKind::Return(rv) => opt_box::<R>(w, r, rv, f - 1),
            ast::ExprKind::Try(tr) => expr::<R>(w, r, &mut **tr, f - 1),
            ast::ExprKind::Loop(lp) => { exprs::<R>(w, r, &mut lp.invariants, f - 1); opt_box::<R>(w, r, &mut lp.measure, f - 1); block::<R>(w, r, &mut lp.body, f - 1); },
            ast::ExprKind::Break(bk) => opt_box::<R>(w, r, &mut bk.value, f - 1),
            ast::ExprKind::Continue(co) => {},
            ast::ExprKind::Range(rg) => { expr::<R>(w, r, &mut *rg.lo, f - 1); expr::<R>(w, r, &mut *rg.hi, f - 1); },
            ast::ExprKind::Error => {},
        }
    }

    #[summary("Expressions in order")]
    #[effects(alloc)]
    fn exprs<R: Rewrite>(w: &Walker, r: &mut R, xs: &mut Vec<ast::Expr>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = xs.len();
        for i in 0..n
            invariant xs.len() == n,
        {
            expr::<R>(w, r, &mut xs[i], f - 1);
        }
    }

    #[summary("Functions: the declaration name to the visitor, then walks the function")]
    #[effects(alloc)]
    fn fns_decl<R: Rewrite>(w: &mut Walker, r: &mut R, fs: &mut Vec<ast::FnDef>, unit: &[String], kind: DeclKind, owner: &[String]) -> () {
        let n: usize = fs.len();
        for i in 0..n
            invariant fs.len() == n,
        {
            r.decl(unit, kind_copy(&kind), owner, &mut fs[i].name);
            function::<R>(w, r, &mut fs[i]);
        }
    }

    #[summary("One function: type parameters, #[uses], signature, contract, measure, body")]
    #[effects(alloc)]
    fn function<R: Rewrite>(w: &mut Walker, r: &mut R, d: &mut ast::FnDef) -> () {
        let depth: usize = w.tparams.len();
        generics::<R>(w, r, &mut d.generics);
        attrs_named::<R>(w, r, &mut d.attrs, "uses");
        let n: usize = d.params.len();
        for i in 0..n
            invariant d.params.len() == n,
        {
            ty::<R>(w, r, &mut d.params[i].ty, 1000000000);
        }
        ty::<R>(w, r, &mut d.ret.ty, 1000000000);
        exprs::<R>(w, r, &mut d.pre, 1000000000);
        exprs::<R>(w, r, &mut d.post, 1000000000);
        opt::<R>(w, r, &mut d.measure, 1000000000);
        block::<R>(w, r, &mut d.body, 1000000000);
        w.tparams.truncate(depth);
    }

    #[summary("Makes the type parameters visible and walks their bounds")]
    #[effects(alloc)]
    fn generics<R: Rewrite>(w: &mut Walker, r: &mut R, gs: &mut Vec<ast::TypeParam>) -> () {
        let n: usize = gs.len();
        for i in 0..n
            invariant gs.len() == n,
        {
            w.tparams.push(gs[i].name.name.clone());
            let nb: usize = gs[i].bounds.len();
            for j in 0..nb
                invariant gs.len() == n && gs[i].bounds.len() == nb,
            {
                idents::<R>(w, r, &mut gs[i].bounds[j], Site::Bound);
            }
        }
    }

    #[summary("Rewrites a path of names. Segments added in front take the position of the first segment")]
    #[effects(alloc)]
    fn idents<R: Rewrite>(w: &Walker, r: &mut R, path: &mut Vec<ast::Ident>, site: Site) -> () {
        let before: usize = path.len();
        let mut s: Vec<String> = Vec::new();
        for i in 0..before {
            s.push(path[i].name.clone());
        }
        r.path(&mut s, site, w.unit.as_slice(), w.tparams.as_slice());
        let after: usize = s.len();
        if after == before {
            for j in 0..before
                invariant path.len() == before && s.len() == before,
            {
                path[j].name = s[j].clone();
            }
            return;
        }
        let mut span: source::Span = source::Span { file: 0, lo: 0, hi: 0 };
        if before > 0 {
            span = path[0].span;
        }
        let mut out: Vec<ast::Ident> = Vec::new();
        for k in 0..after {
            out.push(ast::Ident { name: s[k].clone(), span: span });
        }
        *path = out;
    }

    #[summary("impl T { .. }: name of the type, type arguments, functions")]
    #[effects(alloc)]
    fn impl_block<R: Rewrite>(w: &mut Walker, r: &mut R, i: &mut ast::Impl, unit: &[String]) -> () {
        let none: Vec<String> = Vec::new();
        let mut owner: Vec<String> = Vec::new();
        owner.push(i.ty.name.clone());
        r.decl(unit, DeclKind::ImplTy, none.as_slice(), &mut i.ty);
        let depth: usize = w.tparams.len();
        generics::<R>(w, r, &mut i.generics);
        types::<R>(w, r, &mut i.ty_args, 1000000000);
        fns_decl::<R>(w, r, &mut i.fns, unit, DeclKind::ImplFn, owner.as_slice());
        w.tparams.truncate(depth);
    }

    #[summary("Text of the segments joined with ::")]
    #[effects(alloc)]
    fn join_path(s: &[String]) -> String {
        let mut out: String = String::new();
        for i in 0..s.len() {
            if i > 0 {
                out.push_str("::");
            }
            out.push_str(s[i].as_str());
        }
        out
    }

    #[effects(pure)]
    fn kind_copy(k: &DeclKind) -> DeclKind {
        match k {
            DeclKind::Fn => DeclKind::Fn,
            DeclKind::Type => DeclKind::Type,
            DeclKind::ImplTy => DeclKind::ImplTy,
            DeclKind::ImplFn => DeclKind::ImplFn,
            DeclKind::Trait => DeclKind::Trait,
            DeclKind::TraitFn => DeclKind::TraitFn,
            DeclKind::TraitImplFn => DeclKind::TraitImplFn,
        }
    }

    #[summary("Unit m and the units inside it: declarations and all references")]
    #[effects(alloc)]
    fn module<R: Rewrite>(w: &mut Walker, r: &mut R, m: &mut ast::Mod, prefix: &[String], f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mut unit: Vec<String> = Vec::new();
        for i in 0..prefix.len() {
            unit.push(prefix[i].clone());
        }
        unit.push(m.name.name.clone());
        let none: Vec<String> = Vec::new();
        let nm: usize = m.mods.len();
        for j in 0..nm
            invariant m.mods.len() == nm,
        {
            module::<R>(w, r, &mut m.mods[j], unit.as_slice(), f - 1);
        }
        let mut here: Vec<String> = Vec::new();
        for k in 0..unit.len() {
            here.push(unit[k].clone());
        }
        w.unit = here;
        fns_decl::<R>(w, r, &mut m.fns, unit.as_slice(), DeclKind::Fn, none.as_slice());
        let nty: usize = m.types.len();
        for b in 0..nty
            invariant m.types.len() == nty,
        {
            type_decl::<R>(w, r, &mut m.types[b], unit.as_slice());
        }
        let ni: usize = m.impls.len();
        for c in 0..ni
            invariant m.impls.len() == ni,
        {
            impl_block::<R>(w, r, &mut m.impls[c], unit.as_slice());
        }
        let nti: usize = m.trait_impls.len();
        for e in 0..nti
            invariant m.trait_impls.len() == nti,
        {
            trait_impl_block::<R>(w, r, &mut m.trait_impls[e], unit.as_slice());
        }
        let ntr: usize = m.traits.len();
        for p in 0..ntr
            invariant m.traits.len() == ntr,
        {
            trait_block::<R>(w, r, &mut m.traits[p], unit.as_slice());
        }
    }

    #[summary("The expression, if present")]
    #[effects(alloc)]
    fn opt<R: Rewrite>(w: &Walker, r: &mut R, o: &mut Option<ast::Expr>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match o {
            None => {},
            Some(x) => expr::<R>(w, r, x, f - 1),
        }
    }

    #[summary("The expression, if present")]
    #[effects(alloc)]
    fn opt_box<R: Rewrite>(w: &Walker, r: &mut R, o: &mut Option<Box<ast::Expr>>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match o {
            None => {},
            Some(x) => expr::<R>(w, r, &mut **x, f - 1),
        }
    }

    #[summary("a::b::c into segments (same as Rust's split(\"::\"): an empty text is one empty segment)")]
    #[effects(alloc)]
    fn split_path(s: &str) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        let mut start: usize = 0;
        let mut i: usize = 0;
        while i < s.len()
            invariant start <= i,
            decreases s.len() - i,
        {
            if i + 1 < s.len() && s.as_bytes()[i] == 58 && s.as_bytes()[i + 1] == 58 {
                out.push(lexer::cut(s, start, i));
                i = i + 2;
                start = i;
            } else {
                i = i + 1;
            }
        }
        out.push(lexer::cut(s, start, s.len()));
        out
    }

    #[summary("trait declaration: name and methods")]
    #[effects(alloc)]
    fn trait_block<R: Rewrite>(w: &mut Walker, r: &mut R, t: &mut ast::TraitDef, unit: &[String]) -> () {
        let none: Vec<String> = Vec::new();
        let mut tname: Vec<String> = Vec::new();
        tname.push(t.name.name.clone());
        r.decl(unit, DeclKind::Trait, none.as_slice(), &mut t.name);
        let n: usize = t.fns.len();
        for q in 0..n
            invariant t.fns.len() == n,
        {
            r.decl(unit, DeclKind::TraitFn, tname.as_slice(), &mut t.fns[q].f.name);
            function::<R>(w, r, &mut t.fns[q].f);
        }
    }

    #[summary("impl Trait for T { .. }: path of the trait, type, functions (owner is the trait path as written)")]
    #[effects(alloc)]
    fn trait_impl_block<R: Rewrite>(w: &mut Walker, r: &mut R, i: &mut ast::TraitImpl, unit: &[String]) -> () {
        let depth: usize = w.tparams.len();
        generics::<R>(w, r, &mut i.generics);
        let mut written: Vec<String> = Vec::new();
        for g in 0..i.trait_path.len() {
            written.push(i.trait_path[g].name.clone());
        }
        idents::<R>(w, r, &mut i.trait_path, Site::Bound);
        ty::<R>(w, r, &mut i.self_ty, 1000000000);
        fns_decl::<R>(w, r, &mut i.fns, unit, DeclKind::TraitImplFn, written.as_slice());
        w.tparams.truncate(depth);
    }

    #[summary("One type and its inside")]
    #[effects(alloc)]
    fn ty<R: Rewrite>(w: &Walker, r: &mut R, t: &mut ast::Type, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match &mut t.kind {
            ast::TypeKind::Int(it) => {},
            ast::TypeKind::F64 => {},
            ast::TypeKind::Bool => {},
            ast::TypeKind::Unit => {},
            ast::TypeKind::Char => {},
            ast::TypeKind::String => {},
            ast::TypeKind::Str => {},
            ast::TypeKind::Array(ae, an) => ty::<R>(w, r, &mut **ae, f - 1),
            ast::TypeKind::ArrayN(ne, nn) => {},
            ast::TypeKind::Slice(se) => ty::<R>(w, r, &mut **se, f - 1),
            ast::TypeKind::Ref(rm, ri) => ty::<R>(w, r, &mut **ri, f - 1),
            ast::TypeKind::Named(path, args) => { r.path(path, Site::Type, w.unit.as_slice(), w.tparams.as_slice()); types::<R>(w, r, args, f - 1); },
            ast::TypeKind::Vec(ve) => ty::<R>(w, r, &mut **ve, f - 1),
            ast::TypeKind::Box(be) => ty::<R>(w, r, &mut **be, f - 1),
            ast::TypeKind::Param(pn) => {},
            ast::TypeKind::Never => {},
            ast::TypeKind::Error => {},
        }
    }

    #[summary("Types of the fields and payloads of a type declaration")]
    #[effects(alloc)]
    fn type_body<R: Rewrite>(w: &Walker, r: &mut R, k: &mut ast::TypeDefKind) -> () {
        match k {
            ast::TypeDefKind::Struct(fs) => { let n: usize = fs.len(); for i in 0..n invariant fs.len() == n, { ty::<R>(w, r, &mut fs[i].ty, 1000000000); } },
            ast::TypeDefKind::Enum(vs) => { let nv: usize = vs.len(); for j in 0..nv invariant vs.len() == nv, { types::<R>(w, r, &mut vs[j].payload, 1000000000); } },
        }
    }

    #[summary("Type declaration: name, predicate of #[invariant], types of the fields and payloads")]
    #[effects(alloc)]
    fn type_decl<R: Rewrite>(w: &mut Walker, r: &mut R, td: &mut ast::TypeDef, unit: &[String]) -> () {
        let none: Vec<String> = Vec::new();
        r.decl(unit, DeclKind::Type, none.as_slice(), &mut td.name);
        attrs_named::<R>(w, r, &mut td.attrs, "invariant");
        let depth: usize = w.tparams.len();
        generics::<R>(w, r, &mut td.generics);
        type_body::<R>(w, r, &mut td.kind);
        w.tparams.truncate(depth);
    }

    #[summary("Types in order")]
    #[effects(alloc)]
    fn types<R: Rewrite>(w: &Walker, r: &mut R, ts: &mut Vec<ast::Type>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = ts.len();
        for i in 0..n
            invariant ts.len() == n,
        {
            ty::<R>(w, r, &mut ts[i], f - 1);
        }
    }

    #[summary("Walks every unit of the program with visitor r")]
    #[effects(alloc)]
    fn walk<R: Rewrite>(p: &mut ast::Program, r: &mut R) -> () {
        let mut w: Walker = Walker { unit: Vec::new(), tparams: Vec::new() };
        let none: Vec<String> = Vec::new();
        let n: usize = p.mods.len();
        for i in 0..n
            invariant p.mods.len() == n,
        {
            module::<R>(&mut w, r, &mut p.mods[i], none.as_slice(), 1000000000);
        }
    }

    #[summary("Walks one function of unit with visitor r")]
    #[effects(alloc)]
    fn walk_fn<R: Rewrite>(d: &mut ast::FnDef, unit: &[String], r: &mut R) -> () {
        let mut here: Vec<String> = Vec::new();
        for i in 0..unit.len() {
            here.push(unit[i].clone());
        }
        let mut w: Walker = Walker { unit: here, tparams: Vec::new() };
        function::<R>(&mut w, r, d);
    }
}
