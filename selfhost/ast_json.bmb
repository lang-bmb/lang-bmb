                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); let one: ast::AttrArg = self.attr_arg(&xs[j], f - 1)?; out.push(one); self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("An attribute from its members name and args")]
        #[effects(alloc)]
        fn attr_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Attr, String>
            decreases f,
