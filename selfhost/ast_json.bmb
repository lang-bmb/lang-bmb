        #[effects(alloc)]
        fn types(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::TypeDef>, String>
            decreases f,
        {
            let mut out: Vec<ast::TypeDef> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Array(a0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Object(ms) => { self.keys_ok(ms.as_slice(), k)?; for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { self.down(k); self.down(ms[j].key.as_str()); let one: ast::TypeDef = self.type_def(ms[j].key.as_str(), &ms[j].value, f - 1)?; out.push(one); self.up(); self.up(); } },
                }
            }
            Ok(out)
        }

