                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a pattern (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a pattern (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a pattern (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a pattern (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a pattern (an object)")),
                json::Value::Object(o) => self.pat_of(o.as_slice(), f - 1),
            }
        }

        #[summary("A pattern from its members path and binds")]
        #[effects(alloc)]
        fn pat_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Pat, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a pattern", "path, binds")?;
            let path: Vec<ast::Ident> = self.path(kv, "path")?;
            let binds: Vec<Option<ast::Ident>> = self.binds(kv, "binds")?;
            let parens: bool = binds.len() > 0;
            Ok(ast::Pat { path: path, binds: binds, parens: parens, origin: ast::PatOrigin::Written, span: sp() })
        }

        #[summary("The member k as a path")]
        #[effects(alloc)]
        fn path(self: &Im, kv: &[json::Member], k: &str) -> Result<Vec<ast::Ident>, String> {
            let p: String = self.string(kv, k)?;
            self.path_of(k, p.as_str())
        }

        #[summary("The path p, names joined by ::, under the member k")]
        #[effects(alloc)]
        fn path_of(self: &Im, k: &str, p: &str) -> Result<Vec<ast::Ident>, String> {
            let segs: Vec<String> = refs::split_path(p);
            if !names(segs.as_slice()) {
                return Err(self.fail_at(k, types::cat3("`", p, "` is not a path (names joined by `::`)").as_str()));
            }
            Ok(ids(segs.as_slice()))
        }

        #[summary("The payload types of a variant")]
        #[effects(alloc)]
        fn payload(self: &mut Im, name: &str, v: &json::Value, f: usize) -> Result<ast::Variant, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut out: Vec<ast::Type> = Vec::new();
            match v {
                json::Value::Null => { return Err(self.fail("expected the payload types (an array, empty for a unit variant)")); },
                json::Value::Bool(b0) => { return Err(self.fail("expected the payload types (an array, empty for a unit variant)")); },
                json::Value::Num(n0) => { return Err(self.fail("expected the payload types (an array, empty for a unit variant)")); },
                json::Value::Str(s0) => { return Err(self.fail("expected the payload types (an array, empty for a unit variant)")); },
                json::Value::Array(xs) => { for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); let one: ast::Type = self.ty(&xs[j], f - 1)?; out.push(one); self.up(); } },
                json::Value::Object(o0) => { return Err(self.fail("expected the payload types (an array, empty for a unit variant)")); },
            }
            Ok(ast::Variant { name: id(name), payload: out, span: sp() })
        }

        #[summary("The place of the member k, which must be there")]
        #[effects(alloc)]
        fn req(self: &Im, kv: &[json::Member], k: &str) -> (r: Result<usize, String>)
            ensures match r { Ok(i) => i < kv.len(), Err(e) => true, },
        {
            let i: usize = at(kv, k);
            if i < kv.len() {
                Ok(i)
            } else {
                Err(self.fail(types::cat3("missing field `", k, "`").as_str()))
            }
        }

        #[summary("A return type from the object v")]
        #[effects(alloc)]
        fn ret(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Ret, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a return type (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a return type (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a return type (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a return type (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a return type (an object)")),
                json::Value::Object(o) => self.ret_of(o.as_slice(), f - 1),
            }
        }

        #[summary("A return type from its members name and ty")]
        #[effects(alloc)]
        fn ret_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Ret, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a return type", "name, ty")?;
            let mut name: Option<ast::Ident> = None;
            if at(kv, "name") < kv.len() {
                let n: ast::Ident = self.name(kv, "name")?;
                name = Some(n);
            }
            let ty: ast::Type = self.field_ty(kv, "ty", f - 1)?;
            Ok(ast::Ret { name: name, ty: ty })
        }

        #[summary("A statement from the object v by its kind")]
        #[effects(alloc)]
        fn stmt(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Stmt, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a statement (an object with a `kind`)")),
                json::Value::Bool(b0) => Err(self.fail("expected a statement (an object with a `kind`)")),
                json::Value::Num(n0) => Err(self.fail("expected a statement (an object with a `kind`)")),
                json::Value::Str(s0) => Err(self.fail("expected a statement (an object with a `kind`)")),
                json::Value::Array(a0) => Err(self.fail("expected a statement (an object with a `kind`)")),
                json::Value::Object(o) => self.stmt_of(o.as_slice(), f - 1),
            }
        }

        #[summary("A statement from its members")]
        #[effects(alloc)]
        fn stmt_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Stmt, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let k: String = self.kind(kv, "a statement")?;
            if k == "let" {
                self.check(kv, "a `let`", "kind, mutable, name, ty, init")?;
                let mutable: bool = self.flag(kv, "mutable")?;
                let name: ast::Ident = self.name(kv, "name")?;
                let ty: ast::Type = self.field_ty(kv, "ty", f - 1)?;
                let init: ast::Expr = self.field_expr(kv, "init", f - 1)?;
                return Ok(ast::Stmt::Let(ast::Let { mutable: mutable, name: name, ty: ty, ty_missing: false, init: init, span: sp() }));
            }
            if k == "assign" {
                self.check(kv, "an assignment", "kind, target, value")?;
                let target: ast::Expr = self.field_expr(kv, "target", f - 1)?;
                let value: ast::Expr = self.field_expr(kv, "value", f - 1)?;
                return Ok(ast::Stmt::Assign(ast::Assign { target: target, value: value, span: sp() }));
            }
            if k == "while" {
                self.check(kv, "a `while`", "kind, label, cond, invariants, decreases, body")?;
                let wlabel: Option<ast::Ident> = self.label(kv)?;
                let wcond: ast::Expr = self.field_expr(kv, "cond", f - 1)?;
                let winv: Vec<ast::Expr> = self.exprs(kv, "invariants", f - 1)?;
                let wmeasure: Option<ast::Expr> = self.opt_expr(kv, "decreases", f - 1)?;
                let wbody: ast::Block = self.field_block(kv, "body", f - 1)?;
                return Ok(ast::Stmt::While(ast::While { label: wlabel, cond: wcond, invariants: winv, measure: wmeasure, body: wbody, span: sp() }));
            }
            if k == "for" {
                self.check(kv, "a `for`", "kind, label, var, lo, hi, inclusive, invariants, body")?;
                let flabel: Option<ast::Ident> = self.label(kv)?;
                let var: ast::Ident = self.name(kv, "var")?;
                let lo: ast::Expr = self.field_expr(kv, "lo", f - 1)?;
                let hi: ast::Expr = self.field_expr(kv, "hi", f - 1)?;
                let inclusive: bool = self.flag(kv, "inclusive")?;
                let finv: Vec<ast::Expr> = self.exprs(kv, "invariants", f - 1)?;
                let fbody: ast::Block = self.field_block(kv, "body", f - 1)?;
                return Ok(ast::Stmt::For(ast::For { label: flabel, var: var, lo: lo, hi: hi, inclusive: inclusive, invariants: finv, body: fbody, span: sp() }));
            }
            if k == "assert" {
                self.check(kv, "an `assert`", "kind, cond, by")?;
                let mut by: Option<ast::Prover> = None;
                if at(kv, "by") < kv.len() {
                    let b: String = self.string(kv, "by")?;
                    if b != "bit_vector" {
                        return Err(self.fail_at("by", types::cat3("unknown prover `", b.as_str(), "` (bit_vector)").as_str()));
                    }
                    by = Some(ast::Prover::BitVector);
                }
                let acond: ast::Expr = self.field_expr(kv, "cond", f - 1)?;
                return Ok(ast::Stmt::Assert(ast::Assert { cond: acond, by: by, span: sp() }));
            }
            if k == "assume" {
                self.check(kv, "an `assume`", "kind, cond, rationale")?;
                let mut rationale: Option<ast::Attr> = None;
                if at(kv, "rationale") < kv.len() {
                    let rargs: Vec<ast::AttrArg> = self.attr_args(kv, "rationale", f - 1)?;
                    rationale = Some(ast::Attr { name: id("rationale"), args: rargs, span: sp() });
                }
                let ucond: ast::Expr = self.field_expr(kv, "cond", f - 1)?;
                return Ok(ast::Stmt::Assume(ast::Assume { cond: ucond, rationale: rationale, span: sp() }));
            }
            if k == "proof" {
                self.check(kv, "a `proof` block", "kind, body")?;
                let pbody: ast::Block = self.field_block(kv, "body", f - 1)?;
                return Ok(ast::Stmt::Proof(ast::ProofBlock { body: pbody, span: sp() }));
            }
            if k == "expr" {
                self.check(kv, "an expression statement", "kind, expr")?;
                let e: ast::Expr = self.field_expr(kv, "expr", f - 1)?;
                return Ok(ast::Stmt::Expr(e));
            }
            Err(self.fail(types::cat3("unknown statement kind `", k.as_str(), "` (let, assign, while, for, assert, proof, expr)").as_str()))
        }

