#[summary("The syntax tree as a JSON document (port of stage0 compiler/src/ast_json.rs, ADR-0073): writing a program as the document, reading a document back into a program, the pointer of the node at a span, and JSON Pointer and JSON Patch over the value tree. The document is an object keyed by top-level unit name; units, traits, types, impls and functions are objects keyed by name, every other node an object whose kind says what it is; spans are not part of it")]
mod ast_json {
    #[summary("The writer of the document (stage0 Ex): the pointer segments of the node being written, the spans recorded with their pointers when rec is set, and the repeat counts written as a constant's name, by the key of their span (Mod::lens)")]
    struct Ex { at: Vec<String>, rec: bool, spans: Vec<Mark>, lens: table::Table<String> }

    impl Ex {
        #[summary("One arm of a match: its pattern (path and binds) and its body. An arm the parser made is refused")]
        #[effects(alloc)]
        fn arm(self: &mut Ex, a: &ast::Arm, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(a.span);
            match &a.pat.origin {
                ast::PatOrigin::Written => {},
                ast::PatOrigin::IfLetElse => { return Err(self.fail("this arm is not part of the language (one arm per variant)")); },
                ast::PatOrigin::Rejected => { return Err(self.fail("this arm is not part of the language (one arm per variant)")); },
            }
            self.down("pat");
            self.mark(a.pat.span);
            let mut pkv: Vec<json::Member> = Vec::new();
            put(&mut pkv, "path", s(path_text(a.pat.path.as_slice()).as_str()));
            if a.pat.binds.len() > 0 {
                let mut bs: Vec<json::Value> = Vec::new();
                for i in 0..a.pat.binds.len()
                    invariant 0 <= i && i <= a.pat.binds.len(),
                {
                    match &a.pat.binds[i] {
                        None => bs.push(s("_")),
                        Some(b) => bs.push(s(b.name.as_str())),
                    }
                }
                put(&mut pkv, "binds", json::Value::Array(bs));
            }
            self.up();
            let mut kv: Vec<json::Member> = Vec::new();
            put(&mut kv, "pat", json::Value::Object(pkv));
            self.sub(&mut kv, "body", &a.body, f - 1)?;
            Ok(json::Value::Object(kv))
        }

        #[summary("The attributes as a list of objects with name and, when there are some, args")]
        #[effects(alloc)]
        fn attrs(self: &mut Ex, attrs: &[ast::Attr]) -> json::Value {
            let mut out: Vec<json::Value> = Vec::new();
            self.down("attrs");
            for i in 0..attrs.len()
                invariant 0 <= i && i <= attrs.len(),
            {
                self.down_n(i);
                self.mark(attrs[i].span);
                let mut kv: Vec<json::Member> = Vec::new();
                put(&mut kv, "name", s(attrs[i].name.name.as_str()));
                if attrs[i].args.len() > 0 {
                    put(&mut kv, "args", attr_args(attrs[i].args.as_slice()));
                }
                out.push(json::Value::Object(kv));
                self.up();
            }
            self.up();
            json::Value::Array(out)
        }

        #[summary("A block as an object with stmts and tail")]
        #[effects(alloc)]
        fn block(self: &mut Ex, b: &ast::Block, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(b.span);
            let mut kv: Vec<json::Member> = Vec::new();
            self.block_fields(&mut kv, b, f - 1)?;
            Ok(json::Value::Object(kv))
        }

        #[summary("The members stmts and tail of a block, each left out when empty or absent")]
        #[effects(alloc)]
        fn block_fields(self: &mut Ex, kv: &mut Vec<json::Member>, b: &ast::Block, f: usize) -> Result<(), String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            if b.stmts.len() > 0 {
                let mut out: Vec<json::Value> = Vec::new();
                self.down("stmts");
                for i in 0..b.stmts.len()
                    invariant 0 <= i && i <= b.stmts.len(),
                {
                    self.down_n(i);
                    let one: json::Value = self.stmt(&b.stmts[i], f - 1)?;
                    out.push(one);
                    self.up();
                }
                self.up();
                put(kv, "stmts", json::Value::Array(out));
            }
            match &b.tail {
                None => {},
                Some(t) => { self.sub(kv, "tail", &**t, f - 1)?; },
            }
            Ok(())
        }

        #[summary("Enters the member or element seg")]
        #[effects(alloc)]
        fn down(self: &mut Ex, seg: &str) -> () {
            self.at.push(String::from(seg));
        }

        #[summary("Enters element k of a list")]
        #[effects(alloc)]
        fn down_n(self: &mut Ex, k: usize) -> () {
            self.at.push(index_text(k));
        }

        #[summary("An expression as an object with its kind")]
        #[effects(alloc)]
        fn expr(self: &mut Ex, x: &ast::Expr, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(x.span);
            let mut kv: Vec<json::Member> = Vec::new();
            match &x.kind {
                ast::ExprKind::Int(iv, ir) => { kind(&mut kv, "int"); put(&mut kv, "value", json::Value::Num(ast::radix_text(ast::Radix::Dec, *iv))); match ir { ast::Radix::Dec => {}, ast::Radix::Hex => put(&mut kv, "radix", s("hex")), ast::Radix::Oct => put(&mut kv, "radix", s("oct")), ast::Radix::Bin => put(&mut kv, "radix", s("bin")), } },
                ast::ExprKind::Float(fb) => { kind(&mut kv, "float"); put(&mut kv, "value", json::Value::Num(lexer::float_text(*fb))); },
                ast::ExprKind::ByteLit(by) => { kind(&mut kv, "byte"); put(&mut kv, "value", num(*by as u64)); },
                ast::ExprKind::ByteStr(bys) => { kind(&mut kv, "bytes"); let mut bs: Vec<json::Value> = Vec::new(); for bi in 0..bys.len() invariant 0 <= bi && bi <= bys.len(), { bs.push(num(bys[bi] as u64)); } put(&mut kv, "value", json::Value::Array(bs)); },
                ast::ExprKind::StrLit(st) => { kind(&mut kv, "str"); put(&mut kv, "value", s(st.as_str())); },
                ast::ExprKind::CharLit(ch) => { kind(&mut kv, "char"); put(&mut kv, "value", num(*ch as u64)); },
                ast::ExprKind::Bool(bo) => { kind(&mut kv, "bool"); put(&mut kv, "value", json::Value::Bool(*bo)); },
                ast::ExprKind::Unit => kind(&mut kv, "unit"),
                ast::ExprKind::Var(id) => { kind(&mut kv, "var"); put(&mut kv, "name", s(id.name.as_str())); },
                ast::ExprKind::Call(ca) => { kind(&mut kv, "call"); put(&mut kv, "path", s(path_text(ca.path.as_slice()).as_str())); if ca.targs.len() > 0 { let mut tas: Vec<json::Value> = Vec::new(); self.down("targs"); for ti in 0..ca.targs.len() invariant 0 <= ti && ti <= ca.targs.len(), { self.down_n(ti); let mut tkv: Vec<json::Member> = Vec::new(); put(&mut tkv, "seg", num(ca.targs[ti].seg as u64)); let targ: json::Value = self.tys("args", ca.targs[ti].args.as_slice(), f - 1)?; put(&mut tkv, "args", targ); tas.push(json::Value::Object(tkv)); self.up(); } self.up(); put(&mut kv, "targs", json::Value::Array(tas)); } self.exprs(&mut kv, "args", ca.args.as_slice(), f - 1)?; },
                ast::ExprKind::Method(me) => { kind(&mut kv, "method"); self.sub(&mut kv, "recv", &*me.recv, f - 1)?; put(&mut kv, "name", s(me.name.name.as_str())); self.exprs(&mut kv, "args", me.args.as_slice(), f - 1)?; },
                ast::ExprKind::Index(ib, ii) => { kind(&mut kv, "index"); self.sub(&mut kv, "base", &**ib, f - 1)?; self.sub(&mut kv, "index", &**ii, f - 1)?; },
                ast::ExprKind::Unary(uo, ux) => { kind(&mut kv, "unary"); match uo { ast::UnOp::Neg => put(&mut kv, "op", s("-")), ast::UnOp::Not => put(&mut kv, "op", s("!")), } self.sub(&mut kv, "expr", &**ux, f - 1)?; },
                ast::ExprKind::Binary(bop, bl, br) => { kind(&mut kv, "binary"); let mut sym: String = String::new(); ast::push_bin_symbol(&mut sym, bop); put(&mut kv, "op", json::Value::Str(sym)); self.sub(&mut kv, "lhs", &**bl, f - 1)?; self.sub(&mut kv, "rhs", &**br, f - 1)?; },
                ast::ExprKind::Ref(rm, rx) => { kind(&mut kv, "ref"); if *rm { put(&mut kv, "mutable", json::Value::Bool(true)); } self.sub(&mut kv, "expr", &**rx, f - 1)?; },
                ast::ExprKind::If(ife) => { kind(&mut kv, "if"); self.sub(&mut kv, "cond", &*ife.cond, f - 1)?; self.sub_block(&mut kv, "then", &ife.then, f - 1)?; match &ife.els { None => {}, Some(el) => { self.sub(&mut kv, "else", &**el, f - 1)?; }, } },
                ast::ExprKind::Block(blk) => { kind(&mut kv, "block"); self.block_fields(&mut kv, blk, f - 1)?; },
                ast::ExprKind::Array(ar) => { kind(&mut kv, "array"); self.exprs(&mut kv, "elems", ar.as_slice(), f - 1)?; },
                ast::ExprKind::Repeat(rp) => { kind(&mut kv, "repeat"); self.sub(&mut kv, "value", &*rp.value, f - 1)?; match self.lens.find(span_key(rp.count_span).as_str()) { None => put(&mut kv, "count", json::Value::Num(ast::radix_text(ast::Radix::Dec, rp.count))), Some(li) => put(&mut kv, "count_const", json::Value::Str(self.lens.items[li].clone())), } },
                ast::ExprKind::Old(ox) => { kind(&mut kv, "old"); self.sub(&mut kv, "expr", &**ox, f - 1)?; },
                ast::ExprKind::Quant(qu) => { match &qu.q { ast::Quantifier::Forall => kind(&mut kv, "forall"), ast::Quantifier::Exists => kind(&mut kv, "exists"), } let binders: json::Value = self.params("binders", qu.binders.as_slice(), f - 1)?; put(&mut kv, "binders", binders); self.sub(&mut kv, "body", &*qu.body, f - 1)?; },
                ast::ExprKind::Trigger(tx) => { kind(&mut kv, "trigger"); self.sub(&mut kv, "expr", &**tx, f - 1)?; },
                ast::ExprKind::Closure(cl) => { kind(&mut kv, "closure"); if cl.is_move { put(&mut kv, "move", json::Value::Bool(true)); } if cl.params.len() > 0 { let cps: json::Value = self.params("params", cl.params.as_slice(), f - 1)?; put(&mut kv, "params", cps); } self.ret(&mut kv, &cl.ret, f - 1)?; self.exprs(&mut kv, "requires", cl.pre.as_slice(), f - 1)?; self.exprs(&mut kv, "ensures", cl.post.as_slice(), f - 1)?; self.sub_block(&mut kv, "body", &cl.body, f - 1)?; },
                ast::ExprKind::StructLit(sl) => { if fmt::is_some_box(&sl.rest) { return Err(self.fail("`..base` is not part of the language")); } kind(&mut kv, "struct"); put(&mut kv, "path", s(path_text(sl.path.as_slice()).as_str())); let mut fkv: Vec<json::Member> = Vec::new(); self.down("fields"); for fi in 0..sl.fields.len() invariant 0 <= fi && fi <= sl.fields.len(), { if at(fkv.as_slice(), sl.fields[fi].name.name.as_str()) < fkv.len() { return Err(self.fail(types::cat3("field `", sl.fields[fi].name.name.as_str(), "` given twice").as_str())); } self.down(sl.fields[fi].name.name.as_str()); let fv: json::Value = self.expr(&sl.fields[fi].value, f - 1)?; self.up(); put(&mut fkv, sl.fields[fi].name.name.as_str(), fv); } self.up(); put(&mut kv, "fields", json::Value::Object(fkv)); },
                ast::ExprKind::Path(pa) => { kind(&mut kv, "path"); put(&mut kv, "path", s(path_text(pa.as_slice()).as_str())); },
                ast::ExprKind::Deref(dx) => { kind(&mut kv, "deref"); self.sub(&mut kv, "expr", &**dx, f - 1)?; },
                ast::ExprKind::Field(fx, fnm) => { kind(&mut kv, "field"); self.sub(&mut kv, "base", &**fx, f - 1)?; put(&mut kv, "name", s(fnm.name.as_str())); },
                ast::ExprKind::Match(ma) => { kind(&mut kv, "match"); self.sub(&mut kv, "scrut", &*ma.scrut, f - 1)?; let mut arms: Vec<json::Value> = Vec::new(); self.down("arms"); for ai in 0..ma.arms.len() invariant 0 <= ai && ai <= ma.arms.len(), { self.down_n(ai); let arm: json::Value = self.arm(&ma.arms[ai], f - 1)?; arms.push(arm); self.up(); } self.up(); put(&mut kv, "arms", json::Value::Array(arms)); },
                ast::ExprKind::Return(rv) => { kind(&mut kv, "return"); match rv { None => {}, Some(rx2) => { self.sub(&mut kv, "value", &**rx2, f - 1)?; }, } },
                ast::ExprKind::Try(tr) => { kind(&mut kv, "try"); self.sub(&mut kv, "expr", &**tr, f - 1)?; },
                ast::ExprKind::Loop(lp) => { kind(&mut kv, "loop"); label(&mut kv, &lp.label); self.exprs(&mut kv, "invariants", lp.invariants.as_slice(), f - 1)?; match &lp.measure { None => {}, Some(lm) => { self.sub(&mut kv, "decreases", &**lm, f - 1)?; }, } self.sub_block(&mut kv, "body", &lp.body, f - 1)?; },
                ast::ExprKind::Break(bk) => { kind(&mut kv, "break"); label(&mut kv, &bk.label); match &bk.value { None => {}, Some(bv) => { self.sub(&mut kv, "value", &**bv, f - 1)?; }, } },
                ast::ExprKind::Continue(co) => { kind(&mut kv, "continue"); label(&mut kv, co); },
                ast::ExprKind::Range(rg) => { kind(&mut kv, "range"); self.sub(&mut kv, "lo", &*rg.lo, f - 1)?; self.sub(&mut kv, "hi", &*rg.hi, f - 1)?; },
                ast::ExprKind::Error => { return Err(self.fail("not an expression of the language")); },
            }
            Ok(json::Value::Object(kv))
        }

        #[summary("The member field with the list of xs, left out when there is none")]
        #[effects(alloc)]
        fn exprs(self: &mut Ex, kv: &mut Vec<json::Member>, field: &str, xs: &[ast::Expr], f: usize) -> Result<(), String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            if xs.len() > 0 {
                let mut out: Vec<json::Value> = Vec::new();
                self.down(field);
                for i in 0..xs.len()
                    invariant 0 <= i && i <= xs.len(),
                {
                    self.down_n(i);
                    let one: json::Value = self.expr(&xs[i], f - 1)?;
                    out.push(one);
                    self.up();
                }
                self.up();
                put(kv, field, json::Value::Array(out));
            }
            Ok(())
        }

        #[summary("The error what at the node being written")]
        #[effects(alloc)]
        fn fail(self: &Ex, what: &str) -> String {
            types::cat3(pointer_text(self.at.as_slice()).as_str(), ": ", what)
        }

        #[summary("The functions fs as an object keyed by name, in name order; a name twice is an error")]
        #[effects(alloc)]
        fn fns(self: &mut Ex, fs: &[ast::FnDef], f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut keys: Vec<String> = Vec::new();
            for i in 0..fs.len()
                invariant 0 <= i && i <= fs.len(),
            {
                keys.push(fs[i].name.name.clone());
            }
            let ord: Vec<usize> = fmt::order(keys.as_slice());
            let mut kv: Vec<json::Member> = Vec::new();
            self.down("fns");
            for o in 0..ord.len()
                invariant 0 <= o && o <= ord.len(),
            {
                if ord[o] < fs.len() {
                    let k: String = fs[ord[o]].name.name.clone();
                    if at(kv.as_slice(), k.as_str()) < kv.len() {
                        return Err(self.fail(types::cat3("two members named `", k.as_str(), "`").as_str()));
                    }
                    self.down(k.as_str());
                    let v: json::Value = self.function(&fs[ord[o]], true, f - 1)?;
                    self.up();
                    put(&mut kv, k.as_str(), v);
                }
            }
            self.up();
            Ok(json::Value::Object(kv))
        }

        #[summary("A function as an object: kind, effects, summary, external_body, rationale, uses, generics, params, ret, requires, ensures, decreases and, when body, its body. Of the attributes the normal form keeps effects and uses only")]
        #[effects(alloc)]
        fn function(self: &mut Ex, d: &ast::FnDef, body: bool, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(d.span);
            let mut kv: Vec<json::Member> = Vec::new();
            match &d.kind {
                ast::FnKind::Exec => kind(&mut kv, "fn"),
                ast::FnKind::Spec => kind(&mut kv, "spec fn"),
                ast::FnKind::Proof => kind(&mut kv, "proof fn"),
            }
            let ei: usize = attr_at(d.attrs.as_slice(), "effects");
            if ei < d.attrs.len() {
                let mut es: Vec<json::Value> = Vec::new();
                for i in 0..d.attrs[ei].args.len()
                    invariant 0 <= i && i <= d.attrs[ei].args.len(),
                {
                    match &d.attrs[ei].args[i] {
                        ast::AttrArg::Ident(en) => es.push(s(en.name.as_str())),
                        ast::AttrArg::Str(et, esp) => { return Err(self.fail("`effects` takes names")); },
                        ast::AttrArg::Pair(ek, ev) => { return Err(self.fail("`effects` takes names")); },
                    }
                }
                put(&mut kv, "effects", json::Value::Array(es));
            }
            match map::summary_of(d.attrs.as_slice()) {
                None => {},
                Some(sm) => put(&mut kv, "summary", json::Value::Str(sm)),
            }
            if attr_at(d.attrs.as_slice(), "external_body") < d.attrs.len() {
                put(&mut kv, "external_body", json::Value::Bool(true));
            }
            let ri: usize = attr_at(d.attrs.as_slice(), "rationale");
            if ri < d.attrs.len() {
                put(&mut kv, "rationale", attr_args(d.attrs[ri].args.as_slice()));
            }
            let mut names: Vec<String> = Vec::new();
            for j in 0..d.attrs.len()
                invariant 0 <= j && j <= d.attrs.len(),
            {
                if d.attrs[j].name.name == "uses" {
                    for u in 0..d.attrs[j].args.len()
                        invariant 0 <= u && u <= d.attrs[j].args.len(),
                    {
                        match &d.attrs[j].args[u] {
                            ast::AttrArg::Ident(un) => names.push(un.name.clone()),
                            ast::AttrArg::Str(ut, usp) => {},
                            ast::AttrArg::Pair(uk, uv) => {},
                        }
                    }
                }
            }
            if names.len() > 0 {
                let ord: Vec<usize> = fmt::order(names.as_slice());
                let mut us: Vec<json::Value> = Vec::new();
                let mut last: usize = names.len();
                for o in 0..ord.len()
                    invariant 0 <= o && o <= ord.len(), last <= names.len(),
                {
                    if ord[o] < names.len() {
                        if last == names.len() || names[last] != names[ord[o]] {
                            us.push(s(names[ord[o]].as_str()));
                        }
                        last = ord[o];
                    }
                }
                put(&mut kv, "uses", json::Value::Array(us));
            }
            if d.generics.len() > 0 {
                let gs: json::Value = self.generics(d.generics.as_slice(), f - 1)?;
                put(&mut kv, "generics", gs);
            }
            if d.params.len() > 0 {
                let ps: json::Value = self.params("params", d.params.as_slice(), f - 1)?;
                put(&mut kv, "params", ps);
            }
            self.ret(&mut kv, &d.ret, f - 1)?;
            self.exprs(&mut kv, "requires", d.pre.as_slice(), f - 1)?;
            self.exprs(&mut kv, "ensures", d.post.as_slice(), f - 1)?;
            match &d.measure {
                None => {},
                Some(m) => { self.sub(&mut kv, "decreases", m, f - 1)?; },
            }
            if body {
                self.sub_block(&mut kv, "body", &d.body, f - 1)?;
            }
            Ok(json::Value::Object(kv))
        }

        #[summary("The type parameters as a list of objects with name, bounds and fn_bound")]
        #[effects(alloc)]
        fn generics(self: &mut Ex, gs: &[ast::TypeParam], f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut out: Vec<json::Value> = Vec::new();
            self.down("generics");
            for i in 0..gs.len()
                invariant 0 <= i && i <= gs.len(),
            {
                self.down_n(i);
                self.mark(gs[i].span);
                let mut kv: Vec<json::Member> = Vec::new();
                put(&mut kv, "name", s(gs[i].name.name.as_str()));
                if gs[i].bounds.len() > 0 {
                    let mut bs: Vec<json::Value> = Vec::new();
                    for b in 0..gs[i].bounds.len()
                        invariant 0 <= b && b <= gs[i].bounds.len(),
                    {
                        bs.push(s(path_text(gs[i].bounds[b].as_slice()).as_str()));
                    }
                    put(&mut kv, "bounds", json::Value::Array(bs));
                }
                match &gs[i].fn_bound {
                    None => {},
                    Some(fb) => { let ps: json::Value = self.tys("params", fb.params.as_slice(), f - 1)?; let mut bkv: Vec<json::Member> = Vec::new(); match &fb.kind { ast::FnTrait::Fn => put(&mut bkv, "trait", s("Fn")), ast::FnTrait::FnMut => put(&mut bkv, "trait", s("FnMut")), ast::FnTrait::FnOnce => put(&mut bkv, "trait", s("FnOnce")), } put(&mut bkv, "params", ps); self.sub_ty(&mut bkv, "ret", &fb.ret, f - 1)?; put(&mut kv, "fn_bound", json::Value::Object(bkv)); },
                }
                out.push(json::Value::Object(kv));
                self.up();
            }
            self.up();
            Ok(json::Value::Array(out))
        }

        #[summary("An impl block as an object with generics, ty_args and fns")]
        #[effects(alloc)]
        fn impl_block(self: &mut Ex, i: &ast::Impl, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(i.span);
            let mut kv: Vec<json::Member> = Vec::new();
            if i.generics.len() > 0 {
                let gs: json::Value = self.generics(i.generics.as_slice(), f - 1)?;
                put(&mut kv, "generics", gs);
            }
            if i.ty_args.len() > 0 {
                let ts: json::Value = self.tys("ty_args", i.ty_args.as_slice(), f - 1)?;
                put(&mut kv, "ty_args", ts);
            }
            let fns: json::Value = self.fns(i.fns.as_slice(), f - 1)?;
            put(&mut kv, "fns", fns);
            Ok(json::Value::Object(kv))
        }

        #[summary("Records the pointer of the node at sp, when spans are recorded")]
        #[effects(alloc)]
        fn mark(self: &mut Ex, sp: source::Span) -> () {
            if self.rec {
                let p: String = pointer_text(self.at.as_slice());
                self.spans.push(Mark { span: sp, ptr: p });
            }
        }

        #[summary("A parameter or binder as an object with name and ty")]
        #[effects(alloc)]
        fn param(self: &mut Ex, p: &ast::Param, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(p.name.span.to(p.ty.span));
            let mut kv: Vec<json::Member> = Vec::new();
            put(&mut kv, "name", s(p.name.name.as_str()));
            self.sub_ty(&mut kv, "ty", &p.ty, f - 1)?;
            Ok(json::Value::Object(kv))
        }

        #[summary("The list of parameters under the member field")]
        #[effects(alloc)]
        fn params(self: &mut Ex, field: &str, ps: &[ast::Param], f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut out: Vec<json::Value> = Vec::new();
            self.down(field);
            for i in 0..ps.len()
                invariant 0 <= i && i <= ps.len(),
            {
                self.down_n(i);
                let one: json::Value = self.param(&ps[i], f - 1)?;
                out.push(one);
                self.up();
            }
            self.up();
            Ok(json::Value::Array(out))
        }

        #[summary("The member ret: the name of the result, when it has one, and its type")]
        #[effects(alloc)]
        fn ret(self: &mut Ex, kv: &mut Vec<json::Member>, r: &ast::Ret, f: usize) -> Result<(), String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.down("ret");
            let mut rkv: Vec<json::Member> = Vec::new();
            match &r.name {
                None => {},
                Some(n) => put(&mut rkv, "name", s(n.name.as_str())),
            }
            self.sub_ty(&mut rkv, "ty", &r.ty, f - 1)?;
            self.up();
            put(kv, "ret", json::Value::Object(rkv));
            Ok(())
        }

        #[summary("A statement as an object with its kind")]
        #[effects(alloc)]
        fn stmt(self: &mut Ex, st: &ast::Stmt, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut kv: Vec<json::Member> = Vec::new();
            match st {
                ast::Stmt::Let(le) => { self.mark(le.span); if le.ty_missing { return Err(self.fail("`let` without a type is not part of the language")); } kind(&mut kv, "let"); if le.mutable { put(&mut kv, "mutable", json::Value::Bool(true)); } put(&mut kv, "name", s(le.name.name.as_str())); self.sub_ty(&mut kv, "ty", &le.ty, f - 1)?; self.sub(&mut kv, "init", &le.init, f - 1)?; },
                ast::Stmt::Assign(asg) => { self.mark(asg.span); kind(&mut kv, "assign"); self.sub(&mut kv, "target", &asg.target, f - 1)?; self.sub(&mut kv, "value", &asg.value, f - 1)?; },
                ast::Stmt::While(wh) => { self.mark(wh.span); kind(&mut kv, "while"); label(&mut kv, &wh.label); self.sub(&mut kv, "cond", &wh.cond, f - 1)?; self.exprs(&mut kv, "invariants", wh.invariants.as_slice(), f - 1)?; match &wh.measure { None => {}, Some(wm) => { self.sub(&mut kv, "decreases", wm, f - 1)?; }, } self.sub_block(&mut kv, "body", &wh.body, f - 1)?; },
                ast::Stmt::For(fo) => { self.mark(fo.span); kind(&mut kv, "for"); label(&mut kv, &fo.label); put(&mut kv, "var", s(fo.var.name.as_str())); self.sub(&mut kv, "lo", &fo.lo, f - 1)?; self.sub(&mut kv, "hi", &fo.hi, f - 1)?; if fo.inclusive { put(&mut kv, "inclusive", json::Value::Bool(true)); } self.exprs(&mut kv, "invariants", fo.invariants.as_slice(), f - 1)?; self.sub_block(&mut kv, "body", &fo.body, f - 1)?; },
                ast::Stmt::Assert(asr) => { self.mark(asr.span); kind(&mut kv, "assert"); self.sub(&mut kv, "cond", &asr.cond, f - 1)?; match &asr.by { None => {}, Some(pv) => { match pv { ast::Prover::BitVector => put(&mut kv, "by", s("bit_vector")), } }, } },
                ast::Stmt::Assume(asu) => { self.mark(asu.span); kind(&mut kv, "assume"); self.sub(&mut kv, "cond", &asu.cond, f - 1)?; match &asu.rationale { None => {}, Some(ra) => put(&mut kv, "rationale", attr_args(ra.args.as_slice())), } },
                ast::Stmt::Proof(pb) => { self.mark(pb.span); kind(&mut kv, "proof"); self.sub_block(&mut kv, "body", &pb.body, f - 1)?; },
                ast::Stmt::LetFields(lf) => { self.mark(lf.span); return Err(self.fail("destructuring `let` is not part of the language")); },
                ast::Stmt::Expr(ex) => { self.mark(ex.span); kind(&mut kv, "expr"); self.sub(&mut kv, "expr", ex, f - 1)?; },
            }
            Ok(json::Value::Object(kv))
        }

        #[summary("The member field with the expression e")]
        #[effects(alloc)]
        fn sub(self: &mut Ex, kv: &mut Vec<json::Member>, field: &str, e: &ast::Expr, f: usize) -> Result<(), String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.down(field);
            let v: json::Value = self.expr(e, f - 1)?;
            self.up();
            put(kv, field, v);
            Ok(())
        }

        #[summary("The member field with the block b")]
        #[effects(alloc)]
        fn sub_block(self: &mut Ex, kv: &mut Vec<json::Member>, field: &str, b: &ast::Block, f: usize) -> Result<(), String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.down(field);
            let v: json::Value = self.block(b, f - 1)?;
            self.up();
            put(kv, field, v);
            Ok(())
        }

        #[summary("The member field with the type t")]
        #[effects(alloc)]
        fn sub_ty(self: &mut Ex, kv: &mut Vec<json::Member>, field: &str, t: &ast::Type, f: usize) -> Result<(), String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.down(field);
            let v: json::Value = self.ty(t, f - 1)?;
            self.up();
            put(kv, field, v);
            Ok(())
        }

        #[summary("A trait as an object with attrs and fns; a method without a body has none")]
        #[effects(alloc)]
        fn trait_def(self: &mut Ex, t: &ast::TraitDef, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(t.span);
            let mut kv: Vec<json::Member> = Vec::new();
            if t.attrs.len() > 0 {
                put(&mut kv, "attrs", self.attrs(t.attrs.as_slice()));
            }
            let mut keys: Vec<String> = Vec::new();
            for i in 0..t.fns.len()
                invariant 0 <= i && i <= t.fns.len(),
            {
                keys.push(t.fns[i].f.name.name.clone());
            }
            let ord: Vec<usize> = fmt::order(keys.as_slice());
            let mut fkv: Vec<json::Member> = Vec::new();
            self.down("fns");
            for o in 0..ord.len()
                invariant 0 <= o && o <= ord.len(),
            {
                if ord[o] < t.fns.len() {
                    let k: String = t.fns[ord[o]].f.name.name.clone();
                    if at(fkv.as_slice(), k.as_str()) < fkv.len() {
                        return Err(self.fail(types::cat3("two members named `", k.as_str(), "`").as_str()));
                    }
                    self.down(k.as_str());
                    let v: json::Value = self.function(&t.fns[ord[o]].f, t.fns[ord[o]].has_body, f - 1)?;
                    self.up();
                    put(&mut fkv, k.as_str(), v);
                }
            }
            self.up();
            put(&mut kv, "fns", json::Value::Object(fkv));
            Ok(json::Value::Object(kv))
        }

        #[summary("A trait impl as an object with generics, trait, self_ty and fns")]
        #[effects(alloc)]
        fn trait_impl(self: &mut Ex, i: &ast::TraitImpl, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(i.span);
            let mut kv: Vec<json::Member> = Vec::new();
            if i.generics.len() > 0 {
                let gs: json::Value = self.generics(i.generics.as_slice(), f - 1)?;
                put(&mut kv, "generics", gs);
            }
            put(&mut kv, "trait", s(path_text(i.trait_path.as_slice()).as_str()));
            self.sub_ty(&mut kv, "self_ty", &i.self_ty, f - 1)?;
            let fns: json::Value = self.fns(i.fns.as_slice(), f - 1)?;
            put(&mut kv, "fns", fns);
            Ok(json::Value::Object(kv))
        }

        #[summary("A type as an object with its kind. String is written as the path the parser keeps")]
        #[effects(alloc)]
        fn ty(self: &mut Ex, t: &ast::Type, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(t.span);
            let mut kv: Vec<json::Member> = Vec::new();
            match &t.kind {
                ast::TypeKind::Int(it) => { let mut n: String = String::new(); ast::push_int_name(&mut n, it); put(&mut kv, "kind", json::Value::Str(n)); },
                ast::TypeKind::F64 => kind(&mut kv, "f64"),
                ast::TypeKind::Bool => kind(&mut kv, "bool"),
                ast::TypeKind::Unit => kind(&mut kv, "unit"),
                ast::TypeKind::Char => kind(&mut kv, "char"),
                ast::TypeKind::String => { kind(&mut kv, "named"); put(&mut kv, "path", s("String")); },
                ast::TypeKind::Str => kind(&mut kv, "str"),
                ast::TypeKind::Array(ae, an) => { kind(&mut kv, "array"); self.sub_ty(&mut kv, "elem", &**ae, f - 1)?; put(&mut kv, "len", num(*an)); },
                ast::TypeKind::ArrayN(ne, nn) => { kind(&mut kv, "array"); self.sub_ty(&mut kv, "elem", &**ne, f - 1)?; put(&mut kv, "len_const", s(ast::join_names(nn.as_slice()).as_str())); },
                ast::TypeKind::Slice(se) => { kind(&mut kv, "slice"); self.sub_ty(&mut kv, "elem", &**se, f - 1)?; },
                ast::TypeKind::Ref(rm, ri) => { kind(&mut kv, "ref"); if *rm { put(&mut kv, "mutable", json::Value::Bool(true)); } self.sub_ty(&mut kv, "inner", &**ri, f - 1)?; },
                ast::TypeKind::Named(np, na) => { kind(&mut kv, "named"); put(&mut kv, "path", s(ast::join_names(np.as_slice()).as_str())); if na.len() > 0 { let args: json::Value = self.tys("args", na.as_slice(), f - 1)?; put(&mut kv, "args", args); } },
                ast::TypeKind::Vec(ve) => { kind(&mut kv, "Vec"); self.sub_ty(&mut kv, "elem", &**ve, f - 1)?; },
                ast::TypeKind::Box(be) => { kind(&mut kv, "Box"); self.sub_ty(&mut kv, "elem", &**be, f - 1)?; },
                ast::TypeKind::Param(pn) => { kind(&mut kv, "named"); put(&mut kv, "path", s(pn.as_str())); },
                ast::TypeKind::Never => { return Err(self.fail("not a type of the language")); },
                ast::TypeKind::Error => { return Err(self.fail("not a type of the language")); },
            }
            Ok(json::Value::Object(kv))
        }

        #[summary("A struct or enum as an object: kind, generics, attrs and its fields or variants in declaration order; a field or variant twice is an error")]
        #[effects(alloc)]
        fn type_def(self: &mut Ex, t: &ast::TypeDef, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(t.span);
            let mut kv: Vec<json::Member> = Vec::new();
            match &t.kind {
                ast::TypeDefKind::Struct(fs0) => kind(&mut kv, "struct"),
                ast::TypeDefKind::Enum(vs0) => kind(&mut kv, "enum"),
            }
            if t.generics.len() > 0 {
                let gs: json::Value = self.generics(t.generics.as_slice(), f - 1)?;
                put(&mut kv, "generics", gs);
            }
            if t.attrs.len() > 0 {
                put(&mut kv, "attrs", self.attrs(t.attrs.as_slice()));
            }
            let mut out: Vec<json::Member> = Vec::new();
            match &t.kind {
                ast::TypeDefKind::Struct(fs) => { self.down("fields"); for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { if at(out.as_slice(), fs[i].name.name.as_str()) < out.len() { return Err(self.fail(types::cat3("two fields named `", fs[i].name.name.as_str(), "`").as_str())); } self.sub_ty(&mut out, fs[i].name.name.as_str(), &fs[i].ty, f - 1)?; } self.up(); put(&mut kv, "fields", json::Value::Object(out)); },
                ast::TypeDefKind::Enum(vs) => { self.down("variants"); for j in 0..vs.len() invariant 0 <= j && j <= vs.len(), { if at(out.as_slice(), vs[j].name.name.as_str()) < out.len() { return Err(self.fail(types::cat3("two variants named `", vs[j].name.name.as_str(), "`").as_str())); } self.down(vs[j].name.name.as_str()); self.mark(vs[j].span); let mut ps: Vec<json::Value> = Vec::new(); for k in 0..vs[j].payload.len() invariant 0 <= k && k <= vs[j].payload.len(), { self.down_n(k); let one: json::Value = self.ty(&vs[j].payload[k], f - 1)?; ps.push(one); self.up(); } self.up(); put(&mut out, vs[j].name.name.as_str(), json::Value::Array(ps)); } self.up(); put(&mut kv, "variants", json::Value::Object(out)); },
            }
            Ok(json::Value::Object(kv))
        }

        #[summary("The list of types under the member field")]
        #[effects(alloc)]
        fn tys(self: &mut Ex, field: &str, ts: &[ast::Type], f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut out: Vec<json::Value> = Vec::new();
            self.down(field);
            for i in 0..ts.len()
                invariant 0 <= i && i <= ts.len(),
            {
                self.down_n(i);
                let one: json::Value = self.ty(&ts[i], f - 1)?;
                out.push(one);
                self.up();
            }
            self.up();
            Ok(json::Value::Array(out))
        }

        #[summary("A unit as an object: summary, consts, units, traits, types, impls (a type's later blocks as T#1, T#2), trait_impls (by trait path and type) and fns, each left out when empty")]
        #[effects(alloc)]
        fn unit(self: &mut Ex, m: &ast::Mod, f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.mark(m.span);
            if m.uses.len() > 0 {
                return Err(self.fail("`use` items are not part of the language"));
            }
            let mut kv: Vec<json::Member> = Vec::new();
            match unit_summary(m.attrs.as_slice()) {
                None => {},
                Some(sm) => put(&mut kv, "summary", json::Value::Str(sm)),
            }
            for l in 0..m.lens.len()
                invariant 0 <= l && l <= m.lens.len(),
            {
                self.lens.insert(span_key(m.lens[l].at).as_str(), path_text(m.lens[l].path.as_slice()));
            }
            if m.consts.len() > 0 {
                let mut ckeys: Vec<String> = Vec::new();
                for c in 0..m.consts.len()
                    invariant 0 <= c && c <= m.consts.len(),
                {
                    ckeys.push(m.consts[c].name.name.clone());
                }
                let cord: Vec<usize> = fmt::order(ckeys.as_slice());
                let mut ckv: Vec<json::Member> = Vec::new();
                self.down("consts");
                for co in 0..cord.len()
                    invariant 0 <= co && co <= cord.len(),
                {
                    if cord[co] < m.consts.len() {
                        let ck: String = m.consts[cord[co]].name.name.clone();
                        if at(ckv.as_slice(), ck.as_str()) < ckv.len() {
                            return Err(self.fail(types::cat3("two members named `", ck.as_str(), "`").as_str()));
                        }
                        self.down(ck.as_str());
                        self.mark(m.consts[cord[co]].span);
                        let mut one: Vec<json::Member> = Vec::new();
                        self.sub_ty(&mut one, "ty", &m.consts[cord[co]].ty, f - 1)?;
                        self.sub(&mut one, "value", &m.consts[cord[co]].value, f - 1)?;
                        match map::summary_of(m.consts[cord[co]].attrs.as_slice()) {
                            None => {},
                            Some(cs) => put(&mut one, "summary", json::Value::Str(cs)),
                        }
                        self.up();
                        put(&mut ckv, ck.as_str(), json::Value::Object(one));
                    }
                }
                self.up();
                put(&mut kv, "consts", json::Value::Object(ckv));
            }
            if m.mods.len() > 0 {
                self.down("units");
                let us: json::Value = self.units(m.mods.as_slice(), f - 1)?;
                self.up();
                put(&mut kv, "units", us);
            }
            if m.traits.len() > 0 {
                let mut tkeys: Vec<String> = Vec::new();
                for t in 0..m.traits.len()
                    invariant 0 <= t && t <= m.traits.len(),
                {
                    tkeys.push(m.traits[t].name.name.clone());
                }
                let tord: Vec<usize> = fmt::order(tkeys.as_slice());
                let mut tkv: Vec<json::Member> = Vec::new();
                self.down("traits");
                for to in 0..tord.len()
                    invariant 0 <= to && to <= tord.len(),
                {
                    if tord[to] < m.traits.len() {
                        let tk: String = m.traits[tord[to]].name.name.clone();
                        if at(tkv.as_slice(), tk.as_str()) < tkv.len() {
                            return Err(self.fail(types::cat3("two members named `", tk.as_str(), "`").as_str()));
                        }
                        self.down(tk.as_str());
                        let tv: json::Value = self.trait_def(&m.traits[tord[to]], f - 1)?;
                        self.up();
                        put(&mut tkv, tk.as_str(), tv);
                    }
                }
                self.up();
                put(&mut kv, "traits", json::Value::Object(tkv));
            }
            if m.types.len() > 0 {
                let mut ykeys: Vec<String> = Vec::new();
                for y in 0..m.types.len()
                    invariant 0 <= y && y <= m.types.len(),
                {
                    ykeys.push(m.types[y].name.name.clone());
                }
                let yord: Vec<usize> = fmt::order(ykeys.as_slice());
                let mut ykv: Vec<json::Member> = Vec::new();
                self.down("types");
                for yo in 0..yord.len()
                    invariant 0 <= yo && yo <= yord.len(),
                {
                    if yord[yo] < m.types.len() {
                        let yk: String = m.types[yord[yo]].name.name.clone();
                        if at(ykv.as_slice(), yk.as_str()) < ykv.len() {
                            return Err(self.fail(types::cat3("two members named `", yk.as_str(), "`").as_str()));
                        }
                        self.down(yk.as_str());
                        let yv: json::Value = self.type_def(&m.types[yord[yo]], f - 1)?;
                        self.up();
                        put(&mut ykv, yk.as_str(), yv);
                    }
                }
                self.up();
                put(&mut kv, "types", json::Value::Object(ykv));
            }
            if m.impls.len() > 0 {
                let ikeys: Vec<String> = impl_keys(m.impls.as_slice());
                let iord: Vec<usize> = fmt::order(ikeys.as_slice());
                let mut ikv: Vec<json::Member> = Vec::new();
                self.down("impls");
                for io in 0..iord.len()
                    invariant 0 <= io && io <= iord.len(),
                {
                    if iord[io] < m.impls.len() && iord[io] < ikeys.len() {
                        let ik: String = ikeys[iord[io]].clone();
                        if at(ikv.as_slice(), ik.as_str()) < ikv.len() {
                            return Err(self.fail(types::cat3("two members named `", ik.as_str(), "`").as_str()));
                        }
                        self.down(ik.as_str());
                        let iv: json::Value = self.impl_block(&m.impls[iord[io]], f - 1)?;
                        self.up();
                        put(&mut ikv, ik.as_str(), iv);
                    }
                }
                self.up();
                put(&mut kv, "impls", json::Value::Object(ikv));
            }
            if m.trait_impls.len() > 0 {
                let mut rkeys: Vec<String> = Vec::new();
                for r in 0..m.trait_impls.len()
                    invariant 0 <= r && r <= m.trait_impls.len(),
                {
                    let mut rk: String = path_text(m.trait_impls[r].trait_path.as_slice());
                    rk.push('\0');
                    rk.push_str(fmt::type_str(&m.trait_impls[r].self_ty).as_str());
                    rkeys.push(rk);
                }
                let rord: Vec<usize> = fmt::order(rkeys.as_slice());
                let mut rs: Vec<json::Value> = Vec::new();
                self.down("trait_impls");
                for ro in 0..rord.len()
                    invariant 0 <= ro && ro <= rord.len(),
                {
                    if rord[ro] < m.trait_impls.len() {
                        self.down_n(ro);
                        let rv: json::Value = self.trait_impl(&m.trait_impls[rord[ro]], f - 1)?;
                        rs.push(rv);
                        self.up();
                    }
                }
                self.up();
                put(&mut kv, "trait_impls", json::Value::Array(rs));
            }
            if m.fns.len() > 0 {
                let fns: json::Value = self.fns(m.fns.as_slice(), f - 1)?;
                put(&mut kv, "fns", fns);
            }
            Ok(json::Value::Object(kv))
        }

        #[summary("The units as an object keyed by name, in name order; a name twice is an error")]
        #[effects(alloc)]
        fn units(self: &mut Ex, mods: &[ast::Mod], f: usize) -> Result<json::Value, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut keys: Vec<String> = Vec::new();
            for i in 0..mods.len()
                invariant 0 <= i && i <= mods.len(),
            {
                keys.push(mods[i].name.name.clone());
            }
            let ord: Vec<usize> = fmt::order(keys.as_slice());
            let mut kv: Vec<json::Member> = Vec::new();
            for o in 0..ord.len()
                invariant 0 <= o && o <= ord.len(),
            {
                if ord[o] < mods.len() {
                    let k: String = mods[ord[o]].name.name.clone();
                    if at(kv.as_slice(), k.as_str()) < kv.len() {
                        return Err(self.fail(types::cat3("two units named `", k.as_str(), "`").as_str()));
                    }
                    self.down(k.as_str());
                    let v: json::Value = self.unit(&mods[ord[o]], f - 1)?;
                    self.up();
                    put(&mut kv, k.as_str(), v);
                }
            }
            Ok(json::Value::Object(kv))
        }

        #[summary("Leaves the member or element entered last")]
        #[effects(alloc)]
        fn up(self: &mut Ex) -> () {
            self.at.pop();
        }
    }

    #[summary("The reader of a document (stage0 Im): the pointer segments of the node being read, the repeat counts given as a constant's name in the unit being read, each at a span of its own, and how many of them the document has had so far")]
    struct Im { at: Vec<String>, lens: Vec<ast::Len>, counts: u32 }

    impl Im {
        #[summary("An arm from the object v")]
        #[effects(alloc)]
        fn arm(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Arm, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected an arm (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected an arm (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected an arm (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected an arm (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected an arm (an object)")),
                json::Value::Object(o) => self.arm_of(o.as_slice(), f - 1),
            }
        }

        #[summary("An arm from its members pat and body")]
        #[effects(alloc)]
        fn arm_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Arm, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "an arm", "pat, body")?;
            let pi: usize = self.req(kv, "pat")?;
            self.down("pat");
            let pat: ast::Pat = self.pat(&kv[pi].value, f - 1)?;
            self.up();
            let body: ast::Expr = self.field_expr(kv, "body", f - 1)?;
            Ok(ast::Arm { pat: pat, body: body, span: sp() })
        }

        #[summary("The elements of the array under the member k, none when it is absent")]
        #[effects(alloc)]
        fn arms(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::Arm>, String>
            decreases f,
        {
            let mut out: Vec<ast::Arm> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); let one: ast::Arm = self.arm(&xs[j], f - 1)?; out.push(one); self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("An attribute from the object v")]
        #[effects(alloc)]
        fn attr(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Attr, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected an attribute (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected an attribute (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected an attribute (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected an attribute (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected an attribute (an object)")),
                json::Value::Object(o) => self.attr_of(o.as_slice(), f - 1),
            }
        }

        #[summary("An attribute argument: a name, an object with str, or an object with key and value")]
        #[effects(alloc)]
        fn attr_arg(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::AttrArg, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a name, {\"str\": ..} or {\"key\", \"value\"}")),
                json::Value::Bool(b0) => Err(self.fail("expected a name, {\"str\": ..} or {\"key\", \"value\"}")),
                json::Value::Num(n0) => Err(self.fail("expected a name, {\"str\": ..} or {\"key\", \"value\"}")),
                json::Value::Str(t) => { self.path_of("", t.as_str())?; Ok(ast::AttrArg::Ident(id(t.as_str()))) },
                json::Value::Array(a0) => Err(self.fail("expected a name, {\"str\": ..} or {\"key\", \"value\"}")),
                json::Value::Object(o) => self.attr_arg_of(o.as_slice(), f - 1),
            }
        }

        #[summary("An attribute argument from the members of an object")]
        #[effects(alloc)]
        fn attr_arg_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::AttrArg, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            if at(kv, "key") < kv.len() {
                self.check(kv, "a `key = value` argument", "key, value")?;
                let key: ast::Ident = self.name(kv, "key")?;
                let vi: usize = self.req(kv, "value")?;
                self.down("value");
                let value: ast::AttrArg = self.attr_arg(&kv[vi].value, f - 1)?;
                self.up();
                if is_pair(&value) {
                    return Err(self.fail("a value is a name or a string"));
                }
                return Ok(ast::AttrArg::Pair(key, Box::new(value)));
            }
            self.check(kv, "a string argument", "str")?;
            let text: String = self.string(kv, "str")?;
            Ok(ast::AttrArg::Str(text, sp()))
        }

        #[summary("The elements of the array under the member k, none when it is absent")]
        #[effects(alloc)]
        fn attr_args(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::AttrArg>, String>
            decreases f,
        {
            let mut out: Vec<ast::AttrArg> = Vec::new();
