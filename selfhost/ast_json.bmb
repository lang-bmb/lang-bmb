        #[summary("A type from the object v by its kind")]
        #[effects(alloc)]
        fn ty(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Type, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a type (an object with a `kind`)")),
                json::Value::Bool(b0) => Err(self.fail("expected a type (an object with a `kind`)")),
                json::Value::Num(n0) => Err(self.fail("expected a type (an object with a `kind`)")),
                json::Value::Str(s0) => Err(self.fail("expected a type (an object with a `kind`)")),
                json::Value::Array(a0) => Err(self.fail("expected a type (an object with a `kind`)")),
                json::Value::Object(o) => { let kind: ast::TypeKind = self.ty_of(o.as_slice(), f - 1)?; Ok(ast::Type { kind: kind, span: sp() }) },
            }
        }

        #[summary("The kind of a type from its members")]
        #[effects(alloc)]
        fn ty_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::TypeKind, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let k: String = self.kind(kv, "a type")?;
            match ast::int_of(k.as_str()) {
                None => {},
                Some(it) => { self.check(kv, "a type", "kind")?; return Ok(ast::TypeKind::Int(it)); },
            }
            if k == "f64" || k == "bool" || k == "unit" || k == "char" || k == "str" {
                self.check(kv, "a type", "kind")?;
                if k == "f64" {
                    return Ok(ast::TypeKind::F64);
                }
                if k == "bool" {
                    return Ok(ast::TypeKind::Bool);
                }
                if k == "char" {
                    return Ok(ast::TypeKind::Char);
                }
                if k == "str" {
                    return Ok(ast::TypeKind::Str);
                }
                return Ok(ast::TypeKind::Unit);
            }
            if k == "array" {
                if at(kv, "len_const") < kv.len() {
                    self.check(kv, "an array type", "kind, elem, len_const")?;
                    let nelem: ast::Type = self.field_ty(kv, "elem", f - 1)?;
                    let n: String = self.string(kv, "len_const")?;
                    return Ok(ast::TypeKind::ArrayN(Box::new(nelem), refs::split_path(n.as_str())));
                }
                self.check(kv, "an array type", "kind, elem, len")?;
                let aelem: ast::Type = self.field_ty(kv, "elem", f - 1)?;
                let len: wide::U128 = self.number(kv, "len")?;
                if len.hi != 0 {
                    return Err(self.fail_at("len", "too large"));
                }
                return Ok(ast::TypeKind::Array(Box::new(aelem), len.lo));
            }
            if k == "slice" || k == "Vec" || k == "Box" {
                self.check(kv, "a type", "kind, elem")?;
                let elem: ast::Type = self.field_ty(kv, "elem", f - 1)?;
                if k == "slice" {
                    return Ok(ast::TypeKind::Slice(Box::new(elem)));
                }
                if k == "Vec" {
                    return Ok(ast::TypeKind::Vec(Box::new(elem)));
                }
                return Ok(ast::TypeKind::Box(Box::new(elem)));
            }
            if k == "ref" {
                self.check(kv, "a reference type", "kind, mutable, inner")?;
                let mutable: bool = self.flag(kv, "mutable")?;
                let inner: ast::Type = self.field_ty(kv, "inner", f - 1)?;
                return Ok(ast::TypeKind::Ref(mutable, Box::new(inner)));
            }
            if k == "named" {
                self.check(kv, "a named type", "kind, path, args")?;
                let path: Vec<ast::Ident> = self.path(kv, "path")?;
                let args: Vec<ast::Type> = self.tys(kv, "args", f - 1)?;
                return Ok(ast::TypeKind::Named(idents_names(path.as_slice()), args));
            }
            Err(self.fail(types::cat3("unknown type kind `", k.as_str(), "` (i8 .. usize, f64, bool, unit, array, slice, ref, named, Vec, Box)").as_str()))
        }

        #[summary("A struct or enum from the object v by its kind")]
        #[effects(alloc)]
        fn type_def(self: &mut Im, name: &str, v: &json::Value, f: usize) -> Result<ast::TypeDef, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a struct or enum (an object with a `kind`)")),
                json::Value::Bool(b0) => Err(self.fail("expected a struct or enum (an object with a `kind`)")),
                json::Value::Num(n0) => Err(self.fail("expected a struct or enum (an object with a `kind`)")),
                json::Value::Str(s0) => Err(self.fail("expected a struct or enum (an object with a `kind`)")),
                json::Value::Array(a0) => Err(self.fail("expected a struct or enum (an object with a `kind`)")),
                json::Value::Object(o) => self.type_def_of(name, o.as_slice(), f - 1),
            }
        }

        #[summary("A struct or enum from its members")]
        #[effects(alloc)]
        fn type_def_of(self: &mut Im, name: &str, kv: &[json::Member], f: usize) -> Result<ast::TypeDef, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let k: String = self.kind(kv, "a struct or enum")?;
            if k == "struct" {
                self.check(kv, "a struct", "kind, generics, attrs, fields")?;
                let fs: Vec<ast::Field> = self.fields(kv, "fields", f - 1)?;
                let sgen: Vec<ast::TypeParam> = self.generics(kv, "generics", f - 1)?;
                let sattrs: Vec<ast::Attr> = self.attrs(kv, "attrs", f - 1)?;
                return Ok(ast::TypeDef { name: id(name), generics: sgen, attrs: sattrs, kind: ast::TypeDefKind::Struct(fs), span: sp() });
            }
            if k == "enum" {
                self.check(kv, "an enum", "kind, generics, attrs, variants")?;
                let vs: Vec<ast::Variant> = self.variants(kv, "variants", f - 1)?;
                let egen: Vec<ast::TypeParam> = self.generics(kv, "generics", f - 1)?;
                let eattrs: Vec<ast::Attr> = self.attrs(kv, "attrs", f - 1)?;
                return Ok(ast::TypeDef { name: id(name), generics: egen, attrs: eattrs, kind: ast::TypeDefKind::Enum(vs), span: sp() });
            }
            Err(self.fail(types::cat3("unknown type kind `", k.as_str(), "` (struct, enum)").as_str()))
        }

