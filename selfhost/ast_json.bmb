                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); let one: ast::Type = self.ty(&xs[j], f - 1)?; out.push(one); self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("A unit from the object v")]
        #[effects(alloc)]
        fn unit(self: &mut Im, name: &str, v: &json::Value, f: usize) -> Result<ast::Mod, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let outer: Vec<ast::Len> = std::mem::replace(&mut self.lens, Vec::new());
            match v {
                json::Value::Null => Err(self.fail("expected a unit (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a unit (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a unit (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a unit (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a unit (an object)")),
                json::Value::Object(o) => self.unit_of(name, o.as_slice(), outer, f - 1),
            }
        }

        #[summary("A unit from its members. The repeat counts read so far are the enclosing unit's (outer) and are put back at the end")]
        #[effects(alloc)]
        fn unit_of(self: &mut Im, name: &str, kv: &[json::Member], outer: Vec<ast::Len>, f: usize) -> Result<ast::Mod, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a unit", "summary, consts, units, traits, types, impls, trait_impls, fns")?;
            let consts: Vec<ast::ConstDef> = self.consts(kv, "consts", f - 1)?;
            let mut attrs: Vec<ast::Attr> = Vec::new();
            if at(kv, "summary") < kv.len() {
                let text: String = self.string(kv, "summary")?;
                attrs.push(summary_attr(text));
            }
            let mut mods: Vec<ast::Mod> = Vec::new();
            let ui: usize = at(kv, "units");
            if ui < kv.len() {
                self.down("units");
                mods = self.units(&kv[ui].value, f - 1)?;
                self.up();
            }
            let traits: Vec<ast::TraitDef> = self.traits(kv, "traits", f - 1)?;
            let tys: Vec<ast::TypeDef> = self.types(kv, "types", f - 1)?;
            let impls: Vec<ast::Impl> = self.impls(kv, "impls", f - 1)?;
            let trait_impls: Vec<ast::TraitImpl> = self.trait_impls(kv, "trait_impls", f - 1)?;
            let fns: Vec<ast::TraitFn> = self.fns(kv, "fns", false, f - 1)?;
            let lens: Vec<ast::Len> = std::mem::replace(&mut self.lens, outer);
            Ok(ast::Mod { name: id(name), attrs: attrs, fns: plain_fns(fns), mods: mods, types: tys, impls: impls, traits: traits, trait_impls: trait_impls, uses: Vec::new(), consts: consts, lens: lens, span: sp() })
        }

        #[summary("The units of an object keyed by unit name, none twice")]
        #[effects(alloc)]
        fn units(self: &mut Im, v: &json::Value, f: usize) -> Result<Vec<ast::Mod>, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let mut out: Vec<ast::Mod> = Vec::new();
            match v {
                json::Value::Null => { return Err(self.fail("expected an object keyed by unit name")); },
                json::Value::Bool(b0) => { return Err(self.fail("expected an object keyed by unit name")); },
                json::Value::Num(n0) => { return Err(self.fail("expected an object keyed by unit name")); },
                json::Value::Str(s0) => { return Err(self.fail("expected an object keyed by unit name")); },
                json::Value::Array(a0) => { return Err(self.fail("expected an object keyed by unit name")); },
                json::Value::Object(ms) => { for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { if at(ms.as_slice(), ms[j].key.as_str()) < j { return Err(self.fail(types::cat3("unit `", ms[j].key.as_str(), "` given twice").as_str())); } if !is_name(ms[j].key.as_str()) { return Err(self.fail(types::cat3("`", ms[j].key.as_str(), "` is not a unit name").as_str())); } self.down(ms[j].key.as_str()); let one: ast::Mod = self.unit(ms[j].key.as_str(), &ms[j].value, f - 1)?; out.push(one); self.up(); } },
            }
            Ok(out)
        }

        #[summary("Leaves the member or element entered last")]
        #[effects(alloc)]
        fn up(self: &mut Im) -> () {
            self.at.pop();
        }

        #[summary("The members of the object keyed by name under the member k, in their order; none when it is absent")]
        #[effects(alloc)]
        fn variants(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::Variant>, String>
            decreases f,
        {
            let mut out: Vec<ast::Variant> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Array(a0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Object(ms) => { self.keys_ok(ms.as_slice(), k)?; for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { self.down(k); self.down(ms[j].key.as_str()); let one: ast::Variant = self.payload(ms[j].key.as_str(), &ms[j].value, f - 1)?; out.push(one); self.up(); self.up(); } },
                }
            }
            Ok(out)
        }
    }

    #[summary("A span of an exported program with the JSON Pointer of its node")]
    struct Mark { span: source::Span, ptr: String }

    #[summary("Puts v at the pointer segs[k..] of doc (RFC 6902 add): a member of an object is set or added at its end, an element is put before the one at its index, or at the end for - or the length")]
    #[effects(alloc)]
    fn add(doc: &mut json::Value, segs: &[String], k: usize, v: json::Value, f: usize) -> Result<(), String>
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        if k >= segs.len() {
            *doc = v;
            return Ok(());
        }
        match doc {
            json::Value::Null => Err(off(segs, k)),
            json::Value::Bool(b0) => Err(off(segs, k)),
            json::Value::Num(n0) => Err(off(segs, k)),
            json::Value::Str(s0) => Err(off(segs, k)),
            json::Value::Array(xs) => add_elem(xs, segs, k, v, f - 1),
            json::Value::Object(kv) => add_member(kv, segs, k, v, f - 1),
        }
    }

    #[summary("add inside the array xs")]
    #[effects(alloc)]
    fn add_elem(xs: &mut Vec<json::Value>, segs: &[String], k: usize, v: json::Value, f: usize) -> Result<(), String>
        requires k < segs.len(),
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        if k + 1 == segs.len() {
            let i: usize = index(segs[k].as_str(), xs.len(), true)?;
            let n: usize = xs.len();
            let mut carry: json::Value = v;
            for j in i..n
                invariant xs.len() == n,
            {
                carry = std::mem::replace(&mut xs[j], carry);
            }
            xs.push(carry);
            return Ok(());
        }
        match index(segs[k].as_str(), xs.len(), false) {
            Ok(at0) => add(&mut xs[at0], segs, k + 1, v, f - 1),
            Err(e) => Err(types::cat3(here(segs, k).as_str(), ": ", e.as_str())),
        }
    }

    #[summary("add inside the object kv")]
    #[effects(alloc)]
    fn add_member(kv: &mut Vec<json::Member>, segs: &[String], k: usize, v: json::Value, f: usize) -> Result<(), String>
        requires k < segs.len(),
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        let i: usize = at(kv.as_slice(), segs[k].as_str());
        if k + 1 == segs.len() {
            if i < kv.len() {
                kv[i].value = v;
            } else {
                kv.push(json::Member { key: segs[k].clone(), value: v });
            }
            return Ok(());
        }
        if i < kv.len() {
            add(&mut kv[i].value, segs, k + 1, v, f - 1)
        } else {
            Err(types::cat2(here(segs, k).as_str(), ": no such member"))
        }
    }

    #[summary("Whether the text is digits only (true for the empty text)")]
    #[effects(pure)]
    fn all_digits(n: &str) -> bool {
        if n.len() == 0 {
            return false;
        }
        for i in 0..n.len()
            invariant 0 <= i && i <= n.len(),
        {
            if n.as_bytes()[i] < 48 || n.as_bytes()[i] > 57 {
                return false;
            }
        }
        true
    }

    #[summary("Whether k is one of the names of list, which are joined by a comma and a space")]
    #[effects(pure)]
    fn allows(list: &str, k: &str) -> bool {
        allows_of(list.as_bytes(), k.as_bytes())
    }

    #[summary("allows, with the bytes of the text")]
    #[effects(pure)]
    fn allows_of(b: &[u8], w: &[u8]) -> bool {
        let mut start: usize = 0;
        let mut i: usize = 0;
        while i <= b.len()
            invariant start <= i,
            decreases b.len() + 1 - i,
        {
            if i == b.len() || b[i] == 44 {
                if i - start == w.len() && same_bytes(b, start, w) {
                    return true;
                }
                start = i.saturating_add(2);
                i = start;
            } else {
                i = i + 1;
            }
        }
        false
    }

    #[summary("Applies one operation of a JSON Patch to doc. The error names the operation and its path")]
    #[effects(alloc)]
    fn apply_op(doc: &mut json::Value, op: &json::Value) -> Result<(), String> {
        match op {
            json::Value::Null => Err(String::from("expected an object {\"op\", \"path\", ..}")),
            json::Value::Bool(b0) => Err(String::from("expected an object {\"op\", \"path\", ..}")),
            json::Value::Num(n0) => Err(String::from("expected an object {\"op\", \"path\", ..}")),
            json::Value::Str(s0) => Err(String::from("expected an object {\"op\", \"path\", ..}")),
            json::Value::Array(a0) => Err(String::from("expected an object {\"op\", \"path\", ..}")),
            json::Value::Object(kv) => apply_op_of(doc, kv.as_slice()),
        }
    }

    #[summary("apply_op, with the members of the operation")]
    #[effects(alloc)]
    fn apply_op_of(doc: &mut json::Value, kv: &[json::Member]) -> Result<(), String> {
        let oi: usize = at(kv, "op");
        let mut name: String = String::new();
        if oi < kv.len() {
            match json::as_str(&kv[oi].value) {
                None => { return Err(String::from("missing `op`")); },
                Some(o) => { name = o; },
            }
        } else {
            return Err(String::from("missing `op`"));
        }
        let mut allowed: String = String::new();
        if name == "add" || name == "replace" || name == "test" {
            allowed.push_str("op, path, value");
        } else if name == "remove" {
            allowed.push_str("op, path");
        } else if name == "move" || name == "copy" {
            allowed.push_str("op, path, from");
        } else {
            return Err(types::cat3("unknown op `", name.as_str(), "` (add, remove, replace, move, copy, test)"));
        }
        for i in 0..kv.len()
            invariant 0 <= i && i <= kv.len(),
        {
            if !allows(allowed.as_str(), kv[i].key.as_str()) {
                return Err(types::cat3("unexpected field `", kv[i].key.as_str(), "`"));
            }
        }
        let path: Vec<String> = op_pointer(kv, "path")?;
        let mut shown: String = String::new();
        let pi: usize = at(kv, "path");
        if pi < kv.len() {
            match json::as_str(&kv[pi].value) {
                None => {},
                Some(p) => { shown = p; },
            }
        }
        let mut pre: String = name.clone();
        pre.push_str(" `");
        pre.push_str(shown.as_str());
        pre.push_str("`: ");
        if name == "add" {
            let av: json::Value = op_value(kv)?;
            return prefixed(pre.as_str(), add(doc, path.as_slice(), 0, av, 1000000000));
        }
        if name == "remove" {
            return match remove(doc, path.as_slice(), 0, 1000000000) { Ok(gone) => Ok(()), Err(e) => Err(types::cat2(pre.as_str(), e.as_str())), };
        }
        if name == "replace" {
            let rv: json::Value = op_value(kv)?;
            return prefixed(pre.as_str(), replace(doc, path.as_slice(), 0, rv, 1000000000));
        }
        if name == "move" {
            let mfrom: Vec<String> = op_pointer(kv, "from")?;
            if path.len() > mfrom.len() && starts(path.as_slice(), mfrom.as_slice()) {
                return Err(types::cat2(pre.as_str(), "cannot move a value into itself"));
            }
            return match remove(doc, mfrom.as_slice(), 0, 1000000000) { Ok(moved) => prefixed(pre.as_str(), add(doc, path.as_slice(), 0, moved, 1000000000)), Err(e) => Err(types::cat2(pre.as_str(), e.as_str())), };
        }
        if name == "copy" {
            let cfrom: Vec<String> = op_pointer(kv, "from")?;
            return match resolve_at(doc, cfrom.as_slice(), 0, 1000000000) { Ok(copied) => prefixed(pre.as_str(), add(doc, path.as_slice(), 0, copied, 1000000000)), Err(e) => Err(types::cat2(pre.as_str(), e.as_str())), };
        }
        let tv: json::Value = op_value(kv)?;
        match resolve_at(doc, path.as_slice(), 0, 1000000000) {
            Ok(there) => { if same(&there, &tv, 1000000000) { Ok(()) } else { Err(types::cat2(pre.as_str(), "the value differs")) } },
            Err(e) => Err(types::cat2(pre.as_str(), e.as_str())),
        }
    }

    #[summary("Applies a JSON Patch (RFC 6902: add, remove, replace, move, copy, test) to a copy of doc, all or nothing: the patched document, or the error that names the operation")]
    #[effects(alloc)]
    fn apply_patch(doc: &json::Value, patch: &json::Value) -> Result<json::Value, String> {
        match patch {
            json::Value::Null => Err(String::from("a JSON Patch is an array of operations")),
            json::Value::Bool(b0) => Err(String::from("a JSON Patch is an array of operations")),
            json::Value::Num(n0) => Err(String::from("a JSON Patch is an array of operations")),
            json::Value::Str(s0) => Err(String::from("a JSON Patch is an array of operations")),
            json::Value::Array(ops) => { let mut work: json::Value = doc.clone(); for k in 0..ops.len() invariant 0 <= k && k <= ops.len(), { match apply_op(&mut work, &ops[k]) { Ok(done) => {}, Err(e) => { let mut m: String = String::from("operation "); std::num::push_u64(&mut m, k as u64); m.push_str(": "); m.push_str(e.as_str()); return Err(m); }, } } Ok(work) },
            json::Value::Object(o0) => Err(String::from("a JSON Patch is an array of operations")),
        }
    }

    #[summary("The place of the first member named k; the number of members when there is none")]
    #[effects(pure)]
    fn at(kv: &[json::Member], k: &str) -> (r: usize)
        ensures r <= kv.len(),
    {
        for i in 0..kv.len()
            invariant 0 <= i && i <= kv.len(),
        {
            if kv[i].key.as_str() == k {
                return i;
            }
        }
        kv.len()
    }

    #[summary("An attribute argument as JSON: a name, an object with str, or an object with key and value")]
    #[effects(alloc)]
    fn attr_arg(x: &ast::AttrArg, f: usize) -> json::Value
        decreases f,
    {
        if f == 0 {
            return json::Value::Null;
        }
        match x {
            ast::AttrArg::Ident(i) => s(i.name.as_str()),
            ast::AttrArg::Str(t, tsp) => { let mut kv: Vec<json::Member> = Vec::new(); put(&mut kv, "str", s(t.as_str())); json::Value::Object(kv) },
            ast::AttrArg::Pair(k, v) => { let mut pkv: Vec<json::Member> = Vec::new(); put(&mut pkv, "key", s(k.name.as_str())); put(&mut pkv, "value", attr_arg(&**v, f - 1)); json::Value::Object(pkv) },
        }
    }

    #[summary("The arguments of an attribute as a JSON list")]
    #[effects(alloc)]
    fn attr_args(xs: &[ast::AttrArg]) -> json::Value {
        let mut out: Vec<json::Value> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(attr_arg(&xs[i], 1000000000));
        }
        json::Value::Array(out)
    }

    #[summary("The place of the first attribute named name; the number of attributes when there is none")]
    #[effects(pure)]
    fn attr_at(attrs: &[ast::Attr], name: &str) -> (r: usize)
        ensures r <= attrs.len(),
    {
        for i in 0..attrs.len()
            invariant 0 <= i && i <= attrs.len(),
        {
            if attrs[i].name.name.as_str() == name {
                return i;
            }
        }
        attrs.len()
    }

    #[summary("The operator written s")]
    #[effects(alloc)]
    fn bin_op(s: &str) -> Option<ast::BinOp> {
        let all: Vec<ast::BinOp> = bin_ops();
        let mut found: Option<ast::BinOp> = None;
        let mut left: Vec<ast::BinOp> = all;
        let n: usize = left.len();
        for i in 0..n
            invariant 0 <= i && i <= n,
        {
            match left.pop() {
                None => {},
                Some(op) => { let mut sym: String = String::new(); ast::push_bin_symbol(&mut sym, &op); if sym == s { found = Some(op); } },
            }
        }
        found
    }

    #[summary("Every binary operator")]
    #[effects(alloc)]
    fn bin_ops() -> Vec<ast::BinOp> {
        let mut v: Vec<ast::BinOp> = Vec::new();
        v.push(ast::BinOp::Add);
        v.push(ast::BinOp::Sub);
        v.push(ast::BinOp::Mul);
        v.push(ast::BinOp::Div);
        v.push(ast::BinOp::Rem);
        v.push(ast::BinOp::Eq);
        v.push(ast::BinOp::Ne);
        v.push(ast::BinOp::Lt);
        v.push(ast::BinOp::Le);
        v.push(ast::BinOp::Gt);
        v.push(ast::BinOp::Ge);
        v.push(ast::BinOp::And);
        v.push(ast::BinOp::Or);
        v.push(ast::BinOp::Implies);
        v.push(ast::BinOp::BitAnd);
        v.push(ast::BinOp::BitOr);
        v.push(ast::BinOp::BitXor);
        v.push(ast::BinOp::Shl);
        v.push(ast::BinOp::Shr);
        v
    }

    #[summary("Whether the text is a u32 above zero as Rust's parse reads it: digits, after a + or not, that fit")]
    #[effects(pure)]
    fn block_number(t: &str) -> bool {
        block_number_of(t.as_bytes())
    }

    #[summary("block_number, with the bytes of the text")]
    #[effects(pure)]
    fn block_number_of(b: &[u8]) -> bool {
        let mut i: usize = 0;
        if b.len() > 0 && b[0] == 43 {
            i = 1;
        }
        if i >= b.len() {
            return false;
        }
        let mut v: u64 = 0;
        while i < b.len()
            invariant v <= 4294967295,
            decreases b.len() - i,
        {
            if b[i] < 48 || b[i] > 57 {
                return false;
            }
            v = v * 10 + (b[i] - 48) as u64;
            if v > 4294967295 {
                return false;
            }
            i = i + 1;
        }
        v > 0
    }

    #[summary("true or false of a JSON value; None for another value")]
    #[effects(pure)]
    fn bool_of(v: &json::Value) -> Option<bool> {
        match v {
            json::Value::Null => None,
            json::Value::Bool(b) => Some(*b),
            json::Value::Num(n0) => None,
            json::Value::Str(s0) => None,
            json::Value::Array(a0) => None,
            json::Value::Object(o0) => None,
        }
    }

    #[summary("An optional expression in a box")]
    #[effects(alloc)]
    fn boxed(o: Option<ast::Expr>) -> Option<Box<ast::Expr>> {
        match o {
            None => None,
            Some(e) => Some(Box::new(e)),
        }
    }

    #[summary("The decimal digits n as a number of 128 bits; None when it does not fit")]
    #[effects(pure)]
    #[uses(wide::small)]
    fn dec_u128(n: &str) -> Option<wide::U128> {
        let mut v: wide::U128 = wide::zero();
        for i in 0..n.len()
            invariant 0 <= i && i <= n.len(),
        {
            let c: u8 = n.as_bytes()[i];
            if c < 48 || c > 57 {
                return None;
            }
            v = wide::mul_add(v, 10, (c - 48) as u64)?;
        }
        Some(v)
    }

    #[summary("Whether the else of an if is an if or a block, or absent")]
    #[effects(pure)]
    fn else_ok(o: &Option<ast::Expr>) -> bool {
        match o {
            None => true,
            Some(e) => ast::tag(&e.kind) == 15 || ast::tag(&e.kind) == 16,
        }
    }

    #[summary("One segment of a JSON Pointer (RFC 6901 §3): ~ as ~0 and / as ~1")]
    #[effects(alloc)]
    fn escape(seg: &str) -> String {
        let mut out: String = String::new();
        let mut start: usize = 0;
        for i in 0..seg.len()
            invariant 0 <= i && i <= seg.len(), start <= i,
        {
            let c: u8 = seg.as_bytes()[i];
            if c == 126 || c == 47 {
                out.push_str(lexer::cut(seg, start, i).as_str());
                if c == 126 {
                    out.push_str("~0");
                } else {
                    out.push_str("~1");
                }
                start = i + 1;
            }
        }
        out.push_str(lexer::cut(seg, start, seg.len()).as_str());
        out
    }

    #[summary("The JSON document of p (stage0 export)")]
    #[effects(alloc)]
    fn export(p: &ast::Program) -> Result<json::Value, String> {
        let mut ex: Ex = Ex { at: Vec::new(), rec: false, spans: Vec::new(), lens: table::new::<String>() };
        ex.units(p.mods.as_slice(), 1000000000)
    }

    #[summary("The JSON document of p and, in spans, the pointer of every node with a span, parents before children (stage0 export_spans)")]
    #[effects(alloc)]
    fn export_spans(p: &ast::Program, spans: &mut Vec<Mark>) -> Result<json::Value, String> {
        let mut ex: Ex = Ex { at: Vec::new(), rec: true, spans: Vec::new(), lens: table::new::<String>() };
        let r: Result<json::Value, String> = ex.units(p.mods.as_slice(), 1000000000);
        let got: Vec<Mark> = ex.spans;
        for i in 0..got.len()
            invariant 0 <= i && i <= got.len(),
        {
            spans.push(Mark { span: got[i].span, ptr: got[i].ptr.clone() });
        }
        r
    }

    #[summary("The bits of the f64 a JSON number reads as, as Rust's parse reads it; None for a number with a sign or one too large to be finite")]
    #[effects(alloc)]
    fn float_bits(n: &str) -> Option<u64> {
        float_bits_of(n.as_bytes())
    }

    #[summary("float_bits, with the bytes of the text")]
    #[effects(alloc)]
    fn float_bits_of(b: &[u8]) -> Option<u64> {
        if b.len() == 0 || b[0] == 45 {
            return None;
        }
        let mut int: Vec<u8> = Vec::new();
        let mut frac: Vec<u8> = Vec::new();
        let mut exp: Vec<u8> = Vec::new();
        let mut neg: bool = false;
        let mut part: u8 = 0;
        for i in 0..b.len()
            invariant 0 <= i && i <= b.len(),
        {
            let c: u8 = b[i];
            if c == 46 {
                part = 1;
            } else if c == 101 || c == 69 {
                part = 2;
            } else if c == 45 {
                neg = true;
            } else if c >= 48 && c <= 57 {
                if part == 0 {
                    int.push(c);
                } else if part == 1 {
                    frac.push(c);
                } else {
                    exp.push(c);
                }
            }
        }
        let bits: u64 = float::parse(int.as_slice(), frac.as_slice(), neg, exp.as_slice());
        if bits >= 9218868437227405312 {
            return None;
        }
        Some(bits)
    }

    #[summary("The pointer of the segments segs[0..=k], for an error")]
    #[effects(alloc)]
    fn here(segs: &[String], k: usize) -> String {
        let mut out: String = String::new();
        for i in 0..segs.len()
            invariant 0 <= i && i <= segs.len(),
        {
            if i <= k {
                out.push_str("/");
                out.push_str(escape(segs[i].as_str()).as_str());
            }
        }
        out
    }

    #[summary("An identifier without a position")]
    #[effects(alloc)]
    fn id(name: &str) -> ast::Ident {
        ast::Ident { name: String::from(name), span: sp() }
    }

    #[summary("The names of a path")]
    #[effects(alloc)]
    fn idents_names(path: &[ast::Ident]) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..path.len()
            invariant 0 <= i && i <= path.len(),
        {
            out.push(path[i].name.clone());
        }
        out
    }

    #[summary("The segments as identifiers")]
    #[effects(alloc)]
    fn ids(segs: &[String]) -> Vec<ast::Ident> {
        let mut out: Vec<ast::Ident> = Vec::new();
        for i in 0..segs.len()
            invariant 0 <= i && i <= segs.len(),
        {
            out.push(id(segs[i].as_str()));
        }
        out
    }

    #[summary("The name a key of impls is checked as: T of T#k when k is a number above zero as Rust reads a u32 (a + before the digits is taken), otherwise the key")]
    #[effects(alloc)]
    fn impl_base(key: &str) -> String {
        match encode_query::split_once(key, "#") {
            None => String::from(key),
            Some(p) => { if block_number(p.b.as_str()) { p.a } else { String::from(key) } },
        }
    }

    #[summary("The keys of the impl blocks: the type's name for its first block, T#1, T#2 for its later ones in the order written")]
    #[effects(alloc)]
    fn impl_keys(impls: &[ast::Impl]) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..impls.len()
            invariant 0 <= i && i <= impls.len(),
        {
            let mut k: u64 = 0;
            for j in 0..i
                invariant 0 <= j && j <= i, k <= j as u64,
            {
                if impls[j].ty.name == impls[i].ty.name {
                    k = k + 1;
                }
            }
            let mut key: String = impls[i].ty.name.clone();
            if k > 0 {
                key.push_str("#");
                std::num::push_u64(&mut key, k);
            }
            out.push(key);
        }
        out
    }

    #[summary("Whether t is a trait impl's method as the parser keeps it in uses: <a::T as b::Tr>::name")]
    #[effects(alloc)]
    fn impl_path(t: &str) -> bool {
        if t.len() == 0 || t.as_bytes()[0] != 60 {
            return false;
        }
        match encode_query::split_once(lexer::cut(t, 1, t.len()).as_str(), ">::") {
            None => false,
            Some(hn) => { match encode_query::split_once(hn.a.as_str(), " as ") { None => false, Some(tt) => is_name(hn.b.as_str()) && names(refs::split_path(tt.a.as_str()).as_slice()) && names(refs::split_path(tt.b.as_str()).as_slice()), } },
        }
    }

    #[summary("The type of a key of impls: the text before its first #")]
    #[effects(alloc)]
    fn impl_type(key: &str) -> String {
        match encode_query::split_once(key, "#") {
            None => String::from(key),
            Some(p) => p.a,
        }
    }

    #[summary("The program a JSON document describes (stage0 import). Spans are empty: the caller prints the program in normal form and parses it back")]
    #[effects(alloc)]
    fn import(doc: &json::Value) -> Result<ast::Program, String> {
        let mut im: Im = Im { at: Vec::new(), lens: Vec::new(), counts: 0 };
        let mods: Vec<ast::Mod> = im.units(doc, 1000000000)?;
        Ok(ast::Program { mods: mods })
    }

    #[summary("An array index of a pointer segment: digits without a leading zero, below len; with allow_end also len itself or -. The error is stage0's message. An index of 19 digits or more is out of range without being read (no array is that long)")]
    #[effects(alloc)]
    fn index(seg: &str, len: usize, allow_end: bool) -> (r: Result<usize, String>)
        ensures match r { Ok(i) => i < len || allow_end && i == len, Err(e) => true, },
    {
        index_of(seg, seg.as_bytes(), len, allow_end)
    }

    #[summary("index, with the bytes of the text")]
    #[effects(alloc)]
    fn index_of(seg: &str, b: &[u8], len: usize, allow_end: bool) -> (r: Result<usize, String>)
        ensures match r { Ok(i) => i < len || allow_end && i == len, Err(e) => true, },
    {
        if allow_end && seg == "-" {
            return Ok(len);
        }
        let mut ok: bool = b.len() > 0 && (b.len() == 1 || b[0] != 48);
        let mut v: usize = 0;
        for i in 0..b.len()
            invariant 0 <= i && i <= b.len(), v <= 1000000000000000009,
        {
            if b[i] < 48 || b[i] > 57 {
                ok = false;
            } else if ok {
                let d: usize = (b[i] - 48) as usize;
                if v > 100000000000000000 {
                    ok = false;
                } else {
                    v = v * 10 + d;
                }
            }
        }
        if ok && (v < len || allow_end && v == len) {
            return Ok(v);
        }
        let mut m: String = String::from("array index `");
        m.push_str(seg);
        m.push_str("` is out of range (length ");
        std::num::push_u64(&mut m, len as u64);
        m.push_str(")");
        Err(m)
    }

    #[summary("The decimal text of k")]
    #[effects(alloc)]
    fn index_text(k: usize) -> String {
        let mut out: String = String::new();
        std::num::push_u64(&mut out, k as u64);
        out
    }

    #[summary("A name as the parser takes it: ASCII letters, digits and _, not starting with a digit")]
    #[effects(pure)]
    fn is_name(x: &str) -> bool {
        is_name_of(x.as_bytes())
    }

    #[summary("is_name, with the bytes of the text")]
    #[effects(pure)]
    fn is_name_of(b: &[u8]) -> bool {
        if b.len() == 0 {
            return false;
        }
        for i in 0..b.len()
            invariant 0 <= i && i <= b.len(),
        {
            let c: u8 = b[i];
            let letter: bool = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95;
            let digit: bool = c >= 48 && c <= 57;
            if !(letter || digit && i > 0) {
                return false;
            }
        }
        true
    }

    #[summary("Whether the value is null")]
    #[effects(pure)]
    fn is_null(v: &json::Value) -> bool {
        match v {
            json::Value::Null => true,
            json::Value::Bool(b0) => false,
            json::Value::Num(n0) => false,
            json::Value::Str(s0) => false,
            json::Value::Array(a0) => false,
            json::Value::Object(o0) => false,
        }
    }

    #[summary("Whether the argument is key = value")]
    #[effects(pure)]
    fn is_pair(x: &ast::AttrArg) -> bool {
        match x {
            ast::AttrArg::Ident(i) => false,
            ast::AttrArg::Str(t, tsp) => false,
            ast::AttrArg::Pair(k, v) => true,
        }
    }

    #[summary("Sets the member kind")]
    #[effects(alloc)]
    fn kind(kv: &mut Vec<json::Member>, name: &str) -> () {
        put(kv, "kind", s(name));
    }

    #[summary("Sets the member label, when there is one")]
    #[effects(alloc)]
    fn label(kv: &mut Vec<json::Member>, l: &Option<ast::Ident>) -> () {
        match l {
            None => {},
            Some(i) => put(kv, "label", s(i.name.as_str())),
        }
    }

    #[summary("Whether every segment is a name")]
    #[effects(pure)]
    fn names(segs: &[String]) -> bool {
        for i in 0..segs.len()
            invariant 0 <= i && i <= segs.len(),
        {
            if !is_name(segs[i].as_str()) {
                return false;
            }
        }
        true
    }

    #[summary("The pointer of the innermost node in spans whose range holds lo..hi of file and is not empty (stage0 node_at): the smallest range; among equal ranges the longest pointer; among those the first")]
    #[effects(alloc)]
    fn node_at(spans: &[Mark], file: u32, lo: u32, hi: u32) -> Option<String> {
        let mut best: usize = spans.len();
        for i in 0..spans.len()
            invariant 0 <= i && i <= spans.len(), best <= spans.len(),
        {
            let sp0: source::Span = spans[i].span;
            if sp0.file == file && sp0.lo <= lo && hi <= sp0.hi && sp0.hi > sp0.lo {
                if best == spans.len() {
                    best = i;
                } else {
                    let bs: source::Span = spans[best].span;
                    if bs.hi >= bs.lo {
                        let w: u32 = sp0.hi - sp0.lo;
                        let bw: u32 = bs.hi - bs.lo;
                        if w < bw || w == bw && spans[i].ptr.len() > spans[best].ptr.len() {
                            best = i;
                        }
                    }
                }
            }
        }
        if best < spans.len() {
            Some(spans[best].ptr.clone())
        } else {
            None
        }
    }

    #[summary("A JSON number of n")]
    #[effects(alloc)]
    fn num(n: u64) -> json::Value {
        let mut out: String = String::new();
        std::num::push_u64(&mut out, n);
        json::Value::Num(out)
    }

    #[summary("The text of a JSON number; None for another value")]
    #[effects(alloc)]
    fn num_of(v: &json::Value) -> Option<String> {
        match v {
            json::Value::Null => None,
            json::Value::Bool(b0) => None,
            json::Value::Num(n) => Some(n.clone()),
            json::Value::Str(s0) => None,
            json::Value::Array(a0) => None,
            json::Value::Object(o0) => None,
        }
    }

    #[summary("The error of a pointer that leaves the document at segs[k]: the value there is no object or array")]
    #[effects(alloc)]
    fn off(segs: &[String], k: usize) -> String {
        if segs.len() > 0 && k == segs.len() - 1 {
            return String::from("the parent is not an object or array");
        }
        types::cat2(here(segs, k).as_str(), ": not inside an object or array")
    }

    #[summary("The segments of the pointer in the text member k of an operation")]
    #[effects(alloc)]
    fn op_pointer(kv: &[json::Member], k: &str) -> Result<Vec<String>, String> {
        let i: usize = at(kv, k);
        if i < kv.len() {
            match json::as_str(&kv[i].value) {
                None => {},
                Some(p) => { return pointer(p.as_str()); },
            }
        }
        Err(types::cat3("missing `", k, "` (a JSON Pointer string)"))
    }

    #[summary("A copy of the member value of an operation")]
    #[effects(alloc)]
    fn op_value(kv: &[json::Member]) -> Result<json::Value, String> {
        let i: usize = at(kv, "value");
        if i < kv.len() {
            Ok(kv[i].value.clone())
        } else {
            Err(String::from("missing `value`"))
        }
    }

    #[summary("The names of a path joined by ::")]
    #[effects(alloc)]
    fn path_text(p: &[ast::Ident]) -> String {
        let mut out: String = String::new();
        for i in 0..p.len()
            invariant 0 <= i && i <= p.len(),
        {
            if i > 0 {
                out.push_str("::");
            }
            out.push_str(p[i].name.as_str());
        }
        out
    }

    #[summary("The functions of fs in their order, without the flags")]
    #[effects(alloc)]
    fn plain_fns(fs: Vec<ast::TraitFn>) -> Vec<ast::FnDef> {
        let mut from: Vec<ast::TraitFn> = fs;
        let mut back: Vec<ast::FnDef> = Vec::new();
        let n: usize = from.len();
        for i in 0..n
            invariant 0 <= i && i <= n,
        {
            match from.pop() {
                None => {},
                Some(tf) => back.push(tf.f),
            }
        }
        let mut out: Vec<ast::FnDef> = Vec::new();
        let m: usize = back.len();
        for j in 0..m
            invariant 0 <= j && j <= m,
        {
            match back.pop() {
                None => {},
                Some(d) => out.push(d),
            }
        }
        out
    }

    #[summary("The segments of a JSON Pointer (RFC 6901): the empty text is the whole document. The error is stage0's message")]
    #[effects(alloc)]
    fn pointer(p: &str) -> Result<Vec<String>, String> {
        pointer_of(p, p.as_bytes())
    }

    #[summary("pointer, with the bytes of the text")]
    #[effects(alloc)]
    fn pointer_of(p: &str, b: &[u8]) -> Result<Vec<String>, String> {
        let mut out: Vec<String> = Vec::new();
        if b.len() == 0 {
            return Ok(out);
        }
        if b[0] != 47 {
            return Err(types::cat3("`", p, "` is not a JSON Pointer (it starts with `/`)"));
        }
        let mut seg: String = String::new();
        let mut start: usize = 1;
        let mut i: usize = 1;
        while i < b.len()
            invariant start <= i,
            decreases b.len() - i,
        {
            if b[i] == 47 {
                seg.push_str(lexer::cut(p, start, i).as_str());
                out.push(seg);
                seg = String::new();
                start = i + 1;
                i = i + 1;
            } else if b[i] == 126 {
                seg.push_str(lexer::cut(p, start, i).as_str());
                if i + 1 < b.len() && b[i + 1] == 48 {
                    seg.push_str("~");
                } else if i + 1 < b.len() && b[i + 1] == 49 {
                    seg.push_str("/");
                } else {
                    return Err(types::cat3("`", p, "`: `~` is written `~0` and `/` `~1`"));
                }
                start = i + 2;
                i = i + 2;
            } else {
                i = i + 1;
            }
        }
        seg.push_str(lexer::cut(p, start, b.len()).as_str());
        out.push(seg);
        Ok(out)
    }

    #[summary("The JSON Pointer of the segments: each after a /, escaped")]
    #[effects(alloc)]
    fn pointer_text(at0: &[String]) -> String {
        let mut out: String = String::new();
        for i in 0..at0.len()
            invariant 0 <= i && i <= at0.len(),
        {
            out.push_str("/");
            out.push_str(escape(at0[i].as_str()).as_str());
        }
        out
    }

    #[summary("r with pre before its error")]
    #[effects(alloc)]
    fn prefixed(pre: &str, r: Result<(), String>) -> Result<(), String> {
        match r {
            Ok(u) => Ok(()),
            Err(e) => Err(types::cat2(pre, e.as_str())),
        }
    }

    #[summary("Adds the member k with the value v")]
    #[effects(alloc)]
    fn put(kv: &mut Vec<json::Member>, k: &str, v: json::Value) -> () {
        kv.push(json::Member { key: String::from(k), value: v });
    }

    #[summary("Takes the value at the pointer segs[k..] out of doc (RFC 6902 remove)")]
    #[effects(alloc)]
    fn remove(doc: &mut json::Value, segs: &[String], k: usize, f: usize) -> Result<json::Value, String>
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        if k >= segs.len() {
            return Err(String::from("cannot remove the whole document"));
        }
        match doc {
            json::Value::Null => Err(off(segs, k)),
            json::Value::Bool(b0) => Err(off(segs, k)),
            json::Value::Num(n0) => Err(off(segs, k)),
            json::Value::Str(s0) => Err(off(segs, k)),
            json::Value::Array(xs) => remove_elem(xs, segs, k, f - 1),
            json::Value::Object(kv) => remove_member(kv, segs, k, f - 1),
        }
    }

    #[summary("remove inside the array xs")]
    #[effects(alloc)]
    fn remove_elem(xs: &mut Vec<json::Value>, segs: &[String], k: usize, f: usize) -> Result<json::Value, String>
        requires k < segs.len(),
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        if k + 1 == segs.len() {
            let i: usize = index(segs[k].as_str(), xs.len(), false)?;
            let n: usize = xs.len();
            let gone: json::Value = std::mem::replace(&mut xs[i], json::Value::Null);
            for j in i..n - 1
                invariant xs.len() == n, i <= j,
            {
                let next: json::Value = std::mem::replace(&mut xs[j + 1], json::Value::Null);
                xs[j] = next;
            }
            xs.pop();
            return Ok(gone);
        }
        match index(segs[k].as_str(), xs.len(), false) {
            Ok(at0) => remove(&mut xs[at0], segs, k + 1, f - 1),
            Err(e) => Err(types::cat3(here(segs, k).as_str(), ": ", e.as_str())),
        }
    }

    #[summary("remove inside the object kv")]
    #[effects(alloc)]
    fn remove_member(kv: &mut Vec<json::Member>, segs: &[String], k: usize, f: usize) -> Result<json::Value, String>
        requires k < segs.len(),
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        let i: usize = at(kv.as_slice(), segs[k].as_str());
        if k + 1 == segs.len() {
            if i >= kv.len() {
                return Err(String::from("no such member"));
            }
            let n: usize = kv.len();
            let gone: json::Value = std::mem::replace(&mut kv[i].value, json::Value::Null);
            for j in i..n - 1
                invariant kv.len() == n, i <= j,
            {
                let next: json::Member = std::mem::replace(&mut kv[j + 1], json::Member { key: String::new(), value: json::Value::Null });
                kv[j] = next;
            }
            kv.pop();
            return Ok(gone);
        }
        if i < kv.len() {
            remove(&mut kv[i].value, segs, k + 1, f - 1)
        } else {
            Err(types::cat2(here(segs, k).as_str(), ": no such member"))
        }
    }

    #[summary("Sets the value at the pointer segs[k..] of doc, which must be there (RFC 6902 replace)")]
    #[effects(alloc)]
    fn replace(doc: &mut json::Value, segs: &[String], k: usize, v: json::Value, f: usize) -> Result<(), String>
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        if k >= segs.len() {
            *doc = v;
            return Ok(());
        }
        match doc {
            json::Value::Null => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Bool(b0) => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Num(n0) => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Str(s0) => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Array(xs) => replace_elem(xs, segs, k, v, f - 1),
            json::Value::Object(kv) => replace_member(kv, segs, k, v, f - 1),
        }
    }

    #[summary("replace inside the array xs")]
    #[effects(alloc)]
    fn replace_elem(xs: &mut Vec<json::Value>, segs: &[String], k: usize, v: json::Value, f: usize) -> Result<(), String>
        requires k < segs.len(),
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        match index(segs[k].as_str(), xs.len(), false) {
            Ok(at0) => replace(&mut xs[at0], segs, k + 1, v, f - 1),
            Err(e) => Err(types::cat3(here(segs, k).as_str(), ": ", e.as_str())),
        }
    }

    #[summary("replace inside the object kv")]
    #[effects(alloc)]
    fn replace_member(kv: &mut Vec<json::Member>, segs: &[String], k: usize, v: json::Value, f: usize) -> Result<(), String>
        requires k < segs.len(),
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        let i: usize = at(kv.as_slice(), segs[k].as_str());
        if i < kv.len() {
            replace(&mut kv[i].value, segs, k + 1, v, f - 1)
        } else {
            Err(types::cat2(here(segs, k).as_str(), ": no such member"))
        }
    }

    #[summary("A copy of the value at the pointer segs of doc (stage0 resolve). The error is stage0's message")]
    #[effects(alloc)]
    fn resolve(doc: &json::Value, segs: &[String]) -> Result<json::Value, String> {
        resolve_at(doc, segs, 0, 1000000000)
    }

    #[summary("resolve from segment k on")]
    #[effects(alloc)]
    fn resolve_at(doc: &json::Value, segs: &[String], k: usize, f: usize) -> Result<json::Value, String>
        decreases f,
    {
        if f == 0 {
            return Err(String::new());
        }
        if k >= segs.len() {
            return Ok(doc.clone());
        }
        match doc {
            json::Value::Null => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Bool(b0) => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Num(n0) => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Str(s0) => Err(types::cat2(here(segs, k).as_str(), ": not inside an object or array")),
            json::Value::Array(xs) => { match index(segs[k].as_str(), xs.len(), false) { Ok(i) => resolve_at(&xs[i], segs, k + 1, f - 1), Err(e) => Err(types::cat3(here(segs, k).as_str(), ": ", e.as_str())), } },
            json::Value::Object(kv) => { let j: usize = at(kv.as_slice(), segs[k].as_str()); if j < kv.len() { resolve_at(&kv[j].value, segs, k + 1, f - 1) } else { Err(types::cat2(here(segs, k).as_str(), ": no such member")) } },
        }
    }

    #[summary("A JSON string of x")]
    #[effects(alloc)]
    fn s(x: &str) -> json::Value {
        json::Value::Str(String::from(x))
    }

    #[summary("Whether two values are equal: a number by its text, the members of an object in their order")]
    #[effects(pure)]
    fn same(a: &json::Value, b: &json::Value, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match a {
            json::Value::Null => is_null(b),
            json::Value::Bool(x) => { match b { json::Value::Null => false, json::Value::Bool(y) => *x == *y, json::Value::Num(n0) => false, json::Value::Str(s0) => false, json::Value::Array(a0) => false, json::Value::Object(o0) => false, } },
            json::Value::Num(xn) => { match b { json::Value::Null => false, json::Value::Bool(b1) => false, json::Value::Num(yn) => xn.as_str() == yn.as_str(), json::Value::Str(s1) => false, json::Value::Array(a1) => false, json::Value::Object(o1) => false, } },
            json::Value::Str(xs) => { match b { json::Value::Null => false, json::Value::Bool(b2) => false, json::Value::Num(n2) => false, json::Value::Str(ys) => xs.as_str() == ys.as_str(), json::Value::Array(a2) => false, json::Value::Object(o2) => false, } },
            json::Value::Array(xa) => { match b { json::Value::Null => false, json::Value::Bool(b3) => false, json::Value::Num(n3) => false, json::Value::Str(s3) => false, json::Value::Array(ya) => { if xa.len() != ya.len() { return false; } for i in 0..xa.len() invariant 0 <= i && i <= xa.len(), { if !same(&xa[i], &ya[i], f - 1) { return false; } } true }, json::Value::Object(o3) => false, } },
            json::Value::Object(xo) => { match b { json::Value::Null => false, json::Value::Bool(b4) => false, json::Value::Num(n4) => false, json::Value::Str(s4) => false, json::Value::Array(a4) => false, json::Value::Object(yo) => { if xo.len() != yo.len() { return false; } for j in 0..xo.len() invariant 0 <= j && j <= xo.len(), { if xo[j].key != yo[j].key || !same(&xo[j].value, &yo[j].value, f - 1) { return false; } } true }, } },
        }
    }

    #[summary("Whether the bytes w are in b from a on")]
    #[effects(pure)]
    fn same_bytes(b: &[u8], a: usize, w: &[u8]) -> bool {
        if a > b.len() || b.len() - a < w.len() {
            return false;
        }
        for k in 0..w.len()
            invariant 0 <= k && k <= w.len(),
        {
            if b[a + k] != w[k] {
                return false;
            }
        }
        true
    }

    #[summary("The digits n as a number up to max; None for other text and for a larger number")]
    #[effects(pure)]
    fn small_num(n: &str, max: u64) -> (r: Option<u64>)
        requires max <= 1000000,
        ensures match r { None => true, Some(v) => v <= max, },
    {
        small_num_of(n.as_bytes(), max)
    }

    #[summary("small_num, with the bytes of the text")]
    #[effects(pure)]
    fn small_num_of(b: &[u8], max: u64) -> (r: Option<u64>)
        requires max <= 1000000,
        ensures match r { None => true, Some(v) => v <= max, },
    {
        if b.len() == 0 {
            return None;
        }
        let mut v: u64 = 0;
        for i in 0..b.len()
            invariant 0 <= i && i <= b.len(), v <= max,
        {
            if b[i] < 48 || b[i] > 57 {
                return None;
            }
            v = v * 10 + (b[i] - 48) as u64;
            if v > max {
                return None;
            }
        }
        Some(v)
    }

    #[summary("The empty span of a node read from a document")]
    #[effects(pure)]
    fn sp() -> source::Span {
        source::Span { file: 0, lo: 0, hi: 0 }
    }

    #[summary("The key of a span in the table of repeat counts")]
    #[effects(alloc)]
    fn span_key(x: source::Span) -> String {
        let mut out: String = String::new();
        std::num::push_u64(&mut out, x.file as u64);
        out.push_str(":");
        std::num::push_u64(&mut out, x.lo as u64);
        out.push_str(":");
        std::num::push_u64(&mut out, x.hi as u64);
        out
    }

    #[summary("Whether the segments of path begin with those of from")]
    #[effects(pure)]
    fn starts(path: &[String], from: &[String]) -> bool {
        if path.len() < from.len() {
            return false;
        }
        for i in 0..from.len()
            invariant 0 <= i && i <= from.len(),
        {
            if path[i] != from[i] {
                return false;
            }
        }
        true
    }

    #[summary("The attribute summary with the text")]
    #[effects(alloc)]
    fn summary_attr(text: String) -> ast::Attr {
        let mut args: Vec<ast::AttrArg> = Vec::new();
        args.push(ast::AttrArg::Str(text, sp()));
        ast::Attr { name: id("summary"), args: args, span: sp() }
    }

    #[summary("The summary of a unit: the first argument of the first attribute summary whose first argument is a string")]
    #[effects(alloc)]
    fn unit_summary(attrs: &[ast::Attr]) -> Option<String> {
        for i in 0..attrs.len()
            invariant 0 <= i && i <= attrs.len(),
        {
            if attrs[i].name.name == "summary" && attrs[i].args.len() > 0 {
                match &attrs[i].args[0] {
                    ast::AttrArg::Ident(n) => {},
                    ast::AttrArg::Str(t, tsp) => { return Some(t.clone()); },
                    ast::AttrArg::Pair(k, v) => {},
                }
            }
        }
        None
    }
}
