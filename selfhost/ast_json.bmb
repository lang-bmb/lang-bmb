        fn targ_of(self: &mut Im, kv: &[json::Member], n: usize, f: usize) -> Result<ast::TArgs, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "type arguments", "seg, args")?;
            let seg: wide::U128 = self.number(kv, "seg")?;
            if seg.hi != 0 || seg.lo >= n as u64 {
                return Err(self.fail_at("seg", "no such segment in the path"));
            }
            let args: Vec<ast::Type> = self.tys(kv, "args", f - 1)?;
            Ok(ast::TArgs { seg: seg.lo as usize, args: args, span: sp() })
        }

