        #[summary("A list of names in the form of the parser's patterns: a name, or _ for none")]
        #[effects(alloc)]
        fn binds(self: &mut Im, kv: &[json::Member], k: &str) -> Result<Vec<Option<ast::Ident>>, String> {
            let mut out: Vec<Option<ast::Ident>> = Vec::new();
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); match json::as_str(&xs[j]) { None => { return Err(self.fail("expected a name or \"_\"")); }, Some(x) => { if x == "_" { out.push(None); } else if is_name(x.as_str()) { out.push(Some(id(x.as_str()))); } else { return Err(self.fail("expected a name or \"_\"")); } }, } self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("A block from the object v")]
        #[effects(alloc)]
        fn block(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Block, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a block (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a block (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a block (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a block (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a block (an object)")),
                json::Value::Object(o) => self.block_of(o.as_slice(), f - 1),
            }
        }

        #[summary("A block from the members stmts and tail of an object that may also say that its kind is block")]
        #[effects(alloc)]
        fn block_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Block, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a block", "kind, stmts, tail")?;
            let ki: usize = at(kv, "kind");
            if ki < kv.len() {
                match json::as_str(&kv[ki].value) {
                    None => { return Err(self.fail("expected a block")); },
                    Some(k) => { if k != "block" { return Err(self.fail("expected a block")); } },
                }
            }
            self.block_parts(kv, f - 1)
        }

        #[summary("A block from the members stmts and tail")]
        #[effects(alloc)]
        fn block_parts(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Block, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let stmts: Vec<ast::Stmt> = self.stmts(kv, "stmts", f - 1)?;
            let tail: Option<ast::Expr> = self.opt_expr(kv, "tail", f - 1)?;
            Ok(ast::Block { stmts: stmts, tail: boxed(tail), span: sp() })
        }

        #[summary("The trait paths of a type parameter")]
        #[effects(alloc)]
        fn bounds(self: &mut Im, kv: &[json::Member], k: &str) -> Result<Vec<Vec<ast::Ident>>, String> {
            let mut out: Vec<Vec<ast::Ident>> = Vec::new();
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); match json::as_str(&xs[j]) { None => { return Err(self.fail("expected a trait path")); }, Some(p) => { let one: Vec<ast::Ident> = self.path_of("", p.as_str())?; out.push(one); }, } self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("The bytes of a byte string")]
        #[effects(alloc)]
        fn bytes(self: &mut Im, kv: &[json::Member], k: &str) -> Result<Vec<u8>, String> {
            let mut out: Vec<u8> = Vec::new();
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); match num_of(&xs[j]) { None => { return Err(self.fail("expected a byte (0..=255)")); }, Some(n) => { match small_num(n.as_str(), 255) { None => { return Err(self.fail("a byte is 0..=255")); }, Some(b) => out.push(b as u8), } }, } self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("The members kv as those of what, which has the members named in allowed (joined by a comma and a space) and none twice")]
        #[effects(alloc)]
        fn check(self: &Im, kv: &[json::Member], what: &str, allowed: &str) -> Result<(), String> {
            for i in 0..kv.len()
                invariant 0 <= i && i <= kv.len(),
            {
                if !allows(allowed, kv[i].key.as_str()) {
                    let mut m: String = String::from(what);
                    m.push_str(" has no field `");
                    m.push_str(kv[i].key.as_str());
                    m.push_str("` (fields: ");
                    m.push_str(allowed);
                    m.push_str(")");
                    return Err(self.fail(m.as_str()));
                }
            }
            for j in 0..kv.len()
                invariant 0 <= j && j <= kv.len(),
            {
                if at(kv, kv[j].key.as_str()) < j {
                    return Err(self.fail(types::cat3("field `", kv[j].key.as_str(), "` given twice").as_str()));
                }
            }
            Ok(())
        }

        #[summary("Refuses n as a name under the member k")]
        #[effects(alloc)]
        fn check_name(self: &Im, k: &str, n: &str) -> Result<(), String> {
            if is_name(n) {
                Ok(())
            } else {
                Err(self.fail_at(k, types::cat3("`", n, "` is not a name").as_str()))
            }
        }

        #[summary("A closure from its members")]
        #[effects(alloc)]
        fn closure_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::ExprKind, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a closure", "kind, move, params, ret, requires, ensures, body")?;
            let is_move: bool = self.flag(kv, "move")?;
            let params: Vec<ast::Param> = self.params(kv, "params", f - 1)?;
            let ret: ast::Ret = self.field_ret(kv, f - 1)?;
            let pre: Vec<ast::Expr> = self.exprs(kv, "requires", f - 1)?;
            let post: Vec<ast::Expr> = self.exprs(kv, "ensures", f - 1)?;
            let body: ast::Block = self.field_block(kv, "body", f - 1)?;
            Ok(ast::ExprKind::Closure(Box::new(ast::Closure { is_move: is_move, params: params, ret: ret, pre: pre, post: post, body: body, span: sp() })))
        }

        #[summary("A constant from the object v: ty, value and summary")]
        #[effects(alloc)]
        fn const_def(self: &mut Im, name: &str, v: &json::Value, f: usize) -> Result<ast::ConstDef, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a constant (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a constant (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a constant (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a constant (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a constant (an object)")),
                json::Value::Object(o) => self.const_of(name, o.as_slice(), f - 1),
            }
        }

        #[summary("A constant from its members")]
        #[effects(alloc)]
        fn const_of(self: &mut Im, name: &str, kv: &[json::Member], f: usize) -> Result<ast::ConstDef, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a constant", "ty, value, summary")?;
            let mut attrs: Vec<ast::Attr> = Vec::new();
            if at(kv, "summary") < kv.len() {
                let text: String = self.string(kv, "summary")?;
                attrs.push(summary_attr(text));
            }
            let ty: ast::Type = self.field_ty(kv, "ty", f - 1)?;
            let value: ast::Expr = self.field_expr(kv, "value", f - 1)?;
            Ok(ast::ConstDef { attrs: attrs, name: id(name), ty: ty, value: value, span: sp() })
        }

        #[summary("The members of the object keyed by name under the member k, in their order; none when it is absent")]
        #[effects(alloc)]
        fn consts(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::ConstDef>, String>
            decreases f,
        {
            let mut out: Vec<ast::ConstDef> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Array(a0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Object(ms) => { self.keys_ok(ms.as_slice(), k)?; for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { self.down(k); self.down(ms[j].key.as_str()); let one: ast::ConstDef = self.const_def(ms[j].key.as_str(), &ms[j].value, f - 1)?; out.push(one); self.up(); self.up(); } },
                }
            }
            Ok(out)
        }

        #[summary("Enters the member or element seg")]
        #[effects(alloc)]
        fn down(self: &mut Im, seg: &str) -> () {
            self.at.push(String::from(seg));
        }

        #[summary("The names of an effects or uses list. In uses a trait impl's method is taken as the parser keeps it, <a::T as b::Tr>::name")]
        #[effects(alloc)]
        fn effect_names(self: &mut Im, kv: &[json::Member], k: &str, uses: bool) -> Result<Vec<ast::AttrArg>, String> {
            let mut out: Vec<ast::AttrArg> = Vec::new();
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); match json::as_str(&xs[j]) { None => { return Err(self.fail("expected a name")); }, Some(t) => { if !(uses && impl_path(t.as_str())) { self.path_of("", t.as_str())?; } out.push(ast::AttrArg::Ident(id(t.as_str()))); }, } self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("An expression from the object v by its kind")]
        #[effects(alloc)]
        fn expr(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Expr, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected an expression (an object with a `kind`)")),
                json::Value::Bool(b0) => Err(self.fail("expected an expression (an object with a `kind`)")),
                json::Value::Num(n0) => Err(self.fail("expected an expression (an object with a `kind`)")),
                json::Value::Str(s0) => Err(self.fail("expected an expression (an object with a `kind`)")),
                json::Value::Array(a0) => Err(self.fail("expected an expression (an object with a `kind`)")),
                json::Value::Object(o) => { let kind: ast::ExprKind = self.expr_of(o.as_slice(), f - 1)?; Ok(ast::Expr { kind: kind, span: sp() }) },
            }
        }

        #[summary("The kind of an expression from its members")]
        #[effects(alloc)]
        fn expr_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::ExprKind, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let k: String = self.kind(kv, "an expression")?;
            if k == "int" {
                self.check(kv, "an integer", "kind, value, radix")?;
                let mut radix: ast::Radix = ast::Radix::Dec;
                let ri: usize = at(kv, "radix");
                if ri < kv.len() {
                    match json::as_str(&kv[ri].value) {
                        None => { return Err(self.fail_at("radix", "expected dec, hex, oct or bin")); },
                        Some(r) => { if r == "hex" { radix = ast::Radix::Hex; } else if r == "oct" { radix = ast::Radix::Oct; } else if r == "bin" { radix = ast::Radix::Bin; } else if r != "dec" { return Err(self.fail_at("radix", "expected dec, hex, oct or bin")); } },
                    }
                }
                let iv: wide::U128 = self.number(kv, "value")?;
                return Ok(ast::ExprKind::Int(iv, radix));
            }
            if k == "float" {
                self.check(kv, "a float", "kind, value")?;
                let fi: usize = self.req(kv, "value")?;
                return match num_of(&kv[fi].value) { None => Err(self.fail_at("value", "expected a number")), Some(n) => { match float_bits(n.as_str()) { None => Err(self.fail_at("value", "expected a finite non-negative number (negate with `unary`)")), Some(bits) => Ok(ast::ExprKind::Float(bits)), } }, };
            }
            if k == "byte" {
                self.check(kv, "a byte", "kind, value")?;
                let bv: wide::U128 = self.number(kv, "value")?;
                if bv.hi != 0 || bv.lo > 255 {
                    return Err(self.fail("a byte is 0..=255"));
                }
                return Ok(ast::ExprKind::ByteLit(bv.lo as u8));
            }
            if k == "bytes" {
                self.check(kv, "a byte string", "kind, value")?;
                let bs: Vec<u8> = self.bytes(kv, "value")?;
                return Ok(ast::ExprKind::ByteStr(bs));
            }
            if k == "str" {
                self.check(kv, "a string literal", "kind, value")?;
                let st: String = self.string(kv, "value")?;
                return Ok(ast::ExprKind::StrLit(st));
            }
            if k == "char" {
                self.check(kv, "a character literal", "kind, value")?;
                let cv: wide::U128 = self.number(kv, "value")?;
                if cv.hi == 0 && cv.lo <= 1114111 {
                    match char::from_u32(cv.lo as u32) {
                        None => {},
                        Some(c) => { return Ok(ast::ExprKind::CharLit(cv.lo as u32)); },
                    }
                }
                return Err(self.fail_at("value", "a character is a Unicode scalar value"));
            }
            if k == "bool" {
                self.check(kv, "a bool", "kind, value")?;
                let bi: usize = self.req(kv, "value")?;
                return match bool_of(&kv[bi].value) { None => Err(self.fail_at("value", "expected true or false")), Some(b) => Ok(ast::ExprKind::Bool(b)), };
            }
            if k == "unit" {
                self.check(kv, "`()`", "kind")?;
                return Ok(ast::ExprKind::Unit);
            }
            if k == "var" {
                self.check(kv, "a variable", "kind, name")?;
                let vn: ast::Ident = self.name(kv, "name")?;
                return Ok(ast::ExprKind::Var(vn));
            }
            if k == "call" {
                self.check(kv, "a call", "kind, path, targs, args")?;
                let cpath: Vec<ast::Ident> = self.path(kv, "path")?;
                let targs: Vec<ast::TArgs> = self.targs(kv, "targs", cpath.len(), f - 1)?;
                let cargs: Vec<ast::Expr> = self.exprs(kv, "args", f - 1)?;
                return Ok(ast::ExprKind::Call(ast::Call { path: cpath, targs: targs, args: cargs, method: None }));
            }
            if k == "method" {
                self.check(kv, "a method call", "kind, recv, name, args")?;
                let recv: ast::Expr = self.field_expr(kv, "recv", f - 1)?;
                let mname: ast::Ident = self.name(kv, "name")?;
                let margs: Vec<ast::Expr> = self.exprs(kv, "args", f - 1)?;
                return Ok(ast::ExprKind::Method(ast::Method { recv: Box::new(recv), name: mname, args: margs }));
            }
            if k == "index" {
                self.check(kv, "an index", "kind, base, index")?;
                let ibase: ast::Expr = self.field_expr(kv, "base", f - 1)?;
                let iindex: ast::Expr = self.field_expr(kv, "index", f - 1)?;
                return Ok(ast::ExprKind::Index(Box::new(ibase), Box::new(iindex)));
            }
            if k == "unary" {
                self.check(kv, "a unary operation", "kind, op, expr")?;
                let uop: String = self.string(kv, "op")?;
                if uop != "-" && uop != "!" {
                    return Err(self.fail_at("op", types::cat3("unknown operator `", uop.as_str(), "` (-, !)").as_str()));
                }
                let ux: ast::Expr = self.field_expr(kv, "expr", f - 1)?;
                if uop == "-" {
                    return Ok(ast::ExprKind::Unary(ast::UnOp::Neg, Box::new(ux)));
                }
                return Ok(ast::ExprKind::Unary(ast::UnOp::Not, Box::new(ux)));
            }
            if k == "range" {
                self.check(kv, "a range", "kind, lo, hi")?;
                let rlo: ast::Expr = self.field_expr(kv, "lo", f - 1)?;
                let rhi: ast::Expr = self.field_expr(kv, "hi", f - 1)?;
                return Ok(ast::ExprKind::Range(ast::Range { lo: Box::new(rlo), hi: Box::new(rhi), inclusive: false }));
            }
            if k == "binary" {
                self.check(kv, "a binary operation", "kind, op, lhs, rhs")?;
                let bsym: String = self.string(kv, "op")?;
                return match bin_op(bsym.as_str()) { None => Err(self.fail_at("op", types::cat3("unknown operator `", bsym.as_str(), "`").as_str())), Some(bop) => { let bl: ast::Expr = self.field_expr(kv, "lhs", f - 1)?; let br: ast::Expr = self.field_expr(kv, "rhs", f - 1)?; Ok(ast::ExprKind::Binary(bop, Box::new(bl), Box::new(br))) }, };
            }
            if k == "ref" {
                self.check(kv, "a reference", "kind, mutable, expr")?;
                let rmut: bool = self.flag(kv, "mutable")?;
                let rx: ast::Expr = self.field_expr(kv, "expr", f - 1)?;
                return Ok(ast::ExprKind::Ref(rmut, Box::new(rx)));
            }
            if k == "if" {
                self.check(kv, "an `if`", "kind, cond, then, else")?;
                let els: Option<ast::Expr> = self.opt_expr(kv, "else", f - 1)?;
                if !else_ok(&els) {
                    return Err(self.fail_at("else", "`else` is an `if` or a `block`"));
                }
                let cond: ast::Expr = self.field_expr(kv, "cond", f - 1)?;
                let then: ast::Block = self.field_block(kv, "then", f - 1)?;
                return Ok(ast::ExprKind::If(ast::If { cond: Box::new(cond), then: then, els: boxed(els) }));
            }
            if k == "block" {
                self.check(kv, "a block", "kind, stmts, tail")?;
                let blk: ast::Block = self.block_parts(kv, f - 1)?;
                return Ok(ast::ExprKind::Block(blk));
            }
            if k == "array" {
                self.check(kv, "an array", "kind, elems")?;
                let elems: Vec<ast::Expr> = self.exprs(kv, "elems", f - 1)?;
                return Ok(ast::ExprKind::Array(elems));
            }
            if k == "repeat" {
                if at(kv, "count_const") < kv.len() {
                    self.check(kv, "an array repeat", "kind, value, count_const")?;
                    let cn: String = self.string(kv, "count_const")?;
                    let here: source::Span = source::Span { file: 4294967295, lo: self.counts, hi: self.counts };
                    if self.counts < 4294967295 {
                        self.counts = self.counts + 1;
                    }
                    self.lens.push(ast::Len { at: here, path: ids(refs::split_path(cn.as_str()).as_slice()) });
                    let cvalue: ast::Expr = self.field_expr(kv, "value", f - 1)?;
                    return Ok(ast::ExprKind::Repeat(ast::Repeat { value: Box::new(cvalue), count: wide::zero(), count_span: here }));
                }
                self.check(kv, "an array repeat", "kind, value, count")?;
                let rvalue: ast::Expr = self.field_expr(kv, "value", f - 1)?;
                let count: wide::U128 = self.number(kv, "count")?;
                return Ok(ast::ExprKind::Repeat(ast::Repeat { value: Box::new(rvalue), count: count, count_span: sp() }));
            }
            if k == "closure" {
                return self.closure_of(kv, f - 1);
            }
            if k == "old" || k == "trigger" || k == "deref" || k == "try" {
                self.check(kv, "an expression", "kind, expr")?;
                let inner: ast::Expr = self.field_expr(kv, "expr", f - 1)?;
                if k == "old" {
                    return Ok(ast::ExprKind::Old(Box::new(inner)));
                }
                if k == "trigger" {
                    return Ok(ast::ExprKind::Trigger(Box::new(inner)));
                }
                if k == "deref" {
                    return Ok(ast::ExprKind::Deref(Box::new(inner)));
                }
                return Ok(ast::ExprKind::Try(Box::new(inner)));
            }
            if k == "forall" || k == "exists" {
                self.check(kv, types::cat3("an `", k.as_str(), "`").as_str(), "kind, binders, body")?;
                let binders: Vec<ast::Param> = self.params(kv, "binders", f - 1)?;
                let qbody: ast::Expr = self.field_expr(kv, "body", f - 1)?;
                if k == "forall" {
                    return Ok(ast::ExprKind::Quant(ast::Quant { q: ast::Quantifier::Forall, binders: binders, body: Box::new(qbody) }));
                }
                return Ok(ast::ExprKind::Quant(ast::Quant { q: ast::Quantifier::Exists, binders: binders, body: Box::new(qbody) }));
            }
            if k == "struct" {
                self.check(kv, "a struct literal", "kind, path, fields")?;
                let spath: Vec<ast::Ident> = self.path(kv, "path")?;
                let inits: Vec<ast::FieldInit> = self.inits(kv, "fields", f - 1)?;
                return Ok(ast::ExprKind::StructLit(ast::StructLit { path: spath, fields: inits, rest: None }));
            }
            if k == "path" {
                self.check(kv, "a path", "kind, path")?;
                let ppath: Vec<ast::Ident> = self.path(kv, "path")?;
                return Ok(ast::ExprKind::Path(ppath));
            }
            if k == "field" {
                self.check(kv, "a field access", "kind, base, name")?;
                let fbase: ast::Expr = self.field_expr(kv, "base", f - 1)?;
                let fname: ast::Ident = self.name(kv, "name")?;
                return Ok(ast::ExprKind::Field(Box::new(fbase), fname));
            }
            if k == "match" {
                self.check(kv, "a `match`", "kind, scrut, arms")?;
                let arms: Vec<ast::Arm> = self.arms(kv, "arms", f - 1)?;
                let scrut: ast::Expr = self.field_expr(kv, "scrut", f - 1)?;
                return Ok(ast::ExprKind::Match(ast::Match { scrut: Box::new(scrut), arms: arms }));
            }
            if k == "return" {
                self.check(kv, "a `return`", "kind, value")?;
                let rv: Option<ast::Expr> = self.opt_expr(kv, "value", f - 1)?;
                return Ok(ast::ExprKind::Return(boxed(rv)));
            }
            if k == "loop" {
                self.check(kv, "a `loop`", "kind, label, invariants, decreases, body")?;
                let llabel: Option<ast::Ident> = self.label(kv)?;
                let linv: Vec<ast::Expr> = self.exprs(kv, "invariants", f - 1)?;
                let lmeasure: Option<ast::Expr> = self.opt_expr(kv, "decreases", f - 1)?;
                let lbody: ast::Block = self.field_block(kv, "body", f - 1)?;
                return Ok(ast::ExprKind::Loop(ast::Loop { label: llabel, invariants: linv, measure: boxed(lmeasure), body: lbody }));
            }
            if k == "break" {
                self.check(kv, "a `break`", "kind, label, value")?;
                let blabel: Option<ast::Ident> = self.label(kv)?;
                let bvalue: Option<ast::Expr> = self.opt_expr(kv, "value", f - 1)?;
                return Ok(ast::ExprKind::Break(ast::Break { label: blabel, value: boxed(bvalue) }));
            }
            if k == "continue" {
                self.check(kv, "a `continue`", "kind, label")?;
                let clabel: Option<ast::Ident> = self.label(kv)?;
                return Ok(ast::ExprKind::Continue(clabel));
            }
            Err(self.fail(types::cat3("unknown expression kind `", k.as_str(), "` (int, float, byte, bytes, bool, unit, var, call, method, index, unary, binary, ref, if, block, array, repeat, old, forall, exists, trigger, struct, path, deref, field, match, return, try, loop, break, continue)").as_str()))
        }

        #[summary("The elements of the array under the member k, none when it is absent")]
        #[effects(alloc)]
        fn exprs(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::Expr>, String>
            decreases f,
        {
            let mut out: Vec<ast::Expr> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); let one: ast::Expr = self.expr(&xs[j], f - 1)?; out.push(one); self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("The error what at the node being read; the document itself is /")]
        #[effects(alloc)]
        fn fail(self: &Im, what: &str) -> String {
            let p: String = pointer_text(self.at.as_slice());
            if p.len() == 0 {
                return types::cat2("/: ", what);
            }
            types::cat3(p.as_str(), ": ", what)
        }

        #[summary("The error what at the member k of the node being read")]
        #[effects(alloc)]
        fn fail_at(self: &Im, k: &str, what: &str) -> String {
            let mut p: String = pointer_text(self.at.as_slice());
            p.push_str("/");
            p.push_str(escape(k).as_str());
            types::cat3(p.as_str(), ": ", what)
        }

        #[summary("The block of the member k, which must be there")]
        #[effects(alloc)]
        fn field_block(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<ast::Block, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = self.req(kv, k)?;
            self.down(k);
            let b: ast::Block = self.block(&kv[i].value, f - 1)?;
            self.up();
            Ok(b)
        }

        #[summary("The expression of the member k, which must be there")]
        #[effects(alloc)]
        fn field_expr(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<ast::Expr, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = self.req(kv, k)?;
            self.down(k);
            let e: ast::Expr = self.expr(&kv[i].value, f - 1)?;
            self.up();
            Ok(e)
        }

        #[summary("The return type of the member ret, which must be there")]
        #[effects(alloc)]
        fn field_ret(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::Ret, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = self.req(kv, "ret")?;
            self.down("ret");
            let r: ast::Ret = self.ret(&kv[i].value, f - 1)?;
            self.up();
            Ok(r)
        }

        #[summary("The type of the member k, which must be there")]
        #[effects(alloc)]
        fn field_ty(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<ast::Type, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = self.req(kv, k)?;
            self.down(k);
            let t: ast::Type = self.ty(&kv[i].value, f - 1)?;
            self.up();
            Ok(t)
        }

        #[summary("The members of the object keyed by name under the member k, in their order; none when it is absent")]
        #[effects(alloc)]
        fn fields(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::Field>, String>
            decreases f,
        {
            let mut out: Vec<ast::Field> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Array(a0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Object(ms) => { self.keys_ok(ms.as_slice(), k)?; for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { self.down(k); self.down(ms[j].key.as_str()); let one: ast::Field = self.struct_field(ms[j].key.as_str(), &ms[j].value, f - 1)?; out.push(one); self.up(); self.up(); } },
                }
            }
            Ok(out)
        }

        #[summary("The member k as true or false; false when it is absent")]
        #[effects(alloc)]
        fn flag(self: &Im, kv: &[json::Member], k: &str) -> Result<bool, String> {
            let i: usize = at(kv, k);
            if i >= kv.len() {
                return Ok(false);
            }
            match bool_of(&kv[i].value) {
                None => Err(self.fail_at(k, "expected true or false")),
                Some(b) => Ok(b),
            }
        }

        #[summary("A function bound from the object v: trait, params and ret")]
        #[effects(alloc)]
        fn fn_bound(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::FnBound, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a function bound (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a function bound (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a function bound (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a function bound (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a function bound (an object)")),
                json::Value::Object(o) => self.fn_bound_of(o.as_slice(), f - 1),
            }
        }

        #[summary("A function bound from its members")]
        #[effects(alloc)]
        fn fn_bound_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::FnBound, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a function bound", "trait, params, ret")?;
            let t: String = self.string(kv, "trait")?;
            if t != "Fn" && t != "FnMut" && t != "FnOnce" {
                return Err(self.fail("`trait` is `Fn`, `FnMut` or `FnOnce`"));
            }
            let params: Vec<ast::Type> = self.tys(kv, "params", f - 1)?;
            let ret: ast::Type = self.field_ty(kv, "ret", f - 1)?;
            if t == "Fn" {
                return Ok(ast::FnBound { kind: ast::FnTrait::Fn, params: params, ret: ret, span: sp() });
            }
            if t == "FnMut" {
                return Ok(ast::FnBound { kind: ast::FnTrait::FnMut, params: params, ret: ret, span: sp() });
            }
            Ok(ast::FnBound { kind: ast::FnTrait::FnOnce, params: params, ret: ret, span: sp() })
        }

        #[summary("The members of the object keyed by name under the member k, in their order; none when it is absent")]
        #[effects(alloc)]
        fn fns(self: &mut Im, kv: &[json::Member], k: &str, bodiless: bool, f: usize) -> Result<Vec<ast::TraitFn>, String>
            decreases f,
        {
            let mut out: Vec<ast::TraitFn> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Array(a0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Object(ms) => { self.keys_ok(ms.as_slice(), k)?; for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { self.down(k); self.down(ms[j].key.as_str()); let one: ast::TraitFn = self.function(ms[j].key.as_str(), &ms[j].value, bodiless, f - 1)?; out.push(one); self.up(); self.up(); } },
                }
            }
            Ok(out)
        }

        #[summary("A function from the object v; has_body says whether it has one, which only a trait method (bodiless) may be without")]
        #[effects(alloc)]
        fn function(self: &mut Im, name: &str, v: &json::Value, bodiless: bool, f: usize) -> Result<ast::TraitFn, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a function (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a function (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a function (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a function (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a function (an object)")),
                json::Value::Object(o) => self.function_of(name, o.as_slice(), bodiless, f - 1),
            }
        }

        #[summary("A function from its members")]
        #[effects(alloc)]
        fn function_of(self: &mut Im, name: &str, kv: &[json::Member], bodiless: bool, f: usize) -> Result<ast::TraitFn, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a function", "kind, summary, external_body, rationale, effects, uses, generics, params, ret, requires, ensures, decreases, body")?;
            let k: String = self.string(kv, "kind")?;
            if k != "fn" && k != "spec fn" && k != "proof fn" {
                return Err(self.fail_at("kind", types::cat3("unknown function kind `", k.as_str(), "` (fn, spec fn, proof fn)").as_str()));
            }
            let mut attrs: Vec<ast::Attr> = Vec::new();
            if at(kv, "rationale") < kv.len() {
                let rargs: Vec<ast::AttrArg> = self.attr_args(kv, "rationale", f - 1)?;
                attrs.push(ast::Attr { name: id("rationale"), args: rargs, span: sp() });
            }
            if at(kv, "summary") < kv.len() {
                let text: String = self.string(kv, "summary")?;
                attrs.push(summary_attr(text));
            }
            if self.flag(kv, "external_body")? {
                attrs.push(ast::Attr { name: id("external_body"), args: Vec::new(), span: sp() });
            }
            if at(kv, "effects") < kv.len() {
                let eargs: Vec<ast::AttrArg> = self.effect_names(kv, "effects", false)?;
                attrs.push(ast::Attr { name: id("effects"), args: eargs, span: sp() });
            }
            if at(kv, "uses") < kv.len() {
                let uargs: Vec<ast::AttrArg> = self.effect_names(kv, "uses", true)?;
                attrs.push(ast::Attr { name: id("uses"), args: uargs, span: sp() });
            }
            let generics: Vec<ast::TypeParam> = self.generics(kv, "generics", f - 1)?;
            let params: Vec<ast::Param> = self.params(kv, "params", f - 1)?;
            let ret: ast::Ret = self.field_ret(kv, f - 1)?;
            let pre: Vec<ast::Expr> = self.exprs(kv, "requires", f - 1)?;
            let post: Vec<ast::Expr> = self.exprs(kv, "ensures", f - 1)?;
            let measure: Option<ast::Expr> = self.opt_expr(kv, "decreases", f - 1)?;
            let mut body: ast::Block = ast::Block { stmts: Vec::new(), tail: None, span: sp() };
            let mut has_body: bool = false;
            if at(kv, "body") < kv.len() {
                body = self.field_block(kv, "body", f - 1)?;
                has_body = true;
            } else if !bodiless {
                return Err(self.fail("missing field `body`"));
            }
            let mut fk: ast::FnKind = ast::FnKind::Exec;
            if k == "spec fn" {
                fk = ast::FnKind::Spec;
            } else if k == "proof fn" {
                fk = ast::FnKind::Proof;
            }
            Ok(ast::TraitFn { f: ast::FnDef { kind: fk, name: id(name), generics: generics, attrs: attrs, params: params, ret: ret, pre: pre, post: post, measure: measure, body: body, span: sp() }, has_body: has_body })
        }

        #[summary("A type parameter from the object v")]
        #[effects(alloc)]
        fn generic(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::TypeParam, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected a type parameter (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a type parameter (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a type parameter (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a type parameter (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a type parameter (an object)")),
                json::Value::Object(o) => self.generic_of(o.as_slice(), f - 1),
            }
        }

        #[summary("A type parameter from its members name, bounds and fn_bound")]
        #[effects(alloc)]
        fn generic_of(self: &mut Im, kv: &[json::Member], f: usize) -> Result<ast::TypeParam, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "a type parameter", "name, bounds, fn_bound")?;
            let name: ast::Ident = self.name(kv, "name")?;
            let bounds: Vec<Vec<ast::Ident>> = self.bounds(kv, "bounds")?;
            let mut fn_bound: Option<ast::FnBound> = None;
            let bi: usize = at(kv, "fn_bound");
            if bi < kv.len() {
                self.down("fn_bound");
                let fb: ast::FnBound = self.fn_bound(&kv[bi].value, f - 1)?;
                self.up();
                fn_bound = Some(fb);
            }
            Ok(ast::TypeParam { name: name, bounds: bounds, fn_bound: fn_bound, span: sp() })
        }

        #[summary("The elements of the array under the member k, none when it is absent")]
        #[effects(alloc)]
        fn generics(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::TypeParam>, String>
            decreases f,
        {
            let mut out: Vec<ast::TypeParam> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); let one: ast::TypeParam = self.generic(&xs[j], f - 1)?; out.push(one); self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("An impl block of the type ty from the object v: generics, ty_args and fns")]
        #[effects(alloc)]
        fn impl_block(self: &mut Im, ty: &str, v: &json::Value, f: usize) -> Result<ast::Impl, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            match v {
                json::Value::Null => Err(self.fail("expected an impl (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected an impl (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected an impl (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected an impl (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected an impl (an object)")),
                json::Value::Object(o) => self.impl_of(ty, o.as_slice(), f - 1),
            }
        }

        #[summary("An impl block from its members")]
        #[effects(alloc)]
        fn impl_of(self: &mut Im, ty: &str, kv: &[json::Member], f: usize) -> Result<ast::Impl, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            self.check(kv, "an impl", "generics, ty_args, fns")?;
            let generics: Vec<ast::TypeParam> = self.generics(kv, "generics", f - 1)?;
            let ty_args: Vec<ast::Type> = self.tys(kv, "ty_args", f - 1)?;
            let fns: Vec<ast::TraitFn> = self.fns(kv, "fns", false, f - 1)?;
            Ok(ast::Impl { generics: generics, ty: id(ty), ty_args: ty_args, fns: plain_fns(fns), span: sp() })
        }

        #[summary("The members of the object keyed by name under the member k, in their order; none when it is absent")]
        #[effects(alloc)]
        fn impls(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::Impl>, String>
            decreases f,
        {
            let mut out: Vec<ast::Impl> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Array(a0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Object(ms) => { self.keys_ok(ms.as_slice(), k)?; for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { self.down(k); self.down(ms[j].key.as_str()); let one: ast::Impl = self.impl_block(impl_type(ms[j].key.as_str()).as_str(), &ms[j].value, f - 1)?; out.push(one); self.up(); self.up(); } },
                }
            }
            Ok(out)
        }

        #[summary("One field of a struct literal")]
        #[effects(alloc)]
        fn init(self: &mut Im, name: &str, v: &json::Value, f: usize) -> Result<ast::FieldInit, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let value: ast::Expr = self.expr(v, f - 1)?;
            Ok(ast::FieldInit { name: id(name), value: value })
        }

        #[summary("The members of the object keyed by name under the member k, in their order; none when it is absent")]
        #[effects(alloc)]
        fn inits(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Vec<ast::FieldInit>, String>
            decreases f,
        {
            let mut out: Vec<ast::FieldInit> = Vec::new();
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i < kv.len() {
                match &kv[i].value {
                    json::Value::Null => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Bool(b0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Array(a0) => { return Err(self.fail_at(k, "expected an object keyed by name")); },
                    json::Value::Object(ms) => { self.keys_ok(ms.as_slice(), k)?; for j in 0..ms.len() invariant 0 <= j && j <= ms.len(), { self.down(k); self.down(ms[j].key.as_str()); let one: ast::FieldInit = self.init(ms[j].key.as_str(), &ms[j].value, f - 1)?; out.push(one); self.up(); self.up(); } },
                }
            }
            Ok(out)
        }

        #[summary("The keys of the object under the member k as names, none twice. Under impls a key may be T#k for a later block of T")]
        #[effects(alloc)]
        fn keys_ok(self: &Im, ms: &[json::Member], k: &str) -> Result<(), String> {
            for i in 0..ms.len()
                invariant 0 <= i && i <= ms.len(),
            {
                if at(ms, ms[i].key.as_str()) < i {
                    return Err(self.fail_at(k, types::cat3("`", ms[i].key.as_str(), "` given twice").as_str()));
                }
                let mut base: String = ms[i].key.clone();
                if k == "impls" {
                    base = impl_base(ms[i].key.as_str());
                }
                if !is_name(base.as_str()) {
                    return Err(self.fail_at(k, types::cat3("`", ms[i].key.as_str(), "` is not a name").as_str()));
                }
            }
            Ok(())
        }

        #[summary("The text of the member kind of a node, which is what")]
        #[effects(alloc)]
        fn kind(self: &Im, kv: &[json::Member], what: &str) -> Result<String, String> {
            let i: usize = at(kv, "kind");
            if i < kv.len() {
                match json::as_str(&kv[i].value) {
                    None => {},
                    Some(k) => { return Ok(k); },
                }
            }
            Err(self.fail(types::cat3("expected ", what, " (an object with a `kind`)").as_str()))
        }

        #[summary("The label of a loop, break or continue, when the member is there")]
        #[effects(alloc)]
        fn label(self: &Im, kv: &[json::Member]) -> Result<Option<ast::Ident>, String> {
            if at(kv, "label") >= kv.len() {
                return Ok(None);
            }
            let l: ast::Ident = self.name(kv, "label")?;
            Ok(Some(l))
        }

        #[summary("The member k as a name")]
        #[effects(alloc)]
        fn name(self: &Im, kv: &[json::Member], k: &str) -> Result<ast::Ident, String> {
            let n: String = self.string(kv, k)?;
            self.check_name(k, n.as_str())?;
            Ok(id(n.as_str()))
        }

        #[summary("The member k as a number of 128 bits without a sign")]
        #[effects(alloc)]
        fn number(self: &Im, kv: &[json::Member], k: &str) -> Result<wide::U128, String> {
            let i: usize = self.req(kv, k)?;
            match num_of(&kv[i].value) {
                None => Err(self.fail_at(k, "expected a non-negative integer")),
                Some(n) => { if !all_digits(n.as_str()) { return Err(self.fail_at(k, "expected a non-negative integer")); } match dec_u128(n.as_str()) { None => Err(self.fail_at(k, "number out of range")), Some(x) => Ok(x), } },
            }
        }

        #[summary("The expression of the member k, when it is there and not null")]
        #[effects(alloc)]
        fn opt_expr(self: &mut Im, kv: &[json::Member], k: &str, f: usize) -> Result<Option<ast::Expr>, String>
            decreases f,
        {
            if f == 0 {
                return Err(String::new());
            }
            let i: usize = at(kv, k);
            if i >= kv.len() || is_null(&kv[i].value) {
                return Ok(None);
            }
            self.down(k);
            let e: ast::Expr = self.expr(&kv[i].value, f - 1)?;
            self.up();
            Ok(Some(e))
        }

        #[summary("A parameter from the object v")]
        #[effects(alloc)]
        fn param(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Param, String>
            decreases f,
