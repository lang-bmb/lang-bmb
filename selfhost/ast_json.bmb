            match v {
                json::Value::Null => Err(self.fail("expected a parameter (an object)")),
                json::Value::Bool(b0) => Err(self.fail("expected a parameter (an object)")),
                json::Value::Num(n0) => Err(self.fail("expected a parameter (an object)")),
                json::Value::Str(s0) => Err(self.fail("expected a parameter (an object)")),
                json::Value::Array(a0) => Err(self.fail("expected a parameter (an object)")),
                json::Value::Object(o) => self.param_of(o.as_slice(), f - 1),
            }
        }

        #[summary("A parameter from its members name and ty")]
