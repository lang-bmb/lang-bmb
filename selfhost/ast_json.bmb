                    json::Value::Num(n0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Str(s0) => { return Err(self.fail_at(k, "expected an array")); },
                    json::Value::Array(xs) => { self.down(k); for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { self.at.push(index_text(j)); let one: ast::Param = self.param(&xs[j], f - 1)?; out.push(one); self.up(); } self.up(); },
                    json::Value::Object(o0) => { return Err(self.fail_at(k, "expected an array")); },
                }
            }
            Ok(out)
        }

        #[summary("A pattern from the object v")]
        #[effects(alloc)]
        fn pat(self: &mut Im, v: &json::Value, f: usize) -> Result<ast::Pat, String>
            decreases f,
        {
