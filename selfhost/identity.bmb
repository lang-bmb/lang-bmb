#[summary("Identity of definitions: hash references, names are metadata (ADR-0059 §1) (port of stage0 compiler/src/identity.rs). The identity (id) of a definition is the SHA-256 of its nameless normal form (fmt's identity text). Other definitions (functions, spec fns, types, traits) are written by their id (#<hex>), trait methods and enum variants as #<id>#k, binding names as bound slots (_0, _1, ..), fields and variants as declaration positions. The text of a type contains that type's trait impls, and the text of a trait contains all of its impls (types distinguished by name: types of the same structure are still different types). Definitions that refer to each other are a strongly connected component of the reference graph, and within it a member is #self.k. Order of members (Unison's rule): the hash of the text with the component erased (#self), then, until the splitting stops, the hash of the text with the other members written as their previous hashes (color refinement), remaining ties by path. The hash of a component is the hash of the member hashes in that order, the id of a member is <component>.k, and a singleton component is its own hash. Methods of a trait are ordered by the hash of the method's text (with the trait's items erased) and of the impl functions that define it, remaining ties by name. A key is the kind digit (0 definition, 1 type, 2 trait), a colon, the full path: the order of the texts is stage0's Key order. Syntax is held as copies (references cannot be put in a struct)")]
mod identity {
    #[summary("One trait impl block (collected by walking): unit, head, positions and names of the functions")]
    struct Block { unit: String, head: TraitHead, spans: Vec<source::Span>, names: Vec<String> }

    #[summary("Where a definition with a body sits: free function, impl T, trait impl, default body of a trait method (the trait's full path)")]
    enum Ctx { Free, Impl(ImplHead), TraitImpl(TraitHead), Default(String) }

    #[summary("One line of bmb hash")]
    struct DefHash { path: String, id: String, body: String, iface: String }

    #[summary("What was hashed: the hashes and, for a trait, the identity order of the method names")]
    struct Done { hashes: Hashes, methods: Vec<String> }

    #[summary("One item to hash: a definition with a body (function, spec fn, impl function, default body of a trait), a type declaration, a trait")]
    struct Ent { unit: String, kind: EntKind }

    enum EntKind { Def(ast::FnDef, Ctx), Type(ast::TypeDef), Trait(ast::TraitDef) }

    #[summary("One frame of Tarjan: node, its successors, the next successor to visit")]
    struct Frame { v: String, succ: Vec<String>, next: usize }

    #[summary("Hashes of one item. id is sha256:<hex>, or sha256:<hex>.k for the k-th member of a recursive component. body is its own nameless text (members of the component are #self.k), iface is that without the body, caller is iface without #[uses] (what a caller's query reads, ADR-0043). For types and traits all three are the hash of that text, and for a spec fn iface is body (the body is the surface)")]
    struct Hashes { id: String, body: String, iface: String, caller: String }

    #[summary("Identities of a checked program, computed when asked. edges are the edges of the reference graph (the items that an item's text refers to), done is what has been hashed")]
    struct Ids { ents: table::Table<Ent>, impls: Vec<ImplInfo>, impls_of_type: table::Table<Vec<usize>>, impls_of_trait: table::Table<Vec<usize>>, edges: table::Table<Vec<String>>, done: table::Table<Done> }

    impl Ids {
        #[summary("Hashes start and everything it reaches (Tarjan's algorithm: a component is finished after the components it refers to). fuel is the step limit")]
        #[effects(alloc)]
        fn ensure(self: &mut Ids, pr: &mut fmt::Printer, start: &str) -> () {
            if self.done.has(start) {
                return;
            }
            let mut index: table::Table<usize> = table::new::<usize>();
            let mut low: table::Table<usize> = table::new::<usize>();
            let mut on_stack: table::Table<bool> = table::new::<bool>();
            let mut stack: Vec<String> = Vec::new();
            let mut frames: Vec<Frame> = Vec::new();
            index.insert(start, 0);
            low.insert(start, 0);
            stack.push(String::from(start));
            on_stack.insert(start, true);
            let first: Vec<String> = self.succ(pr, start);
            frames.push(Frame { v: String::from(start), succ: first, next: 0 });
            let mut fuel: usize = 1000000000000;
            while frames.len() > 0 && fuel > 0
                decreases fuel,
            {
                fuel = fuel - 1;
                let top: usize = frames.len() - 1;
                if frames[top].next < frames[top].succ.len() {
                    let w: String = frames[top].succ[frames[top].next].clone();
                    frames[top].next = frames[top].next + 1;
                    let v: String = frames[top].v.clone();
                    if !self.done.has(w.as_str()) {
                        if !index.has(w.as_str()) {
                            let n: usize = index.len();
                            index.insert(w.as_str(), n);
                            low.insert(w.as_str(), n);
                            stack.push(w.clone());
                            on_stack.insert(w.as_str(), true);
                            let s: Vec<String> = self.succ(pr, w.as_str());
                            frames.push(Frame { v: w.clone(), succ: s, next: 0 });
                        } else if flag(&on_stack, w.as_str()) {
                            let m: usize = lesser(num(&low, v.as_str()), num(&index, w.as_str()));
                            low.insert(v.as_str(), m);
                        }
                    }
                } else {
                    let v: String = frames[top].v.clone();
                    frames.pop();
                    if frames.len() > 0 {
                        let u: String = frames[frames.len() - 1].v.clone();
                        let m: usize = lesser(num(&low, u.as_str()), num(&low, v.as_str()));
                        low.insert(u.as_str(), m);
                    }
                    if num(&low, v.as_str()) == num(&index, v.as_str()) {
                        let mut comp: Vec<String> = Vec::new();
                        let mut more: bool = true;
                        while more && stack.len() > 0
                            decreases stack.len(),
                        {
                            let w: String = stack[stack.len() - 1].clone();
                            stack.pop();
                            on_stack.insert(w.as_str(), false);
                            more = w != v;
                            comp.push(w);
                        }
                        self.finish(pr, sorted(comp.as_slice()));
                    }
                }
            }
        }

        #[summary("Hashes one component whose outward references are all hashed")]
        #[effects(alloc)]
        fn finish(self: &mut Ids, pr: &mut fmt::Printer, comp: Vec<String>) -> () {
            if comp.len() == 0 {
                return;
            }
            let own: Vec<String> = self.succ(pr, comp[0].as_str());
            let cyclic: bool = comp.len() > 1 || types::has(own.as_slice(), comp[0].as_str());
            let set: Vec<String> = if cyclic {
                comp.clone()
            } else {
                Vec::new()
            };
            let mut methods: table::Table<Vec<String>> = table::new::<Vec<String>>();
            for i in 0..comp.len()
                invariant 0 <= i && i <= comp.len(),
            {
                if is_trait(comp[i].as_str()) {
                    let path: String = path_of(comp[i].as_str());
                    let order: Vec<String> = self.method_order(pr, path.as_str(), set.as_slice());
                    methods.insert(path.as_str(), order);
                }
            }
            let mut members: Vec<String> = comp;
            if cyclic {
                let mut colors: table::Table<String> = table::new::<String>();
                for i in 0..members.len()
                    invariant 0 <= i && i <= members.len(),
                {
                    let t: String = self.text(pr, members[i].as_str(), set.as_slice(), &Member::Erased, &methods, Part::Body);
                    colors.insert(members[i].as_str(), sha(t.as_str()));
                }
                let mut round: usize = 0;
                let mut split: bool = true;
                while split && round < members.len()
                    decreases members.len() - round,
                {
                    let member: Member = Member::Colored(colors.clone());
                    let mut next: table::Table<String> = table::new::<String>();
                    for i in 0..members.len()
                        invariant 0 <= i && i <= members.len(),
                    {
                        let t: String = self.text(pr, members[i].as_str(), set.as_slice(), &member, &methods, Part::Body);
                        next.insert(members[i].as_str(), sha(types::cat3(word(&colors, members[i].as_str()).as_str(), "\n", t.as_str()).as_str()));
                    }
                    split = classes(&next) > classes(&colors);
                    colors = next;
                    round = round + 1;
                }
                let mut keys: Vec<String> = Vec::new();
                for i in 0..members.len()
                    invariant 0 <= i && i <= members.len(),
                {
                    keys.push(types::cat3(word(&colors, members[i].as_str()).as_str(), "\n", members[i].as_str()));
                }
                let ord: Vec<usize> = std::slice::sort_indices::<String>(keys.as_slice());
                let mut by_color: Vec<String> = Vec::new();
                for i in 0..ord.len()
                    invariant 0 <= i && i <= ord.len(),
                {
                    if ord[i] < members.len() {
                        by_color.push(members[ord[i]].clone());
                    }
                }
                members = by_color;
            }
            let mut at: table::Table<usize> = table::new::<usize>();
            for i in 0..members.len()
                invariant 0 <= i && i <= members.len(),
            {
                at.insert(members[i].as_str(), i as usize);
            }
            let place: Member = Member::At(at);
            let mut rows: Vec<Hashes> = Vec::new();
            for i in 0..members.len()
                invariant 0 <= i && i <= members.len(),
            {
                let body: String = sha(self.text(pr, members[i].as_str(), set.as_slice(), &place, &methods, Part::Body).as_str());
                if self.is_exec(members[i].as_str()) {
                    let iface: String = sha(self.text(pr, members[i].as_str(), set.as_slice(), &place, &methods, Part::Iface).as_str());
                    let caller: String = sha(self.text(pr, members[i].as_str(), set.as_slice(), &place, &methods, Part::Caller).as_str());
                    rows.push(Hashes { id: String::new(), body: body, iface: iface, caller: caller });
                } else {
                    rows.push(Hashes { id: String::new(), body: body.clone(), iface: body.clone(), caller: body });
                }
            }
            let total: usize = rows.len();
            let mut comp_hash: String = String::new();
            if total == 1 {
                comp_hash = rows[0].body.clone();
            } else {
                let mut all: String = String::new();
                for i in 0..total
                    invariant 0 <= i && i <= total,
                {
                    let k: usize = i as usize;
                    if k < rows.len() {
                        all.push_str(rows[k].body.as_str());
                        all.push_str("\n");
                    }
                }
                comp_hash = sha(all.as_str());
            }
            for i in 0..total
                invariant 0 <= i && i <= total,
            {
                let k: usize = i as usize;
                if k < rows.len() && k < members.len() {
                    let mut id: String = comp_hash.clone();
                    if total != 1 {
                        id.push_str(".");
                        std::num::push_u64(&mut id, k as u64);
                    }
                    let order: Vec<String> = match methods.find(path_of(members[k].as_str()).as_str()) {
                        None => Vec::new(),
                        Some(m) => { if is_trait(members[k].as_str()) { methods.items[m].clone() } else { Vec::new() } },
                    };
                    self.done.insert(members[k].as_str(), Done { hashes: Hashes { id: id, body: rows[k].body.clone(), iface: rows[k].iface.clone(), caller: rows[k].caller.clone() }, methods: order });
                }
            }
        }

        #[summary("Hashes of key. None if the program has no such item")]
        #[effects(alloc)]
        fn get(self: &mut Ids, pr: &mut fmt::Printer, key: &str) -> Option<Hashes> {
            if !self.ents.has(key) {
                return None;
            }
            self.ensure(pr, key);
            match self.done.find(key) {
                None => None,
                Some(at) => Some(self.done.items[at].hashes.clone()),
            }
        }

        #[summary("One trait impl on one line: impl<..> #trait for <type> { #trait#k = #fn, .. }")]
        #[effects(alloc)]
        fn impl_line(self: &Ids, pr: &mut fmt::Printer, k: usize) -> String {
            if k >= self.impls.len() {
                return String::new();
            }
            fresh(pr, self.impls[k].unit.as_str());
            let g: String = pr.generics(self.impls[k].generics.as_slice());
            let mut fns: Vec<String> = Vec::new();
            for i in 0..self.impls[k].names.len()
                invariant 0 <= i && i <= self.impls[k].names.len(),
            {
                if i < self.impls[k].paths.len() {
                    let m: String = pr.method_ref(self.impls[k].trait_path.as_str(), self.impls[k].names[i].as_str());
                    fns.push(types::cat3(m.as_str(), " = ", pr.entity("0", self.impls[k].paths[i].as_str()).as_str()));
                }
            }
            let mut out: String = String::from("impl");
            out.push_str(g.as_str());
            out.push_str(" ");
            out.push_str(pr.entity("2", self.impls[k].trait_path.as_str()).as_str());
            out.push_str(" for ");
            out.push_str(pr.ty(&self.impls[k].self_ty).as_str());
            out.push_str(" { ");
            out.push_str(types::join(sorted(fns.as_slice()).as_slice(), ", ").as_str());
            out.push_str(" }\n");
            out
        }

        #[summary("Lines of the impls in text order (order in the source carries no meaning)")]
        #[effects(alloc)]
        fn impl_lines(self: &Ids, pr: &mut fmt::Printer, list: &[usize]) -> String {
            let mut lines: Vec<String> = Vec::new();
            for i in 0..list.len()
                invariant 0 <= i && i <= list.len(),
            {
                lines.push(self.impl_line(pr, list[i]));
            }
            types::join(sorted(lines.as_slice()).as_slice(), "")
        }

        #[summary("Whether key is the definition of an executable function (fn): only for those do iface and caller differ from body")]
        #[effects(alloc)]
        fn is_exec(self: &Ids, key: &str) -> bool {
            match self.ents.find(key) {
                None => false,
                Some(at) => match &self.ents.items[at].kind { EntKind::Def(d, c) => match &d.kind { ast::FnKind::Exec => true, ast::FnKind::Spec => false, ast::FnKind::Proof => false, }, EntKind::Type(td) => false, EntKind::Trait(tr) => false, },
            }
        }

        #[summary("The functions that define method name of trait trait_path, as method_read writes them: `impl` and each impl's function in source order, then `default` and the default body when there is one")]
        #[effects(alloc)]
        fn method_defs(self: &Ids, pr: &mut fmt::Printer, trait_path: &str, name: &str) -> String {
            let mut out: String = String::new();
            let list: Vec<usize> = match self.impls_of_trait.find(trait_path) {
                None => Vec::new(),
                Some(l) => self.impls_of_trait.items[l].clone(),
            };
            for a in 0..list.len()
                invariant 0 <= a && a <= list.len(),
            {
                let i: usize = list[a];
                if i < self.impls.len() {
                    for b in 0..self.impls[i].names.len()
                        invariant 0 <= b && b <= self.impls[i].names.len(),
                    {
                        if b < self.impls[i].paths.len() && self.impls[i].names[b] == name {
                            out.push_str("impl ");
                            out.push_str(pr.entity("0", self.impls[i].paths[b].as_str()).as_str());
                            out.push_str("\n");
                        }
                    }
                }
            }
            let default: String = types::cat4("0:", trait_path, "::", name);
            if self.ents.has(default.as_str()) {
                out.push_str("default ");
                out.push_str(pr.entity("0", types::cat3(trait_path, "::", name).as_str()).as_str());
                out.push_str("\n");
            }
            out
        }

        #[summary("Method order of trait path within component comp: per method, the hash of its text with the component erased and of the erased texts of the impl functions that define it. Ties by name")]
        #[effects(alloc)]
        fn method_order(self: &Ids, pr: &mut fmt::Printer, path: &str, comp: &[String]) -> Vec<String> {
            let key: String = types::cat3("2", ":", path);
            let at: usize = match self.ents.find(key.as_str()) {
                None => { return Vec::new(); },
                Some(i) => i,
            };
            let none: table::Table<Vec<String>> = table::new::<Vec<String>>();
            let list: Vec<usize> = match self.impls_of_trait.find(path) {
                None => Vec::new(),
                Some(l) => self.impls_of_trait.items[l].clone(),
            };
            let mut keyed: Vec<String> = Vec::new();
            let mut names: Vec<String> = Vec::new();
            match &self.ents.items[at].kind {
                EntKind::Def(d, c) => {},
                EntKind::Type(td) => {},
                EntKind::Trait(t) => { for i in 0..t.fns.len() invariant 0 <= i && i <= t.fns.len(), { fresh(pr, self.ents.items[at].unit.as_str()); self.resolve(pr, key.as_str(), comp, &Member::Erased, &none); pr.trait_fn(&t.fns[i], 0, "_", 1000000000); let own: String = pr.out.clone(); let mut defs: Vec<String> = Vec::new(); for a in 0..list.len() invariant 0 <= a && a <= list.len(), { let k: usize = list[a]; if k < self.impls.len() { for b in 0..self.impls[k].names.len() invariant 0 <= b && b <= self.impls[k].names.len(), { if b < self.impls[k].paths.len() && self.impls[k].names[b] == t.fns[i].f.name.name { let dk: String = types::cat3("0", ":", self.impls[k].paths[b].as_str()); defs.push(sha(self.text(pr, dk.as_str(), comp, &Member::Erased, &none, Part::Body).as_str())); } } } } let h: String = sha(types::cat3(own.as_str(), "\n", types::join(sorted(defs.as_slice()).as_slice(), "\n").as_str()).as_str()); keyed.push(types::cat3(h.as_str(), "\n", t.fns[i].f.name.name.as_str())); names.push(t.fns[i].f.name.name.clone()); } },
            }
            let ord: Vec<usize> = std::slice::sort_indices::<String>(keyed.as_slice());
            let mut out: Vec<String> = Vec::new();
            for i in 0..ord.len()
                invariant 0 <= i && i <= ord.len(),
            {
                if ord[i] < names.len() {
                    out.push(names[ord[i]].clone());
                }
            }
            out
        }

        #[summary("Method name of trait trait_path as an incremental proof key reads it (stage0 Ids::method_read): its position in the trait's declaration and its trait, its declaration's caller surface, and the functions that define it (each impl's, in source order, then the default body). The declaration is printed before the trait is referred to, as stage0 does. None when there is no such trait or method")]
        #[effects(alloc)]
        fn method_read(self: &Ids, pr: &mut fmt::Printer, trait_path: &str, name: &str) -> Option<String> {
            let tk: String = types::cat2("2:", trait_path);
            let at: usize = self.ents.find(tk.as_str())?;
            match &self.ents.items[at].kind {
                EntKind::Def(d, c) => None,
                EntKind::Type(td) => None,
                EntKind::Trait(t) => { let k: usize = method_at(t, name)?; if k >= t.fns.len() { return None; } fresh(pr, self.ents.items[at].unit.as_str()); let decl: ast::FnDef = fmt::without_uses(&t.fns[k].f); pr.function(&decl, 0, "_", false, 1000000000); let text: String = pr.out.clone(); let mut out: String = String::from("method "); std::num::push_u64(&mut out, k as u64); out.push_str(" of "); out.push_str(pr.entity("2", trait_path).as_str()); out.push_str("\n"); out.push_str(text.as_str()); out.push_str(self.method_defs(pr, trait_path, name).as_str()); Some(out) },
            }
        }

        #[summary("Text of key. Methods of a trait in the order of order (names). pr.names determines the reference texts")]
        #[effects(alloc)]
        fn print(self: &Ids, pr: &mut fmt::Printer, key: &str, part: &Part, order: &[String]) -> String {
            let at: usize = match self.ents.find(key) {
                None => { return String::new(); },
                Some(i) => i,
            };
            fresh(pr, self.ents.items[at].unit.as_str());
            match &self.ents.items[at].kind {
                EntKind::Def(d, c) => { let mut head: String = String::new(); match c { Ctx::Free => {}, Ctx::Impl(h) => { if h.generics.len() > 0 { head.push_str("impl"); head.push_str(pr.generics(h.generics.as_slice()).as_str()); head.push_str(" "); head.push_str(pr.applied_ty(h.name.as_str(), h.args.as_slice()).as_str()); head.push_str("\n"); } }, Ctx::TraitImpl(th) => { head.push_str("impl"); head.push_str(pr.generics(th.generics.as_slice()).as_str()); head.push_str(" "); let full: String = trait_path(&pr.names.traits, self.ents.items[at].unit.as_str(), th.trait_path.as_slice()); head.push_str(pr.method_ref(full.as_str(), d.name.name.as_str()).as_str()); head.push_str(" for "); head.push_str(pr.ty(&th.self_ty).as_str()); head.push_str("\n"); }, Ctx::Default(tr) => { head.push_str("default "); head.push_str(pr.method_ref(tr.as_str(), d.name.name.as_str()).as_str()); head.push_str("\n"); }, } pr.out = head; match part { Part::Body => pr.function(d, 0, "_", true, 1000000000), Part::Iface => pr.function(d, 0, "_", false, 1000000000), Part::Caller => { let g: ast::FnDef = fmt::without_uses(d); pr.function(&g, 0, "_", false, 1000000000); }, } pr.out.clone() },
                EntKind::Type(td) => { pr.type_def_as(td, 0, "_"); let mut out: String = pr.out.clone(); match self.impls_of_type.find(path_of(key).as_str()) { None => {}, Some(l) => out.push_str(self.impl_lines(pr, self.impls_of_type.items[l].as_slice()).as_str()), } out },
                EntKind::Trait(t) => { let mut idx: Vec<usize> = Vec::new(); for i in 0..order.len() invariant 0 <= i && i <= order.len(), { match method_at(t, order[i].as_str()) { None => {}, Some(k) => idx.push(k), } } pr.trait_identity(t, idx.as_slice(), 1000000000); let mut out: String = pr.out.clone(); match self.impls_of_trait.find(path_of(key).as_str()) { None => {}, Some(l) => out.push_str(self.impl_lines(pr, self.impls_of_trait.items[l].as_slice()).as_str()), } out },
            }
        }

        #[summary("The nameless text of key as an incremental proof key reads it (stage0 Ids::read_text), references written as pr's mode writes them: a definition's whole text (read 0), the surface a caller reads (1) or its declaration (2), a type's declaration without its impls, a trait as `trait` (a key reaches what it reads of a trait through its methods, method_read). None when the program has no such item")]
        #[effects(alloc)]
        fn read_text(self: &Ids, pr: &mut fmt::Printer, key: &str, read: u8) -> Option<String> {
            let at: usize = self.ents.find(key)?;
            match &self.ents.items[at].kind {
                EntKind::Def(d, c) => { let none: Vec<String> = Vec::new(); if read == 0 { Some(self.print(pr, key, &Part::Body, none.as_slice())) } else if read == 1 { Some(self.print(pr, key, &Part::Caller, none.as_slice())) } else { Some(self.print(pr, key, &Part::Iface, none.as_slice())) } },
                EntKind::Type(td) => { fresh(pr, self.ents.items[at].unit.as_str()); pr.type_def_as(td, 0, "_"); Some(pr.out.clone()) },
                EntKind::Trait(t) => Some(String::from("trait")),
            }
        }

        #[summary("Places into pr the reference texts of the items that the text of key refers to: members of component comp as member says (#self, #self<color>, #self.k), the rest by id (#<hex>). The method order of a trait is the component's (methods) or the hashed one. Those not placed (not items of the program) are written by the printer as #?path")]
        #[effects(alloc)]
        fn resolve(self: &Ids, pr: &mut fmt::Printer, key: &str, comp: &[String], member: &Member, methods: &table::Table<Vec<String>>) -> () {
            let mut refs: table::Table<fmt::RefRow> = table::new::<fmt::RefRow>();
            match self.edges.find(key) {
                None => {},
                Some(at) => { for i in 0..self.edges.items[at].len() invariant 0 <= i && i <= self.edges.items[at].len(), { let r: String = self.edges.items[at][i].clone(); let mut text: String = String::new(); let mut known: bool = false; let mut order: Vec<String> = Vec::new(); let d: Option<usize> = self.done.find(r.as_str()); if types::has(comp, r.as_str()) { known = true; match member { Member::Erased => text.push_str("#self"), Member::Colored(colors) => { text.push_str("#self<"); text.push_str(hex(word(colors, r.as_str()).as_str()).as_str()); text.push_str(">"); }, Member::At(places) => { text.push_str("#self."); std::num::push_u64(&mut text, num(places, r.as_str()) as u64); }, } } else { match d { None => {}, Some(x) => { known = true; text.push_str("#"); text.push_str(hex(self.done.items[x].hashes.id.as_str()).as_str()); }, } } if is_trait(r.as_str()) { match methods.find(path_of(r.as_str()).as_str()) { None => match d { None => {}, Some(x) => { order = self.done.items[x].methods.clone(); }, }, Some(m) => { order = methods.items[m].clone(); }, } } if known { refs.insert(r.as_str(), fmt::RefRow { text: text.clone(), methods: order.clone() }); } } },
            }
            pr.names.refs = refs;
        }

        #[summary("Items that the text of key refers to (edges of the reference graph), in key order")]
        #[effects(alloc)]
        fn succ(self: &mut Ids, pr: &mut fmt::Printer, key: &str) -> Vec<String> {
            match self.edges.find(key) {
                None => {},
                Some(at) => { return self.edges.items[at].clone(); },
            }
            let order: Vec<String> = match self.ents.find(key) {
                None => Vec::new(),
                Some(at) => match &self.ents.items[at].kind { EntKind::Def(d, c) => Vec::new(), EntKind::Type(td) => Vec::new(), EntKind::Trait(t) => method_names(t), },
            };
            pr.names.mode = fmt::Mode::Collect;
            pr.names.seen = Vec::new();
            let text: String = self.print(pr, key, &Part::Body, order.as_slice());
            pr.names.mode = fmt::Mode::Identity;
            let mut found: Vec<String> = Vec::new();
            for i in 0..pr.names.seen.len()
                invariant 0 <= i && i <= pr.names.seen.len(),
            {
                if self.ents.has(pr.names.seen[i].as_str()) {
                    found.push(pr.names.seen[i].clone());
                }
            }
            let out: Vec<String> = sorted(found.as_slice());
            self.edges.insert(key, out.clone());
            out
        }

        #[summary("Text of key: prints with references resolved by comp, member, methods")]
        #[effects(alloc)]
        fn text(self: &Ids, pr: &mut fmt::Printer, key: &str, comp: &[String], member: &Member, methods: &table::Table<Vec<String>>, part: Part) -> String {
            self.resolve(pr, key, comp, member, methods);
            let order: Vec<String> = match methods.find(path_of(key).as_str()) {
                None => Vec::new(),
                Some(m) => { if is_trait(key) { methods.items[m].clone() } else { Vec::new() } },
            };
            self.print(pr, key, &part, order.as_slice())
        }
    }

    #[summary("Head of impl T: type parameters, the type's name and arguments")]
    struct ImplHead { generics: Vec<ast::TypeParam>, name: String, args: Vec<ast::Type> }

    #[summary("trait impl block: unit, type parameters, type, full path of the trait, functions (method name and path of the definition)")]
    struct ImplInfo { unit: String, generics: Vec<ast::TypeParam>, self_ty: ast::Type, trait_path: String, names: Vec<String>, paths: Vec<String> }

    #[summary("How to write the members of the component being hashed: #self (first ordering), #self<hash> (refinement), #self.k (final text)")]
    enum Member { Erased, Colored(table::Table<String>), At(table::Table<usize>) }

    #[summary("Text to print: with the body, without the body, the surface the caller reads")]
    enum Part { Body, Iface, Caller }

    #[summary("Head of a trait impl: type parameters, the trait path as written, the type")]
    struct TraitHead { generics: Vec<ast::TypeParam>, trait_path: Vec<ast::Ident>, self_ty: ast::Type }

    #[summary("Collected while walking: for each position of a function's name (the position of body::DefRow is that) where it sits (ctx) and its syntax (fns), the trait impl blocks, the full paths of traits")]
    struct Walk { ctx: table::Table<Ctx>, fns: table::Table<ast::FnDef>, blocks: Vec<Block>, traits: Vec<String> }

    #[summary("Number of distinct values")]
    #[effects(alloc)]
    fn classes(c: &table::Table<String>) -> usize {
        let vals: Vec<String> = sorted(c.items.as_slice());
        let mut n: usize = 0;
        for i in 0..vals.len()
            invariant 0 <= i && i <= vals.len() && n <= i,
        {
            if i == 0 || vals[i - 1] != vals[i] {
                n = n + 1;
            }
        }
        n
    }

    #[summary("Walks unit m and its inner units, collecting types and traits into ents, and where functions sit, their syntax and trait impl blocks into w")]
    #[effects(alloc)]
    fn collect(m: &ast::Mod, prefix: &str, ents: &mut table::Table<Ent>, w: &mut Walk, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mp: String = types::cat3(prefix, m.name.name.as_str(), "");
        let inner: String = types::cat3(mp.as_str(), "::", "");
        for s in 0..m.mods.len()
            invariant 0 <= s && s <= m.mods.len(),
        {
            collect(&m.mods[s], inner.as_str(), ents, w, f - 1);
        }
        for i in 0..m.fns.len()
            invariant 0 <= i && i <= m.fns.len(),
        {
            w.fns.insert(body::span_key(m.fns[i].name.span).as_str(), m.fns[i].clone());
        }
        for i in 0..m.impls.len()
            invariant 0 <= i && i <= m.impls.len(),
        {
            for j in 0..m.impls[i].fns.len()
                invariant 0 <= j && j <= m.impls[i].fns.len(),
            {
                let at: String = body::span_key(m.impls[i].fns[j].name.span);
                w.ctx.insert(at.as_str(), Ctx::Impl(ImplHead { generics: m.impls[i].generics.clone(), name: m.impls[i].ty.name.clone(), args: m.impls[i].ty_args.clone() }));
                w.fns.insert(at.as_str(), m.impls[i].fns[j].clone());
            }
        }
        for i in 0..m.trait_impls.len()
            invariant 0 <= i && i <= m.trait_impls.len(),
        {
            let mut spans: Vec<source::Span> = Vec::new();
            let mut names: Vec<String> = Vec::new();
            for j in 0..m.trait_impls[i].fns.len()
                invariant 0 <= j && j <= m.trait_impls[i].fns.len(),
            {
                let at: String = body::span_key(m.trait_impls[i].fns[j].name.span);
                w.ctx.insert(at.as_str(), Ctx::TraitImpl(TraitHead { generics: m.trait_impls[i].generics.clone(), trait_path: m.trait_impls[i].trait_path.clone(), self_ty: m.trait_impls[i].self_ty.clone() }));
                w.fns.insert(at.as_str(), m.trait_impls[i].fns[j].clone());
                spans.push(m.trait_impls[i].fns[j].name.span);
                names.push(m.trait_impls[i].fns[j].name.name.clone());
            }
            w.blocks.push(Block { unit: mp.clone(), head: TraitHead { generics: m.trait_impls[i].generics.clone(), trait_path: m.trait_impls[i].trait_path.clone(), self_ty: m.trait_impls[i].self_ty.clone() }, spans: spans, names: names });
        }
        for i in 0..m.types.len()
            invariant 0 <= i && i <= m.types.len(),
        {
            let key: String = types::cat7("1", ":", mp.as_str(), "::", m.types[i].name.name.as_str(), "", "");
            ents.insert(key.as_str(), Ent { unit: mp.clone(), kind: EntKind::Type(m.types[i].clone()) });
        }
        for i in 0..m.traits.len()
            invariant 0 <= i && i <= m.traits.len(),
        {
            let path: String = types::cat3(mp.as_str(), "::", m.traits[i].name.name.as_str());
            for j in 0..m.traits[i].fns.len()
                invariant 0 <= j && j <= m.traits[i].fns.len(),
            {
                if m.traits[i].fns[j].has_body {
                    let at: String = body::span_key(m.traits[i].fns[j].f.name.span);
                    w.ctx.insert(at.as_str(), Ctx::Default(path.clone()));
                    w.fns.insert(at.as_str(), m.traits[i].fns[j].f.clone());
                }
            }
            w.traits.push(path.clone());
            ents.insert(types::cat3("2", ":", path.as_str()).as_str(), Ent { unit: mp.clone(), kind: EntKind::Trait(m.traits[i].clone()) });
        }
    }

    #[summary("Whether k is recorded as true in t")]
    #[effects(alloc)]
    fn flag(t: &table::Table<bool>, k: &str) -> bool {
        match t.find(k) {
            None => false,
            Some(at) => t.items[at],
        }
    }

    #[summary("Setup for printing a new text: unit unit, empty text, no bound names (stage0 builds a new printer per text)")]
    #[effects(alloc)]
    fn fresh(pr: &mut fmt::Printer, unit: &str) -> () {
        pr.out = String::new();
        pr.names.unit = String::from(unit);
        pr.reset_binders();
    }

    #[summary("Identity hashes of all definitions and type declarations, in path order (ADR-0059 §1: bmb hash). p is the checked program, the tables are that checker's")]
    #[effects(alloc)]
    fn hashes(p: &ast::Program, fns: &table::Table<types::FnSig>, adts: &table::Table<types::Adt>, tys: &table::Table<ast::TypeKind>) -> Vec<DefHash> {
        let mut keys: Vec<String> = Vec::new();
        let defs: Vec<body::DefRow> = body::defs_of(p, fns);
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            keys.push(types::cat3("0", ":", defs[i].path.as_str()));
        }
        for i in 0..p.mods.len()
            invariant 0 <= i && i <= p.mods.len(),
        {
            type_paths(&p.mods[i], "", &mut keys, 100000);
        }
        let mut w: Walk = Walk { ctx: table::new::<Ctx>(), fns: table::new::<ast::FnDef>(), blocks: Vec::new(), traits: Vec::new() };
        let mut ids: Ids = new(p, fns, adts, &mut w);
        let mut pr: fmt::Printer = fmt::identity(fns.clone(), adts.clone(), tys.clone(), w.traits.clone());
        let mut rows: Vec<DefHash> = Vec::new();
        let mut paths: Vec<String> = Vec::new();
        for i in 0..keys.len()
            invariant 0 <= i && i <= keys.len(),
        {
            match ids.get(&mut pr, keys[i].as_str()) {
                None => {},
                Some(h) => { paths.push(path_of(keys[i].as_str())); rows.push(DefHash { path: path_of(keys[i].as_str()), id: h.id, body: h.body, iface: h.iface }); },
            }
        }
        let ord: Vec<usize> = std::slice::sort_indices::<String>(paths.as_slice());
        let mut out: Vec<DefHash> = Vec::new();
        for i in 0..ord.len()
            invariant 0 <= i && i <= ord.len(),
        {
            if ord[i] < rows.len() {
                out.push(rows[ord[i]].clone());
            }
        }
        out
    }

    #[summary("sha256: the hash with the prefix removed, the form references use")]
    #[effects(alloc)]
    fn hex(h: &str) -> String {
        if h.len() >= 7 && lexer::cut(h, 0, 7) == "sha256:" {
            lexer::cut(h, 7, h.len())
        } else {
            String::from(h)
        }
    }

    #[summary("Whether the key is a trait's")]
    #[effects(pure)]
    fn is_trait(key: &str) -> bool {
        key.len() > 0 && key.as_bytes()[0] == 50
    }

    #[effects(pure)]
    fn lesser(a: usize, b: usize) -> usize {
        if a < b {
            a
        } else {
            b
        }
    }

    #[summary("Declaration position of method name of trait t")]
    #[effects(pure)]
    fn method_at(t: &ast::TraitDef, name: &str) -> (r: Option<usize>) {
        let mut i: usize = 0;
        while i < t.fns.len()
            decreases t.fns.len() - i,
        {
            if t.fns[i].f.name.name == name {
                return Some(i);
            }
            i = i + 1;
        }
        None
    }

    #[summary("Method names of the trait, in declaration order")]
    #[effects(alloc)]
    fn method_names(t: &ast::TraitDef) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..t.fns.len()
            invariant 0 <= i && i <= t.fns.len(),
        {
            out.push(t.fns[i].f.name.name.clone());
        }
        out
    }

    #[summary("Collects the things of program p: types and traits, definitions with a body (with where they sit), trait impl blocks. w keeps what was collected while walking (the paths of traits)")]
    #[effects(alloc)]
    fn new(p: &ast::Program, fns: &table::Table<types::FnSig>, adts: &table::Table<types::Adt>, w: &mut Walk) -> Ids {
        let mut ids: Ids = Ids { ents: table::new::<Ent>(), impls: Vec::new(), impls_of_type: table::new::<Vec<usize>>(), impls_of_trait: table::new::<Vec<usize>>(), edges: table::new::<Vec<String>>(), done: table::new::<Done>() };
        for i in 0..p.mods.len()
            invariant 0 <= i && i <= p.mods.len(),
        {
            collect(&p.mods[i], "", &mut ids.ents, w, 100000);
        }
        let mut path_at: table::Table<String> = table::new::<String>();
        let defs: Vec<body::DefRow> = body::defs_of(p, fns);
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            let at: String = body::span_key(defs[i].span);
            path_at.insert(at.as_str(), defs[i].path.clone());
            let c: Ctx = match w.ctx.find(at.as_str()) {
                None => Ctx::Free,
                Some(x) => w.ctx.items[x].clone(),
            };
            match w.fns.find(at.as_str()) {
                None => {},
                Some(x) => ids.ents.insert(types::cat3("0", ":", defs[i].path.as_str()).as_str(), Ent { unit: defs[i].unit.clone(), kind: EntKind::Def(w.fns.items[x].clone(), c) }),
            }
        }
        for i in 0..w.blocks.len()
            invariant 0 <= i && i <= w.blocks.len(),
        {
            let tp: String = trait_path(&w.traits, w.blocks[i].unit.as_str(), w.blocks[i].head.trait_path.as_slice());
            if types::has(w.traits.as_slice(), tp.as_str()) {
                let mut names: Vec<String> = Vec::new();
                let mut paths: Vec<String> = Vec::new();
                for j in 0..w.blocks[i].spans.len()
                    invariant 0 <= j && j <= w.blocks[i].spans.len(),
                {
                    match path_at.find(body::span_key(w.blocks[i].spans[j]).as_str()) {
                        None => {},
                        Some(x) => { if j < w.blocks[i].names.len() { names.push(w.blocks[i].names[j].clone()); paths.push(path_at.items[x].clone()); } },
                    }
                }
                let k: usize = ids.impls.len();
                let full: String = own_type(&w.blocks[i].head.self_ty.kind, w.blocks[i].unit.as_str());
                if full.len() > 0 && adts.has(full.as_str()) {
                    push_at(&mut ids.impls_of_type, full.as_str(), k);
                }
                push_at(&mut ids.impls_of_trait, tp.as_str(), k);
                ids.impls.push(ImplInfo { unit: w.blocks[i].unit.clone(), generics: w.blocks[i].head.generics.clone(), self_ty: w.blocks[i].head.self_ty.clone(), trait_path: tp.clone(), names: names, paths: paths });
            }
        }
        ids
    }

    #[summary("The number recorded for k in t, 0 if absent")]
    #[effects(alloc)]
    fn num(t: &table::Table<usize>, k: &str) -> usize {
        match t.find(k) {
            None => 0,
            Some(at) => t.items[at],
        }
    }

    #[summary("If the type written in unit unit is a named type, its full path, otherwise empty text")]
    #[effects(alloc)]
    fn own_type(t: &ast::TypeKind, unit: &str) -> String {
        match t {
            ast::TypeKind::Int(it) => String::new(),
            ast::TypeKind::F64 => String::new(),
            ast::TypeKind::Bool => String::new(),
            ast::TypeKind::Unit => String::new(),
            ast::TypeKind::Char => String::new(),
            ast::TypeKind::String => String::new(),
            ast::TypeKind::Str => String::new(),
            ast::TypeKind::Array(e, n) => String::new(),
            ast::TypeKind::ArrayN(e, p) => String::new(),
            ast::TypeKind::Slice(e) => String::new(),
            ast::TypeKind::Ref(m, e) => String::new(),
            ast::TypeKind::Named(np, a) => { if np.len() == 1 { types::cat3(unit, "::", np[0].as_str()) } else { types::join(np.as_slice(), "::") } },
            ast::TypeKind::Vec(e) => String::new(),
            ast::TypeKind::Box(e) => String::new(),
            ast::TypeKind::Param(s) => String::new(),
            ast::TypeKind::Never => String::new(),
            ast::TypeKind::Error => String::new(),
        }
    }

    #[summary("Path of the key (after the kind digit and the colon)")]
    #[effects(alloc)]
    fn path_of(key: &str) -> String {
        if key.len() >= 2 {
            lexer::cut(key, 2, key.len())
        } else {
            String::new()
        }
    }

    #[summary("Appends v to the list of k in t")]
    #[effects(alloc)]
    fn push_at(t: &mut table::Table<Vec<usize>>, k: &str, v: usize) -> () {
        let mut list: Vec<usize> = match t.find(k) {
            None => Vec::new(),
            Some(at) => t.items[at].clone(),
        };
        list.push(v);
        t.insert(k, list);
    }

    #[summary("Hash of text s")]
    #[effects(alloc)]
    fn sha(s: &str) -> String {
        sha256::hex(s.as_bytes())
    }

    #[summary("Copy sorted in text order")]
    #[effects(alloc)]
    fn sorted(xs: &[String]) -> Vec<String> {
        let ord: Vec<usize> = std::slice::sort_indices::<String>(xs);
        let mut out: Vec<String> = Vec::new();
        for i in 0..ord.len()
            invariant 0 <= i && i <= ord.len(),
        {
            if ord[i] < xs.len() {
                out.push(xs[ord[i]].clone());
            }
        }
        out
    }

    #[summary("Full path of the trait written in unit unit: if a single segment is a trait of that unit, that, otherwise as written")]
    #[effects(alloc)]
    fn trait_path(traits: &Vec<String>, unit: &str, path: &[ast::Ident]) -> String {
        let plain: String = fmt::path_str(path);
        let local: String = types::cat3(unit, "::", plain.as_str());
        if path.len() == 1 && types::has(traits.as_slice(), local.as_str()) {
            local
        } else {
            plain
        }
    }

    #[summary("Keys of type declarations: inner units first")]
    #[effects(alloc)]
    fn type_paths(m: &ast::Mod, prefix: &str, out: &mut Vec<String>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mp: String = types::cat3(prefix, m.name.name.as_str(), "");
        let inner: String = types::cat3(mp.as_str(), "::", "");
        for s in 0..m.mods.len()
            invariant 0 <= s && s <= m.mods.len(),
        {
            type_paths(&m.mods[s], inner.as_str(), out, f - 1);
        }
        for i in 0..m.types.len()
            invariant 0 <= i && i <= m.types.len(),
        {
            out.push(types::cat7("1", ":", mp.as_str(), "::", m.types[i].name.name.as_str(), "", ""));
        }
    }

    #[summary("The text recorded for k in t, empty text if absent")]
    #[effects(alloc)]
    fn word(t: &table::Table<String>, k: &str) -> String {
        match t.find(k) {
            None => String::new(),
            Some(at) => t.items[at].clone(),
        }
    }
}
