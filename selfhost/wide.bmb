#[summary("128-bit unsigned integer: two u64s (value is hi * 2^64 + lo). The form in which the port holds the value of an integer literal that stage0 holds as Rust's u128")]
mod wide {
    struct DivRem { q: U128, r: u64 }

    #[summary("Quotient and remainder of a division of two 128-bit values")]
    struct QuoRem { q: U128, r: U128 }

    struct U128 { hi: u64, lo: u64 }

    #[summary("a + b. None when the sum does not fit in 128 bits")]
    #[effects(pure)]
    #[uses(summed)]
    fn add(a: U128, b: U128) -> (r: Option<U128>)
        ensures summed(r, a, b),
    {
        let mut lo: u64 = 0;
        let mut c: u64 = 0;
        if a.lo > 18446744073709551615 - b.lo {
            lo = a.lo - (18446744073709551615 - b.lo) - 1;
            c = 1;
        } else {
            lo = a.lo + b.lo;
        }
        if a.hi > 18446744073709551615 - b.hi {
            return None;
        }
        let h: u64 = a.hi + b.hi;
        if h > 18446744073709551615 - c {
            return None;
        }
        Some(U128 { hi: h + c, lo: lo })
    }

    #[summary("Number of bits of a: 0 for 0, 128 for a value with the top bit set (128 minus Rust's leading_zeros)")]
    #[effects(pure)]
    fn bit_len(a: U128) -> (r: u64)
        ensures r <= 128,
    {
        if a.hi != 0 {
            return 64 + bit_len64(a.hi);
        }
        bit_len64(a.lo)
    }

    #[summary("Number of bits of x: 0 for 0")]
    #[effects(pure)]
    fn bit_len64(x: u64) -> (r: u64)
        ensures r <= 64,
    {
        let mut top: u64 = x;
        let mut k: u64 = 0;
        while top != 0 && k < 64
            invariant k <= 64,
            decreases 64 - k,
        {
            top = top / 2;
            k = k + 1;
        }
        k
    }

    #[summary("Quotient and remainder of a by b (schoolbook division, one bit at a time from the top). For b = 0 the quotient is 0 and the remainder a")]
    #[effects(pure)]
    fn div_rem(a: U128, b: U128) -> QuoRem {
        if b.hi == 0 && b.lo == 0 {
            return QuoRem { q: zero(), r: a };
        }
        if a.hi == 0 && b.hi == 0 {
            return QuoRem { q: U128 { hi: 0, lo: a.lo / b.lo }, r: U128 { hi: 0, lo: a.lo % b.lo } };
        }
        let mut q: U128 = zero();
        let mut r: U128 = zero();
        let mut k: u64 = 128;
        while k > 0
            invariant k <= 128,
            decreases k,
        {
            k = k - 1;
            let bit: u64 = if k >= 64 {
                (a.hi >> k - 64) % 2
            } else {
                (a.lo >> k) % 2
            };
            let carry: bool = r.hi >= 9223372036854775808;
            r = U128 { hi: r.hi % 9223372036854775808 * 2 + r.lo / 9223372036854775808, lo: r.lo % 9223372036854775808 * 2 + bit };
            if carry || !less(r, b) {
                let borrow: u64 = if r.lo < b.lo {
                    1
                } else {
                    0
                };
                r = U128 { hi: r.hi.wrapping_sub(b.hi).wrapping_sub(borrow), lo: r.lo.wrapping_sub(b.lo) };
                if k >= 64 {
                    q = U128 { hi: q.hi | 1 << k - 64, lo: q.lo };
                } else {
                    q = U128 { hi: q.hi, lo: q.lo | 1 << k };
                }
            }
        }
        QuoRem { q: q, r: r }
    }

    #[effects(pure)]
    #[uses(divided, divisor)]
    fn div_small(v: U128, d: u64) -> (o: DivRem)
        requires divisor(d),
        ensures divided(o, v, d),
    {
        let a3: u64 = v.hi / 4294967296;
        let a2: u64 = v.hi % 4294967296;
        let a1: u64 = v.lo / 4294967296;
        let a0: u64 = v.lo % 4294967296;
        let q3: u64 = a3 / d;
        let c2: u64 = a3 % d * 4294967296 + a2;
        let q2: u64 = c2 / d;
        let c1: u64 = c2 % d * 4294967296 + a1;
        let q1: u64 = c1 / d;
        let c0: u64 = c1 % d * 4294967296 + a0;
        let q0: u64 = c0 / d;
        DivRem { q: U128 { hi: q3 * 4294967296 + q2, lo: q1 * 4294967296 + q0 }, r: c0 % d }
    }

    spec fn divided(o: DivRem, v: U128, d: u64) -> bool {
        (o.q.hi * 18446744073709551616 + o.q.lo) * d + o.r == v.hi * 18446744073709551616 + v.lo && o.r < d
    }

    spec fn divisor(d: u64) -> bool {
        2 <= d && d <= 16
    }

    #[summary("Whether a = b")]
    #[effects(pure)]
    fn equal(a: U128, b: U128) -> (r: bool)
        ensures r == (a.hi == b.hi && a.lo == b.lo),
    {
        a.hi == b.hi && a.lo == b.lo
    }

    #[summary("Whether a < b")]
    #[effects(pure)]
    fn less(a: U128, b: U128) -> (r: bool)
        ensures r == (a.hi * 18446744073709551616 + a.lo < b.hi * 18446744073709551616 + b.lo),
    {
        a.hi < b.hi || a.hi == b.hi && a.lo < b.lo
    }

    #[summary("a * b. None when the product does not fit in 128 bits")]
    #[effects(pure)]
    #[uses(multiplied, product, summed)]
    fn mul(a: U128, b: U128) -> (r: Option<U128>)
        ensures multiplied(r, a, b),
    {
        if a.hi != 0 && b.hi != 0 {
            return None;
        }
        let x: U128 = if a.hi != 0 {
            a
        } else {
            b
        };
        let y: u64 = if a.hi != 0 {
            b.lo
        } else {
            a.lo
        };
        let top: U128 = mul64(x.hi, y);
        if top.hi != 0 {
            return None;
        }
        add(U128 { hi: top.lo, lo: 0 }, mul64(x.lo, y))
    }

    #[summary("a * b of two 64-bit values, from the four products of their 32-bit halves")]
    #[effects(pure)]
    #[uses(product)]
    fn mul64(a: u64, b: u64) -> (r: U128)
        ensures product(r, a, b),
    {
        let a0: u64 = a % 4294967296;
        let a1: u64 = a / 4294967296;
        let b0: u64 = b % 4294967296;
        let b1: u64 = b / 4294967296;
        assert(a0 <= 4294967295 && a1 <= 4294967295 && b0 <= 4294967295 && b1 <= 4294967295);
        let p00: u64 = a0 * b0;
        let p01: u64 = a0 * b1;
        let p10: u64 = a1 * b0;
        let p11: u64 = a1 * b1;
        let mid: u64 = p01 + p00 / 4294967296;
        let mid2: u64 = p10 + mid % 4294967296;
        U128 { hi: p11 + mid / 4294967296 + mid2 / 4294967296, lo: mid2 % 4294967296 * 4294967296 + p00 % 4294967296 }
    }

    #[effects(pure)]
    #[uses(small, stepped)]
    fn mul_add(v: U128, base: u64, d: u64) -> (r: Option<U128>)
        requires small(base, d),
        ensures stepped(r, v, base, d),
    {
        let l0: u64 = v.lo % 4294967296;
        let l1: u64 = v.lo / 4294967296;
        let p0: u64 = l0 * base + d;
        let p1: u64 = l1 * base + p0 / 4294967296;
        let lo: u64 = p1 % 4294967296 * 4294967296 + p0 % 4294967296;
        let c: u64 = p1 / 4294967296;
        if v.hi > (18446744073709551615 - c) / base {
            return None;
        }
        Some(U128 { hi: v.hi * base + c, lo: lo })
    }

    spec fn multiplied(r: Option<U128>, a: U128, b: U128) -> bool {
        match r {
            None => (a.hi * 18446744073709551616 + a.lo) * (b.hi * 18446744073709551616 + b.lo) >= 18446744073709551616 * 18446744073709551616,
            Some(y) => y.hi * 18446744073709551616 + y.lo == (a.hi * 18446744073709551616 + a.lo) * (b.hi * 18446744073709551616 + b.lo),
        }
    }

    #[summary("2^k. Zero for k of 128 or more")]
    #[effects(pure)]
    fn pow2(k: u64) -> U128 {
        if k < 64 {
            U128 { hi: 0, lo: 1 << k }
        } else if k < 128 {
            U128 { hi: 1 << k - 64, lo: 0 }
        } else {
            zero()
        }
    }

    spec fn product(r: U128, a: u64, b: u64) -> bool {
        r.hi * 18446744073709551616 + r.lo == a * b
    }

    #[effects(alloc)]
    #[uses(divided, divisor)]
    fn push_radix(out: &mut String, v: U128, base: u64) -> ()
        requires divisor(base),
    {
        let mut digits: Vec<u8> = Vec::new();
        let mut x: U128 = v;
        let mut n: usize = 0;
        while n < 128 && (x.hi != 0 || x.lo != 0)
            invariant n <= 128,
            decreases 128 - n,
        {
            let o: DivRem = div_small(x, base);
            let d: u8 = o.r as u8;
            if d < 10 {
                digits.push(48 + d);
            } else {
                digits.push(87 + d);
            }
            x = o.q;
            n = n + 1;
        }
        if digits.len() == 0 {
            out.push('0');
        }
        let mut k: usize = digits.len();
        while k > 0
            invariant k <= digits.len(),
            decreases k,
        {
            k = k - 1;
            match char::from_u32(digits[k] as u32) {
                None => {},
                Some(c) => out.push(c),
            }
        }
    }

    spec fn small(base: u64, d: u64) -> bool {
        2 <= base && base <= 16 && d < base
    }

    spec fn stepped(r: Option<U128>, v: U128, base: u64, d: u64) -> bool {
        match r {
            None => (v.hi * 18446744073709551616 + v.lo) * base + d >= 18446744073709551616 * 18446744073709551616,
            Some(y) => y.hi * 18446744073709551616 + y.lo == (v.hi * 18446744073709551616 + v.lo) * base + d,
        }
    }

    #[summary("a - b. None when a < b")]
    #[effects(pure)]
    #[uses(subtracted)]
    fn sub(a: U128, b: U128) -> (r: Option<U128>)
        ensures subtracted(r, a, b),
    {
        if a.hi < b.hi || a.hi == b.hi && a.lo < b.lo {
            return None;
        }
        if a.lo >= b.lo {
            return Some(U128 { hi: a.hi - b.hi, lo: a.lo - b.lo });
        }
        Some(U128 { hi: a.hi - b.hi - 1, lo: 18446744073709551615 - b.lo + a.lo + 1 })
    }

    spec fn subtracted(r: Option<U128>, a: U128, b: U128) -> bool {
        match r {
            None => a.hi * 18446744073709551616 + a.lo < b.hi * 18446744073709551616 + b.lo,
            Some(y) => y.hi * 18446744073709551616 + y.lo + b.hi * 18446744073709551616 + b.lo == a.hi * 18446744073709551616 + a.lo,
        }
    }

    spec fn summed(r: Option<U128>, a: U128, b: U128) -> bool {
        match r {
            None => a.hi * 18446744073709551616 + a.lo + b.hi * 18446744073709551616 + b.lo >= 18446744073709551616 * 18446744073709551616,
            Some(y) => y.hi * 18446744073709551616 + y.lo == a.hi * 18446744073709551616 + a.lo + b.hi * 18446744073709551616 + b.lo,
        }
    }

    #[summary("Number of zero bits below the lowest set bit of a (Rust's trailing_zeros): 128 for 0")]
    #[effects(pure)]
    fn trailing_zeros(a: U128) -> (r: u64)
        ensures r <= 128,
    {
        let mut x: u64 = a.lo;
        let mut k: u64 = 0;
        if a.lo == 0 {
            if a.hi == 0 {
                return 128;
            }
            x = a.hi;
            k = 64;
        }
        let base: u64 = k;
        while x % 2 == 0 && k < base + 63
            invariant base <= k && k <= base + 63 && base <= 64,
            decreases base + 63 - k,
        {
            x = x / 2;
            k = k + 1;
        }
        k
    }

    #[effects(pure)]
    fn zero() -> U128 {
        U128 { hi: 0, lo: 0 }
    }
}
