#[summary("진단: 안정된 코드의 표, 진단 자료, 결정론적 JSONL 쓰기, 코드 참조 문서 (stage0 compiler/src/diag.rs의 포트, 백로그 4D-02)")]
mod diag {
    struct Bound { b: i64, l: usize }

    struct Code { code: String, text: String }

    struct Diag { code: String, span: source::Span, message: String, fix: Option<Fix>, obligation: Option<String>, bounded: Option<Bound> }

    struct Diags { items: Vec<Diag>, aliases: Vec<Diag> }

    impl Diags {
        #[effects(pure)]
        fn has_errors(self: &Diags) -> bool {
            self.items.len() > 0
        }

        #[effects(alloc)]
        fn push(self: &mut Diags, d: Diag) -> () {
            self.items.push(d);
        }

        #[summary("결정론적 JSONL: 위치와 코드의 순서로, 같은 줄은 한 번만")]
        #[effects(alloc)]
        fn to_jsonl(self: &Diags, sm: &source::SourceMap) -> String {
            let mut rows: Vec<Row> = Vec::new();
            let mut i: usize = 0;
            while i < self.items.len()
                decreases self.items.len() - i,
            {
                rows.push(Row { file: self.items[i].span.file, lo: self.items[i].span.lo, code: self.items[i].code.clone(), text: render(&self.items[i], sm) });
                i = i + 1;
            }
            let mut ord: Vec<usize> = Vec::new();
            let mut x: usize = 0;
            while x < rows.len()
                decreases rows.len() - x,
            {
                ord = placed(rows.as_slice(), ord.as_slice(), x);
                x = x + 1;
            }
            let mut out: String = String::new();
            let mut last: usize = rows.len();
            let mut k: usize = 0;
            while k < ord.len()
                invariant last <= rows.len(),
                decreases ord.len() - k,
            {
                let j: usize = ord[k];
                if j < rows.len() {
                    if last == rows.len() || rows[last].text != rows[j].text {
                        out.push_str(rows[j].text.as_str());
                        out.push_str("\n");
                    }
                    last = j;
                }
                k = k + 1;
            }
            out
        }
    }

    struct Fix { message: String, replacement: Option<String> }

    struct Row { file: u32, lo: u32, code: String, text: String }

    #[effects(pure)]
    fn after(rows: &[Row], x: usize, j: usize) -> bool
        requires x < rows.len(),
    {
        j < rows.len() && row_lt(&rows[x], &rows[j])
    }

    #[summary("컴파일러가 내는 모든 진단 코드, 참조 문서의 순서. 코드는 안정적이다: 번호를 바꾸거나 은퇴한 코드를 다시 쓰지 않는다")]
    #[effects(alloc)]
    fn codes() -> Vec<Code> {
        let mut v: Vec<Code> = Vec::new();
        v.push(Code { code: String::from("E0101"), text: String::from("unexpected character") });
        v.push(Code { code: String::from("E0102"), text: String::from("unterminated string literal") });
        v.push(Code { code: String::from("E0103"), text: String::from("syntax error: unexpected token") });
        v.push(Code { code: String::from("E0104"), text: String::from("integer literal suffix not allowed; the type comes from context") });
        v.push(Code { code: String::from("E0105"), text: String::from("integer literal too large") });
        v.push(Code { code: String::from("E0106"), text: String::from("block comments are not allowed; use `//`") });
        v.push(Code { code: String::from("E0107"), text: String::from("nesting too deep") });
        v.push(Code { code: String::from("E0108"), text: String::from("malformed integer literal: a digit outside its base, or a base prefix without digits") });
