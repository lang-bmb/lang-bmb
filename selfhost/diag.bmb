        v.push(Code { code: String::from("E1004"), text: String::from("`#[external_body]` on a spec fn, a proof fn or `main`") });
        v.push(Code { code: String::from("W1001"), text: String::from("an unconfirmed rationale: what it is bound to changed, or it carries no hash (`bmb fix --confirm`)") });
        v.push(Code { code: String::from("W1002"), text: String::from("an `assume` the proof does not need: the definition is proved without it") });
        v.push(Code { code: String::from("W0901"), text: String::from("preconditions are unsatisfiable together: the function can never be called and its proofs are vacuous") });
        v.push(Code { code: String::from("W0902"), text: String::from("precondition is not needed by this function's proof") });
        v.push(Code { code: String::from("W0903"), text: String::from("postcondition is not used by any caller's proof") });
        v.push(Code { code: String::from("W0904"), text: String::from("the specification does not distinguish this change to the body (the mutant still verifies)") });
        v.push(Code { code: String::from("W0905"), text: String::from("a point of a verified function is unreachable in its proof: what follows is proved vacuously") });
        v.push(Code { code: String::from("W0906"), text: String::from("a quantifier's only trigger matches a term of its own body: instances feed each other (matching loop)") });
        v.push(Code { code: String::from("W0907"), text: String::from("a counting `while` whose canonical form is a range `for` (the fix rewrites it; `bmb fix` applies it)") });
        v.push(Code { code: String::from("W0909"), text: String::from("an executable function declares an effect its body does not need (callers must declare it too)") });
        v.push(Code { code: String::from("W0912"), text: String::from("a clause keyword repeated (`invariant a, invariant b,`): the canonical form lists the clauses after one keyword (an input alias, ADR-0095; `bmb fmt` and `bmb fix` rewrite it)") });
        v.push(Code { code: String::from("W0913"), text: String::from("loop clauses at the start of the body (`while c { invariant a, .. }`): the canonical form puts them before the body (an input alias, ADR-0095; `bmb fmt` and `bmb fix` rewrite it)") });
        v.push(Code { code: String::from("W0914"), text: String::from("a compound assignment `t op= e`: the canonical form is `t = t op e` (an input alias, backlog 2N-07, ADR-0095; `bmb fmt` and `bmb fix` rewrite it)") });
        v.push(Code { code: String::from("W0915"), text: String::from("an integer conversion written `T::try_from(x).unwrap()`: the canonical form is `x as T` (an input alias, ADR-0095 A4; `bmb fmt` and `bmb fix` rewrite it)") });
        v.push(Code { code: String::from("W0916"), text: String::from("a `#[uses(..)]` entry the default proof context reveals already (the spec fns the definition's own clauses, invariants, assertions and proof code and its callees' contracts name, ADR-0095 A1; `bmb fix` removes it)") });
        v.push(Code { code: String::from("W0917"), text: String::from("a widening integer conversion `x as T` in a specification: every value of `x` is one of `T`, so it is `x` (an input alias, ADR-0099; `bmb fix` removes it)") });
        v.push(Code { code: String::from("W0918"), text: String::from("the postconditions allow two different results for one input the preconditions admit (with the two results as a witness): the contract does not fix the result") });
        v.push(Code { code: String::from("W0911"), text: String::from("a call by path of a method whose normal form is the method call `x.f(..)` (the fix rewrites it; `bmb fmt` and `bmb fix` apply it)") });
        v.push(Code { code: String::from("W0910"), text: String::from("a loop of an `io` function prints and carries state whose every update is pure: the update can be a pure function, proved instead of tested") });
        v.push(Code { code: String::from("W0908"), text: String::from("the contract is weaker than in the old version: a stronger `requires`, a weaker `ensures` or `pure` become `io` (`bmb weaken`, with the counterexample)") });
        v
    }

    #[effects(alloc)]
    fn codes_jsonl() -> String {
        let t: Vec<Code> = codes();
        let mut out: String = String::new();
        let mut i: usize = 0;
        while i < t.len()
            decreases t.len() - i,
        {
            out.push_str("{\"code\":");
            json_str(&mut out, t[i].code.as_str());
            out.push_str(",\"severity\":\"");
            push_severity(&mut out, t[i].code.as_str());
            out.push_str("\",\"description\":");
            json_str(&mut out, t[i].text.as_str());
            out.push_str("}\n");
            i = i + 1;
        }
        out
    }

    #[effects(alloc)]
    fn codes_markdown() -> String {
        let t: Vec<Code> = codes();
        let g: Vec<Code> = groups();
        let mut out: String = String::from("# 진단 코드\n\n> 생성 파일: `bmb codes --md`가 `compiler/src/diag.rs`의 `CODES`에서 만든다. 손으로 고치지 않는다.\n> 코드는 바꾸거나 재사용하지 않는다. 진단 형식은 `compiler/README.md`.\n");
        let mut k: usize = 0;
        while k < g.len()
            decreases g.len() - k,
        {
            out.push_str("\n## ");
            out.push_str(g[k].code.as_str());
            out.push_str("xx ");
            out.push_str(g[k].text.as_str());
            out.push_str("\n\n| 코드 | 뜻 |\n| --- | --- |\n");
            push_rows(&mut out, t.as_slice(), g[k].code.as_str());
            k = k + 1;
        }
        out.push_str("\n## 은퇴한 코드(다시 쓰지 않는다)\n\n| 코드 | 뜻 |\n| --- | --- |\n");
        let r: Vec<Code> = retired();
        push_rows(&mut out, r.as_slice(), "");
        out
    }

    #[summary("참조 문서의 절: 코드 접두사와 제목")]
    #[effects(alloc)]
    fn groups() -> Vec<Code> {
        let mut v: Vec<Code> = Vec::new();
        v.push(Code { code: String::from("E01"), text: String::from("어휘·구문") });
        v.push(Code { code: String::from("E02"), text: String::from("Rust 습관(수정 제안 포함)") });
        v.push(Code { code: String::from("E03"), text: String::from("이름") });
        v.push(Code { code: String::from("E04"), text: String::from("타입·소유권") });
        v.push(Code { code: String::from("E05"), text: String::from("명세") });
        v.push(Code { code: String::from("E06"), text: String::from("효과·속성") });
        v.push(Code { code: String::from("E07"), text: String::from("프로그램 구조") });
        v.push(Code { code: String::from("E08"), text: String::from("증명 게이트") });
        v.push(Code { code: String::from("W09"), text: String::from("계약 조정(경고, `bmb lint`·`bmb weaken`만)") });
        v.push(Code { code: String::from("E10"), text: String::from("탈출구와 근거(ADR-0029)") });
        v.push(Code { code: String::from("W10"), text: String::from("탈출구와 근거(경고, `bmb lint`만)") });
        v
    }

    #[summary("s를 JSON 문자열로 덧붙인다. 따옴표로 쓴 글이 메모리에 들어가지 않을 길이면 쓰지 않는다(닿지 않는 갈래: std::json::push_string의 길이 전제를 여기서 확인한다)")]
    #[effects(alloc)]
    #[uses(std::json::quote_room)]
    fn json_str(out: &mut String, s: &str) -> () {
        if s.len() < 1000000000000 && out.len() < 1000000000000000 {
            std::json::push_string(out, s);
        }
    }

    #[effects(alloc)]
    fn new(code: &str, span: source::Span, message: &str) -> Diag {
        Diag { code: String::from(code), span: span, message: String::from(message), fix: None, obligation: None, bounded: None }
    }

    #[summary("ord에 x를 넣는다: x보다 뒤가 아닌 마지막 행의 다음 자리(안정 삽입 정렬의 한 걸음)")]
    #[effects(alloc)]
    fn placed(rows: &[Row], ord: &[usize], x: usize) -> Vec<usize>
        requires x < rows.len(),
    {
        let mut at: usize = ord.len();
        while at > 0 && after(rows, x, ord[at - 1])
            invariant at <= ord.len(),
            decreases at,
        {
            at = at - 1;
        }
        let mut out: Vec<usize> = Vec::new();
        let mut k: usize = 0;
        while k < ord.len()
            invariant at <= ord.len(),
            decreases ord.len() - k,
        {
            if k == at {
                out.push(x);
            }
            out.push(ord[k]);
            k = k + 1;
        }
        if at == ord.len() {
            out.push(x);
        }
        out
    }

    #[summary("s를 Markdown 표의 칸으로 덧붙인다: |를 이스케이프. 자르는 자리는 한 바이트 글자의 앞뒤라 글자 경계이고, 증명이 인코딩을 따라가지 않아 실행 때 확인한다")]
    #[effects(alloc)]
    fn push_cell(out: &mut String, s: &str) -> () {
        let mut a: usize = 0;
        let mut i: usize = 0;
        while i < s.len()
            invariant a <= i, i <= s.len(),
            decreases s.len() - i,
        {
            if s.as_bytes()[i] == b'|' {
                if s.is_char_boundary(a) && s.is_char_boundary(i) {
                    out.push_str(&s[a..i]);
                }
                out.push_str("\\|");
                a = i + 1;
            }
            i = i + 1;
        }
        if s.is_char_boundary(a) {
            out.push_str(&s[a..s.len()]);
        }
    }

    #[summary("x를 10진으로 덧붙인다(std::num::push_i64의 길이 전제를 여기서 확인한다)")]
    #[effects(alloc)]
    #[uses(std::num::room1)]
    fn push_i64(out: &mut String, x: i64) -> () {
        if out.len() < 1000000000000000 {
            std::num::push_i64(out, x);
        }
    }

    #[effects(alloc)]
    fn push_rows(out: &mut String, t: &[Code], prefix: &str) -> () {
        let mut i: usize = 0;
        while i < t.len()
            decreases t.len() - i,
        {
            if std::str::starts_with(t[i].code.as_str(), prefix) {
                out.push_str("| ");
                out.push_str(t[i].code.as_str());
                out.push_str(" | ");
                push_cell(out, t[i].text.as_str());
                out.push_str(" |\n");
            }
            i = i + 1;
        }
    }

    #[effects(alloc)]
    fn push_severity(out: &mut String, code: &str) -> () {
        if code.len() > 0 && code.as_bytes()[0] == b'W' {
            out.push_str("warning");
        } else {
            out.push_str("error");
        }
    }

    #[summary("x를 10진으로 덧붙인다(std::num::push_u64의 길이 전제를 여기서 확인한다)")]
    #[effects(alloc)]
    #[uses(std::num::room)]
    fn push_u64(out: &mut String, x: u64) -> () {
        if out.len() < 1000000000000000 {
            std::num::push_u64(out, x);
        }
    }

    #[summary("진단 하나를 JSON 객체로")]
    #[effects(alloc)]
    fn render(d: &Diag, sm: &source::SourceMap) -> String {
        let a: source::Pos = sm.line_col(d.span.file, d.span.lo);
        let b: source::Pos = sm.line_col(d.span.file, d.span.hi);
        let mut s: String = String::from("{\"code\":");
        json_str(&mut s, d.code.as_str());
        s.push_str(",\"severity\":\"");
        push_severity(&mut s, d.code.as_str());
        s.push_str("\",\"message\":");
        json_str(&mut s, d.message.as_str());
        s.push_str(",\"file\":");
        sm.push_name(&mut s, d.span.file);
        s.push_str(",\"line\":");
        push_u64(&mut s, a.line as u64);
        s.push_str(",\"col\":");
        push_u64(&mut s, a.col as u64);
        s.push_str(",\"end_line\":");
        push_u64(&mut s, b.line as u64);
        s.push_str(",\"end_col\":");
        push_u64(&mut s, b.col as u64);
        match &d.obligation {
            None => {},
            Some(o) => { s.push_str(",\"obligation\":"); json_str(&mut s, o.as_str()); },
        }
        match &d.bounded {
            None => {},
            Some(k) => { s.push_str(",\"bounded\":{\"b\":"); push_i64(&mut s, k.b); s.push_str(",\"l\":"); push_u64(&mut s, k.l as u64); s.push_str("}"); },
        }
        match &d.fix {
            None => {},
            Some(f) => { s.push_str(",\"fix\":{\"message\":"); json_str(&mut s, f.message.as_str()); match &f.replacement { None => {}, Some(r) => { s.push_str(",\"replacement\":"); json_str(&mut s, r.as_str()); }, } s.push_str("}"); },
        }
        s.push_str("}");
        s
    }

    #[summary("더 내지 않는 코드. 다시 쓰이지 않게 적어 둔다")]
    #[effects(alloc)]
    fn retired() -> Vec<Code> {
        let mut v: Vec<Code> = Vec::new();
        v.push(Code { code: String::from("E0814"), text: String::from("construct not supported by the proof gate (retired by backlog 2V-05: every construct is encoded)") });
        v.push(Code { code: String::from("E0203"), text: String::from("`return` is not allowed (retired by backlog 2K-01a: `return` is part of the language, ADR-0049)") });
        v.push(Code { code: String::from("E0204"), text: String::from("`for` is not allowed (retired by backlog 2K-01d: the range `for` is part of the language, ADR-0049)") });
        v.push(Code { code: String::from("E0206"), text: String::from("the `?` operator is not allowed (retired by backlog 2K-01e: `?` is part of the language, ADR-0049)") });
        v.push(Code { code: String::from("E0234"), text: String::from("a string literal: text is bytes, write `b\"...\"` (retired by backlog 2U-01: `\"...\"` is a `&str`, ADR-0050)") });
        v.push(Code { code: String::from("E0227"), text: String::from("method calls are not allowed; call by path (retired by backlog 2M-01: `x.f(..)` calls a method, ADR-0051)") });
        v
    }

    #[summary("행 a가 b보다 앞인가: 파일, 위치, 코드, 쓴 글의 순서(Rust의 튜플 순서)")]
    #[effects(pure)]
    fn row_lt(a: &Row, b: &Row) -> bool {
        if a.file != b.file {
            return a.file < b.file;
        }
        if a.lo != b.lo {
            return a.lo < b.lo;
        }
        if a.code != b.code {
            return a.code < b.code;
        }
        a.text < b.text
    }
}
