        v.push(Code { code: String::from("E0207"), text: String::from("construct not supported in milestone 1") });
        v.push(Code { code: String::from("E0208"), text: String::from("lifetime annotations are not allowed") });
        v.push(Code { code: String::from("E0209"), text: String::from("function return type is required (write `-> ()` for unit)") });
        v.push(Code { code: String::from("E0210"), text: String::from("`mut` parameters are not allowed") });
        v.push(Code { code: String::from("E0211"), text: String::from("comparison operators cannot be chained") });
        v.push(Code { code: String::from("E0212"), text: String::from("`T::from(x)` / `x.into()` / `x.try_into()`: convert with `x as T`") });
