#[summary("The per-definition cache of the proof side (port of the proof part of stage0 compiler/src/incremental.rs, DESIGN.md §8.1): per definition the result of proving it (its obligations, resource units, the digest of its script and its proved obligations as positions of syntax nodes) under a key built from everything its queries read, so that a definition whose key is unchanged is not encoded again. The key names nothing (ADR-0063 §4): the nameless text of the definition and of what its queries read of each item it reaches, numbered in order of first reference, with the solver version, the memory limit and the head of every query. The file `DIR/defs` names the compiler build that wrote it on its second line; a file of another build is not read at all, and the keys do not hold the build, so the entries are the same bytes as stage0's for the same program. The IR side (entries of kind I, stage0's ir_lookup and ir_record) holds per definition and instance the IR it was lowered to, under a key of its texts, the callees' caller texts, the data types it reads and the proved obligations inside it")]
mod incremental {
    #[summary("A data type as the IR keys read it (an entry of stage0 Session.adts): its key line (adt_line) and the types its fields and payloads name (adt_refs)")]
    struct AdtKey { line: String, refs: Vec<String> }

    #[summary("The entry of one slot: its kind, its definition path, its key and its payload")]
    struct Entry { kind: String, path: String, key: String, payload: String }

    #[summary("The fields of one line of the file")]
    struct Entry4 { kind: String, path: String, key: String, sum: String, payload: String }

    #[summary("A stored proof result relocated to a definition's current text (stage0 ProofHit): its obligations, resource units, the digest of its canonical script, and its proved obligations")]
    struct Hit { obligations: usize, total: u64, max: u64, sha: String, proved: Vec<encode_spec::Trivial> }

    #[summary("What a lowered fragment needs besides its text (stage0 IrDeps): the instances it calls and the instance types it uses (their LLVM declarations)")]
    struct IrDeps { wants: Vec<codegen::Want>, used: Vec<ast::TypeKind> }

    #[summary("A stored fragment (stage0 IrHit): its IR, its runtime checks and its dependencies")]
    struct IrHit { ir: String, checks: u32, deps: IrDeps }

    #[summary("The lines read for one slot (kind and definition path) and not checked yet, in file order")]
    struct Lines { kind: String, path: String, raws: Vec<Raw> }

    #[summary("Dependencies read from the start of a payload, and the rest of it (the IR)")]
    struct Parsed { deps: IrDeps, rest: String }

    #[summary("One line of the file not checked yet (stage0 RawLine): its key, its digest, and its payload as written (escaped)")]
    struct Raw { key: String, sum: String, payload: String }

    #[summary("What a key reads of the definitions: the kind of each by path (definitions with a body and trait method declarations), the spec fns its context reveals, its recursive component and the predicates of type invariants")]
    struct Reads { kinds: table::Table<ast::FnKind>, uses: Vec<String>, comp: Vec<String>, invariants: Vec<String> }

    #[summary("One run's view of the cache (stage0 Session): its directory, the identity of this build, the store, whether hits are proved and lowered again and compared (audit), the proof key of each definition it proves, the IR key of each definition when the run lowers the program (with_ir), each data type's key line and the types it names, for the keys of instances, and the counters")]
    struct Session { dir: String, id: String, store: Store, audit: bool, keys: table::Table<String>, ir_keys: table::Table<String>, adts: table::Table<AdtKey>, stats: Stats }

    #[summary("What the cache did in one run (stage0 Stats): the definitions encoded and those whose proof result came from the cache, the definitions and instances lowered to IR and those whose IR came from the cache, in processing order, the damaged lines when the run started, and with an audit the definitions whose stored result or IR differs from the one computed again")]
    struct Stats { encoded: Vec<String>, reused: Vec<String>, lowered: Vec<String>, ir_reused: Vec<String>, damaged: usize, mismatches: Vec<String> }

    #[summary("The cache file (stage0 Store): the entries by slot (slot_of), the lines of a lazy load not checked yet by slot, whether it must be written back, and how many lines were found damaged")]
    struct Store { entries: table::Table<Entry>, pending: table::Table<Lines>, changed: bool, damaged: usize }

    #[summary("The key line and the named types of every data type of the checked program (stage0 Session.adts)")]
    #[effects(alloc)]
    fn adt_keys(ck: &body::Checked) -> table::Table<AdtKey> {
        let mut out: table::Table<AdtKey> = table::new::<AdtKey>();
        for n in 0..ck.b.c.adts.len()
            invariant 0 <= n,
        {
            match ck.b.c.adts.nth(n) {
                None => {},
                Some(at) => out.insert(ck.b.c.adts.key(n).as_str(), AdtKey { line: adt_line(&ck.b.c.adts.items[at]), refs: adt_refs(&ck.b.c.adts.items[at]) }),
            }
        }
        out
    }

    #[summary("A type declaration as a key line (stage0 adt_line): its invariant when it has one, its path, and its fields or variants with their resolved types")]
    #[effects(alloc)]
    fn adt_line(a: &types::Adt) -> String {
        let mut body: Vec<String> = Vec::new();
        match &a.kind {
            types::AdtKind::Struct(fs) => { for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { body.push(types::cat3(fs[i].name.as_str(), ": ", types::text(&fs[i].ty).as_str())); } },
            types::AdtKind::Enum(vs) => { for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { let mut ps: Vec<String> = Vec::new(); for j in 0..vs[i].tys.len() invariant 0 <= j && j <= vs[i].tys.len(), { ps.push(types::text(&vs[i].tys[j])); } body.push(types::cat4(vs[i].name.as_str(), "(", types::join(ps.as_slice(), ", ").as_str(), ")")); } },
        }
        let mut out: String = String::new();
        match &a.inv {
            None => {},
            Some(p) => { out.push_str("#[invariant("); out.push_str(p.as_str()); out.push_str(")] "); },
        }
        out.push_str(a.path.as_str());
        out.push_str(" { ");
        out.push_str(types::join(body.as_slice(), ", ").as_str());
        out.push_str(" }");
        out
    }

    #[summary("The data types a type declaration's fields and payloads name (stage0 adt_refs)")]
    #[effects(alloc)]
    fn adt_refs(a: &types::Adt) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        match &a.kind {
            types::AdtKind::Struct(fs) => { for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { named_in(&fs[i].ty, &mut out, 100000); } },
            types::AdtKind::Enum(vs) => { for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { for j in 0..vs[i].tys.len() invariant 0 <= j && j <= vs[i].tys.len(), { named_in(&vs[i].tys[j], &mut out, 100000); } } },
        }
        out
    }

    #[summary("Whether this run proves every hit again and compares (bmb verify --audit)")]
    #[effects(pure)]
    fn audit(s: &Session) -> bool {
        s.audit
    }

    #[summary("The digest of the caller text of definition r (stage0 hash_of's caller hash), each computed once into memo")]
    #[effects(alloc)]
    fn caller_hash(pr: &mut fmt::Printer, heads: &table::Table<String>, by_path: &table::Table<encode_decls::Def>, memo: &mut table::Table<String>, r: &str) -> String {
        match memo.find(r) {
            None => {},
            Some(at) => { return memo.items[at].clone(); },
        }
        let h: String = match by_path.find(r) {
            None => String::new(),
            Some(bi) => sha256::hex(fmt::caller_text(pr, heads, &by_path.items[bi].d, by_path.items[bi].unit.as_str()).as_bytes()),
        };
        memo.insert(r, h.clone());
        h
    }

    #[summary("Checks one line's digest (stage0 check_line): its key and payload when the payload unescapes and the digest holds")]
    #[effects(alloc)]
    fn check_line(kind: &str, path: &str, raw: &Raw) -> Option<Entry> {
        let payload: String = unescape(raw.payload.as_str())?;
        if line_digest(kind, path, raw.key.as_str(), payload.as_str()) == raw.sum {
            Some(Entry { kind: String::from(kind), path: String::from(path), key: raw.key.clone(), payload: payload })
        } else {
            None
        }
    }

    #[summary("The stats line of `--stats` of `emit-llvm` and `build` (stage0 verify_stats with the checks): stats_line with the runtime checks the IR keeps because their obligations are not proved")]
    #[effects(alloc)]
    fn checks_line(st: &Stats, hits: usize, misses: usize, checks: u32) -> String {
        let line: String = stats_line(st, hits, misses);
        let mut out: String = lexer::cut(line.as_str(), 0, line.len().saturating_sub(2));
        out.push_str(",\"runtime_checks\":");
        std::num::push_u64(&mut out, checks as u64);
        out.push_str("}\n");
        out
    }

    #[summary("Whether code is a diagnostic code of the compiler (stage0 code_static)")]
    #[effects(alloc)]
    fn code_known(code: &str) -> bool {
        let all: Vec<diag::Code> = diag::codes();
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            if all[i].code == code {
                return true;
            }
        }
        false
    }

    #[summary("The identity of this build: `port+` and the SHA-256 of the executable that runs, which changes with any change of the port or of the compiler and toolchain that built it. `port+unknown` when the executable cannot be read, an identity under which nothing is read (unknown_id)")]
    #[effects(alloc, io, nondet)]
    fn compiler_id() -> String {
        match std::fs::read("/proc/self/exe") {
            Ok(bytes) => types::cat2("port+", sha256::hex(bytes.as_slice()).as_str()),
            Err(e) => unknown_id(),
        }
    }

    #[summary("The instances and types of a fragment as payload lines (stage0 deps_text): the count of instances, one line per instance with its key, its definition and its type arguments by name in name order, split by the unit separator, then the count of types and one type per line, each type as written (types::text)")]
    #[effects(alloc)]
    fn deps_text(deps: &IrDeps) -> String {
        let mut out: String = String::new();
        std::num::push_u64(&mut out, deps.wants.len() as u64);
        out.push_str("\n");
        for i in 0..deps.wants.len()
            invariant 0 <= i && i <= deps.wants.len(),
        {
            out.push_str(deps.wants[i].key.as_str());
            out.push_str("\u{1f}");
            out.push_str(deps.wants[i].callee.as_str());
            let ord: Vec<usize> = std::slice::sort_indices::<String>(deps.wants[i].sub.names.as_slice());
            for j in 0..ord.len()
                invariant 0 <= j && j <= ord.len(),
            {
                let k: usize = ord[j];
                if k < deps.wants[i].sub.names.len() && k < deps.wants[i].sub.tys.len() {
                    out.push_str("\u{1f}");
                    out.push_str(deps.wants[i].sub.names[k].as_str());
                    out.push_str("\u{1f}");
                    out.push_str(types::text(&deps.wants[i].sub.tys[k]).as_str());
                }
            }
            out.push_str("\n");
        }
        std::num::push_u64(&mut out, deps.used.len() as u64);
        out.push_str("\n");
        for u in 0..deps.used.len()
            invariant 0 <= u && u <= deps.used.len(),
        {
            out.push_str(types::text(&deps.used[u]).as_str());
            out.push_str("\n");
        }
        out
    }

    #[summary("Audit (stage0 proof_audit): whether a hit differs from the result proved again in the digest of the canonical script, the failures, the obligations, the resource units or the proved obligations as a set")]
    #[effects(alloc)]
    fn differs(h: &Hit, obligations: usize, failed: usize, total: u64, max: u64, proved: &[encode_spec::Trivial], script: &str) -> bool {
        !(h.sha == script_digest(script) && failed == 0 && h.obligations == obligations && h.total == total && h.max == max && same_list(key_set(h.proved.as_slice()).as_slice(), key_set(proved).as_slice()))
    }

    #[summary("The error of a result, if it is one")]
    #[effects(alloc)]
    fn error_of(r: Result<(), String>) -> Option<String> {
        match r {
            Ok(u) => None,
            Err(why) => Some(why),
        }
    }

    #[summary("s with each backslash and line feed escaped (stage0 escape)")]
    #[effects(alloc)]
    fn escape(s: &str) -> String {
        encode_terms::replace(encode_terms::replace(s, "\\", "\\\\").as_str(), "\n", "\\n")
    }

    #[summary("A path field of a line (stage0 escape_path): escaped, and a space (a trait impl function, `<unit::Sq as unit::Shape>::area`) as `\\s` so that the fields stay apart")]
    #[effects(alloc)]
    fn escape_path(s: &str) -> String {
        encode_terms::replace(escape(s).as_str(), " ", "\\s")
    }

    #[summary("Any entry of kind stored under key, whatever its path (stage0 Store::find): the settled entries in slot order first, then the slots of a lazy load, each by its last line whose digest holds. Proof keys name nothing, so a renamed definition finds the entry its old name stored")]
    #[effects(alloc)]
    fn find(st: &Store, kind: &str, key: &str) -> Option<String> {
        for n in 0..st.entries.len()
            invariant 0 <= n,
        {
            match st.entries.nth(n) {
                None => {},
                Some(at) => { if st.entries.items[at].kind == kind && st.entries.items[at].key == key { return Some(st.entries.items[at].payload.clone()); } },
            }
        }
        for m in 0..st.pending.len()
            invariant 0 <= m,
        {
            match st.pending.nth(m) {
                None => {},
                Some(pa) => { if st.pending.items[pa].kind == kind { match last_valid(&st.pending.items[pa]) { None => {}, Some(e) => { if e.key == key { return Some(e.payload); } }, } } },
            }
        }
        None
    }

    #[summary("The proved obligations of a node list, relocated to definition d's current spans (stage0 from_nodes): `-` is none, otherwise `CODE@INDEX` items split by commas; None when an item does not parse, names no code of the compiler or no node of d")]
    #[effects(alloc)]
    fn from_nodes(text: &str, d: &ast::FnDef) -> Option<Vec<encode_spec::Trivial>> {
        let mut out: Vec<encode_spec::Trivial> = Vec::new();
        if text == "-" {
            return Some(out);
        }
        let nodes: Vec<source::Span> = node_spans(d);
        let items: Vec<String> = encode_terms::split(text, 44);
        for i in 0..items.len()
            invariant 0 <= i && i <= items.len(),
        {
            let at: usize = encode_query::find_byte(items[i].as_str(), 64, 0)?;
            let code: String = lexer::cut(items[i].as_str(), 0, at);
            let k: u64 = cache::number(lexer::cut(items[i].as_str(), at + 1, items[i].len()).as_str())?;
            if k >= nodes.len() as u64 || !code_known(code.as_str()) {
                return None;
            }
            out.push(encode_spec::Trivial { code: code, span: nodes[k as usize] });
        }
        Some(out)
    }

    #[summary("The payload stored in slot (kind, path) when its key is key (stage0 Store::get): the settled entry, or for a lazy load the last line whose digest holds")]
    #[effects(alloc)]
    fn get(st: &Store, kind: &str, path: &str, key: &str) -> Option<String> {
        let slot: String = slot_of(kind, path);
        let e: Entry = match st.entries.find(slot.as_str()) {
            None => { let pa: usize = st.pending.find(slot.as_str())?; last_valid(&st.pending.items[pa])? },
            Some(at) => st.entries.items[at].clone(),
        };
        if e.key == key {
            Some(e.payload)
        } else {
            None
        }
    }

    #[summary("Whether name is a name the parser takes for a unit or definition (stage0 parser::is_ident): an ASCII letter or `_`, then ASCII letters, digits and `_`, and no reserved word")]
    #[effects(alloc)]
    fn ident_text(name: &str) -> bool {
        if name.len() == 0 {
            return false;
        }
        let c0: u8 = name.as_bytes()[0];
        if !(c0 >= 65 && c0 <= 90 || c0 >= 97 && c0 <= 122 || c0 == 95) {
            return false;
        }
        for i in 1..name.len()
            invariant 1 <= i && i <= name.len(),
        {
            let c: u8 = name.as_bytes()[i];
            if !(c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95) {
                return false;
            }
        }
        !parser::reserved(name)
    }

    #[summary("The impl functions a trait method w names (stage0 impls_of in Session::keys): for each impl of its trait, the function of the method's name, when it is a definition of the program")]
    #[effects(alloc)]
    fn impls_of(ck: &body::Checked, kinds: &table::Table<ast::FnKind>, w: &str) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        let at: usize = match ck.b.c.fns.find(w) {
            None => { return out; },
            Some(x) => x,
        };
        let tr: String = match &ck.b.c.fns.items[at].trait_of {
            None => { return out; },
            Some(t) => t.clone(),
        };
        let m: String = last_segment(w);
        for i in 0..ck.b.c.trait_impls.len()
            invariant 0 <= i && i <= ck.b.c.trait_impls.len(),
        {
            if ck.b.c.trait_impls[i].trait_path == tr {
                let q: String = types::fn_path(&ck.b.c.trait_impls[i], m.as_str());
                if kinds.has(q.as_str()) {
                    out.push(q.clone());
                }
            }
        }
        out
    }

    #[summary("The IR key of definition path (or of its instance key with type arguments targs) lowered with the proved obligations rel (stage0 ir_key): the definition's key and rel, and for an instance its key and the data types its type arguments name, closed over their fields and payloads, by their key lines in path order")]
    #[effects(alloc)]
    fn ir_key(s: &Session, path: &str, inst: &Option<String>, targs: &[ast::TypeKind], rel: &str) -> Option<String> {
        let at: usize = s.ir_keys.find(path)?;
        let mut text: String = types::cat3(s.ir_keys.items[at].as_str(), "\n", rel);
        match inst {
            None => {},
            Some(key) => { text.push_str("\ninstance "); text.push_str(key.as_str()); let mut todo: Vec<String> = Vec::new(); for i in 0..targs.len() invariant 0 <= i && i <= targs.len(), { named_in(&targs[i], &mut todo, 100000); } let mut tys: table::Table<bool> = table::new::<bool>(); let mut fuel: usize = 1000000000; while todo.len() > 0 && fuel > 0 decreases fuel, { fuel = fuel - 1; let ty: String = match todo.pop() { None => String::new(), Some(x) => x, }; match s.adts.find(ty.as_str()) { None => {}, Some(ai) => { if !tys.has(ty.as_str()) { tys.insert(ty.as_str(), true); for r in 0..s.adts.items[ai].refs.len() invariant 0 <= r && r <= s.adts.items[ai].refs.len(), { todo.push(s.adts.items[ai].refs[r].clone()); } } }, } } for n in 0..tys.len() invariant 0 <= n, { match s.adts.find(tys.key(n).as_str()) { None => {}, Some(aj) => { text.push_str("\ntype "); text.push_str(s.adts.items[aj].line.as_str()); }, } } },
        }
        Some(sha256::hex(text.as_bytes()))
    }

    #[summary("The IR keys of every definition of the checked program (the IR half of stage0 Session::keys): the SHA-256 of `ir`, the sections of the definition's path, unit, qualified text and source text (which places the runtime checks), one section per executable or proof function its qualified text names (and the trait method a trait impl's function refines, and every impl's function of a trait method named) with the digest of that callee's caller text, and one section per data type its text or a text it reaches names (closed over fields and payloads) with its key line. What a text reaches: the definitions it names, and from each the definitions its text names, a spec fn's whole text and any other function's caller text")]
    #[effects(alloc)]
    fn ir_keys(ck: &body::Checked, low: &lowered::Tables, sm: &source::SourceMap) -> table::Table<String> {
        let defs: Vec<codegen::Def> = codegen::sorted_defs(&ck.program, low);
        let mut by_path: table::Table<encode_decls::Def> = table::new::<encode_decls::Def>();
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            by_path.insert(defs[i].path.as_str(), encode_decls::Def { unit: defs[i].unit.clone(), d: defs[i].d.clone() });
        }
        let mut decls: table::Table<encode_decls::Def> = table::new::<encode_decls::Def>();
        for m in 0..ck.program.mods.len()
            invariant 0 <= m && m <= ck.program.mods.len(),
        {
            encode_decls::trait_decls(&ck.program.mods[m], "", &mut decls, 100000);
        }
        for n in 0..decls.len()
            invariant 0 <= n,
        {
            match decls.nth(n) {
                None => {},
                Some(at) => by_path.insert(decls.key(n).as_str(), decls.items[at].clone()),
            }
        }
        let mut kinds: table::Table<ast::FnKind> = table::new::<ast::FnKind>();
        for n2 in 0..by_path.len()
            invariant 0 <= n2,
        {
            match by_path.nth(n2) {
                None => {},
                Some(at2) => kinds.insert(by_path.key(n2).as_str(), by_path.items[at2].d.kind),
            }
        }
        let heads: table::Table<String> = fmt::impl_heads(&ck.b.c.fns);
        let mut pr: fmt::Printer = fmt::qualifying(ck.b.c.fns.clone(), "");
        let mut texts: table::Table<String> = table::new::<String>();
        let mut callers: table::Table<String> = table::new::<String>();
        let mut reads: table::Table<Vec<String>> = table::new::<Vec<String>>();
        let mut out: table::Table<String> = table::new::<String>();
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            let path: String = defs[i].path.clone();
            let unit: String = defs[i].unit.clone();
            let qual: String = fmt::qualified_text(&mut pr, &heads, &defs[i].d, unit.as_str(), true);
            let slice: String = match source_text(sm, defs[i].d.span) {
                None => String::new(),
                Some(t) => t,
            };
            let refines: Vec<String> = match encode_decls::refinement_of(low, path.as_str()) {
                None => Vec::new(),
                Some(rf) => { let mut one: Vec<String> = Vec::new(); one.push(rf.base.clone()); one },
            };
            let mut named: Vec<String> = Vec::new();
            let ws: Vec<String> = words(qual.as_str());
            for w in 0..ws.len()
                invariant 0 <= w && w <= ws.len(),
            {
                if encode_query::has(ws[w].as_str(), "::") && ws[w] != path && kinds.has(ws[w].as_str()) {
                    named.push(ws[w].clone());
                }
            }
            for r0 in 0..refines.len()
                invariant 0 <= r0 && r0 <= refines.len(),
            {
                named.push(refines[r0].clone());
            }
            let mut refs: Vec<String> = Vec::new();
            for k in 0..named.len()
                invariant 0 <= k && k <= named.len(),
            {
                refs.push(named[k].clone());
                let more: Vec<String> = impls_of(ck, &kinds, named[k].as_str());
                ast::append::<String>(&mut refs, more);
            }
            let mut refs2: Vec<String> = Vec::new();
            for k2 in 0..refs.len()
                invariant 0 <= k2 && k2 <= refs.len(),
            {
                if refs[k2] != path {
                    refs2.push(refs[k2].clone());
                }
            }
            let sorted_refs: Vec<String> = body::sorted_set(refs2.as_slice());
            let mut ik: String = String::from("ir\n");
            section(&mut ik, "path", path.as_str());
            section(&mut ik, "unit", unit.as_str());
            section(&mut ik, "qualified", qual.as_str());
            section(&mut ik, "source", slice.as_str());
            for r in 0..sorted_refs.len()
                invariant 0 <= r && r <= sorted_refs.len(),
            {
                match kinds.find(sorted_refs[r].as_str()) {
                    None => {},
                    Some(ka) => { if !body::is_spec(kinds.items[ka]) { let h: String = caller_hash(&mut pr, &heads, &by_path, &mut callers, sorted_refs[r].as_str()); section(&mut ik, "callee", types::cat3(sorted_refs[r].as_str(), " ", h.as_str()).as_str()); } },
                }
            }
            let mut reach: table::Table<bool> = table::new::<bool>();
            let mut todo: Vec<String> = Vec::new();
            let first: Vec<String> = named_defs(ck, &kinds, qual.as_str());
            for a in 0..first.len()
                invariant 0 <= a && a <= first.len(),
            {
                if !reach.has(first[a].as_str()) {
                    reach.insert(first[a].as_str(), true);
                    todo.push(first[a].clone());
                }
            }
            if !reach.has(path.as_str()) {
                reach.insert(path.as_str(), true);
                todo.push(path.clone());
            }
            for r1 in 0..refines.len()
                invariant 0 <= r1 && r1 <= refines.len(),
            {
                if !reach.has(refines[r1].as_str()) {
                    reach.insert(refines[r1].as_str(), true);
                    todo.push(refines[r1].clone());
                }
            }
            let mut fuel: usize = 1000000000;
            while todo.len() > 0 && fuel > 0
                decreases fuel,
            {
                fuel = fuel - 1;
                let x: String = match todo.pop() {
                    None => String::new(),
                    Some(y) => y,
                };
                let next: Vec<String> = reads_of(ck, &mut pr, &heads, &by_path, &kinds, &mut texts, &mut reads, x.as_str());
                for b in 0..next.len()
                    invariant 0 <= b && b <= next.len(),
                {
                    if !reach.has(next[b].as_str()) {
                        reach.insert(next[b].as_str(), true);
                        todo.push(next[b].clone());
                    }
                }
            }
            let mut tys: table::Table<bool> = table::new::<bool>();
            let mut tytodo: Vec<String> = Vec::new();
            type_words(ck, qual.as_str(), unit.as_str(), &mut tys, &mut tytodo);
            for n3 in 0..reach.len()
                invariant 0 <= n3,
            {
                let r3: String = reach.key(n3);
                match by_path.find(r3.as_str()) {
                    None => {},
                    Some(ba) => { let t3: String = text_of(&mut pr, &heads, &by_path, &mut texts, r3.as_str()); let u3: String = by_path.items[ba].unit.clone(); type_words(ck, t3.as_str(), u3.as_str(), &mut tys, &mut tytodo); },
                }
            }
            let mut fuel2: usize = 1000000000;
            while tytodo.len() > 0 && fuel2 > 0
                decreases fuel2,
            {
                fuel2 = fuel2 - 1;
                let ty: String = match tytodo.pop() {
                    None => String::new(),
                    Some(z) => z,
                };
                match ck.b.c.adts.find(ty.as_str()) {
                    None => {},
                    Some(ta) => { let rs: Vec<String> = adt_refs(&ck.b.c.adts.items[ta]); for c in 0..rs.len() invariant 0 <= c && c <= rs.len(), { if ck.b.c.adts.has(rs[c].as_str()) && !tys.has(rs[c].as_str()) { tys.insert(rs[c].as_str(), true); tytodo.push(rs[c].clone()); } } },
                }
            }
            for n4 in 0..tys.len()
                invariant 0 <= n4,
            {
                match ck.b.c.adts.find(tys.key(n4).as_str()) {
                    None => {},
                    Some(tb4) => section(&mut ik, "type", adt_line(&ck.b.c.adts.items[tb4]).as_str()),
                }
            }
            out.insert(path.as_str(), sha256::hex(ik.as_bytes()));
        }
        out
    }

    #[summary("The stored IR of definition path, or of its instance inst with type arguments targs, lowered with the usable proved obligations usable (those inside span) (stage0 ir_lookup): none when one lies outside span, the key differs, or the payload does not read")]
    #[effects(alloc)]
    fn ir_lookup(s: &Session, path: &str, inst: &Option<String>, targs: &[ast::TypeKind], span: source::Span, usable: &[encode_spec::Trivial]) -> Option<IrHit> {
        let rel: String = rel_text(usable, span)?;
        let key: String = ir_key(s, path, inst, targs, rel.as_str())?;
        let slot: String = match inst {
            None => String::from(path),
            Some(k) => k.clone(),
        };
        let payload: String = get(&s.store, "I", slot.as_str(), key.as_str())?;
        let nl: usize = encode_query::find_byte(payload.as_str(), 10, 0)?;
        let checks: u64 = cache::number(lexer::cut(payload.as_str(), 0, nl).as_str())?;
        if checks > 4294967295 {
            return None;
        }
        let parsed: Parsed = parse_deps(lexer::cut(payload.as_str(), nl + 1, payload.len()).as_str())?;
        Some(IrHit { ir: parsed.rest, checks: checks as u32, deps: parsed.deps })
    }

    #[summary("Stores the IR of definition path, or of its instance inst, lowered with usable (stage0 ir_record): the runtime checks, the dependencies and the IR, under the key of ir_lookup; nothing when an obligation of usable lies outside span")]
    #[effects(alloc)]
    fn ir_record(s: &mut Session, path: &str, inst: &Option<String>, targs: &[ast::TypeKind], span: source::Span, usable: &[encode_spec::Trivial], ir: &str, checks: u32, deps: &IrDeps) -> () {
        let rel: String = match rel_text(usable, span) {
            None => { return; },
            Some(r) => r,
        };
        let key: String = match ir_key(s, path, inst, targs, rel.as_str()) {
            None => { return; },
            Some(k) => k,
        };
        let slot: String = match inst {
            None => String::from(path),
            Some(k2) => k2.clone(),
        };
        let mut payload: String = String::new();
        std::num::push_u64(&mut payload, checks as u64);
        payload.push_str("\n");
        payload.push_str(deps_text(deps).as_str());
        payload.push_str(ir);
        put(&mut s.store, "I", slot.as_str(), key.as_str(), payload.as_str());
    }

    #[summary("The proved obligations as a sorted set of texts, to compare two lists as sets (stage0 sorts and dedups (code, file, lo, hi))")]
    #[effects(alloc)]
    fn key_set(xs: &[encode_spec::Trivial]) -> Vec<String> {
        let mut texts: Vec<String> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            let mut t: String = types::cat2(xs[i].code.as_str(), " ");
            t.push_str(body::span_key(xs[i].span).as_str());
            texts.push(t);
        }
        body::sorted_set(texts.as_slice())
    }

    #[summary("The keys of the definitions (stage0 Session::keys, the proof keys): every definition with a body of the checked program, or those of only when it names some. The key of a definition is the SHA-256 of the solver version, the memory limit of the gate, the digest of the head of every query (options at seed 0 under the gate's limit, the bounded search's line when it is on, the prelude) and its nameless reads")]
    #[effects(alloc, io, nondet)]
    fn keys(ck: &body::Checked, pr: &encode_decls::Prepared, only: &Option<Vec<String>>, bounded: bool) -> table::Table<String> {
        let mut out: table::Table<String> = table::new::<String>();
        let rows: Vec<body::DefRow> = body::defs_of(&ck.program, &ck.b.c.fns);
        let mut w: identity::Walk = identity::Walk { ctx: table::new::<identity::Ctx>(), fns: table::new::<ast::FnDef>(), blocks: Vec::new(), traits: Vec::new() };
        let ids: identity::Ids = identity::new(&ck.program, &ck.b.c.fns, &ck.b.c.adts, &mut w);
        let mut printer: fmt::Printer = fmt::identity(ck.b.c.fns.clone(), ck.b.c.adts.clone(), ck.b.types.clone(), w.traits.clone());
        let mut kinds: table::Table<ast::FnKind> = table::new::<ast::FnKind>();
        let mut paths: Vec<String> = Vec::new();
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            match ids.ents.find(types::cat2("0:", rows[i].path.as_str()).as_str()) {
                None => {},
                Some(at) => { match &ids.ents.items[at].kind { identity::EntKind::Def(d, c) => { kinds.insert(rows[i].path.as_str(), d.kind); }, identity::EntKind::Type(td) => {}, identity::EntKind::Trait(t) => {}, } },
            }
            paths.push(rows[i].path.clone());
        }
        let mut decls: table::Table<encode_decls::Def> = table::new::<encode_decls::Def>();
        for m in 0..ck.program.mods.len()
            invariant 0 <= m && m <= ck.program.mods.len(),
        {
            encode_decls::trait_decls(&ck.program.mods[m], "", &mut decls, 100000);
        }
        for n in 0..decls.len()
            invariant 0 <= n,
        {
            match decls.nth(n) {
                None => {},
                Some(at) => kinds.insert(decls.key(n).as_str(), decls.items[at].d.kind),
            }
        }
        let sorted: Vec<String> = body::sorted_set(paths.as_slice());
        let mut invariants: Vec<String> = Vec::new();
        for n in 0..ck.b.c.adts.len()
            invariant 0 <= n,
        {
            match ck.b.c.adts.nth(n) {
                None => {},
                Some(at) => { match &ck.b.c.adts.items[at].inv { None => {}, Some(p) => invariants.push(p.clone()), } },
            }
        }
        let mut head: String = encode_query::header(0, solver::rlimit());
        if bounded {
            head.push_str("\n; bounded search |x| <= 8, lengths <= 4");
        }
        head.push_str("\n");
        head.push_str(encode_terms::prelude().as_str());
        let mut fixed: String = String::from("proof\n");
        section(&mut fixed, "z3", toolchain::z3_version().as_str());
        section(&mut fixed, "memory", encode_terms::dec(solver::query_memory_mb(solver::Asker::Gate)).as_str());
        section(&mut fixed, "header", sha256::hex(head.as_bytes()).as_str());
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            let path: String = rows[i].path.clone();
            let wanted: bool = match only {
                None => true,
                Some(names) => types::has(names.as_slice(), path.as_str()),
            };
            if wanted {
                match ids.ents.find(types::cat2("0:", path.as_str()).as_str()) {
                    None => {},
                    Some(at) => { match &ids.ents.items[at].kind { identity::EntKind::Def(d, c) => { let ctx: Vec<String> = encode_decls::context_of(path.as_str(), d, rows[i].unit.as_str(), pr); let mut uses: Vec<String> = Vec::new(); for u in 0..ctx.len() invariant 0 <= u && u <= ctx.len(), { uses.push(ctx[u].clone()); let more: Vec<String> = impls_of(ck, &kinds, ctx[u].as_str()); for v in 0..more.len() invariant 0 <= v && v <= more.len(), { uses.push(more[v].clone()); } } let mut comp: Vec<String> = Vec::new(); match ck.b.recursive.find(path.as_str()) { None => {}, Some(c0) => { let id: usize = ck.b.recursive.items[c0]; for q in 0..sorted.len() invariant 0 <= q && q <= sorted.len(), { match ck.b.recursive.find(sorted[q].as_str()) { None => {}, Some(cq) => { if ck.b.recursive.items[cq] == id { comp.push(sorted[q].clone()); } }, } } }, } let rd: Reads = Reads { kinds: kinds.clone(), uses: body::sorted_set(uses.as_slice()), comp: comp, invariants: invariants.clone() }; let mut pk: String = fixed.clone(); section(&mut pk, "reads", nameless_reads(&ids, &mut printer, path.as_str(), &rd).as_str()); out.insert(path.as_str(), sha256::hex(pk.as_bytes())); }, identity::EntKind::Type(td) => {}, identity::EntKind::Trait(t) => {}, } },
                }
            }
        }
        out
    }

    #[summary("The text after the last `::` of a path, the whole path without one (Rust's rsplit(\"::\").next())")]
    #[effects(alloc)]
    fn last_segment(path: &str) -> String {
        match encode_decls::last_of(path, "::") {
            None => String::from(path),
            Some(i) => lexer::cut(path, i.saturating_add(2), path.len()),
        }
    }

    #[summary("The last line of a slot whose digest holds (a slot's value in stage0's lazy load)")]
    #[effects(alloc)]
    fn last_valid(ls: &Lines) -> Option<Entry> {
        let mut k: usize = ls.raws.len();
        while k > 0
            invariant k <= ls.raws.len(),
            decreases k,
        {
            k = k - 1;
            match check_line(ls.kind.as_str(), ls.path.as_str(), &ls.raws[k]) {
                None => {},
                Some(e) => { return Some(e); },
            }
        }
        None
    }

    #[summary("The digest of one line's fields (stage0 line_digest)")]
    #[effects(alloc)]
    fn line_digest(kind: &str, path: &str, key: &str, payload: &str) -> String {
        let mut text: String = types::cat4(kind, "\n", path, "\n");
        text.push_str(types::cat4(key, "\n", payload, "").as_str());
        sha256::hex(text.as_bytes())
    }

    #[summary("Loads `dir/defs` (stage0 Store::load_lazy, and with eager every line checked as Store::load does). A file that cannot be read is an empty store; one with another first line or another compiler is an empty store to be written back, and so is every file under the identity of a build that cannot name itself. A line is `KIND PATH KEY DIGEST PAYLOAD` split at its first four spaces with an escaped path; any other line is damaged")]
    #[effects(alloc, io, nondet)]
    fn load(dir: &str, id: &str, eager: bool) -> Store {
        let mut st: Store = Store { entries: table::new::<Entry>(), pending: table::new::<Lines>(), changed: false, damaged: 0 };
        let text: String = match std::fs::read_to_string(cache::within(dir, "defs").as_str()) {
            Ok(read) => read,
            Err(e) => { return st; },
        };
        let ls: Vec<String> = cache::lines_of(text.as_str());
        if ls.len() < 2 || ls[0] != magic() || ls[1] != types::cat2("id ", id) || id == unknown_id().as_str() {
            st.changed = true;
            return st;
        }
        for i in 2..ls.len()
            invariant 2 <= i && i <= ls.len(),
        {
            match split_line(ls[i].as_str()) {
                None => { st.damaged = st.damaged.saturating_add(1); st.changed = true; },
                Some(f4) => { let slot: String = slot_of(f4.kind.as_str(), f4.path.as_str()); let mut held: Lines = match st.pending.find(slot.as_str()) { None => Lines { kind: f4.kind.clone(), path: f4.path.clone(), raws: Vec::new() }, Some(at) => st.pending.items[at].clone(), }; held.raws.push(Raw { key: f4.key.clone(), sum: f4.sum.clone(), payload: f4.payload.clone() }); st.pending.insert(slot.as_str(), held); },
            }
        }
        if eager {
            settle_all(&mut st);
        }
        st
    }

    #[summary("The stored proof result of definition path, relocated to d's current spans (stage0 proof_lookup). An entry stored under the same key for another path (a rename, or a definition equal up to names) is kept under this path too, so that it stays when the other one changes. A payload is the obligations, the resource units in all and at most, the script's digest and the node list, split at single spaces; anything else is no hit")]
    #[effects(alloc)]
    fn lookup(s: &mut Session, path: &str, d: &ast::FnDef) -> Option<Hit> {
        let at: usize = s.keys.find(path)?;
        let key: String = s.keys.items[at].clone();
        let payload: String = match get(&s.store, "P", path, key.as_str()) {
            None => { let p2: String = find(&s.store, "P", key.as_str())?; put(&mut s.store, "P", path, key.as_str(), p2.as_str()); p2 },
            Some(p) => p,
        };
        let words: Vec<String> = encode_terms::split(payload.as_str(), 32);
        if words.len() != 5 {
            return None;
        }
        let obligations: u64 = cache::number(words[0].as_str())?;
        let total: u64 = cache::number(words[1].as_str())?;
        let max: u64 = cache::number(words[2].as_str())?;
        let proved: Vec<encode_spec::Trivial> = from_nodes(words[4].as_str(), d)?;
        Some(Hit { obligations: obligations as usize, total: total, max: max, sha: words[3].clone(), proved: proved })
    }

    #[summary("The first line of the file (stage0 MAGIC)")]
    #[effects(alloc)]
    fn magic() -> String {
        String::from("bmb incremental cache v3")
    }

    #[summary("The definitions a text names (stage0's names of Session::keys): each word of it that holds `::` and is a definition or a trait method declaration, and for a trait method every impl's function of it")]
    #[effects(alloc)]
    fn named_defs(ck: &body::Checked, kinds: &table::Table<ast::FnKind>, text: &str) -> Vec<String> {
        let ws: Vec<String> = words(text);
        let mut out: Vec<String> = Vec::new();
        for i in 0..ws.len()
            invariant 0 <= i && i <= ws.len(),
        {
            if encode_query::has(ws[i].as_str(), "::") && kinds.has(ws[i].as_str()) {
                out.push(ws[i].clone());
                let more: Vec<String> = impls_of(ck, kinds, ws[i].as_str());
                ast::append::<String>(&mut out, more);
            }
        }
        out
    }

    #[summary("The paths of the data types type t names (the walk of stage0 adt_refs and ir_key's named): a named type's path, then those of its arguments, and the types inside arrays, slices, `Vec`s, `Box`es and references. f is the remaining depth")]
    #[effects(alloc)]
    fn named_in(t: &ast::TypeKind, out: &mut Vec<String>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match t {
            ast::TypeKind::Int(it) => {},
            ast::TypeKind::F64 => {},
            ast::TypeKind::Bool => {},
            ast::TypeKind::Unit => {},
            ast::TypeKind::Char => {},
            ast::TypeKind::String => {},
            ast::TypeKind::Str => {},
            ast::TypeKind::Array(ae, an) => named_in(&ae.kind, out, f - 1),
            ast::TypeKind::ArrayN(ne, np) => {},
            ast::TypeKind::Slice(se) => named_in(&se.kind, out, f - 1),
            ast::TypeKind::Ref(rm, re) => named_in(&re.kind, out, f - 1),
            ast::TypeKind::Named(p, args) => { out.push(types::join(p.as_slice(), "::")); for i in 0..args.len() invariant 0 <= i && i <= args.len(), { named_in(&args[i].kind, out, f - 1); } },
            ast::TypeKind::Vec(ve) => named_in(&ve.kind, out, f - 1),
            ast::TypeKind::Box(be) => named_in(&be.kind, out, f - 1),
            ast::TypeKind::Param(ps) => {},
            ast::TypeKind::Never => {},
            ast::TypeKind::Error => {},
        }
    }

    #[summary("What the queries of definition path read, without names (stage0 nameless_reads, ADR-0063 §4): `@0` is the definition's whole nameless text, and each item it reaches gets the next number at its first reference and, once, the text its queries read of it: an executable or proof function its caller surface; a spec fn revealed by #[uses], in the recursive component or as a type's invariant its whole text, any other spec fn its declaration; a data type its declaration; a trait method its declaration and the functions that define it. Members of the component nothing reaches come last, the least by their text with references erased (then path) first. Then the component's members by number")]
    #[effects(alloc)]
    fn nameless_reads(ids: &identity::Ids, pr: &mut fmt::Printer, path: &str, rd: &Reads) -> String {
        pr.names.mode = fmt::Mode::Number;
        pr.names.refs = table::new::<fmt::RefRow>();
        pr.names.seen = Vec::new();
        let first: String = pr.number(types::cat2("0:", path).as_str());
        let mut out: String = String::new();
        let mut i: usize = 0;
        let mut fuel: usize = rd.comp.len().saturating_add(1);
        while fuel > 0
            decreases fuel,
        {
            fuel = fuel - 1;
            let mut more: usize = 1000000000;
            while i < pr.names.seen.len() && more > 0
                decreases more,
            {
                more = more - 1;
                let r: String = pr.names.seen[i].clone();
                let text: String = read_of(ids, pr, r.as_str(), path, rd);
                out.push_str("@");
                std::num::push_u64(&mut out, i as u64);
                out.push_str("\n");
                out.push_str(text.as_str());
                i = i + 1;
            }
            let mut best: Option<usize> = None;
            let mut best_text: String = String::new();
            for q in 0..rd.comp.len()
                invariant 0 <= q && q <= rd.comp.len(),
            {
                let key: String = types::cat2("0:", rd.comp[q].as_str());
                if !pr.names.refs.has(key.as_str()) {
                    pr.names.mode = fmt::Mode::Erase;
                    let t: String = read_of(ids, pr, key.as_str(), path, rd);
                    pr.names.mode = fmt::Mode::Number;
                    let less: bool = match best {
                        None => true,
                        Some(b) => t < best_text || t == best_text && b < rd.comp.len() && rd.comp[q] < rd.comp[b],
                    };
                    if less {
                        best = Some(q);
                        best_text = t.clone();
                    }
                }
            }
            match best {
                None => { fuel = 0; },
                Some(b2) => { if b2 < rd.comp.len() { let n: String = pr.number(types::cat2("0:", rd.comp[b2].as_str()).as_str()); } },
            }
        }
        let mut members: Vec<u64> = Vec::new();
        for m in 0..rd.comp.len()
            invariant 0 <= m && m <= rd.comp.len(),
        {
            let t: String = pr.number(types::cat2("0:", rd.comp[m].as_str()).as_str());
            match cache::number(lexer::cut(t.as_str(), 1, t.len()).as_str()) {
                None => {},
                Some(k) => members.push(k),
            }
        }
        let ord: Vec<usize> = std::slice::sort_indices::<u64>(members.as_slice());
        out.push_str("component");
        for j in 0..ord.len()
            invariant 0 <= j && j <= ord.len(),
        {
            if ord[j] < members.len() {
                if j > 0 {
                    out.push_str(" @");
                } else {
                    out.push_str(" @");
                }
                std::num::push_u64(&mut out, members[ord[j]]);
            }
        }
        if ord.len() == 0 {
            out.push_str(" ");
        }
        out.push_str("\n");
        pr.names.mode = fmt::Mode::Identity;
        out
    }

    #[summary("Paths as a JSON array, sorted by their JSON text as stage0 sorts them")]
    #[effects(alloc)]
    fn names(out: &mut String, xs: &[String]) -> () {
        let mut texts: Vec<String> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            let mut t: String = String::new();
            std::json::push_string(&mut t, xs[i].as_str());
            texts.push(t);
        }
        let ord: Vec<usize> = std::slice::sort_indices::<String>(texts.as_slice());
        out.push_str("[");
        for j in 0..ord.len()
            invariant 0 <= j && j <= ord.len(),
        {
            if ord[j] < texts.len() {
                if j > 0 {
                    out.push_str(",");
                }
                out.push_str(texts[ord[j]].as_str());
            }
        }
        out.push_str("]");
    }

    #[summary("A session over the cache in dir (stage0 Session::new, and with only Session::new_for: a lazy load, and the keys of the named definitions alone). id is this build's identity; bounded is whether the search within small bounds is on, which every query's head says")]
    #[effects(alloc, io, nondet)]
    fn new(dir: &str, id: &str, ck: &body::Checked, pr: &encode_decls::Prepared, only: &Option<Vec<String>>, bounded: bool, audit: bool) -> Session {
        let eager: bool = match only {
            None => true,
            Some(names) => false,
        };
        let st: Store = load(dir, id, eager);
        let damaged: usize = st.damaged;
        let keys: table::Table<String> = keys(ck, pr, only, bounded);
        Session { dir: String::from(dir), id: String::from(id), store: st, audit: audit, keys: keys, ir_keys: table::new::<String>(), adts: table::new::<AdtKey>(), stats: Stats { encoded: Vec::new(), reused: Vec::new(), lowered: Vec::new(), ir_reused: Vec::new(), damaged: damaged, mismatches: Vec::new() } }
    }

    #[summary("What a run that does not go through the cache did with it: nothing (stage0 Stats::default)")]
    #[effects(alloc)]
    fn no_stats() -> Stats {
        Stats { encoded: Vec::new(), reused: Vec::new(), lowered: Vec::new(), ir_reused: Vec::new(), damaged: 0, mismatches: Vec::new() }
    }

    #[summary("The spans of a definition's syntax nodes in a fixed order (stage0 node_spans, ADR-0059 §4): the definition, its name, parameters, result, contract, then its body, depth first. The order follows the tree, so two texts with the same qualified normal form list the same nodes whatever their layout. Attributes are left out; a path is one node whatever its length")]
    #[effects(alloc)]
    fn node_spans(d: &ast::FnDef) -> Vec<source::Span> {
        let mut out: Vec<source::Span> = Vec::new();
        out.push(d.span);
        out.push(d.name.span);
        for i in 0..d.params.len()
            invariant 0 <= i && i <= d.params.len(),
        {
            out.push(d.params[i].name.span);
            ns_ty(&d.params[i].ty, &mut out, 100000);
        }
        match &d.ret.name {
            None => {},
            Some(n) => out.push(n.span),
        }
        ns_ty(&d.ret.ty, &mut out, 100000);
        for j in 0..d.pre.len()
            invariant 0 <= j && j <= d.pre.len(),
        {
            ns_expr(&d.pre[j], &mut out, 1000000000);
        }
        for k in 0..d.post.len()
            invariant 0 <= k && k <= d.post.len(),
        {
            ns_expr(&d.post[k], &mut out, 1000000000);
        }
        match &d.measure {
            None => {},
            Some(m) => ns_expr(m, &mut out, 1000000000),
        }
        ns_block(&d.body, &mut out, 1000000000);
        out
    }

    #[summary("A node list as payload text (stage0 nodes_text): `-` for none, else `CODE@INDEX` by commas")]
    #[effects(alloc)]
    fn nodes_text(v: &[String]) -> String {
        if v.len() == 0 {
            return String::from("-");
        }
        encode_terms::join(v, ",")
    }

    #[summary("The nodes of a block: the block, its statements, its tail")]
    #[effects(alloc)]
    fn ns_block(b: &ast::Block, out: &mut Vec<source::Span>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        out.push(b.span);
        for i in 0..b.stmts.len()
            invariant 0 <= i && i <= b.stmts.len(),
        {
            ns_stmt(&b.stmts[i], out, f - 1);
        }
        match &b.tail {
            None => {},
            Some(t) => ns_expr(&**t, out, f - 1),
        }
    }

    #[summary("The nodes of an expression: the expression, then its parts (a closure's are not walked)")]
    #[effects(alloc)]
    fn ns_expr(e: &ast::Expr, out: &mut Vec<source::Span>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        out.push(e.span);
        match &e.kind {
            ast::ExprKind::Int(xv, xr) => {},
            ast::ExprKind::Float(xf) => {},
            ast::ExprKind::ByteLit(xb) => {},
            ast::ExprKind::ByteStr(xbs) => {},
            ast::ExprKind::StrLit(xs) => {},
            ast::ExprKind::CharLit(xc) => {},
            ast::ExprKind::Bool(xbo) => {},
            ast::ExprKind::Unit => {},
            ast::ExprKind::Var(var) => out.push(var.span),
            ast::ExprKind::Call(call) => { ns_path(call.path.as_slice(), out); for i in 0..call.targs.len() invariant 0 <= i && i <= call.targs.len(), { out.push(call.targs[i].span); for j in 0..call.targs[i].args.len() invariant 0 <= j && j <= call.targs[i].args.len(), { ns_ty(&call.targs[i].args[j], out, 100000); } } ns_exprs(call.args.as_slice(), out, f - 1); },
            ast::ExprKind::Method(me) => { ns_expr(&*me.recv, out, f - 1); out.push(me.name.span); ns_exprs(me.args.as_slice(), out, f - 1); },
            ast::ExprKind::Index(ib, ii) => { ns_expr(&**ib, out, f - 1); ns_expr(&**ii, out, f - 1); },
            ast::ExprKind::Unary(uo, ux) => ns_expr(&**ux, out, f - 1),
            ast::ExprKind::Binary(bo, bl, br) => { ns_expr(&**bl, out, f - 1); ns_expr(&**br, out, f - 1); },
            ast::ExprKind::Ref(rm, rx) => ns_expr(&**rx, out, f - 1),
            ast::ExprKind::If(ife) => { ns_expr(&*ife.cond, out, f - 1); ns_block(&ife.then, out, f - 1); match &ife.els { None => {}, Some(el) => ns_expr(&**el, out, f - 1), } },
            ast::ExprKind::Block(blk) => ns_block(blk, out, f - 1),
            ast::ExprKind::Array(arr) => ns_exprs(arr.as_slice(), out, f - 1),
            ast::ExprKind::Repeat(rp) => { ns_expr(&*rp.value, out, f - 1); out.push(rp.count_span); },
            ast::ExprKind::Old(ox) => ns_expr(&**ox, out, f - 1),
            ast::ExprKind::Quant(qu) => { for i in 0..qu.binders.len() invariant 0 <= i && i <= qu.binders.len(), { out.push(qu.binders[i].name.span); ns_ty(&qu.binders[i].ty, out, 100000); } ns_expr(&*qu.body, out, f - 1); },
            ast::ExprKind::Trigger(tx) => ns_expr(&**tx, out, f - 1),
            ast::ExprKind::Closure(clo) => {},
            ast::ExprKind::StructLit(sl) => { ns_path(sl.path.as_slice(), out); for i in 0..sl.fields.len() invariant 0 <= i && i <= sl.fields.len(), { out.push(sl.fields[i].name.span); ns_expr(&sl.fields[i].value, out, f - 1); } match &sl.rest { None => {}, Some(rest) => ns_expr(&**rest, out, f - 1), } },
            ast::ExprKind::Path(pa) => ns_path(pa.as_slice(), out),
            ast::ExprKind::Deref(dx) => ns_expr(&**dx, out, f - 1),
            ast::ExprKind::Field(fb, fname) => { ns_expr(&**fb, out, f - 1); out.push(fname.span); },
            ast::ExprKind::Match(ma) => { ns_expr(&*ma.scrut, out, f - 1); for i in 0..ma.arms.len() invariant 0 <= i && i <= ma.arms.len(), { out.push(ma.arms[i].span); out.push(ma.arms[i].pat.span); ns_path(ma.arms[i].pat.path.as_slice(), out); for j in 0..ma.arms[i].pat.binds.len() invariant 0 <= j && j <= ma.arms[i].pat.binds.len(), { match &ma.arms[i].pat.binds[j] { None => {}, Some(bound) => out.push(bound.span), } } ns_expr(&ma.arms[i].body, out, f - 1); } },
            ast::ExprKind::Return(ret) => { match ret { None => {}, Some(rv) => ns_expr(&**rv, out, f - 1), } },
            ast::ExprKind::Try(trx) => ns_expr(&**trx, out, f - 1),
            ast::ExprKind::Loop(lo) => { match &lo.label { None => {}, Some(ll) => out.push(ll.span), } ns_exprs(lo.invariants.as_slice(), out, f - 1); match &lo.measure { None => {}, Some(lm) => ns_expr(&**lm, out, f - 1), } ns_block(&lo.body, out, f - 1); },
            ast::ExprKind::Break(br2) => { match &br2.label { None => {}, Some(bl2) => out.push(bl2.span), } match &br2.value { None => {}, Some(bv) => ns_expr(&**bv, out, f - 1), } },
            ast::ExprKind::Continue(cl) => { match cl { None => {}, Some(cn) => out.push(cn.span), } },
            ast::ExprKind::Range(ra) => { ns_expr(&*ra.lo, out, f - 1); ns_expr(&*ra.hi, out, f - 1); },
            ast::ExprKind::Error => {},
        }
    }

    #[summary("The nodes of an expression list")]
    #[effects(alloc)]
    fn ns_exprs(xs: &[ast::Expr], out: &mut Vec<source::Span>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            ns_expr(&xs[i], out, f - 1);
        }
    }

    #[summary("A path is one node, from its first segment to its last")]
    #[effects(alloc)]
    fn ns_path(p: &[ast::Ident], out: &mut Vec<source::Span>) -> () {
        if p.len() > 0 {
            out.push(p[0].span.to(p[p.len() - 1].span));
        }
    }

    #[summary("The nodes of a statement")]
    #[effects(alloc)]
    fn ns_stmt(s: &ast::Stmt, out: &mut Vec<source::Span>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match s {
            ast::Stmt::Let(l) => { out.push(l.span); out.push(l.name.span); ns_ty(&l.ty, out, 100000); ns_expr(&l.init, out, f - 1); },
            ast::Stmt::Assign(asg) => { out.push(asg.span); ns_expr(&asg.target, out, f - 1); ns_expr(&asg.value, out, f - 1); },
            ast::Stmt::While(w) => { out.push(w.span); match &w.label { None => {}, Some(wl) => out.push(wl.span), } ns_expr(&w.cond, out, f - 1); ns_exprs(w.invariants.as_slice(), out, f - 1); match &w.measure { None => {}, Some(wm) => ns_expr(wm, out, f - 1), } ns_block(&w.body, out, f - 1); },
            ast::Stmt::For(x) => { out.push(x.span); match &x.label { None => {}, Some(xl) => out.push(xl.span), } out.push(x.var.span); ns_expr(&x.lo, out, f - 1); ns_expr(&x.hi, out, f - 1); ns_exprs(x.invariants.as_slice(), out, f - 1); ns_block(&x.body, out, f - 1); },
            ast::Stmt::Assert(a) => { out.push(a.span); ns_expr(&a.cond, out, f - 1); },
            ast::Stmt::Assume(am) => { out.push(am.span); ns_expr(&am.cond, out, f - 1); },
            ast::Stmt::Proof(p) => { out.push(p.span); ns_block(&p.body, out, f - 1); },
            ast::Stmt::LetFields(lf) => { out.push(lf.span); ns_path(lf.path.as_slice(), out); for i in 0..lf.fields.len() invariant 0 <= i && i <= lf.fields.len(), { out.push(lf.fields[i].span); } ns_expr(&lf.init, out, f - 1); },
            ast::Stmt::Expr(e) => ns_expr(e, out, f - 1),
        }
    }

    #[summary("The nodes of a type: the type, then the types inside it")]
    #[effects(alloc)]
    fn ns_ty(t: &ast::Type, out: &mut Vec<source::Span>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        out.push(t.span);
        match &t.kind {
            ast::TypeKind::Int(it) => {},
            ast::TypeKind::F64 => {},
            ast::TypeKind::Bool => {},
            ast::TypeKind::Unit => {},
            ast::TypeKind::Char => {},
            ast::TypeKind::String => {},
            ast::TypeKind::Str => {},
            ast::TypeKind::Array(ae, an) => ns_ty(&**ae, out, f - 1),
            ast::TypeKind::ArrayN(ne, np) => {},
            ast::TypeKind::Slice(se) => ns_ty(&**se, out, f - 1),
            ast::TypeKind::Ref(rm, re) => ns_ty(&**re, out, f - 1),
            ast::TypeKind::Named(p, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { ns_ty(&args[i], out, f - 1); } },
            ast::TypeKind::Vec(ve) => ns_ty(&**ve, out, f - 1),
            ast::TypeKind::Box(be) => ns_ty(&**be, out, f - 1),
            ast::TypeKind::Param(ps) => {},
            ast::TypeKind::Never => {},
            ast::TypeKind::Error => {},
        }
    }

    #[summary("The dependencies at the start of text and the rest of it (stage0 parse_deps): the count of instances and their lines, the count of types and their lines; none when a count or a type does not read or a line is missing")]
    #[effects(alloc)]
    fn parse_deps(text: &str) -> Option<Parsed> {
        let mut at: usize = 0;
        let mut deps: IrDeps = IrDeps { wants: Vec::new(), used: Vec::new() };
        let e0: usize = encode_query::find_byte(text, 10, at)?;
        let w: u64 = cache::number(lexer::cut(text, at, e0).as_str())?;
        at = e0 + 1;
        let mut k: u64 = 0;
        while k < w
            decreases w - k,
        {
            k = k + 1;
            let e1: usize = encode_query::find_byte(text, 10, at)?;
            let parts: Vec<String> = encode_terms::split(lexer::cut(text, at, e1).as_str(), 31);
            at = e1 + 1;
            if parts.len() < 2 || parts.len() % 2 != 0 {
                return None;
            }
            let mut sub: types::Subst = types::Subst { names: Vec::new(), tys: Vec::new() };
            let mut j: usize = 2;
            while j + 1 < parts.len()
                invariant 2 <= j && j <= parts.len(),
                decreases parts.len() - j,
            {
                let ty: ast::TypeKind = parse_ty(parts[j + 1].as_str())?;
                let mut held: usize = sub.names.len();
                for q in 0..sub.names.len()
                    invariant 0 <= q && q <= sub.names.len(),
                {
                    if sub.names[q] == parts[j] {
                        held = q;
                    }
                }
                if held < sub.tys.len() {
                    sub.tys[held] = ty;
                } else {
                    sub.names.push(parts[j].clone());
                    sub.tys.push(ty);
                }
                j = j + 2;
            }
            deps.wants.push(codegen::Want { key: parts[0].clone(), callee: parts[1].clone(), sub: sub });
        }
        let e2: usize = encode_query::find_byte(text, 10, at)?;
        let u: u64 = cache::number(lexer::cut(text, at, e2).as_str())?;
        at = e2 + 1;
        let mut m: u64 = 0;
        while m < u
            decreases u - m,
        {
            m = m + 1;
            let e3: usize = encode_query::find_byte(text, 10, at)?;
            deps.used.push(parse_ty(lexer::cut(text, at, e3).as_str())?);
            at = e3 + 1;
        }
        Some(Parsed { deps: deps, rest: lexer::cut(text, at, text.len()) })
    }

    #[summary("The type that types::text printed (stage0 check::parse_ty): the scalar names, `&mut ` and `&` references, `[T]` slices and `[T; N]` arrays, and names with type arguments in angle brackets, of which `Vec<T>` and `Box<T>` are their own types and a one-segment name other than `Option` and `Result` without arguments a type parameter. Each part is read with white space trimmed; none for text of another form, a segment that is no identifier (nor `Self`) or a length that is no number")]
    #[effects(alloc)]
    fn parse_ty(s: &str) -> Option<ast::TypeKind> {
        parse_ty_in(s, 10000)
    }

    #[summary("parse_ty, f the remaining depth")]
    #[effects(alloc)]
    fn parse_ty_in(text: &str, f: usize) -> Option<ast::TypeKind>
        decreases f,
    {
        if f == 0 {
            return None;
        }
        let s: String = fmt::trim(text);
        match ast::int_of(s.as_str()) {
            None => {},
            Some(it) => { return Some(ast::TypeKind::Int(it)); },
        }
        if s == "f64" {
            return Some(ast::TypeKind::F64);
        }
        if s == "bool" {
            return Some(ast::TypeKind::Bool);
        }
        if s == "()" {
            return Some(ast::TypeKind::Unit);
        }
        if s == "char" {
            return Some(ast::TypeKind::Char);
        }
        if s == "String" {
            return Some(ast::TypeKind::String);
        }
        if s == "str" {
            return Some(ast::TypeKind::Str);
        }
        let none: source::Span = source::Span { file: 0, lo: 0, hi: 0 };
        if encode_terms::starts_at(s.as_str(), 0, "&mut ") {
            let inner: ast::TypeKind = parse_ty_in(lexer::cut(s.as_str(), 5, s.len()).as_str(), f - 1)?;
            return Some(ast::TypeKind::Ref(true, Box::new(ast::Type { kind: inner, span: none })));
        }
        if encode_terms::starts_at(s.as_str(), 0, "&") {
            let inner2: ast::TypeKind = parse_ty_in(lexer::cut(s.as_str(), 1, s.len()).as_str(), f - 1)?;
            return Some(ast::TypeKind::Ref(false, Box::new(ast::Type { kind: inner2, span: none })));
        }
        let n: usize = s.len();
        if n >= 2 && s.as_bytes()[0] == 91 && s.as_bytes()[n - 1] == 93 {
            let parts: Vec<String> = split_top(lexer::cut(s.as_str(), 1, n - 1).as_str(), 59);
            if parts.len() == 1 {
                let e: ast::TypeKind = parse_ty_in(parts[0].as_str(), f - 1)?;
                return Some(ast::TypeKind::Slice(Box::new(ast::Type { kind: e, span: none })));
            }
            if parts.len() == 2 {
                let e2: ast::TypeKind = parse_ty_in(parts[0].as_str(), f - 1)?;
                let len: u64 = cache::number(fmt::trim(parts[1].as_str()).as_str())?;
                return Some(ast::TypeKind::Array(Box::new(ast::Type { kind: e2, span: none }), len));
            }
            return None;
        }
        let mut head: String = s.clone();
        let mut args: Vec<ast::Type> = Vec::new();
        match encode_query::find_byte(s.as_str(), 60, 0) {
            None => {},
            Some(lt) => { if n == 0 || s.as_bytes()[n - 1] != 62 || lt + 1 > n - 1 { return None; } head = lexer::cut(s.as_str(), 0, lt); let inner3: String = lexer::cut(s.as_str(), lt + 1, n - 1); if inner3.len() > 0 { let ps: Vec<String> = split_top(inner3.as_str(), 44); for i in 0..ps.len() invariant 0 <= i && i <= ps.len(), { let a: ast::TypeKind = parse_ty_in(ps[i].as_str(), f - 1)?; args.push(ast::Type { kind: a, span: none }); } } },
        }
        let segs: Vec<String> = segments(head.as_str());
        for k in 0..segs.len()
            invariant 0 <= k && k <= segs.len(),
        {
            if !ident_text(segs[k].as_str()) && segs[k] != "Self" {
                return None;
            }
        }
        if segs.len() == 1 && args.len() == 1 && segs[0] == "Vec" {
            return Some(ast::TypeKind::Vec(Box::new(args[0].clone())));
        }
        if segs.len() == 1 && args.len() == 1 && segs[0] == "Box" {
            return Some(ast::TypeKind::Box(Box::new(args[0].clone())));
        }
        if segs.len() == 1 && args.len() == 0 && segs[0] != "Option" && segs[0] != "Result" {
            return Some(ast::TypeKind::Param(segs[0].clone()));
        }
        Some(ast::TypeKind::Named(segs, args))
    }

    #[summary("Stores slot (kind, path) (stage0 Store::put): the lines of a lazy load not checked yet for it are checked first; the store changes when the entry is new or differs")]
    #[effects(alloc)]
    fn put(st: &mut Store, kind: &str, path: &str, key: &str, payload: &str) -> () {
        let slot: String = slot_of(kind, path);
        settle(st, slot.as_str());
        let same: bool = match st.entries.find(slot.as_str()) {
            None => false,
            Some(at) => st.entries.items[at].key == key && st.entries.items[at].payload == payload,
        };
        if !same {
            st.entries.insert(slot.as_str(), Entry { kind: String::from(kind), path: String::from(path), key: String::from(key), payload: String::from(payload) });
            st.changed = true;
        }
    }

    #[summary("The text a key reads of reference r (the read_of of stage0 nameless_reads), references written by pr's mode: a definition path itself by its whole text, other definitions as rd says, a type or trait as read_text gives it, a trait method by method_read; `? PATH` and a line feed for what the program does not hold")]
    #[effects(alloc)]
    fn read_of(ids: &identity::Ids, pr: &mut fmt::Printer, r: &str, path: &str, rd: &Reads) -> String {
        if encode_terms::starts_at(r, 0, "m:") {
            let rest: String = lexer::cut(r, 2, r.len());
            let sp: usize = match encode_query::find_byte(rest.as_str(), 32, 0) {
                None => rest.len(),
                Some(x) => x,
            };
            let tr: String = lexer::cut(rest.as_str(), 0, sp);
            let m: String = lexer::cut(rest.as_str(), sp.saturating_add(1), rest.len());
            return match ids.method_read(pr, tr.as_str(), m.as_str()) { None => types::cat5("? ", tr.as_str(), "::", m.as_str(), "\n"), Some(t) => t, };
        }
        let p: String = lexer::cut(r, 2, r.len());
        let mut read: u8 = 0;
        if encode_terms::starts_at(r, 0, "0:") && p != path {
            read = 1;
            match rd.kinds.find(p.as_str()) {
                None => {},
                Some(k) => { if body::is_spec(rd.kinds.items[k]) { if types::has(rd.uses.as_slice(), p.as_str()) || types::has(rd.comp.as_slice(), p.as_str()) || types::has(rd.invariants.as_slice(), p.as_str()) { read = 0; } else { read = 2; } } },
            }
        }
        match ids.read_text(pr, r, read) {
            None => types::cat3("? ", p.as_str(), "\n"),
            Some(t) => t,
        }
    }

    #[summary("The definitions the text of r names (stage0 reads of Session::keys), each computed once into memo; none for a path that is no definition")]
    #[effects(alloc)]
    fn reads_of(ck: &body::Checked, pr: &mut fmt::Printer, heads: &table::Table<String>, by_path: &table::Table<encode_decls::Def>, kinds: &table::Table<ast::FnKind>, texts: &mut table::Table<String>, memo: &mut table::Table<Vec<String>>, r: &str) -> Vec<String> {
        match memo.find(r) {
            None => {},
            Some(at) => { return memo.items[at].clone(); },
        }
        let mut out: Vec<String> = Vec::new();
        if by_path.has(r) {
            let t: String = text_of(pr, heads, by_path, texts, r);
            out = named_defs(ck, kinds, t.as_str());
        }
        memo.insert(r, out.clone());
        out
    }

    #[summary("Stores the result of a fully proved definition (stage0 proof_record): none with a failure or with a query the backstop ended (the machine's result, not the program's), and none when a proved obligation is no node of d")]
    #[effects(alloc)]
    fn record(s: &mut Session, path: &str, d: &ast::FnDef, obligations: usize, failed: usize, total: u64, max: u64, backstop: u64, proved: &[encode_spec::Trivial], script: &str) -> () {
        if failed != 0 || backstop != 0 {
            return;
        }
        let at: usize = match s.keys.find(path) {
            None => { return; },
            Some(x) => x,
        };
        let key: String = s.keys.items[at].clone();
        let nodes: Vec<String> = match to_nodes(proved, d) {
            None => { return; },
            Some(v) => v,
        };
        let mut payload: String = String::new();
        std::num::push_u64(&mut payload, obligations as u64);
        payload.push_str(" ");
        std::num::push_u64(&mut payload, total);
        payload.push_str(" ");
        std::num::push_u64(&mut payload, max);
        payload.push_str(" ");
        payload.push_str(script_digest(script).as_str());
        payload.push_str(" ");
        payload.push_str(nodes_text(nodes.as_slice()).as_str());
        put(&mut s.store, "P", path, key.as_str(), payload.as_str());
    }

    #[summary("The proved obligations inside span relative to its start, as the text of an IR key (stage0 relative and rel_text): `-` for none, else `CODE:LO:HI` sorted by code and positions, each once, split by commas; none when one lies outside span")]
    #[effects(alloc)]
    fn rel_text(keys: &[encode_spec::Trivial], span: source::Span) -> Option<String> {
        let mut sortable: Vec<String> = Vec::new();
        let mut shown: Vec<String> = Vec::new();
        for i in 0..keys.len()
            invariant 0 <= i && i <= keys.len(),
        {
            let k: source::Span = keys[i].span;
            if k.file != span.file || k.lo < span.lo || k.hi > span.hi || k.lo > k.hi {
                return None;
            }
            let a: u32 = k.lo - span.lo;
            let b: u32 = k.hi - span.lo;
            let mut t: String = types::cat2(keys[i].code.as_str(), ":");
            std::num::push_u64(&mut t, a as u64);
            t.push_str(":");
            std::num::push_u64(&mut t, b as u64);
            let mut o: String = types::cat2(keys[i].code.as_str(), "\0");
            o.push_str(body::span_key(source::Span { file: 0, lo: a, hi: b }).as_str());
            sortable.push(o);
            shown.push(t);
        }
        if keys.len() == 0 {
            return Some(String::from("-"));
        }
        let ord: Vec<usize> = std::slice::sort_indices::<String>(sortable.as_slice());
        let mut out: Vec<String> = Vec::new();
        for j in 0..ord.len()
            invariant 0 <= j && j <= ord.len(),
        {
            if ord[j] < shown.len() && (out.len() == 0 || out[out.len() - 1] != shown[ord[j]]) {
                out.push(shown[ord[j]].clone());
            }
        }
        Some(encode_terms::join(out.as_slice(), ","))
    }

    #[summary("Whether two lists hold the same texts in the same order")]
    #[effects(pure)]
    fn same_list(a: &[String], b: &[String]) -> bool {
        if a.len() != b.len() {
            return false;
        }
        for i in 0..a.len()
            invariant 0 <= i && i <= a.len() && a.len() == b.len(),
        {
            if a[i] != b[i] {
                return false;
            }
        }
        true
    }

    #[summary("Writes the cache back when something changed (stage0 Session::save, Store::save): every line not checked yet is checked first; then the header and one line per entry in slot order, written to `defs.tmp`, a new file in place of whatever was there, and renamed. The error is the system's text")]
    #[effects(alloc, io)]
    fn save(s: &mut Session) -> Result<(), String> {
        settle_all(&mut s.store);
        if !s.store.changed {
            return Ok(());
        }
        let mut out: String = types::cat4(magic().as_str(), "\nid ", s.id.as_str(), "\n");
        for n in 0..s.store.entries.len()
            invariant 0 <= n,
        {
            match s.store.entries.nth(n) {
                None => {},
                Some(at) => { let e: Entry = s.store.entries.items[at].clone(); out.push_str(types::cat5(e.kind.as_str(), " ", escape_path(e.path.as_str()).as_str(), " ", e.key.as_str()).as_str()); out.push_str(types::cat4(" ", line_digest(e.kind.as_str(), e.path.as_str(), e.key.as_str(), e.payload.as_str()).as_str(), " ", escape(e.payload.as_str()).as_str()).as_str()); out.push_str("\n"); },
            }
        }
        cache::write_file(s.dir.as_str(), "defs", out.as_str())
    }

    #[summary("Writes back the cache of a slot that holds a session (save): why it could not be written, if it could not")]
    #[effects(alloc, io)]
    fn save_slot(slot: &mut Option<Session>) -> Option<String> {
        match slot {
            None => None,
            Some(s) => error_of(save(s)),
        }
    }

    #[summary("The digest of a definition's script as the solver receives it (stage0 script_digest: canonical symbols, ADR-0063), the same for a renamed definition")]
    #[effects(alloc)]
    fn script_digest(script: &str) -> String {
        sha256::hex(encode_query::canonical(script).as_bytes())
    }

    #[summary("Appends a section of a key: its tag, the length of its text in bytes, a line feed, the text, a line feed (stage0 section)")]
    #[effects(alloc)]
    fn section(out: &mut String, tag: &str, text: &str) -> () {
        out.push_str(tag);
        out.push_str(" ");
        std::num::push_u64(out, text.len() as u64);
        out.push_str("\n");
        out.push_str(text);
        out.push_str("\n");
    }

    #[summary("The segments of a path split at each `::` (Rust's split(\"::\"))")]
    #[effects(alloc)]
    fn segments(path: &str) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        let mut start: usize = 0;
        let mut i: usize = 0;
        while i + 1 < path.len()
            invariant start <= i && i <= path.len(),
            decreases path.len() - i,
        {
            if path.as_bytes()[i] == 58 && path.as_bytes()[i + 1] == 58 {
                out.push(lexer::cut(path, start, i));
                i = i + 2;
                start = i;
            } else {
                i = i + 1;
            }
        }
        out.push(lexer::cut(path, start, path.len()));
        out
    }

    #[summary("Checks the lines of slot into the entries (stage0 Store::settle): each line whose digest holds becomes the slot's entry in turn, each other line is damaged")]
    #[effects(alloc)]
    fn settle(st: &mut Store, slot: &str) -> () {
        let at: usize = match st.pending.find(slot) {
            None => { return; },
            Some(x) => x,
        };
        let ls: Lines = st.pending.items[at].clone();
        if ls.raws.len() == 0 {
            return;
        }
        let empty: Lines = Lines { kind: ls.kind.clone(), path: ls.path.clone(), raws: Vec::new() };
        st.pending.insert(slot, empty);
        for i in 0..ls.raws.len()
            invariant 0 <= i && i <= ls.raws.len(),
        {
            match check_line(ls.kind.as_str(), ls.path.as_str(), &ls.raws[i]) {
                None => { st.damaged = st.damaged.saturating_add(1); st.changed = true; },
                Some(e) => st.entries.insert(slot, e),
            }
        }
    }

    #[summary("Checks every line not checked yet")]
    #[effects(alloc)]
    fn settle_all(st: &mut Store) -> () {
        let mut slots: Vec<String> = Vec::new();
        for n in 0..st.pending.len()
            invariant 0 <= n,
        {
            slots.push(st.pending.key(n));
        }
        for i in 0..slots.len()
            invariant 0 <= i && i <= slots.len(),
        {
            settle(st, slots[i].as_str());
        }
    }

    #[summary("The key of slot (kind, path) in the tables of a store, ordered as stage0 orders the pair: kind with each NUL byte as NUL and 1, then NUL NUL, then path")]
    #[effects(alloc)]
    fn slot_of(kind: &str, path: &str) -> String {
        let mut out: String = encode_terms::replace(kind, "\0", "\0\u{1}");
        out.push_str("\0\0");
        out.push_str(path);
        out
    }

    #[summary("The text of position at in its file (stage0 reads sm.file(file).text.get(lo..hi)): none for a file the source map does not hold (generated items) or a range that is not one")]
    #[effects(alloc)]
    fn source_text(sm: &source::SourceMap, at: source::Span) -> Option<String> {
        let i: usize = at.file as usize;
        if i >= sm.files.len() {
            return None;
        }
        let lo: usize = at.lo as usize;
        let hi: usize = at.hi as usize;
        if lo <= hi && hi <= sm.files[i].text.len() && sm.files[i].text.is_char_boundary(lo) && sm.files[i].text.is_char_boundary(hi) {
            Some(lexer::cut(sm.files[i].text.as_str(), lo, hi))
        } else {
            None
        }
    }

    #[summary("One line split at its first four spaces (stage0 splitn(5, ' ')), the path unescaped: kind, path, key, digest and payload; None when it has fewer fields or its path does not unescape")]
    #[effects(alloc)]
    fn split_line(line: &str) -> Option<Entry4> {
        let a: usize = encode_query::find_byte(line, 32, 0)?;
        let b: usize = encode_query::find_byte(line, 32, a + 1)?;
        let c: usize = encode_query::find_byte(line, 32, b + 1)?;
        let d: usize = encode_query::find_byte(line, 32, c + 1)?;
        let path: String = unescape(lexer::cut(line, a + 1, b).as_str())?;
        Some(Entry4 { kind: lexer::cut(line, 0, a), path: path, key: lexer::cut(line, b + 1, c), sum: lexer::cut(line, c + 1, d), payload: lexer::cut(line, d + 1, line.len()) })
    }

    #[summary("text split at byte sep where no bracket (`<`, `[`, `(` against `>`, `]`, `)`) is open (stage0 parse_ty's split_top)")]
    #[effects(alloc)]
    fn split_top(text: &str, sep: u8) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        let mut depth: i64 = 0;
        let mut start: usize = 0;
        for i in 0..text.len()
            invariant 0 <= i && i <= text.len() && start <= i,
        {
            let c: u8 = text.as_bytes()[i];
            if c == 60 || c == 91 || c == 40 {
                depth = depth.saturating_add(1);
            } else if c == 62 || c == 93 || c == 41 {
                depth = depth.saturating_sub(1);
            } else if c == sep && depth == 0 {
                out.push(lexer::cut(text, start, i));
                start = i + 1;
            }
        }
        out.push(lexer::cut(text, start, text.len()));
        out
    }

    #[summary("The stats line of `--stats` of `verify` (stage0 verify_stats without runtime checks): the definitions encoded and reused, lowered and with reused IR, each sorted, the proof cache's hits and misses, the audit's mismatches, the damaged lines")]
    #[effects(alloc)]
    fn stats_line(st: &Stats, hits: usize, misses: usize) -> String {
        let mut line: String = String::from("{\"encoded\":");
        names(&mut line, st.encoded.as_slice());
        line.push_str(",\"reused\":");
        names(&mut line, st.reused.as_slice());
        line.push_str(",\"lowered\":");
        names(&mut line, st.lowered.as_slice());
        line.push_str(",\"ir_reused\":");
        names(&mut line, st.ir_reused.as_slice());
        line.push_str(",\"proof_cache_hits\":");
        std::num::push_u64(&mut line, hits as u64);
        line.push_str(",\"proof_cache_misses\":");
        std::num::push_u64(&mut line, misses as u64);
        line.push_str(",\"audit_mismatches\":");
        names(&mut line, st.mismatches.as_slice());
        line.push_str(",\"damaged\":");
        std::num::push_u64(&mut line, st.damaged as u64);
        line.push_str("}\n");
        line
    }

    #[summary("What the session of a slot did, when it holds one")]
    #[effects(alloc)]
    fn stats_of(slot: &Option<Session>) -> Option<Stats> {
        match slot {
            None => None,
            Some(s) => Some(s.stats.clone()),
        }
    }

    #[summary("The text another definition's key reads of definition r (a spec fn's qualified text with its body, any other's caller text), each computed once into memo")]
    #[effects(alloc)]
    fn text_of(pr: &mut fmt::Printer, heads: &table::Table<String>, by_path: &table::Table<encode_decls::Def>, memo: &mut table::Table<String>, r: &str) -> String {
        match memo.find(r) {
            None => {},
            Some(at) => { return memo.items[at].clone(); },
        }
        let t: String = match by_path.find(r) {
            None => String::new(),
            Some(bi) => { if body::is_spec(by_path.items[bi].d.kind) { fmt::qualified_text(pr, heads, &by_path.items[bi].d, by_path.items[bi].unit.as_str(), true) } else { fmt::caller_text(pr, heads, &by_path.items[bi].d, by_path.items[bi].unit.as_str()) } },
        };
        memo.insert(r, t.clone());
        t
    }

    #[summary("Proved obligations as node positions in d (stage0 to_nodes): the code and the index of the first node with the obligation's span, sorted by code and index without repeats, as `CODE@INDEX` texts. None when an obligation is no node of d")]
    #[effects(alloc)]
    fn to_nodes(keys: &[encode_spec::Trivial], d: &ast::FnDef) -> Option<Vec<String>> {
        let nodes: Vec<source::Span> = node_spans(d);
        let mut first: table::Table<usize> = table::new::<usize>();
        for i in 0..nodes.len()
            invariant 0 <= i && i <= nodes.len(),
        {
            let k: String = body::span_key(nodes[i]);
            if !first.has(k.as_str()) {
                first.insert(k.as_str(), i);
            }
        }
        let mut sortable: Vec<String> = Vec::new();
        let mut shown: Vec<String> = Vec::new();
        for j in 0..keys.len()
            invariant 0 <= j && j <= keys.len(),
        {
            let at: usize = first.find(body::span_key(keys[j].span).as_str())?;
            let n: usize = first.items[at];
            let mut t: String = types::cat2(keys[j].code.as_str(), "@");
            std::num::push_u64(&mut t, n as u64);
            let digits: String = encode_terms::dec(n as u64);
            let mut s: String = types::cat2(keys[j].code.as_str(), "\0");
            for z in digits.len()..20
                invariant digits.len() <= z,
            {
                s.push_str("0");
            }
            s.push_str(digits.as_str());
            sortable.push(types::cat3(s.as_str(), "\0", t.as_str()));
            shown.push(t);
        }
        let ord: Vec<usize> = std::slice::sort_indices::<String>(sortable.as_slice());
        let mut out: Vec<String> = Vec::new();
        for o in 0..ord.len()
            invariant 0 <= o && o <= ord.len(),
        {
            if ord[o] < shown.len() && !types::has(out.as_slice(), shown[ord[o]].as_str()) {
                out.push(shown[ord[o]].clone());
            }
        }
        Some(out)
    }

    #[summary("The data types the words of text (written in unit) name (stage0's types of Session::keys): a word is a type by its path or, in its own unit, by its name; each new one is added to tys and todo")]
    #[effects(alloc)]
    fn type_words(ck: &body::Checked, text: &str, unit: &str, tys: &mut table::Table<bool>, todo: &mut Vec<String>) -> () {
        let ws: Vec<String> = words(text);
        for i in 0..ws.len()
            invariant 0 <= i && i <= ws.len(),
        {
            let local: String = types::cat3(unit, "::", ws[i].as_str());
            if ck.b.c.adts.has(local.as_str()) {
                if !tys.has(local.as_str()) {
                    tys.insert(local.as_str(), true);
                    todo.push(local.clone());
                }
            } else if ck.b.c.adts.has(ws[i].as_str()) {
                if !tys.has(ws[i].as_str()) {
                    tys.insert(ws[i].as_str(), true);
                    todo.push(ws[i].clone());
                }
            }
        }
    }

    #[summary("s with the escapes of escape_path undone (stage0 unescape): `\\\\`, `\\n` and `\\s`; None for any other backslash")]
    #[effects(alloc)]
    fn unescape(s: &str) -> Option<String> {
        let mut out: String = String::new();
        let mut from: usize = 0;
        let mut i: usize = 0;
        while i < s.len()
            invariant from <= i,
            decreases s.len() - i,
        {
            if s.as_bytes()[i] == 92 {
                out.push_str(lexer::cut(s, from, i).as_str());
                if i + 1 >= s.len() {
                    return None;
                }
                let c: u8 = s.as_bytes()[i + 1];
                if c == 92 {
                    out.push_str("\\");
                } else if c == 110 {
                    out.push_str("\n");
                } else if c == 115 {
                    out.push_str(" ");
                } else {
                    return None;
                }
                i = i + 2;
                from = i;
            } else {
                i = i + 1;
            }
        }
        out.push_str(lexer::cut(s, from, s.len()).as_str());
        Some(out)
    }

    #[summary("The identity of a build that cannot read its own executable: under it nothing is read")]
    #[effects(alloc)]
    fn unknown_id() -> String {
        String::from("port+unknown")
    }

    #[summary("Gives the session the IR keys of the program and the key lines of its data types, for a run that lowers it (stage0 computes them in Session::new)")]
    #[effects(alloc)]
    fn with_ir(s: &mut Session, ck: &body::Checked, low: &lowered::Tables, sm: &source::SourceMap) -> () {
        s.ir_keys = ir_keys(ck, low, sm);
        s.adts = adt_keys(ck);
    }

    #[summary("The words of text as stage0's keys split it (at every character that is neither alphanumeric nor `_` nor `:`), without the words holding a character outside ASCII, which no path or type name has")]
    #[effects(alloc)]
    fn words(text: &str) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        let mut start: usize = 0;
        let mut ascii: bool = true;
        let mut i: usize = 0;
        while i < text.len()
            invariant start <= i,
            decreases text.len() - i,
        {
            let c: u8 = text.as_bytes()[i];
            let mut next: usize = i + 1;
            let mut part: bool = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 58;
            if c >= 128 {
                match std::str::decode_utf8(text, i) {
                    None => { part = false; },
                    Some(dc) => { if dc.next > i && dc.next <= text.len() { next = dc.next; } part = unicode::alphanumeric(u32::from(dc.ch)); },
                }
                if part {
                    ascii = false;
                }
            }
            if !part {
                if i > start && ascii {
                    out.push(lexer::cut(text, start, i));
                }
                start = next;
                ascii = true;
            }
            i = next;
        }
        if text.len() > start && ascii {
            out.push(lexer::cut(text, start, text.len()));
        }
        out
    }
}
