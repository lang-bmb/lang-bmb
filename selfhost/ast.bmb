#[summary("Syntax tree (port of stage0 compiler/src/ast.rs). Expression traversals (expr_mut etc.) take the visitor trait ExprFn, type traversals (unit_types_mut) take TypeFn. The deep copy is the built-in clone (ADR-0141)")]
mod ast {
    #[summary("Visitor of a traversal that receives one expression (stage0's &mut dyn FnMut(&mut Expr))")]
    trait ExprFn {
        #[effects(alloc)]
        fn expr(self: &mut Self, e: &mut Expr) -> ();
    }

    #[summary("Visitor of a traversal that receives one type: together with the path of the unit that uses the type (&mut dyn FnMut(&str, &mut Type) of stage0 unit_types_mut)")]
    trait TypeFn {
        #[effects(alloc)]
        fn ty(self: &mut Self, unit: &str, t: &mut Type) -> ();
    }

    #[summary("How a method call passes the receiver (ADR-0051)")]
    enum Adjust { Value, Ref, RefMut, AsStr }

    #[summary("One arm of a match")]
    struct Arm { pat: Pat, body: Expr, span: source::Span }

    #[summary("assert(cond); or assert(cond) by (bit_vector); (ADR-0048 §4)")]
    struct Assert { cond: Expr, by: Option<Prover>, span: source::Span }

    #[summary("x = e;")]
    struct Assign { target: Expr, value: Expr, span: source::Span }

    #[summary("assume(p(..)); (ADR-0029 §1). rationale is the #[rationale(..)] before it")]
    struct Assume { cond: Expr, rationale: Option<Attr>, span: source::Span }

    struct Attr { name: Ident, args: Vec<AttrArg>, span: source::Span }

    #[summary("Argument of an attribute: name, string, key = value")]
    enum AttrArg { Ident(Ident), Str(String, source::Span), Pair(Ident, Box<AttrArg>) }

    enum BinOp { Add, Sub, Mul, Div, Rem, Eq, Ne, Lt, Le, Gt, Ge, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr }

    struct Block { stmts: Vec<Stmt>, tail: Option<Box<Expr>>, span: source::Span }

    #[summary("break, break 'l, break e")]
    struct Break { label: Option<Ident>, value: Option<Box<Expr>> }

    #[summary("Call by path f(..), a::b::f(..). targs are the type arguments written on the path, method is how the receiver was passed when written as x.f(..)")]
    struct Call { path: Vec<Ident>, targs: Vec<TArgs>, args: Vec<Expr>, method: Option<Adjust> }

    #[summary("Closure expression (ADR-0053 §1, §2)")]
    struct Closure { is_move: bool, params: Vec<Param>, ret: Ret, pre: Vec<Expr>, post: Vec<Expr>, body: Block, span: source::Span }

    #[summary("const NAME: T = e; (ADR-0052)")]
    struct ConstDef { attrs: Vec<Attr>, name: Ident, ty: Type, value: Expr, span: source::Span }

    struct Expr { kind: ExprKind, span: source::Span }

    enum ExprKind { Int(wide::U128, Radix), Float(u64), ByteLit(u8), ByteStr(Vec<u8>), StrLit(String), CharLit(u32), Bool(bool), Unit, Var(Ident), Call(Call), Method(Method), Index(Box<Expr>, Box<Expr>), Unary(UnOp, Box<Expr>), Binary(BinOp, Box<Expr>, Box<Expr>), Ref(bool, Box<Expr>), If(If), Block(Block), Array(Vec<Expr>), Repeat(Repeat), Old(Box<Expr>), Quant(Quant), Trigger(Box<Expr>), Closure(Box<Closure>), StructLit(StructLit), Path(Vec<Ident>), Deref(Box<Expr>), Field(Box<Expr>, Ident), Match(Match), Return(Option<Box<Expr>>), Try(Box<Expr>), Loop(Loop), Break(Break), Continue(Option<Ident>), Range(Range), Error }

    struct Field { name: Ident, ty: Type }

    #[summary("One field of a struct expression")]
    struct FieldInit { name: Ident, value: Expr }

    #[summary("Fn(A, B) -> R: parameter types and result (() if there is no ->)")]
    struct FnBound { kind: FnTrait, params: Vec<Type>, ret: Type, span: source::Span }

    struct FnDef { kind: FnKind, name: Ident, generics: Vec<TypeParam>, attrs: Vec<Attr>, params: Vec<Param>, ret: Ret, pre: Vec<Expr>, post: Vec<Expr>, measure: Option<Expr>, body: Block, span: source::Span }

    enum FnKind { Exec, Spec, Proof }

    enum FnTrait { Fn, FnMut, FnOnce }

    #[summary("'l: for i in lo..hi invariant .., { .. } (ADR-0049 §2)")]
    struct For { label: Option<Ident>, var: Ident, lo: Expr, hi: Expr, inclusive: bool, invariants: Vec<Expr>, body: Block, span: source::Span }

    struct Ident { name: String, span: source::Span }

    struct If { cond: Box<Expr>, then: Block, els: Option<Box<Expr>> }

    #[summary("impl T { fn .. }")]
    struct Impl { generics: Vec<TypeParam>, ty: Ident, ty_args: Vec<Type>, fns: Vec<FnDef>, span: source::Span }

    enum IntTy { I8, I16, I32, I64, Isize, U8, U16, U32, U64, Usize }

    #[summary("Repeat count written as the name of a const (ADR-0052 §4): position of the count and the name")]
    struct Len { at: source::Span, path: Vec<Ident> }

    struct Let { mutable: bool, name: Ident, ty: Type, ty_missing: bool, init: Expr, span: source::Span }

    #[summary("let Point { x, y } = p; (Rust habit, E0230)")]
    struct LetFields { path: Vec<Ident>, fields: Vec<Ident>, init: Expr, span: source::Span }

    #[summary("'l: loop invariant .., decreases .., { .. } (ADR-0049 §1)")]
    struct Loop { label: Option<Ident>, invariants: Vec<Expr>, measure: Option<Box<Expr>>, body: Block }

    struct Match { scrut: Box<Expr>, arms: Vec<Arm> }

    #[summary("Built-in method call a.len(), x.wrapping_add(y)")]
    struct Method { recv: Box<Expr>, name: Ident, args: Vec<Expr> }

    struct Mod { name: Ident, attrs: Vec<Attr>, fns: Vec<FnDef>, mods: Vec<Mod>, types: Vec<TypeDef>, impls: Vec<Impl>, traits: Vec<TraitDef>, trait_impls: Vec<TraitImpl>, uses: Vec<UseItem>, consts: Vec<ConstDef>, lens: Vec<Len>, span: source::Span }

    struct Param { name: Ident, ty: Type }

    #[summary("Variant pattern Shape::Rect(a, _), Some(x), None. Each payload slot is a new name or _ (None)")]
    struct Pat { path: Vec<Ident>, binds: Vec<Option<Ident>>, parens: bool, origin: PatOrigin, span: source::Span }

    #[summary("Where a pattern came from. Only Written is what the source wrote")]
    enum PatOrigin { Written, IfLetElse, Rejected }

    struct Program { mods: Vec<Mod> }

    #[summary("proof { .. } (ADR-0062 §1)")]
    struct ProofBlock { body: Block, span: source::Span }

    #[summary("Prover of assert(e) by (..) (ADR-0048 §4)")]
    enum Prover { BitVector }

    struct Quant { q: Quantifier, binders: Vec<Param>, body: Box<Expr> }

    enum Quantifier { Forall, Exists }

    #[summary("Radix in which an integer literal was written (ADR-0048 §3). The normal form keeps it: 0xff stays 0xff")]
    enum Radix { Dec, Hex, Oct, Bin }

    #[summary("lo..hi. inclusive means written as lo..=hi")]
    struct Range { lo: Box<Expr>, hi: Box<Expr>, inclusive: bool }

    #[summary("[v; N]")]
    struct Repeat { value: Box<Expr>, count: wide::U128, count_span: source::Span }

    struct Ret { name: Option<Ident>, ty: Type }

    enum Stmt { Let(Let), Assign(Assign), While(While), For(For), Assert(Assert), Assume(Assume), Proof(ProofBlock), LetFields(LetFields), Expr(Expr) }

    #[summary("Point { x: e, y: e } (ADR-0026 §3). rest is ..base (E0223)")]
    struct StructLit { path: Vec<Ident>, fields: Vec<FieldInit>, rest: Option<Box<Expr>> }

    #[summary("Type arguments written after segment seg of a call path (ADR-0046 §3)")]
    struct TArgs { seg: usize, args: Vec<Type>, span: source::Span }

    struct TraitDef { name: Ident, attrs: Vec<Attr>, fns: Vec<TraitFn>, span: source::Span }

    #[summary("Method of a trait: signature, and whether a default body was written")]
    struct TraitFn { f: FnDef, has_body: bool }

    #[summary("impl<T: Copy> geo::Shape for Wrap<T> { .. } (ADR-0046 §2)")]
    struct TraitImpl { generics: Vec<TypeParam>, trait_path: Vec<Ident>, self_ty: Type, fns: Vec<FnDef>, span: source::Span }

    struct Type { kind: TypeKind, span: source::Span }

    struct TypeDef { name: Ident, generics: Vec<TypeParam>, attrs: Vec<Attr>, kind: TypeDefKind, span: source::Span }

    enum TypeDefKind { Struct(Vec<Field>), Enum(Vec<Variant>) }

    enum TypeKind { Int(IntTy), F64, Bool, Unit, Char, String, Str, Array(Box<Type>, u64), ArrayN(Box<Type>, Vec<String>), Slice(Box<Type>), Ref(bool, Box<Type>), Named(Vec<String>, Vec<Type>), Vec(Box<Type>), Box(Box<Type>), Param(String), Never, Error }

    #[summary("Type parameter T, T: Copy (ADR-0046 §1). fn_bound is F: Fn(A, B) -> R")]
    struct TypeParam { name: Ident, bounds: Vec<Vec<Ident>>, fn_bound: Option<FnBound>, span: source::Span }

    enum UnOp { Neg, Not }

    #[summary("A use that brings in one name")]
    struct UseItem { path: Vec<Ident>, span: source::Span }

    struct Variant { name: Ident, payload: Vec<Type>, span: source::Span }

    struct While { label: Option<Ident>, cond: Expr, invariants: Vec<Expr>, measure: Option<Expr>, body: Block, span: source::Span }

    #[summary("Moves the elements of src to the end of dst, in order")]
    #[effects(alloc)]
    fn append<T>(dst: &mut Vec<T>, src: Vec<T>) -> () {
        let mut rest: Vec<T> = src;
        let mut flipped: Vec<T> = Vec::new();
        let mut n: usize = rest.len();
        while n > 0
            decreases n,
        {
            n = n - 1;
            match rest.pop() {
                None => {},
                Some(m) => flipped.push(m),
            }
        }
        let mut j: usize = flipped.len();
        while j > 0
            decreases j,
        {
            j = j - 1;
            match flipped.pop() {
                None => {},
                Some(m2) => dst.push(m2),
            }
        }
    }

    #[summary("All expressions of a block, innermost first. f is the remaining depth (ADR-0140)")]
    #[effects(alloc)]
    fn block_mut<V: ExprFn>(b: &mut Block, v: &mut V, deep: bool, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = b.stmts.len();
        for i in 0..n
            invariant b.stmts.len() == n,
        {
            match &mut b.stmts[i] {
                Stmt::Let(sl) => expr_mut::<V>(&mut sl.init, v, deep, f - 1),
                Stmt::Assign(sa) => { expr_mut::<V>(&mut sa.target, v, deep, f - 1); expr_mut::<V>(&mut sa.value, v, deep, f - 1); },
                Stmt::While(sw) => { expr_mut::<V>(&mut sw.cond, v, deep, f - 1); exprs_each::<V>(&mut sw.invariants, v, deep, f - 1); opt_mut::<V>(&mut sw.measure, v, deep, f - 1); block_mut::<V>(&mut sw.body, v, deep, f - 1); },
                Stmt::For(sf) => { expr_mut::<V>(&mut sf.lo, v, deep, f - 1); expr_mut::<V>(&mut sf.hi, v, deep, f - 1); exprs_each::<V>(&mut sf.invariants, v, deep, f - 1); block_mut::<V>(&mut sf.body, v, deep, f - 1); },
                Stmt::Assert(st) => expr_mut::<V>(&mut st.cond, v, deep, f - 1),
                Stmt::Assume(su) => expr_mut::<V>(&mut su.cond, v, deep, f - 1),
                Stmt::Proof(sp) => block_mut::<V>(&mut sp.body, v, deep, f - 1),
                Stmt::LetFields(lf) => expr_mut::<V>(&mut lf.init, v, deep, f - 1),
                Stmt::Expr(se) => expr_mut::<V>(se, v, deep, f - 1),
            }
        }
        opt_box_mut::<V>(&mut b.tail, v, deep, f - 1);
    }

    #[summary("Walks the expressions of a block in the same order as block_mut, giving types to the visitor")]
    #[effects(alloc)]
    fn block_types<V: TypeFn>(b: &mut Block, unit: &str, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = b.stmts.len();
        for i in 0..n
            invariant b.stmts.len() == n,
        {
            match &mut b.stmts[i] {
                Stmt::Let(sl) => expr_types::<V>(&mut sl.init, unit, v, f - 1),
                Stmt::Assign(sa) => { expr_types::<V>(&mut sa.target, unit, v, f - 1); expr_types::<V>(&mut sa.value, unit, v, f - 1); },
                Stmt::While(sw) => { expr_types::<V>(&mut sw.cond, unit, v, f - 1); exprs_types::<V>(&mut sw.invariants, unit, v, f - 1); opt_types::<V>(&mut sw.measure, unit, v, f - 1); block_types::<V>(&mut sw.body, unit, v, f - 1); },
                Stmt::For(sf) => { expr_types::<V>(&mut sf.lo, unit, v, f - 1); expr_types::<V>(&mut sf.hi, unit, v, f - 1); exprs_types::<V>(&mut sf.invariants, unit, v, f - 1); block_types::<V>(&mut sf.body, unit, v, f - 1); },
                Stmt::Assert(st) => expr_types::<V>(&mut st.cond, unit, v, f - 1),
                Stmt::Assume(su) => expr_types::<V>(&mut su.cond, unit, v, f - 1),
                Stmt::Proof(sp) => block_types::<V>(&mut sp.body, unit, v, f - 1),
                Stmt::LetFields(lf) => expr_types::<V>(&mut lf.init, unit, v, f - 1),
                Stmt::Expr(se) => expr_types::<V>(se, unit, v, f - 1),
            }
        }
        opt_box_types::<V>(&mut b.tail, unit, v, f - 1);
    }

    #[summary("Initializer expressions of all consts (ADR-0052)")]
    #[effects(alloc)]
    fn const_exprs_mut<V: ExprFn>(p: &mut Program, v: &mut V) -> () {
        let n: usize = p.mods.len();
        for i in 0..n
            invariant p.mods.len() == n,
        {
            mod_consts::<V>(&mut p.mods[i], v, 1000000000);
        }
    }

    #[effects(alloc)]
    fn consts_types<V: TypeFn>(cs: &mut Vec<ConstDef>, unit: &str, v: &mut V) -> () {
        let n: usize = cs.len();
        for i in 0..n
            invariant cs.len() == n,
        {
            v.ty(unit, &mut cs[i].ty);
        }
    }

    #[summary("Expression e and all expressions inside it to the visitor, innermost first: children first, the node after. Unless deep, does not enter closures (the closure itself is seen)")]
    #[effects(alloc)]
    fn expr_mut<V: ExprFn>(e: &mut Expr, v: &mut V, deep: bool, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match &mut e.kind {
            ExprKind::Int(iv, ir) => {},
            ExprKind::Float(fb) => {},
            ExprKind::ByteLit(by) => {},
            ExprKind::ByteStr(bys) => {},
            ExprKind::StrLit(st) => {},
            ExprKind::CharLit(ch) => {},
            ExprKind::Bool(bo) => {},
            ExprKind::Unit => {},
            ExprKind::Var(id) => {},
            ExprKind::Call(ca) => exprs_each::<V>(&mut ca.args, v, deep, f - 1),
            ExprKind::Method(me) => { expr_mut::<V>(&mut *me.recv, v, deep, f - 1); exprs_each::<V>(&mut me.args, v, deep, f - 1); },
            ExprKind::Index(ib, ii) => { expr_mut::<V>(&mut **ib, v, deep, f - 1); expr_mut::<V>(&mut **ii, v, deep, f - 1); },
            ExprKind::Unary(uo, ux) => expr_mut::<V>(&mut **ux, v, deep, f - 1),
            ExprKind::Binary(bop, bl, br) => { expr_mut::<V>(&mut **bl, v, deep, f - 1); expr_mut::<V>(&mut **br, v, deep, f - 1); },
            ExprKind::Ref(rm, rx) => expr_mut::<V>(&mut **rx, v, deep, f - 1),
            ExprKind::If(ife) => { expr_mut::<V>(&mut *ife.cond, v, deep, f - 1); block_mut::<V>(&mut ife.then, v, deep, f - 1); opt_box_mut::<V>(&mut ife.els, v, deep, f - 1); },
            ExprKind::Block(blk) => block_mut::<V>(blk, v, deep, f - 1),
            ExprKind::Array(ar) => exprs_each::<V>(ar, v, deep, f - 1),
            ExprKind::Repeat(rp) => expr_mut::<V>(&mut *rp.value, v, deep, f - 1),
            ExprKind::Old(ox) => expr_mut::<V>(&mut **ox, v, deep, f - 1),
            ExprKind::Quant(qu) => expr_mut::<V>(&mut *qu.body, v, deep, f - 1),
            ExprKind::Trigger(tx) => expr_mut::<V>(&mut **tx, v, deep, f - 1),
            ExprKind::Closure(cl) => { if deep { exprs_each::<V>(&mut cl.pre, v, deep, f - 1); exprs_each::<V>(&mut cl.post, v, deep, f - 1); block_mut::<V>(&mut cl.body, v, deep, f - 1); } },
            ExprKind::StructLit(sl) => { let n: usize = sl.fields.len(); for i in 0..n invariant sl.fields.len() == n, { expr_mut::<V>(&mut sl.fields[i].value, v, deep, f - 1); } opt_box_mut::<V>(&mut sl.rest, v, deep, f - 1); },
            ExprKind::Path(pa) => {},
            ExprKind::Deref(dx) => expr_mut::<V>(&mut **dx, v, deep, f - 1),
            ExprKind::Field(fx, fnm) => expr_mut::<V>(&mut **fx, v, deep, f - 1),
            ExprKind::Match(ma) => { expr_mut::<V>(&mut *ma.scrut, v, deep, f - 1); let na: usize = ma.arms.len(); for j in 0..na invariant ma.arms.len() == na, { expr_mut::<V>(&mut ma.arms[j].body, v, deep, f - 1); } },
            ExprKind::Return(rv) => { opt_box_mut::<V>(rv, v, deep, f - 1); },
            ExprKind::Try(tr) => expr_mut::<V>(&mut **tr, v, deep, f - 1),
            ExprKind::Loop(lp) => { exprs_each::<V>(&mut lp.invariants, v, deep, f - 1); opt_box_mut::<V>(&mut lp.measure, v, deep, f - 1); block_mut::<V>(&mut lp.body, v, deep, f - 1); },
            ExprKind::Break(bk) => { opt_box_mut::<V>(&mut bk.value, v, deep, f - 1); },
            ExprKind::Continue(co) => {},
            ExprKind::Range(rg) => { expr_mut::<V>(&mut *rg.lo, v, deep, f - 1); expr_mut::<V>(&mut *rg.hi, v, deep, f - 1); },
            ExprKind::Error => {},
        }
        v.expr(e);
    }

    #[summary("Walks in the same order as expr_mut (children first), giving the types written in that expression to the visitor: lets of blocks, loop and if, type arguments of calls, variables of quantifiers")]
    #[effects(alloc)]
    fn expr_types<V: TypeFn>(e: &mut Expr, unit: &str, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match &mut e.kind {
            ExprKind::Int(iv, ir) => {},
            ExprKind::Float(fb) => {},
            ExprKind::ByteLit(by) => {},
            ExprKind::ByteStr(bys) => {},
            ExprKind::StrLit(st) => {},
            ExprKind::CharLit(ch) => {},
            ExprKind::Bool(bo) => {},
            ExprKind::Unit => {},
            ExprKind::Var(id) => {},
            ExprKind::Call(ca) => { exprs_types::<V>(&mut ca.args, unit, v, f - 1); let nt: usize = ca.targs.len(); for i in 0..nt invariant ca.targs.len() == nt, { types_each::<V>(&mut ca.targs[i].args, unit, v); } },
            ExprKind::Method(me) => { expr_types::<V>(&mut *me.recv, unit, v, f - 1); exprs_types::<V>(&mut me.args, unit, v, f - 1); },
            ExprKind::Index(ib, ii) => { expr_types::<V>(&mut **ib, unit, v, f - 1); expr_types::<V>(&mut **ii, unit, v, f - 1); },
            ExprKind::Unary(uo, ux) => expr_types::<V>(&mut **ux, unit, v, f - 1),
            ExprKind::Binary(bop, bl, br) => { expr_types::<V>(&mut **bl, unit, v, f - 1); expr_types::<V>(&mut **br, unit, v, f - 1); },
            ExprKind::Ref(rm, rx) => expr_types::<V>(&mut **rx, unit, v, f - 1),
            ExprKind::If(ife) => { expr_types::<V>(&mut *ife.cond, unit, v, f - 1); block_types::<V>(&mut ife.then, unit, v, f - 1); opt_box_types::<V>(&mut ife.els, unit, v, f - 1); stmt_types::<V>(&mut ife.then, unit, v, 1000000000); },
            ExprKind::Block(blk) => { block_types::<V>(blk, unit, v, f - 1); stmt_types::<V>(blk, unit, v, 1000000000); },
            ExprKind::Array(ar) => exprs_types::<V>(ar, unit, v, f - 1),
            ExprKind::Repeat(rp) => expr_types::<V>(&mut *rp.value, unit, v, f - 1),
            ExprKind::Old(ox) => expr_types::<V>(&mut **ox, unit, v, f - 1),
            ExprKind::Quant(qu) => { expr_types::<V>(&mut *qu.body, unit, v, f - 1); let nb: usize = qu.binders.len(); for j in 0..nb invariant qu.binders.len() == nb, { v.ty(unit, &mut qu.binders[j].ty); } },
            ExprKind::Trigger(tx) => expr_types::<V>(&mut **tx, unit, v, f - 1),
            ExprKind::Closure(cl) => { exprs_types::<V>(&mut cl.pre, unit, v, f - 1); exprs_types::<V>(&mut cl.post, unit, v, f - 1); block_types::<V>(&mut cl.body, unit, v, f - 1); },
            ExprKind::StructLit(sl) => { let nf: usize = sl.fields.len(); for k in 0..nf invariant sl.fields.len() == nf, { expr_types::<V>(&mut sl.fields[k].value, unit, v, f - 1); } opt_box_types::<V>(&mut sl.rest, unit, v, f - 1); },
            ExprKind::Path(pa) => {},
            ExprKind::Deref(dx) => expr_types::<V>(&mut **dx, unit, v, f - 1),
            ExprKind::Field(fx, fnm) => expr_types::<V>(&mut **fx, unit, v, f - 1),
            ExprKind::Match(ma) => { expr_types::<V>(&mut *ma.scrut, unit, v, f - 1); let na: usize = ma.arms.len(); for m in 0..na invariant ma.arms.len() == na, { expr_types::<V>(&mut ma.arms[m].body, unit, v, f - 1); } },
            ExprKind::Return(rv) => opt_box_types::<V>(rv, unit, v, f - 1),
            ExprKind::Try(tr) => expr_types::<V>(&mut **tr, unit, v, f - 1),
            ExprKind::Loop(lp) => { exprs_types::<V>(&mut lp.invariants, unit, v, f - 1); opt_box_types::<V>(&mut lp.measure, unit, v, f - 1); block_types::<V>(&mut lp.body, unit, v, f - 1); stmt_types::<V>(&mut lp.body, unit, v, 1000000000); },
            ExprKind::Break(bk) => opt_box_types::<V>(&mut bk.value, unit, v, f - 1),
            ExprKind::Continue(co) => {},
            ExprKind::Range(rg) => { expr_types::<V>(&mut *rg.lo, unit, v, f - 1); expr_types::<V>(&mut *rg.hi, unit, v, f - 1); },
            ExprKind::Error => {},
        }
    }

    #[summary("Expressions in order")]
    #[effects(alloc)]
    fn exprs_each<V: ExprFn>(xs: &mut Vec<Expr>, v: &mut V, deep: bool, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = xs.len();
        for i in 0..n
            invariant xs.len() == n,
        {
            expr_mut::<V>(&mut xs[i], v, deep, f - 1);
        }
    }

    #[summary("All expressions of the program (executable and specification), innermost first")]
    #[effects(alloc)]
    fn exprs_mut<V: ExprFn>(p: &mut Program, v: &mut V) -> () {
        let n: usize = p.mods.len();
        for i in 0..n
            invariant p.mods.len() == n,
        {
            mod_exprs::<V>(&mut p.mods[i], v, 1000000000);
        }
    }

    #[effects(alloc)]
    fn exprs_types<V: TypeFn>(xs: &mut Vec<Expr>, unit: &str, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = xs.len();
        for i in 0..n
            invariant xs.len() == n,
        {
            expr_types::<V>(&mut xs[i], unit, v, f - 1);
        }
    }

    #[summary("Contract, measure and body of one function")]
    #[effects(alloc)]
    fn fn_exprs_mut<V: ExprFn>(d: &mut FnDef, v: &mut V, deep: bool, f: usize) -> () {
        exprs_each::<V>(&mut d.pre, v, deep, f);
        exprs_each::<V>(&mut d.post, v, deep, f);
        opt_mut::<V>(&mut d.measure, v, deep, f);
        block_mut::<V>(&mut d.body, v, deep, f);
    }

    #[summary("Types written in one function: parameters, result, lets of the body (of that block and of while, for and proof bodies), and, walking expressions innermost first, lets of blocks, loop and if, type arguments of calls, variables of quantifiers")]
    #[effects(alloc)]
    fn fn_types_mut<V: TypeFn>(d: &mut FnDef, unit: &str, v: &mut V) -> () {
        let n: usize = d.params.len();
        for i in 0..n
            invariant d.params.len() == n,
        {
            v.ty(unit, &mut d.params[i].ty);
        }
        v.ty(unit, &mut d.ret.ty);
        stmt_types::<V>(&mut d.body, unit, v, 1000000000);
        exprs_types::<V>(&mut d.pre, unit, v, 1000000000);
        exprs_types::<V>(&mut d.post, unit, v, 1000000000);
        opt_types::<V>(&mut d.measure, unit, v, 1000000000);
        block_types::<V>(&mut d.body, unit, v, 1000000000);
    }

    #[summary("Functions in order")]
    #[effects(alloc)]
    fn fns_each<V: ExprFn>(fs: &mut Vec<FnDef>, v: &mut V, f: usize) -> () {
        let n: usize = fs.len();
        for i in 0..n
            invariant fs.len() == n,
        {
            fn_exprs_mut::<V>(&mut fs[i], v, true, f);
        }
    }

    #[effects(alloc)]
    fn fns_types<V: TypeFn>(fs: &mut Vec<FnDef>, unit: &str, v: &mut V) -> () {
        let n: usize = fs.len();
        for i in 0..n
            invariant fs.len() == n,
        {
            fn_types_mut::<V>(&mut fs[i], unit, v);
        }
    }

    #[effects(alloc)]
    fn impl_fns_each<V: ExprFn>(is: &mut Vec<Impl>, v: &mut V) -> () {
        let n: usize = is.len();
        for i in 0..n
            invariant is.len() == n,
        {
            fns_each::<V>(&mut is[i].fns, v, 1000000000);
        }
    }

    #[effects(alloc)]
    fn impl_fns_types<V: TypeFn>(is: &mut Vec<Impl>, unit: &str, v: &mut V) -> () {
        let n: usize = is.len();
        for i in 0..n
            invariant is.len() == n,
        {
            fns_types::<V>(&mut is[i].fns, unit, v);
        }
    }

    #[effects(alloc)]
    fn impl_heads_types<V: TypeFn>(is: &mut Vec<Impl>, unit: &str, v: &mut V) -> () {
        let n: usize = is.len();
        for i in 0..n
            invariant is.len() == n,
        {
            types_each::<V>(&mut is[i].ty_args, unit, v);
        }
    }

    #[summary("Integer type the name refers to")]
    #[effects(pure)]
    fn int_of(s: &str) -> Option<IntTy> {
        if s == "i8" {
            return Some(IntTy::I8);
        }
        if s == "i16" {
            return Some(IntTy::I16);
        }
        if s == "i32" {
            return Some(IntTy::I32);
        }
        if s == "i64" {
            return Some(IntTy::I64);
        }
        if s == "isize" {
            return Some(IntTy::Isize);
        }
        if s == "u8" {
            return Some(IntTy::U8);
        }
        if s == "u16" {
            return Some(IntTy::U16);
        }
        if s == "u32" {
            return Some(IntTy::U32);
        }
        if s == "u64" {
            return Some(IntTy::U64);
        }
        if s == "usize" {
            return Some(IntTy::Usize);
        }
        None
    }

    #[summary("Whether it is &mut T")]
    #[effects(pure)]
    fn is_ref_mut(t: &TypeKind) -> bool {
        match t {
            TypeKind::Int(it) => false,
            TypeKind::F64 => false,
            TypeKind::Bool => false,
            TypeKind::Unit => false,
            TypeKind::Char => false,
            TypeKind::String => false,
            TypeKind::Str => false,
            TypeKind::Array(ae, an) => false,
            TypeKind::ArrayN(ne, nn) => false,
            TypeKind::Slice(se) => false,
            TypeKind::Ref(rm, ri) => *rm,
            TypeKind::Named(path, args) => false,
            TypeKind::Vec(ve) => false,
            TypeKind::Box(be) => false,
            TypeKind::Param(pn) => false,
            TypeKind::Never => false,
            TypeKind::Error => false,
        }
    }

    #[summary("Whether it is &str")]
    #[effects(pure)]
    fn is_ref_str(t: &TypeKind) -> bool {
        match t {
            TypeKind::Int(it) => false,
            TypeKind::F64 => false,
            TypeKind::Bool => false,
            TypeKind::Unit => false,
            TypeKind::Char => false,
            TypeKind::String => false,
            TypeKind::Str => false,
            TypeKind::Array(ae, an) => false,
            TypeKind::ArrayN(ne, nn) => false,
            TypeKind::Slice(se) => false,
            TypeKind::Ref(rm, ri) => is_str(&ri.kind),
            TypeKind::Named(path, args) => false,
            TypeKind::Vec(ve) => false,
            TypeKind::Box(be) => false,
            TypeKind::Param(pn) => false,
            TypeKind::Never => false,
            TypeKind::Error => false,
        }
    }

    #[summary("Whether it is str")]
    #[effects(pure)]
    fn is_str(t: &TypeKind) -> bool {
        match t {
            TypeKind::Int(it) => false,
            TypeKind::F64 => false,
            TypeKind::Bool => false,
            TypeKind::Unit => false,
            TypeKind::Char => false,
            TypeKind::String => false,
            TypeKind::Str => true,
            TypeKind::Array(ae, an) => false,
            TypeKind::ArrayN(ne, nn) => false,
            TypeKind::Slice(se) => false,
            TypeKind::Ref(rm, ri) => false,
            TypeKind::Named(path, args) => false,
            TypeKind::Vec(ve) => false,
            TypeKind::Box(be) => false,
            TypeKind::Param(pn) => false,
            TypeKind::Never => false,
            TypeKind::Error => false,
        }
    }

    #[summary("Text of the segments joined with ::")]
    #[effects(alloc)]
    fn join_names(s: &[String]) -> String {
        let mut out: String = String::new();
        for i in 0..s.len() {
            if i > 0 {
                out.push_str("::");
            }
            out.push_str(s[i].as_str());
        }
        out
    }

    #[summary("Const initializers of a unit and its inner units")]
    #[effects(alloc)]
    fn mod_consts<V: ExprFn>(m: &mut Mod, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = m.mods.len();
        for i in 0..n
            invariant m.mods.len() == n,
        {
            mod_consts::<V>(&mut m.mods[i], v, f - 1);
        }
        let nc: usize = m.consts.len();
        for j in 0..nc
            invariant m.consts.len() == nc,
        {
            expr_mut::<V>(&mut m.consts[j].value, v, true, 1000000000);
        }
    }

    #[summary("Functions of a unit: inner units first, then free functions, impls, trait declarations, trait impls, in that order (stage0 fns_mut)")]
    #[effects(alloc)]
    fn mod_exprs<V: ExprFn>(m: &mut Mod, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = m.mods.len();
        for i in 0..n
            invariant m.mods.len() == n,
        {
            mod_exprs::<V>(&mut m.mods[i], v, f - 1);
        }
        fns_each::<V>(&mut m.fns, v, 1000000000);
        impl_fns_each::<V>(&mut m.impls, v);
        trait_fns_each::<V>(&mut m.traits, v);
        trait_impl_fns_each::<V>(&mut m.trait_impls, v);
    }

    #[effects(alloc)]
    fn mod_types<V: TypeFn>(m: &mut Mod, prefix: &str, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mut unit: String = String::from(prefix);
        unit.push_str(m.name.name.as_str());
        consts_types::<V>(&mut m.consts, unit.as_str(), v);
        typedefs_types::<V>(&mut m.types, unit.as_str(), v);
        impl_heads_types::<V>(&mut m.impls, unit.as_str(), v);
        trait_impl_heads_types::<V>(&mut m.trait_impls, unit.as_str(), v);
        fns_types::<V>(&mut m.fns, unit.as_str(), v);
        impl_fns_types::<V>(&mut m.impls, unit.as_str(), v);
        trait_fns_types::<V>(&mut m.traits, unit.as_str(), v);
        trait_impl_fns_types::<V>(&mut m.trait_impls, unit.as_str(), v);
        let mut sub: String = unit.clone();
        sub.push_str("::");
        let nm: usize = m.mods.len();
        for j in 0..nm
            invariant m.mods.len() == nm,
        {
            mod_types::<V>(&mut m.mods[j], sub.as_str(), v, f - 1);
        }
    }

    #[summary("Whether it is a type written as the single name t without type arguments")]
    #[effects(pure)]
    fn named_is(k: &TypeKind, t: &str) -> bool {
        match k {
            TypeKind::Int(it) => false,
            TypeKind::F64 => false,
            TypeKind::Bool => false,
            TypeKind::Unit => false,
            TypeKind::Char => false,
            TypeKind::String => false,
            TypeKind::Str => false,
            TypeKind::Array(ae, an) => false,
            TypeKind::ArrayN(ne, nn) => false,
            TypeKind::Slice(se) => false,
            TypeKind::Ref(rm, ri) => false,
            TypeKind::Named(path, args) => args.len() == 0 && path.len() == 1 && path[0].as_str() == t,
            TypeKind::Vec(ve) => false,
            TypeKind::Box(be) => false,
            TypeKind::Param(pn) => false,
            TypeKind::Never => false,
            TypeKind::Error => false,
        }
    }

    #[summary("If a type written by name, the text of its path joined with ::")]
    #[effects(alloc)]
    fn named_join(t: &TypeKind) -> Option<String> {
        match t {
            TypeKind::Int(it) => None,
            TypeKind::F64 => None,
            TypeKind::Bool => None,
            TypeKind::Unit => None,
            TypeKind::Char => None,
            TypeKind::String => None,
            TypeKind::Str => None,
            TypeKind::Array(ae, an) => None,
            TypeKind::ArrayN(ne, nn) => None,
            TypeKind::Slice(se) => None,
            TypeKind::Ref(rm, ri) => None,
            TypeKind::Named(path, args) => Some(join_names(path.as_slice())),
            TypeKind::Vec(ve) => None,
            TypeKind::Box(be) => None,
            TypeKind::Param(pn) => None,
            TypeKind::Never => None,
            TypeKind::Error => None,
        }
    }

    #[summary("The expression, if there is one")]
    #[effects(alloc)]
    fn opt_box_mut<V: ExprFn>(o: &mut Option<Box<Expr>>, v: &mut V, deep: bool, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match o {
            None => {},
            Some(x) => expr_mut::<V>(&mut **x, v, deep, f - 1),
        }
    }

    #[effects(alloc)]
    fn opt_box_types<V: TypeFn>(o: &mut Option<Box<Expr>>, unit: &str, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match o {
            None => {},
            Some(x) => expr_types::<V>(&mut **x, unit, v, f - 1),
        }
    }

    #[summary("The expression, if there is one")]
    #[effects(alloc)]
    fn opt_mut<V: ExprFn>(o: &mut Option<Expr>, v: &mut V, deep: bool, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match o {
            None => {},
            Some(x) => expr_mut::<V>(x, v, deep, f - 1),
        }
    }

    #[effects(alloc)]
    fn opt_types<V: TypeFn>(o: &mut Option<Expr>, unit: &str, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match o {
            None => {},
            Some(x) => expr_types::<V>(x, unit, v, f - 1),
        }
    }

    #[summary("Appends the text of a binary operator")]
    #[effects(alloc)]
    fn push_bin_symbol(out: &mut String, op: &BinOp) -> () {
        match op {
            BinOp::Add => out.push_str("+"),
            BinOp::Sub => out.push_str("-"),
            BinOp::Mul => out.push_str("*"),
            BinOp::Div => out.push_str("/"),
            BinOp::Rem => out.push_str("%"),
            BinOp::Eq => out.push_str("=="),
            BinOp::Ne => out.push_str("!="),
            BinOp::Lt => out.push_str("<"),
            BinOp::Le => out.push_str("<="),
            BinOp::Gt => out.push_str(">"),
            BinOp::Ge => out.push_str(">="),
            BinOp::And => out.push_str("&&"),
            BinOp::Or => out.push_str("||"),
            BinOp::Implies => out.push_str("==>"),
            BinOp::BitAnd => out.push_str("&"),
            BinOp::BitOr => out.push_str("|"),
            BinOp::BitXor => out.push_str("^"),
            BinOp::Shl => out.push_str("<<"),
            BinOp::Shr => out.push_str(">>"),
        }
    }

    #[summary("Appends the name of an integer type")]
    #[effects(alloc)]
    fn push_int_name(out: &mut String, t: &IntTy) -> () {
        match t {
            IntTy::I8 => out.push_str("i8"),
            IntTy::I16 => out.push_str("i16"),
            IntTy::I32 => out.push_str("i32"),
            IntTy::I64 => out.push_str("i64"),
            IntTy::Isize => out.push_str("isize"),
            IntTy::U8 => out.push_str("u8"),
            IntTy::U16 => out.push_str("u16"),
            IntTy::U32 => out.push_str("u32"),
            IntTy::U64 => out.push_str("u64"),
            IntTy::Usize => out.push_str("usize"),
        }
    }

    #[summary("Text of v written in the normal form of radix r: prefix, lowercase digits, no _ separators, no leading zeros (ADR-0019 §1)")]
    #[effects(alloc)]
    #[uses(wide::divisor)]
    fn radix_text(r: Radix, v: wide::U128) -> String {
        let mut out: String = String::new();
        match r {
            Radix::Dec => wide::push_radix(&mut out, v, 10),
            Radix::Hex => { out.push_str("0x"); wide::push_radix(&mut out, v, 16); },
            Radix::Oct => { out.push_str("0o"); wide::push_radix(&mut out, v, 8); },
            Radix::Bin => { out.push_str("0b"); wide::push_radix(&mut out, v, 2); },
        }
        out
    }

    #[summary("Whether it is a reference to a type that is named_is")]
    #[effects(pure)]
    fn ref_named_is(k: &TypeKind, t: &str) -> bool {
        match k {
            TypeKind::Int(it) => false,
            TypeKind::F64 => false,
            TypeKind::Bool => false,
            TypeKind::Unit => false,
            TypeKind::Char => false,
            TypeKind::String => false,
            TypeKind::Str => false,
            TypeKind::Array(ae, an) => false,
            TypeKind::ArrayN(ne, nn) => false,
            TypeKind::Slice(se) => false,
            TypeKind::Ref(rm, ri) => named_is(&ri.kind, t),
            TypeKind::Named(path, args) => false,
            TypeKind::Vec(ve) => false,
            TypeKind::Box(be) => false,
            TypeKind::Param(pn) => false,
            TypeKind::Never => false,
            TypeKind::Error => false,
        }
    }

    #[summary("Types of the lets of a block: those of that block and of while, for and proof bodies")]
    #[effects(alloc)]
    fn stmt_types<V: TypeFn>(b: &mut Block, unit: &str, v: &mut V, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = b.stmts.len();
        for i in 0..n
            invariant b.stmts.len() == n,
        {
            match &mut b.stmts[i] {
                Stmt::Let(sl) => v.ty(unit, &mut sl.ty),
                Stmt::Assign(sa) => {},
                Stmt::While(sw) => stmt_types::<V>(&mut sw.body, unit, v, f - 1),
                Stmt::For(sf) => stmt_types::<V>(&mut sf.body, unit, v, f - 1),
                Stmt::Assert(st) => {},
                Stmt::Assume(su) => {},
                Stmt::Proof(sp) => stmt_types::<V>(&mut sp.body, unit, v, f - 1),
                Stmt::LetFields(lf) => {},
                Stmt::Expr(se) => {},
            }
        }
    }

    #[summary("Ordinal of the expression kind (declaration order): 0 Int .. 34 Error")]
    #[effects(pure)]
    fn tag(k: &ExprKind) -> u8 {
        match k {
            ExprKind::Int(iv, ir) => 0,
            ExprKind::Float(fb) => 1,
            ExprKind::ByteLit(by) => 2,
            ExprKind::ByteStr(bys) => 3,
            ExprKind::StrLit(st) => 4,
            ExprKind::CharLit(ch) => 5,
            ExprKind::Bool(bo) => 6,
            ExprKind::Unit => 7,
            ExprKind::Var(id) => 8,
            ExprKind::Call(ca) => 9,
            ExprKind::Method(me) => 10,
            ExprKind::Index(ib, ii) => 11,
            ExprKind::Unary(uo, ux) => 12,
            ExprKind::Binary(bop, bl, br) => 13,
            ExprKind::Ref(rm, rx) => 14,
            ExprKind::If(ife) => 15,
            ExprKind::Block(blk) => 16,
            ExprKind::Array(ar) => 17,
            ExprKind::Repeat(rp) => 18,
            ExprKind::Old(ox) => 19,
            ExprKind::Quant(qu) => 20,
            ExprKind::Trigger(tx) => 21,
            ExprKind::Closure(cl) => 22,
            ExprKind::StructLit(sl) => 23,
            ExprKind::Path(pa) => 24,
            ExprKind::Deref(dx) => 25,
            ExprKind::Field(fx, fnm) => 26,
            ExprKind::Match(ma) => 27,
            ExprKind::Return(rv) => 28,
            ExprKind::Try(tr) => 29,
            ExprKind::Loop(lp) => 30,
            ExprKind::Break(bk) => 31,
            ExprKind::Continue(co) => 32,
            ExprKind::Range(rg) => 33,
            ExprKind::Error => 34,
        }
    }

    #[effects(alloc)]
    fn trait_fns_each<V: ExprFn>(ts: &mut Vec<TraitDef>, v: &mut V) -> () {
        let n: usize = ts.len();
        for i in 0..n
            invariant ts.len() == n,
        {
            let nf: usize = ts[i].fns.len();
            for q in 0..nf
                invariant ts.len() == n && ts[i].fns.len() == nf,
            {
                fn_exprs_mut::<V>(&mut ts[i].fns[q].f, v, true, 1000000000);
            }
        }
    }

    #[effects(alloc)]
    fn trait_fns_types<V: TypeFn>(ts: &mut Vec<TraitDef>, unit: &str, v: &mut V) -> () {
        let n: usize = ts.len();
        for i in 0..n
            invariant ts.len() == n,
        {
            let nf: usize = ts[i].fns.len();
            for q in 0..nf
                invariant ts.len() == n && ts[i].fns.len() == nf,
            {
                fn_types_mut::<V>(&mut ts[i].fns[q].f, unit, v);
            }
        }
    }

    #[effects(alloc)]
    fn trait_impl_fns_each<V: ExprFn>(is: &mut Vec<TraitImpl>, v: &mut V) -> () {
        let n: usize = is.len();
        for i in 0..n
            invariant is.len() == n,
        {
            fns_each::<V>(&mut is[i].fns, v, 1000000000);
        }
    }

    #[effects(alloc)]
    fn trait_impl_fns_types<V: TypeFn>(is: &mut Vec<TraitImpl>, unit: &str, v: &mut V) -> () {
        let n: usize = is.len();
        for i in 0..n
            invariant is.len() == n,
        {
            fns_types::<V>(&mut is[i].fns, unit, v);
        }
    }

    #[effects(alloc)]
    fn trait_impl_heads_types<V: TypeFn>(is: &mut Vec<TraitImpl>, unit: &str, v: &mut V) -> () {
        let n: usize = is.len();
        for i in 0..n
            invariant is.len() == n,
        {
            v.ty(unit, &mut is[i].self_ty);
        }
    }

    #[effects(alloc)]
    fn typedef_types<V: TypeFn>(k: &mut TypeDefKind, unit: &str, v: &mut V) -> () {
        match k {
            TypeDefKind::Struct(fs) => { let n: usize = fs.len(); for i in 0..n invariant fs.len() == n, { v.ty(unit, &mut fs[i].ty); } },
            TypeDefKind::Enum(vs) => { let nv: usize = vs.len(); for j in 0..nv invariant vs.len() == nv, { types_each::<V>(&mut vs[j].payload, unit, v); } },
        }
    }

    #[effects(alloc)]
    fn typedefs_types<V: TypeFn>(ts: &mut Vec<TypeDef>, unit: &str, v: &mut V) -> () {
        let n: usize = ts.len();
        for i in 0..n
            invariant ts.len() == n,
        {
            typedef_types::<V>(&mut ts[i].kind, unit, v);
        }
    }

    #[effects(alloc)]
    fn types_each<V: TypeFn>(ts: &mut Vec<Type>, unit: &str, v: &mut V) -> () {
        let n: usize = ts.len();
        for i in 0..n
            invariant ts.len() == n,
        {
            v.ty(unit, &mut ts[i]);
        }
    }

    #[summary("All types written in the program (parameters, results, lets, fields, payloads, impl heads, type arguments, variables of quantifiers, consts) together with the path of the unit that wrote them, outer ones only: the visitor sees inner types through the outer one. The unit first, inner units next")]
    #[effects(alloc)]
    fn unit_types_mut<V: TypeFn>(p: &mut Program, v: &mut V) -> () {
        let n: usize = p.mods.len();
        for i in 0..n
            invariant p.mods.len() == n,
        {
            mod_types::<V>(&mut p.mods[i], "", v, 1000000000);
        }
    }

    #[summary("If a variable read, its name")]
    #[effects(alloc)]
    fn var_name(e: &Expr) -> Option<String> {
        match &e.kind {
            ExprKind::Int(iv, ir) => None,
            ExprKind::Float(fb) => None,
            ExprKind::ByteLit(by) => None,
            ExprKind::ByteStr(bys) => None,
            ExprKind::StrLit(st) => None,
            ExprKind::CharLit(ch) => None,
            ExprKind::Bool(bo) => None,
            ExprKind::Unit => None,
            ExprKind::Var(id) => Some(id.name.clone()),
            ExprKind::Call(ca) => None,
            ExprKind::Method(me) => None,
            ExprKind::Index(ib, ii) => None,
            ExprKind::Unary(uo, ux) => None,
            ExprKind::Binary(bop, bl, br) => None,
            ExprKind::Ref(rm, rx) => None,
            ExprKind::If(ife) => None,
            ExprKind::Block(blk) => None,
            ExprKind::Array(ar) => None,
            ExprKind::Repeat(rp) => None,
            ExprKind::Old(ox) => None,
            ExprKind::Quant(qu) => None,
            ExprKind::Trigger(tx) => None,
            ExprKind::Closure(cl) => None,
            ExprKind::StructLit(sl) => None,
            ExprKind::Path(pa) => None,
            ExprKind::Deref(dx) => None,
            ExprKind::Field(fx, fnm) => None,
            ExprKind::Match(ma) => None,
            ExprKind::Return(rv) => None,
            ExprKind::Try(tr) => None,
            ExprKind::Loop(lp) => None,
            ExprKind::Break(bk) => None,
            ExprKind::Continue(co) => None,
            ExprKind::Range(rg) => None,
            ExprKind::Error => None,
        }
    }
}
