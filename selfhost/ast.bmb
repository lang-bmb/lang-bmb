#[summary("구문 트리 (stage0 compiler/src/ast.rs의 포트, 백로그 4D-02). 식의 순회(expr_mut 등)는 손님 trait ExprFn을 받고, 깊은 사본(clone_*)은 타입 선언에서 기계로 만든 것이다(사용자 타입에 clone이 없다)")]
mod ast {
    #[summary("식 하나를 받는 순회의 손님 (stage0의 &mut dyn FnMut(&mut Expr))")]
    trait ExprFn {
        #[effects(alloc)]
        fn expr(self: &mut Self, e: &mut Expr) -> ();
    }

    #[summary("메서드 호출이 수신자를 넘기는 방식 (ADR-0051)")]
    enum Adjust { Value, Ref, RefMut, AsStr }

    #[summary("match의 갈래 하나")]
    struct Arm { pat: Pat, body: Expr, span: source::Span }

    #[summary("assert(cond); 또는 assert(cond) by (bit_vector); (ADR-0048 §4)")]
    struct Assert { cond: Expr, by: Option<Prover>, span: source::Span }

    #[summary("x = e;")]
    struct Assign { target: Expr, value: Expr, span: source::Span }

    #[summary("assume(p(..)); (ADR-0029 §1). rationale은 그 앞의 #[rationale(..)]")]
    struct Assume { cond: Expr, rationale: Option<Attr>, span: source::Span }

    struct Attr { name: Ident, args: Vec<AttrArg>, span: source::Span }

    #[summary("속성의 인자: 이름, 문자열, key = value")]
    enum AttrArg { Ident(Ident), Str(String, source::Span), Pair(Ident, Box<AttrArg>) }

    enum BinOp { Add, Sub, Mul, Div, Rem, Eq, Ne, Lt, Le, Gt, Ge, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr }

    struct Block { stmts: Vec<Stmt>, tail: Option<Box<Expr>>, span: source::Span }

    #[summary("break, break 'l, break e")]
    struct Break { label: Option<Ident>, value: Option<Box<Expr>> }

    #[summary("경로로 부르는 호출 f(..), a::b::f(..). targs는 경로에 쓴 타입 인자, method는 x.f(..)로 썼을 때 수신자를 넘긴 방식")]
    struct Call { path: Vec<Ident>, targs: Vec<TArgs>, args: Vec<Expr>, method: Option<Adjust> }

    #[summary("클로저 식 (ADR-0053 §1, §2)")]
    struct Closure { is_move: bool, params: Vec<Param>, ret: Ret, pre: Vec<Expr>, post: Vec<Expr>, body: Block, span: source::Span }

    #[summary("const NAME: T = e; (ADR-0052)")]
    struct ConstDef { attrs: Vec<Attr>, name: Ident, ty: Type, value: Expr, span: source::Span }

    struct Expr { kind: ExprKind, span: source::Span }

    enum ExprKind { Int(wide::U128, Radix), Float(u64), ByteLit(u8), ByteStr(Vec<u8>), StrLit(String), CharLit(u32), Bool(bool), Unit, Var(Ident), Call(Call), Method(Method), Index(Box<Expr>, Box<Expr>), Unary(UnOp, Box<Expr>), Binary(BinOp, Box<Expr>, Box<Expr>), Ref(bool, Box<Expr>), If(If), Block(Block), Array(Vec<Expr>), Repeat(Repeat), Old(Box<Expr>), Quant(Quant), Trigger(Box<Expr>), Closure(Box<Closure>), StructLit(StructLit), Path(Vec<Ident>), Deref(Box<Expr>), Field(Box<Expr>, Ident), Match(Match), Return(Option<Box<Expr>>), Try(Box<Expr>), Loop(Loop), Break(Break), Continue(Option<Ident>), Range(Range), Error }

    struct Field { name: Ident, ty: Type }

    #[summary("구조체 식의 필드 하나")]
    struct FieldInit { name: Ident, value: Expr }

    #[summary("Fn(A, B) -> R: 매개변수 타입들과 결과 (-> 가 없으면 ())")]
    struct FnBound { kind: FnTrait, params: Vec<Type>, ret: Type, span: source::Span }

    struct FnDef { kind: FnKind, name: Ident, generics: Vec<TypeParam>, attrs: Vec<Attr>, params: Vec<Param>, ret: Ret, pre: Vec<Expr>, post: Vec<Expr>, measure: Option<Expr>, body: Block, span: source::Span }

    enum FnKind { Exec, Spec, Proof }

    enum FnTrait { Fn, FnMut, FnOnce }

    #[summary("'l: for i in lo..hi invariant .., { .. } (ADR-0049 §2)")]
    struct For { label: Option<Ident>, var: Ident, lo: Expr, hi: Expr, inclusive: bool, invariants: Vec<Expr>, body: Block, span: source::Span }

    struct Ident { name: String, span: source::Span }

    struct If { cond: Box<Expr>, then: Block, els: Option<Box<Expr>> }

    #[summary("impl T { fn .. }")]
    struct Impl { generics: Vec<TypeParam>, ty: Ident, ty_args: Vec<Type>, fns: Vec<FnDef>, span: source::Span }

    enum IntTy { I8, I16, I32, I64, Isize, U8, U16, U32, U64, Usize }

    #[summary("const의 이름으로 쓴 반복 횟수 (ADR-0052 §4): 횟수의 자리와 이름")]
    struct Len { at: source::Span, path: Vec<Ident> }

    struct Let { mutable: bool, name: Ident, ty: Type, ty_missing: bool, init: Expr, span: source::Span }

    #[summary("let Point { x, y } = p; (Rust 습관, E0230)")]
    struct LetFields { path: Vec<Ident>, fields: Vec<Ident>, init: Expr, span: source::Span }

    #[summary("'l: loop invariant .., decreases .., { .. } (ADR-0049 §1)")]
    struct Loop { label: Option<Ident>, invariants: Vec<Expr>, measure: Option<Box<Expr>>, body: Block }

    struct Match { scrut: Box<Expr>, arms: Vec<Arm> }

    #[summary("내장 메서드 호출 a.len(), x.wrapping_add(y)")]
    struct Method { recv: Box<Expr>, name: Ident, args: Vec<Expr> }

    struct Mod { name: Ident, attrs: Vec<Attr>, fns: Vec<FnDef>, mods: Vec<Mod>, types: Vec<TypeDef>, impls: Vec<Impl>, traits: Vec<TraitDef>, trait_impls: Vec<TraitImpl>, uses: Vec<UseItem>, consts: Vec<ConstDef>, lens: Vec<Len>, span: source::Span }

    struct Param { name: Ident, ty: Type }

    #[summary("변형 패턴 Shape::Rect(a, _), Some(x), None. 페이로드 자리마다 새 이름이거나 _ (None)")]
    struct Pat { path: Vec<Ident>, binds: Vec<Option<Ident>>, parens: bool, origin: PatOrigin, span: source::Span }

    #[summary("패턴이 온 곳. Written만 소스가 쓴 것이다")]
    enum PatOrigin { Written, IfLetElse, Rejected }

    struct Program { mods: Vec<Mod> }

    #[summary("proof { .. } (ADR-0062 §1)")]
    struct ProofBlock { body: Block, span: source::Span }

    #[summary("assert(e) by (..)의 증명기 (ADR-0048 §4)")]
    enum Prover { BitVector }

    struct Quant { q: Quantifier, binders: Vec<Param>, body: Box<Expr> }

    enum Quantifier { Forall, Exists }

    #[summary("정수 리터럴을 쓴 진법 (ADR-0048 §3). 정규형이 지킨다: 0xff는 0xff로 남는다")]
    enum Radix { Dec, Hex, Oct, Bin }

    #[summary("lo..hi. inclusive는 lo..=hi로 쓴 것")]
    struct Range { lo: Box<Expr>, hi: Box<Expr>, inclusive: bool }

    #[summary("[v; N]")]
    struct Repeat { value: Box<Expr>, count: wide::U128, count_span: source::Span }

    struct Ret { name: Option<Ident>, ty: Type }

    enum Stmt { Let(Let), Assign(Assign), While(While), For(For), Assert(Assert), Assume(Assume), Proof(ProofBlock), LetFields(LetFields), Expr(Expr) }

    #[summary("Point { x: e, y: e } (ADR-0026 §3). rest는 ..base (E0223)")]
    struct StructLit { path: Vec<Ident>, fields: Vec<FieldInit>, rest: Option<Box<Expr>> }

    #[summary("호출 경로의 마디 seg 뒤에 쓴 타입 인자 (ADR-0046 §3)")]
    struct TArgs { seg: usize, args: Vec<Type>, span: source::Span }

    struct TraitDef { name: Ident, attrs: Vec<Attr>, fns: Vec<TraitFn>, span: source::Span }

    #[summary("trait의 메서드: 시그니처, 그리고 기본 몸을 썼는지")]
    struct TraitFn { f: FnDef, has_body: bool }

    #[summary("impl<T: Copy> geo::Shape for Wrap<T> { .. } (ADR-0046 §2)")]
    struct TraitImpl { generics: Vec<TypeParam>, trait_path: Vec<Ident>, self_ty: Type, fns: Vec<FnDef>, span: source::Span }

    struct Type { kind: TypeKind, span: source::Span }

    struct TypeDef { name: Ident, generics: Vec<TypeParam>, attrs: Vec<Attr>, kind: TypeDefKind, span: source::Span }

    enum TypeDefKind { Struct(Vec<Field>), Enum(Vec<Variant>) }

    enum TypeKind { Int(IntTy), F64, Bool, Unit, Char, String, Str, Array(Box<Type>, u64), ArrayN(Box<Type>, Vec<String>), Slice(Box<Type>), Ref(bool, Box<Type>), Named(Vec<String>, Vec<Type>), Vec(Box<Type>), Box(Box<Type>), Param(String), Never, Error }

    #[summary("타입 매개변수 T, T: Copy (ADR-0046 §1). fn_bound는 F: Fn(A, B) -> R")]
    struct TypeParam { name: Ident, bounds: Vec<Vec<Ident>>, fn_bound: Option<FnBound>, span: source::Span }

    enum UnOp { Neg, Not }

    #[summary("이름 하나를 들이는 use")]
    struct UseItem { path: Vec<Ident>, span: source::Span }

    struct Variant { name: Ident, payload: Vec<Type>, span: source::Span }

    struct While { label: Option<Ident>, cond: Expr, invariants: Vec<Expr>, measure: Option<Expr>, body: Block, span: source::Span }

    #[summary("src의 원소들을 차례 그대로 dst의 뒤로 옮긴다")]
    #[effects(alloc)]
    fn append<T>(dst: &mut Vec<T>, src: Vec<T>) -> () {
        let mut rest: Vec<T> = src;
        let mut flipped: Vec<T> = Vec::new();
        let mut n: usize = rest.len();
        while n > 0
            decreases n,
        {
            n = n - 1;
            match rest.pop() {
                None => {},
                Some(m) => flipped.push(m),
            }
        }
        let mut j: usize = flipped.len();
        while j > 0
            decreases j,
        {
            j = j - 1;
            match flipped.pop() {
                None => {},
                Some(m2) => dst.push(m2),
            }
        }
    }

    #[summary("블록의 모든 식을 안쪽부터. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn block_mut<V: ExprFn>(b: &mut Block, v: &mut V, deep: bool, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let n: usize = b.stmts.len();
        for i in 0..n
            invariant b.stmts.len() == n,
        {
            match &mut b.stmts[i] {
                Stmt::Let(sl) => expr_mut::<V>(&mut sl.init, v, deep, f - 1),
                Stmt::Assign(sa) => { expr_mut::<V>(&mut sa.target, v, deep, f - 1); expr_mut::<V>(&mut sa.value, v, deep, f - 1); },
                Stmt::While(sw) => { expr_mut::<V>(&mut sw.cond, v, deep, f - 1); exprs_each::<V>(&mut sw.invariants, v, deep, f - 1); opt_mut::<V>(&mut sw.measure, v, deep, f - 1); block_mut::<V>(&mut sw.body, v, deep, f - 1); },
                Stmt::For(sf) => { expr_mut::<V>(&mut sf.lo, v, deep, f - 1); expr_mut::<V>(&mut sf.hi, v, deep, f - 1); exprs_each::<V>(&mut sf.invariants, v, deep, f - 1); block_mut::<V>(&mut sf.body, v, deep, f - 1); },
                Stmt::Assert(st) => expr_mut::<V>(&mut st.cond, v, deep, f - 1),
                Stmt::Assume(su) => expr_mut::<V>(&mut su.cond, v, deep, f - 1),
                Stmt::Proof(sp) => block_mut::<V>(&mut sp.body, v, deep, f - 1),
                Stmt::LetFields(lf) => expr_mut::<V>(&mut lf.init, v, deep, f - 1),
                Stmt::Expr(se) => expr_mut::<V>(se, v, deep, f - 1),
            }
        }
        opt_box_mut::<V>(&mut b.tail, v, deep, f - 1);
    }

    #[summary("Arm의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_arm(x: &Arm, f: usize) -> Arm
        decreases f * 64 + 5,
    {
        Arm { pat: clone_pat(&x.pat, f), body: clone_expr(&x.body, f), span: x.span }
    }

    #[summary("Assert의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_assert(x: &Assert, f: usize) -> Assert
        decreases f * 64 + 2,
    {
        Assert { cond: clone_expr(&x.cond, f), by: clone_option_prover(&x.by, f), span: x.span }
    }

    #[summary("Assign의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_assign(x: &Assign, f: usize) -> Assign
        decreases f * 64 + 1,
    {
        Assign { target: clone_expr(&x.target, f), value: clone_expr(&x.value, f), span: x.span }
    }

    #[summary("Assume의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_assume(x: &Assume, f: usize) -> Assume
        decreases f * 64 + 4,
    {
        Assume { cond: clone_expr(&x.cond, f), rationale: clone_option_attr(&x.rationale, f), span: x.span }
    }

    #[summary("Attr의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_attr(x: &Attr, f: usize) -> Attr
        decreases f * 64 + 2,
    {
        Attr { name: clone_ident(&x.name, f), args: clone_vec_attrarg(&x.args, f), span: x.span }
    }

    #[summary("AttrArg의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_attrarg(x: &AttrArg, f: usize) -> AttrArg
        decreases f * 64 + 0,
    {
        if f == 0 {
            return AttrArg::Str(String::new(), source::Span { file: 0, lo: 0, hi: 0 });
        }
        match x {
            AttrArg::Ident(p0_0) => AttrArg::Ident(clone_ident(p0_0, f - 1)),
            AttrArg::Str(p1_0, p1_1) => AttrArg::Str(p1_0.clone(), *p1_1),
            AttrArg::Pair(p2_0, p2_1) => AttrArg::Pair(clone_ident(p2_0, f - 1), Box::new(clone_attrarg(&**p2_1, f - 1))),
        }
    }

    #[summary("Block의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_block(x: &Block, f: usize) -> Block
        decreases f * 64 + 0,
    {
        if f == 0 {
            return Block { stmts: Vec::new(), tail: None, span: x.span };
        }
        Block { stmts: clone_vec_stmt(&x.stmts, f - 1), tail: clone_option_box_expr(&x.tail, f - 1), span: x.span }
    }

    #[summary("Break의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_break(x: &Break, f: usize) -> Break
        decreases f * 64 + 3,
    {
        Break { label: clone_option_ident(&x.label, f), value: clone_option_box_expr(&x.value, f) }
    }

    #[summary("Call의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_call(x: &Call, f: usize) -> Call
        decreases f * 64 + 4,
    {
        Call { path: clone_vec_ident(&x.path, f), targs: clone_vec_targs(&x.targs, f), args: clone_vec_expr(&x.args, f), method: clone_option_adjust(&x.method, f) }
    }

    #[summary("Closure의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_closure(x: &Closure, f: usize) -> Closure
        decreases f * 64 + 4,
    {
        Closure { is_move: x.is_move, params: clone_vec_param(&x.params, f), ret: clone_ret(&x.ret, f), pre: clone_vec_expr(&x.pre, f), post: clone_vec_expr(&x.post, f), body: clone_block(&x.body, f), span: x.span }
    }

    #[summary("ConstDef의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_constdef(x: &ConstDef, f: usize) -> ConstDef
        decreases f * 64 + 4,
    {
        ConstDef { attrs: clone_vec_attr(&x.attrs, f), name: clone_ident(&x.name, f), ty: clone_type(&x.ty, f), value: clone_expr(&x.value, f), span: x.span }
    }

    #[summary("Expr의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_expr(x: &Expr, f: usize) -> Expr
        decreases f * 64 + 0,
    {
        if f == 0 {
            return Expr { kind: ExprKind::Error, span: x.span };
        }
        Expr { kind: clone_exprkind(&x.kind, f - 1), span: x.span }
    }

    #[summary("ExprKind의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_exprkind(x: &ExprKind, f: usize) -> ExprKind
        decreases f * 64 + 8,
    {
        match x {
            ExprKind::Int(p0_0, p0_1) => ExprKind::Int(*p0_0, *p0_1),
            ExprKind::Float(p1_0) => ExprKind::Float(*p1_0),
            ExprKind::ByteLit(p2_0) => ExprKind::ByteLit(*p2_0),
            ExprKind::ByteStr(p3_0) => ExprKind::ByteStr(clone_vec_u8(p3_0, f)),
            ExprKind::StrLit(p4_0) => ExprKind::StrLit(p4_0.clone()),
            ExprKind::CharLit(p5_0) => ExprKind::CharLit(*p5_0),
            ExprKind::Bool(p6_0) => ExprKind::Bool(*p6_0),
            ExprKind::Unit => ExprKind::Unit,
            ExprKind::Var(p8_0) => ExprKind::Var(clone_ident(p8_0, f)),
            ExprKind::Call(p9_0) => ExprKind::Call(clone_call(p9_0, f)),
            ExprKind::Method(p10_0) => ExprKind::Method(clone_method(p10_0, f)),
            ExprKind::Index(p11_0, p11_1) => ExprKind::Index(Box::new(clone_expr(&**p11_0, f)), Box::new(clone_expr(&**p11_1, f))),
            ExprKind::Unary(p12_0, p12_1) => ExprKind::Unary(*p12_0, Box::new(clone_expr(&**p12_1, f))),
            ExprKind::Binary(p13_0, p13_1, p13_2) => ExprKind::Binary(*p13_0, Box::new(clone_expr(&**p13_1, f)), Box::new(clone_expr(&**p13_2, f))),
            ExprKind::Ref(p14_0, p14_1) => ExprKind::Ref(*p14_0, Box::new(clone_expr(&**p14_1, f))),
            ExprKind::If(p15_0) => ExprKind::If(clone_if(p15_0, f)),
            ExprKind::Block(p16_0) => ExprKind::Block(clone_block(p16_0, f)),
            ExprKind::Array(p17_0) => ExprKind::Array(clone_vec_expr(p17_0, f)),
            ExprKind::Repeat(p18_0) => ExprKind::Repeat(clone_repeat(p18_0, f)),
            ExprKind::Old(p19_0) => ExprKind::Old(Box::new(clone_expr(&**p19_0, f))),
            ExprKind::Quant(p20_0) => ExprKind::Quant(clone_quant(p20_0, f)),
            ExprKind::Trigger(p21_0) => ExprKind::Trigger(Box::new(clone_expr(&**p21_0, f))),
            ExprKind::Closure(p22_0) => ExprKind::Closure(Box::new(clone_closure(&**p22_0, f))),
            ExprKind::StructLit(p23_0) => ExprKind::StructLit(clone_structlit(p23_0, f)),
            ExprKind::Path(p24_0) => ExprKind::Path(clone_vec_ident(p24_0, f)),
            ExprKind::Deref(p25_0) => ExprKind::Deref(Box::new(clone_expr(&**p25_0, f))),
            ExprKind::Field(p26_0, p26_1) => ExprKind::Field(Box::new(clone_expr(&**p26_0, f)), clone_ident(p26_1, f)),
            ExprKind::Match(p27_0) => ExprKind::Match(clone_match(p27_0, f)),
            ExprKind::Return(p28_0) => ExprKind::Return(clone_option_box_expr(p28_0, f)),
            ExprKind::Try(p29_0) => ExprKind::Try(Box::new(clone_expr(&**p29_0, f))),
            ExprKind::Loop(p30_0) => ExprKind::Loop(clone_loop(p30_0, f)),
            ExprKind::Break(p31_0) => ExprKind::Break(clone_break(p31_0, f)),
            ExprKind::Continue(p32_0) => ExprKind::Continue(clone_option_ident(p32_0, f)),
            ExprKind::Range(p33_0) => ExprKind::Range(clone_range(p33_0, f)),
            ExprKind::Error => ExprKind::Error,
        }
    }

    #[summary("Field의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_field(x: &Field, f: usize) -> Field
        decreases f * 64 + 2,
    {
        Field { name: clone_ident(&x.name, f), ty: clone_type(&x.ty, f) }
    }

    #[summary("FieldInit의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_fieldinit(x: &FieldInit, f: usize) -> FieldInit
        decreases f * 64 + 2,
    {
        FieldInit { name: clone_ident(&x.name, f), value: clone_expr(&x.value, f) }
    }

    #[summary("FnBound의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_fnbound(x: &FnBound, f: usize) -> FnBound
        decreases f * 64 + 2,
    {
        FnBound { kind: x.kind, params: clone_vec_type(&x.params, f), ret: clone_type(&x.ret, f), span: x.span }
    }

    #[summary("FnDef의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_fndef(x: &FnDef, f: usize) -> FnDef
        decreases f * 64 + 6,
    {
        FnDef { kind: x.kind, name: clone_ident(&x.name, f), generics: clone_vec_typeparam(&x.generics, f), attrs: clone_vec_attr(&x.attrs, f), params: clone_vec_param(&x.params, f), ret: clone_ret(&x.ret, f), pre: clone_vec_expr(&x.pre, f), post: clone_vec_expr(&x.post, f), measure: clone_option_expr(&x.measure, f), body: clone_block(&x.body, f), span: x.span }
    }

    #[summary("For의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_for(x: &For, f: usize) -> For
        decreases f * 64 + 3,
    {
        For { label: clone_option_ident(&x.label, f), var: clone_ident(&x.var, f), lo: clone_expr(&x.lo, f), hi: clone_expr(&x.hi, f), inclusive: x.inclusive, invariants: clone_vec_expr(&x.invariants, f), body: clone_block(&x.body, f), span: x.span }
    }

    #[summary("Ident의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_ident(x: &Ident, f: usize) -> Ident
        decreases f * 64 + 1,
    {
