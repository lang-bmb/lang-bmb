        for i in 0..x.len() {
            out.push(clone_stmt(&x[i], f));
        }
        out
    }

    #[summary("Vec<String>의 깊은 사본. f는 남은 깊이 (ADR-0140)")]
    #[effects(alloc)]
    fn clone_vec_string(x: &Vec<String>, f: usize) -> Vec<String>
        decreases f * 64 + 1,
    {
        let mut out: Vec<String> = Vec::new();
        for i in 0..x.len() {
            out.push(x[i].clone());
        }
        out
    }

