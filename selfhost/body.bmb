#[summary("검사기의 2패스: 몸을 검사한다 (stage0 compiler/src/check.rs의 check_mod부터의 포트, 백로그 4D-03e). 단위와 함수를 걷고, 매개변수와 계약의 자리를 보고, 이름을 범위에 넣고, 효과를 견주고, 문장과 자리, match·변형·구조체 리터럴을 본다. 식(expr)은 다음 조각이 채운다. f는 남은 깊이다 (ADR-0140)")]
mod body {
    #[summary("settle_lets가 고른 타입: 가장 앞 자리의 것")]
    struct Best { found: bool, lo: u32, ty: ast::TypeKind }

    #[summary("몸 검사의 표. c는 1패스가 모은 선언. types는 식마다의 타입(열쇠는 span_key), locals는 정의마다 이름의 타입, needs는 실행 정의마다 제 연산의 효과와 몸이 요구하는 효과")]
    struct Body { c: decls::Checker, consts: table::Table<consts::Const>, calls: table::Table<Vec<String>>, needs: table::Table<Needs>, external: Vec<String>, types: table::Table<ast::TypeKind>, open_lets: Vec<OpenLet>, typed_uses: Vec<TypedUse>, spec_at: Vec<source::Span>, locals: table::Table<table::Table<ast::TypeKind>>, const_reads: table::Table<Vec<String>>, spec_widen: bool }

    impl Body {
        #[summary("갈래의 패턴이 묶는 이름들의 타입: 변형 k의 페이로드 (참조를 match하면 그 참조). 자리 수가 어긋나면 E0427")]
        #[effects(alloc)]
        fn arm_binds(self: &mut Body, mp: &str, p: &ast::Pat, tp: &str, vs: &[types::VariantSig], k: usize, by_ref: bool, by_mut: bool) -> Vec<ast::TypeKind> {
            let mut tys: Vec<ast::TypeKind> = Vec::new();
            if k >= vs.len() {
                return tys;
            }
            let n: usize = vs[k].tys.len();
            let vt: String = variant_text(tp, vs[k].name.as_str(), mp);
            if n == 0 && p.parens {
                self.c.fixed("E0427", p.span, types::cat3("`", vt.as_str(), "` has no payload").as_str(), types::cat3("write `", vt.as_str(), "`").as_str(), vt.as_str());
            } else if p.binds.len() != n {
                let msg: String = decls::counts(types::cat3("`", vt.as_str(), "` holds ").as_str(), n, " value(s), the pattern names ", p.binds.len(), "");
                self.c.fixed("E0427", p.span, msg.as_str(), "one new name or `_` per payload position", types::cat4(vt.as_str(), "(", holes(n).as_str(), ")").as_str());
            }
            for i in 0..n
                invariant 0 <= i && i <= n && n == vs[k].tys.len(),
            {
                if by_ref {
                    tys.push(ast::TypeKind::Ref(by_mut, types::boxed(vs[k].tys[i].clone())));
                } else {
                    tys.push(vs[k].tys[i].clone());
                }
            }
            tys
        }

        #[summary("갈래의 패턴이 이름한 변형의 차례 (값은 열거형 tp). 변형 경로가 아니면 E0307, 다른 타입의 변형이면 E0401")]
        #[effects(alloc)]
        fn arm_variant(self: &mut Body, cx: &FnCtx, p: &ast::Pat, tp: &str, vs: &[types::VariantSig], st: &ast::TypeKind) -> (r: Option<usize>)
            ensures match r { None => true, Some(i) => i < vs.len(), },
        {
            let n: usize = p.path.len();
            if n == 0 {
                return None;
            }
            let names: Vec<String> = variant_names(vs);
            let mut bare: bool = n == 1;
            if builtin_path(p.path.as_slice()) {
                self.builtin_by_path(p.path.as_slice());
                bare = true;
            }
            let mut pt: String = String::new();
            if bare {
                if p.path[n - 1].name == "Some" || p.path[n - 1].name == "None" {
                    pt = String::from("Option");
                } else if p.path[n - 1].name == "Ok" || p.path[n - 1].name == "Err" {
                    pt = String::from("Result");
                } else {
                    let msg: String = types::cat3("`", p.path[n - 1].name.as_str(), "` is not a variant path");
                    if types::has(names.as_slice(), p.path[n - 1].name.as_str()) {
                        self.c.fixed("E0307", p.path[n - 1].span, msg.as_str(), "a user enum variant is written with its type", variant_text(tp, p.path[n - 1].name.as_str(), cx.mod_path.as_str()).as_str());
                    } else {
                        match types::closest(p.path[n - 1].name.as_str(), names.as_slice()) {
                            None => self.c.help("E0307", p.path[n - 1].span, msg.as_str(), "a variant pattern is `Type::Variant`"),
                            Some(near) => { let vt: String = variant_text(tp, near.as_str(), cx.mod_path.as_str()); self.c.fixed("E0307", p.path[n - 1].span, msg.as_str(), types::cat3("did you mean `", vt.as_str(), "`?").as_str(), vt.as_str()); },
                        }
                    }
                    return None;
                }
            } else {
                let ty: Vec<ast::Ident> = head(p.path.as_slice());
                match self.c.type_path(ty.as_slice(), cx.mod_path.as_str()) {
                    None => { let tn: Vec<String> = names_of(ty.as_slice()); let d: diag::Diag = self.c.unknown_type(tn.as_slice(), decls::span_to(p.path[0].span, p.path[n - 2].span), cx.mod_path.as_str()); self.c.diags.push(d); return None; },
                    Some(found) => { pt = found; },
                }
            }
            if pt.as_str() != tp {
                let mut all: Vec<String> = Vec::new();
                for i in 0..vs.len()
                    invariant 0 <= i && i <= vs.len(),
                {
                    all.push(variant_text(tp, vs[i].name.as_str(), cx.mod_path.as_str()));
                }
                let stt: String = types::text(st);
                self.c.help("E0401", p.span, types::cat5("this pattern is a `", pt.as_str(), "` variant; the value is `", stt.as_str(), "`").as_str(), types::cat4("the variants of `", stt.as_str(), "`: ", types::join(all.as_slice(), ", ").as_str()).as_str());
                return None;
            }
            let at: Option<usize> = decls::index_of(names.as_slice(), p.path[n - 1].name.as_str());
            match at {
                None => { let miss: String = types::cat5("`", tp, "` has no variant `", p.path[n - 1].name.as_str(), "`"); match types::closest(p.path[n - 1].name.as_str(), names.as_slice()) { None => self.c.help("E0307", p.path[n - 1].span, miss.as_str(), types::cat4("variants of `", tp, "`: ", types::join(names.as_slice(), ", ").as_str()).as_str()), Some(near2) => self.c.fixed("E0307", p.path[n - 1].span, miss.as_str(), types::cat3("did you mean `", near2.as_str(), "`?").as_str(), near2.as_str()), } None },
                Some(k) => { if k < vs.len() { Some(k) } else { None } },
            }
        }

        #[summary("assert(e); 와 assert(e) by (bit_vector); : 실행 코드, proof 블록, proof fn의 몸에 (ADR-0048 §4)")]
        #[effects(alloc)]
        fn assert_stmt(self: &mut Body, cx: &mut FnCtx, a: &ast::Assert, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if !exec_mode(mode) && !ghost_mode(mode) {
                self.c.help("E0503", a.span, "`assert` is not allowed in a specification", "an assertion is a statement of code, a `proof` block or a `proof fn`; a fact about a specification is a `proof fn`'s `ensures`");
            }
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let t: ast::TypeKind = self.expr(cx, &a.cond, &want, Mode::Spec(true), f - 1);
            self.expect_ty(&t, &ast::TypeKind::Bool, a.cond.span);
            if has_prover(&a.by) && is_bool(&t) {
                self.bit_vector_terms(&a.cond);
            }
        }

        #[summary("대입: 대상의 자리와 타입, 값의 타입. 대상의 타입은 놓는 자리의 검사(moves)가 읽도록 적어 둔다")]
        #[effects(alloc)]
        fn assign_stmt(self: &mut Body, cx: &mut FnCtx, a: &ast::Assign, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if ghost_mode(mode) {
                self.ghost_violation(a.span, "assignment", "ghost code proves facts about the state; assign outside the `proof` block");
            } else if !exec_mode(mode) {
                self.c.err("E0503", a.span, "assignment is not allowed in a specification");
            }
            let tt: ast::TypeKind = self.place(cx, &a.target, f - 1);
            self.types.insert(span_key(a.target.span).as_str(), tt.clone());
            let want: Option<ast::TypeKind> = Some(tt.clone());
            let vt: ast::TypeKind = self.expr(cx, &a.value, &want, mode, f - 1);
            self.expect_ty(&vt, &tt, a.value.span);
        }

        #[summary("assume(p(..)); (ADR-0029 §1): 실행 코드에서, 이름 붙은 술어 호출 하나(E1003), 앞에 근거(E1001, E1002). panic의 출처다")]
        #[effects(alloc)]
        fn assume_stmt(self: &mut Body, cx: &mut FnCtx, a: &ast::Assume, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if !exec_mode(mode) {
                self.c.help("E1003", a.span, "`assume` is not allowed in a specification or ghost code", "an escape is a statement of executable code; a ghost fact is proved (`assert`, a `proof fn`)");
            }
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let t: ast::TypeKind = self.expr(cx, &a.cond, &want, Mode::Spec(false), f - 1);
            let named: Option<usize> = match call_of(&a.cond) {
                None => None,
                Some(call) => { match self.resolve(call.path.as_slice(), cx.mod_path.as_str()) { None => None, Some(p) => self.c.fns.find(p.as_str()), } },
            };
            let pred: bool = match named {
                None => false,
                Some(i) => is_spec(self.c.fns.items[i].kind) && types::same(&self.c.fns.items[i].ret, &ast::TypeKind::Bool),
            };
            if !pred && !types::is_error(&t) {
                self.c.help("E1003", a.cond.span, "`assume` takes one named predicate call", "move the condition into `spec fn name(..) -> bool { .. }` and assume `name(..)`");
            }
            match &a.rationale {
                None => self.c.missing_rationale(a.span, "`assume`"),
                Some(r) => self.c.check_rationale(r),
            }
            if exec_mode(mode) {
                need_own(cx, panic_effect(), "`assume`");
            }
        }

        #[summary("by (bit_vector)의 항. 다음 조각(4D-03e5)이 채운다")]
        #[effects(alloc)]
        fn bit_vector_terms(self: &mut Body, e: &ast::Expr) -> () {}

        #[summary("블록: 새 범위에서 문장을 차례로, 끝 식의 타입. 끝 식이 없고 끝나지 않는 문장이 있으면 `!`")]
        #[effects(alloc)]
        fn block(self: &mut Body, cx: &mut FnCtx, b: &ast::Block, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 2,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let scope: Vec<Local> = Vec::new();
            cx.scopes.push(scope);
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                self.stmt(cx, &b.stmts[i], mode, f - 1);
            }
            let t: ast::TypeKind = match &b.tail {
                None => { if self.diverges(b) { ast::TypeKind::Never } else { ast::TypeKind::Unit } },
                Some(e) => self.expr(cx, &**e, expected, mode, f - 1),
            };
            cx.scopes.pop();
            t
        }

        #[summary("E0221: 내장 변형은 타입 없이 쓴다 (ADR-0026 §3)")]
        #[effects(alloc)]
        fn builtin_by_path(self: &mut Body, segs: &[ast::Ident]) -> () {
            if segs.len() < 2 {
                return;
            }
            self.c.fixed("E0221", decls::span_to(segs[0].span, segs[1].span), types::cat5("write `", segs[1].name.as_str(), "`, not `", segs[0].name.as_str(), types::cat3("::", segs[1].name.as_str(), "`").as_str()).as_str(), types::cat3("`", segs[1].name.as_str(), "` is a built-in name").as_str(), segs[1].name.as_str());
        }

        #[summary("Some(x), None, Ok(x), Err(e): 타입은 기대한 타입에서 온다 (Some(x)만은 Option<x의 타입>)")]
        #[effects(alloc)]
        fn builtin_variant(self: &mut Body, cx: &mut FnCtx, name: &str, args: &[ast::Expr], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let arity: usize = if name == "None" {
                0
            } else {
                1
            };
            if args.len() != arity {
                self.c.err("E0405", span, decls::counts(types::cat3("`", name, "` takes ").as_str(), arity, " value(s), found ", args.len(), "").as_str());
            }
            let mut whole: ast::TypeKind = ast::TypeKind::Error;
            let mut inner: Option<ast::TypeKind> = None;
            match expected {
                None => {},
                Some(t) => { let ta: Vec<ast::TypeKind> = types::named_args(t); if (name == "Some" || name == "None") && named_one(t, "Option") { whole = t.clone(); if ta.len() > 0 { inner = Some(ta[0].clone()); } } else if (name == "Ok" || name == "Err") && named_one(t, "Result") { whole = t.clone(); let k: usize = if name == "Err" { 1 } else { 0 }; if k < ta.len() { inner = Some(ta[k].clone()); } } },
            }
            let no: Option<ast::TypeKind> = None;
            match inner {
                None => {},
                Some(it) => { let hint: Option<ast::TypeKind> = Some(it.clone()); for i in 0..args.len() invariant 0 <= i && i <= args.len(), { let at: ast::TypeKind = self.expr(cx, &args[i], &hint, mode, f - 1); self.expect_ty(&at, &it, args[i].span); } return whole; },
            }
            if name == "Some" && args.len() == 1 {
                let xt: ast::TypeKind = self.expr(cx, &args[0], &no, mode, f - 1);
                if types::is_error(&xt) {
                    return ast::TypeKind::Error;
                }
                let mut targs: Vec<ast::Type> = Vec::new();
                targs.push(types::ty(xt));
                return ast::TypeKind::Named(single("Option"), targs);
            }
            for j in 0..args.len()
                invariant 0 <= j && j <= args.len(),
            {
                self.expr(cx, &args[j], &no, mode, f - 1);
            }
            self.c.help("E0424", span, types::cat3("the type of `", name, "` is not known here").as_str(), "give it a type: `let o: Option<i64> = None;`, or pass it where the type is written");
            ast::TypeKind::Error
        }

        #[summary("const 하나 (ADR-0052): 타입은 값만 담고(E0437) 초기값은 그 타입이다. 평가기가 먼저 돌았으므로, 검사기가 초기값을 틀렸다고 하면 그 자리의 평가기 진단은 뺀다")]
        #[effects(alloc)]
        fn check_const(self: &mut Body, c: &ast::ConstDef, mp: &str) -> () {
            let saved: Vec<types::TParam> = self.c.tparams.clone();
            self.c.tparams = Vec::new();
            let t: ast::TypeKind = self.c.canon(&c.ty, mp, true, 1000000000);
            if ty_has_error(&t, 1000000000) {
                self.c.tparams = saved;
                return;
            }
            let before: usize = self.c.diags.len();
            let mut seen: Vec<String> = Vec::new();
            if !self.holds_values(&t, &mut seen, 1000000000) {
                self.c.diags.push(consts::not_value(&t, c.ty.span));
                self.drop_evaluator(c.value.span, before);
                self.c.tparams = saved;
                return;
            }
            let mut path: String = String::from(mp);
            path.push_str("::");
            path.push_str(c.name.name.as_str());
            let mut cx: FnCtx = new_ctx(path.as_str(), mp, types::pure(), false);
            cx.ret = t.clone();
            let want: Option<ast::TypeKind> = Some(t.clone());
            let got: ast::TypeKind = self.expr(&mut cx, &c.value, &want, Mode::Exec, 1000000000);
            self.expect_ty(&got, &t, c.value.span);
            let mut any: bool = false;
            for i in 0..self.c.diags.len()
                invariant 0 <= i && i <= self.c.diags.len(),
            {
                if i >= before && starts_e(self.c.diags[i].code.as_str()) {
                    any = true;
                }
            }
            if any {
                self.drop_evaluator(c.value.span, before);
            }
            self.c.tparams = saved;
        }

        #[summary("계약의 절 하나: bool이고, 이름 붙은 술어면 공허하지 않으며(E0502), 한정자를 담으면 이름 붙은 술어다(E0501, ADR-0095 A2)")]
        #[effects(alloc)]
        fn check_contract(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, post: bool) -> () {
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let t: ast::TypeKind = self.expr(cx, e, &want, Mode::Spec(post), 1000000000);
            self.expect_ty(&t, &ast::TypeKind::Bool, e.span);
            let named: Option<usize> = match call_of(e) {
                None => None,
                Some(call) => { match self.resolve(call.path.as_slice(), cx.mod_path.as_str()) { None => None, Some(p) => self.c.fns.find(p.as_str()), } },
            };
            let mut pred: bool = false;
            match named {
                None => {},
                Some(i) => { if is_spec(self.c.fns.items[i].kind) && types::same(&self.c.fns.items[i].ret, &ast::TypeKind::Bool) { pred = true; if self.c.fns.items[i].vacuous { let msg: String = types::cat3("`", self.c.fns.items[i].path.as_str(), "` is the constant `true`; it states nothing"); self.c.err("E0502", e.span, msg.as_str()); } } },
            }
            if !pred && !types::is_error(&t) && has_quant(e) {
                self.c.help("E0501", e.span, "a contract clause with a quantifier is not a named predicate", "move the quantified condition into `spec fn name(..) -> bool { .. }` and call it here");
            }
        }

        #[summary("선언한 효과가 몸이 요구하는 것을 담는가 (ADR-0030 §3). 빠진 효과는 정의에 하나의 E0606이고 고칠 글은 요구하는 효과를 모두 쓴 속성이다. pure가 io를 부르는 것뿐이면 호출 자리의 E0603으로 충분하다")]
        #[effects(alloc)]
        fn check_effects(self: &mut Body, d: &ast::FnDef, cx: &FnCtx) -> () {
            let need: types::Effects = needed(cx);
            let missing: types::Effects = types::e_minus(need, cx.effect);
            if types::is_pure(missing) || types::is_pure(cx.effect) && only_io(missing) {
                return;
            }
            let mut k: usize = d.attrs.len();
            for i in 0..d.attrs.len()
                invariant 0 <= i && i <= d.attrs.len() && k <= d.attrs.len(),
            {
                if k == d.attrs.len() && d.attrs[i].name.name == "effects" {
                    k = i;
                }
            }
            {
                {
                    if k < d.attrs.len() {
                        let mut why: String = String::new();
                        let mut first: bool = true;
                        for j in 0..cx.needs.len()
                            invariant 0 <= j && j <= cx.needs.len(),
                        {
                            if types::e_contains(missing, cx.needs[j].e) {
                                if !first {
                                    why.push_str(" and ");
                                }
                                first = false;
                                why.push_str("`");
                                why.push_str(types::e_text(cx.needs[j].e).as_str());
                                why.push_str("` (");
                                why.push_str(cx.needs[j].what.as_str());
                                why.push_str(")");
                            }
                        }
                        let want: String = types::e_text(types::e_union(cx.effect, need));
                        let msg: String = types::cat7("`", d.name.name.as_str(), "` needs ", why.as_str(), " but declares `#[effects(", types::e_text(cx.effect).as_str(), ")]`");
                        let fix: String = types::cat3("declare `#[effects(", want.as_str(), ")]`");
                        let to: String = types::cat3("#[effects(", want.as_str(), ")]");
                        self.c.fixed("E0606", d.attrs[k].span, msg.as_str(), fix.as_str(), to.as_str());
                    }
                }
            }
        }

        #[summary("함수 하나: #[uses], 매개변수와 결과의 타입, 계약, 측도, 몸, 그리고 실행 함수면 효과")]
        #[effects(alloc)]
        fn check_fn(self: &mut Body, d: &ast::FnDef, mp: &str, path: &str) -> () {
            let at: usize = match self.c.fns.find(path) {
                None => { return; },
                Some(i) => i,
            };
            let sig: types::FnSig = self.c.fns.items[at].clone();
            self.c.tparams = sig.generics.clone();
            let mut cx: FnCtx = new_ctx(path, mp, sig.effect, is_proof(d.kind));
            if !self.calls.has(path) {
                let none: Vec<String> = Vec::new();
                self.calls.insert(path, none);
            }
            for i in 0..d.attrs.len()
                invariant 0 <= i && i <= d.attrs.len(),
            {
                if d.attrs[i].name.name == "uses" {
                    self.check_uses(&d.attrs[i], mp);
                }
            }
            for i in 0..d.params.len()
                invariant 0 <= i && i <= d.params.len(),
            {
                let ty: ast::TypeKind = self.c.canon(&d.params[i].ty, mp, true, 1000000000);
                self.check_param_type(&d.params[i].ty, d.kind, !ty_has_error(&ty, 1000000000));
                self.declare(&mut cx, &d.params[i].name, ty, false, true);
            }
            self.check_value_type(&d.ret.ty, "return type");
            if is_spec(d.kind) && named_one(&d.ret.ty.kind, "Vec") {
                self.spec_vec(d.ret.ty.span);
            }
            if is_spec(d.kind) && named_one(&d.ret.ty.kind, "String") {
                self.spec_string(d.ret.ty.span);
            }
            let ret_ty: ast::TypeKind = self.c.canon(&d.ret.ty, mp, true, 1000000000);
            cx.ret = ret_ty.clone();
            if is_spec(d.kind) {
                if d.pre.len() > 0 {
                    self.c.err("E0207", d.pre[0].span, "spec functions take no `requires` / `ensures` in milestone 1");
                } else if d.post.len() > 0 {
                    self.c.err("E0207", d.post[0].span, "spec functions take no `requires` / `ensures` in milestone 1");
                }
            }
            for i in 0..d.pre.len()
                invariant 0 <= i && i <= d.pre.len(),
            {
                self.check_contract(&mut cx, &d.pre[i], false);
            }
            if d.post.len() > 0 {
                let scope: Vec<Local> = Vec::new();
                cx.scopes.push(scope);
                match &d.ret.name {
                    None => {},
                    Some(n) => self.declare(&mut cx, n, ret_ty.clone(), false, false),
                }
                for i in 0..d.post.len()
                    invariant 0 <= i && i <= d.post.len(),
                {
                    self.check_contract(&mut cx, &d.post[i], true);
                }
                cx.scopes.pop();
            }
            match &d.ret.name {
                None => {},
                Some(n) => { types::add(&mut cx.reserved, n.name.as_str()); },
            }
            match &d.measure {
                None => {},
                Some(m) => { let no: Option<ast::TypeKind> = None; let t: ast::TypeKind = self.expr(&mut cx, m, &no, Mode::Spec(false), 1000000000); self.measure_type(&t, m.span); },
            }
            if is_some(&sig.trait_of) && !sig.default {
                self.c.tparams = Vec::new();
                return;
            }
            let mode: Mode = match d.kind {
                ast::FnKind::Exec => Mode::Exec,
                ast::FnKind::Spec => Mode::Spec(false),
                ast::FnKind::Proof => Mode::Ghost,
            };
            let want: Option<ast::TypeKind> = Some(ret_ty.clone());
            self.open_lets = Vec::new();
            self.typed_uses = Vec::new();
            self.spec_at = Vec::new();
            let t: ast::TypeKind = self.block(&mut cx, &d.body, &want, mode, 1000000000);
            self.spec_widen = !is_exec(d.kind);
            let end: source::Span = match &d.body.tail {
                None => d.body.span,
                Some(e) => e.span,
            };
            self.expect_ty(&t, &ret_ty, end);
            self.spec_widen = false;
            self.settle_lets(d, mp);
            if is_exec(d.kind) {
                if has_attr(d.attrs.as_slice(), "external_body") {
                    need_own(&mut cx, panic_effect(), "`#[external_body]`");
                    types::add(&mut self.external, path);
                }
                self.check_effects(d, &cx);
                self.needs.insert(path, Needs { own: cx.own, body: needed(&cx) });
            }
            self.c.tparams = Vec::new();
        }

        #[summary("단위 하나: 속성과 요약, 안의 단위, 상수, 함수, impl과 trait의 함수")]
        #[effects(alloc)]
        fn check_mod(self: &mut Body, m: &ast::Mod, prefix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mp: String = types::cat2(prefix, m.name.name.as_str());
            let mut has_summary: bool = false;
            for i in 0..m.attrs.len()
                invariant 0 <= i && i <= m.attrs.len(),
            {
                if m.attrs[i].name.name == "summary" && m.attrs[i].args.len() == 1 && str_arg(&m.attrs[i].args[0]) {
                    if has_summary {
                        self.c.fixed("E0605", m.attrs[i].span, "duplicate `#[summary(..)]` attribute", "keep one: join the text", "");
                    }
                    has_summary = true;
                } else if m.attrs[i].name.name == "summary" {
                    self.c.err("E0704", m.attrs[i].span, "`#[summary(..)]` takes exactly one string");
                    has_summary = true;
                } else {
                    self.c.fixed("E0605", m.attrs[i].span, types::cat3("unknown attribute `", m.attrs[i].name.name.as_str(), "` on a unit").as_str(), "remove it: units take `#[summary(\"..\")]`", "");
                }
            }
            if !has_summary {
                self.c.help("E0704", m.name.span, types::cat3("unit `", m.name.name.as_str(), "` has no summary").as_str(), "add `#[summary(\"one line\")]` above `mod`");
            }
            let sub: String = types::cat2(mp.as_str(), "::");
            for i in 0..m.mods.len()
                invariant 0 <= i && i <= m.mods.len(),
            {
                self.check_mod(&m.mods[i], sub.as_str(), f - 1);
            }
            for i in 0..m.consts.len()
                invariant 0 <= i && i <= m.consts.len(),
            {
                for j in 0..m.consts[i].attrs.len()
                    invariant 0 <= j && j <= m.consts[i].attrs.len(),
                {
                    if m.consts[i].attrs[j].name.name == "summary" {
                        self.c.check_summary(&m.consts[i].attrs[j], m.consts[i].attrs.as_slice());
                    } else {
                        self.c.fixed("E0605", m.consts[i].attrs[j].span, types::cat3("unknown attribute `", m.consts[i].attrs[j].name.name.as_str(), "` on a constant").as_str(), "constants take `#[summary(\"..\")]`", "");
                    }
                }
                self.check_const(&m.consts[i], mp.as_str());
            }
            for i in 0..m.fns.len()
                invariant 0 <= i && i <= m.fns.len(),
            {
                let path: String = types::cat3(mp.as_str(), "::", m.fns[i].name.name.as_str());
                self.check_fn(&m.fns[i], mp.as_str(), path.as_str());
            }
            for i in 0..m.impls.len()
                invariant 0 <= i && i <= m.impls.len(),
            {
                for j in 0..m.impls[i].fns.len()
                    invariant 0 <= j && j <= m.impls[i].fns.len(),
                {
                    let path: String = types::cat5(mp.as_str(), "::", m.impls[i].ty.name.as_str(), "::", m.impls[i].fns[j].name.name.as_str());
                    self.check_fn(&m.impls[i].fns[j], mp.as_str(), path.as_str());
                }
            }
            for i in 0..m.traits.len()
                invariant 0 <= i && i <= m.traits.len(),
            {
                for j in 0..m.traits[i].fns.len()
                    invariant 0 <= j && j <= m.traits[i].fns.len(),
                {
                    let path: String = types::cat5(mp.as_str(), "::", m.traits[i].name.name.as_str(), "::", m.traits[i].fns[j].f.name.name.as_str());
                    if self.declared_at(path.as_str(), m.traits[i].fns[j].f.span) {
                        self.check_fn(&m.traits[i].fns[j].f, mp.as_str(), path.as_str());
                    }
                }
            }
            for i in 0..m.trait_impls.len()
                invariant 0 <= i && i <= m.trait_impls.len(),
            {
                match self.c.impl_info(m.trait_impls[i].span) {
                    None => {},
                    Some(found) => { self.c.self_head = Some(decls::SelfHead { head: found.info.head.clone(), text: types::text_in(&found.info.head, mp.as_str()) }); for j in 0..m.trait_impls[i].fns.len() invariant 0 <= j && j <= m.trait_impls[i].fns.len(), { let path: String = types::fn_path(&found.info, m.trait_impls[i].fns[j].name.name.as_str()); if self.declared_at(path.as_str(), m.trait_impls[i].fns[j].span) { self.check_fn(&m.trait_impls[i].fns[j], mp.as_str(), path.as_str()); } } self.c.self_head = None; },
                }
            }
        }

        #[summary("매개변수의 타입이 가질 수 있는 꼴. resolved가 거짓이면 타입 안의 결함을 이미 알렸으므로 둘러싼 참조의 꼴을 다시 알리지 않는다 (백로그 2V-22)")]
        #[effects(alloc)]
        fn check_param_type(self: &mut Body, t: &ast::Type, kind: ast::FnKind, resolved: bool) -> () {
            match ref_inner(&t.kind) {
                None => { if !is_exec(kind) && named_one(&t.kind, "Vec") { self.spec_vec(t.span); } else if !is_exec(kind) && named_one(&t.kind, "String") { self.spec_string(t.span); } else { self.check_value_type(t, "parameter type"); } },
                Some(inner) => self.check_ref_param(t.span, types::is_ref_mut(&t.kind), &inner, kind, resolved),
            }
        }

        #[summary("참조 매개변수 `&inner`의 꼴")]
        #[effects(alloc)]
        fn check_ref_param(self: &mut Body, span: source::Span, mutable: bool, inner: &ast::TypeKind, kind: ast::FnKind, resolved: bool) -> () {
            let slice_ok: bool = match slice_elem(inner) {
                None => false,
                Some(e) => types::array_elem_ok(&e, 100000) || named_one(&e, "Vec") || named_one(&e, "String"),
            };
            if slice_ok {
                if mutable && !is_exec(kind) {
                    self.ghost_mut_param(span, kind);
                }
                return;
            }
            if named_one(inner, "Vec") {
                if !is_exec(kind) {
                    self.spec_vec(span);
                }
                return;
            }
            if named_one(inner, "String") {
                if !is_exec(kind) {
                    self.spec_string(span);
                }
                return;
            }
            if is_named(inner) || types::is_scalar(inner) {
                if mutable && !is_exec(kind) {
                    self.ghost_mut_param(span, kind);
                }
                return;
            }
            if is_str(inner) {
                if mutable {
                    self.c.help("E0402", span, "a `&mut str` parameter is not supported", "take `&mut String` to change the text");
                }
                return;
            }
            if types::is_error(inner) || !resolved {
                return;
            }
            self.c.help("E0402", span, "references are `&[T]`, `&mut [T]`, `&T` or `&mut T` with `T` a scalar, struct or enum", "pass the value itself, or a reference to the scalar, struct, enum or slice that holds it");
        }

        #[summary("필드나 페이로드의 값들을 선언된 타입에 견준다. 타입이 제네릭 데이터 타입의 매개변수 ps를 말하면, tm이 아직 묶지 않은 매개변수는 값에서 묶는다 (정수 리터럴은 마지막에: 다른 값이 그 타입을 정한다)")]
        #[effects(alloc)]
        fn check_slots(self: &mut Body, cx: &mut FnCtx, ps: &[types::TParam], tm: &mut types::Subst, args: &[ast::Expr], fields: &[ast::FieldInit], by_field: bool, slots: &[Slot], mode: Mode, f: usize) -> ()
            decreases f * 3 + 1,
        {
            let no: Option<ast::TypeKind> = None;
            let mut deferred: Vec<usize> = Vec::new();
            for i in 0..slots.len()
                invariant 0 <= i && i <= slots.len(),
            {
                if has_param_of(&slots[i].ty, ps, tm) {
                    if slot_literal(args, fields, by_field, slots[i].at) {
                        deferred.push(i);
                    } else {
                        let xt: ast::TypeKind = self.slot_expr(cx, args, fields, by_field, slots[i].at, &no, mode, f);
                        types::unify(&slots[i].ty, &xt, ps, tm, 100000);
                        let want: ast::TypeKind = types::subst(&slots[i].ty, tm);
                        if !has_param_of(&slots[i].ty, ps, tm) {
                            self.expect_ty(&xt, &want, slot_span(args, fields, by_field, slots[i].at));
                        }
                    }
                } else {
                    let want2: ast::TypeKind = types::subst(&slots[i].ty, tm);
                    let hint: Option<ast::TypeKind> = Some(want2.clone());
                    let xt2: ast::TypeKind = self.slot_expr(cx, args, fields, by_field, slots[i].at, &hint, mode, f);
                    self.expect_ty(&xt2, &want2, slot_span(args, fields, by_field, slots[i].at));
                }
            }
            for j in 0..deferred.len()
                invariant 0 <= j && j <= deferred.len(),
            {
                let s: usize = deferred[j];
                if s < slots.len() {
                    if has_param_of(&slots[s].ty, ps, tm) {
                        self.slot_expr(cx, args, fields, by_field, slots[s].at, &no, mode, f);
                    } else {
                        let want3: ast::TypeKind = types::subst(&slots[s].ty, tm);
                        let hint3: Option<ast::TypeKind> = Some(want3.clone());
                        let xt3: ast::TypeKind = self.slot_expr(cx, args, fields, by_field, slots[s].at, &hint3, mode, f);
                        self.expect_ty(&xt3, &want3, slot_span(args, fields, by_field, slots[s].at));
                    }
                }
            }
        }

        #[summary("#[uses(..)]의 인자는 spec fn의 이름이다 (E0509)")]
        #[effects(alloc)]
        fn check_uses(self: &mut Body, a: &ast::Attr, mp: &str) -> () {
            for j in 0..a.args.len()
                invariant 0 <= j && j <= a.args.len(),
            {
                match &a.args[j] {
                    ast::AttrArg::Ident(i) => { let mut known: bool = false; let mut is_sp: bool = false; match decls::uses_target(i.name.as_str(), mp, &self.c.fns) { None => {}, Some(p) => { match self.c.fns.find(p.as_str()) { None => {}, Some(at) => { known = true; is_sp = is_spec(self.c.fns.items[at].kind); }, } }, } if !is_sp { let msg: String = types::cat3("`", i.name.as_str(), "` is not a spec function"); if known { self.c.help("E0509", i.span, msg.as_str(), "remove it from `#[uses(..)]`: only spec function bodies are revealed; executable functions are seen through their contracts"); } else { self.c.help("E0509", i.span, msg.as_str(), "remove it from `#[uses(..)]`, or define the spec function (another unit's as `unit::name`)"); } } },
                    ast::AttrArg::Str(q4_s, sp) => self.c.err("E0509", *sp, "`#[uses(..)]` takes spec function names"),
                    ast::AttrArg::Pair(k, q4_v) => self.c.err("E0509", k.span, "`#[uses(..)]` takes spec function names"),
                }
            }
        }

        #[summary("지역 변수와 결과의 타입: 참조도 맨 조각도 아니다")]
        #[effects(alloc)]
        fn check_value_type(self: &mut Body, t: &ast::Type, what: &str) -> () {
            if is_ref(&t.kind) {
                self.c.help("E0403", t.span, types::cat2("a reference cannot be a ", what).as_str(), "references are second-class: pass them as arguments only (ADR-0015)");
            } else if is_slice(&t.kind) {
                self.c.err("E0402", t.span, "a bare slice is unsized; use `&[T]` as a parameter or `[T; N]`");
            } else if is_str(&t.kind) {
                self.c.err("E0402", t.span, "a bare `str` is unsized; use `&str` as a parameter or `String`");
            }
        }

        #[summary("E0436: std::process::Child는 필드로 짓거나 읽지 않는다")]
        #[effects(alloc)]
        fn child_by_hand(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0436", span, "a `std::process::Child` is not built or read by its fields", "get one from `std::process::spawn(prog, args.as_slice(), std::process::Stdio::Inherit)` and use its methods: `write_all`, `read_line`, `id`, `wait`");
        }

        #[summary("타입 t의 값이 바로 담는 타입들")]
        #[effects(alloc)]
        fn components(self: &Body, t: &ast::TypeKind) -> Vec<ast::TypeKind> {
            let mut out: Vec<ast::TypeKind> = Vec::new();
            match held(t) {
                None => {},
                Some(e) => { out.push(e); return out; },
            }
            let path: String = match types::named_path(t) {
                None => { return out; },
                Some(p) => p,
            };
            if path == "Option" || path == "Result" {
                return types::named_args(t);
            }
            match self.c.adts.find(path.as_str()) {
                None => {},
                Some(at) => { let m: types::Subst = types::adt_subst(&self.c.adts.items[at], t); let parts: Vec<ast::TypeKind> = adt_parts(&self.c.adts.items[at].kind); for i in 0..parts.len() invariant 0 <= i && i <= parts.len(), { out.push(types::subst(&parts[i], &m)); } },
            }
            out
        }

        #[summary("const의 선언한 타입을 그 단위에서, 함수의 타입 매개변수 밖에서 푼 것. 값만 담지 않으면 Error")]
        #[effects(alloc)]
        fn const_type(self: &mut Body, c: &consts::Const) -> ast::TypeKind {
            if consts::scalar(&c.ty) {
                return c.ty.clone();
            }
            let saved: Vec<types::TParam> = self.c.tparams.clone();
            self.c.tparams = Vec::new();
            let written: ast::Type = types::ty(c.ty.clone());
            let t: ast::TypeKind = self.c.canon(&written, c.unit.as_str(), false, 1000000000);
            self.c.tparams = saved;
            let mut seen: Vec<String> = Vec::new();
            if self.holds_values(&t, &mut seen, 1000000000) {
                t
            } else {
                ast::TypeKind::Error
            }
        }

        #[summary("이름을 지금 범위에 넣는다. 보이는 이름을 가리면 E0303, 이 함수의 다른 자리에서 다른 타입으로 묶였어도 E0303 (ADR-0095 A3: 이름 하나에 타입 하나)")]
        #[effects(alloc)]
        fn declare(self: &mut Body, cx: &mut FnCtx, name: &ast::Ident, ty: ast::TypeKind, mutable: bool, is_param: bool) -> () {
            let one: Vec<String> = single(name.name.as_str());
            let hides: bool = is_some_local(&lookup(cx, name.name.as_str())) || types::has(cx.reserved.as_slice(), name.name.as_str()) || is_some(&lookup_const(&self.consts, one.as_slice(), cx.mod_path.as_str()));
            let mut other: Option<ast::TypeKind> = None;
            if types::has(cx.all_names.as_slice(), name.name.as_str()) {
                match self.locals.find(cx.path.as_str()) {
                    None => {},
                    Some(u) => { match self.locals.items[u].find(name.name.as_str()) { None => {}, Some(k) => { if !types::same(&self.locals.items[u].items[k], &ty) { other = Some(self.locals.items[u].items[k].clone()); } }, } },
                }
            }
            if hides {
                self.c.help("E0303", name.span, types::cat3("`", name.name.as_str(), "` hides a visible name of this function").as_str(), "choose a new name");
            } else {
                match other {
                    None => {},
                    Some(t) => self.c.help("E0303", name.span, types::cat5("`", name.name.as_str(), "` is bound elsewhere in this function with type `", types::text(&t).as_str(), "`").as_str(), "choose a new name: a name has one type in a function"),
                }
            }
            types::add(&mut cx.all_names, name.name.as_str());
            if !self.locals.has(cx.path.as_str()) {
                self.locals.insert(cx.path.as_str(), table::new::<ast::TypeKind>());
            }
            match self.locals.find(cx.path.as_str()) {
                None => {},
                Some(u) => self.locals.items[u].insert(name.name.as_str(), ty.clone()),
            }
            let n: usize = cx.scopes.len();
            if n > 0 {
                cx.scopes[n - 1].push(Local { name: name.name.clone(), ty: ty.clone(), mutable: mutable, is_param: is_param });
            }
        }

        #[summary("path의 함수가 span에 선언된 그것인가 (같은 이름의 다른 선언은 1패스가 알렸다)")]
        #[effects(alloc)]
        fn declared_at(self: &Body, path: &str, span: source::Span) -> bool {
            match self.c.fns.find(path) {
                None => false,
                Some(i) => same_span(self.c.fns.items[i].span, span),
            }
        }

        #[summary("E0231: (*p).x는 p.x로 쓴다 (필드는 참조를 지나 읽힌다)")]
        #[effects(alloc)]
        fn deref_field(self: &mut Body, e: &ast::Expr, base: &ast::Expr, name: &ast::Ident) -> () {
            match deref_inner(base) {
                None => {},
                Some(x) => { let r: String = types::cat3(fmt::expr_text(&x).as_str(), ".", name.name.as_str()); self.c.fixed("E0231", e.span, types::cat3("write `", r.as_str(), "`").as_str(), "fields are read through a reference directly", r.as_str()); },
            }
        }

        #[summary("E0401과 고칠 글 `*e`: 구조체나 열거형 T를 기대하는 자리에 &T나 &mut T인 e를 줬다 (백로그 2B-16). 알렸는가")]
        #[effects(alloc)]
        fn deref_fix(self: &mut Body, found: &ast::TypeKind, want: &ast::TypeKind, e: &ast::Expr) -> bool {
            match ref_inner(found) {
                None => false,
                Some(inner) => { if !types::same(&inner, want) || !is_named(want) { return false; } let r: String = types::cat2("*", fmt::expr_text(e).as_str()); let msg: String = types::cat5("expected `", types::text(want).as_str(), "`, found `", types::text(found).as_str(), "`"); self.c.fixed("E0401", e.span, msg.as_str(), types::cat3("pass the value: `", r.as_str(), "`").as_str(), r.as_str()); true },
            }
        }

        #[summary("*x의 자리: x가 &T(조각 아님)나 Box<T>면 T")]
        #[effects(alloc)]
        fn deref_place(self: &mut Body, span: source::Span, p: Place) -> Place {
            match ref_inner(&p.ty) {
                None => {},
                Some(inner) => { if !is_slice(&inner) { return Place { ty: inner, writable: p.writable }; } },
            }
            match box_inner(&p.ty) {
                None => {},
                Some(boxed) => { return Place { ty: boxed, writable: p.writable }; },
            }
            if !types::is_error(&p.ty) {
                self.c.err("E0401", span, types::cat3("`*` needs a reference `&T` or `&mut T` or a `Box<T>`, found `", types::text(&p.ty).as_str(), "`").as_str());
            }
            Place { ty: ast::TypeKind::Error, writable: false }
        }

        #[summary("블록에 끝나지 않는 문장(타입이 `!`인 식)이 있는가")]
        #[effects(alloc)]
        fn diverges(self: &Body, b: &ast::Block) -> bool {
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                match stmt_expr(&b.stmts[i]) {
                    None => {},
                    Some(sp) => { match self.types.find(span_key(sp).as_str()) { None => {}, Some(k) => { if is_never(&self.types.items[k]) { return true; } }, } },
                }
            }
            false
        }

        #[summary("before번째 앞의 진단 가운데 span 안에서 난 평가기의 것(E0259, E0260, E0401)을 뺀다")]
        #[effects(alloc)]
        fn drop_evaluator(self: &mut Body, span: source::Span, before: usize) -> () {
            let mut kept: Vec<diag::Diag> = Vec::new();
            for i in 0..self.c.diags.len()
                invariant 0 <= i && i <= self.c.diags.len(),
            {
                let at: source::Span = self.c.diags[i].span;
                let inside: bool = at.file == span.file && at.lo >= span.lo && at.hi <= span.hi;
                let evaluator: bool = self.c.diags[i].code == "E0259" || self.c.diags[i].code == "E0260" || self.c.diags[i].code == "E0401";
                if i >= before || !inside || !evaluator {
                    kept.push(self.c.diags[i].clone());
                }
            }
            self.c.diags = kept;
        }

        #[summary("색인한 자리: 원소의 타입, 색인할 수 없으면 E0407")]
        #[effects(alloc)]
        fn elem_place(self: &mut Body, span: source::Span, p: Place) -> Place {
            match elem_of(&p.ty) {
                None => { if !types::is_error(&p.ty) { self.c.err("E0407", span, types::cat3("type `", types::text(&p.ty).as_str(), "` cannot be indexed").as_str()); } Place { ty: ast::TypeKind::Error, writable: false } },
                Some(t) => Place { ty: t, writable: p.writable },
            }
        }

        #[summary("path가 열거형인가")]
        #[effects(alloc)]
        fn enum_adt(self: &Body, path: &str) -> bool {
            match self.c.adts.find(path) {
                None => false,
                Some(at) => !struct_kind(&self.c.adts.items[at].kind),
            }
        }

        #[summary("found가 want인가. 아니면 E0401, 고칠 길은 꼴에 따라 (참조의 값 읽기, 정수 변환, f64)")]
        #[effects(alloc)]
        fn expect_ty(self: &mut Body, found: &ast::TypeKind, want: &ast::TypeKind, span: source::Span) -> () {
            if self.spec_widen && widens(found, want) {
                return;
            }
            if ty_has_error(found, 1000000000) || ty_has_error(want, 1000000000) {
                return;
            }
            if types::same(found, want) || is_never(found) {
                return;
            }
            let msg: String = types::cat5("expected `", types::text(want).as_str(), "`, found `", types::text(found).as_str(), "`");
            let refers: bool = match ref_inner(found) {
                None => false,
                Some(inner) => types::same(&inner, want),
            };
            if refers {
                self.c.help("E0401", span, msg.as_str(), "read the value it refers to: `*x`");
            } else if types::is_int(found) && types::is_int(want) {
                let w: String = types::text(want);
                let fix: String = if conv_obligation(found, want) {
                    types::cat3("convert: `x as ", w.as_str(), "` (its range is a proof obligation)")
                } else {
                    types::cat3("convert: `x as ", w.as_str(), "` (every value fits)")
                };
                self.c.help("E0401", span, msg.as_str(), fix.as_str());
            } else if types::is_int(found) && is_f64(want) {
                self.c.help("E0401", span, msg.as_str(), "convert: `f64::from(x)` (exact; a 64-bit integer has the obligation `|x| <= 2^53`)");
            } else if is_f64(found) && types::is_int(want) {
                self.c.help("E0401", span, msg.as_str(), "`f64` does not convert to an integer type (ADR-0061 §4, open question 1)");
            } else {
                self.c.err("E0401", span, msg.as_str());
            }
        }

        #[summary("제네릭 데이터 타입 tp의 매개변수를 기대한 타입에서 묶는다 (기대한 타입이 그 타입의 인스턴스일 때)")]
        #[effects(alloc)]
        fn expected_args(self: &Body, tp: &str, expected: &Option<ast::TypeKind>) -> types::Subst {
            match expected {
                None => empty_subst(),
                Some(t) => { match types::named_path(t) { None => empty_subst(), Some(p) => { match self.c.adts.find(tp) { None => empty_subst(), Some(at) => { if p.as_str() == tp { types::adt_subst(&self.c.adts.items[at], t) } else { empty_subst() } }, } }, } },
            }
        }

        #[summary("식 하나의 타입. 다음 조각(4D-03e5)이 채운다")]
        #[effects(alloc)]
        fn expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 2,
        {
            ast::TypeKind::Error
        }

        #[summary("구조체(나 그 참조) bt의 필드 name의 타입")]
        #[effects(alloc)]
        fn field_type_of(self: &mut Body, bt: &ast::TypeKind, name: &ast::Ident) -> ast::TypeKind {
            if types::is_error(bt) {
                return ast::TypeKind::Error;
            }
            if is_child(bt) {
                self.child_by_hand(name.span);
                return ast::TypeKind::Error;
            }
            let decl: Fields = self.struct_fields(bt);
            if !decl.found {
                let msg: String = types::cat5("`", types::text(bt).as_str(), "` has no field `", name.name.as_str(), "`");
                if is_named(bt) {
                    self.c.help("E0306", name.span, msg.as_str(), "enum values have no fields: `match` the variants");
                } else {
                    self.c.help("E0306", name.span, msg.as_str(), "only structs have fields");
                }
                return ast::TypeKind::Error;
            }
            let mut names: Vec<String> = Vec::new();
            for i in 0..decl.fields.len()
                invariant 0 <= i && i <= decl.fields.len(),
            {
                if decl.fields[i].name == name.name {
                    return decl.fields[i].ty.clone();
                }
                names.push(decl.fields[i].name.clone());
            }
            let none: String = types::cat5("`", decl.path.as_str(), "` has no field `", name.name.as_str(), "`");
            match types::closest(name.name.as_str(), names.as_slice()) {
                None => self.c.help("E0306", name.span, none.as_str(), types::cat4("fields of `", decl.path.as_str(), "`: ", types::join(names.as_slice(), ", ").as_str()).as_str()),
                Some(near) => self.c.fixed("E0306", name.span, none.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()),
            }
            ast::TypeKind::Error
        }

        #[summary("for: 두 끝은 한 정수 타입이고(리터럴은 다른 끝의 것을 받는다) 루프 앞에서 한 번 계산된다. 변수는 루프 안에서만 살고 대입되지 않는다")]
        #[effects(alloc)]
        fn for_stmt(self: &mut Body, cx: &mut FnCtx, x: &ast::For, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if ghost_mode(mode) {
                self.ghost_loop(x.span);
            } else if !exec_mode(mode) {
                self.spec_loop(x.span);
            }
            let m: Mode = operand(mode);
            let no: Option<ast::TypeKind> = None;
            let mut lt: ast::TypeKind = ast::TypeKind::Error;
            let mut ht: ast::TypeKind = ast::TypeKind::Error;
            if untyped_literal(&x.lo, 1000000000) && !untyped_literal(&x.hi, 1000000000) {
                ht = self.expr(cx, &x.hi, &no, m, f - 1);
                let want_lo: Option<ast::TypeKind> = int_want(&ht);
                lt = self.expr(cx, &x.lo, &want_lo, m, f - 1);
            } else {
                lt = self.expr(cx, &x.lo, &no, m, f - 1);
                let want_hi: Option<ast::TypeKind> = int_want(&lt);
                ht = self.expr(cx, &x.hi, &want_hi, m, f - 1);
            }
            if !types::is_int(&lt) && !types::is_error(&lt) {
                self.c.help("E0401", x.lo.span, types::cat3("a `for` range is of integers, found `", types::text(&lt).as_str(), "`").as_str(), "loop over integer bounds and index with them");
            }
            if types::is_int(&lt) && types::is_int(&ht) && !types::same(&lt, &ht) {
                self.c.help("E0401", x.hi.span, types::cat5("the ends of a `for` range have one type: `", types::text(&lt).as_str(), "` and `", types::text(&ht).as_str(), "`").as_str(), types::cat3("convert one end: `.. as ", types::text(&lt).as_str(), "`").as_str());
            } else {
                self.expect_ty(&ht, &lt, x.hi.span);
            }
            let scope: Vec<Local> = Vec::new();
            cx.scopes.push(scope);
            self.declare(cx, &x.var, lt, false, false);
            types::add(&mut cx.for_vars, x.var.name.as_str());
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            for i in 0..x.invariants.len()
                invariant 0 <= i && i <= x.invariants.len(),
            {
                let t: ast::TypeKind = self.expr(cx, &x.invariants[i], &wb, Mode::Spec(true), f - 1);
                self.expect_ty(&t, &ast::TypeKind::Bool, x.invariants[i].span);
            }
            cx.loops.push(LoopCx { label: label_name(&x.label), is_loop: false, value: None });
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Unit);
            let bt: ast::TypeKind = self.block(cx, &x.body, &wu, mode, f - 1);
            cx.loops.pop();
            cx.scopes.pop();
            self.expect_ty(&bt, &ast::TypeKind::Unit, x.body.span);
        }

        #[summary("E0257: 유령 코드의 루프")]
        #[effects(alloc)]
        fn ghost_loop(self: &mut Body, span: source::Span) -> () {
            self.ghost_violation(span, "a loop", "prove by induction: a recursive `proof fn` with `decreases`");
        }

        #[summary("유령 코드의 &mut 매개변수: spec fn은 E0402, proof fn은 E0257 (ADR-0062 §1)")]
        #[effects(alloc)]
        fn ghost_mut_param(self: &mut Body, span: source::Span, kind: ast::FnKind) -> () {
            if is_proof(kind) {
                self.c.help("E0257", span, "a `proof fn` parameter cannot be `&mut`: ghost code changes no executable state", "take the value or `&T`");
            } else {
                self.c.err("E0402", span, "spec function parameters cannot be `&mut`");
            }
        }

        #[summary("E0257: 유령 코드는 실행 상태를 읽기만 한다 (ADR-0062 §1)")]
        #[effects(alloc)]
        fn ghost_violation(self: &mut Body, span: source::Span, what: &str, fix: &str) -> () {
            self.c.help("E0257", span, types::cat2(what, " is not allowed in ghost code (a `proof fn` body or a `proof { .. }` block)").as_str(), fix);
        }

        #[summary("t가 값만 담는가 (ADR-0052 §2): 정수, bool, char, 그리고 그것들의 배열·구조체·열거형")]
        #[effects(alloc)]
        fn holds_values(self: &Body, t: &ast::TypeKind, seen: &mut Vec<String>, f: usize) -> bool
            decreases f,
        {
            if f == 0 {
                return false;
            }
            match t {
                ast::TypeKind::Int(q4_tk_int0) => true,
                ast::TypeKind::F64 => false,
                ast::TypeKind::Bool => true,
                ast::TypeKind::Unit => false,
                ast::TypeKind::Char => true,
                ast::TypeKind::String => false,
                ast::TypeKind::Str => false,
                ast::TypeKind::Array(e, q4_tk_array1) => self.holds_values(&e.kind, seen, f - 1),
                ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
                ast::TypeKind::Slice(q4_tk_slice0) => false,
                ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => false,
                ast::TypeKind::Named(path, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if !self.holds_values(&args[i].kind, seen, f - 1) { return false; } } let full: String = types::join(path.as_slice(), "::"); if full == "Option" || full == "Result" { return true; } let at: usize = match self.c.adts.find(full.as_str()) { None => { return false; }, Some(k) => k, }; if !types::add(seen, full.as_str()) { return true; } let sub: types::Subst = types::adt_subst(&self.c.adts.items[at], t); let parts: Vec<ast::TypeKind> = adt_parts(&self.c.adts.items[at].kind); for i in 0..parts.len() invariant 0 <= i && i <= parts.len(), { let p: ast::TypeKind = types::subst(&parts[i], &sub); if !self.holds_values(&p, seen, f - 1) { return false; } } true },
                ast::TypeKind::Vec(q4_tk_vec0) => false,
                ast::TypeKind::Box(q4_tk_box0) => false,
                ast::TypeKind::Param(q4_tk_param0) => false,
                ast::TypeKind::Never => false,
                ast::TypeKind::Error => false,
            }
        }

        #[summary("색인은 usize다")]
        #[effects(alloc)]
        fn index_usize(self: &mut Body, cx: &mut FnCtx, index: &ast::Expr, f: usize) -> ()
            decreases f * 3 + 2,
        {
            if f == 0 {
                return;
            }
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Int(ast::IntTy::Usize));
            let it: ast::TypeKind = self.expr(cx, index, &want, Mode::Exec, f - 1);
            self.expect_ty(&it, &ast::TypeKind::Int(ast::IntTy::Usize), index.span);
        }

        #[summary("묶음 tm이 주는 제네릭 데이터 타입 tp의 인스턴스. 매개변수가 아직 모르는 것이면 E0424")]
        #[effects(alloc)]
        fn instance(self: &mut Body, tp: &str, tm: &types::Subst, what: &str, span: source::Span) -> ast::TypeKind {
            let at: usize = match self.c.adts.find(tp) {
                None => { return ast::TypeKind::Error; },
                Some(i) => i,
            };
            let path: Vec<String> = refs::split_path(tp);
            let mut targs: Vec<ast::Type> = Vec::new();
            let mut missing: bool = false;
            for j in 0..self.c.adts.items[at].generics.len()
                invariant 0 <= j && j <= self.c.adts.items[at].generics.len(),
            {
                match types::sub_get(tm, self.c.adts.items[at].generics[j].name.as_str()) {
                    None => { missing = true; },
                    Some(t) => targs.push(types::ty(t)),
                }
            }
            if missing {
                let last: String = if path.len() > 0 {
                    path[path.len() - 1].clone()
                } else {
                    String::new()
                };
                self.c.help("E0424", span, types::cat3("the type of ", what, " is not known here").as_str(), types::cat3("give it a type: `let x: ", last.as_str(), "<..> = ..;`, or pass it where the type is written").as_str());
                return ast::TypeKind::Error;
            }
            ast::TypeKind::Named(path, targs)
        }

        #[summary("span의 break나 continue가 떠나는 루프: 레이블이 가리키는 것이나 가장 안쪽 것의 cx.loops 자리 (없으면 E0250, E0317)")]
        #[effects(alloc)]
        fn jump_target(self: &mut Body, cx: &FnCtx, label: &Option<ast::Ident>, span: source::Span, what: &str) -> Option<usize> {
            if cx.loops.len() == 0 {
                self.c.help("E0250", span, types::cat3("`", what, "` outside a loop").as_str(), "use it inside a `while`, `for` or `loop`; to leave the function, `return`");
                return None;
            }
            match label {
                None => Some(cx.loops.len() - 1),
                Some(l) => { let mut found: Option<usize> = None; let mut known: String = String::new(); for i in 0..cx.loops.len() invariant 0 <= i && i <= cx.loops.len(), { match &cx.loops[i].label { None => {}, Some(n) => { if n.as_str() == l.name.as_str() { found = Some(i); } if known.len() > 0 { known.push_str(", "); } known.push_str("'"); known.push_str(n.as_str()); }, } } if no_index(&found) { let msg: String = types::cat3("no loop labeled `'", l.name.as_str(), "` around this"); if known.len() == 0 { self.c.help("E0317", l.span, msg.as_str(), "label the loop: `'name: while ..`"); } else { self.c.help("E0317", l.span, msg.as_str(), types::cat2("the labels in scope are ", known.as_str()).as_str()); } } found },
            }
        }

        #[summary("풀어 쓰는 let (Rust의 습관, E0230): 필드의 타입으로 고칠 글을 만든다")]
        #[effects(alloc)]
        fn let_fields(self: &mut Body, cx: &mut FnCtx, l: &ast::LetFields, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            let it: ast::TypeKind = self.expr(cx, &l.init, &no, mode, f - 1);
            let decl: Fields = self.struct_fields(&it);
            let var: Option<String> = ast::var_name(&l.init);
            let mut lets: String = String::new();
            let mut n: usize = 0;
            for i in 0..l.fields.len()
                invariant 0 <= i && i <= l.fields.len() && n <= i,
            {
                let mut ty: ast::TypeKind = ast::TypeKind::Error;
                let mut have: bool = false;
                for j in 0..decl.fields.len()
                    invariant 0 <= j && j <= decl.fields.len(),
                {
                    if !have && decl.fields[j].name == l.fields[i].name {
                        ty = decl.fields[j].ty.clone();
                        have = true;
                    }
                }
                if have {
                    match &var {
                        None => {},
                        Some(v) => { if n > 0 { lets.push_str(" "); } lets.push_str("let "); lets.push_str(l.fields[i].name.as_str()); lets.push_str(": "); lets.push_str(types::text(&ty).as_str()); lets.push_str(" = "); lets.push_str(v.as_str()); lets.push_str("."); lets.push_str(l.fields[i].name.as_str()); lets.push_str(";"); n = n + 1; },
                    }
                }
                self.declare(cx, &l.fields[i], ty, false, false);
            }
            if n == l.fields.len() {
                self.c.fixed("E0230", l.span, "destructuring `let` is not allowed", "read each field into its own `let`", lets.as_str());
            } else {
                self.c.help("E0230", l.span, "destructuring `let` is not allowed", "read each field into its own `let`: `let x: T = p.x;`");
            }
        }

        #[summary("타입을 쓴 let")]
        #[effects(alloc)]
        fn let_typed(self: &mut Body, cx: &mut FnCtx, l: &ast::Let, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            self.check_value_type(&l.ty, "local variable type");
            if l.mutable && ghost_mode(mode) {
                self.ghost_violation(l.name.span, "`let mut`", "bind the value with `let`: ghost values do not change");
            } else if l.mutable && !exec_mode(mode) {
                self.c.err("E0503", l.name.span, "`let mut` is not allowed in a specification");
            }
            let mp: String = cx.mod_path.clone();
            let lty: ast::TypeKind = self.c.canon(&l.ty, mp.as_str(), true, 1000000000);
            match ast::var_name(&l.init) {
                None => {},
                Some(v) => self.typed_uses.push(TypedUse { name: v, lo: l.init.span.lo, ty: lty.clone() }),
            }
            let want: Option<ast::TypeKind> = Some(lty.clone());
            let t: ast::TypeKind = self.expr(cx, &l.init, &want, operand(mode), f - 1);
            if !self.deref_fix(&t, &lty, &l.init) {
                self.expect_ty(&t, &lty, l.init.span);
            }
            self.declare(cx, &l.name, lty, l.mutable, false);
        }

        #[summary("타입 없는 let (Rust의 습관, E0201): 타입을 미루어 고칠 글로 준다. 맨 정수 리터럴과 Vec::new()는 말하는 것이 적어 처음 쓰이는 자리에서 정한다 (settle_lets)")]
        #[effects(alloc)]
        fn let_untyped(self: &mut Body, cx: &mut FnCtx, l: &ast::Let, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            let t: ast::TypeKind = self.expr(cx, &l.init, &no, mode, f - 1);
            let vec_new: bool = vec_new_call(&l.init);
            if int_literal(&l.init) || vec_new {
                self.open_lets.push(OpenLet { name: l.name.clone(), vec_new: vec_new });
            }
            let msg: String = types::cat3("`let ", l.name.name.as_str(), "` requires an explicit type");
            if types::is_error(&t) {
                self.c.help("E0201", l.name.span, msg.as_str(), "add `: T` after the name");
            } else {
                let r: String = types::cat3(l.name.name.as_str(), ": ", types::text(&t).as_str());
                self.c.fixed("E0201", l.name.span, msg.as_str(), types::cat3("write `", r.as_str(), "`").as_str(), r.as_str());
            }
            self.declare(cx, &l.name, t, l.mutable, false);
        }

        #[summary("while이나 loop의 invariant와 decreases: invariant의 old(a)는 함수에 들어올 때의 a, decreases는 있어야 한다 (E0506, missing에). 밖의 입력이 끝을 정하는 nondet 함수의 loop는 없어도 된다 (ADR-0094)")]
        #[effects(alloc)]
        fn loop_clauses(self: &mut Body, cx: &mut FnCtx, invariants: &[ast::Expr], measure: &Option<ast::Expr>, missing: source::Span, kw: &str, f: usize) -> ()
            decreases f * 3 + 2,
        {
            if f == 0 {
                return;
            }
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            for i in 0..invariants.len()
                invariant 0 <= i && i <= invariants.len(),
            {
                let t: ast::TypeKind = self.expr(cx, &invariants[i], &wb, Mode::Spec(true), f - 1);
                self.expect_ty(&t, &ast::TypeKind::Bool, invariants[i].span);
            }
            match measure {
                None => { if kw == "loop" && cx.effect.nondet { return; } let msg: String = types::cat3("`", kw, "` has no `decreases` clause"); if kw == "loop" { self.c.help("E0506", missing, msg.as_str(), "add `decreases <expr>,` before the loop body; a loop that runs until outside input ends goes in a `nondet` function, where it may have none (its termination is then unproved, ADR-0094)"); } else { self.c.help("E0506", missing, msg.as_str(), "add `decreases <expr>,` before the loop body"); } },
                Some(d) => { let no: Option<ast::TypeKind> = None; let dt: ast::TypeKind = self.expr(cx, d, &no, Mode::Spec(false), f - 1); if !types::is_int(&dt) && !types::is_error(&dt) { self.c.err("E0401", d.span, types::cat3("`decreases` must be an integer, found `", types::text(&dt).as_str(), "`").as_str()); } },
            }
        }

        #[summary("갈래 하나의 몸: 패턴의 이름을 새 범위에 넣고 몸을 본다. ty는 지금까지의 갈래들의 타입")]
        #[effects(alloc)]
        fn match_arm(self: &mut Body, cx: &mut FnCtx, a: &ast::Arm, binds: &[ast::TypeKind], ty: &Option<ast::TypeKind>, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> Option<ast::TypeKind>
            decreases f * 3,
        {
            if f == 0 {
                return ty.clone();
            }
            let scope: Vec<Local> = Vec::new();
            cx.scopes.push(scope);
            for pos in 0..a.pat.binds.len()
                invariant 0 <= pos && pos <= a.pat.binds.len(),
            {
                match &a.pat.binds[pos] {
                    None => {},
                    Some(id) => { let t: ast::TypeKind = if pos < binds.len() { binds[pos].clone() } else { ast::TypeKind::Error }; self.declare(cx, id, t, false, false); },
                }
            }
            let hint: Option<ast::TypeKind> = match ty {
                None => expected.clone(),
                Some(h) => { if types::is_error(h) || is_never(h) { expected.clone() } else { Some(h.clone()) } },
            };
            let bt: ast::TypeKind = self.expr(cx, &a.body, &hint, mode, f - 1);
            let mut out: Option<ast::TypeKind> = Some(bt.clone());
            match ty {
                None => {},
                Some(cur) => { let wider: bool = !exec_mode(mode) && !has_type(expected) && widens(cur, &bt); if !wider && !is_never(cur) { self.expect_ty(&bt, cur, a.body.span); out = Some(cur.clone()); } },
            }
            cx.scopes.pop();
            out
        }

        #[summary("갈래들이 변형을 덮는가: 변형마다 갈래 하나(E0426), 와일드카드 없이(E0224·E0225), 빠진 변형 없이, 선언 순서로")]
        #[effects(alloc)]
        fn match_cover(self: &mut Body, cx: &FnCtx, scrut: &ast::Expr, arms: &[ast::Arm], kinds: &[Option<usize>], tp: &str, vs: &[types::VariantSig], span: source::Span, wildcard: bool, unresolved: bool) -> () {
            let mut seen: Vec<usize> = Vec::new();
            let mut dup: bool = false;
            let mut prev: Option<usize> = None;
            let mut disorder: bool = false;
            let mut at: source::Span = span;
            for i in 0..arms.len()
                invariant 0 <= i && i <= arms.len(),
            {
                if i < kinds.len() {
                    match kinds[i] {
                        None => {},
                        Some(k) => { if has_usize(seen.as_slice(), k) { dup = true; if k < vs.len() { let vt: String = variant_text(tp, vs[k].name.as_str(), cx.mod_path.as_str()); self.c.help("E0426", arms[i].pat.span, types::cat3("a second arm for `", vt.as_str(), "`").as_str(), "one arm per variant: merge the two"); } } else { seen.push(k); } match prev { None => {}, Some(p) => { if p > k && !disorder { disorder = true; at = arms[i].pat.span; } }, } prev = Some(k); },
                    }
                }
            }
            let mut missing: Vec<String> = Vec::new();
            let mut order: Vec<String> = Vec::new();
            for j in 0..vs.len()
                invariant 0 <= j && j <= vs.len(),
            {
                let vt2: String = variant_text(tp, vs[j].name.as_str(), cx.mod_path.as_str());
                if !has_usize(seen.as_slice(), j) {
                    missing.push(variant_pat(vt2.as_str(), vs[j].tys.len()));
                }
                order.push(vt2);
            }
            self.wildcard_arms(cx, scrut, arms, kinds, tp, vs, span);
            if !wildcard && !unresolved && missing.len() > 0 {
                self.c.help("E0426", span, types::cat3("`match` misses `", types::join(missing.as_slice(), "`, `").as_str(), "`").as_str(), types::cat3("add an arm for each: `", types::join(missing.as_slice(), " => .., ").as_str(), " => ..`").as_str());
            }
            if !dup && disorder {
                self.c.help("E0426", at, "`match` arms are not in declaration order", types::cat2("order the arms as declared: ", types::join(order.as_slice(), ", ").as_str()).as_str());
            }
        }

        #[summary("match s { E::A => e0, E::B(x, _) => e1 }: 변형마다 갈래 하나를 선언 순서로, 페이로드 자리마다 새 이름이나 `_`, 갈래들은 한 타입 (ADR-0026 §3). 참조를 match하면 묶는 이름은 페이로드의 참조다 (ADR-0055)")]
        #[effects(alloc)]
        fn match_expr(self: &mut Body, cx: &mut FnCtx, scrut: &ast::Expr, arms: &[ast::Arm], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let st0: ast::TypeKind = match ref_of(scrut) {
                None => self.expr(cx, scrut, &no, operand(mode), f - 1),
                Some(x) => { let mutable: bool = ref_mutable(scrut); if mutable && ghost_mode(mode) { self.ghost_violation(scrut.span, "`&mut`", "match the value or `&` it: ghost code does not write"); } let t: ast::TypeKind = self.expr(cx, &x, &no, operand(mode), f - 1); let rt: ast::TypeKind = if types::is_error(&t) { ast::TypeKind::Error } else { ast::TypeKind::Ref(mutable, types::boxed(t.clone())) }; self.types.insert(span_key(scrut.span).as_str(), rt.clone()); rt },
            };
            let mut by_ref: bool = false;
            let mut by_mut: bool = false;
            let mut st: ast::TypeKind = st0.clone();
            match ref_inner(&st0) {
                None => {},
                Some(inner) => { if self.match_variants(&inner).found { by_ref = true; by_mut = types::is_ref_mut(&st0); st = inner.clone(); } },
            }
            if by_mut {
                let root: Option<String> = match ref_of(scrut) {
                    None => root_name(scrut, 1000000000),
                    Some(x2) => root_name(&x2, 1000000000),
                };
                match root {
                    None => {},
                    Some(r) => { for i in 0..arms.len() invariant 0 <= i && i <= arms.len(), { if mentions_strict(&arms[i].body, r.as_str(), 1000000000) { self.c.help("E0410", arms[i].body.span, types::cat3("`", r.as_str(), "` is used while the `match` borrows it").as_str(), "use the bindings of the arm instead"); } } },
                }
            }
            let mv: Variants = self.match_variants(&st);
            if !mv.found && !types::is_error(&st) {
                let msg: String = types::cat3("`match` needs an enum value, found `", types::text(&st).as_str(), "`");
                let through: Option<String> = match ref_inner(&st) {
                    None => None,
                    Some(inner2) => { if self.match_variants(&inner2).found { ast::var_name(scrut) } else { None } },
                };
                match through {
                    None => self.c.help("E0423", scrut.span, msg.as_str(), "branch with `if` on a condition"),
                    Some(v) => self.c.fixed("E0423", scrut.span, msg.as_str(), "match the value the reference points to", types::cat2("*", v.as_str()).as_str()),
                }
            }
            let mut kinds: Vec<Option<usize>> = Vec::new();
            let mut bind_tys: Vec<Vec<ast::TypeKind>> = Vec::new();
            let mut wildcard: bool = false;
            let mut unresolved: bool = false;
            for j in 0..arms.len()
                invariant 0 <= j && j <= arms.len() && kinds.len() == j && bind_tys.len() == j,
            {
                let mut k: Option<usize> = None;
                let mut tys: Vec<ast::TypeKind> = Vec::new();
                if !written(&arms[j].pat) || wild_name(&arms[j].pat) {
                    wildcard = true;
                } else if mv.found {
                    match self.arm_variant(cx, &arms[j].pat, mv.path.as_str(), mv.vs.as_slice(), &st) {
                        None => { unresolved = true; },
                        Some(kk) => { k = Some(kk); tys = self.arm_binds(cx.mod_path.as_str(), &arms[j].pat, mv.path.as_str(), mv.vs.as_slice(), kk, by_ref, by_mut); },
                    }
                }
                kinds.push(k);
                bind_tys.push(tys);
            }
            if mv.found {
                self.match_cover(cx, scrut, arms, kinds.as_slice(), mv.path.as_str(), mv.vs.as_slice(), span, wildcard, unresolved);
            }
            let mut first: usize = 0;
            if !has_type(expected) {
                let mut found: bool = false;
                for q in 0..arms.len()
                    invariant 0 <= q && q <= arms.len() && first <= q,
                {
                    if !found && !untyped_literal(&arms[q].body, 1000000000) {
                        found = true;
                        first = q;
                    }
                }
            }
            let mut ty: Option<ast::TypeKind> = match expected {
                None => None,
                Some(e) => { if types::is_error(e) { None } else { Some(e.clone()) } },
            };
            for step in 0..arms.len()
                invariant 0 <= step && step <= arms.len() && bind_tys.len() == arms.len(),
            {
                let at: usize = if step == 0 {
                    first
                } else if step - 1 < first {
                    step - 1
                } else {
                    step
                };
                if at < arms.len() {
                    ty = self.match_arm(cx, &arms[at], bind_tys[at].as_slice(), &ty, expected, mode, f - 1);
                }
            }
            match ty {
                None => ast::TypeKind::Error,
                Some(done) => done,
            }
        }

        #[summary("t 값의 match가 덮을 변형들 (선언 순서)")]
        #[effects(alloc)]
        fn match_variants(self: &Body, t: &ast::TypeKind) -> Variants {
            let path: String = match types::named_path(t) {
                None => { return no_variants(); },
                Some(p) => p,
            };
            let args: Vec<ast::TypeKind> = types::named_args(t);
            if named_one(t, "Option") && args.len() == 1 {
                let empty: Vec<ast::TypeKind> = Vec::new();
                return Variants { found: true, path: String::from("Option"), vs: two_variants("None", empty, "Some", one_type(&args[0])) };
            }
            if named_one(t, "Result") && args.len() == 2 {
                return Variants { found: true, path: String::from("Result"), vs: two_variants("Ok", one_type(&args[0]), "Err", one_type(&args[1])) };
            }
            let mut vs: Vec<types::VariantSig> = Vec::new();
            let at: usize = match self.c.adts.find(path.as_str()) {
                None => { return no_variants(); },
                Some(i) => i,
            };
            let m: types::Subst = types::adt_subst(&self.c.adts.items[at], t);
            let mut is_enum: bool = false;
            match &self.c.adts.items[at].kind {
                types::AdtKind::Struct(q4_fs) => {},
                types::AdtKind::Enum(xs) => { is_enum = true; for i2 in 0..xs.len() invariant 0 <= i2 && i2 <= xs.len(), { let mut tys: Vec<ast::TypeKind> = Vec::new(); for j in 0..xs[i2].tys.len() invariant 0 <= j && j <= xs[i2].tys.len(), { tys.push(types::subst(&xs[i2].tys[j], &m)); } vs.push(types::VariantSig { name: xs[i2].name.clone(), tys: tys }); } },
            }
            Variants { found: is_enum, path: self.c.adts.items[at].path.clone(), vs: vs }
        }

        #[summary("decreases의 타입: 정수, 재귀 열거형, 또는 자기를 담는 구조체")]
        #[effects(alloc)]
        fn measure_type(self: &mut Body, t: &ast::TypeKind, span: source::Span) -> () {
            if types::is_int(t) || types::is_error(t) {
                return;
            }
            let outer: ast::TypeKind = match ref_inner(t) {
                None => t.clone(),
                Some(inner) => inner,
            };
            let v: ast::TypeKind = match box_inner(&outer) {
                None => outer.clone(),
                Some(boxed) => boxed,
            };
            let is_enum: bool = match types::named_path(&v) {
                None => false,
                Some(path) => path == "Option" || path == "Result" || self.enum_adt(path.as_str()),
            };
            let reaches: bool = self.reaches_itself(&v);
            if is_enum && reaches || self.struct_cycle(&v) {
                return;
            }
            let msg: String = types::cat3("`decreases` must be an integer, a recursive enum or a recursive struct, found `", types::text(t).as_str(), "`");
            if is_named(&v) && reaches {
                self.c.help("E0401", span, msg.as_str(), "decrease the enum-valued part that holds the recursion (a field such as `n.next`)");
            } else {
                self.c.help("E0401", span, msg.as_str(), "an integer, or a value of a recursive enum or of a struct that holds itself in a `Vec` (its structural size)");
            }
        }

        #[summary("대입의 대상을 검사하고 그 타입을 낸다")]
        #[effects(alloc)]
        fn place(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, f: usize) -> ast::TypeKind
            decreases f * 3 + 2,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            match &target.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Float(q4_ek_float0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::StrLit(q4_ek_strlit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::CharLit(q4_ek_charlit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Bool(q4_ek_bool0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Unit => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Var(id) => self.place_var(cx, target, id),
                ast::ExprKind::Call(q4_ek_call0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Method(q4_ek_method0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Index(base, index) => self.place_index(cx, target, &**base, &**index, f),
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::If(q4_ek_if0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Block(q4_ek_block0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Array(q4_ek_array0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Repeat(q4_ek_repeat0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Old(q4_ek_old0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Quant(q4_ek_quant0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Trigger(q4_ek_trigger0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Closure(q4_ek_closure0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::StructLit(q4_ek_structlit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Path(q4_ek_path0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Deref(q4_ek_deref0) => self.place_path(cx, target, f),
                ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => self.place_path(cx, target, f),
                ast::ExprKind::Match(q4_ek_match0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Return(q4_ek_return0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Try(q4_ek_try0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Loop(q4_ek_loop0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Break(q4_ek_break0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Continue(q4_ek_continue0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Range(q4_ek_range0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Error => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
            }
        }

        #[summary("원소에의 대입 base[index] = v. base가 필드·원소·`*`면 그 자리를 따라가고(s.w[i], g[i][j], (*b)[i]), 아니면 변수여야 한다")]
        #[effects(alloc)]
        fn place_index(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, base: &ast::Expr, index: &ast::Expr, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if nested_place(&base.kind) {
                let p: Place = self.place_of(cx, base, f - 1);
                self.types.insert(span_key(base.span).as_str(), p.ty.clone());
                self.index_usize(cx, index, f - 1);
                let bad: bool = types::is_error(&p.ty);
                let writable: bool = p.writable;
                let indexable: bool = has_type(&elem_of(&p.ty));
                let q: Place = self.elem_place(base.span, p);
                if !indexable {
                    return ast::TypeKind::Error;
                }
                if !writable && !bad {
                    self.c.help("E0408", target.span, "this place cannot be assigned", "assign through a `let mut` local or a `&mut` parameter");
                }
                return q.ty;
            }
            let id: String = match ast::var_name(base) {
                None => { self.c.err("E0408", target.span, "only elements of a variable, a field or an element can be assigned"); return ast::TypeKind::Error; },
                Some(n) => n,
            };
            let l: Local = match lookup(cx, id.as_str()) {
                None => { self.unknown_local(cx, id.as_str(), base.span); return ast::TypeKind::Error; },
                Some(found) => found,
            };
            let writable: bool = if is_array(&l.ty) || is_vec(&l.ty) {
                l.mutable
            } else {
                types::is_ref_mut(&l.ty)
            };
            self.index_usize(cx, index, f - 1);
            match elem_of(&l.ty) {
                None => { self.c.err("E0407", base.span, types::cat5("`", id.as_str(), "` has type `", types::text(&l.ty).as_str(), "` and cannot be indexed").as_str()); ast::TypeKind::Error },
                Some(elem) => { if !writable { self.c.err("E0408", target.span, types::cat5("elements of `", id.as_str(), "` cannot be assigned (`", types::text(&l.ty).as_str(), "`)").as_str()); } elem },
            }
        }

        #[summary("필드나 `*` 대상 아래의 자리의 타입과 쓸 수 있는가: let mut 지역 변수, &mut 매개변수, 쓸 수 있는 원소. 뒤 단계가 자리의 타입도 읽으므로 적어 둔다")]
        #[effects(alloc)]
        fn place_of(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, f: usize) -> Place
            decreases f * 3 + 1,
        {
            if f == 0 {
                return Place { ty: ast::TypeKind::Error, writable: false };
            }
            let p: Place = self.place_of_inner(cx, e, f);
            let key: String = span_key(e.span);
            if !self.types.has(key.as_str()) {
                self.types.insert(key.as_str(), p.ty.clone());
            }
            p
        }

        #[effects(alloc)]
        fn place_of_inner(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, f: usize) -> Place
            decreases f * 3,
        {
            if f == 0 {
                return Place { ty: ast::TypeKind::Error, writable: false };
            }
            match &e.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Float(q4_ek_float0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::StrLit(q4_ek_strlit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::CharLit(q4_ek_charlit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Bool(q4_ek_bool0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Unit => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Var(id) => self.var_place(cx, id),
                ast::ExprKind::Call(q4_ek_call0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Method(q4_ek_method0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Index(base, index) => { let p: Place = self.place_of(cx, &**base, f - 1); self.index_usize(cx, &**index, f - 1); self.elem_place(base.span, p) },
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::If(q4_ek_if0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Block(q4_ek_block0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Array(q4_ek_array0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Repeat(q4_ek_repeat0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Old(q4_ek_old0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Quant(q4_ek_quant0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Trigger(q4_ek_trigger0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Closure(q4_ek_closure0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::StructLit(q4_ek_structlit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Path(q4_ek_path0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Deref(x) => { let p: Place = self.place_of(cx, &**x, f - 1); self.deref_place(e.span, p) },
                ast::ExprKind::Field(base, name) => { self.deref_field(e, &**base, name); let p: Place = self.place_of(cx, &**base, f - 1); Place { ty: self.field_type_of(&p.ty, name), writable: p.writable } },
                ast::ExprKind::Match(q4_ek_match0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Return(q4_ek_return0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Try(q4_ek_try0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Loop(q4_ek_loop0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Break(q4_ek_break0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Continue(q4_ek_continue0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Range(q4_ek_range0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Error => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
            }
        }

        #[summary("필드나 `*`인 대입의 대상")]
        #[effects(alloc)]
        fn place_path(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let p: Place = self.place_of(cx, target, f - 1);
            if !p.writable && !types::is_error(&p.ty) {
                self.c.help("E0408", target.span, "this place cannot be assigned", "assign through a `let mut` local or a `&mut` parameter");
            }
            p.ty
        }

        #[summary("변수에의 대입: 바꿀 수 있는 지역 변수여야 한다 (E0408)")]
        #[effects(alloc)]
        fn place_var(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, id: &ast::Ident) -> ast::TypeKind {
            match lookup(cx, id.name.as_str()) {
                None => { self.unknown_local(cx, id.name.as_str(), id.span); ast::TypeKind::Error },
                Some(l) => { if !l.mutable { let msg: String = types::cat3("`", id.name.as_str(), "` is not mutable"); if l.is_param { self.c.help("E0408", target.span, msg.as_str(), "copy the parameter into a `let mut` local"); } else if types::has(cx.for_vars.as_slice(), id.name.as_str()) { self.c.help("E0408", target.span, msg.as_str(), "a `for` variable steps by itself; copy it into a `let mut` local to change the copy"); } else { self.c.help("E0408", target.span, msg.as_str(), "declare it with `let mut`"); } } l.ty },
            }
        }

        #[summary("proof { .. } (ADR-0062 §1): 실행 코드 안의 유령 문장. 그 let은 블록 안의 것이라 유령 값이 실행 코드에 닿지 않는다")]
        #[effects(alloc)]
        fn proof_stmt(self: &mut Body, cx: &mut FnCtx, p: &ast::ProofBlock, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            match mode {
                Mode::Exec => {},
                Mode::Spec(q4_old) => self.c.help("E0503", p.span, "a `proof` block is not allowed in a specification", "call lemmas from a `proof { .. }` block of executable code, or from a `proof fn`"),
                Mode::Ghost => self.ghost_violation(p.span, "a `proof` block", "this is ghost code already: write the statements without `proof { .. }`"),
            }
            let was: bool = cx.ghost;
            cx.ghost = true;
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Unit);
            let t: ast::TypeKind = self.block(cx, &p.body, &wu, Mode::Ghost, f - 1);
            cx.ghost = was;
            self.expect_ty(&t, &ast::TypeKind::Unit, p.body.span);
        }

        #[summary("t가 자기 자신에 닿는가 (값이 담는 타입을 따라)")]
        #[effects(alloc)]
        fn reaches_itself(self: &Body, t: &ast::TypeKind) -> bool {
            let target: String = types::text(t);
            let mut seen: Vec<String> = Vec::new();
            let mut todo: Vec<ast::TypeKind> = self.components(t);
            let mut fuel: usize = 1000000000;
            while todo.len() > 0 && fuel > 0
                decreases fuel,
            {
                fuel = fuel - 1;
                match todo.pop() {
                    None => {},
                    Some(c) => { let k: String = types::text(&c); if k == target { return true; } if types::add(&mut seen, k.as_str()) { let more: Vec<ast::TypeKind> = self.components(&c); push_all(&mut todo, more.as_slice()); } },
                }
            }
            false
        }

        #[summary("호출의 경로가 가리키는 함수: 이 단위의 타입이나 trait의 함수 `T::f`, 이 단위의 함수나 내장 함수 `f`, 온 경로")]
        #[effects(alloc)]
        fn resolve(self: &Body, path: &[ast::Ident], mp: &str) -> Option<String> {
            if path.len() == 2 {
                let owner: String = types::cat3(mp, "::", path[0].name.as_str());
                if self.c.adts.has(owner.as_str()) || self.c.traits.has(owner.as_str()) {
                    let full: String = types::cat3(owner.as_str(), "::", path[1].name.as_str());
                    if self.c.fns.has(full.as_str()) {
                        return Some(full);
                    }
                }
            }
            if path.len() == 1 {
                let local: String = types::cat3(mp, "::", path[0].name.as_str());
                if self.c.fns.has(local.as_str()) {
                    return Some(local);
                }
                match self.c.fns.find(path[0].name.as_str()) {
                    None => {},
                    Some(i) => { if self.c.fns.items[i].builtin { return Some(path[0].name.clone()); } },
                }
                return None;
            }
            let mut p: String = String::new();
            for i in 0..path.len()
                invariant 0 <= i && i <= path.len(),
            {
                if i > 0 {
                    p.push_str("::");
                }
                p.push_str(path[i].name.as_str());
            }
            if self.c.fns.has(p.as_str()) {
                return Some(p);
            }
            None
        }

        #[summary("타입 없는 let의 E0201을 고친다 (백로그 2N-12): 타입은 그 변수가 뒤에서 처음 쓰이는 자리에서 온다. 산술·비교·비트 연산의 다른 쪽(리터럴이 아닌 것), 색인(usize), 함수의 인자(매개변수의 타입), Vec이면 첫 push(원소의 타입). 그런 자리가 없으면 초기값의 타입을 둔다")]
        #[effects(alloc)]
        fn settle_lets(self: &mut Body, d: &ast::FnDef, mp: &str) -> () {
            let open: Vec<OpenLet> = self.open_lets.clone();
            self.open_lets = Vec::new();
            let typed: Vec<TypedUse> = self.typed_uses.clone();
            self.typed_uses = Vec::new();
            let spec_at: Vec<source::Span> = self.spec_at.clone();
            self.spec_at = Vec::new();
            if open.len() == 0 {
                return;
            }
            let mut body: ast::FnDef = d.clone();
            for o in 0..open.len()
                invariant 0 <= o && o <= open.len(),
            {
                let facts: Vec<Fact> = Vec::new();
                let calls: Vec<CallUse> = Vec::new();
                let mut uses: Uses = Uses { name: open[o].name.name.clone(), after: open[o].name.span.hi, vec_new: open[o].vec_new, spec_at: spec_at.clone(), facts: facts, calls: calls };
                ast::fn_exprs_mut::<Uses>(&mut body, &mut uses, true, 1000000000);
                let mut best: Best = Best { found: false, lo: 0, ty: ast::TypeKind::Error };
                for i in 0..uses.facts.len()
                    invariant 0 <= i && i <= uses.facts.len(),
                {
                    if uses.facts[i].kind == 0 {
                        if !uses.facts[i].literal {
                            match self.types.find(span_key(uses.facts[i].other).as_str()) {
                                None => {},
                                Some(at) => { if types::is_int(&self.types.items[at]) { better(&mut best, uses.facts[i].lo, &self.types.items[at]); } },
                            }
                        }
                    } else if uses.facts[i].kind == 1 {
                        better(&mut best, uses.facts[i].lo, &ast::TypeKind::Int(ast::IntTy::Usize));
                    } else {
                        match self.types.find(span_key(uses.facts[i].other).as_str()) {
                            None => {},
                            Some(at) => { let v: ast::TypeKind = ast::TypeKind::Vec(Box::new(ast::Type { kind: self.types.items[at].clone(), span: uses.facts[i].other })); better(&mut best, uses.facts[i].lo, &v); },
                        }
                    }
                }
                for i in 0..typed.len()
                    invariant 0 <= i && i <= typed.len(),
                {
                    if typed[i].name == open[o].name.name && typed[i].lo > open[o].name.span.hi && fits_let(&typed[i].ty, open[o].vec_new) {
                        better(&mut best, typed[i].lo, &typed[i].ty);
                    }
                }
                for i in 0..uses.calls.len()
                    invariant 0 <= i && i <= uses.calls.len(),
                {
                    match self.resolve(uses.calls[i].path.as_slice(), mp) {
                        None => {},
                        Some(p) => { match self.c.fns.find(p.as_str()) { None => {}, Some(at) => { let k: usize = uses.calls[i].k; if k < self.c.fns.items[at].params.len() && fits_let(&self.c.fns.items[at].params[k], open[o].vec_new) { better(&mut best, uses.calls[i].lo, &self.c.fns.items[at].params[k]); } }, } },
                    }
                }
                if best.found {
                    let r: String = types::cat3(open[o].name.name.as_str(), ": ", types::text(&best.ty).as_str());
                    settle_diag(&mut self.c.diags, &open[o].name, r.as_str());
                }
            }
        }

        #[summary("check_slots의 한 자리의 값을 본다: 인자 at, 또는 필드 at의 값")]
        #[effects(alloc)]
        fn slot_expr(self: &mut Body, cx: &mut FnCtx, args: &[ast::Expr], fields: &[ast::FieldInit], by_field: bool, at: usize, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if by_field {
                if at < fields.len() {
                    return self.expr(cx, &fields[at].value, expected, mode, f - 1);
                }
            } else {
                if at < args.len() {
                    return self.expr(cx, &args[at], expected, mode, f - 1);
                }
            }
            ast::TypeKind::Error
        }

        #[summary("E0503: 명세는 식 하나이고 루프가 없다")]
        #[effects(alloc)]
        fn spec_loop(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0503", span, "loops are not allowed in a specification", "state the property with `forall`, or with a recursive spec fn and `decreases`");
        }

        #[summary("E0402: 명세는 String을 그 &str로 본다 (ADR-0050 §3)")]
        #[effects(alloc)]
        fn spec_string(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0402", span, "a spec function cannot take or return a `String`", "take `&str` and pass `s.as_str()`");
        }

        #[summary("E0402: 명세는 Vec을 조각으로 본다 (ADR-0031 §3)")]
        #[effects(alloc)]
        fn spec_vec(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0402", span, "a spec function cannot take or return a `Vec`", "take `&[T]` and pass `v.as_slice()`");
        }

        #[summary("문장 하나")]
        #[effects(alloc)]
        fn stmt(self: &mut Body, cx: &mut FnCtx, s: &ast::Stmt, mode: Mode, f: usize) -> ()
            decreases f * 3 + 1,
        {
            if f == 0 {
                return;
            }
            match s {
                ast::Stmt::Let(sl) => { if sl.ty_missing { self.let_untyped(cx, sl, mode, f); } else { self.let_typed(cx, sl, mode, f); } },
                ast::Stmt::Assign(sa) => self.assign_stmt(cx, sa, mode, f),
                ast::Stmt::While(sw) => self.while_stmt(cx, sw, mode, f),
                ast::Stmt::For(sf) => self.for_stmt(cx, sf, mode, f),
                ast::Stmt::Assert(sc) => self.assert_stmt(cx, sc, mode, f),
                ast::Stmt::Assume(su) => self.assume_stmt(cx, su, mode, f),
                ast::Stmt::Proof(sp) => self.proof_stmt(cx, sp, mode, f),
                ast::Stmt::LetFields(sd) => self.let_fields(cx, sd, mode, f),
                ast::Stmt::Expr(se) => { let no: Option<ast::TypeKind> = None; let unused: ast::TypeKind = self.expr(cx, se, &no, mode, f - 1); },
            }
        }

        #[summary("구조체 값 t가 구조체만을 지나(필드, Vec, 배열, Box) 자기를 담는가 (ADR-0047 §3)")]
        #[effects(alloc)]
        fn struct_cycle(self: &Body, t: &ast::TypeKind) -> bool {
            let v: ast::TypeKind = match ref_inner(t) {
                None => t.clone(),
                Some(inner) => inner,
            };
            let target: String = types::text(&v);
            let mut seen: Vec<String> = Vec::new();
            let mut todo: Vec<ast::TypeKind> = self.struct_parts(&v);
            let mut fuel: usize = 1000000000;
            while todo.len() > 0 && fuel > 0
                decreases fuel,
            {
                fuel = fuel - 1;
                match todo.pop() {
                    None => {},
                    Some(c) => { let k: String = types::text(&c); if k == target { return true; } if types::add(&mut seen, k.as_str()) { let more: Vec<ast::TypeKind> = self.struct_parts(&c); push_all(&mut todo, more.as_slice()); } },
                }
            }
            false
        }

        #[summary("타입 t가 가리키는 구조체의 경로와 필드 (참조 하나와 Box들을 지나: p: &Point나 p: &Box<Point>의 p.x). 구조체가 아니면 found가 거짓")]
        #[effects(alloc)]
        fn struct_fields(self: &Body, t: &ast::TypeKind) -> Fields {
            let mut out: Vec<types::FieldSig> = Vec::new();
            let mut cur: ast::TypeKind = match ref_inner(t) {
                None => t.clone(),
                Some(inner) => inner,
            };
            let mut more: bool = true;
            let mut fuel: usize = 1000000000;
            while more && fuel > 0
                decreases fuel,
            {
                match box_inner(&cur) {
                    None => { more = false; },
                    Some(inner) => { cur = inner; },
                }
                fuel = fuel - 1;
            }
            let path: String = match types::named_path(&cur) {
                None => { return Fields { found: false, path: String::new(), fields: out }; },
                Some(p) => p,
            };
            let at: usize = match self.c.adts.find(path.as_str()) {
                None => { return Fields { found: false, path: String::new(), fields: out }; },
                Some(i) => i,
            };
            let m: types::Subst = types::adt_subst(&self.c.adts.items[at], &cur);
            let mut is_struct: bool = false;
            match &self.c.adts.items[at].kind {
                types::AdtKind::Struct(fs) => { is_struct = true; for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { out.push(types::FieldSig { name: fs[i].name.clone(), ty: types::subst(&fs[i].ty, &m) }); } },
                types::AdtKind::Enum(q4_vs) => {},
            }
            Fields { found: is_struct, path: self.c.adts.items[at].path.clone(), fields: out }
        }

        #[summary("t가 구조체면 그 필드 (참조나 Box를 지나지 않는다)")]
        #[effects(alloc)]
        fn struct_fields_of(self: &Body, t: &ast::TypeKind) -> Fields {
            if is_ref(t) || is_box(t) {
                let none: Vec<types::FieldSig> = Vec::new();
                return Fields { found: false, path: String::new(), fields: none };
            }
            self.struct_fields(t)
        }

        #[summary("T { f: e, .. }: 필드마다 한 번(E0422), 선언 순서로(E0434), `..base`는 없다(E0223)")]
        #[effects(alloc)]
        fn struct_lit(self: &mut Body, cx: &mut FnCtx, sl: &ast::StructLit, expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            let n: usize = sl.path.len();
            if f == 0 || n == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let name: String = decls::path_text(sl.path.as_slice());
            let mut tp: String = String::new();
            let mut state: u8 = 0;
            let mut fs: Vec<types::FieldSig> = Vec::new();
            match self.c.type_path(sl.path.as_slice(), cx.mod_path.as_str()) {
                None => {},
                Some(p) => { state = 2; match self.c.adts.find(p.as_str()) { None => {}, Some(at) => { match &self.c.adts.items[at].kind { types::AdtKind::Struct(xs) => { state = 1; fs = xs.clone(); }, types::AdtKind::Enum(q4_vs) => {}, } }, } tp = p; },
            }
            if state == 2 {
                self.c.help("E0422", span, types::cat3("`", name.as_str(), "` is an enum, not a struct").as_str(), types::cat3("build a variant: `", name.as_str(), "::V(..)`").as_str());
            }
            if state == 0 {
                let tn: Vec<String> = names_of(sl.path.as_slice());
                let d: diag::Diag = self.c.unknown_type(tn.as_slice(), decls::span_to(sl.path[0].span, sl.path[n - 1].span), cx.mod_path.as_str());
                self.c.diags.push(d);
            }
            if state != 1 {
                for i in 0..sl.fields.len()
                    invariant 0 <= i && i <= sl.fields.len(),
                {
                    self.expr(cx, &sl.fields[i].value, &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            let fnames: Vec<String> = field_names(fs.as_slice());
            let ps: Vec<types::TParam> = match self.c.adts.find(tp.as_str()) {
                None => Vec::new(),
                Some(at2) => self.c.adts.items[at2].generics.clone(),
            };
            let mut tm: types::Subst = self.expected_args(tp.as_str(), expected);
            let mut slots: Vec<Slot> = Vec::new();
            let mut given: Vec<String> = Vec::new();
            let mut order: Vec<usize> = Vec::new();
            for j in 0..sl.fields.len()
                invariant 0 <= j && j <= sl.fields.len(),
            {
                if types::has(given.as_slice(), sl.fields[j].name.name.as_str()) {
                    self.c.help("E0422", sl.fields[j].name.span, types::cat3("field `", sl.fields[j].name.name.as_str(), "` is given more than once").as_str(), "give each field once");
                } else {
                    given.push(sl.fields[j].name.name.clone());
                }
                match decls::index_of(fnames.as_slice(), sl.fields[j].name.name.as_str()) {
                    None => { let msg: String = types::cat5("`", tp.as_str(), "` has no field `", sl.fields[j].name.name.as_str(), "`"); match types::closest(sl.fields[j].name.name.as_str(), fnames.as_slice()) { None => self.c.help("E0306", sl.fields[j].name.span, msg.as_str(), types::cat4("fields of `", tp.as_str(), "`: ", types::join(fnames.as_slice(), ", ").as_str()).as_str()), Some(near) => self.c.fixed("E0306", sl.fields[j].name.span, msg.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()), } self.expr(cx, &sl.fields[j].value, &no, mode, f - 1); },
                    Some(k) => { if k < fs.len() { slots.push(Slot { at: j, ty: fs[k].ty.clone() }); order.push(k); } },
                }
            }
            let noargs: Vec<ast::Expr> = Vec::new();
            self.check_slots(cx, ps.as_slice(), &mut tm, noargs.as_slice(), sl.fields.as_slice(), true, slots.as_slice(), mode, f - 1);
            let whole: ast::TypeKind = if ps.len() == 0 {
                let targs: Vec<ast::Type> = Vec::new();
                ast::TypeKind::Named(refs::split_path(tp.as_str()), targs)
            } else {
                self.instance(tp.as_str(), &tm, types::cat3("`", sl.path[n - 1].name.as_str(), " { .. }`").as_str(), span)
            };
            let has_rest: bool = match &sl.rest {
                None => false,
                Some(q4_r) => true,
            };
            if !has_rest && order.len() == sl.fields.len() && given.len() == sl.fields.len() && unsorted(order.as_slice()) {
                let mut sorted: Vec<String> = Vec::new();
                for a in 0..fnames.len()
                    invariant 0 <= a && a <= fnames.len(),
                {
                    match field_at(sl.fields.as_slice(), fnames[a].as_str()) {
                        None => {},
                        Some(b) => sorted.push(types::cat3(fnames[a].as_str(), ": ", fmt::expr_text(&sl.fields[b].value).as_str())),
                    }
                }
                self.c.fixed("E0434", span, types::cat5("the fields of `", tp.as_str(), "` are given out of their declaration order (", types::join(fnames.as_slice(), ", ").as_str(), ")").as_str(), "give the fields in declaration order (they are evaluated in the order written)", types::cat4(name.as_str(), " { ", types::join(sorted.as_slice(), ", ").as_str(), " }").as_str());
            }
            match &sl.rest {
                None => { let mut missing: Vec<String> = Vec::new(); for c in 0..fnames.len() invariant 0 <= c && c <= fnames.len(), { if !types::has(given.as_slice(), fnames[c].as_str()) { missing.push(fnames[c].clone()); } } if missing.len() > 0 { self.c.help("E0422", span, types::cat5("missing field(s) `", types::join(missing.as_slice(), "`, `").as_str(), "` of `", tp.as_str(), "`").as_str(), "give every field a value (ADR-0026: no `..` update syntax)"); } },
                Some(r) => { let hint: Option<ast::TypeKind> = Some(whole.clone()); let rt: ast::TypeKind = self.expr(cx, &**r, &hint, mode, f - 1); self.expect_ty(&rt, &whole, r.span); if var_or_field(&r.kind) { let base: String = fmt::expr_text(&**r); let mut all: Vec<String> = Vec::new(); for g in 0..fnames.len() invariant 0 <= g && g <= fnames.len(), { match field_at(sl.fields.as_slice(), fnames[g].as_str()) { None => all.push(types::cat5(fnames[g].as_str(), ": ", base.as_str(), ".", fnames[g].as_str())), Some(h) => all.push(types::cat3(fnames[g].as_str(), ": ", fmt::expr_text(&sl.fields[h].value).as_str())), } } self.c.fixed("E0223", span, "struct update syntax `..` is not allowed", "write every field", types::cat4(name.as_str(), " { ", types::join(all.as_slice(), ", ").as_str(), " }").as_str()); } else { self.c.help("E0223", span, "struct update syntax `..` is not allowed", "write every field: `f: base.f`"); } },
            }
            whole
        }

        #[summary("구조체 t의 필드가 Vec·배열·Box·조각·참조를 지나 담는 구조체들")]
        #[effects(alloc)]
        fn struct_parts(self: &Body, t: &ast::TypeKind) -> Vec<ast::TypeKind> {
            let mut out: Vec<ast::TypeKind> = Vec::new();
            let decl: Fields = self.struct_fields_of(t);
            for i in 0..decl.fields.len()
                invariant 0 <= i && i <= decl.fields.len(),
            {
                self.struct_under(&decl.fields[i].ty, &mut out, 1000000000);
            }
            out
        }

        #[summary("t 아래의 구조체를 out에: t가 구조체면 그것, Vec·배열·Box·조각·참조면 그 안")]
        #[effects(alloc)]
        fn struct_under(self: &Body, t: &ast::TypeKind, out: &mut Vec<ast::TypeKind>, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            match under(t) {
                None => { match types::named_path(t) { None => {}, Some(path) => { match self.c.adts.find(path.as_str()) { None => {}, Some(at) => { if struct_kind(&self.c.adts.items[at].kind) { out.push(t.clone()); } }, } }, } },
                Some(e) => self.struct_under(&e, out, f - 1),
            }
        }

        #[summary("x? (ADR-0049 §1): x는 Option을 내는 함수 안의 Option, 또는 같은 오류 타입의 Result를 내는 함수 안의 Result (암묵 변환 없음, E0241). 타입은 페이로드")]
        #[effects(alloc)]
        fn try_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, x: &ast::Expr, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if !exec_mode(mode) {
                self.c.help("E0503", e.span, "`?` is not allowed in a specification", "a specification is one expression: test the variant with `match`");
            }
            let no: Option<ast::TypeKind> = None;
            let xt: ast::TypeKind = self.expr(cx, x, &no, mode, f - 1);
            let kind: u8 = try_variants(&xt);
            if kind == 0 {
                if !types::is_error(&xt) && !is_never(&xt) {
                    let through: bool = match ref_inner(&xt) {
                        None => false,
                        Some(inner) => try_variants(&inner) != 0,
                    };
                    let msg: String = types::cat3("`?` applies to an `Option` or a `Result`, found `", types::text(&xt).as_str(), "`");
                    if through {
                        self.c.help("E0401", x.span, msg.as_str(), "`?` takes the value itself: `(*x)?` when it is `Copy`, otherwise `match` the reference");
                    } else {
                        self.c.help("E0401", x.span, msg.as_str(), "test the value with `if` or `match` instead");
                    }
                }
                return ast::TypeKind::Error;
            }
            let args: Vec<ast::TypeKind> = types::named_args(&xt);
            if args.len() == 0 {
                return ast::TypeKind::Error;
            }
            let payload: ast::TypeKind = args[0].clone();
            if !exec_mode(mode) {
                return payload;
            }
            let ret: ast::TypeKind = cx.ret.clone();
            if try_variants(&ret) == kind {
                let ra: Vec<ast::TypeKind> = types::named_args(&ret);
                if kind == 1 || ra.len() < 2 || args.len() < 2 {
                    return payload;
                }
                if types::same(&ra[1], &args[1]) {
                    return payload;
                }
                let want: String = types::text(&ra[1]);
                self.c.help("E0241", e.span, types::cat5("the error type `", types::text(&args[1]).as_str(), "` of `?` is not the function's `", want.as_str(), "`").as_str(), types::cat3("convert it explicitly: `match` the value and `return Err(..)` with a `", want.as_str(), "`").as_str());
                return payload;
            }
            if types::is_error(&ret) {
                return payload;
            }
            if kind == 1 {
                self.c.help("E0241", e.span, types::cat5("`?` on `", types::text(&xt).as_str(), "` returns its `None` from a function returning `", types::text(&ret).as_str(), "`").as_str(), "`?` needs the function to return `Option<..>`; otherwise `match` the value");
            } else {
                self.c.help("E0241", e.span, types::cat5("`?` on `", types::text(&xt).as_str(), "` returns its `Err` from a function returning `", types::text(&ret).as_str(), "`").as_str(), "`?` needs the function to return `Result<.., E>`; otherwise `match` the value");
            }
            payload
        }

        #[summary("E0301: 범위에 없는 이름. 보이는 이름 가운데 가장 가까운 하나(편집 거리 2 이하)를 고칠 글로 (백로그 2D-18)")]
        #[effects(alloc)]
        fn unknown_local(self: &mut Body, cx: &FnCtx, name: &str, span: source::Span) -> () {
            let msg: String = types::cat3("unknown name `", name, "`");
            if types::has(cx.for_vars.as_slice(), name) {
                self.c.help("E0301", span, msg.as_str(), "a `for` variable lives only in its loop; keep what you need in a local declared before it");
                return;
            }
            let mut cands: Vec<String> = Vec::new();
            for i in 0..cx.scopes.len()
                invariant 0 <= i && i <= cx.scopes.len(),
            {
                let mut names: Vec<String> = Vec::new();
                for j in 0..cx.scopes[i].len()
                    invariant 0 <= j && j <= cx.scopes[i].len(),
                {
                    types::add(&mut names, cx.scopes[i][j].name.as_str());
                }
                let ordered: Vec<String> = decls::sorted(names.as_slice());
                push_names(&mut cands, ordered.as_slice());
            }
            match types::closest(name, cands.as_slice()) {
                None => self.c.err("E0301", span, msg.as_str()),
                Some(near) => self.c.fixed("E0301", span, msg.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()),
            }
        }

        #[summary("경로가 변형이 아닐 때의 진단: 그런 변형이 없는 열거형(E0307), 또는 모르는 타입(E0305)")]
        #[effects(alloc)]
        fn unknown_variant(self: &mut Body, cx: &FnCtx, segs: &[ast::Ident]) -> () {
            let n: usize = segs.len();
            if n < 2 {
                return;
            }
            let ty: Vec<ast::Ident> = head(segs);
            match self.c.type_path(ty.as_slice(), cx.mod_path.as_str()) {
                None => { let tn: Vec<String> = names_of(ty.as_slice()); let d: diag::Diag = self.c.unknown_type(tn.as_slice(), decls::span_to(segs[0].span, segs[n - 2].span), cx.mod_path.as_str()); self.c.diags.push(d); },
                Some(tp) => { let mut names: Vec<String> = Vec::new(); match self.c.adts.find(tp.as_str()) { None => {}, Some(at) => { match &self.c.adts.items[at].kind { types::AdtKind::Struct(q4_fs) => {}, types::AdtKind::Enum(vs) => { names = variant_names(vs.as_slice()); }, } }, } let msg: String = types::cat5("`", tp.as_str(), "` has no variant `", segs[n - 1].name.as_str(), "`"); match types::closest(segs[n - 1].name.as_str(), names.as_slice()) { None => { if names.len() == 0 { self.c.help("E0307", segs[n - 1].span, msg.as_str(), types::cat5("`", tp.as_str(), "` is a struct: build it with `", segs[n - 2].name.as_str(), " { .. }`").as_str()); } else { self.c.help("E0307", segs[n - 1].span, msg.as_str(), types::cat4("variants of `", tp.as_str(), "`: ", types::join(names.as_slice(), ", ").as_str()).as_str()); } }, Some(near) => self.c.fixed("E0307", segs[n - 1].span, msg.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()), } },
            }
        }

        #[summary("변수인 자리: 참조면 그 참조가 &mut인가, 아니면 let mut인가")]
        #[effects(alloc)]
        fn var_place(self: &mut Body, cx: &mut FnCtx, id: &ast::Ident) -> Place {
            match lookup(cx, id.name.as_str()) {
                None => { self.unknown_local(cx, id.name.as_str(), id.span); Place { ty: ast::TypeKind::Error, writable: false } },
                Some(l) => { let w: bool = if is_ref(&l.ty) { types::is_ref_mut(&l.ty) } else { l.mutable }; Place { ty: l.ty, writable: w } },
            }
        }

        #[summary("T::V, unit::T::V: 열거형의 경로, 변형의 차례, 페이로드의 타입")]
        #[effects(alloc)]
        fn variant(self: &Body, segs: &[ast::Ident], mp: &str) -> VariantAt {
            let n: usize = segs.len();
            if n < 2 {
                return no_variant();
            }
            let ty: Vec<ast::Ident> = head(segs);
            let tp: String = match self.c.type_path(ty.as_slice(), mp) {
                None => { return no_variant(); },
                Some(p) => p,
            };
            let at: usize = match self.c.adts.find(tp.as_str()) {
                None => { return no_variant(); },
                Some(i) => i,
            };
            match &self.c.adts.items[at].kind {
                types::AdtKind::Struct(q4_fs) => no_variant(),
                types::AdtKind::Enum(vs) => { for k in 0..vs.len() invariant 0 <= k && k <= vs.len(), { if vs[k].name == segs[n - 1].name { return VariantAt { found: true, tp: tp.clone(), k: k, payload: vs[k].tys.clone() }; } } no_variant() },
            }
        }

        #[summary("변형 값: T::V (페이로드 없음) 또는 T::V(a, ..)")]
        #[effects(alloc)]
        fn variant_value(self: &mut Body, cx: &mut FnCtx, segs: &[ast::Ident], args: &[ast::Expr], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            let n: usize = segs.len();
            if f == 0 || n == 0 {
                return ast::TypeKind::Error;
            }
            let va: VariantAt = self.variant(segs, cx.mod_path.as_str());
            if !va.found {
                self.unknown_variant(cx, segs);
                let no: Option<ast::TypeKind> = None;
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            if args.len() != va.payload.len() {
                let mut tys: Vec<String> = Vec::new();
                for j in 0..va.payload.len()
                    invariant 0 <= j && j <= va.payload.len(),
                {
                    tys.push(types::text(&va.payload[j]));
                }
                self.c.help("E0405", span, decls::counts(types::cat3("`", segs[n - 1].name.as_str(), "` takes ").as_str(), va.payload.len(), " value(s), found ", args.len(), "").as_str(), types::cat3("the payload is `(", types::join(tys.as_slice(), ", ").as_str(), ")`").as_str());
            }
            let ps: Vec<types::TParam> = match self.c.adts.find(va.tp.as_str()) {
                None => Vec::new(),
                Some(at) => self.c.adts.items[at].generics.clone(),
            };
            let mut tm: types::Subst = self.expected_args(va.tp.as_str(), expected);
            let mut slots: Vec<Slot> = Vec::new();
            for k in 0..va.payload.len()
                invariant 0 <= k && k <= va.payload.len(),
            {
                if k < args.len() {
                    slots.push(Slot { at: k, ty: va.payload[k].clone() });
                }
            }
            let nofields: Vec<ast::FieldInit> = Vec::new();
            self.check_slots(cx, ps.as_slice(), &mut tm, args, nofields.as_slice(), false, slots.as_slice(), mode, f - 1);
            if ps.len() == 0 {
                let targs: Vec<ast::Type> = Vec::new();
                return ast::TypeKind::Named(refs::split_path(va.tp.as_str()), targs);
            }
            self.instance(va.tp.as_str(), &tm, types::cat3("`", decls::path_text(segs).as_str(), "`").as_str(), span)
        }

        #[summary("while")]
        #[effects(alloc)]
        fn while_stmt(self: &mut Body, cx: &mut FnCtx, w: &ast::While, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if ghost_mode(mode) {
                self.ghost_loop(w.span);
            } else if !exec_mode(mode) {
                self.spec_loop(w.span);
            }
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let ct: ast::TypeKind = self.expr(cx, &w.cond, &wb, operand(mode), f - 1);
            self.expect_ty(&ct, &ast::TypeKind::Bool, w.cond.span);
            let missing: source::Span = source::Span { file: w.span.file, lo: w.span.lo, hi: w.cond.span.hi };
            self.loop_clauses(cx, w.invariants.as_slice(), &w.measure, missing, "while", f - 1);
            cx.loops.push(LoopCx { label: label_name(&w.label), is_loop: false, value: None });
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Unit);
            let bt: ast::TypeKind = self.block(cx, &w.body, &wu, mode, f - 1);
            cx.loops.pop();
            self.expect_ty(&bt, &ast::TypeKind::Unit, w.body.span);
        }

        #[summary("`_ =>` 갈래의 E0224와 if let의 E0225: 고침은 match 전체다. 변형마다 갈래 하나를 선언 순서로, 와일드카드의 몸은 그것이 덮던 변형마다")]
        #[effects(alloc)]
        fn wildcard_arms(self: &mut Body, cx: &FnCtx, scrut: &ast::Expr, arms: &[ast::Arm], kinds: &[Option<usize>], tp: &str, vs: &[types::VariantSig], span: source::Span) -> () {
            let mut w: usize = arms.len();
            for i in 0..arms.len()
                invariant 0 <= i && i <= arms.len() && w <= arms.len(),
            {
                if w == arms.len() && (if_let_else(&arms[i].pat) || written(&arms[i].pat) && wild_name(&arms[i].pat)) {
                    w = i;
                }
            }
            if w >= arms.len() {
                return;
            }
            let if_let: bool = if_let_else(&arms[w].pat);
            let mut exact: bool = true;
            for j in 0..arms.len()
                invariant 0 <= j && j <= arms.len(),
            {
                if j != w && j < kinds.len() {
                    let named: bool = match kinds[j] {
                        None => false,
                        Some(q4_k) => true,
                    };
                    if !named || !written(&arms[j].pat) {
                        exact = false;
                    }
                }
            }
            let mut text: String = String::new();
            if exact {
                let wild_body: String = fmt::expr_text(&arms[w].body);
                let mut rows: Vec<String> = Vec::new();
                for k in 0..vs.len()
                    invariant 0 <= k && k <= vs.len(),
                {
                    match kind_at(kinds, k) {
                        None => { let vt: String = variant_text(tp, vs[k].name.as_str(), cx.mod_path.as_str()); rows.push(types::cat3(variant_pat(vt.as_str(), vs[k].tys.len()).as_str(), " => ", wild_body.as_str())); },
                        Some(a) => { if a < arms.len() { rows.push(types::cat3(fmt::pat_str(&arms[a].pat).as_str(), " => ", fmt::expr_text(&arms[a].body).as_str())); } },
                    }
                }
                text = types::cat5("match ", fmt::expr_text(scrut).as_str(), " { ", types::join(rows.as_slice(), ", ").as_str(), " }");
            }
            if if_let {
                if exact {
                    self.c.fixed("E0225", span, "`if let` is not allowed", "`match` with one arm per variant", text.as_str());
                } else {
                    self.c.help("E0225", span, "`if let` is not allowed", "`match` with one arm per variant");
                }
            } else {
                if exact {
                    self.c.fixed("E0224", span, "a wildcard arm is not allowed", "one arm per variant, the wildcard's body on each it stood for", text.as_str());
                } else {
                    self.c.help("E0224", span, "a wildcard arm is not allowed", "one arm per variant, the wildcard's body on each it stood for");
                }
            }
        }
    }

    #[summary("변수가 인자로 쓰인 호출: 자리, 호출의 경로, 몇 번째 인자인가")]
    struct CallUse { lo: u32, path: Vec<ast::Ident>, k: usize }

    #[summary("변수가 쓰인 자리 하나. kind 0은 연산의 한 쪽(other는 다른 쪽, literal은 그것이 리터럴인가), 1은 색인, 2는 push의 받는 쪽(other는 넣는 값)")]
    struct Fact { kind: u8, lo: u32, other: source::Span, literal: bool }

    #[summary("struct_fields의 답")]
    struct Fields { found: bool, path: String, fields: Vec<types::FieldSig> }

    #[summary("함수 하나를 검사하는 동안의 문맥. scopes는 안쪽이 뒤, all_names는 지금까지 묶은 이름, reserved는 몸이 묶을 수 없는 이름(ensures의 결과 이름), loops는 둘러싼 루프(안쪽이 뒤), needs는 효과마다 처음 요구한 자리")]
    struct FnCtx { path: String, mod_path: String, effect: types::Effects, scopes: Vec<Vec<Local>>, all_names: Vec<String>, reserved: Vec<String>, forall_depth: usize, ret: ast::TypeKind, loops: Vec<LoopCx>, for_vars: Vec<String>, ghost: bool, needs: Vec<Need>, own: types::Effects }

    #[summary("범위의 이름 하나")]
    struct Local { name: String, ty: ast::TypeKind, mutable: bool, is_param: bool }

    #[summary("break나 continue가 가리킬 수 있는 루프. is_loop는 값을 낼 수 있는 loop, value는 본 break 값의 타입")]
    struct LoopCx { label: Option<String>, is_loop: bool, value: Option<ast::TypeKind> }

    #[summary("검사하는 자리: 실행 코드, 명세(Spec의 값은 old를 쓸 수 있는가), 유령 코드")]
    enum Mode { Exec, Spec(bool), Ghost }

    #[summary("효과 e를 처음 요구한 것")]
    struct Need { e: types::Effects, what: String }

    #[summary("실행 정의의 효과: 제 연산의 것과 몸이 요구하는 것")]
    struct Needs { own: types::Effects, body: types::Effects }

    #[summary("타입 없는 let: 이름과, 초기값이 Vec::new()인가")]
    struct OpenLet { name: ast::Ident, vec_new: bool }

    #[summary("자리의 타입과 쓸 수 있는가")]
    struct Place { ty: ast::TypeKind, writable: bool }

    #[summary("한정자를 찾는 손님")]
    struct Quants { found: bool }

    impl ast::ExprFn for Quants {
        #[effects(alloc)]
        fn expr(self: &mut Quants, e: &mut ast::Expr) -> () {
            if is_quant(&e.kind) {
                self.found = true;
            }
        }
    }

    #[summary("check_slots의 한 자리: at은 인자(또는 필드)의 차례, ty는 선언된 타입")]
    struct Slot { at: usize, ty: ast::TypeKind }

    #[summary("타입을 쓴 let의 초기값 전체로 쓰인 지역 변수: 이름, 자리, 선언한 타입")]
    struct TypedUse { name: String, lo: u32, ty: ast::TypeKind }

    #[summary("타입 없는 let의 변수 name이 after 뒤에서 쓰인 자리를 모으는 손님. spec_at은 명세로 검사한 식의 자리(그 정수는 수학의 것이라 타입을 말하지 않는다)")]
    struct Uses { name: String, after: u32, vec_new: bool, spec_at: Vec<source::Span>, facts: Vec<Fact>, calls: Vec<CallUse> }

    impl Uses {
        #[summary("e가 그 변수를 쓴 자리인가")]
        #[effects(alloc)]
        fn is_var(self: &Uses, e: &ast::Expr) -> bool {
            match ast::var_name(e) {
                None => false,
                Some(v) => v == self.name && e.span.lo > self.after && !has_span(self.spec_at.as_slice(), e.span),
            }
        }
    }

    impl ast::ExprFn for Uses {
        #[effects(alloc)]
        fn expr(self: &mut Uses, e: &mut ast::Expr) -> () {
            match &e.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => {},
                ast::ExprKind::Float(q4_ek_float0) => {},
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => {},
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => {},
                ast::ExprKind::StrLit(q4_ek_strlit0) => {},
                ast::ExprKind::CharLit(q4_ek_charlit0) => {},
                ast::ExprKind::Bool(q4_ek_bool0) => {},
                ast::ExprKind::Unit => {},
                ast::ExprKind::Var(q4_ek_var0) => {},
                ast::ExprKind::Call(c) => { for i in 0..c.args.len() invariant 0 <= i && i <= c.args.len(), { if self.is_var(&c.args[i]) { self.calls.push(CallUse { lo: c.args[i].span.lo, path: c.path.clone(), k: i }); } } },
                ast::ExprKind::Method(m) => { if self.vec_new && m.name.name == "push" && self.is_var(&*m.recv) && m.args.len() == 1 && !is_int_kind(&m.args[0].kind) { self.facts.push(Fact { kind: 2, lo: m.recv.span.lo, other: m.args[0].span, literal: false }); } },
                ast::ExprKind::Index(q4_ek_index0, index) => { if !self.vec_new && self.is_var(&**index) { self.facts.push(Fact { kind: 1, lo: index.span.lo, other: index.span, literal: false }); } },
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => {},
                ast::ExprKind::Binary(op, a, b) => { if !self.vec_new && (is_arith(*op) || is_cmp(*op) || is_bit(*op)) { if self.is_var(&**a) { self.facts.push(Fact { kind: 0, lo: a.span.lo, other: b.span, literal: is_int_kind(&b.kind) }); } else if self.is_var(&**b) { self.facts.push(Fact { kind: 0, lo: b.span.lo, other: a.span, literal: is_int_kind(&a.kind) }); } } },
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => {},
                ast::ExprKind::If(q4_ek_if0) => {},
                ast::ExprKind::Block(q4_ek_block0) => {},
                ast::ExprKind::Array(q4_ek_array0) => {},
                ast::ExprKind::Repeat(q4_ek_repeat0) => {},
                ast::ExprKind::Old(q4_ek_old0) => {},
                ast::ExprKind::Quant(q4_ek_quant0) => {},
                ast::ExprKind::Trigger(q4_ek_trigger0) => {},
                ast::ExprKind::Closure(q4_ek_closure0) => {},
                ast::ExprKind::StructLit(q4_ek_structlit0) => {},
                ast::ExprKind::Path(q4_ek_path0) => {},
                ast::ExprKind::Deref(q4_ek_deref0) => {},
                ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => {},
                ast::ExprKind::Match(q4_ek_match0) => {},
                ast::ExprKind::Return(q4_ek_return0) => {},
                ast::ExprKind::Try(q4_ek_try0) => {},
                ast::ExprKind::Loop(q4_ek_loop0) => {},
                ast::ExprKind::Break(q4_ek_break0) => {},
                ast::ExprKind::Continue(q4_ek_continue0) => {},
                ast::ExprKind::Range(q4_ek_range0) => {},
                ast::ExprKind::Error => {},
            }
        }
    }

    #[summary("경로가 가리킨 변형: 열거형의 경로, 변형의 차례, 페이로드의 타입")]
    struct VariantAt { found: bool, tp: String, k: usize, payload: Vec<ast::TypeKind> }

    #[summary("match가 덮을 변형들: 타입의 경로와 선언 순서의 변형 (Option은 None, Some; Result는 Ok, Err)")]
    struct Variants { found: bool, path: String, vs: Vec<types::VariantSig> }

    #[summary("구조체의 필드 타입들이나 열거형의 페이로드 타입들")]
    #[effects(alloc)]
    fn adt_parts(k: &types::AdtKind) -> Vec<ast::TypeKind> {
        let mut out: Vec<ast::TypeKind> = Vec::new();
        match k {
            types::AdtKind::Struct(fs) => { for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { out.push(fs[i].ty.clone()); } },
            types::AdtKind::Enum(vs) => { for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { for j in 0..vs[i].tys.len() invariant 0 <= j && j <= vs[i].tys.len(), { out.push(vs[i].tys[j].clone()); } } },
        }
        out
    }

    #[summary("xs 가운데 하나가 name을 말하는가 (strict면 mentions_strict로)")]
    #[effects(pure)]
    fn any_mentions(xs: &[ast::Expr], name: &str, strict: bool, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if strict {
                if mentions_strict(&xs[i], name, f - 1) {
                    return true;
                }
            } else {
                if mentions(&xs[i], name, f - 1) {
                    return true;
                }
            }
        }
        false
    }

    #[summary("lo가 더 앞이면 고른 것을 바꾼다")]
    #[effects(alloc)]
    fn better(best: &mut Best, lo: u32, t: &ast::TypeKind) -> () {
        if !best.found || lo < best.lo {
            best.found = true;
            best.lo = lo;
            best.ty = t.clone();
        }
    }

    #[summary("정수 타입의 비트 수")]
    #[effects(pure)]
    fn bits(t: ast::IntTy) -> u32 {
        match t {
            ast::IntTy::I8 => 8,
            ast::IntTy::I16 => 16,
            ast::IntTy::I32 => 32,
            ast::IntTy::I64 => 64,
            ast::IntTy::Isize => 64,
            ast::IntTy::U8 => 8,
            ast::IntTy::U16 => 16,
            ast::IntTy::U32 => 32,
            ast::IntTy::U64 => 64,
            ast::IntTy::Usize => 64,
        }
    }

    #[summary("블록의 문장이나 꼬리가 name을 말하는가")]
    #[effects(pure)]
    fn block_mentions(b: &ast::Block, name: &str, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        for i in 0..b.stmts.len()
            invariant 0 <= i && i <= b.stmts.len(),
        {
            if stmt_mentions(&b.stmts[i], name, f - 1) {
                return true;
            }
        }
        opt_mentions(&b.tail, name, true, f - 1)
    }

    #[summary("t가 Box면 담은 타입")]
    #[effects(alloc)]
    fn box_inner(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => None,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => None,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(q4_tk_vec0) => None,
            ast::TypeKind::Box(e) => Some(e.kind.clone()),
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("Option::Some, Option::None, Result::Ok, Result::Err: 내장 변형을 타입과 함께 쓴 경로인가")]
    #[effects(pure)]
    fn builtin_path(segs: &[ast::Ident]) -> bool {
        segs.len() == 2 && (segs[0].name == "Option" && (segs[1].name == "Some" || segs[1].name == "None") || segs[0].name == "Result" && (segs[1].name == "Ok" || segs[1].name == "Err"))
    }

    #[summary("e가 호출이면 그 호출")]
    #[effects(alloc)]
    fn call_of(e: &ast::Expr) -> Option<ast::Call> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(c) => Some(c.clone()),
            ast::ExprKind::Method(q4_ek_method0) => None,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(q4_ek_deref0) => None,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("source에서 target으로의 변환에 범위 의무가 있는가: 정수가 아니거나 source의 값이 모두 target의 값이지는 않다")]
    #[effects(pure)]
    fn conv_obligation(source: &ast::TypeKind, target: &ast::TypeKind) -> bool {
        match int_of(source) {
            None => true,
            Some(s) => { match int_of(target) { None => true, Some(t) => !fits(s, t), } },
        }
    }

    #[summary("e가 *x면 x")]
    #[effects(alloc)]
    fn deref_inner(e: &ast::Expr) -> Option<ast::Expr> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(q4_ek_call0) => None,
            ast::ExprKind::Method(q4_ek_method0) => None,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(x) => Some((**x).clone()),
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("색인한 원소의 타입: 배열, Vec, 그리고 조각이나 Vec의 참조")]
    #[effects(alloc)]
    fn elem_of(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(e, q4_tk_array1) => Some(e.kind.clone()),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, inner) => ref_elem(&inner.kind),
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(e) => Some(e.kind.clone()),
            ast::TypeKind::Box(q4_tk_box0) => None,
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[effects(alloc)]
    fn empty_subst() -> types::Subst {
        types::Subst { names: Vec::new(), tys: Vec::new() }
    }

    #[effects(pure)]
    fn exec_mode(m: Mode) -> bool {
        match m {
            Mode::Exec => true,
            Mode::Spec(q4_old) => false,
            Mode::Ghost => false,
        }
    }

    #[summary("이름이 name인 첫 필드 값의 차례")]
    #[effects(pure)]
    fn field_at(xs: &[ast::FieldInit], name: &str) -> (r: Option<usize>)
        ensures match r { None => true, Some(i) => i < xs.len(), },
    {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if xs[i].name.name == name {
                return Some(i);
            }
        }
        None
    }

    #[effects(alloc)]
    fn field_names(fs: &[types::FieldSig]) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..fs.len()
            invariant 0 <= i && i <= fs.len(),
        {
            out.push(fs[i].name.clone());
        }
        out
    }

    #[summary("필드 값 가운데 하나가 name을 말하는가")]
    #[effects(pure)]
    fn fields_mention(xs: &[ast::FieldInit], name: &str, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if mentions(&xs[i].value, name, f - 1) {
                return true;
            }
        }
        false
    }

    #[summary("s의 값이 모두 t의 값인가")]
    #[effects(pure)]
    fn fits(s: ast::IntTy, t: ast::IntTy) -> bool {
        if signed(s) == signed(t) {
            return bits(s) <= bits(t);
        }
        !signed(s) && bits(s) < bits(t)
    }

    #[summary("타입 없는 let에 맞는 타입인가: Vec::new()면 Vec, 아니면 정수")]
    #[effects(pure)]
    fn fits_let(t: &ast::TypeKind, vec_new: bool) -> bool {
        if vec_new {
            return is_vec(t);
        }
        types::is_int(t)
    }

    #[effects(pure)]
    fn ghost_mode(m: Mode) -> bool {
        match m {
            Mode::Exec => false,
            Mode::Spec(q4_old) => false,
            Mode::Ghost => true,
        }
    }

    #[effects(pure)]
    fn has_attr(attrs: &[ast::Attr], name: &str) -> bool {
        for i in 0..attrs.len()
            invariant 0 <= i && i <= attrs.len(),
        {
            if attrs[i].name.name == name {
                return true;
            }
        }
        false
    }

    #[summary("t가 ps의 매개변수 가운데 tm이 아직 묶지 않은 것을 말하는가")]
    #[effects(pure)]
    fn has_param_of(t: &ast::TypeKind, ps: &[types::TParam], tm: &types::Subst) -> bool {
        for i in 0..ps.len()
            invariant 0 <= i && i <= ps.len(),
        {
            if !types::has(tm.names.as_slice(), ps[i].name.as_str()) && types::mentions_param(t, ps[i].name.as_str(), 100000) {
                return true;
            }
        }
        false
    }

    #[effects(pure)]
    fn has_prover(o: &Option<ast::Prover>) -> bool {
        match o {
            None => false,
            Some(q4_p) => true,
        }
    }

    #[summary("e 안에 한정자가 있는가")]
    #[effects(alloc)]
    fn has_quant(e: &ast::Expr) -> bool {
        let mut copy: ast::Expr = e.clone();
        let mut v: Quants = Quants { found: false };
        ast::expr_mut::<Quants>(&mut copy, &mut v, true, 1000000000);
        v.found
    }

    #[effects(pure)]
    fn has_span(xs: &[source::Span], s: source::Span) -> bool {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if same_span(xs[i], s) {
                return true;
            }
        }
        false
    }

    #[effects(pure)]
    fn has_type(o: &Option<ast::TypeKind>) -> bool {
        match o {
            None => false,
            Some(q4_t) => true,
        }
    }

    #[effects(pure)]
    fn has_usize(xs: &[usize], k: usize) -> bool {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if xs[i] == k {
                return true;
            }
        }
        false
    }

    #[summary("경로의 마지막 마디를 뺀 앞")]
    #[effects(alloc)]
    fn head(segs: &[ast::Ident]) -> Vec<ast::Ident> {
        let mut out: Vec<ast::Ident> = Vec::new();
        if segs.len() == 0 {
            return out;
        }
        for i in 0..segs.len() - 1
            invariant 0 <= i && i <= segs.len() - 1,
        {
            out.push(segs[i].clone());
        }
        out
    }

    #[summary("배열, Box, Vec이 담는 타입")]
    #[effects(alloc)]
    fn held(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(e, q4_tk_array1) => Some(e.kind.clone()),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => None,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(e) => Some(e.kind.clone()),
            ast::TypeKind::Box(e) => Some(e.kind.clone()),
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("`_`를 n개: `_, _`")]
    #[effects(alloc)]
    fn holes(n: usize) -> String {
        let mut s: String = String::new();
        for i in 0..n
            invariant 0 <= i && i <= n,
        {
            if i > 0 {
                s.push_str(", ");
            }
            s.push_str("_");
        }
        s
    }

    #[summary("else가 if let의 것인 갈래인가 (E0225)")]
    #[effects(pure)]
    fn if_let_else(p: &ast::Pat) -> bool {
        match &p.origin {
            ast::PatOrigin::Written => false,
            ast::PatOrigin::IfLetElse => true,
            ast::PatOrigin::Rejected => false,
        }
    }

    #[summary("초기값이 맨 정수 리터럴이나 그 음수인가")]
    #[effects(pure)]
    fn int_literal(e: &ast::Expr) -> bool {
        match &e.kind {
