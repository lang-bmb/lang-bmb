    #[summary("t가 std::process::Child(나 그 참조)인가")]
    #[effects(alloc)]
    fn is_child(t: &ast::TypeKind) -> bool {
        let v: ast::TypeKind = match ref_inner(t) {
            None => t.clone(),
            Some(inner) => inner,
        };
        match types::named_path(&v) {
            None => false,
            Some(p) => p == "std::process::Child" && types::named_args(&v).len() == 0,
        }
    }

