    #[effects(pure)]
    fn is_some(o: &Option<String>) -> bool {
        match o {
            None => false,
            Some(q4_s) => true,
        }
    }

    #[effects(pure)]
    fn is_some_local(o: &Option<Local>) -> bool {
        match o {
            None => false,
            Some(q4_l) => true,
        }
    }

    #[effects(pure)]
    fn is_spec(k: ast::FnKind) -> bool {
