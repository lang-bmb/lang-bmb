    #[summary("t가 정수 타입이면 문맥의 타입으로 준다")]
    #[effects(alloc)]
    fn int_want(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        if types::is_int(t) {
            return Some(t.clone());
        }
        None
    }

