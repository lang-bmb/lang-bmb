            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => false,
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => false,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => false,
            ast::ExprKind::Block(q4_ek_block0) => false,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => false,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => false,
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
