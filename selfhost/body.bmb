#[summary("검사기의 2패스: 몸을 검사한다 (stage0 compiler/src/check.rs의 check_mod부터의 포트, 백로그 4D-03e). 단위와 함수를 걷고, 매개변수와 계약의 자리를 보고, 이름을 범위에 넣고, 효과를 견주고, 문장과 자리, match·변형·구조체 리터럴을 본다. 식(expr)은 다음 조각이 채운다. f는 남은 깊이다 (ADR-0140)")]
mod body {
    #[summary("settle_lets가 고른 타입: 가장 앞 자리의 것")]
    struct Best { found: bool, lo: u32, ty: ast::TypeKind }

    #[summary("몸 검사의 표. c는 1패스가 모은 선언. types는 식마다의 타입(열쇠는 span_key), locals는 정의마다 이름의 타입, needs는 실행 정의마다 제 연산의 효과와 몸이 요구하는 효과")]
    struct Body { c: decls::Checker, recursive: table::Table<usize>, gcalls: Vec<GCall>, targs: table::Table<Vec<ast::TypeKind>>, aliases: Vec<diag::Diag>, consts: table::Table<consts::Const>, calls: table::Table<Vec<String>>, needs: table::Table<Needs>, external: Vec<String>, types: table::Table<ast::TypeKind>, open_lets: Vec<OpenLet>, typed_uses: Vec<TypedUse>, spec_at: Vec<source::Span>, locals: table::Table<table::Table<ast::TypeKind>>, const_reads: table::Table<Vec<String>>, const_uses: table::Table<ConstUse>, methods: table::Table<MethodTarget>, spec_widen: bool }

    impl Body {
        #[summary("caller가 callee를 부른다고 적는다")]
        #[effects(alloc)]
        fn add_call(self: &mut Body, caller: &str, callee: &str) -> () {
            let mut set: Vec<String> = match self.calls.find(caller) {
                None => Vec::new(),
                Some(at) => self.calls.items[at].clone(),
            };
            if !types::has(set.as_slice(), callee) {
                set.push(String::from(callee));
            }
            self.calls.insert(caller, set);
        }

        #[summary("E0410: &mut으로 넘긴 변수를 다른 인자도 쓴다. 배열을 읽기만 하는 스칼라 인자는 호출 전에 계산된 값이라 겹칠 수 없다 (ADR-0024): fill(&mut a, a.len())")]
        #[effects(alloc)]
        fn alias_check(self: &mut Body, sig: &types::FnSig, args: &[ast::Expr], mut_roots: &[MutRoot]) -> () {
            for q in 0..mut_roots.len()
                invariant 0 <= q && q <= mut_roots.len(),
            {
                for j in 0..args.len()
                    invariant 0 <= j && j <= args.len(),
                {
                    let by_value: bool = !(j < sig.params.len() && (is_ref(&sig.params[j]) || is_vec(&sig.params[j])));
                    if j != mut_roots[q].at && !(by_value && reads_only(&args[j], 1000000000)) && mentions_strict(&args[j], mut_roots[q].root.as_str(), 1000000000) {
                        self.c.err("E0410", args[j].span, types::cat3("`", mut_roots[q].root.as_str(), "` is passed as `&mut` and also used by another argument").as_str());
                    }
                }
            }
        }

        #[summary("타입 인자를 추론하는 중의 인자 a (매개변수 타입 pt0에 아직 묶이지 않은 매개변수가 있다): 문맥의 타입을 받는 리터럴은 미루고, 값 인자는 검사한 타입에서, 참조 인자는 구문에서 읽은 타입에서 묶는다. 이 인자가 끝났는가 (참조 인자는 이어서 ref_arg가 본다)")]
        #[effects(alloc)]
        fn arg_infer(self: &mut Body, cx: &mut FnCtx, sig: &types::FnSig, tm: &mut types::Subst, a: &ast::Expr, i: usize, pt0: &ast::TypeKind, mode: Mode, deferred: &mut Vec<usize>, f: usize) -> bool
            decreases f * 3 + 1,
        {
            if f == 0 {
                return true;
            }
            let no: Option<ast::TypeKind> = None;
            let ints_mix: bool = !exec_mode(mode);
            if untyped_literal(a, 1000000000) {
                deferred.push(i);
                return true;
            }
            if is_ref(pt0) {
                match self.arg_peek(cx, a, 1000000000) {
                    None => {},
                    Some(peeked) => { types::unify(pt0, &peeked, sig.generics.as_slice(), tm, 100000); },
                }
            } else {
                let at: ast::TypeKind = self.expr(cx, a, &no, mode, f - 1);
                types::unify(pt0, &at, sig.generics.as_slice(), tm, 100000);
                let bound: ast::TypeKind = types::subst(pt0, tm);
                if !has_param_of(&bound, sig.generics.as_slice(), tm) && !(ints_mix && types::is_int(&at) && types::is_int(&bound)) {
                    self.expect_ty(&at, &bound, a.span);
                }
                return true;
            }
            false
        }

        #[summary("검사하기 전에 구문에서 읽은 인자 a의 타입: 지역 변수, 그것의 참조, 조각으로 본 Vec. 타입 인자를 추론하는 데 쓴다 (E0237)")]
        #[effects(alloc)]
        fn arg_peek(self: &Body, cx: &FnCtx, a: &ast::Expr, f: usize) -> Option<ast::TypeKind>
            decreases f,
        {
            if f == 0 {
                return None;
            }
            match &a.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
                ast::ExprKind::Float(q4_ek_float0) => None,
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
                ast::ExprKind::StrLit(q4_ek_strlit0) => None,
                ast::ExprKind::CharLit(q4_ek_charlit0) => None,
                ast::ExprKind::Bool(q4_ek_bool0) => None,
                ast::ExprKind::Unit => None,
                ast::ExprKind::Var(id) => { match lookup(cx, id.name.as_str()) { None => None, Some(l) => Some(l.ty), } },
                ast::ExprKind::Call(q4_ek_call0) => None,
                ast::ExprKind::Method(mc) => self.peek_slice(cx, mc),
                ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
                ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
                ast::ExprKind::Ref(rm, x) => { match self.place_peek(cx, &**x, f - 1) { None => None, Some(t) => Some(ast::TypeKind::Ref(*rm, types::boxed(t))), } },
                ast::ExprKind::If(q4_ek_if0) => None,
                ast::ExprKind::Block(q4_ek_block0) => None,
                ast::ExprKind::Array(q4_ek_array0) => None,
                ast::ExprKind::Repeat(q4_ek_repeat0) => None,
                ast::ExprKind::Old(x) => self.arg_peek(cx, &**x, f - 1),
                ast::ExprKind::Quant(q4_ek_quant0) => None,
                ast::ExprKind::Trigger(q4_ek_trigger0) => None,
                ast::ExprKind::Closure(q4_ek_closure0) => None,
                ast::ExprKind::StructLit(q4_ek_structlit0) => None,
                ast::ExprKind::Path(q4_ek_path0) => None,
                ast::ExprKind::Deref(q4_ek_deref0) => None,
                ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
                ast::ExprKind::Match(q4_ek_match0) => None,
                ast::ExprKind::Return(q4_ek_return0) => None,
                ast::ExprKind::Try(q4_ek_try0) => None,
                ast::ExprKind::Loop(q4_ek_loop0) => None,
                ast::ExprKind::Break(q4_ek_break0) => None,
                ast::ExprKind::Continue(q4_ek_continue0) => None,
                ast::ExprKind::Range(q4_ek_range0) => None,
                ast::ExprKind::Error => None,
            }
        }

        #[summary("값 매개변수(타입 pt)의 인자 a: 그 타입을 기대하며 검사한다. 명세에서는 정수 타입이 섞인다 (ADR-0022)")]
        #[effects(alloc)]
        fn arg_value(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, pt: &ast::TypeKind, mode: Mode, f: usize) -> ()
            decreases f * 3 + 1,
        {
            if f == 0 {
                return;
            }
            let hint: Option<ast::TypeKind> = Some(pt.clone());
            let t: ast::TypeKind = self.expr(cx, a, &hint, mode, f - 1);
            if !(!exec_mode(mode) && types::is_int(&t) && types::is_int(pt)) {
                let fixed: bool = self.deref_fix(&t, pt, a);
                if !fixed {
                    self.expect_ty(&t, pt, a.span);
                }
            }
        }

        #[summary("인자들을 기대 없이 검사한다 (오류를 낸 호출의 나머지)")]
        #[effects(alloc)]
        fn args_only(self: &mut Body, cx: &mut FnCtx, args: &[ast::Expr], mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            for i in 0..args.len()
                invariant 0 <= i && i <= args.len(),
            {
                self.expr(cx, &args[i], &no, mode, f - 1);
            }
        }

        #[summary("갈래의 패턴이 묶는 이름들의 타입: 변형 k의 페이로드 (참조를 match하면 그 참조). 자리 수가 어긋나면 E0427")]
        #[effects(alloc)]
        fn arm_binds(self: &mut Body, mp: &str, p: &ast::Pat, tp: &str, vs: &[types::VariantSig], k: usize, by_ref: bool, by_mut: bool) -> Vec<ast::TypeKind> {
            let mut tys: Vec<ast::TypeKind> = Vec::new();
            if k >= vs.len() {
                return tys;
            }
            let n: usize = vs[k].tys.len();
            let vt: String = variant_text(tp, vs[k].name.as_str(), mp);
            if n == 0 && p.parens {
                self.c.fixed("E0427", p.span, types::cat3("`", vt.as_str(), "` has no payload").as_str(), types::cat3("write `", vt.as_str(), "`").as_str(), vt.as_str());
            } else if p.binds.len() != n {
                let msg: String = decls::counts(types::cat3("`", vt.as_str(), "` holds ").as_str(), n, " value(s), the pattern names ", p.binds.len(), "");
                self.c.fixed("E0427", p.span, msg.as_str(), "one new name or `_` per payload position", types::cat4(vt.as_str(), "(", holes(n).as_str(), ")").as_str());
            }
            for i in 0..n
                invariant 0 <= i && i <= n && n == vs[k].tys.len(),
            {
                if by_ref {
                    tys.push(ast::TypeKind::Ref(by_mut, types::boxed(vs[k].tys[i].clone())));
                } else {
                    tys.push(vs[k].tys[i].clone());
                }
            }
            tys
        }

        #[summary("갈래의 패턴이 이름한 변형의 차례 (값은 열거형 tp). 변형 경로가 아니면 E0307, 다른 타입의 변형이면 E0401")]
        #[effects(alloc)]
        fn arm_variant(self: &mut Body, cx: &FnCtx, p: &ast::Pat, tp: &str, vs: &[types::VariantSig], st: &ast::TypeKind) -> (r: Option<usize>)
            ensures match r { None => true, Some(i) => i < vs.len(), },
        {
            let n: usize = p.path.len();
            if n == 0 {
                return None;
            }
            let names: Vec<String> = variant_names(vs);
            let mut bare: bool = n == 1;
            if builtin_path(p.path.as_slice()) {
                self.builtin_by_path(p.path.as_slice());
                bare = true;
            }
            let mut pt: String = String::new();
            if bare {
                if p.path[n - 1].name == "Some" || p.path[n - 1].name == "None" {
                    pt = String::from("Option");
                } else if p.path[n - 1].name == "Ok" || p.path[n - 1].name == "Err" {
                    pt = String::from("Result");
                } else {
                    let msg: String = types::cat3("`", p.path[n - 1].name.as_str(), "` is not a variant path");
                    if types::has(names.as_slice(), p.path[n - 1].name.as_str()) {
                        self.c.fixed("E0307", p.path[n - 1].span, msg.as_str(), "a user enum variant is written with its type", variant_text(tp, p.path[n - 1].name.as_str(), cx.mod_path.as_str()).as_str());
                    } else {
                        match types::closest(p.path[n - 1].name.as_str(), names.as_slice()) {
                            None => self.c.help("E0307", p.path[n - 1].span, msg.as_str(), "a variant pattern is `Type::Variant`"),
                            Some(near) => { let vt: String = variant_text(tp, near.as_str(), cx.mod_path.as_str()); self.c.fixed("E0307", p.path[n - 1].span, msg.as_str(), types::cat3("did you mean `", vt.as_str(), "`?").as_str(), vt.as_str()); },
                        }
                    }
                    return None;
                }
            } else {
                let ty: Vec<ast::Ident> = head(p.path.as_slice());
                match self.c.type_path(ty.as_slice(), cx.mod_path.as_str()) {
                    None => { let tn: Vec<String> = names_of(ty.as_slice()); let d: diag::Diag = self.c.unknown_type(tn.as_slice(), decls::span_to(p.path[0].span, p.path[n - 2].span), cx.mod_path.as_str()); self.c.diags.push(d); return None; },
                    Some(found) => { pt = found; },
                }
            }
            if pt.as_str() != tp {
                let mut all: Vec<String> = Vec::new();
                for i in 0..vs.len()
                    invariant 0 <= i && i <= vs.len(),
                {
                    all.push(variant_text(tp, vs[i].name.as_str(), cx.mod_path.as_str()));
                }
                let stt: String = types::text(st);
                self.c.help("E0401", p.span, types::cat5("this pattern is a `", pt.as_str(), "` variant; the value is `", stt.as_str(), "`").as_str(), types::cat4("the variants of `", stt.as_str(), "`: ", types::join(all.as_slice(), ", ").as_str()).as_str());
                return None;
            }
            let at: Option<usize> = decls::index_of(names.as_slice(), p.path[n - 1].name.as_str());
            match at {
                None => { let miss: String = types::cat5("`", tp, "` has no variant `", p.path[n - 1].name.as_str(), "`"); match types::closest(p.path[n - 1].name.as_str(), names.as_slice()) { None => self.c.help("E0307", p.path[n - 1].span, miss.as_str(), types::cat4("variants of `", tp, "`: ", types::join(names.as_slice(), ", ").as_str()).as_str()), Some(near2) => self.c.fixed("E0307", p.path[n - 1].span, miss.as_str(), types::cat3("did you mean `", near2.as_str(), "`?").as_str(), near2.as_str()), } None },
                Some(k) => { if k < vs.len() { Some(k) } else { None } },
            }
        }

        #[summary("배열 리터럴 [a, b]: 원소는 한 타입이고 배열의 원소가 될 수 있다. 기대한 배열 타입이 원소의 타입을 준다")]
        #[effects(alloc)]
        fn array_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, items: &[ast::Expr], expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let mut elem: Option<ast::TypeKind> = want_elem(expected);
            let mut ok: bool = true;
            for i in 0..items.len()
                invariant 0 <= i && i <= items.len(),
            {
                let t: ast::TypeKind = self.expr(cx, &items[i], &elem, mode, f - 1);
                if !self.literal_elem(&t, items[i].span, false) {
                    ok = false;
                } else {
                    let cur: Option<ast::TypeKind> = elem.clone();
                    match cur {
                        None => { elem = Some(t.clone()); },
                        Some(want) => self.expect_ty(&t, &want, items[i].span),
                    }
                }
            }
            if !ok {
                return ast::TypeKind::Error;
            }
            match elem {
                None => { self.c.err("E0401", e.span, "cannot determine the element type of an empty array"); ast::TypeKind::Error },
                Some(el) => ast::TypeKind::Array(types::boxed(el), items.len() as u64),
            }
        }

        #[summary("&[u8] 매개변수에 주거나 색인한 s.as_bytes() (ADR-0050 §2): 글 값의 바이트, 읽기만")]
        #[effects(alloc)]
        fn as_bytes_arg(self: &mut Body, cx: &mut FnCtx, base: &ast::Expr, recv: &ast::Expr, mode: Mode, f: usize) -> bool
            decreases f * 3,
        {
            if f == 0 {
                return false;
            }
            let no: Option<ast::TypeKind> = None;
            let rt: ast::TypeKind = self.expr(cx, recv, &no, mode, f - 1);
            if !is_text(&rt) {
                return false;
            }
            self.types.insert(span_key(base.span).as_str(), bytes_ref());
            true
        }

        #[summary("assert(e); 와 assert(e) by (bit_vector); : 실행 코드, proof 블록, proof fn의 몸에 (ADR-0048 §4)")]
        #[effects(alloc)]
        fn assert_stmt(self: &mut Body, cx: &mut FnCtx, a: &ast::Assert, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if !exec_mode(mode) && !ghost_mode(mode) {
                self.c.help("E0503", a.span, "`assert` is not allowed in a specification", "an assertion is a statement of code, a `proof` block or a `proof fn`; a fact about a specification is a `proof fn`'s `ensures`");
            }
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let t: ast::TypeKind = self.expr(cx, &a.cond, &want, Mode::Spec(true), f - 1);
            self.expect_ty(&t, &ast::TypeKind::Bool, a.cond.span);
            if has_prover(&a.by) && is_bool(&t) {
                let mut bound: Vec<String> = Vec::new();
                self.bit_vector_terms(&a.cond, &mut bound, 1000000000);
            }
        }

        #[summary("대입: 대상의 자리와 타입, 값의 타입. 대상의 타입은 놓는 자리의 검사(moves)가 읽도록 적어 둔다")]
        #[effects(alloc)]
        fn assign_stmt(self: &mut Body, cx: &mut FnCtx, a: &ast::Assign, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if ghost_mode(mode) {
                self.ghost_violation(a.span, "assignment", "ghost code proves facts about the state; assign outside the `proof` block");
            } else if !exec_mode(mode) {
                self.c.err("E0503", a.span, "assignment is not allowed in a specification");
            }
            let tt: ast::TypeKind = self.place(cx, &a.target, f - 1);
            self.types.insert(span_key(a.target.span).as_str(), tt.clone());
            let want: Option<ast::TypeKind> = Some(tt.clone());
            let vt: ast::TypeKind = self.expr(cx, &a.value, &want, mode, f - 1);
            self.expect_ty(&vt, &tt, a.value.span);
        }

        #[summary("assume(p(..)); (ADR-0029 §1): 실행 코드에서, 이름 붙은 술어 호출 하나(E1003), 앞에 근거(E1001, E1002). panic의 출처다")]
        #[effects(alloc)]
        fn assume_stmt(self: &mut Body, cx: &mut FnCtx, a: &ast::Assume, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if !exec_mode(mode) {
                self.c.help("E1003", a.span, "`assume` is not allowed in a specification or ghost code", "an escape is a statement of executable code; a ghost fact is proved (`assert`, a `proof fn`)");
            }
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let t: ast::TypeKind = self.expr(cx, &a.cond, &want, Mode::Spec(false), f - 1);
            let named: Option<usize> = match call_of(&a.cond) {
                None => None,
                Some(call) => { match self.resolve(call.path.as_slice(), cx.mod_path.as_str()) { None => None, Some(p) => self.c.fns.find(p.as_str()), } },
            };
            let pred: bool = match named {
                None => false,
                Some(i) => is_spec(self.c.fns.items[i].kind) && types::same(&self.c.fns.items[i].ret, &ast::TypeKind::Bool),
            };
            if !pred && !types::is_error(&t) {
                self.c.help("E1003", a.cond.span, "`assume` takes one named predicate call", "move the condition into `spec fn name(..) -> bool { .. }` and assume `name(..)`");
            }
            match &a.rationale {
                None => self.c.missing_rationale(a.span, "`assume`"),
                Some(r) => self.c.check_rationale(r),
            }
            if exec_mode(mode) {
                need_own(cx, panic_effect(), "`assume`");
            }
        }

        #[summary("unwrap도 ok도 없는 변환 T::try_from(x) (ADR-0028 §1, E0412)과 T::from(x) (E0212). u32::from(c)는 글자의 스칼라 값이다 (ADR-0050 §2)")]
        #[effects(alloc)]
        fn bare_conv(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, c: &ast::Call, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 || c.path.len() != 2 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let mut ats: Vec<ast::TypeKind> = Vec::new();
            for i in 0..c.args.len()
                invariant 0 <= i && i <= c.args.len(),
            {
                ats.push(self.expr(cx, &c.args[i], &no, mode, f - 1));
            }
            let target: ast::IntTy = match ast::int_of(c.path[0].name.as_str()) {
                None => { return ast::TypeKind::Error; },
                Some(it) => it,
            };
            let tn: String = int_text(target);
            if c.path[1].name == "from" {
                if is_u32(target) && ats.len() == 1 && is_char(&ats[0]) {
                    return ast::TypeKind::Int(ast::IntTy::U32);
                }
                if c.args.len() != 1 {
                    self.c.help("E0405", e.span, types::cat3("`", tn.as_str(), "::from` takes one argument").as_str(), types::cat3("an integer conversion is `x as ", tn.as_str(), "`").as_str());
                    return ast::TypeKind::Int(target);
                }
                let ct: String = cast_text(&c.args[0], tn.as_str());
                self.c.fixed("E0212", e.span, types::cat3("write `", ct.as_str(), "`").as_str(), "an integer conversion has a range obligation (ADR-0028)", ct.as_str());
                return ast::TypeKind::Int(target);
            }
            let x: String = if c.args.len() > 0 {
                fmt::expr_text(&c.args[0])
            } else {
                String::new()
            };
            self.c.fixed("E0412", e.span, "`T::try_from(x)` is used as `.unwrap()` or `.ok()`", "`.unwrap()`: the value, with a range obligation; `.ok()`: an `Option`", types::cat4(tn.as_str(), "::try_from(", x.as_str(), ").unwrap()").as_str());
            ast::TypeKind::Error
        }

        #[summary("이항 연산 (시프트와 논리 연산은 따로): 리터럴은 다른 피연산자에서 타입을 받는다")]
        #[effects(alloc)]
        fn binary(self: &mut Body, cx: &mut FnCtx, op: ast::BinOp, l: &ast::Expr, r: &ast::Expr, expected: &Option<ast::TypeKind>, mode: Mode, span: source::Span, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if is_shift(op) {
                return self.shift(cx, op, l, r, expected, mode, span, f - 1);
            }
            if is_logic(op) {
                if is_implies(op) && exec_mode(mode) {
                    self.c.err("E0503", span, "`==>` is only allowed in specifications");
                }
                let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
                let bl: ast::TypeKind = self.expr(cx, l, &wb, mode, f - 1);
                let br: ast::TypeKind = self.expr(cx, r, &wb, mode, f - 1);
                self.expect_ty(&bl, &ast::TypeKind::Bool, l.span);
                self.expect_ty(&br, &ast::TypeKind::Bool, r.span);
                return ast::TypeKind::Bool;
            }
            let hint: Option<ast::TypeKind> = match expected {
                None => None,
                Some(x) => { if is_arith(op) && (types::is_int(x) || is_f64(x)) || is_bit(op) && (types::is_int(x) || is_bool(x)) { Some(x.clone()) } else { None } },
            };
            let mut lt: ast::TypeKind = ast::TypeKind::Error;
            let mut rt: ast::TypeKind = ast::TypeKind::Error;
            if untyped_literal(l, 1000000000) && !untyped_literal(r, 1000000000) {
                rt = self.text_operand(cx, r, &hint, mode, f - 1);
                let rh: Option<ast::TypeKind> = Some(rt.clone());
                lt = self.text_operand(cx, l, &rh, mode, f - 1);
            } else {
                lt = self.text_operand(cx, l, &hint, mode, f - 1);
                let lh: Option<ast::TypeKind> = Some(lt.clone());
                rt = self.text_operand(cx, r, &lh, mode, f - 1);
            }
            self.binary_types(op, l, r, &lt, &rt, mode, span)
        }

        #[summary("두 피연산자가 한 타입 lt일 때: ==는 스칼라에(자료 타입·배열·조각의 ==는 명세에서만, E0425), 비트 연산은 정수와 bool에, 나머지는 정수와 f64에")]
        #[effects(alloc)]
        fn binary_same(self: &mut Body, op: ast::BinOp, l: &ast::Expr, r: &ast::Expr, lt: &ast::TypeKind, mode: Mode, span: source::Span) -> ast::TypeKind {
            let valued: bool = is_arith(op) || is_bit(op);
            let sym: String = op_symbol(op);
            let ltt: String = types::text(lt);
            let eq: bool = is_eq(op);
            if eq && is_vec(lt) {
                self.c.help("E0514", span, types::cat5("`", sym.as_str(), "` is not defined for `", ltt.as_str(), "`").as_str(), "compare the lengths and the elements with a spec predicate over `v.as_slice()`");
                return ast::TypeKind::Bool;
            }
            let slice: bool = match ref_inner(lt) {
                None => false,
                Some(inner) => is_slice(&inner),
            };
            match types::param_name(lt) {
                None => {},
                Some(n) => { if is_cmp(op) && !eq { if !self.c.has_builtin(lt, "Ord") { self.c.help("E0428", span, types::cat7("`", sym.as_str(), "` on `", n.as_str(), "` needs the bound `", n.as_str(), ": Ord`").as_str(), types::cat3("add `Ord` to the bounds of `", n.as_str(), "`").as_str()); } return ast::TypeKind::Bool; } if eq { if exec_mode(mode) && !self.c.has_builtin(lt, "Eq") { self.c.help("E0428", span, types::cat7("`", sym.as_str(), "` on `", ltt.as_str(), "` in code needs the bound `", ltt.as_str(), ": Eq`").as_str(), types::cat3("add `Eq` (or `Ord`) to the bounds of `", ltt.as_str(), "`").as_str()); } return ast::TypeKind::Bool; } },
            }
            if eq && (is_named(lt) || is_array(lt) || is_box(lt) || slice) {
                if exec_mode(mode) {
                    let fix: String = if is_box(lt) {
                        types::cat7("compare the values: `*", fmt::expr_text(l).as_str(), " ", sym.as_str(), " *", fmt::expr_text(r).as_str(), "`")
                    } else {
                        String::from("compare the fields (or `match` the variants) in code")
                    };
                    self.c.help("E0425", span, types::cat5("`", sym.as_str(), "` on `", ltt.as_str(), "` is only defined in specifications").as_str(), fix.as_str());
                } else {
                    match self.recursive_with_vec(lt) {
                        None => {},
                        Some(c) => self.c.help("E0431", span, types::cat7("`", sym.as_str(), "` on `", ltt.as_str(), "` is not defined: `", types::text(&c).as_str(), "` is recursive and holds a `Vec`").as_str(), "compare the parts that matter, or write a recursive spec fn over them"),
                    }
                }
                return ast::TypeKind::Bool;
            }
            let ok: bool = if eq {
                types::is_scalar(lt)
            } else if is_bit(op) {
                types::is_int(lt) || is_bool(lt)
            } else if is_rem(op) {
                types::is_int(lt)
            } else if is_cmp(op) && (is_char(lt) || is_bool(lt)) {
                true
            } else {
                types::is_int(lt) || is_f64(lt)
            };
            if !ok {
                let msg: String = types::cat5("`", sym.as_str(), "` is not defined for `", ltt.as_str(), "`");
                if is_f64(lt) && is_rem(op) {
                    self.c.help("E0401", span, msg.as_str(), "`%` on `f64` (Rust's truncated remainder) is not supported yet (ADR-0061 §3): compute `x - y * q` with the quotient you need");
                } else if is_f64(lt) {
                    self.c.help("E0401", span, msg.as_str(), "`f64` has `+ - * /`, unary `-` and the comparisons; bit operations are on integers");
                } else if is_bit(op) {
                    self.c.help("E0401", span, msg.as_str(), "`&`, `|` and `^` take two integers of one type, or two `bool`s");
                } else {
                    self.c.err("E0401", span, msg.as_str());
                }
                return bin_fail(valued);
            }
            if valued {
                lt.clone()
            } else {
                ast::TypeKind::Bool
            }
        }

        #[summary("피연산자의 타입 lt, rt로 이항 연산의 타입: char는 수가 아니고, 글은 글과 견주고, 명세에서는 정수 타입이 섞인다 (ADR-0022), 코드에서는 한 타입이다")]
        #[effects(alloc)]
        fn binary_types(self: &mut Body, op: ast::BinOp, l: &ast::Expr, r: &ast::Expr, lt: &ast::TypeKind, rt: &ast::TypeKind, mode: Mode, span: source::Span) -> ast::TypeKind {
            let valued: bool = is_arith(op) || is_bit(op);
            if types::is_error(lt) || types::is_error(rt) {
                return bin_fail(valued);
            }
            let sym: String = op_symbol(op);
            if (is_char(lt) || is_char(rt)) && !is_cmp(op) {
                self.c.help("E0401", span, types::cat3("`", sym.as_str(), "` is not defined for `char`").as_str(), "compute on the scalar value `u32::from(c)` and make a character with `char::from_u32(x)`");
                return bin_fail(valued);
            }
            let ltt: String = types::text(lt);
            let rtt: String = types::text(rt);
            if is_text(lt) || is_text(rt) {
                if is_text(lt) && is_text(rt) && is_cmp(op) {
                    return ast::TypeKind::Bool;
                }
                let tmsg: String = types::cat7("`", sym.as_str(), "` is not defined for `", ltt.as_str(), "` and `", rtt.as_str(), "`");
                if is_add(op) && is_text(lt) {
                    self.c.help("E0401", span, tmsg.as_str(), "append with `s.push_str(t)` (or `s.push(c)`)");
                } else {
                    self.c.help("E0401", span, tmsg.as_str(), "text compares with text: `==`, `<` and the other comparisons");
                }
                return bin_fail(valued);
            }
            let same: bool = types::same(lt, rt);
            let ints: bool = types::is_int(lt) && types::is_int(rt);
            if !same && !exec_mode(mode) && ints && is_bit(op) {
                if !conv_obligation(rt, lt) {
                    return lt.clone();
                }
                if !conv_obligation(lt, rt) {
                    return rt.clone();
                }
                self.c.help("E0401", span, types::cat7("`", sym.as_str(), "` needs a width, and no integer type holds both `", ltt.as_str(), "` and `", rtt.as_str(), "`").as_str(), "give both operands one type, e.g. a spec fn parameter of that type");
                return ast::TypeKind::Error;
            }
            if !same && !exec_mode(mode) && ints {
                if is_arith(op) {
                    return ast::TypeKind::Int(ast::IntTy::I64);
                }
                return ast::TypeKind::Bool;
            }
            if !same {
                let msg: String = types::cat7("`", sym.as_str(), "` needs operands of one type, found `", ltt.as_str(), "` and `", rtt.as_str(), "`");
                if types::is_int(lt) && is_f64(rt) || is_f64(lt) && types::is_int(rt) {
                    self.c.help("E0401", span, msg.as_str(), "convert the integer operand: `f64::from(x)` (`f64` does not convert to integers)");
                } else if ints {
                    if conv_obligation(lt, rt) {
                        self.c.help("E0401", span, msg.as_str(), types::cat5("convert the `", rtt.as_str(), "` operand: `x as ", ltt.as_str(), "`").as_str());
                    } else {
                        self.c.help("E0401", span, msg.as_str(), types::cat5("convert the `", ltt.as_str(), "` operand: `x as ", rtt.as_str(), "`").as_str());
                    }
                } else {
                    self.c.err("E0401", span, msg.as_str());
                }
                return bin_fail(valued);
            }
            self.binary_same(op, l, r, lt, mode, span)
        }

        #[summary("owner의 함수 sig를 메서드로 부르는 길 (ADR-0051): 수신자를 넘기는 방식과 타입 인자. by_self면 trait의 메서드(수신자는 Self), 아니면 타입 owner의 impl. 메서드로 부를 수 없으면 E0314, 공유 참조로 &mut 메서드를 부르면 E0401")]
        #[effects(alloc)]
        fn bind_method(self: &mut Body, cx: &FnCtx, rt: &ast::TypeKind, value: &ast::TypeKind, owner: &str, by_self: bool, sig: &types::FnSig, recv: &ast::Expr, name: &ast::Ident, args: &[ast::Expr], span: source::Span) -> Found {
            let adjust: ast::Adjust = match receiver_adjust(sig.params.as_slice(), is_ref(rt), owner, by_self) {
                None => { let none: Option<ast::Adjust> = None; self.not_a_method(cx, owner, recv, name, args, span, true, none); return Found::Reported; },
                Some(a) => a,
            };
            if self.shared_receiver(cx, rt, sig, owner, recv, name) {
                return Found::Reported;
            }
            if sig.generics.len() > sig.impl_generics {
                self.not_a_method(cx, owner, recv, name, args, span, false, Some(adjust));
                return Found::Reported;
            }
            let mut type_args: Vec<ast::TypeKind> = Vec::new();
            if !by_self {
                let mut ig: Vec<types::TParam> = Vec::new();
                for i in 0..sig.generics.len()
                    invariant 0 <= i && i <= sig.generics.len(),
                {
                    if i < sig.impl_generics {
                        ig.push(sig.generics[i].clone());
                    }
                }
                let mut m: types::Subst = empty_subst();
                if sig.params.len() > 0 {
                    let decl: ast::TypeKind = match ref_inner(&sig.params[0]) {
                        None => sig.params[0].clone(),
                        Some(inner) => inner,
                    };
                    types::unify(&decl, value, ig.as_slice(), &mut m, 100000);
                }
                for j in 0..ig.len()
                    invariant 0 <= j && j <= ig.len(),
                {
                    match types::sub_get(&m, ig[j].name.as_str()) {
                        None => { type_args.push(ast::TypeKind::Error); },
                        Some(t) => { type_args.push(t); },
                    }
                }
            }
            let mut path: Vec<String> = refs::split_path(owner);
            path.push(name.name.clone());
            Found::Target(MethodTarget { path: path, type_args: type_args, adjust: adjust })
        }

        #[summary("블록 안의 by (bit_vector) 항: let의 초기값과 끝 식. let의 이름은 블록 안에서 묶인다")]
        #[effects(alloc)]
        fn bit_vector_block(self: &mut Body, b: &ast::Block, bound: &mut Vec<String>, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let n: usize = bound.len();
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                match &b.stmts[i] {
                    ast::Stmt::Let(sl) => { self.bit_vector_terms(&sl.init, bound, f - 1); bound.push(sl.name.name.clone()); },
                    ast::Stmt::Assign(q4_sa) => {},
                    ast::Stmt::While(q4_sw) => {},
                    ast::Stmt::For(q4_sf) => {},
                    ast::Stmt::Assert(q4_st) => {},
                    ast::Stmt::Assume(q4_su) => {},
                    ast::Stmt::Proof(q4_sp) => {},
                    ast::Stmt::LetFields(q4_lf) => {},
                    ast::Stmt::Expr(q4_se) => {},
                }
            }
            match &b.tail {
                None => {},
                Some(t) => self.bit_vector_terms(&**t, bound, f - 1),
            }
            bound.truncate(n);
        }

        #[summary("assert(e) by (bit_vector)의 항 (ADR-0048 §4): 변수·리터럴·정수와 f64의 상수·연산자·if·let 블록·정수 메서드·spec fn 호출로 지은 정수·f64·bool 값. 다른 값의 스칼라 읽기(원소, 필드, 참조 뒤의 값, 스칼라 아닌 받는 값의 메서드)는 단언의 let을 말하지 않으면 부증명의 변수다 (백로그 2N-11). 나머지는 E0515")]
        #[effects(alloc)]
        fn bit_vector_terms(self: &mut Body, e: &ast::Expr, bound: &mut Vec<String>, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let ty: ast::TypeKind = self.type_at(e.span);
            if types::is_error(&ty) {
                return;
            }
            let scalar: bool = types::is_scalar(&ty);
            let mut what: u8 = 0;
            match &e.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => { if !scalar { what = 6; } },
                ast::ExprKind::Float(q4_ek_float0) => { if !scalar { what = 6; } },
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => { if !scalar { what = 6; } },
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => { what = 6; },
                ast::ExprKind::StrLit(q4_ek_strlit0) => { what = 6; },
                ast::ExprKind::CharLit(q4_ek_charlit0) => { if !scalar { what = 6; } },
                ast::ExprKind::Bool(q4_ek_bool0) => { if !scalar { what = 6; } },
                ast::ExprKind::Unit => { what = 6; },
                ast::ExprKind::Var(q4_ek_var0) => { if !scalar { what = 6; } },
                ast::ExprKind::Call(c) => { if scalar { for j in 0..c.args.len() invariant 0 <= j && j <= c.args.len(), { self.bit_vector_terms(&c.args[j], bound, f - 1); } } else { what = 6; } },
                ast::ExprKind::Method(m) => { if scalar { if types::is_scalar(&self.type_at(m.recv.span)) || any_bound(e, bound.as_slice()) { self.bit_vector_terms(&*m.recv, bound, f - 1); for i in 0..m.args.len() invariant 0 <= i && i <= m.args.len(), { self.bit_vector_terms(&m.args[i], bound, f - 1); } } } else { what = 6; } },
                ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => { if !scalar || any_bound(e, bound.as_slice()) { what = 1; } },
                ast::ExprKind::Unary(q4_op, x) => { if scalar { self.bit_vector_terms(&**x, bound, f - 1); } else { what = 6; } },
                ast::ExprKind::Binary(q4_bop, a, b) => { if scalar { self.bit_vector_terms(&**a, bound, f - 1); self.bit_vector_terms(&**b, bound, f - 1); } else { what = 6; } },
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => { what = 6; },
                ast::ExprKind::If(ife) => { if scalar { self.bit_vector_terms(&*ife.cond, bound, f - 1); self.bit_vector_block(&ife.then, bound, f - 1); match &ife.els { None => {}, Some(el) => self.bit_vector_terms(&**el, bound, f - 1), } } else { what = 6; } },
                ast::ExprKind::Block(blk) => { if scalar { self.bit_vector_block(blk, bound, f - 1); } else { what = 6; } },
                ast::ExprKind::Array(q4_ek_array0) => { what = 6; },
                ast::ExprKind::Repeat(q4_ek_repeat0) => { what = 6; },
                ast::ExprKind::Old(q4_ek_old0) => { what = 4; },
                ast::ExprKind::Quant(q4_ek_quant0) => { what = 3; },
                ast::ExprKind::Trigger(q4_ek_trigger0) => { what = 6; },
                ast::ExprKind::Closure(q4_ek_closure0) => { what = 6; },
                ast::ExprKind::StructLit(q4_ek_structlit0) => { what = 6; },
                ast::ExprKind::Path(p) => { if !int_const(p.as_slice()) && !f64_const(p.as_slice()) { what = 6; } },
                ast::ExprKind::Deref(q4_ek_deref0) => { if !scalar || any_bound(e, bound.as_slice()) { what = 5; } },
                ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => { if !scalar || any_bound(e, bound.as_slice()) { what = 2; } },
                ast::ExprKind::Match(q4_ek_match0) => { what = 6; },
                ast::ExprKind::Return(q4_ek_return0) => { what = 6; },
                ast::ExprKind::Try(q4_ek_try0) => { what = 6; },
                ast::ExprKind::Loop(q4_ek_loop0) => { what = 6; },
                ast::ExprKind::Break(q4_ek_break0) => { what = 6; },
                ast::ExprKind::Continue(q4_ek_continue0) => { what = 6; },
                ast::ExprKind::Range(q4_ek_range0) => { what = 6; },
                ast::ExprKind::Error => { what = 6; },
            }
            if what == 0 {
                return;
            }
            let text: String = if what == 1 {
                String::from("an element")
            } else if what == 2 {
                String::from("a field")
            } else if what == 3 {
                String::from("a quantifier")
            } else if what == 4 {
                String::from("an entry value (`old`)")
            } else if what == 5 {
                String::from("a value behind a reference")
            } else if !scalar {
                types::cat3("a value of type `", types::text(&ty).as_str(), "`")
            } else {
                String::from("not a bit-vector term")
            };
            self.c.help("E0515", e.span, types::cat4("`by (bit_vector)` takes integer, `f64` and `bool` terms: `", fmt::expr_text(e).as_str(), "` is ", text.as_str()).as_str(), "assert over integer and `bool` terms: an element, a field or a length is one when it names no `let` of the assertion; a quantified fact is a `proof fn` over one value");
        }

        #[summary("블록: 새 범위에서 문장을 차례로, 끝 식의 타입. 끝 식이 없고 끝나지 않는 문장이 있으면 `!`")]
        #[effects(alloc)]
        fn block(self: &mut Body, cx: &mut FnCtx, b: &ast::Block, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 2,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let scope: Vec<Local> = Vec::new();
            cx.scopes.push(scope);
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                self.stmt(cx, &b.stmts[i], mode, f - 1);
            }
            let t: ast::TypeKind = match &b.tail {
                None => { if self.diverges(b) { ast::TypeKind::Never } else { ast::TypeKind::Unit } },
                Some(e) => self.expr(cx, &**e, expected, mode, f - 1),
            };
            cx.scopes.pop();
            t
        }

        #[summary("Box::new(v) (ADR-0047 §1): 담는 타입은 기대한 타입의 것, 없으면 v의 것")]
        #[effects(alloc)]
        fn box_new(self: &mut Body, cx: &mut FnCtx, args: &[ast::Expr], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            if args.len() != 1 {
                self.c.err("E0405", span, decls::count1("`Box::new` takes 1 argument, found ", args.len()).as_str());
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            let mut want: Option<ast::TypeKind> = None;
            match expected {
                None => {},
                Some(x) => { if types::is_error(x) { let he: Option<ast::TypeKind> = Some(ast::TypeKind::Error); self.expr(cx, &args[0], &he, mode, f - 1); return ast::TypeKind::Error; } want = box_inner(x); },
            }
            let t: ast::TypeKind = self.expr(cx, &args[0], &want, mode, f - 1);
            match want {
                None => {},
                Some(w) => { self.expect_ty(&t, &w, args[0].span); return ast::TypeKind::Box(types::boxed(w)); },
            }
            if types::is_error(&t) {
                return ast::TypeKind::Error;
            }
            if decls::is_unit(&t) {
                self.c.err("E0402", args[0].span, "a `Box<()>` is not supported (ADR-0047 §1)");
                return ast::TypeKind::Error;
            }
            ast::TypeKind::Box(types::boxed(t))
        }

        #[summary("break와 break 값: 값은 loop만 떠난다 (E0251). loop의 break들은 한 타입의 값을 든다")]
        #[effects(alloc)]
        fn break_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, b: &ast::Break, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if !exec_mode(mode) {
                self.c.help("E0503", e.span, "`break` is not allowed in a specification", "a specification is one expression: it has no loop to leave");
            }
            let target: Option<usize> = self.jump_target(cx, &b.label, e.span, "break");
            let want: Option<ast::TypeKind> = match target {
                None => None,
                Some(k) => { if k < cx.loops.len() { cx.loops[k].value.clone() } else { None } },
            };
            let mut has_value: bool = false;
            let mut sp: source::Span = e.span;
            let t: ast::TypeKind = match &b.value {
                None => ast::TypeKind::Unit,
                Some(v) => { has_value = true; sp = v.span; self.expr(cx, &**v, &want, mode, f - 1) },
            };
            match target {
                None => {},
                Some(k2) => { if k2 < cx.loops.len() { if !cx.loops[k2].is_loop && has_value { self.c.help("E0251", e.span, "`break` with a value leaves only a `loop`", "assign the value to a variable declared before the `while`, then `break`"); } else if cx.loops[k2].is_loop { match &want { None => { if !is_never(&t) { cx.loops[k2].value = Some(t.clone()); } }, Some(w) => { let mark: usize = self.c.diags.len(); self.expect_ty(&t, w, sp); if self.c.diags.len() > mark { loop_fix(&mut self.c.diags, types::cat3("every `break` of this `loop` carries its value, a `", types::text(w).as_str(), "`").as_str()); } }, } } } },
            }
            ast::TypeKind::Never
        }

        #[summary("E0221: 내장 변형은 타입 없이 쓴다 (ADR-0026 §3)")]
        #[effects(alloc)]
        fn builtin_by_path(self: &mut Body, segs: &[ast::Ident]) -> () {
            if segs.len() < 2 {
                return;
            }
            self.c.fixed("E0221", decls::span_to(segs[0].span, segs[1].span), types::cat5("write `", segs[1].name.as_str(), "`, not `", segs[0].name.as_str(), types::cat3("::", segs[1].name.as_str(), "`").as_str()).as_str(), types::cat3("`", segs[1].name.as_str(), "` is a built-in name").as_str(), segs[1].name.as_str());
        }

        #[summary("rt 타입의 받는 값에 x.clone()이 내장 깊은 사본인가 (ADR-0141 §1): 메모리를 가진 타입(구조체·열거형·Box·배열)이고 제 clone이 없다 (제 함수나 trait의 메서드가 먼저다)")]
        #[effects(alloc)]
        fn builtin_clone(self: &Body, rt: &ast::TypeKind) -> bool {
            let value: ast::TypeKind = match ref_inner(rt) {
                None => rt.clone(),
                Some(inner) => inner,
            };
            let mut own: bool = false;
            if !is_box(&value) && !is_array(&value) {
                match types::named_path(&value) {
                    None => { return false; },
                    Some(tp) => { match self.c.fns.find(types::cat2(tp.as_str(), "::clone").as_str()) { None => {}, Some(i) => { if !is_some(&self.c.fns.items[i].trait_of) { own = true; } }, } if self.impls_have(&value, self.c.trait_impls.as_slice(), "clone") || self.impls_have(&value, self.c.rejected_impls.as_slice(), "clone") { own = true; } },
                }
            }
            let moving: Vec<String> = self.c.moving_params();
            !own && types::is_move_in(&value, &self.c.adts, moving.as_slice())
        }

        #[summary("Some(x), None, Ok(x), Err(e): 타입은 기대한 타입에서 온다 (Some(x)만은 Option<x의 타입>)")]
        #[effects(alloc)]
        fn builtin_variant(self: &mut Body, cx: &mut FnCtx, name: &str, args: &[ast::Expr], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let arity: usize = if name == "None" {
                0
            } else {
                1
            };
            if args.len() != arity {
                self.c.err("E0405", span, decls::counts(types::cat3("`", name, "` takes ").as_str(), arity, " value(s), found ", args.len(), "").as_str());
            }
            let mut whole: ast::TypeKind = ast::TypeKind::Error;
            let mut inner: Option<ast::TypeKind> = None;
            match expected {
                None => {},
                Some(t) => { let ta: Vec<ast::TypeKind> = types::named_args(t); if (name == "Some" || name == "None") && named_one(t, "Option") { whole = t.clone(); if ta.len() > 0 { inner = Some(ta[0].clone()); } } else if (name == "Ok" || name == "Err") && named_one(t, "Result") { whole = t.clone(); let k: usize = if name == "Err" { 1 } else { 0 }; if k < ta.len() { inner = Some(ta[k].clone()); } } },
            }
            let no: Option<ast::TypeKind> = None;
            match inner {
                None => {},
                Some(it) => { let hint: Option<ast::TypeKind> = Some(it.clone()); for i in 0..args.len() invariant 0 <= i && i <= args.len(), { let at: ast::TypeKind = self.expr(cx, &args[i], &hint, mode, f - 1); self.expect_ty(&at, &it, args[i].span); } return whole; },
            }
            if name == "Some" && args.len() == 1 {
                let xt: ast::TypeKind = self.expr(cx, &args[0], &no, mode, f - 1);
                if types::is_error(&xt) {
                    return ast::TypeKind::Error;
                }
                let mut targs: Vec<ast::Type> = Vec::new();
                targs.push(types::ty(xt));
                return ast::TypeKind::Named(single("Option"), targs);
            }
            for j in 0..args.len()
                invariant 0 <= j && j <= args.len(),
            {
                self.expr(cx, &args[j], &no, mode, f - 1);
            }
            self.c.help("E0424", span, types::cat3("the type of `", name, "` is not known here").as_str(), "give it a type: `let o: Option<i64> = None;`, or pass it where the type is written");
            ast::TypeKind::Error
        }

        #[summary("u8을 기대한 자리가 아니면 u8인 바이트 리터럴. 글자를 기대한 자리면 E0401, 고침은 글자 리터럴")]
        #[effects(alloc)]
        fn byte_lit(self: &mut Body, b: u8, expected: &Option<ast::TypeKind>, span: source::Span) -> ast::TypeKind {
            if opt_char(expected) {
                let mut cs: String = String::new();
                match char::from_u32(b as u32) {
                    None => {},
                    Some(c) => cs.push(c),
                }
                self.c.fixed("E0401", span, "expected `char`, found `u8`", "a character is `'a'`", lexer::str_text(cs.as_str(), 39).as_str());
                return ast::TypeKind::Char;
            }
            ast::TypeKind::Int(ast::IntTy::U8)
        }

        #[summary("경로로 부르는 호출 f(args): 가리키는 함수, 부르는 곳과 함수의 종류(실행·명세·증명), 효과, 인자 수, 쓰거나 추론한 타입 인자 (ADR-0046 §3, 추론하면 E0237이 써 준다), 인자마다의 타입, &mut 인자의 겹침 (E0410)")]
        #[effects(alloc)]
        fn call(self: &mut Body, cx: &mut FnCtx, path: &[ast::Ident], targs: &[ast::TArgs], args: &[ast::Expr], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 || path.len() == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let name: String = decls::path_text(path);
            let quoted: String = types::cat3("`", name.as_str(), "`");
            let target: String = match self.resolve(path, cx.mod_path.as_str()) {
                None => { let segs: Vec<String> = names_of(path); let pspan: source::Span = decls::span_to(path[0].span, path[path.len() - 1].span); match self.c.import_text(segs.as_slice(), cx.mod_path.as_str()) { None => { let tip: String = if path.len() == 1 { types::cat7("no `", name.as_str(), "` in unit `", cx.mod_path.as_str(), "`; other units are reached by full path `unit::", name.as_str(), "`") } else { types::cat2("no function ", quoted.as_str()) }; self.c.help("E0304", span, types::cat2("unknown function ", quoted.as_str()).as_str(), tip.as_str()); }, Some(text) => { self.c.fixed("E0214", pspan, types::cat2(quoted.as_str(), " comes from a `use`").as_str(), types::cat3("write `", text.as_str(), "`").as_str(), text.as_str()); }, } for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if !is_ref_expr(&args[i].kind) { self.expr(cx, &args[i], &no, mode, f - 1); } } return ast::TypeKind::Error; },
                Some(t) => t,
            };
            let sig: types::FnSig = match self.c.fns.find(target.as_str()) {
                None => { return ast::TypeKind::Error; },
                Some(at) => self.c.fns.items[at].clone(),
            };
            self.call_kind(cx, path, targs, args, &sig, target.as_str(), quoted.as_str(), span, mode);
            let no_value: bool = !exec_mode(mode) && !ghost_mode(mode) && is_proof(sig.kind);
            let amode: Mode = operand(mode);
            if ghost_mode(mode) {
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    if ref_mutable(&args[i]) {
                        self.ghost_violation(args[i].span, "`&mut`", "pass the value or `&` it");
                    }
                }
            }
            if args.len() != sig.params.len() {
                self.c.err("E0405", span, decls::counts(types::cat2(quoted.as_str(), " takes ").as_str(), sig.params.len(), " argument(s), found ", args.len(), "").as_str());
            }
            if sig.generics.len() == 0 && targs.len() > 0 {
                self.c.fixed("E0429", targs[0].span, types::cat2(quoted.as_str(), " takes no type arguments").as_str(), "remove them", "");
            }
            let mut tm: types::Subst = empty_subst();
            let mut missing: bool = false;
            if sig.generics.len() > 0 {
                missing = self.written_targs(cx, path, targs, &sig, &mut tm);
            }
            let is_trait: bool = !no_text(&sig.trait_of);
            let infer: bool = missing || is_trait;
            if infer {
                match expected {
                    None => {},
                    Some(want) => { types::unify(&sig.ret, want, sig.generics.as_slice(), &mut tm, 100000); },
                }
            }
            let mut deferred: Vec<usize> = Vec::new();
            let mut mut_roots: Vec<MutRoot> = Vec::new();
            for i in 0..args.len()
                invariant 0 <= i && i <= args.len(),
            {
                self.call_arg(cx, &sig, &mut tm, &args[i], i, infer, is_trait, amode, &mut deferred, &mut mut_roots, f - 1);
            }
            self.call_deferred(cx, &sig, &tm, args, deferred.as_slice(), amode, f - 1);
            if !self.call_bound(cx, path, targs, &sig, &tm, name.as_str(), missing, span) {
                return ast::TypeKind::Error;
            }
            if !self.call_record(cx, &sig, &tm, target.as_str(), span) {
                return ast::TypeKind::Error;
            }
            self.alias_check(&sig, args, mut_roots.as_slice());
            if no_value {
                return ast::TypeKind::Error;
            }
            types::subst(&sig.ret, &tm)
        }

        #[summary("호출의 i번째 인자 a: 타입 인자를 추론하는 중이면 그 인자에서 묶고(문맥의 타입을 받는 리터럴은 deferred로 미룬다), 참조 매개변수는 ref_arg로 (&mut 인자가 출발하는 변수는 mut_roots에), 값 매개변수는 그 타입을 기대하며 검사한다")]
        #[effects(alloc)]
        fn call_arg(self: &mut Body, cx: &mut FnCtx, sig: &types::FnSig, tm: &mut types::Subst, a: &ast::Expr, i: usize, infer: bool, is_trait: bool, mode: Mode, deferred: &mut Vec<usize>, mut_roots: &mut Vec<MutRoot>, f: usize) -> ()
            decreases f * 3 + 2,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            if i >= sig.params.len() {
                self.expr(cx, a, &no, mode, f - 1);
                return;
            }
            let pt0: ast::TypeKind = sig.params[i].clone();
            if infer && unbound(sig.generics.as_slice(), tm, &pt0) {
                if self.arg_infer(cx, sig, tm, a, i, &pt0, mode, deferred, f) {
                    return;
                }
            }
            let pt: ast::TypeKind = types::subst(&pt0, tm);
            if is_trait && is_ref(&pt) && unbound(sig.generics.as_slice(), tm, &pt0) {
                return;
            }
            match ref_inner(&pt) {
                None => { self.arg_value(cx, a, &pt, mode, f); },
                Some(inner) => { let pm: bool = types::is_ref_mut(&pt); match self.ref_arg(cx, a, pm, &inner, mode, f) { None => {}, Some(root) => { if pm { mut_roots.push(MutRoot { root: root.clone(), at: i }); } }, } },
            }
        }

        #[summary("추론한 타입 인자의 마감: trait 메서드의 Self가 묶였는가 (아니면 E0237)와 그 경계, 빠뜨린 타입 인자가 모두 추론되어 경계를 지키는가, 그리고 써 넣는 E0237. 호출이 계속되는가")]
        #[effects(alloc)]
        fn call_bound(self: &mut Body, cx: &FnCtx, path: &[ast::Ident], targs: &[ast::TArgs], sig: &types::FnSig, tm: &types::Subst, name: &str, missing: bool, span: source::Span) -> bool {
            let is_trait: bool = !no_text(&sig.trait_of);
            let quoted: String = types::cat3("`", name, "`");
            if is_trait {
                let st: ast::TypeKind = match types::sub_get(tm, "Self") {
                    None => ast::TypeKind::Error,
                    Some(found) => found,
                };
                if types::is_error(&st) {
                    let tr: String = match &sig.trait_of {
                        None => String::new(),
                        Some(p) => p.clone(),
                    };
                    self.c.help("E0237", span, types::cat3("the implementing type of ", quoted.as_str(), " cannot be inferred: no argument or expected result gives `Self`").as_str(), types::cat3("give an argument or the result a type that implements `", tr.as_str(), "`").as_str());
                    return false;
                }
                if sig.generics.len() == 0 {
                    return false;
                }
                if !self.c.targ_ok(&st, &sig.generics[0], name, span, true) {
                    return false;
                }
            }
            if missing {
                if all_bound(sig.generics.as_slice(), tm) {
                    let mut ok: bool = true;
                    for i in 0..sig.generics.len()
                        invariant 0 <= i && i <= sig.generics.len(),
                    {
                        if i > 0 || !is_trait {
                            let gt: ast::TypeKind = bound_or_error(tm, sig.generics[i].name.as_str());
                            if !self.c.targ_ok(&gt, &sig.generics[i], name, span, true) {
                                ok = false;
                            }
                        }
                    }
                    if !ok {
                        return false;
                    }
                }
                let known: types::Subst = without_errors(tm);
                if !self.targs_fix(path, targs, sig, &known, cx.mod_path.as_str()) {
                    return false;
                }
            }
            true
        }

        #[summary("미뤄 둔 인자(문맥의 타입을 받는 리터럴): 다른 인자가 타입 인자를 묶은 뒤에 그 타입을 기대하며 검사한다")]
        #[effects(alloc)]
        fn call_deferred(self: &mut Body, cx: &mut FnCtx, sig: &types::FnSig, tm: &types::Subst, args: &[ast::Expr], deferred: &[usize], mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            for k in 0..deferred.len()
                invariant 0 <= k && k <= deferred.len(),
            {
                let d: usize = deferred[k];
                if d < sig.params.len() && d < args.len() {
                    let pt: ast::TypeKind = types::subst(&sig.params[d], tm);
                    if has_param_of(&pt, sig.generics.as_slice(), tm) {
                        self.expr(cx, &args[d], &no, mode, f - 1);
                    } else {
                        let hint: Option<ast::TypeKind> = Some(pt.clone());
                        let dt: ast::TypeKind = self.expr(cx, &args[d], &hint, mode, f - 1);
                        if !(!exec_mode(mode) && types::is_int(&dt) && types::is_int(&pt)) {
                            self.expect_ty(&dt, &pt, args[d].span);
                        }
                    }
                }
            }
        }

        #[summary("호출 꼴의 식이 무엇인가: 바이트에서 온 정수, f64::from, 정수 변환, 내장 변형, 열거형의 변형, std::mem, Box::new, 글과 Vec의 내장 호출, 그리고 함수 호출")]
        #[effects(alloc)]
        fn call_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, c: &ast::Call, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            match from_bytes_int(c.path.as_slice()) {
                None => {},
                Some(i) => { return self.from_bytes(cx, e, c, i, mode, f); },
            }
            if is_f64_from(c.path.as_slice()) {
                return self.f64_from(cx, c.args.as_slice(), e.span, mode, f);
            }
            if conv_call(e) || from_call(c.path.as_slice()) {
                return self.bare_conv(cx, e, c, mode, f);
            }
            if c.path.len() == 2 && builtin_path(c.path.as_slice()) {
                self.builtin_by_path(c.path.as_slice());
                return self.builtin_variant(cx, c.path[1].name.as_str(), c.args.as_slice(), expected, e.span, mode, f);
            }
            if c.path.len() == 1 && (c.path[0].name == "Some" || c.path[0].name == "Ok" || c.path[0].name == "Err") {
                return self.builtin_variant(cx, c.path[0].name.as_str(), c.args.as_slice(), expected, e.span, mode, f);
            }
            let unresolved: bool = !is_some(&self.resolve(c.path.as_slice(), cx.mod_path.as_str()));
            if unresolved && self.enum_prefix(c.path.as_slice(), cx.mod_path.as_str()) {
                return self.variant_value(cx, c.path.as_slice(), c.args.as_slice(), expected, e.span, mode, f);
            }
            if unresolved && mem_op(c.path.as_slice()) {
                return self.mem_call(cx, c.path.as_slice(), c.args.as_slice(), e.span, mode, f);
            }
            if unresolved && is_box_new(c.path.as_slice()) {
                if exec_mode(mode) {
                    need_own(cx, alloc_effect(), "`Box::new`");
                }
                return self.box_new(cx, c.args.as_slice(), expected, e.span, mode, f);
            }
            if unresolved && text_builtin(c.path.as_slice()) {
                return self.text_call(cx, c.path.as_slice(), c.args.as_slice(), e.span, mode, f);
            }
            if unresolved && c.path.len() > 0 && vec_builtin(c.path.as_slice()) {
                if exec_mode(mode) && c.path[0].name == "Vec" {
                    need_own(cx, alloc_effect(), types::cat3("`", decls::path_text(c.path.as_slice()).as_str(), "`").as_str());
                }
                return self.vec_call(cx, c.path.as_slice(), c.args.as_slice(), expected, e.span, mode, f);
            }
            self.call(cx, c.path.as_slice(), c.targs.as_slice(), c.args.as_slice(), expected, e.span, mode, f)
        }

        #[summary("부르는 곳(실행·명세·유령)과 함수의 종류(실행·명세·증명)의 짝: 증명 함수는 유령 코드에서만 (ADR-0062 §1, E0258), 실행 함수는 실행 코드에서만 (E0504, 유령이면 E0257), 명세 함수는 명세에서만 (E0505). 맞는 짝이면 효과를 요구하고 호출을 적는다")]
        #[effects(alloc)]
        fn call_kind(self: &mut Body, cx: &mut FnCtx, path: &[ast::Ident], targs: &[ast::TArgs], args: &[ast::Expr], sig: &types::FnSig, target: &str, quoted: &str, span: source::Span, mode: Mode) -> () {
            let caller: String = cx.path.clone();
            if is_proof(sig.kind) {
                if exec_mode(mode) {
                    let whole: ast::Expr = ast::Expr { kind: ast::ExprKind::Call(ast::Call { path: idents(path), targs: targs_copy(targs), args: exprs_copy(args), method: None }), span: span };
                    let r: String = types::cat3("proof { ", fmt::expr_text(&whole).as_str(), "; }");
                    self.c.fixed("E0258", span, types::cat2(quoted, " is a `proof fn`: executable code calls it in a `proof { .. }` block").as_str(), types::cat3("wrap the call: `", r.as_str(), "`").as_str(), r.as_str());
                } else if ghost_mode(mode) {
                    self.add_call(caller.as_str(), target);
                } else {
                    self.c.help("E0258", span, types::cat2(quoted, " is a `proof fn` and has no value in a specification").as_str(), "call it as a statement of a `proof { .. }` block or a `proof fn`; its `ensures` then hold after the call");
                }
            } else if is_exec(sig.kind) {
                if exec_mode(mode) {
                    need(cx, sig.effect, types::cat2("a call of ", quoted).as_str());
                    if types::is_pure(cx.effect) && sig.effect.io {
                        self.c.help("E0603", span, types::cat5(quoted, " has effect `io`, but `", caller.as_str(), "` is `pure`", "").as_str(), types::cat3("declare `#[effects(io)]` on `", caller.as_str(), "`, or move the call out of it").as_str());
                    }
                    self.add_call(caller.as_str(), target);
                } else if ghost_mode(mode) || cx.ghost {
                    self.ghost_violation(span, types::cat2("a call of executable function ", quoted).as_str(), "call it outside the `proof` block, or state the fact with a spec fn or a `proof fn`");
                } else {
                    self.c.err("E0504", span, types::cat2(quoted, " is executable and cannot be called from a specification").as_str());
                }
            } else if exec_mode(mode) {
                self.c.err("E0505", span, types::cat2(quoted, " is a spec function and cannot be called from executable code").as_str());
            } else {
                self.add_call(caller.as_str(), target);
            }
        }

        #[summary("타입 인자가 있는 호출을 적는다: 타입 인자(targs), 재귀 검사에 쓸 호출(gcalls), Self가 알려진 trait 호출이 돌리는 impl의 함수. 묶이지 않은 매개변수가 있으면 false")]
        #[effects(alloc)]
        fn call_record(self: &mut Body, cx: &FnCtx, sig: &types::FnSig, tm: &types::Subst, target: &str, span: source::Span) -> bool {
            let caller: String = cx.path.clone();
            if sig.generics.len() > 0 {
                if !all_bound(sig.generics.as_slice(), tm) {
                    return false;
                }
                let mut gargs: Vec<ast::TypeKind> = Vec::new();
                for i in 0..sig.generics.len()
                    invariant 0 <= i && i <= sig.generics.len(),
                {
                    gargs.push(bound_or_error(tm, sig.generics[i].name.as_str()));
                }
                match dispatch(&self.c.fns, self.c.trait_impls.as_slice(), target, gargs.as_slice()) {
                    None => {},
                    Some(imp) => { self.add_call(caller.as_str(), imp.path.as_str()); },
                }
                self.gcalls.push(GCall { caller: caller.clone(), callee: String::from(target), span: span, args: gargs.clone() });
                self.targs.insert(span_key(span).as_str(), gargs);
            }
            true
        }

        #[summary("u8을 기대한 자리의 글자 리터럴: Rust의 버릇, BMB에서도 바이트는 b'a'다 (E0401)")]
        #[effects(alloc)]
        fn char_lit(self: &mut Body, c: u32, expected: &Option<ast::TypeKind>, span: source::Span) -> ast::TypeKind {
            if opt_u8(expected) {
                if c < 128 {
                    let mut one: Vec<u8> = Vec::new();
                    one.push(c as u8);
                    self.c.fixed("E0401", span, "expected `u8`, found `char`", "a byte is `b'..'` (`u8`)", lexer::byte_text(one.as_slice(), 39).as_str());
                } else {
                    self.c.help("E0401", span, "expected `u8`, found `char`", "a byte is `b'..'`; this character is more than one byte");
                }
                return ast::TypeKind::Int(ast::IntTy::U8);
            }
            ast::TypeKind::Char
        }

        #[summary("char의 메서드 (ADR-0050 §2): len_utf8")]
        #[effects(alloc)]
        fn char_method(self: &mut Body, cx: &mut FnCtx, name: &ast::Ident, args: &[ast::Expr], mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            for i in 0..args.len()
                invariant 0 <= i && i <= args.len(),
            {
                self.expr(cx, &args[i], &no, mode, f - 1);
            }
            if name.name == "len_utf8" {
                if args.len() == 0 {
                    return ast::TypeKind::Int(ast::IntTy::Usize);
                }
                self.c.err("E0405", name.span, "`len_utf8` takes no arguments");
                return ast::TypeKind::Error;
            }
            let msg: String = types::cat3("unknown method `", name.name.as_str(), "` of `char`");
            let fix: String = char_missing(name.name.as_str());
            if fix.len() > 0 {
                self.c.help("E0404", name.span, msg.as_str(), fix.as_str());
            } else {
                self.c.err("E0404", name.span, msg.as_str());
            }
            ast::TypeKind::Error
        }

        #[summary("const 하나 (ADR-0052): 타입은 값만 담고(E0437) 초기값은 그 타입이다. 평가기가 먼저 돌았으므로, 검사기가 초기값을 틀렸다고 하면 그 자리의 평가기 진단은 뺀다")]
        #[effects(alloc)]
        fn check_const(self: &mut Body, c: &ast::ConstDef, mp: &str) -> () {
            let saved: Vec<types::TParam> = self.c.tparams.clone();
            self.c.tparams = Vec::new();
            let t: ast::TypeKind = self.c.canon(&c.ty, mp, true, 1000000000);
            if ty_has_error(&t, 1000000000) {
                self.c.tparams = saved;
                return;
            }
            let before: usize = self.c.diags.len();
            let mut seen: Vec<String> = Vec::new();
            if !self.holds_values(&t, &mut seen, 1000000000) {
                self.c.diags.push(consts::not_value(&t, c.ty.span));
                self.drop_evaluator(c.value.span, before);
                self.c.tparams = saved;
                return;
            }
            let mut path: String = String::from(mp);
            path.push_str("::");
            path.push_str(c.name.name.as_str());
            let mut cx: FnCtx = new_ctx(path.as_str(), mp, types::pure(), false);
            cx.ret = t.clone();
            let want: Option<ast::TypeKind> = Some(t.clone());
            let got: ast::TypeKind = self.expr(&mut cx, &c.value, &want, Mode::Exec, 1000000000);
            self.expect_ty(&got, &t, c.value.span);
            let mut any: bool = false;
            for i in 0..self.c.diags.len()
                invariant 0 <= i && i <= self.c.diags.len(),
            {
                if i >= before && starts_e(self.c.diags[i].code.as_str()) {
                    any = true;
                }
            }
            if any {
                self.drop_evaluator(c.value.span, before);
            }
            self.c.tparams = saved;
        }

        #[summary("계약의 절 하나: bool이고, 이름 붙은 술어면 공허하지 않으며(E0502), 한정자를 담으면 이름 붙은 술어다(E0501, ADR-0095 A2)")]
        #[effects(alloc)]
        fn check_contract(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, post: bool) -> () {
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let t: ast::TypeKind = self.expr(cx, e, &want, Mode::Spec(post), 1000000000);
            self.expect_ty(&t, &ast::TypeKind::Bool, e.span);
            let named: Option<usize> = match call_of(e) {
                None => None,
                Some(call) => { match self.resolve(call.path.as_slice(), cx.mod_path.as_str()) { None => None, Some(p) => self.c.fns.find(p.as_str()), } },
            };
            let mut pred: bool = false;
            match named {
                None => {},
                Some(i) => { if is_spec(self.c.fns.items[i].kind) && types::same(&self.c.fns.items[i].ret, &ast::TypeKind::Bool) { pred = true; if self.c.fns.items[i].vacuous { let msg: String = types::cat3("`", self.c.fns.items[i].path.as_str(), "` is the constant `true`; it states nothing"); self.c.err("E0502", e.span, msg.as_str()); } } },
            }
            if !pred && !types::is_error(&t) && has_quant(e) {
                self.c.help("E0501", e.span, "a contract clause with a quantifier is not a named predicate", "move the quantified condition into `spec fn name(..) -> bool { .. }` and call it here");
            }
        }

        #[summary("선언한 효과가 몸이 요구하는 것을 담는가 (ADR-0030 §3). 빠진 효과는 정의에 하나의 E0606이고 고칠 글은 요구하는 효과를 모두 쓴 속성이다. pure가 io를 부르는 것뿐이면 호출 자리의 E0603으로 충분하다")]
        #[effects(alloc)]
        fn check_effects(self: &mut Body, d: &ast::FnDef, cx: &FnCtx) -> () {
            let need: types::Effects = needed(cx);
            let missing: types::Effects = types::e_minus(need, cx.effect);
            if types::is_pure(missing) || types::is_pure(cx.effect) && only_io(missing) {
                return;
            }
            let mut k: usize = d.attrs.len();
            for i in 0..d.attrs.len()
                invariant 0 <= i && i <= d.attrs.len() && k <= d.attrs.len(),
            {
                if k == d.attrs.len() && d.attrs[i].name.name == "effects" {
                    k = i;
                }
            }
            {
                {
                    if k < d.attrs.len() {
                        let mut why: String = String::new();
                        let mut first: bool = true;
                        for j in 0..cx.needs.len()
                            invariant 0 <= j && j <= cx.needs.len(),
                        {
                            if types::e_contains(missing, cx.needs[j].e) {
                                if !first {
                                    why.push_str(" and ");
                                }
                                first = false;
                                why.push_str("`");
                                why.push_str(types::e_text(cx.needs[j].e).as_str());
                                why.push_str("` (");
                                why.push_str(cx.needs[j].what.as_str());
                                why.push_str(")");
                            }
                        }
                        let want: String = types::e_text(types::e_union(cx.effect, need));
                        let msg: String = types::cat7("`", d.name.name.as_str(), "` needs ", why.as_str(), " but declares `#[effects(", types::e_text(cx.effect).as_str(), ")]`");
                        let fix: String = types::cat3("declare `#[effects(", want.as_str(), ")]`");
                        let to: String = types::cat3("#[effects(", want.as_str(), ")]");
                        self.c.fixed("E0606", d.attrs[k].span, msg.as_str(), fix.as_str(), to.as_str());
                    }
                }
            }
        }

        #[summary("함수 하나: #[uses], 매개변수와 결과의 타입, 계약, 측도, 몸, 그리고 실행 함수면 효과")]
        #[effects(alloc)]
        fn check_fn(self: &mut Body, d: &ast::FnDef, mp: &str, path: &str) -> () {
            let at: usize = match self.c.fns.find(path) {
                None => { return; },
                Some(i) => i,
            };
            let sig: types::FnSig = self.c.fns.items[at].clone();
            self.c.tparams = sig.generics.clone();
            let mut cx: FnCtx = new_ctx(path, mp, sig.effect, is_proof(d.kind));
            if !self.calls.has(path) {
                let none: Vec<String> = Vec::new();
                self.calls.insert(path, none);
            }
            for i in 0..d.attrs.len()
                invariant 0 <= i && i <= d.attrs.len(),
            {
                if d.attrs[i].name.name == "uses" {
                    self.check_uses(&d.attrs[i], mp);
                }
            }
            for i in 0..d.params.len()
                invariant 0 <= i && i <= d.params.len(),
            {
                let ty: ast::TypeKind = self.c.canon(&d.params[i].ty, mp, true, 1000000000);
                self.check_param_type(&d.params[i].ty, d.kind, !ty_has_error(&ty, 1000000000));
                self.declare(&mut cx, &d.params[i].name, ty, false, true);
            }
            self.check_value_type(&d.ret.ty, "return type");
            if is_spec(d.kind) && named_one(&d.ret.ty.kind, "Vec") {
                self.spec_vec(d.ret.ty.span);
            }
            if is_spec(d.kind) && named_one(&d.ret.ty.kind, "String") {
                self.spec_string(d.ret.ty.span);
            }
            let ret_ty: ast::TypeKind = self.c.canon(&d.ret.ty, mp, true, 1000000000);
            cx.ret = ret_ty.clone();
            if is_spec(d.kind) {
                if d.pre.len() > 0 {
                    self.c.err("E0207", d.pre[0].span, "spec functions take no `requires` / `ensures` in milestone 1");
                } else if d.post.len() > 0 {
                    self.c.err("E0207", d.post[0].span, "spec functions take no `requires` / `ensures` in milestone 1");
                }
            }
            for i in 0..d.pre.len()
                invariant 0 <= i && i <= d.pre.len(),
            {
                self.check_contract(&mut cx, &d.pre[i], false);
            }
            if d.post.len() > 0 {
                let scope: Vec<Local> = Vec::new();
                cx.scopes.push(scope);
                match &d.ret.name {
                    None => {},
                    Some(n) => self.declare(&mut cx, n, ret_ty.clone(), false, false),
                }
                for i in 0..d.post.len()
                    invariant 0 <= i && i <= d.post.len(),
                {
                    self.check_contract(&mut cx, &d.post[i], true);
                }
                cx.scopes.pop();
            }
            match &d.ret.name {
                None => {},
                Some(n) => { types::add(&mut cx.reserved, n.name.as_str()); },
            }
            match &d.measure {
                None => {},
                Some(m) => { let no: Option<ast::TypeKind> = None; let t: ast::TypeKind = self.expr(&mut cx, m, &no, Mode::Spec(false), 1000000000); self.measure_type(&t, m.span); },
            }
            if is_some(&sig.trait_of) && !sig.default {
                self.c.tparams = Vec::new();
                return;
            }
            let mode: Mode = match d.kind {
                ast::FnKind::Exec => Mode::Exec,
                ast::FnKind::Spec => Mode::Spec(false),
                ast::FnKind::Proof => Mode::Ghost,
            };
            let want: Option<ast::TypeKind> = Some(ret_ty.clone());
            self.open_lets = Vec::new();
            self.typed_uses = Vec::new();
            self.spec_at = Vec::new();
            let t: ast::TypeKind = self.block(&mut cx, &d.body, &want, mode, 1000000000);
            self.spec_widen = !is_exec(d.kind);
            let end: source::Span = match &d.body.tail {
                None => d.body.span,
                Some(e) => e.span,
            };
            self.expect_ty(&t, &ret_ty, end);
            self.spec_widen = false;
            self.settle_lets(d, mp);
            if is_exec(d.kind) {
                if has_attr(d.attrs.as_slice(), "external_body") {
                    need_own(&mut cx, panic_effect(), "`#[external_body]`");
                    types::add(&mut self.external, path);
                }
                self.check_effects(d, &cx);
                self.needs.insert(path, Needs { own: cx.own, body: needed(&cx) });
            }
            self.c.tparams = Vec::new();
        }

        #[summary("프로그램의 main: 하나뿐이고 (E0702, 글의 순서로 뒤의 것이 남는 것) `#[effects(io)] fn main() -> ()` 꼴이다 (E0701)")]
        #[effects(alloc)]
        fn check_main(self: &mut Body, p: &ast::Program) -> () {
            let mut found: Vec<ast::FnDef> = Vec::new();
            for i in 0..p.mods.len()
                invariant 0 <= i && i <= p.mods.len(),
            {
                mains_of(&p.mods[i], &mut found, 100000);
            }
            let mains: Vec<ast::FnDef> = by_place(found.as_slice());
            for i in 0..mains.len()
                invariant 0 <= i && i <= mains.len(),
            {
                if i > 0 {
                    self.c.err("E0702", mains[i].name.span, "the program already has a `main`");
                }
                if mains[i].params.len() != 0 || !decls::is_unit(&mains[i].ret.ty.kind) || !declares_io(mains[i].attrs.as_slice()) {
                    self.c.help("E0701", mains[i].name.span, "`main` must be `#[effects(io)] fn main() -> ()`", "write `#[effects(io)] fn main() -> ()`: no parameters, no result (other effects may be listed with `io`)");
                }
            }
        }

        #[summary("단위 하나: 속성과 요약, 안의 단위, 상수, 함수, impl과 trait의 함수")]
        #[effects(alloc)]
        fn check_mod(self: &mut Body, m: &ast::Mod, prefix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mp: String = types::cat2(prefix, m.name.name.as_str());
            let mut has_summary: bool = false;
            for i in 0..m.attrs.len()
                invariant 0 <= i && i <= m.attrs.len(),
            {
                if m.attrs[i].name.name == "summary" && m.attrs[i].args.len() == 1 && str_arg(&m.attrs[i].args[0]) {
                    if has_summary {
                        self.c.fixed("E0605", m.attrs[i].span, "duplicate `#[summary(..)]` attribute", "keep one: join the text", "");
                    }
                    has_summary = true;
                } else if m.attrs[i].name.name == "summary" {
                    self.c.err("E0704", m.attrs[i].span, "`#[summary(..)]` takes exactly one string");
                    has_summary = true;
                } else {
                    self.c.fixed("E0605", m.attrs[i].span, types::cat3("unknown attribute `", m.attrs[i].name.name.as_str(), "` on a unit").as_str(), "remove it: units take `#[summary(\"..\")]`", "");
                }
            }
            if !has_summary {
                self.c.help("E0704", m.name.span, types::cat3("unit `", m.name.name.as_str(), "` has no summary").as_str(), "add `#[summary(\"one line\")]` above `mod`");
            }
            let sub: String = types::cat2(mp.as_str(), "::");
            for i in 0..m.mods.len()
                invariant 0 <= i && i <= m.mods.len(),
            {
                self.check_mod(&m.mods[i], sub.as_str(), f - 1);
            }
            for i in 0..m.consts.len()
                invariant 0 <= i && i <= m.consts.len(),
            {
                for j in 0..m.consts[i].attrs.len()
                    invariant 0 <= j && j <= m.consts[i].attrs.len(),
                {
                    if m.consts[i].attrs[j].name.name == "summary" {
                        self.c.check_summary(&m.consts[i].attrs[j], m.consts[i].attrs.as_slice());
                    } else {
                        self.c.fixed("E0605", m.consts[i].attrs[j].span, types::cat3("unknown attribute `", m.consts[i].attrs[j].name.name.as_str(), "` on a constant").as_str(), "constants take `#[summary(\"..\")]`", "");
                    }
                }
                self.check_const(&m.consts[i], mp.as_str());
            }
            for i in 0..m.fns.len()
                invariant 0 <= i && i <= m.fns.len(),
            {
                let path: String = types::cat3(mp.as_str(), "::", m.fns[i].name.name.as_str());
                self.check_fn(&m.fns[i], mp.as_str(), path.as_str());
            }
            for i in 0..m.impls.len()
                invariant 0 <= i && i <= m.impls.len(),
            {
                for j in 0..m.impls[i].fns.len()
                    invariant 0 <= j && j <= m.impls[i].fns.len(),
                {
                    let path: String = types::cat5(mp.as_str(), "::", m.impls[i].ty.name.as_str(), "::", m.impls[i].fns[j].name.name.as_str());
                    self.check_fn(&m.impls[i].fns[j], mp.as_str(), path.as_str());
                }
            }
            for i in 0..m.traits.len()
                invariant 0 <= i && i <= m.traits.len(),
            {
                for j in 0..m.traits[i].fns.len()
                    invariant 0 <= j && j <= m.traits[i].fns.len(),
                {
                    let path: String = types::cat5(mp.as_str(), "::", m.traits[i].name.name.as_str(), "::", m.traits[i].fns[j].f.name.name.as_str());
                    if self.declared_at(path.as_str(), m.traits[i].fns[j].f.span) {
                        self.check_fn(&m.traits[i].fns[j].f, mp.as_str(), path.as_str());
                    }
                }
            }
            for i in 0..m.trait_impls.len()
                invariant 0 <= i && i <= m.trait_impls.len(),
            {
                match self.c.impl_info(m.trait_impls[i].span) {
                    None => {},
                    Some(found) => { self.c.self_head = Some(decls::SelfHead { head: found.info.head.clone(), text: types::text_in(&found.info.head, mp.as_str()) }); for j in 0..m.trait_impls[i].fns.len() invariant 0 <= j && j <= m.trait_impls[i].fns.len(), { let path: String = types::fn_path(&found.info, m.trait_impls[i].fns[j].name.name.as_str()); if self.declared_at(path.as_str(), m.trait_impls[i].fns[j].span) { self.check_fn(&m.trait_impls[i].fns[j], mp.as_str(), path.as_str()); } } self.c.self_head = None; },
                }
            }
        }

        #[summary("매개변수의 타입이 가질 수 있는 꼴. resolved가 거짓이면 타입 안의 결함을 이미 알렸으므로 둘러싼 참조의 꼴을 다시 알리지 않는다 (백로그 2V-22)")]
        #[effects(alloc)]
        fn check_param_type(self: &mut Body, t: &ast::Type, kind: ast::FnKind, resolved: bool) -> () {
            match ref_inner(&t.kind) {
                None => { if !is_exec(kind) && named_one(&t.kind, "Vec") { self.spec_vec(t.span); } else if !is_exec(kind) && named_one(&t.kind, "String") { self.spec_string(t.span); } else { self.check_value_type(t, "parameter type"); } },
                Some(inner) => self.check_ref_param(t.span, types::is_ref_mut(&t.kind), &inner, kind, resolved),
            }
        }

        #[summary("프로그램 전체: 선언을 모으고(1패스), 단위마다 몸을 검사하고(2패스), 재귀와 main을 본다")]
        #[effects(alloc)]
        fn check_program(self: &mut Body, p: &ast::Program) -> () {
            self.c.collect(p);
            for i in 0..p.mods.len()
                invariant 0 <= i && i <= p.mods.len(),
            {
                self.check_mod(&p.mods[i], "", 1000000000);
            }
            self.check_recursion(p);
            self.check_main(p);
        }

        #[summary("재귀: 호출 그래프의 순환마다 번호를 적고(recursive), 순환 위의 정의에 decreases가 없으면 E0507 (경계 있는 Self의 호출을 지나는 순환은 trait_cycles가 E0207로 알린다). 타입 매개변수를 더 큰 타입에 싸서 넘기는 재귀 호출은 E0430 (인스턴스가 끝나지 않는다)")]
        #[effects(alloc)]
        fn check_recursion(self: &mut Body, p: &ast::Program) -> () {
            let rows: Vec<DefRow> = defs_of(p, &self.c.fns);
            let mut defs: table::Table<DefRow> = table::new::<DefRow>();
            for i in 0..rows.len()
                invariant 0 <= i && i <= rows.len(),
            {
                if !defs.has(rows[i].path.as_str()) {
                    defs.insert(rows[i].path.as_str(), rows[i].clone());
                }
            }
            let comps: Vec<Vec<String>> = sccs_with_cycles(&self.calls);
            for i in 0..comps.len()
                invariant 0 <= i && i <= comps.len(),
            {
                for j in 0..comps[i].len()
                    invariant 0 <= j && j <= comps[i].len(),
                {
                    self.recursive.insert(comps[i][j].as_str(), i);
                }
            }
            let through_trait: Vec<String> = self.trait_cycles(&defs);
            for i in 0..comps.len()
                invariant 0 <= i && i <= comps.len(),
            {
                for j in 0..comps[i].len()
                    invariant 0 <= j && j <= comps[i].len(),
                {
                    match defs.find(comps[i][j].as_str()) {
                        None => {},
                        Some(at) => { if !defs.items[at].has_dec && !types::has(through_trait.as_slice(), comps[i][j].as_str()) { self.c.help("E0507", defs.items[at].span, types::cat3("`", comps[i][j].as_str(), "` is recursive and has no `decreases` clause").as_str(), "add `decreases <expr>,` after `ensures`"); } },
                    }
                }
            }
            let calls: Vec<GCall> = self.gcalls.clone();
            self.gcalls = Vec::new();
            for i in 0..calls.len()
                invariant 0 <= i && i <= calls.len(),
            {
                let same: bool = match self.recursive.find(calls[i].caller.as_str()) {
                    None => false,
                    Some(a) => { match self.recursive.find(calls[i].callee.as_str()) { None => false, Some(b) => self.recursive.items[a] == self.recursive.items[b], } },
                };
                if same {
                    match wrapped_param(calls[i].args.as_slice()) {
                        None => {},
                        Some(t) => { self.c.help("E0430", calls[i].span, types::cat5("the recursive call of `", calls[i].callee.as_str(), "` wraps a type parameter in `", types::text(&t).as_str(), "`: its instances would never end").as_str(), "pass a type parameter itself or a type without parameters"); },
                    }
                }
            }
        }

        #[summary("참조 매개변수 `&inner`의 꼴")]
        #[effects(alloc)]
        fn check_ref_param(self: &mut Body, span: source::Span, mutable: bool, inner: &ast::TypeKind, kind: ast::FnKind, resolved: bool) -> () {
            let slice_ok: bool = match slice_elem(inner) {
                None => false,
                Some(e) => types::array_elem_ok(&e, 100000) || named_one(&e, "Vec") || named_one(&e, "String"),
            };
            if slice_ok {
                if mutable && !is_exec(kind) {
                    self.ghost_mut_param(span, kind);
                }
                return;
            }
            if named_one(inner, "Vec") {
                if !is_exec(kind) {
                    self.spec_vec(span);
                }
                return;
            }
            if named_one(inner, "String") {
                if !is_exec(kind) {
                    self.spec_string(span);
                }
                return;
            }
            if is_named(inner) || types::is_scalar(inner) {
                if mutable && !is_exec(kind) {
                    self.ghost_mut_param(span, kind);
                }
                return;
            }
            if is_str(inner) {
                if mutable {
                    self.c.help("E0402", span, "a `&mut str` parameter is not supported", "take `&mut String` to change the text");
                }
                return;
            }
            if types::is_error(inner) || !resolved {
                return;
            }
            self.c.help("E0402", span, "references are `&[T]`, `&mut [T]`, `&T` or `&mut T` with `T` a scalar, struct or enum", "pass the value itself, or a reference to the scalar, struct, enum or slice that holds it");
        }

        #[summary("필드나 페이로드의 값들을 선언된 타입에 견준다. 타입이 제네릭 데이터 타입의 매개변수 ps를 말하면, tm이 아직 묶지 않은 매개변수는 값에서 묶는다 (정수 리터럴은 마지막에: 다른 값이 그 타입을 정한다)")]
        #[effects(alloc)]
        fn check_slots(self: &mut Body, cx: &mut FnCtx, ps: &[types::TParam], tm: &mut types::Subst, args: &[ast::Expr], fields: &[ast::FieldInit], by_field: bool, slots: &[Slot], mode: Mode, f: usize) -> ()
            decreases f * 3 + 1,
        {
            let no: Option<ast::TypeKind> = None;
            let mut deferred: Vec<usize> = Vec::new();
            for i in 0..slots.len()
                invariant 0 <= i && i <= slots.len(),
            {
                if has_param_of(&slots[i].ty, ps, tm) {
                    if slot_literal(args, fields, by_field, slots[i].at) {
                        deferred.push(i);
                    } else {
                        let xt: ast::TypeKind = self.slot_expr(cx, args, fields, by_field, slots[i].at, &no, mode, f);
                        types::unify(&slots[i].ty, &xt, ps, tm, 100000);
                        let want: ast::TypeKind = types::subst(&slots[i].ty, tm);
                        if !has_param_of(&slots[i].ty, ps, tm) {
                            self.expect_ty(&xt, &want, slot_span(args, fields, by_field, slots[i].at));
                        }
                    }
                } else {
                    let want2: ast::TypeKind = types::subst(&slots[i].ty, tm);
                    let hint: Option<ast::TypeKind> = Some(want2.clone());
                    let xt2: ast::TypeKind = self.slot_expr(cx, args, fields, by_field, slots[i].at, &hint, mode, f);
                    self.expect_ty(&xt2, &want2, slot_span(args, fields, by_field, slots[i].at));
                }
            }
            for j in 0..deferred.len()
                invariant 0 <= j && j <= deferred.len(),
            {
                let s: usize = deferred[j];
                if s < slots.len() {
                    if has_param_of(&slots[s].ty, ps, tm) {
                        self.slot_expr(cx, args, fields, by_field, slots[s].at, &no, mode, f);
                    } else {
                        let want3: ast::TypeKind = types::subst(&slots[s].ty, tm);
                        let hint3: Option<ast::TypeKind> = Some(want3.clone());
                        let xt3: ast::TypeKind = self.slot_expr(cx, args, fields, by_field, slots[s].at, &hint3, mode, f);
                        self.expect_ty(&xt3, &want3, slot_span(args, fields, by_field, slots[s].at));
                    }
                }
            }
        }

        #[summary("#[uses(..)]의 인자는 spec fn의 이름이다 (E0509)")]
        #[effects(alloc)]
        fn check_uses(self: &mut Body, a: &ast::Attr, mp: &str) -> () {
            for j in 0..a.args.len()
                invariant 0 <= j && j <= a.args.len(),
            {
                match &a.args[j] {
                    ast::AttrArg::Ident(i) => { let mut known: bool = false; let mut is_sp: bool = false; match decls::uses_target(i.name.as_str(), mp, &self.c.fns) { None => {}, Some(p) => { match self.c.fns.find(p.as_str()) { None => {}, Some(at) => { known = true; is_sp = is_spec(self.c.fns.items[at].kind); }, } }, } if !is_sp { let msg: String = types::cat3("`", i.name.as_str(), "` is not a spec function"); if known { self.c.help("E0509", i.span, msg.as_str(), "remove it from `#[uses(..)]`: only spec function bodies are revealed; executable functions are seen through their contracts"); } else { self.c.help("E0509", i.span, msg.as_str(), "remove it from `#[uses(..)]`, or define the spec function (another unit's as `unit::name`)"); } } },
                    ast::AttrArg::Str(q4_s, sp) => self.c.err("E0509", *sp, "`#[uses(..)]` takes spec function names"),
                    ast::AttrArg::Pair(k, q4_v) => self.c.err("E0509", k.span, "`#[uses(..)]` takes spec function names"),
                }
            }
        }

        #[summary("지역 변수와 결과의 타입: 참조도 맨 조각도 아니다")]
        #[effects(alloc)]
        fn check_value_type(self: &mut Body, t: &ast::Type, what: &str) -> () {
            if is_ref(&t.kind) {
                self.c.help("E0403", t.span, types::cat2("a reference cannot be a ", what).as_str(), "references are second-class: pass them as arguments only (ADR-0015)");
            } else if is_slice(&t.kind) {
                self.c.err("E0402", t.span, "a bare slice is unsized; use `&[T]` as a parameter or `[T; N]`");
            } else if is_str(&t.kind) {
                self.c.err("E0402", t.span, "a bare `str` is unsized; use `&str` as a parameter or `String`");
            }
        }

        #[summary("E0436: std::process::Child는 필드로 짓거나 읽지 않는다")]
        #[effects(alloc)]
        fn child_by_hand(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0436", span, "a `std::process::Child` is not built or read by its fields", "get one from `std::process::spawn(prog, args.as_slice(), std::process::Stdio::Inherit)` and use its methods: `write_all`, `read_line`, `id`, `wait`");
        }

        #[summary("메모리를 가진 값의 내장 clone (ADR-0141): 받는 값과 같고 제 메모리를 가진 새 값")]
        #[effects(alloc)]
        fn clone_method(self: &mut Body, cx: &mut FnCtx, rt: &ast::TypeKind, name: &ast::Ident, args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            for i in 0..args.len()
                invariant 0 <= i && i <= args.len(),
            {
                self.expr(cx, &args[i], &no, mode, f - 1);
            }
            let value: ast::TypeKind = match ref_inner(rt) {
                None => rt.clone(),
                Some(inner) => inner,
            };
            let moving: Vec<String> = self.c.moving_params();
            let why: String = clone_blocked(&value, &self.c.adts, moving.as_slice());
            if why.len() > 0 {
                self.no_clone(name.span, &value, why.as_str());
                return ast::TypeKind::Error;
            }
            if args.len() != 0 {
                self.c.help("E0405", name.span, decls::count1("`clone` takes 0 argument(s), found ", args.len()).as_str(), "write `x.clone()`");
            }
            if exec_mode(mode) {
                need_own(cx, alloc_effect(), types::cat3("`", types::text(&value).as_str(), "::clone`").as_str());
            } else {
                self.c.help("E0503", span, "`.clone()` is not allowed in a specification", "a specification reads the value itself: remove `.clone()`");
            }
            value
        }

        #[summary("타입 t의 값이 바로 담는 타입들")]
        #[effects(alloc)]
        fn components(self: &Body, t: &ast::TypeKind) -> Vec<ast::TypeKind> {
            let mut out: Vec<ast::TypeKind> = Vec::new();
            match held(t) {
                None => {},
                Some(e) => { out.push(e); return out; },
            }
            let path: String = match types::named_path(t) {
                None => { return out; },
                Some(p) => p,
            };
            if path == "Option" || path == "Result" {
                return types::named_args(t);
            }
            match self.c.adts.find(path.as_str()) {
                None => {},
                Some(at) => { let m: types::Subst = types::adt_subst(&self.c.adts.items[at], t); let parts: Vec<ast::TypeKind> = adt_parts(&self.c.adts.items[at].kind); for i in 0..parts.len() invariant 0 <= i && i <= parts.len(), { out.push(types::subst(&parts[i], &m)); } },
            }
            out
        }

        #[summary("const의 참조 (ADR-0052): 그 타입. 값은 해소된 프로그램을 위해 적어 둔다. 평가되지 않은 const는 이미 오류라 그 참조도 그렇다")]
        #[effects(alloc)]
        fn const_ref(self: &mut Body, from: &str, path: &[String], unit: &str, span: source::Span) -> Option<ast::TypeKind> {
            let full: String = match lookup_const(&self.consts, path, unit) {
                None => { return None; },
                Some(p) => p,
            };
            match self.const_reads.find(from) {
                None => { let mut one: Vec<String> = Vec::new(); one.push(full.clone()); self.const_reads.insert(from, one); },
                Some(i) => { types::add(&mut self.const_reads.items[i], full.as_str()); },
            }
            let at: usize = match self.consts.find(full.as_str()) {
                None => { return Some(ast::TypeKind::Error); },
                Some(j) => j,
            };
            let c: consts::Const = self.consts.items[at].clone();
            let v: consts::CVal = match &c.value {
                None => { return Some(ast::TypeKind::Error); },
                Some(x) => x.clone(),
            };
            let t: ast::TypeKind = self.const_type(&c);
            if types::is_error(&t) {
                return Some(t);
            }
            self.const_uses.insert(span_key(span).as_str(), ConstUse { v: v, ty: t.clone() });
            Some(t)
        }

        #[summary("const의 선언한 타입을 그 단위에서, 함수의 타입 매개변수 밖에서 푼 것. 값만 담지 않으면 Error")]
        #[effects(alloc)]
        fn const_type(self: &mut Body, c: &consts::Const) -> ast::TypeKind {
            if consts::scalar(&c.ty) {
                return c.ty.clone();
            }
            let saved: Vec<types::TParam> = self.c.tparams.clone();
            self.c.tparams = Vec::new();
            let written: ast::Type = types::ty(c.ty.clone());
            let t: ast::TypeKind = self.c.canon(&written, c.unit.as_str(), false, 1000000000);
            self.c.tparams = saved;
            let mut seen: Vec<String> = Vec::new();
            if self.holds_values(&t, &mut seen, 1000000000) {
                t
            } else {
                ast::TypeKind::Error
            }
        }

        #[summary("T::try_from(x).unwrap() / .ok() (ADR-0028 §1): 정수 타입 T로 본 x의 값(범위는 증명기의 의무, E0815), 또는 Option<T>")]
        #[effects(alloc)]
        fn conversion(self: &mut Body, cx: &mut FnCtx, recv: &ast::Expr, name: &ast::Ident, margs: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let c: ast::Call = match call_of(recv) {
                None => { return ast::TypeKind::Error; },
                Some(found) => found,
            };
            if c.path.len() != 2 {
                return ast::TypeKind::Error;
            }
            let target: ast::TypeKind = match ast::int_of(c.path[0].name.as_str()) {
                None => { return ast::TypeKind::Error; },
                Some(it) => ast::TypeKind::Int(it),
            };
            if c.args.len() != 1 {
                self.c.err("E0405", recv.span, "`try_from` takes one value");
                return ast::TypeKind::Error;
            }
            let st: ast::TypeKind = self.expr(cx, &c.args[0], &no, mode, f - 1);
            for i in 0..margs.len()
                invariant 0 <= i && i <= margs.len(),
            {
                self.expr(cx, &margs[i], &no, mode, f - 1);
            }
            let x: String = fmt::expr_text(&c.args[0]);
            let tt: String = types::text(&target);
            let unwrapped: String = types::cat4(tt.as_str(), "::try_from(", x.as_str(), ").unwrap()");
            if !exec_mode(mode) && name.name == "unwrap" && widens(&st, &target) {
                let v: String = if fmt::prec(&c.args[0]) < 11 {
                    types::cat3("(", x.as_str(), ")")
                } else {
                    x.clone()
                };
                self.aliases.push(diag::fix(diag::new("W0917", span, types::cat7("`", x.as_str(), " as ", tt.as_str(), "` in a specification: every value fits, so it is `", x.as_str(), "` (ADR-0099)").as_str()), "remove the conversion", Some(v)));
                return target;
            }
            if !exec_mode(mode) {
                self.c.fixed("E0513", span, "conversions are not used in specifications", "integer types mix in specifications (ADR-0022): write the value", x.as_str());
                return st;
            }
            if !types::is_int(&st) {
                if !types::is_error(&st) {
                    let msg: String = types::cat3("`try_from` converts between integer types, found `", types::text(&st).as_str(), "`");
                    if is_bool(&st) && name.name == "unwrap" {
                        self.c.fixed("E0412", span, msg.as_str(), "choose the values", types::cat3("if ", x.as_str(), " { 1 } else { 0 }").as_str());
                    } else if is_f64(&st) {
                        self.c.help("E0412", c.args[0].span, msg.as_str(), "`f64` does not convert to an integer type yet (ADR-0061 §4, open question 1)");
                    } else {
                        self.c.err("E0412", c.args[0].span, msg.as_str());
                    }
                }
                return ast::TypeKind::Error;
            }
            if name.name == "unwrap" && margs.len() == 0 {
                return target;
            }
            if name.name == "ok" && margs.len() == 0 {
                return option_of(target);
            }
            if name.name == "expect" {
                self.c.fixed("E0213", span, "write `.unwrap()`", "a conversion has one form (its range is proved)", unwrapped.as_str());
                return target;
            }
            self.c.fixed("E0412", span, "`T::try_from(x)` is used as `.unwrap()` or `.ok()`", "`.unwrap()`: the value, with a range obligation", unwrapped.as_str());
            ast::TypeKind::Error
        }

        #[summary("a.copy_within(lo..hi, dest) (ADR-0083): 배열, &mut [T], Vec<T>에서 T가 Copy일 때 a[lo..hi]를 a[dest..]로 제자리에서 옮긴다. 경계는 증명 의무다 (E0805)")]
        #[effects(alloc)]
        fn copy_within(self: &mut Body, cx: &mut FnCtx, recv: &ast::Expr, rt: &ast::TypeKind, et: &ast::TypeKind, name: &ast::Ident, args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Int(ast::IntTy::Usize));
            let range: Option<ast::Range> = if args.len() == 2 {
                range_of(&args[0])
            } else {
                None
            };
            match range {
                None => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if !is_range(&args[i].kind) { self.expr(cx, &args[i], &no, mode, f - 1); } } self.c.help("E0405", name.span, "`copy_within` takes a range and a destination: `a.copy_within(lo..hi, dest)`", "give the source as `lo..hi` and the destination index"); return ast::TypeKind::Error; },
                Some(r) => { let lt: ast::TypeKind = self.expr(cx, &*r.lo, &wu, mode, f - 1); self.expect_ty(&lt, &ast::TypeKind::Int(ast::IntTy::Usize), r.lo.span); let ht: ast::TypeKind = self.expr(cx, &*r.hi, &wu, mode, f - 1); self.expect_ty(&ht, &ast::TypeKind::Int(ast::IntTy::Usize), r.hi.span); if args.len() == 2 { let dt: ast::TypeKind = self.expr(cx, &args[1], &wu, mode, f - 1); self.expect_ty(&dt, &ast::TypeKind::Int(ast::IntTy::Usize), args[1].span); } },
            }
            if !exec_mode(mode) {
                if cx.ghost {
                    self.ghost_violation(span, "`.copy_within()`", "change the value outside the `proof` block");
                } else {
                    self.c.help("E0503", span, "`.copy_within()` is not allowed in a specification", "state the result with a predicate over the old and new values");
                }
                return ast::TypeKind::Unit;
            }
            if !self.c.is_copy(et) && !types::is_error(et) {
                self.c.help("E0404", name.span, types::cat3("`copy_within` copies elements, and `", types::text(et).as_str(), "` moves").as_str(), "move the elements one by one, or keep elements of a `Copy` type");
            }
            let shared: bool = is_ref(rt) && !types::is_ref_mut(rt);
            if (shared || !writable(cx, recv, 1000000000)) && !types::is_error(rt) {
                if is_ref(rt) {
                    self.c.help("E0408", recv.span, "`.copy_within()` needs a mutable receiver", "take the parameter as `&mut`");
                } else {
                    self.c.help("E0408", recv.span, "`.copy_within()` needs a mutable receiver", "declare it with `let mut`");
                }
            }
            ast::TypeKind::Unit
        }

        #[summary("구조체나 열거형 T의 &T / &mut T 매개변수의 인자 (ADR-0026 §2): T 값의 &e, 쓸 수 있는 자리의 &mut p, 넘겨받은 참조 매개변수. &mut 인자가 출발하는 변수를 돌려준다 (겹침 검사 E0410에 쓴다)")]
        #[effects(alloc)]
        fn data_ref_arg(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, pm: bool, want_ty: &ast::TypeKind, want: &str, mode: Mode, f: usize) -> Option<String>
            decreases f * 3,
        {
            if f == 0 {
                return None;
            }
            let no: Option<ast::TypeKind> = None;
            let hint: Option<ast::TypeKind> = Some(want_ty.clone());
            let m: String = if pm {
                String::from("mut ")
            } else {
                String::new()
            };
            match ref_of(a) {
                None => {},
                Some(x) => { if ref_mutable(a) != pm { let r: String = types::cat3("&", m.as_str(), fmt::expr_text(&x).as_str()); self.c.fixed("E0401", a.span, types::cat3("expected `", want, "`").as_str(), types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str()); } if !pm { let vt: ast::TypeKind = self.expr(cx, &x, &hint, mode, f - 1); self.expect_ty(&vt, want_ty, x.span); return None; } let p: Place = self.place_of(cx, &x, f - 1); self.expect_ty(&p.ty, want_ty, x.span); if !p.writable && !types::is_error(&p.ty) { self.c.help("E0408", x.span, types::cat3("`", fmt::expr_text(&x).as_str(), "` is not mutable").as_str(), "declare the variable with `let mut`"); return None; } return root_name(&x, 1000000000); },
            }
            let t: ast::TypeKind = self.expr(cx, a, &no, mode, f - 1);
            let msg: String = types::cat5("expected `", want, "`, found `", types::text(&t).as_str(), "`");
            match ast::var_name(a) {
                None => {},
                Some(id) => { let ok: bool = match ref_inner(&t) { None => types::is_error(&t), Some(inner) => types::same(&inner, want_ty) && (types::is_ref_mut(&t) || !pm), }; if !ok { if types::same(&t, want_ty) { let r: String = types::cat3("&", m.as_str(), id.as_str()); self.c.fixed("E0401", a.span, msg.as_str(), types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str()); } else { self.c.err("E0401", a.span, msg.as_str()); } return None; } if pm { return Some(id); } return None; },
            }
            if is_old(&a.kind) && !pm {
                let ok: bool = match ref_inner(&t) {
                    None => types::is_error(&t),
                    Some(inner) => types::same(&inner, want_ty),
                };
                if !ok {
                    self.c.err("E0401", a.span, msg.as_str());
                }
                return None;
            }
            if !types::is_error(&t) {
                if types::same(&t, want_ty) && !pm {
                    let r: String = types::cat2("&", fmt::expr_text(a).as_str());
                    self.c.fixed("E0401", a.span, msg.as_str(), types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str());
                } else {
                    self.c.err("E0401", a.span, msg.as_str());
                }
            }
            None
        }

        #[summary("이름을 지금 범위에 넣는다. 보이는 이름을 가리면 E0303, 이 함수의 다른 자리에서 다른 타입으로 묶였어도 E0303 (ADR-0095 A3: 이름 하나에 타입 하나)")]
        #[effects(alloc)]
        fn declare(self: &mut Body, cx: &mut FnCtx, name: &ast::Ident, ty: ast::TypeKind, mutable: bool, is_param: bool) -> () {
            let one: Vec<String> = single(name.name.as_str());
            let hides: bool = is_some_local(&lookup(cx, name.name.as_str())) || types::has(cx.reserved.as_slice(), name.name.as_str()) || is_some(&lookup_const(&self.consts, one.as_slice(), cx.mod_path.as_str()));
            let mut other: Option<ast::TypeKind> = None;
            if types::has(cx.all_names.as_slice(), name.name.as_str()) {
                match self.locals.find(cx.path.as_str()) {
                    None => {},
                    Some(u) => { match self.locals.items[u].find(name.name.as_str()) { None => {}, Some(k) => { if !types::same(&self.locals.items[u].items[k], &ty) { other = Some(self.locals.items[u].items[k].clone()); } }, } },
                }
            }
            if hides {
                self.c.help("E0303", name.span, types::cat3("`", name.name.as_str(), "` hides a visible name of this function").as_str(), "choose a new name");
            } else {
                match other {
                    None => {},
                    Some(t) => self.c.help("E0303", name.span, types::cat5("`", name.name.as_str(), "` is bound elsewhere in this function with type `", types::text(&t).as_str(), "`").as_str(), "choose a new name: a name has one type in a function"),
                }
            }
            types::add(&mut cx.all_names, name.name.as_str());
            if !self.locals.has(cx.path.as_str()) {
                self.locals.insert(cx.path.as_str(), table::new::<ast::TypeKind>());
            }
            match self.locals.find(cx.path.as_str()) {
                None => {},
                Some(u) => self.locals.items[u].insert(name.name.as_str(), ty.clone()),
            }
            let n: usize = cx.scopes.len();
            if n > 0 {
                cx.scopes[n - 1].push(Local { name: name.name.clone(), ty: ty.clone(), mutable: mutable, is_param: is_param });
            }
        }

        #[summary("path의 함수가 span에 선언된 그것인가 (같은 이름의 다른 선언은 1패스가 알렸다)")]
        #[effects(alloc)]
        fn declared_at(self: &Body, path: &str, span: source::Span) -> bool {
            match self.c.fns.find(path) {
                None => false,
                Some(i) => same_span(self.c.fns.items[i].span, span),
            }
        }

        #[summary("*x: x는 참조 &T, &mut T(조각의 참조는 아니다)나 Box<T>")]
        #[effects(alloc)]
        fn deref_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, x: &ast::Expr, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let t: ast::TypeKind = self.expr(cx, x, &no, mode, f - 1);
            match ref_inner(&t) {
                None => {},
                Some(inner) => { if !is_slice(&inner) { return inner; } },
            }
            match box_inner(&t) {
                None => {},
                Some(b) => { return b; },
            }
            if types::is_error(&t) {
                return ast::TypeKind::Error;
            }
            self.c.err("E0401", e.span, types::cat3("`*` needs a reference `&T` or `&mut T` or a `Box<T>`, found `", types::text(&t).as_str(), "`").as_str());
            ast::TypeKind::Error
        }

        #[summary("E0231: (*p).x는 p.x로 쓴다 (필드는 참조를 지나 읽힌다)")]
        #[effects(alloc)]
        fn deref_field(self: &mut Body, e: &ast::Expr, base: &ast::Expr, name: &ast::Ident) -> () {
            match deref_inner(base) {
                None => {},
                Some(x) => { let r: String = types::cat3(fmt::expr_text(&x).as_str(), ".", name.name.as_str()); self.c.fixed("E0231", e.span, types::cat3("write `", r.as_str(), "`").as_str(), "fields are read through a reference directly", r.as_str()); },
            }
        }

        #[summary("E0401과 고칠 글 `*e`: 구조체나 열거형 T를 기대하는 자리에 &T나 &mut T인 e를 줬다 (백로그 2B-16). 알렸는가")]
        #[effects(alloc)]
        fn deref_fix(self: &mut Body, found: &ast::TypeKind, want: &ast::TypeKind, e: &ast::Expr) -> bool {
            match ref_inner(found) {
                None => false,
                Some(inner) => { if !types::same(&inner, want) || !is_named(want) { return false; } let r: String = types::cat2("*", fmt::expr_text(e).as_str()); let msg: String = types::cat5("expected `", types::text(want).as_str(), "`, found `", types::text(found).as_str(), "`"); self.c.fixed("E0401", e.span, msg.as_str(), types::cat3("pass the value: `", r.as_str(), "`").as_str(), r.as_str()); true },
            }
        }

        #[summary("*x의 자리: x가 &T(조각 아님)나 Box<T>면 T")]
        #[effects(alloc)]
        fn deref_place(self: &mut Body, span: source::Span, p: Place) -> Place {
            match ref_inner(&p.ty) {
                None => {},
                Some(inner) => { if !is_slice(&inner) { return Place { ty: inner, writable: p.writable }; } },
            }
            match box_inner(&p.ty) {
                None => {},
                Some(boxed) => { return Place { ty: boxed, writable: p.writable }; },
            }
            if !types::is_error(&p.ty) {
                self.c.err("E0401", span, types::cat3("`*` needs a reference `&T` or `&mut T` or a `Box<T>`, found `", types::text(&p.ty).as_str(), "`").as_str());
            }
            Place { ty: ast::TypeKind::Error, writable: false }
        }

        #[summary("블록에 끝나지 않는 문장(타입이 `!`인 식)이 있는가")]
        #[effects(alloc)]
        fn diverges(self: &Body, b: &ast::Block) -> bool {
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                match stmt_expr(&b.stmts[i]) {
                    None => {},
                    Some(sp) => { match self.types.find(span_key(sp).as_str()) { None => {}, Some(k) => { if is_never(&self.types.items[k]) { return true; } }, } },
                }
            }
            false
        }

        #[summary("before번째 앞의 진단 가운데 span 안에서 난 평가기의 것(E0259, E0260, E0401)을 뺀다")]
        #[effects(alloc)]
        fn drop_evaluator(self: &mut Body, span: source::Span, before: usize) -> () {
            let mut kept: Vec<diag::Diag> = Vec::new();
            for i in 0..self.c.diags.len()
                invariant 0 <= i && i <= self.c.diags.len(),
            {
                let at: source::Span = self.c.diags[i].span;
                let inside: bool = at.file == span.file && at.lo >= span.lo && at.hi <= span.hi;
                let evaluator: bool = self.c.diags[i].code == "E0259" || self.c.diags[i].code == "E0260" || self.c.diags[i].code == "E0401";
                if i >= before || !inside || !evaluator {
                    kept.push(self.c.diags[i].clone());
                }
            }
            self.c.diags = kept;
        }

        #[summary("E0218: 조각을 기대한 곳에 준 Vec (Rust의 Deref 강제)")]
        #[effects(alloc)]
        fn e0218(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, v: &ast::Expr, want_m: &str, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            self.expr(cx, v, &no, mode, f - 1);
            let r: String = types::cat4(fmt::expr_text(v).as_str(), ".", want_m, "()");
            self.c.fixed("E0218", a.span, "a `Vec` is not a slice", types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str());
        }

        #[summary("타입 인자 a로 부른 호출 e가 닿는 인스턴스: trait 메서드면 그 Self의 impl의 함수 (정해지지 않으면 없음), 아니면 그 함수 자신")]
        #[effects(alloc)]
        fn edge_target(self: &Body, e: &Edge, a: Vec<ast::TypeKind>) -> Option<Edge> {
            if self.trait_method(e.callee.as_str()) {
                match dispatch(&self.c.fns, self.c.trait_impls.as_slice(), e.callee.as_str(), a.as_slice()) {
                    None => None,
                    Some(d) => Some(Edge { callee: d.path, args: d.args }),
                }
            } else {
                Some(Edge { callee: e.callee.clone(), args: a })
            }
        }

        #[summary("색인한 자리: 원소의 타입, 색인할 수 없으면 E0407")]
        #[effects(alloc)]
        fn elem_place(self: &mut Body, span: source::Span, p: Place) -> Place {
            match elem_of(&p.ty) {
                None => { if !types::is_error(&p.ty) { self.c.err("E0407", span, types::cat3("type `", types::text(&p.ty).as_str(), "` cannot be indexed").as_str()); } Place { ty: ast::TypeKind::Error, writable: false } },
                Some(t) => Place { ty: t, writable: p.writable },
            }
        }

        #[summary("path가 열거형인가")]
        #[effects(alloc)]
        fn enum_adt(self: &Body, path: &str) -> bool {
            match self.c.adts.find(path) {
                None => false,
                Some(at) => !struct_kind(&self.c.adts.items[at].kind),
            }
        }

        #[summary("경로의 마지막 마디를 뺀 앞이 열거형을 가리키는가")]
        #[effects(alloc)]
        fn enum_prefix(self: &Body, segs: &[ast::Ident], mp: &str) -> bool {
            if segs.len() < 2 {
                return false;
            }
            let ty: Vec<ast::Ident> = head(segs);
            match self.c.type_path(ty.as_slice(), mp) {
                None => false,
                Some(tp) => self.enum_adt(tp.as_str()),
            }
        }

        #[summary("found가 want인가. 아니면 E0401, 고칠 길은 꼴에 따라 (참조의 값 읽기, 정수 변환, f64)")]
        #[effects(alloc)]
        fn expect_ty(self: &mut Body, found: &ast::TypeKind, want: &ast::TypeKind, span: source::Span) -> () {
            if self.spec_widen && widens(found, want) {
                return;
            }
            if ty_has_error(found, 1000000000) || ty_has_error(want, 1000000000) {
                return;
            }
            if types::same(found, want) || is_never(found) {
                return;
            }
            let msg: String = types::cat5("expected `", types::text(want).as_str(), "`, found `", types::text(found).as_str(), "`");
            let refers: bool = match ref_inner(found) {
                None => false,
                Some(inner) => types::same(&inner, want),
            };
            if refers {
                self.c.help("E0401", span, msg.as_str(), "read the value it refers to: `*x`");
            } else if types::is_int(found) && types::is_int(want) {
                let w: String = types::text(want);
                let fix: String = if conv_obligation(found, want) {
                    types::cat3("convert: `x as ", w.as_str(), "` (its range is a proof obligation)")
                } else {
                    types::cat3("convert: `x as ", w.as_str(), "` (every value fits)")
                };
                self.c.help("E0401", span, msg.as_str(), fix.as_str());
            } else if types::is_int(found) && is_f64(want) {
                self.c.help("E0401", span, msg.as_str(), "convert: `f64::from(x)` (exact; a 64-bit integer has the obligation `|x| <= 2^53`)");
            } else if is_f64(found) && types::is_int(want) {
                self.c.help("E0401", span, msg.as_str(), "`f64` does not convert to an integer type (ADR-0061 §4, open question 1)");
            } else {
                self.c.err("E0401", span, msg.as_str());
            }
        }

        #[summary("제네릭 데이터 타입 tp의 매개변수를 기대한 타입에서 묶는다 (기대한 타입이 그 타입의 인스턴스일 때)")]
        #[effects(alloc)]
        fn expected_args(self: &Body, tp: &str, expected: &Option<ast::TypeKind>) -> types::Subst {
            match expected {
                None => empty_subst(),
                Some(t) => { match types::named_path(t) { None => empty_subst(), Some(p) => { match self.c.adts.find(tp) { None => empty_subst(), Some(at) => { if p.as_str() == tp { types::adt_subst(&self.c.adts.items[at], t) } else { empty_subst() } }, } }, } },
            }
        }

        #[summary("식 하나의 타입: 타입을 표에 적고(types), 명세 안의 자리와 타입 없는 let이 타입을 받은 자리를 적어 둔다 (2N-13, settle_lets)")]
        #[effects(alloc)]
        fn expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 2,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let widen: bool = self.spec_widen;
            self.spec_widen = !exec_mode(mode);
            let t: ast::TypeKind = self.expr_inner(cx, e, expected, mode, f);
            self.spec_widen = widen;
            self.types.insert(span_key(e.span).as_str(), t.clone());
            if !exec_mode(mode) && self.open_lets.len() > 0 && !has_span(self.spec_at.as_slice(), e.span) {
                self.spec_at.push(e.span);
            }
            if exec_mode(mode) {
                match ast::var_name(e) {
                    None => {},
                    Some(v) => { match expected { None => {}, Some(x) => { if self.open_let(v.as_str()) && settled(x, self.c.tparams.as_slice(), 100000) { self.typed_uses.push(TypedUse { name: v.clone(), lo: e.span.lo, ty: x.clone() }); } }, } },
                }
            }
            t
        }

        #[summary("식의 꼴마다의 검사. 유령 코드(ADR-0062 §1)에서 if·match·블록·loop는 유령 문장을 담고 호출은 종류로 보며, 나머지는 명세다")]
        #[effects(alloc)]
        fn expr_inner(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, expected: &Option<ast::TypeKind>, written: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let mode: Mode = if ghost_mode(written) && !self.ghost_keeps(cx, e) {
                Mode::Spec(true)
            } else {
                written
            };
            let no: Option<ast::TypeKind> = None;
            match &e.kind {
                ast::ExprKind::Int(v, q4_r) => { if opt_f64(expected) { let mut s: String = String::new(); wide::push_radix(&mut s, *v, 10); self.int_for_float(s.as_str(), e.span) } else { self.int_lit(*v, false, expected, e.span, mode) } },
                ast::ExprKind::Float(q4_ek_float0) => ast::TypeKind::F64,
                ast::ExprKind::ByteLit(b) => self.byte_lit(*b, expected, e.span),
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => { self.c.help("E0409", e.span, "a byte string may only appear directly as a call argument", "pass it to a `&[u8]` parameter, e.g. `bytes::extend(&mut v, b\"..\")`"); ast::TypeKind::Error },
                ast::ExprKind::StrLit(st) => self.str_lit(st.as_str(), e.span),
                ast::ExprKind::CharLit(ch) => self.char_lit(*ch, expected, e.span),
                ast::ExprKind::Bool(q4_ek_bool0) => ast::TypeKind::Bool,
                ast::ExprKind::Unit => ast::TypeKind::Unit,
                ast::ExprKind::Var(id) => self.var_expr(cx, e, id, expected, mode, f - 1),
                ast::ExprKind::Call(c) => self.call_expr(cx, e, c, expected, mode, f - 1),
                ast::ExprKind::Method(m) => { if conv_call(&*m.recv) { self.conversion(cx, &*m.recv, &m.name, m.args.as_slice(), e.span, mode, f - 1) } else { self.method(cx, &*m.recv, &m.name, m.args.as_slice(), e.span, mode, f - 1) } },
                ast::ExprKind::Index(base, index) => self.index_expr(cx, &**base, &**index, mode, f - 1),
                ast::ExprKind::Unary(op, x) => self.unary_expr(cx, e, *op, &**x, expected, mode, f - 1),
                ast::ExprKind::Binary(bop, l, r) => self.binary(cx, *bop, &**l, &**r, expected, mode, e.span, f - 1),
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => { self.c.err("E0409", e.span, "`&` / `&mut` may only appear directly as a call argument"); ast::TypeKind::Error },
                ast::ExprKind::If(ife) => self.if_expr(cx, ife, expected, mode, f - 1),
                ast::ExprKind::Block(blk) => self.block(cx, blk, expected, mode, f - 1),
                ast::ExprKind::Array(items) => self.array_expr(cx, e, items.as_slice(), expected, mode, f - 1),
                ast::ExprKind::Repeat(rp) => self.repeat_expr(cx, rp, expected, mode, f - 1),
                ast::ExprKind::Old(ox) => self.old_expr(cx, e, &**ox, mode),
                ast::ExprKind::Quant(q) => self.quant_expr(cx, e, q, mode, f - 1),
                ast::ExprKind::Trigger(tx) => self.trigger_expr(cx, e, &**tx, expected, mode, f - 1),
                ast::ExprKind::Closure(q4_ek_closure0) => ast::TypeKind::Error,
                ast::ExprKind::StructLit(sl) => self.struct_expr(cx, e, sl, expected, mode, f - 1),
                ast::ExprKind::Path(p) => self.path_expr(cx, e, p.as_slice(), expected, mode, f - 1),
                ast::ExprKind::Deref(dx) => self.deref_expr(cx, e, &**dx, mode, f - 1),
                ast::ExprKind::Field(fb, name) => { self.deref_field(e, &**fb, name); let bt: ast::TypeKind = self.expr(cx, &**fb, &no, mode, f - 1); self.field_type_of(&bt, name) },
                ast::ExprKind::Match(ma) => self.match_expr(cx, &*ma.scrut, ma.arms.as_slice(), expected, e.span, mode, f - 1),
                ast::ExprKind::Return(rv) => self.return_expr(cx, e, rv, mode, f - 1),
                ast::ExprKind::Try(tr) => self.try_expr(cx, e, &**tr, mode, f - 1),
                ast::ExprKind::Loop(lp) => self.loop_expr(cx, e, lp, expected, mode, f - 1),
                ast::ExprKind::Break(bk) => self.break_expr(cx, e, bk, mode, f - 1),
                ast::ExprKind::Continue(label) => { if !exec_mode(mode) { self.c.help("E0503", e.span, "`continue` is not allowed in a specification", "a specification is one expression: it has no loop to go on"); } self.jump_target(cx, label, e.span, "continue"); ast::TypeKind::Never },
                ast::ExprKind::Range(rg) => self.range_expr(cx, e, rg, mode, f - 1),
                ast::ExprKind::Error => ast::TypeKind::Error,
            }
        }

        #[summary("f64::from(x) (ADR-0061 §4): x는 어느 정수 타입이든, 또는 f64")]
        #[effects(alloc)]
        fn f64_from(self: &mut Body, cx: &mut FnCtx, args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            if args.len() != 1 {
                self.c.help("E0405", span, "`f64::from` takes one argument", "write `f64::from(x)` with an integer `x`");
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            let t: ast::TypeKind = self.expr(cx, &args[0], &no, mode, f - 1);
            if types::is_int(&t) || is_f64(&t) || types::is_error(&t) {
                return ast::TypeKind::F64;
            }
            self.c.help("E0401", args[0].span, types::cat3("`f64::from` takes an integer, found `", types::text(&t).as_str(), "`").as_str(), "`f64::from(x)` converts an integer of any type");
            ast::TypeKind::Error
        }

        #[summary("f64의 메서드 (ADR-0061 §3): sqrt·abs·is_nan·is_finite는 인자가 없고 min·max는 f64 하나, Rust와 같다")]
        #[effects(alloc)]
        fn f64_method(self: &mut Body, cx: &mut FnCtx, name: &ast::Ident, args: &[ast::Expr], mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let sig: u8 = f64_sig(name.name.as_str());
            if sig == 0 {
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                self.c.help("E0404", name.span, types::cat3("unknown method `", name.name.as_str(), "` of `f64`").as_str(), f64_missing(name.name.as_str()).as_str());
                return ast::TypeKind::Error;
            }
            let arity: usize = if sig == 3 {
                1
            } else {
                0
            };
            if args.len() != arity {
                if arity == 0 {
                    self.c.help("E0405", name.span, types::cat3("`", name.name.as_str(), "` takes no arguments").as_str(), types::cat3("write `x.", name.name.as_str(), "()` (Rust's signature)").as_str());
                } else {
                    self.c.help("E0405", name.span, types::cat3("`", name.name.as_str(), "` takes one argument").as_str(), types::cat3("write `x.", name.name.as_str(), "(y)` with `y: f64` (Rust's signature)").as_str());
                }
                for j in 0..args.len()
                    invariant 0 <= j && j <= args.len(),
                {
                    self.expr(cx, &args[j], &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            if args.len() > 0 {
                let wf: Option<ast::TypeKind> = Some(ast::TypeKind::F64);
                let at: ast::TypeKind = self.expr(cx, &args[0], &wf, mode, f - 1);
                self.expect_ty(&at, &ast::TypeKind::F64, args[0].span);
            }
            if sig == 2 {
                ast::TypeKind::Bool
            } else {
                ast::TypeKind::F64
            }
        }

        #[summary("구조체(나 그 참조) bt의 필드 name의 타입")]
        #[effects(alloc)]
        fn field_type_of(self: &mut Body, bt: &ast::TypeKind, name: &ast::Ident) -> ast::TypeKind {
            if types::is_error(bt) {
                return ast::TypeKind::Error;
            }
            if is_child(bt) {
                self.child_by_hand(name.span);
                return ast::TypeKind::Error;
            }
            let decl: Fields = self.struct_fields(bt);
            if !decl.found {
                let msg: String = types::cat5("`", types::text(bt).as_str(), "` has no field `", name.name.as_str(), "`");
                if is_named(bt) {
                    self.c.help("E0306", name.span, msg.as_str(), "enum values have no fields: `match` the variants");
                } else {
                    self.c.help("E0306", name.span, msg.as_str(), "only structs have fields");
                }
                return ast::TypeKind::Error;
            }
            let mut names: Vec<String> = Vec::new();
            for i in 0..decl.fields.len()
                invariant 0 <= i && i <= decl.fields.len(),
            {
                if decl.fields[i].name == name.name {
                    return decl.fields[i].ty.clone();
                }
                names.push(decl.fields[i].name.clone());
            }
            let none: String = types::cat5("`", decl.path.as_str(), "` has no field `", name.name.as_str(), "`");
            match types::closest(name.name.as_str(), names.as_slice()) {
                None => self.c.help("E0306", name.span, none.as_str(), types::cat4("fields of `", decl.path.as_str(), "`: ", types::join(names.as_slice(), ", ").as_str()).as_str()),
                Some(near) => self.c.fixed("E0306", name.span, none.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()),
            }
            ast::TypeKind::Error
        }

        #[summary("for: 두 끝은 한 정수 타입이고(리터럴은 다른 끝의 것을 받는다) 루프 앞에서 한 번 계산된다. 변수는 루프 안에서만 살고 대입되지 않는다")]
        #[effects(alloc)]
        fn for_stmt(self: &mut Body, cx: &mut FnCtx, x: &ast::For, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if ghost_mode(mode) {
                self.ghost_loop(x.span);
            } else if !exec_mode(mode) {
                self.spec_loop(x.span);
            }
            let m: Mode = operand(mode);
            let no: Option<ast::TypeKind> = None;
            let mut lt: ast::TypeKind = ast::TypeKind::Error;
            let mut ht: ast::TypeKind = ast::TypeKind::Error;
            if untyped_literal(&x.lo, 1000000000) && !untyped_literal(&x.hi, 1000000000) {
                ht = self.expr(cx, &x.hi, &no, m, f - 1);
                let want_lo: Option<ast::TypeKind> = int_want(&ht);
                lt = self.expr(cx, &x.lo, &want_lo, m, f - 1);
            } else {
                lt = self.expr(cx, &x.lo, &no, m, f - 1);
                let want_hi: Option<ast::TypeKind> = int_want(&lt);
                ht = self.expr(cx, &x.hi, &want_hi, m, f - 1);
            }
            if !types::is_int(&lt) && !types::is_error(&lt) {
                self.c.help("E0401", x.lo.span, types::cat3("a `for` range is of integers, found `", types::text(&lt).as_str(), "`").as_str(), "loop over integer bounds and index with them");
            }
            if types::is_int(&lt) && types::is_int(&ht) && !types::same(&lt, &ht) {
                self.c.help("E0401", x.hi.span, types::cat5("the ends of a `for` range have one type: `", types::text(&lt).as_str(), "` and `", types::text(&ht).as_str(), "`").as_str(), types::cat3("convert one end: `.. as ", types::text(&lt).as_str(), "`").as_str());
            } else {
                self.expect_ty(&ht, &lt, x.hi.span);
            }
            let scope: Vec<Local> = Vec::new();
            cx.scopes.push(scope);
            self.declare(cx, &x.var, lt, false, false);
            types::add(&mut cx.for_vars, x.var.name.as_str());
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            for i in 0..x.invariants.len()
                invariant 0 <= i && i <= x.invariants.len(),
            {
                let t: ast::TypeKind = self.expr(cx, &x.invariants[i], &wb, Mode::Spec(true), f - 1);
                self.expect_ty(&t, &ast::TypeKind::Bool, x.invariants[i].span);
            }
            cx.loops.push(LoopCx { label: label_name(&x.label), is_loop: false, value: None });
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Unit);
            let bt: ast::TypeKind = self.block(cx, &x.body, &wu, mode, f - 1);
            cx.loops.pop();
            cx.scopes.pop();
            self.expect_ty(&bt, &ast::TypeKind::Unit, x.body.span);
        }

        #[summary("T::from_be_bytes(b), T::from_le_bytes(b): 바이트에서 온 정수 (백로그 2N-09c)")]
        #[effects(alloc)]
        fn from_bytes(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, c: &ast::Call, i: ast::IntTy, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 || c.path.len() != 2 {
                return ast::TypeKind::Error;
            }
            let bt: ast::TypeKind = ast::TypeKind::Array(types::boxed(ast::TypeKind::Int(ast::IntTy::U8)), (bits(i) / 8) as u64);
            let btt: String = types::text(&bt);
            let iname: String = int_text(i);
            if c.args.len() != 1 {
                self.c.help("E0405", e.span, types::cat3("`", c.path[1].name.as_str(), "` takes one argument").as_str(), types::cat7("write `", iname.as_str(), "::", c.path[1].name.as_str(), "(b)` with `b: ", btt.as_str(), "`").as_str());
                return ast::TypeKind::Error;
            }
            let hint: Option<ast::TypeKind> = Some(bt.clone());
            let at: ast::TypeKind = self.expr(cx, &c.args[0], &hint, mode, f - 1);
            if !types::same(&at, &bt) && !types::is_error(&at) && !is_never(&at) {
                self.c.help("E0401", c.args[0].span, types::cat5("expected `", btt.as_str(), "`, found `", types::text(&at).as_str(), "`").as_str(), types::cat5("the bytes of a `", iname.as_str(), "` are a `", btt.as_str(), "` (`x.to_be_bytes()`, `x.to_le_bytes()`)").as_str());
            }
            ast::TypeKind::Int(i)
        }

        #[summary("유령 코드에서 유령으로 남는 식인가: if·match·블록·loop, 그리고 spec fn이 아닌 함수의 호출")]
        #[effects(alloc)]
        fn ghost_keeps(self: &Body, cx: &FnCtx, e: &ast::Expr) -> bool {
            if ghost_shape(&e.kind) {
                return true;
            }
            match call_of(e) {
                None => false,
                Some(c) => { match self.resolve(c.path.as_slice(), cx.mod_path.as_str()) { None => false, Some(t) => { match self.c.fns.find(t.as_str()) { None => false, Some(i) => !is_spec(self.c.fns.items[i].kind), } }, } },
            }
        }

        #[summary("E0257: 유령 코드의 루프")]
        #[effects(alloc)]
        fn ghost_loop(self: &mut Body, span: source::Span) -> () {
            self.ghost_violation(span, "a loop", "prove by induction: a recursive `proof fn` with `decreases`");
        }

        #[summary("유령 코드의 &mut 매개변수: spec fn은 E0402, proof fn은 E0257 (ADR-0062 §1)")]
        #[effects(alloc)]
        fn ghost_mut_param(self: &mut Body, span: source::Span, kind: ast::FnKind) -> () {
            if is_proof(kind) {
                self.c.help("E0257", span, "a `proof fn` parameter cannot be `&mut`: ghost code changes no executable state", "take the value or `&T`");
            } else {
                self.c.err("E0402", span, "spec function parameters cannot be `&mut`");
            }
        }

        #[summary("E0257: 유령 코드는 실행 상태를 읽기만 한다 (ADR-0062 §1)")]
        #[effects(alloc)]
        fn ghost_violation(self: &mut Body, span: source::Span, what: &str, fix: &str) -> () {
            self.c.help("E0257", span, types::cat2(what, " is not allowed in ghost code (a `proof fn` body or a `proof { .. }` block)").as_str(), fix);
        }

        #[summary("t가 값만 담는가 (ADR-0052 §2): 정수, bool, char, 그리고 그것들의 배열·구조체·열거형")]
        #[effects(alloc)]
        fn holds_values(self: &Body, t: &ast::TypeKind, seen: &mut Vec<String>, f: usize) -> bool
            decreases f,
        {
            if f == 0 {
                return false;
            }
            match t {
                ast::TypeKind::Int(q4_tk_int0) => true,
                ast::TypeKind::F64 => false,
                ast::TypeKind::Bool => true,
                ast::TypeKind::Unit => false,
                ast::TypeKind::Char => true,
                ast::TypeKind::String => false,
                ast::TypeKind::Str => false,
                ast::TypeKind::Array(e, q4_tk_array1) => self.holds_values(&e.kind, seen, f - 1),
                ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
                ast::TypeKind::Slice(q4_tk_slice0) => false,
                ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => false,
                ast::TypeKind::Named(path, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if !self.holds_values(&args[i].kind, seen, f - 1) { return false; } } let full: String = types::join(path.as_slice(), "::"); if full == "Option" || full == "Result" { return true; } let at: usize = match self.c.adts.find(full.as_str()) { None => { return false; }, Some(k) => k, }; if !types::add(seen, full.as_str()) { return true; } let sub: types::Subst = types::adt_subst(&self.c.adts.items[at], t); let parts: Vec<ast::TypeKind> = adt_parts(&self.c.adts.items[at].kind); for i in 0..parts.len() invariant 0 <= i && i <= parts.len(), { let p: ast::TypeKind = types::subst(&parts[i], &sub); if !self.holds_values(&p, seen, f - 1) { return false; } } true },
                ast::TypeKind::Vec(q4_tk_vec0) => false,
                ast::TypeKind::Box(q4_tk_box0) => false,
                ast::TypeKind::Param(q4_tk_param0) => false,
                ast::TypeKind::Never => false,
                ast::TypeKind::Error => false,
            }
        }

        #[summary("if c { a } else { b }: 조건은 bool, 가지들은 한 타입. 리터럴 가지는 다른 가지에서 타입을 받고, 끝나지 않는 가지는 다른 가지의 타입을 받는다. 명세에서는 넓은 정수 타입으로 합친다 (ADR-0099)")]
        #[effects(alloc)]
        fn if_expr(self: &mut Body, cx: &mut FnCtx, ife: &ast::If, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let ct: ast::TypeKind = self.expr(cx, &*ife.cond, &wb, operand(mode), f - 1);
            self.expect_ty(&ct, &ast::TypeKind::Bool, ife.cond.span);
            let then_lit: bool = ife.then.stmts.len() == 0 && opt_literal(&ife.then.tail, 1000000000);
            match &ife.els {
                None => { let ut: ast::TypeKind = self.block(cx, &ife.then, expected, mode, f - 1); self.expect_ty(&ut, &ast::TypeKind::Unit, ife.then.span); ast::TypeKind::Unit },
                Some(el) => { if !has_type(expected) && then_lit && !untyped_literal(&**el, 1000000000) { let et: ast::TypeKind = self.expr(cx, &**el, &no, mode, f - 1); let want: Option<ast::TypeKind> = if types::is_int(&et) { Some(et.clone()) } else { None }; let lt: ast::TypeKind = self.block(cx, &ife.then, &want, mode, f - 1); self.expect_ty(&et, &lt, el.span); return lt; } let tt: ast::TypeKind = self.block(cx, &ife.then, expected, mode, f - 1); let hint: Option<ast::TypeKind> = if types::is_error(&tt) || is_never(&tt) { expected.clone() } else { Some(tt.clone()) }; let et2: ast::TypeKind = self.expr(cx, &**el, &hint, mode, f - 1); if is_never(&tt) { return et2; } if !exec_mode(mode) && widens(&tt, &et2) { return et2; } self.expect_ty(&et2, &tt, el.span); tt },
            }
        }

        #[summary("list의 impl 가운데 value에 맞고 그 trait에 메서드 m이 있는 것이 있는가")]
        #[effects(alloc)]
        fn impls_have(self: &Body, value: &ast::TypeKind, list: &[types::TraitImplInfo], m: &str) -> bool {
            for i in 0..list.len()
                invariant 0 <= i && i <= list.len(),
            {
                let fits: bool = match types::matches(&list[i], value) {
                    None => false,
                    Some(q4_s) => true,
                };
                if fits {
                    match self.c.traits.find(list[i].trait_path.as_str()) {
                        None => {},
                        Some(k) => { if types::has(self.c.traits.items[k].methods.as_slice(), m) { return true; } },
                    }
                }
            }
            false
        }

        #[summary("a[i]: i는 usize, a는 배열·Vec·조각. s.as_bytes()[i]는 글의 바이트다 (ADR-0050 §2)")]
        #[effects(alloc)]
        fn index_expr(self: &mut Body, cx: &mut FnCtx, base: &ast::Expr, index: &ast::Expr, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Int(ast::IntTy::Usize));
            match as_bytes_of(base) {
                None => {},
                Some(recv) => { let ok: bool = self.as_bytes_arg(cx, base, &recv, mode, f - 1); let bi: ast::TypeKind = self.expr(cx, index, &wu, mode, f - 1); self.expect_ty(&bi, &ast::TypeKind::Int(ast::IntTy::Usize), index.span); if !ok { self.c.err("E0404", base.span, "`as_bytes` is defined for `String` and `&str`"); return ast::TypeKind::Error; } return ast::TypeKind::Int(ast::IntTy::U8); },
            }
            let bt: ast::TypeKind = self.expr(cx, base, &no, mode, f - 1);
            let it: ast::TypeKind = self.expr(cx, index, &wu, mode, f - 1);
            self.expect_ty(&it, &ast::TypeKind::Int(ast::IntTy::Usize), index.span);
            match elem_of(&bt) {
                None => { let msg: String = types::cat3("type `", types::text(&bt).as_str(), "` cannot be indexed"); if is_text(&bt) { self.c.help("E0407", base.span, msg.as_str(), "read a byte with `s.as_bytes()[i]`; a part of the text is `&s[a..b]`, as an argument"); } else if !types::is_error(&bt) { self.c.err("E0407", base.span, msg.as_str()); } ast::TypeKind::Error },
                Some(t) => t,
            }
        }

        #[summary("색인은 usize다")]
        #[effects(alloc)]
        fn index_usize(self: &mut Body, cx: &mut FnCtx, index: &ast::Expr, f: usize) -> ()
            decreases f * 3 + 2,
        {
            if f == 0 {
                return;
            }
            let want: Option<ast::TypeKind> = Some(ast::TypeKind::Int(ast::IntTy::Usize));
            let it: ast::TypeKind = self.expr(cx, index, &want, Mode::Exec, f - 1);
            self.expect_ty(&it, &ast::TypeKind::Int(ast::IntTy::Usize), index.span);
        }

        #[summary("묶음 tm이 주는 제네릭 데이터 타입 tp의 인스턴스. 매개변수가 아직 모르는 것이면 E0424")]
        #[effects(alloc)]
        fn instance(self: &mut Body, tp: &str, tm: &types::Subst, what: &str, span: source::Span) -> ast::TypeKind {
            let at: usize = match self.c.adts.find(tp) {
                None => { return ast::TypeKind::Error; },
                Some(i) => i,
            };
            let path: Vec<String> = refs::split_path(tp);
            let mut targs: Vec<ast::Type> = Vec::new();
            let mut missing: bool = false;
            for j in 0..self.c.adts.items[at].generics.len()
                invariant 0 <= j && j <= self.c.adts.items[at].generics.len(),
            {
                match types::sub_get(tm, self.c.adts.items[at].generics[j].name.as_str()) {
                    None => { missing = true; },
                    Some(t) => targs.push(types::ty(t)),
                }
            }
            if missing {
                let last: String = if path.len() > 0 {
                    path[path.len() - 1].clone()
                } else {
                    String::new()
                };
                self.c.help("E0424", span, types::cat3("the type of ", what, " is not known here").as_str(), types::cat3("give it a type: `let x: ", last.as_str(), "<..> = ..;`, or pass it where the type is written").as_str());
                return ast::TypeKind::Error;
            }
            ast::TypeKind::Named(path, targs)
        }

        #[summary("인스턴스 w(정의와 타입 인자)가 부르는 인스턴스들을 그래프에 넣는다: trait 메서드의 호출은 Self가 알려지면 impl의 함수로 가고(호출에서 Self가 타입 매개변수였으면 경계 있는 호출로 적는다), 깊이가 한도를 넘는 타입 인자의 호출은 버린다")]
        #[effects(alloc)]
        fn instance_edges(self: &Body, w: &Edge, edges: &table::Table<Vec<Edge>>, graph: &mut table::Table<Vec<String>>, bound_edges: &mut Vec<Pair>, base_of: &mut table::Table<String>, work: &mut Vec<Edge>) -> () {
            let k: String = inst_key(w.callee.as_str(), w.args.as_slice());
            if graph.has(k.as_str()) {
                return;
            }
            let mut to: Vec<String> = Vec::new();
            base_of.insert(k.as_str(), w.callee.clone());
            let mut sub: types::Subst = empty_subst();
            match self.c.fns.find(w.callee.as_str()) {
                None => {},
                Some(at) => { for i in 0..self.c.fns.items[at].generics.len() invariant 0 <= i && i <= self.c.fns.items[at].generics.len(), { if i < w.args.len() { sub_put(&mut sub, self.c.fns.items[at].generics[i].name.as_str(), w.args[i].clone()); } } },
            }
            match edges.find(w.callee.as_str()) {
                None => {},
                Some(e) => { for i in 0..edges.items[e].len() invariant 0 <= i && i <= edges.items[e].len(), { let mut a: Vec<ast::TypeKind> = Vec::new(); let mut deep: bool = false; for j in 0..edges.items[e][i].args.len() invariant 0 <= j && j <= edges.items[e][i].args.len(), { let t: ast::TypeKind = types::subst(&edges.items[e][i].args[j], &sub); if type_depth(&t, 100000) > 8 { deep = true; } a.push(t); } if !deep { match self.edge_target(&edges.items[e][i], a.clone()) { None => {}, Some(target) => { let ck: String = inst_key(target.callee.as_str(), target.args.as_slice()); if edges.items[e][i].args.len() > 0 && types::is_param(&edges.items[e][i].args[0]) && self.trait_method(edges.items[e][i].callee.as_str()) { bound_edges.push(Pair { from: k.clone(), to: ck.clone() }); } types::add(&mut to, ck.as_str()); work.push(target); }, } } } },
            }
            graph.insert(k.as_str(), to);
        }

        #[summary("f64를 기대한 자리의 정수 리터럴 (let x: f64 = 1;): E0401, 고침은 실수 리터럴. 검사는 f64로 이어 간다")]
        #[effects(alloc)]
        fn int_for_float(self: &mut Body, text: &str, span: source::Span) -> ast::TypeKind {
            self.c.fixed("E0401", span, types::cat3("expected `f64`, found integer literal `", text, "`").as_str(), "write a float literal (ADR-0061 §2)", types::cat2(text, ".0").as_str());
            ast::TypeKind::F64
        }

        #[summary("정수 리터럴: 타입은 기대한 정수 타입, 없으면 i64. 코드에서는 그 타입에 들어야 한다 (E0406); 명세의 정수는 끝이 없다 (ADR-0017, ADR-0024)")]
        #[effects(alloc)]
        fn int_lit(self: &mut Body, v: wide::U128, negative: bool, expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode) -> ast::TypeKind {
            let mut t: ast::TypeKind = ast::TypeKind::Int(ast::IntTy::I64);
            match expected {
                None => {},
                Some(x) => { match int_of(x) { None => {}, Some(xi) => { if signed(xi) || !negative || exec_mode(mode) { t = x.clone(); } }, } },
            }
            let i: ast::IntTy = match int_of(&t) {
                None => ast::IntTy::I64,
                Some(k) => k,
            };
            let zero: bool = v.hi == 0 && v.lo == 0;
            if negative && !zero && !signed(i) {
                self.unsigned_negation(span, &t);
                return ast::TypeKind::Error;
            }
            let bound: consts::Num = if negative {
                consts::min_of(i)
            } else {
                consts::max_of(i)
            };
            let ok: bool = v.hi == 0 && v.lo <= bound.mag;
            if !ok && exec_mode(mode) {
                let tt: String = types::text(&t);
                let mut fix: String = types::cat3("`", tt.as_str(), "` holds ");
                consts::push_num(&mut fix, consts::min_of(i));
                fix.push_str("..=");
                consts::push_num(&mut fix, consts::max_of(i));
                fix.push_str(": use a wider type or a value in range");
                self.c.help("E0406", span, types::cat3("literal does not fit in `", tt.as_str(), "`").as_str(), fix.as_str());
            }
            t
        }

        #[summary("정수와 그 밖의 내장 메서드: len, wrapping_*·saturating_*·checked_*, 바이트(to_be_bytes·to_le_bytes), 비트 메서드 (ADR-0028 §3, ADR-0048 §2). 모르는 이름은 E0404")]
        #[effects(alloc)]
        fn int_method(self: &mut Body, cx: &mut FnCtx, recv: &ast::Expr, rt: &ast::TypeKind, name: &ast::Ident, args: &[ast::Expr], mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let m: String = name.name.clone();
            let ty: String = types::text(rt);
            let undefined: String = types::cat5("`", m.as_str(), "` is not defined for `", ty.as_str(), "`");
            if m == "len" {
                if args.len() != 0 {
                    self.c.err("E0405", name.span, "`len` takes no arguments");
                }
                let has_elem: bool = match elem_of(rt) {
                    None => false,
                    Some(et) => true,
                };
                if !has_elem && !types::is_error(rt) {
                    self.c.err("E0404", name.span, undefined.as_str());
                    return ast::TypeKind::Error;
                }
                return ast::TypeKind::Int(ast::IntTy::Usize);
            }
            if arith_method(m.as_str()) {
                if args.len() != 1 {
                    self.c.err("E0405", name.span, types::cat3("`", m.as_str(), "` takes one argument").as_str());
                    return ast::TypeKind::Error;
                }
                let hint: Option<ast::TypeKind> = Some(rt.clone());
                let at: ast::TypeKind = self.expr(cx, &args[0], &hint, mode, f - 1);
                if !types::is_int(rt) && !types::is_error(rt) {
                    self.c.err("E0404", name.span, undefined.as_str());
                    return ast::TypeKind::Error;
                }
                self.expect_ty(&at, rt, args[0].span);
                if checked_arith(m.as_str()) && !types::is_error(rt) {
                    return option_of(rt.clone());
                }
                return rt.clone();
            }
            if m == "to_be_bytes" || m == "to_le_bytes" {
                if args.len() != 0 {
                    self.c.help("E0405", name.span, types::cat3("`", m.as_str(), "` takes no arguments").as_str(), types::cat3("write `x.", m.as_str(), "()` (Rust's signature)").as_str());
                    return ast::TypeKind::Error;
                }
                return match int_of(rt) { None => { if !types::is_error(rt) { self.c.help("E0404", name.span, undefined.as_str(), "bit methods are methods of the integer types"); } ast::TypeKind::Error }, Some(i) => bytes_ty(i), };
            }
            let arity: u8 = bit_method(m.as_str());
            if arity > 0 {
                let want: usize = if arity == 2 {
                    1
                } else {
                    0
                };
                if args.len() != want {
                    if want == 0 {
                        self.c.help("E0405", name.span, types::cat3("`", m.as_str(), "` takes no arguments").as_str(), types::cat3("write `x.", m.as_str(), "()` (Rust's signature)").as_str());
                    } else {
                        self.c.help("E0405", name.span, types::cat3("`", m.as_str(), "` takes one argument").as_str(), types::cat3("write `x.", m.as_str(), "(n)` with an amount `n: u32` (Rust's signature)").as_str());
                    }
                    return ast::TypeKind::Error;
                }
                let u32t: ast::TypeKind = ast::TypeKind::Int(ast::IntTy::U32);
                let amount: Option<ast::TypeKind> = Some(u32t.clone());
                let mut at: ast::TypeKind = ast::TypeKind::Error;
                if args.len() > 0 {
                    at = self.expr(cx, &args[0], &amount, mode, f - 1);
                }
                let it: ast::IntTy = match int_of(rt) {
                    None => { if !types::is_error(rt) { self.c.help("E0404", name.span, undefined.as_str(), "bit methods are methods of the integer types"); } return ast::TypeKind::Error; },
                    Some(i) => i,
                };
                if args.len() > 0 {
                    self.expect_ty(&at, &u32t, args[0].span);
                }
                if m == "is_power_of_two" {
                    if signed(it) {
                        self.c.help("E0404", name.span, undefined.as_str(), "it is a method of the unsigned integer types (Rust's)");
                        return ast::TypeKind::Error;
                    }
                    return ast::TypeKind::Bool;
                }
                if m == "checked_shl" || m == "checked_shr" {
                    return option_of(rt.clone());
                }
                if bit_count(m.as_str()) {
                    return u32t;
                }
                return rt.clone();
            }
            if (m == "into" || m == "try_into") && types::is_int(rt) {
                self.args_only(cx, args, mode, f - 1);
                self.c.help("E0212", name.span, types::cat3("`.", m.as_str(), "()` is not used").as_str(), types::cat3("write `", fmt::expr_text(recv).as_str(), " as T` with the target type `T`").as_str());
                return ast::TypeKind::Error;
            }
            let msg: String = types::cat3("unknown method `", m.as_str(), "`");
            let fix: String = method_missing(m.as_str());
            if fix.len() > 0 {
                self.c.help("E0404", name.span, msg.as_str(), fix.as_str());
            } else {
                self.c.err("E0404", name.span, msg.as_str());
            }
            self.args_only(cx, args, mode, f - 1);
            ast::TypeKind::Error
        }

        #[summary("span의 break나 continue가 떠나는 루프: 레이블이 가리키는 것이나 가장 안쪽 것의 cx.loops 자리 (없으면 E0250, E0317)")]
        #[effects(alloc)]
        fn jump_target(self: &mut Body, cx: &FnCtx, label: &Option<ast::Ident>, span: source::Span, what: &str) -> Option<usize> {
            if cx.loops.len() == 0 {
                self.c.help("E0250", span, types::cat3("`", what, "` outside a loop").as_str(), "use it inside a `while`, `for` or `loop`; to leave the function, `return`");
                return None;
            }
            match label {
                None => Some(cx.loops.len() - 1),
                Some(l) => { let mut found: Option<usize> = None; let mut known: String = String::new(); for i in 0..cx.loops.len() invariant 0 <= i && i <= cx.loops.len(), { match &cx.loops[i].label { None => {}, Some(n) => { if n.as_str() == l.name.as_str() { found = Some(i); } if known.len() > 0 { known.push_str(", "); } known.push_str("'"); known.push_str(n.as_str()); }, } } if no_index(&found) { let msg: String = types::cat3("no loop labeled `'", l.name.as_str(), "` around this"); if known.len() == 0 { self.c.help("E0317", l.span, msg.as_str(), "label the loop: `'name: while ..`"); } else { self.c.help("E0317", l.span, msg.as_str(), types::cat2("the labels in scope are ", known.as_str()).as_str()); } } found },
            }
        }

        #[summary("풀어 쓰는 let (Rust의 습관, E0230): 필드의 타입으로 고칠 글을 만든다")]
        #[effects(alloc)]
        fn let_fields(self: &mut Body, cx: &mut FnCtx, l: &ast::LetFields, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            let it: ast::TypeKind = self.expr(cx, &l.init, &no, mode, f - 1);
            let decl: Fields = self.struct_fields(&it);
            let var: Option<String> = ast::var_name(&l.init);
            let mut lets: String = String::new();
            let mut n: usize = 0;
            for i in 0..l.fields.len()
                invariant 0 <= i && i <= l.fields.len() && n <= i,
            {
                let mut ty: ast::TypeKind = ast::TypeKind::Error;
                let mut have: bool = false;
                for j in 0..decl.fields.len()
                    invariant 0 <= j && j <= decl.fields.len(),
                {
                    if !have && decl.fields[j].name == l.fields[i].name {
                        ty = decl.fields[j].ty.clone();
                        have = true;
                    }
                }
                if have {
                    match &var {
                        None => {},
                        Some(v) => { if n > 0 { lets.push_str(" "); } lets.push_str("let "); lets.push_str(l.fields[i].name.as_str()); lets.push_str(": "); lets.push_str(types::text(&ty).as_str()); lets.push_str(" = "); lets.push_str(v.as_str()); lets.push_str("."); lets.push_str(l.fields[i].name.as_str()); lets.push_str(";"); n = n + 1; },
                    }
                }
                self.declare(cx, &l.fields[i], ty, false, false);
            }
            if n == l.fields.len() {
                self.c.fixed("E0230", l.span, "destructuring `let` is not allowed", "read each field into its own `let`", lets.as_str());
            } else {
                self.c.help("E0230", l.span, "destructuring `let` is not allowed", "read each field into its own `let`: `let x: T = p.x;`");
            }
        }

        #[summary("타입을 쓴 let")]
        #[effects(alloc)]
        fn let_typed(self: &mut Body, cx: &mut FnCtx, l: &ast::Let, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            self.check_value_type(&l.ty, "local variable type");
            if l.mutable && ghost_mode(mode) {
                self.ghost_violation(l.name.span, "`let mut`", "bind the value with `let`: ghost values do not change");
            } else if l.mutable && !exec_mode(mode) {
                self.c.err("E0503", l.name.span, "`let mut` is not allowed in a specification");
            }
            let mp: String = cx.mod_path.clone();
            let lty: ast::TypeKind = self.c.canon(&l.ty, mp.as_str(), true, 1000000000);
            match ast::var_name(&l.init) {
                None => {},
                Some(v) => self.typed_uses.push(TypedUse { name: v, lo: l.init.span.lo, ty: lty.clone() }),
            }
            let want: Option<ast::TypeKind> = Some(lty.clone());
            let t: ast::TypeKind = self.expr(cx, &l.init, &want, operand(mode), f - 1);
            if !self.deref_fix(&t, &lty, &l.init) {
                self.expect_ty(&t, &lty, l.init.span);
            }
            self.declare(cx, &l.name, lty, l.mutable, false);
        }

        #[summary("타입 없는 let (Rust의 습관, E0201): 타입을 미루어 고칠 글로 준다. 맨 정수 리터럴과 Vec::new()는 말하는 것이 적어 처음 쓰이는 자리에서 정한다 (settle_lets)")]
        #[effects(alloc)]
        fn let_untyped(self: &mut Body, cx: &mut FnCtx, l: &ast::Let, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            let t: ast::TypeKind = self.expr(cx, &l.init, &no, mode, f - 1);
            let vec_new: bool = vec_new_call(&l.init);
            if int_literal(&l.init) || vec_new {
                self.open_lets.push(OpenLet { name: l.name.clone(), vec_new: vec_new });
            }
            let msg: String = types::cat3("`let ", l.name.name.as_str(), "` requires an explicit type");
            if types::is_error(&t) {
                self.c.help("E0201", l.name.span, msg.as_str(), "add `: T` after the name");
            } else {
                let r: String = types::cat3(l.name.name.as_str(), ": ", types::text(&t).as_str());
                self.c.fixed("E0201", l.name.span, msg.as_str(), types::cat3("write `", r.as_str(), "`").as_str(), r.as_str());
            }
            self.declare(cx, &l.name, t, l.mutable, false);
        }

        #[summary("배열 리터럴이나 반복의 원소: 배열 타입의 원소 규칙 (백로그 1B-35, 2B-14, 2V-04b, 2V-22), 반복은 Copy까지. 원소가 못 되면 false: 리터럴이 보고된 타입을 가져, 감싼 리터럴이 다시 보고하지 않는다")]
        #[effects(alloc)]
        fn literal_elem(self: &mut Body, t: &ast::TypeKind, span: source::Span, repeat: bool) -> bool {
            if !types::array_elem_ok(t, 100000) {
                self.c.help("E0402", span, types::cat3("array elements are scalars, structs, enums, `Box`es or arrays, found `", types::text(t).as_str(), "`").as_str(), "an array element is a scalar, a struct or enum, a `Box` or a fixed-size array; for growable elements use `Vec<Vec<T>>`");
                return false;
            }
            if repeat {
                let moving: Vec<String> = self.c.moving_params();
                if types::is_move_in(t, &self.c.adts, moving.as_slice()) {
                    self.c.help("E0402", span, types::cat3("`[v; N]` copies `v`, and `", types::text(t).as_str(), "` moves").as_str(), "write the elements one by one: `[a, b, ..]`");
                }
            }
            true
        }

        #[summary("while이나 loop의 invariant와 decreases: invariant의 old(a)는 함수에 들어올 때의 a, decreases는 있어야 한다 (E0506, missing에). 밖의 입력이 끝을 정하는 nondet 함수의 loop는 없어도 된다 (ADR-0094)")]
        #[effects(alloc)]
        fn loop_clauses(self: &mut Body, cx: &mut FnCtx, invariants: &[ast::Expr], measure: &Option<ast::Expr>, missing: source::Span, kw: &str, f: usize) -> ()
            decreases f * 3 + 2,
        {
            if f == 0 {
                return;
            }
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            for i in 0..invariants.len()
                invariant 0 <= i && i <= invariants.len(),
            {
                let t: ast::TypeKind = self.expr(cx, &invariants[i], &wb, Mode::Spec(true), f - 1);
                self.expect_ty(&t, &ast::TypeKind::Bool, invariants[i].span);
            }
            match measure {
                None => { if kw == "loop" && cx.effect.nondet { return; } let msg: String = types::cat3("`", kw, "` has no `decreases` clause"); if kw == "loop" { self.c.help("E0506", missing, msg.as_str(), "add `decreases <expr>,` before the loop body; a loop that runs until outside input ends goes in a `nondet` function, where it may have none (its termination is then unproved, ADR-0094)"); } else { self.c.help("E0506", missing, msg.as_str(), "add `decreases <expr>,` before the loop body"); } },
                Some(d) => { let no: Option<ast::TypeKind> = None; let dt: ast::TypeKind = self.expr(cx, d, &no, Mode::Spec(false), f - 1); if !types::is_int(&dt) && !types::is_error(&dt) { self.c.err("E0401", d.span, types::cat3("`decreases` must be an integer, found `", types::text(&dt).as_str(), "`").as_str()); } },
            }
        }

        #[summary("loop { .. }: 값은 break들의 값, 없으면 끝나지 않는다. 기대한 타입을 알면 그것이 모든 break의 타입이다")]
        #[effects(alloc)]
        fn loop_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, lp: &ast::Loop, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if ghost_mode(mode) {
                self.ghost_loop(e.span);
            } else if !exec_mode(mode) {
                self.spec_loop(e.span);
            }
            let missing: source::Span = source::Span { file: e.span.file, lo: e.span.lo, hi: after4(e.span.lo) };
            let measure: Option<ast::Expr> = unboxed(&lp.measure);
            self.loop_clauses(cx, lp.invariants.as_slice(), &measure, missing, "loop", f - 1);
            let value: Option<ast::TypeKind> = match expected {
                None => None,
                Some(x) => { if types::is_error(x) || is_never(x) { None } else { Some(x.clone()) } },
            };
            cx.loops.push(LoopCx { label: label_name(&lp.label), is_loop: true, value: value });
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Unit);
            let bt: ast::TypeKind = self.block(cx, &lp.body, &wu, mode, f - 1);
            let lc: Option<LoopCx> = cx.loops.pop();
            self.expect_ty(&bt, &ast::TypeKind::Unit, lp.body.span);
            match lc {
                None => ast::TypeKind::Never,
                Some(l) => { match &l.value { None => ast::TypeKind::Never, Some(v) => v.clone(), } },
            }
        }

        #[summary("갈래 하나의 몸: 패턴의 이름을 새 범위에 넣고 몸을 본다. ty는 지금까지의 갈래들의 타입")]
        #[effects(alloc)]
        fn match_arm(self: &mut Body, cx: &mut FnCtx, a: &ast::Arm, binds: &[ast::TypeKind], ty: &Option<ast::TypeKind>, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> Option<ast::TypeKind>
            decreases f * 3,
        {
            if f == 0 {
                return ty.clone();
            }
            let scope: Vec<Local> = Vec::new();
            cx.scopes.push(scope);
            for pos in 0..a.pat.binds.len()
                invariant 0 <= pos && pos <= a.pat.binds.len(),
            {
                match &a.pat.binds[pos] {
                    None => {},
                    Some(id) => { let t: ast::TypeKind = if pos < binds.len() { binds[pos].clone() } else { ast::TypeKind::Error }; self.declare(cx, id, t, false, false); },
                }
            }
            let hint: Option<ast::TypeKind> = match ty {
                None => expected.clone(),
                Some(h) => { if types::is_error(h) || is_never(h) { expected.clone() } else { Some(h.clone()) } },
            };
            let bt: ast::TypeKind = self.expr(cx, &a.body, &hint, mode, f - 1);
            let mut out: Option<ast::TypeKind> = Some(bt.clone());
            match ty {
                None => {},
                Some(cur) => { let wider: bool = !exec_mode(mode) && !has_type(expected) && widens(cur, &bt); if !wider && !is_never(cur) { self.expect_ty(&bt, cur, a.body.span); out = Some(cur.clone()); } },
            }
            cx.scopes.pop();
            out
        }

        #[summary("갈래들이 변형을 덮는가: 변형마다 갈래 하나(E0426), 와일드카드 없이(E0224·E0225), 빠진 변형 없이, 선언 순서로")]
        #[effects(alloc)]
        fn match_cover(self: &mut Body, cx: &FnCtx, scrut: &ast::Expr, arms: &[ast::Arm], kinds: &[Option<usize>], tp: &str, vs: &[types::VariantSig], span: source::Span, wildcard: bool, unresolved: bool) -> () {
            let mut seen: Vec<usize> = Vec::new();
            let mut dup: bool = false;
            let mut prev: Option<usize> = None;
            let mut disorder: bool = false;
            let mut at: source::Span = span;
            for i in 0..arms.len()
                invariant 0 <= i && i <= arms.len(),
            {
                if i < kinds.len() {
                    match kinds[i] {
                        None => {},
                        Some(k) => { if has_usize(seen.as_slice(), k) { dup = true; if k < vs.len() { let vt: String = variant_text(tp, vs[k].name.as_str(), cx.mod_path.as_str()); self.c.help("E0426", arms[i].pat.span, types::cat3("a second arm for `", vt.as_str(), "`").as_str(), "one arm per variant: merge the two"); } } else { seen.push(k); } match prev { None => {}, Some(p) => { if p > k && !disorder { disorder = true; at = arms[i].pat.span; } }, } prev = Some(k); },
                    }
                }
            }
            let mut missing: Vec<String> = Vec::new();
            let mut order: Vec<String> = Vec::new();
            for j in 0..vs.len()
                invariant 0 <= j && j <= vs.len(),
            {
                let vt2: String = variant_text(tp, vs[j].name.as_str(), cx.mod_path.as_str());
                if !has_usize(seen.as_slice(), j) {
                    missing.push(variant_pat(vt2.as_str(), vs[j].tys.len()));
                }
                order.push(vt2);
            }
            self.wildcard_arms(cx, scrut, arms, kinds, tp, vs, span);
            if !wildcard && !unresolved && missing.len() > 0 {
                self.c.help("E0426", span, types::cat3("`match` misses `", types::join(missing.as_slice(), "`, `").as_str(), "`").as_str(), types::cat3("add an arm for each: `", types::join(missing.as_slice(), " => .., ").as_str(), " => ..`").as_str());
            }
            if !dup && disorder {
                self.c.help("E0426", at, "`match` arms are not in declaration order", types::cat2("order the arms as declared: ", types::join(order.as_slice(), ", ").as_str()).as_str());
            }
        }

        #[summary("match s { E::A => e0, E::B(x, _) => e1 }: 변형마다 갈래 하나를 선언 순서로, 페이로드 자리마다 새 이름이나 `_`, 갈래들은 한 타입 (ADR-0026 §3). 참조를 match하면 묶는 이름은 페이로드의 참조다 (ADR-0055)")]
        #[effects(alloc)]
        fn match_expr(self: &mut Body, cx: &mut FnCtx, scrut: &ast::Expr, arms: &[ast::Arm], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let st0: ast::TypeKind = match ref_of(scrut) {
                None => self.expr(cx, scrut, &no, operand(mode), f - 1),
                Some(x) => { let mutable: bool = ref_mutable(scrut); if mutable && ghost_mode(mode) { self.ghost_violation(scrut.span, "`&mut`", "match the value or `&` it: ghost code does not write"); } let t: ast::TypeKind = self.expr(cx, &x, &no, operand(mode), f - 1); let rt: ast::TypeKind = if types::is_error(&t) { ast::TypeKind::Error } else { ast::TypeKind::Ref(mutable, types::boxed(t.clone())) }; self.types.insert(span_key(scrut.span).as_str(), rt.clone()); rt },
            };
            let mut by_ref: bool = false;
            let mut by_mut: bool = false;
            let mut st: ast::TypeKind = st0.clone();
            match ref_inner(&st0) {
                None => {},
                Some(inner) => { if self.match_variants(&inner).found { by_ref = true; by_mut = types::is_ref_mut(&st0); st = inner.clone(); } },
            }
            if by_mut {
                let root: Option<String> = match ref_of(scrut) {
                    None => root_name(scrut, 1000000000),
                    Some(x2) => root_name(&x2, 1000000000),
                };
                match root {
                    None => {},
                    Some(r) => { for i in 0..arms.len() invariant 0 <= i && i <= arms.len(), { if mentions_strict(&arms[i].body, r.as_str(), 1000000000) { self.c.help("E0410", arms[i].body.span, types::cat3("`", r.as_str(), "` is used while the `match` borrows it").as_str(), "use the bindings of the arm instead"); } } },
                }
            }
            let mv: Variants = self.match_variants(&st);
            if !mv.found && !types::is_error(&st) {
                let msg: String = types::cat3("`match` needs an enum value, found `", types::text(&st).as_str(), "`");
                let through: Option<String> = match ref_inner(&st) {
                    None => None,
                    Some(inner2) => { if self.match_variants(&inner2).found { ast::var_name(scrut) } else { None } },
                };
                match through {
                    None => self.c.help("E0423", scrut.span, msg.as_str(), "branch with `if` on a condition"),
                    Some(v) => self.c.fixed("E0423", scrut.span, msg.as_str(), "match the value the reference points to", types::cat2("*", v.as_str()).as_str()),
                }
            }
            let mut kinds: Vec<Option<usize>> = Vec::new();
            let mut bind_tys: Vec<Vec<ast::TypeKind>> = Vec::new();
            let mut wildcard: bool = false;
            let mut unresolved: bool = false;
            for j in 0..arms.len()
                invariant 0 <= j && j <= arms.len() && kinds.len() == j && bind_tys.len() == j,
            {
                let mut k: Option<usize> = None;
                let mut tys: Vec<ast::TypeKind> = Vec::new();
                if !written(&arms[j].pat) || wild_name(&arms[j].pat) {
                    wildcard = true;
                } else if mv.found {
                    match self.arm_variant(cx, &arms[j].pat, mv.path.as_str(), mv.vs.as_slice(), &st) {
                        None => { unresolved = true; },
                        Some(kk) => { k = Some(kk); tys = self.arm_binds(cx.mod_path.as_str(), &arms[j].pat, mv.path.as_str(), mv.vs.as_slice(), kk, by_ref, by_mut); },
                    }
                }
                kinds.push(k);
                bind_tys.push(tys);
            }
            if mv.found {
                self.match_cover(cx, scrut, arms, kinds.as_slice(), mv.path.as_str(), mv.vs.as_slice(), span, wildcard, unresolved);
            }
            let mut first: usize = 0;
            if !has_type(expected) {
                let mut found: bool = false;
                for q in 0..arms.len()
                    invariant 0 <= q && q <= arms.len() && first <= q,
                {
                    if !found && !untyped_literal(&arms[q].body, 1000000000) {
                        found = true;
                        first = q;
                    }
                }
            }
            let mut ty: Option<ast::TypeKind> = match expected {
                None => None,
                Some(e) => { if types::is_error(e) { None } else { Some(e.clone()) } },
            };
            for step in 0..arms.len()
                invariant 0 <= step && step <= arms.len() && bind_tys.len() == arms.len(),
            {
                let at: usize = if step == 0 {
                    first
                } else if step - 1 < first {
                    step - 1
                } else {
                    step
                };
                if at < arms.len() {
                    ty = self.match_arm(cx, &arms[at], bind_tys[at].as_slice(), &ty, expected, mode, f - 1);
                }
            }
            match ty {
                None => ast::TypeKind::Error,
                Some(done) => done,
            }
        }

        #[summary("t 값의 match가 덮을 변형들 (선언 순서)")]
        #[effects(alloc)]
        fn match_variants(self: &Body, t: &ast::TypeKind) -> Variants {
            let path: String = match types::named_path(t) {
                None => { return no_variants(); },
                Some(p) => p,
            };
            let args: Vec<ast::TypeKind> = types::named_args(t);
            if named_one(t, "Option") && args.len() == 1 {
                let empty: Vec<ast::TypeKind> = Vec::new();
                return Variants { found: true, path: String::from("Option"), vs: two_variants("None", empty, "Some", one_type(&args[0])) };
            }
            if named_one(t, "Result") && args.len() == 2 {
                return Variants { found: true, path: String::from("Result"), vs: two_variants("Ok", one_type(&args[0]), "Err", one_type(&args[1])) };
            }
            let mut vs: Vec<types::VariantSig> = Vec::new();
            let at: usize = match self.c.adts.find(path.as_str()) {
                None => { return no_variants(); },
                Some(i) => i,
            };
            let m: types::Subst = types::adt_subst(&self.c.adts.items[at], t);
            let mut is_enum: bool = false;
            match &self.c.adts.items[at].kind {
                types::AdtKind::Struct(q4_fs) => {},
                types::AdtKind::Enum(xs) => { is_enum = true; for i2 in 0..xs.len() invariant 0 <= i2 && i2 <= xs.len(), { let mut tys: Vec<ast::TypeKind> = Vec::new(); for j in 0..xs[i2].tys.len() invariant 0 <= j && j <= xs[i2].tys.len(), { tys.push(types::subst(&xs[i2].tys[j], &m)); } vs.push(types::VariantSig { name: xs[i2].name.clone(), tys: tys }); } },
            }
            Variants { found: is_enum, path: self.c.adts.items[at].path.clone(), vs: vs }
        }

        #[summary("탈출이 있는 정의들(제 효과에 panic, ADR-0029)을 부르는 쪽으로, 그리고 그런 impl 함수가 있는 trait 메서드로 닫은 것. 이름의 순서로")]
        #[effects(alloc)]
        fn may_untrusted(self: &Body) -> Vec<String> {
            let mut out: Vec<String> = Vec::new();
            let total: usize = self.needs.len();
            for n in 0..total
                invariant 0 <= n && n <= total,
            {
                match self.needs.nth(n) {
                    None => {},
                    Some(at) => { if self.needs.items[at].own.panic { out.push(self.needs.key(n)); } },
                }
            }
            let callers: usize = self.calls.len();
            let mut grew: bool = true;
            let mut fuel: usize = 1000000000;
            while grew && fuel > 0
                invariant 0 <= fuel,
                decreases fuel,
            {
                fuel = fuel - 1;
                grew = false;
                for n in 0..callers
                    invariant 0 <= n && n <= callers,
                {
                    match self.calls.nth(n) {
                        None => {},
                        Some(at) => { let caller: String = self.calls.key(n); if !types::has(out.as_slice(), caller.as_str()) && any_in(self.calls.items[at].as_slice(), out.as_slice()) { out.push(caller.clone()); grew = true; } },
                    }
                }
                let mut more: Vec<String> = Vec::new();
                for i in 0..out.len()
                    invariant 0 <= i && i <= out.len(),
                {
                    match trait_decl_of(out[i].as_str()) {
                        None => {},
                        Some(decl) => { if !types::has(out.as_slice(), decl.as_str()) { types::add(&mut more, decl.as_str()); } },
                    }
                }
                for i in 0..more.len()
                    invariant 0 <= i && i <= more.len(),
                {
                    out.push(more[i].clone());
                    grew = true;
                }
            }
            decls::sorted(out.as_slice())
        }

        #[summary("decreases의 타입: 정수, 재귀 열거형, 또는 자기를 담는 구조체")]
        #[effects(alloc)]
        fn measure_type(self: &mut Body, t: &ast::TypeKind, span: source::Span) -> () {
            if types::is_int(t) || types::is_error(t) {
                return;
            }
            let outer: ast::TypeKind = match ref_inner(t) {
                None => t.clone(),
                Some(inner) => inner,
            };
            let v: ast::TypeKind = match box_inner(&outer) {
                None => outer.clone(),
                Some(boxed) => boxed,
            };
            let is_enum: bool = match types::named_path(&v) {
                None => false,
                Some(path) => path == "Option" || path == "Result" || self.enum_adt(path.as_str()),
            };
            let reaches: bool = self.reaches_itself(&v);
            if is_enum && reaches || self.struct_cycle(&v) {
                return;
            }
            let msg: String = types::cat3("`decreases` must be an integer, a recursive enum or a recursive struct, found `", types::text(t).as_str(), "`");
            if is_named(&v) && reaches {
                self.c.help("E0401", span, msg.as_str(), "decrease the enum-valued part that holds the recursion (a field such as `n.next`)");
            } else {
                self.c.help("E0401", span, msg.as_str(), "an integer, or a value of a recursive enum or of a struct that holds itself in a `Vec` (its structural size)");
            }
        }

        #[summary("std::mem::replace(&mut p, v) (p의 옛 값, p는 이제 v를 든다)와 std::mem::swap(&mut a, &mut b) (ADR-0047 §2): 쓸 수 있게 남는 자리에서 가진 값을 꺼내는 길")]
        #[effects(alloc)]
        fn mem_call(self: &mut Body, cx: &mut FnCtx, path: &[ast::Ident], args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 || path.len() != 3 {
                return ast::TypeKind::Error;
            }
            let full: String = types::cat3("`std::mem::", path[2].name.as_str(), "`");
            if !exec_mode(mode) && cx.ghost {
                self.ghost_violation(span, full.as_str(), "change the value outside the `proof` block");
            } else if !exec_mode(mode) {
                self.c.err("E0503", span, types::cat2(full.as_str(), " is not allowed in a specification").as_str());
            }
            if args.len() != 2 {
                self.c.err("E0405", span, decls::count1(types::cat2(full.as_str(), " takes 2 arguments, found ").as_str(), args.len()).as_str());
                return ast::TypeKind::Error;
            }
            let t: ast::TypeKind = self.mem_place(cx, &args[0], path[2].name.as_str(), mode, f - 1);
            if path[2].name == "replace" {
                let hint: Option<ast::TypeKind> = Some(t.clone());
                let vt: ast::TypeKind = self.expr(cx, &args[1], &hint, mode, f - 1);
                self.expect_ty(&vt, &t, args[1].span);
                return t;
            }
            let u: ast::TypeKind = self.mem_place(cx, &args[1], path[2].name.as_str(), mode, f - 1);
            self.expect_ty(&u, &t, args[1].span);
            match swap_root(&args[0]) {
                None => {},
                Some(r0) => { match swap_root(&args[1]) { None => {}, Some(r1) => { if r0 == r1 { self.c.help("E0410", args[1].span, types::cat3("both places of `std::mem::swap` are in `", r0.as_str(), "`").as_str(), "swap two different variables; for two elements of one `Vec` write a loop or two `std::mem::replace`s through a temporary"); } }, } },
            }
            ast::TypeKind::Unit
        }

        #[summary("std::mem의 자리 인자: &mut place, 또는 넘겨받은 &mut T 매개변수. 그 자리의 타입")]
        #[effects(alloc)]
        fn mem_place(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, op: &str, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            match ast::var_name(a) {
                None => {},
                Some(v) => { match lookup(cx, v.as_str()) { None => {}, Some(l) => { if types::is_ref_mut(&l.ty) { self.types.insert(span_key(a.span).as_str(), l.ty.clone()); return match ref_inner(&l.ty) { None => ast::TypeKind::Error, Some(inner) => inner, }; } }, } },
            }
            if !ref_mutable(a) {
                self.c.help("E0401", a.span, types::cat3("`std::mem::", op, "` takes a place as `&mut place`").as_str(), types::cat3("write `&mut ", fmt::expr_text(a).as_str(), "`").as_str());
                let no: Option<ast::TypeKind> = None;
                self.expr(cx, a, &no, mode, f - 1);
                return ast::TypeKind::Error;
            }
            let x: ast::Expr = match ref_of(a) {
                None => { return ast::TypeKind::Error; },
                Some(inner2) => inner2,
            };
            let t: ast::TypeKind = self.place(cx, &x, f - 1);
            self.types.insert(span_key(x.span).as_str(), t.clone());
            self.types.insert(span_key(a.span).as_str(), ast::TypeKind::Ref(true, types::boxed(t.clone())));
            t
        }

        #[summary("메서드 호출 x.f(..)의 타입. 쓴 사람의 함수면 경로 호출 T::f(adjust(x), ..)로 검사하고 그 길을 methods에 적는다 (ADR-0051); 아니면 내장 메서드. 글 리터럴 수신자는 표준 라이브러리의 글 함수에서만 &str이다 (ADR-0092 §2)")]
        #[effects(alloc)]
        fn method(self: &mut Body, cx: &mut FnCtx, recv: &ast::Expr, name: &ast::Ident, args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let lit: bool = is_str_lit(&recv.kind);
            let rt: ast::TypeKind = if lit {
                let t: ast::TypeKind = str_ref();
                self.types.insert(span_key(recv.span).as_str(), t.clone());
                t
            } else {
                self.expr(cx, recv, &no, mode, f - 1)
            };
            if types::is_error(&rt) {
                self.args_only(cx, args, mode, f);
                return ast::TypeKind::Error;
            }
            if name.name == "clone" && self.builtin_clone(&rt) {
                return self.clone_method(cx, &rt, name, args, span, mode, f);
            }
            let found: Found = self.method_target(cx, &rt, recv, name, args, span);
            match found {
                Found::No => {},
                Found::Reported => { self.args_only(cx, args, mode, f); return ast::TypeKind::Error; },
                Found::Target(target) => { let call: ast::Expr = method_call(recv, name, args, &target, span); self.methods.insert(span_key(span).as_str(), target); return self.expr(cx, &call, &no, mode, f - 1); },
            }
            if lit {
                self.expr(cx, recv, &no, mode, f - 1);
                self.args_only(cx, args, mode, f);
                return ast::TypeKind::Error;
            }
            if is_text(&rt) {
                return self.text_method(cx, recv, &rt, name, args, span, mode, f);
            }
            if is_char(&rt) {
                return self.char_method(cx, name, args, mode, f);
            }
            match vec_elem(&rt) {
                None => {},
                Some(et) => { return self.vec_method(cx, recv, &rt, &et, name, args, span, mode, f); },
            }
            let value: ast::TypeKind = match ref_inner(&rt) {
                None => rt.clone(),
                Some(inner) => inner,
            };
            let tp: String = match types::named_path(&value) {
                None => String::new(),
                Some(p) => p,
            };
            if (tp == "Option" || tp == "Result") && (name.name == "unwrap" || name.name == "expect") {
                self.args_only(cx, args, mode, f);
                let arms: String = if tp == "Option" {
                    String::from("None => .., Some(v) => v")
                } else {
                    String::from("Ok(v) => v, Err(e) => ..")
                };
                self.c.help("E0229", span, types::cat3("`.", name.name.as_str(), "()` is not allowed").as_str(), types::cat3("`match` both cases: `match x { ", arms.as_str(), " }`").as_str());
                return ast::TypeKind::Error;
            }
            if is_f64(&value) {
                return self.f64_method(cx, name, args, mode, f);
            }
            if name.name == "copy_within" {
                match elem_of(&rt) {
                    None => {},
                    Some(et) => { return self.copy_within(cx, recv, &rt, &et, name, args, span, mode, f); },
                }
            }
            self.int_method(cx, recv, &rt, name, args, mode, f)
        }

        #[summary("x.f(..)가 이름하는 쓴 사람의 함수 (ADR-0051): x의 타입(참조 하나 뒤)의 impl의 f, 없으면 표준 라이브러리의 글 함수, 없으면 타입 매개변수의 경계나 타입이 구현한 trait 가운데 f를 가진 단 하나. No는 이름하는 것이 없음(내장이거나 모르는 메서드), Reported는 여기서 알림 (E0313, E0314)")]
        #[effects(alloc)]
        fn method_target(self: &mut Body, cx: &FnCtx, rt: &ast::TypeKind, recv: &ast::Expr, name: &ast::Ident, args: &[ast::Expr], span: source::Span) -> Found {
            let value: ast::TypeKind = match ref_inner(rt) {
                None => rt.clone(),
                Some(inner) => inner,
            };
            let tp: String = match types::named_path(&value) {
                None => String::new(),
                Some(p) => p,
            };
            let user_type: bool = is_named(&value) && self.c.adts.has(tp.as_str());
            if user_type {
                match self.c.fns.find(types::cat3(tp.as_str(), "::", name.name.as_str()).as_str()) {
                    None => {},
                    Some(at) => { let sig: types::FnSig = self.c.fns.items[at].clone(); if no_text(&sig.trait_of) { return self.bind_method(cx, rt, &value, tp.as_str(), false, &sig, recv, name, args, span); } },
                }
            }
            if text_kind(&value) && !builtin_method_name(name.name.as_str()) {
                match self.c.fns.find(types::cat2("std::str::", name.name.as_str()).as_str()) {
                    None => {},
                    Some(at) => { if self.c.fns.items[at].generics.len() == 0 && self.c.fns.items[at].params.len() > 0 && is_text(&self.c.fns.items[at].params[0]) { let mut path: Vec<String> = Vec::new(); path.push(String::from("std")); path.push(String::from("str")); path.push(name.name.clone()); let adjust: ast::Adjust = if is_str(&value) { ast::Adjust::Value } else { ast::Adjust::AsStr }; let none: Vec<ast::TypeKind> = Vec::new(); return Found::Target(MethodTarget { path: path, type_args: none, adjust: adjust }); } },
                }
            }
            let mut traits: Vec<String> = Vec::new();
            let by_param: bool = types::is_param(&value);
            match types::param_name(&value) {
                None => { if !user_type && builtin_method_name(name.name.as_str()) { return Found::No; } if types::is_error(&value) || is_never(&value) { return Found::No; } for i in 0..self.c.trait_impls.len() invariant 0 <= i && i <= self.c.trait_impls.len(), { if impl_matches(&self.c.trait_impls[i], &value) { traits.push(self.c.trait_impls[i].trait_path.clone()); } } for j in 0..self.c.rejected_impls.len() invariant 0 <= j && j <= self.c.rejected_impls.len(), { if impl_matches(&self.c.rejected_impls[j], &value) { traits.push(self.c.rejected_impls[j].trait_path.clone()); } } },
                Some(p) => { for i in 0..self.c.tparams.len() invariant 0 <= i && i <= self.c.tparams.len(), { if self.c.tparams[i].name == p { for j in 0..self.c.tparams[i].bounds.len() invariant 0 <= j && j <= self.c.tparams[i].bounds.len(), { traits.push(self.c.tparams[i].bounds[j].clone()); } } } },
            }
            let mut having: Vec<String> = Vec::new();
            for i in 0..traits.len()
                invariant 0 <= i && i <= traits.len(),
            {
                match self.c.traits.find(traits[i].as_str()) {
                    None => {},
                    Some(at) => { if types::has(self.c.traits.items[at].methods.as_slice(), name.name.as_str()) { having.push(traits[i].clone()); } },
                }
            }
            let with: Vec<String> = sorted_set(having.as_slice());
            if with.len() == 0 {
                if user_type || by_param {
                    self.unknown_method(cx, &value, name, traits.as_slice());
                    return Found::Reported;
                }
                return Found::No;
            }
            if with.len() == 1 {
                return match self.c.fns.find(types::cat3(with[0].as_str(), "::", name.name.as_str()).as_str()) { None => Found::No, Some(at) => { let sig: types::FnSig = self.c.fns.items[at].clone(); self.bind_method(cx, rt, &value, with[0].as_str(), true, &sig, recv, name, args, span) }, };
            }
            let mut shown: Vec<String> = Vec::new();
            for i in 0..with.len()
                invariant 0 <= i && i <= with.len(),
            {
                shown.push(variant_text(with[i].as_str(), name.name.as_str(), cx.mod_path.as_str()));
            }
            let first: String = if shown.len() > 0 {
                shown[0].clone()
            } else {
                String::new()
            };
            self.c.help("E0313", name.span, types::cat7("`", name.name.as_str(), "` is a method of more than one trait of `", types::text_in(&value, cx.mod_path.as_str()).as_str(), "`: `", types::join(shown.as_slice(), "`, `").as_str(), "`").as_str(), types::cat3("call the one you mean by path: `", first.as_str(), "(..)`").as_str());
            Found::Reported
        }

        #[summary("언어가 짓지 않는 clone의 E0404 (ADR-0141 §2)")]
        #[effects(alloc)]
        fn no_clone(self: &mut Body, at: source::Span, t: &ast::TypeKind, why: &str) -> () {
            self.c.help("E0404", at, types::cat3("`clone` is not defined for `", types::text(t).as_str(), "`").as_str(), why);
        }

        #[summary("E0314: x.f(..)가 owner의 함수를 이름하지만 메서드로 부르지 않는다. 고침은 경로 호출. 수신자가 없는 함수(no_receiver)는 x를 받지 않고, 제 타입 매개변수가 있는 함수는 그것을 써서 부른다")]
        #[effects(alloc)]
        fn not_a_method(self: &mut Body, cx: &FnCtx, owner: &str, recv: &ast::Expr, name: &ast::Ident, args: &[ast::Expr], span: source::Span, no_receiver: bool, adjust: Option<ast::Adjust>) -> () {
            let callee: String = variant_text(owner, name.name.as_str(), cx.mod_path.as_str());
            let x: String = fmt::expr_text(recv);
            let mut all: Vec<String> = Vec::new();
            match adjust {
                None => {},
                Some(a) => { match a { ast::Adjust::Value => { all.push(x.clone()); }, ast::Adjust::Ref => { all.push(types::cat2("&", x.as_str())); }, ast::Adjust::RefMut => { all.push(types::cat2("&mut ", x.as_str())); }, ast::Adjust::AsStr => { all.push(types::cat2(x.as_str(), ".as_str()")); }, } },
            }
            for i in 0..args.len()
                invariant 0 <= i && i <= args.len(),
            {
                all.push(fmt::expr_text(&args[i]));
            }
            let list: String = types::join(all.as_slice(), ", ");
            if no_receiver {
                self.c.help("E0314", span, types::cat3("`", callee.as_str(), "` is not called as a method: it has no receiver").as_str(), types::cat5("call it by path: `", callee.as_str(), "(", list.as_str(), ")`").as_str());
            } else {
                self.c.help("E0314", span, types::cat3("`", callee.as_str(), "` is not called as a method: it has type parameters of its own").as_str(), types::cat5("call it by path: `", callee.as_str(), "::<..>(", list.as_str(), ")`").as_str());
            }
        }

        #[summary("old(x): ensures·루프 불변식·assert에서, &mut 매개변수 x에만")]
        #[effects(alloc)]
        fn old_expr(self: &mut Body, cx: &FnCtx, e: &ast::Expr, x: &ast::Expr, mode: Mode) -> ast::TypeKind {
            match ast::var_name(x) {
                None => {},
                Some(v) => { match lookup(cx, v.as_str()) { None => {}, Some(l) => { if spec_old(mode) && l.is_param && types::is_ref_mut(&l.ty) { return l.ty.clone(); } }, } },
            }
            if exec_mode(mode) {
                self.c.err("E0503", e.span, "`old(x)` is only allowed in `ensures`, loop invariants and `assert`, on a `&mut` parameter `x`");
            } else {
                self.c.err("E0508", e.span, "`old(x)` is only allowed in `ensures`, loop invariants and `assert`, on a `&mut` parameter `x`");
            }
            ast::TypeKind::Error
        }

        #[summary("타입 없는 let으로 아직 열려 있는 이름인가")]
        #[effects(pure)]
        fn open_let(self: &Body, name: &str) -> bool {
            for i in 0..self.open_lets.len()
                invariant 0 <= i && i <= self.open_lets.len(),
            {
                if self.open_lets[i].name.name == name {
                    return true;
                }
            }
            false
        }

        #[summary("인자 없이 쓴 경로: 정수와 f64의 상수, 인자 없는 함수 이름(E0301), 내장 변형, const, 그리고 페이로드 없는 변형")]
        #[effects(alloc)]
        fn path_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, path: &[ast::Ident], expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if int_const(path) && path.len() == 2 {
                match ast::int_of(path[0].name.as_str()) {
                    None => {},
                    Some(it) => { return ast::TypeKind::Int(it); },
                }
            }
            if f64_const(path) {
                return ast::TypeKind::F64;
            }
            if path.len() == 2 && path[0].name == "f64" {
                self.c.help("E0305", e.span, types::cat3("`f64` has no constant `", path[1].name.as_str(), "`").as_str(), "the `f64` constants are `f64::INFINITY`, `f64::NEG_INFINITY`, `f64::NAN`, `f64::MAX`, `f64::MIN`, `f64::MIN_POSITIVE`, `f64::EPSILON`");
                return ast::TypeKind::Error;
            }
            if path.len() == 2 && types::int_name(path[0].name.as_str()) {
                self.c.help("E0305", e.span, types::cat5("`", path[0].name.as_str(), "` has no constant `", path[1].name.as_str(), "`").as_str(), types::cat5("the integer constants are `", path[0].name.as_str(), "::MIN` and `", path[0].name.as_str(), "::MAX`").as_str());
                return ast::TypeKind::Error;
            }
            let lower: bool = path.len() > 0 && starts_lower(path[path.len() - 1].name.as_str());
            if lower || is_some(&self.resolve(path, cx.mod_path.as_str())) {
                self.c.err("E0301", e.span, "a path must be followed by call arguments");
                return ast::TypeKind::Error;
            }
            let noargs: Vec<ast::Expr> = Vec::new();
            if path.len() == 2 && builtin_path(path) {
                self.builtin_by_path(path);
                return self.builtin_variant(cx, path[1].name.as_str(), noargs.as_slice(), expected, e.span, mode, f);
            }
            let names: Vec<String> = names_of(path);
            match self.const_ref(cx.path.as_str(), names.as_slice(), cx.mod_path.as_str(), e.span) {
                None => {},
                Some(t) => { return t; },
            }
            self.variant_value(cx, path, noargs.as_slice(), expected, e.span, mode, f)
        }

        #[summary("Vec인 지역 변수 v의 v.as_slice() / v.as_mut_slice()를 조각의 참조로 읽는다")]
        #[effects(alloc)]
        fn peek_slice(self: &Body, cx: &FnCtx, m: &ast::Method) -> Option<ast::TypeKind> {
            let is_mut: bool = m.name.name == "as_mut_slice";
            if m.args.len() != 0 || !(is_mut || m.name.name == "as_slice") {
                return None;
            }
            match vec_var(cx, &*m.recv) {
                None => None,
                Some(l) => { match vec_elem(&l.ty) { None => None, Some(e) => Some(ast::TypeKind::Ref(is_mut, types::boxed(ast::TypeKind::Slice(types::boxed(e))))), } },
            }
        }

        #[summary("타입 매개변수가 없는 구조체의 리터럴 &Point { .. }는 제 타입을 이름한다")]
        #[effects(alloc)]
        fn peek_struct(self: &Body, cx: &FnCtx, path: &[ast::Ident]) -> Option<ast::TypeKind> {
            match self.c.type_path(path, cx.mod_path.as_str()) {
                None => None,
                Some(tp) => { match self.c.adts.find(tp.as_str()) { None => None, Some(at) => { if self.c.adts.items[at].generics.len() == 0 { let none: Vec<ast::Type> = Vec::new(); Some(ast::TypeKind::Named(refs::split_path(tp.as_str()), none)) } else { None } }, } },
            }
        }

        #[summary("대입의 대상을 검사하고 그 타입을 낸다")]
        #[effects(alloc)]
        fn place(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, f: usize) -> ast::TypeKind
            decreases f * 3 + 2,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            match &target.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Float(q4_ek_float0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::StrLit(q4_ek_strlit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::CharLit(q4_ek_charlit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Bool(q4_ek_bool0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Unit => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Var(id) => self.place_var(cx, target, id),
                ast::ExprKind::Call(q4_ek_call0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Method(q4_ek_method0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Index(base, index) => self.place_index(cx, target, &**base, &**index, f),
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::If(q4_ek_if0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Block(q4_ek_block0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Array(q4_ek_array0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Repeat(q4_ek_repeat0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Old(q4_ek_old0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Quant(q4_ek_quant0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Trigger(q4_ek_trigger0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Closure(q4_ek_closure0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::StructLit(q4_ek_structlit0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Path(q4_ek_path0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Deref(q4_ek_deref0) => self.place_path(cx, target, f),
                ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => self.place_path(cx, target, f),
                ast::ExprKind::Match(q4_ek_match0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Return(q4_ek_return0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Try(q4_ek_try0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Loop(q4_ek_loop0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Break(q4_ek_break0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Continue(q4_ek_continue0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Range(q4_ek_range0) => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
                ast::ExprKind::Error => { self.c.err("E0408", target.span, "invalid assignment target"); ast::TypeKind::Error },
            }
        }

        #[summary("원소에의 대입 base[index] = v. base가 필드·원소·`*`면 그 자리를 따라가고(s.w[i], g[i][j], (*b)[i]), 아니면 변수여야 한다")]
        #[effects(alloc)]
        fn place_index(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, base: &ast::Expr, index: &ast::Expr, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if nested_place(&base.kind) {
                let p: Place = self.place_of(cx, base, f - 1);
                self.types.insert(span_key(base.span).as_str(), p.ty.clone());
                self.index_usize(cx, index, f - 1);
                let bad: bool = types::is_error(&p.ty);
                let writable: bool = p.writable;
                let indexable: bool = has_type(&elem_of(&p.ty));
                let q: Place = self.elem_place(base.span, p);
                if !indexable {
                    return ast::TypeKind::Error;
                }
                if !writable && !bad {
                    self.c.help("E0408", target.span, "this place cannot be assigned", "assign through a `let mut` local or a `&mut` parameter");
                }
                return q.ty;
            }
            let id: String = match ast::var_name(base) {
                None => { self.c.err("E0408", target.span, "only elements of a variable, a field or an element can be assigned"); return ast::TypeKind::Error; },
                Some(n) => n,
            };
            let l: Local = match lookup(cx, id.as_str()) {
                None => { self.unknown_local(cx, id.as_str(), base.span); return ast::TypeKind::Error; },
                Some(found) => found,
            };
            let writable: bool = if is_array(&l.ty) || is_vec(&l.ty) {
                l.mutable
            } else {
                types::is_ref_mut(&l.ty)
            };
            self.index_usize(cx, index, f - 1);
            match elem_of(&l.ty) {
                None => { self.c.err("E0407", base.span, types::cat5("`", id.as_str(), "` has type `", types::text(&l.ty).as_str(), "` and cannot be indexed").as_str()); ast::TypeKind::Error },
                Some(elem) => { if !writable { self.c.err("E0408", target.span, types::cat5("elements of `", id.as_str(), "` cannot be assigned (`", types::text(&l.ty).as_str(), "`)").as_str()); } elem },
            }
        }

        #[summary("필드나 `*` 대상 아래의 자리의 타입과 쓸 수 있는가: let mut 지역 변수, &mut 매개변수, 쓸 수 있는 원소. 뒤 단계가 자리의 타입도 읽으므로 적어 둔다")]
        #[effects(alloc)]
        fn place_of(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, f: usize) -> Place
            decreases f * 3 + 1,
        {
            if f == 0 {
                return Place { ty: ast::TypeKind::Error, writable: false };
            }
            let p: Place = self.place_of_inner(cx, e, f);
            let key: String = span_key(e.span);
            if !self.types.has(key.as_str()) {
                self.types.insert(key.as_str(), p.ty.clone());
            }
            p
        }

        #[effects(alloc)]
        fn place_of_inner(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, f: usize) -> Place
            decreases f * 3,
        {
            if f == 0 {
                return Place { ty: ast::TypeKind::Error, writable: false };
            }
            match &e.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Float(q4_ek_float0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::StrLit(q4_ek_strlit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::CharLit(q4_ek_charlit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Bool(q4_ek_bool0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Unit => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Var(id) => self.var_place(cx, id),
                ast::ExprKind::Call(q4_ek_call0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Method(q4_ek_method0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Index(base, index) => { let p: Place = self.place_of(cx, &**base, f - 1); self.index_usize(cx, &**index, f - 1); self.elem_place(base.span, p) },
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::If(q4_ek_if0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Block(q4_ek_block0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Array(q4_ek_array0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Repeat(q4_ek_repeat0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Old(q4_ek_old0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Quant(q4_ek_quant0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Trigger(q4_ek_trigger0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Closure(q4_ek_closure0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::StructLit(q4_ek_structlit0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Path(q4_ek_path0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Deref(x) => { let p: Place = self.place_of(cx, &**x, f - 1); self.deref_place(e.span, p) },
                ast::ExprKind::Field(base, name) => { self.deref_field(e, &**base, name); let p: Place = self.place_of(cx, &**base, f - 1); Place { ty: self.field_type_of(&p.ty, name), writable: p.writable } },
                ast::ExprKind::Match(q4_ek_match0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Return(q4_ek_return0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Try(q4_ek_try0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Loop(q4_ek_loop0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Break(q4_ek_break0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Continue(q4_ek_continue0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Range(q4_ek_range0) => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
                ast::ExprKind::Error => { self.c.err("E0408", e.span, "invalid assignment target"); Place { ty: ast::TypeKind::Error, writable: false } },
            }
        }

        #[summary("필드나 `*`인 대입의 대상")]
        #[effects(alloc)]
        fn place_path(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let p: Place = self.place_of(cx, target, f - 1);
            if !p.writable && !types::is_error(&p.ty) {
                self.c.help("E0408", target.span, "this place cannot be assigned", "assign through a `let mut` local or a `&mut` parameter");
            }
            p.ty
        }

        #[summary("자리 x, x.f.g, *p의 타입을 지역 변수의 타입에서")]
        #[effects(alloc)]
        fn place_peek(self: &Body, cx: &FnCtx, e: &ast::Expr, f: usize) -> Option<ast::TypeKind>
            decreases f,
        {
            if f == 0 {
                return None;
            }
            match &e.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
                ast::ExprKind::Float(q4_ek_float0) => None,
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
                ast::ExprKind::StrLit(q4_ek_strlit0) => None,
                ast::ExprKind::CharLit(q4_ek_charlit0) => None,
                ast::ExprKind::Bool(q4_ek_bool0) => None,
                ast::ExprKind::Unit => None,
                ast::ExprKind::Var(id) => { match lookup(cx, id.name.as_str()) { None => None, Some(l) => Some(l.ty), } },
                ast::ExprKind::Call(q4_ek_call0) => None,
                ast::ExprKind::Method(q4_ek_method0) => None,
                ast::ExprKind::Index(x, q4_i) => { match self.place_peek(cx, &**x, f - 1) { None => None, Some(bt) => elem_of(&bt), } },
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
                ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
                ast::ExprKind::If(q4_ek_if0) => None,
                ast::ExprKind::Block(q4_ek_block0) => None,
                ast::ExprKind::Array(q4_ek_array0) => None,
                ast::ExprKind::Repeat(q4_ek_repeat0) => None,
                ast::ExprKind::Old(q4_ek_old0) => None,
                ast::ExprKind::Quant(q4_ek_quant0) => None,
                ast::ExprKind::Trigger(x) => self.place_peek(cx, &**x, f - 1),
                ast::ExprKind::Closure(q4_ek_closure0) => None,
                ast::ExprKind::StructLit(s) => self.peek_struct(cx, s.path.as_slice()),
                ast::ExprKind::Path(q4_ek_path0) => None,
                ast::ExprKind::Deref(x) => { match self.place_peek(cx, &**x, f - 1) { None => None, Some(bt) => pointee(&bt), } },
                ast::ExprKind::Field(x, name) => { match self.place_peek(cx, &**x, f - 1) { None => None, Some(bt) => { let fs: Fields = self.struct_fields(&bt); if fs.found { field_ty(fs.fields.as_slice(), name.name.as_str()) } else { None } }, } },
                ast::ExprKind::Match(q4_ek_match0) => None,
                ast::ExprKind::Return(q4_ek_return0) => None,
                ast::ExprKind::Try(q4_ek_try0) => None,
                ast::ExprKind::Loop(q4_ek_loop0) => None,
                ast::ExprKind::Break(q4_ek_break0) => None,
                ast::ExprKind::Continue(q4_ek_continue0) => None,
                ast::ExprKind::Range(q4_ek_range0) => None,
                ast::ExprKind::Error => None,
            }
        }

        #[summary("변수에의 대입: 바꿀 수 있는 지역 변수여야 한다 (E0408)")]
        #[effects(alloc)]
        fn place_var(self: &mut Body, cx: &mut FnCtx, target: &ast::Expr, id: &ast::Ident) -> ast::TypeKind {
            match lookup(cx, id.name.as_str()) {
                None => { self.unknown_local(cx, id.name.as_str(), id.span); ast::TypeKind::Error },
                Some(l) => { if !l.mutable { let msg: String = types::cat3("`", id.name.as_str(), "` is not mutable"); if l.is_param { self.c.help("E0408", target.span, msg.as_str(), "copy the parameter into a `let mut` local"); } else if types::has(cx.for_vars.as_slice(), id.name.as_str()) { self.c.help("E0408", target.span, msg.as_str(), "a `for` variable steps by itself; copy it into a `let mut` local to change the copy"); } else { self.c.help("E0408", target.span, msg.as_str(), "declare it with `let mut`"); } } l.ty },
            }
        }

        #[summary("타입 매개변수가 없는 함수인가")]
        #[effects(alloc)]
        fn plain_fn(self: &Body, path: &str) -> bool {
            match self.c.fns.find(path) {
                None => false,
                Some(at) => self.c.fns.items[at].generics.len() == 0,
            }
        }

        #[summary("proof { .. } (ADR-0062 §1): 실행 코드 안의 유령 문장. 그 let은 블록 안의 것이라 유령 값이 실행 코드에 닿지 않는다")]
        #[effects(alloc)]
        fn proof_stmt(self: &mut Body, cx: &mut FnCtx, p: &ast::ProofBlock, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            match mode {
                Mode::Exec => {},
                Mode::Spec(q4_old) => self.c.help("E0503", p.span, "a `proof` block is not allowed in a specification", "call lemmas from a `proof { .. }` block of executable code, or from a `proof fn`"),
                Mode::Ghost => self.ghost_violation(p.span, "a `proof` block", "this is ghost code already: write the statements without `proof { .. }`"),
            }
            let was: bool = cx.ghost;
            cx.ghost = true;
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Unit);
            let t: ast::TypeKind = self.block(cx, &p.body, &wu, Mode::Ghost, f - 1);
            cx.ghost = was;
            self.expect_ty(&t, &ast::TypeKind::Unit, p.body.span);
        }

        #[summary("forall과 exists (ADR-0079): 명세에서만, 묶는 변수는 정수, 몸은 bool. 트리거가 있어야 하고(E0511) 묶는 변수마다 트리거가 말해야 한다(E0512)")]
        #[effects(alloc)]
        fn quant_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, q: &ast::Quant, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let kw: String = quant_kw(&q.q);
            if exec_mode(mode) {
                self.c.help("E0503", e.span, types::cat3("`", kw.as_str(), "` is only allowed in specifications").as_str(), "state it in a `spec fn` used by a contract, or compute it in code with a loop");
                return ast::TypeKind::Error;
            }
            let scope: Vec<Local> = Vec::new();
            cx.scopes.push(scope);
            for i in 0..q.binders.len()
                invariant 0 <= i && i <= q.binders.len(),
            {
                if !types::is_int(&q.binders[i].ty.kind) && !types::is_error(&q.binders[i].ty.kind) {
                    self.c.help("E0402", q.binders[i].ty.span, types::cat3("`", kw.as_str(), "` binders must be integers").as_str(), "bind an integer index (e.g. `i: usize`) and reach the value through it");
                }
                self.declare(cx, &q.binders[i].name, q.binders[i].ty.kind.clone(), false, false);
            }
            let mut triggers: Vec<ast::Expr> = Vec::new();
            collect_triggers(&*q.body, &mut triggers, 1000000000);
            if triggers.len() == 0 {
                let first: Option<source::Span> = if q.binders.len() == 1 {
                    first_index_on(&*q.body, q.binders[0].name.name.as_str())
                } else {
                    None
                };
                let msg: String = types::cat3("`", kw.as_str(), "` has no `#[trigger]`");
                match first {
                    None => self.c.help("E0511", e.span, msg.as_str(), "mark a term that mentions every bound variable, e.g. `#[trigger] a[i]`"),
                    Some(at) => self.c.fixed("E0511", source::Span { file: at.file, lo: at.lo, hi: at.lo }, msg.as_str(), "mark the first term indexed by the bound variable", "#[trigger] "),
                }
            } else {
                for j in 0..q.binders.len()
                    invariant 0 <= j && j <= q.binders.len(),
                {
                    if !any_mentions(triggers.as_slice(), q.binders[j].name.name.as_str(), true, 1000000000) {
                        self.c.help("E0512", q.binders[j].name.span, types::cat3("no trigger mentions bound variable `", q.binders[j].name.name.as_str(), "`").as_str(), types::cat3("mark a term that mentions `", q.binders[j].name.name.as_str(), "` with `#[trigger]` as well (the triggers form one pattern)").as_str());
                    }
                }
            }
            if cx.forall_depth < 4294967295 {
                cx.forall_depth = cx.forall_depth + 1;
            }
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let t: ast::TypeKind = self.expr(cx, &*q.body, &wb, mode, f - 1);
            if cx.forall_depth > 0 {
                cx.forall_depth = cx.forall_depth - 1;
            }
            cx.scopes.pop();
            self.expect_ty(&t, &ast::TypeKind::Bool, q.body.span);
            ast::TypeKind::Bool
        }

        #[summary("범위 lo..hi는 식이 아니다: copy_within의 원본이나 &s[lo..hi]의 경계로만 쓴다 (E0435). lo..=hi는 파서가 보고했다 (E0438)")]
        #[effects(alloc)]
        fn range_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, r: &ast::Range, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            self.expr(cx, &*r.lo, &no, mode, f - 1);
            self.expr(cx, &*r.hi, &no, mode, f - 1);
            if r.inclusive {
                return ast::TypeKind::Error;
            }
            self.c.help("E0435", e.span, "a range `lo..hi` is only `copy_within`'s source or the bounds of `&s[lo..hi]` for a `&str` argument", "use a `for` loop over the range, or pass both bounds");
            ast::TypeKind::Error
        }

        #[summary("from에서 닿는 타입들 (from도)")]
        #[effects(alloc)]
        fn reachable(self: &Body, from: &ast::TypeKind) -> Vec<ast::TypeKind> {
            let mut seen: Vec<String> = Vec::new();
            let mut out: Vec<ast::TypeKind> = Vec::new();
            let mut todo: Vec<ast::TypeKind> = Vec::new();
            todo.push(from.clone());
            let mut fuel: usize = 1000000000;
            while todo.len() > 0 && fuel > 0
                decreases fuel,
            {
                fuel = fuel - 1;
                match todo.pop() {
                    None => {},
                    Some(c) => { if types::add(&mut seen, types::text(&c).as_str()) { let more: Vec<ast::TypeKind> = self.components(&c); push_all(&mut todo, more.as_slice()); out.push(c.clone()); } },
                }
            }
            out
        }

        #[summary("t가 자기 자신에 닿는가 (값이 담는 타입을 따라)")]
        #[effects(alloc)]
        fn reaches_itself(self: &Body, t: &ast::TypeKind) -> bool {
            let target: String = types::text(t);
            let mut seen: Vec<String> = Vec::new();
            let mut todo: Vec<ast::TypeKind> = self.components(t);
            let mut fuel: usize = 1000000000;
            while todo.len() > 0 && fuel > 0
                decreases fuel,
            {
                fuel = fuel - 1;
                match todo.pop() {
                    None => {},
                    Some(c) => { let k: String = types::text(&c); if k == target { return true; } if types::add(&mut seen, k.as_str()) { let more: Vec<ast::TypeKind> = self.components(&c); push_all(&mut todo, more.as_slice()); } },
                }
            }
            false
        }

        #[summary("t에서 닿는 타입(t도) 가운데 저를 담고 Vec이나 배열을 드는 것: 그 명세의 ==는 끝없는 깊이의 값을 원소마다 견줘야 해서 증명기의 ==가 펼 수 없다")]
        #[effects(alloc)]
        fn recursive_with_vec(self: &Body, t: &ast::TypeKind) -> Option<ast::TypeKind> {
            let all: Vec<ast::TypeKind> = self.reachable(t);
            for i in 0..all.len()
                invariant 0 <= i && i <= all.len(),
            {
                if is_named(&all[i]) && self.reaches_itself(&all[i]) {
                    let sub: Vec<ast::TypeKind> = self.reachable(&all[i]);
                    for j in 0..sub.len()
                        invariant 0 <= j && j <= sub.len(),
                    {
                        if is_vec(&sub[j]) || is_array(&sub[j]) {
                            return Some(all[i].clone());
                        }
                    }
                }
            }
            None
        }

        #[summary("참조 매개변수(안의 타입 inner, pm이면 &mut)의 인자를 검사하고, 출발하는 변수의 이름을 돌려준다")]
        #[effects(alloc)]
        fn ref_arg(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, pm: bool, inner: &ast::TypeKind, mode: Mode, f: usize) -> Option<String>
            decreases f * 3 + 1,
        {
            if f == 0 {
                return None;
            }
            let no: Option<ast::TypeKind> = None;
            if ty_has_error(inner, 1000000000) {
                return None;
            }
            let m: String = if pm {
                String::from("mut ")
            } else {
                String::new()
            };
            let want: String = types::cat3("&", m.as_str(), types::text(inner).as_str());
            if is_str(inner) {
                self.text_arg(cx, a, mode, f);
                return None;
            }
            let pe: ast::TypeKind = match slice_elem(inner) {
                None => { return self.data_ref_arg(cx, a, pm, inner, want.as_str(), mode, f); },
                Some(e) => e,
            };
            let bytes: bool = types::same(&pe, &ast::TypeKind::Int(ast::IntTy::U8));
            let sv: VecSlice = self.slice_of_vec(cx, a, pm, &pe, want.as_str(), mode, f);
            if sv.about {
                return sv.root;
            }
            let key: String = span_key(a.span);
            match as_bytes_of(a) {
                None => {},
                Some(recv) => { if !self.as_bytes_arg(cx, a, &recv, mode, f) { self.c.err("E0404", a.span, "`as_bytes` is defined for `String` and `&str`"); } else if pm || !bytes { self.c.err("E0401", a.span, types::cat3("expected `", want.as_str(), "`, found the bytes of a string (`&[u8]`, read-only)").as_str()); } return None; },
            }
            match str_lit_of(a) {
                None => {},
                Some(text) => { self.types.insert(key.as_str(), str_ref()); let msg: String = types::cat3("expected `", want.as_str(), "`, found a string literal (`&str`)"); if !pm && bytes { self.c.fixed("E0401", a.span, msg.as_str(), "write a byte string `b\"...\"`", lexer::byte_text(text.as_bytes(), 34).as_str()); } else { self.c.err("E0401", a.span, msg.as_str()); } return None; },
            }
            if is_byte_str(&a.kind) {
                self.types.insert(key.as_str(), bytes_ref());
                if pm || !bytes {
                    self.c.err("E0401", a.span, types::cat3("expected `", want.as_str(), "`, found a byte string (`&[u8]`, read-only)").as_str());
                }
                return None;
            }
            match slice_of(a) {
                None => {},
                Some(s) => { self.sub_slice_arg(cx, a, &s.base, &s.lo, &s.hi, pm, &pe, want.as_str(), mode, f); return None; },
            }
            let mut explicit_ref: bool = false;
            let mut am: bool = false;
            let place: ast::Expr = match ref_of(a) {
                None => a.clone(),
                Some(x) => { explicit_ref = true; am = ref_mutable(a); x },
            };
            let var: String = match ast::var_name(&place) {
                None => { if explicit_ref { if index_range(&place) { self.c.help("E0409", a.span, "a part of a slice is passed read-only", "pass `&mut v` and the bounds; `&v[lo..hi]` is a shared slice"); } else { self.c.help("E0409", a.span, types::cat3("expected `", want.as_str(), "` of a variable").as_str(), "pass a variable's slice (`&v`, `v.as_slice()`), a part of one (`&v[lo..hi]`) or the bytes of text (`s.as_bytes()`)"); } return None; } let t: ast::TypeKind = self.expr(cx, a, &no, mode, f - 1); match old_var(a) { None => {}, Some(n) => { match ref_inner(&t) { None => {}, Some(ri) => { if !pm && types::same(&ri, inner) { return Some(n); } }, } }, } if !types::is_error(&t) { self.c.err("E0401", a.span, types::cat5("expected `", want.as_str(), "`, found `", types::text(&t).as_str(), "`").as_str()); } return None; },
                Some(n) => n,
            };
            let l: Local = match lookup(cx, var.as_str()) {
                None => { self.unknown_local(cx, var.as_str(), place.span); return None; },
                Some(local) => local,
            };
            let mut ok: bool = false;
            if explicit_ref {
                match array_elem(&l.ty) {
                    None => {},
                    Some(e) => { if types::same(&e, &pe) { if am && !l.mutable { self.c.help("E0408", a.span, types::cat3("`", var.as_str(), "` is not mutable").as_str(), "declare it with `let mut`"); return None; } ok = am == pm; } },
                }
            } else {
                match ref_inner(&l.ty) {
                    None => {},
                    Some(li) => { ok = types::same(&li, inner) && (types::is_ref_mut(&l.ty) || !pm); },
                }
            }
            if !ok {
                let lt: String = types::text(&l.ty);
                let found: String = if explicit_ref {
                    if am {
                        types::cat2("&mut ", lt.as_str())
                    } else {
                        types::cat2("&", lt.as_str())
                    }
                } else {
                    lt
                };
                let msg: String = types::cat5("expected `", want.as_str(), "`, found `", found.as_str(), "`");
                if !explicit_ref && is_array(&l.ty) {
                    let r: String = types::cat3("&", m.as_str(), var.as_str());
                    self.c.fixed("E0401", a.span, msg.as_str(), types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str());
                } else {
                    self.c.err("E0401", a.span, msg.as_str());
                }
                return None;
            }
            Some(var)
        }

        #[summary("[v; N]: v는 배열의 원소가 될 수 있고 Copy다. N은 u32에 든다")]
        #[effects(alloc)]
        fn repeat_expr(self: &mut Body, cx: &mut FnCtx, rp: &ast::Repeat, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let want: Option<ast::TypeKind> = want_elem(expected);
            let t: ast::TypeKind = self.expr(cx, &*rp.value, &want, mode, f - 1);
            let ok: bool = self.literal_elem(&t, rp.value.span, true);
            if rp.count.hi != 0 || rp.count.lo > 4294967295 {
                self.c.err("E0406", rp.count_span, "array length is too large");
            }
            if !ok {
                return ast::TypeKind::Error;
            }
            ast::TypeKind::Array(types::boxed(t), rp.count.lo)
        }

        #[summary("호출의 경로가 가리키는 함수: 이 단위의 타입이나 trait의 함수 `T::f`, 이 단위의 함수나 내장 함수 `f`, 온 경로")]
        #[effects(alloc)]
        fn resolve(self: &Body, path: &[ast::Ident], mp: &str) -> Option<String> {
            if path.len() == 2 {
                let owner: String = types::cat3(mp, "::", path[0].name.as_str());
                if self.c.adts.has(owner.as_str()) || self.c.traits.has(owner.as_str()) {
                    let full: String = types::cat3(owner.as_str(), "::", path[1].name.as_str());
                    if self.c.fns.has(full.as_str()) {
                        return Some(full);
                    }
                }
            }
            if path.len() == 1 {
                let local: String = types::cat3(mp, "::", path[0].name.as_str());
                if self.c.fns.has(local.as_str()) {
                    return Some(local);
                }
                match self.c.fns.find(path[0].name.as_str()) {
                    None => {},
                    Some(i) => { if self.c.fns.items[i].builtin { return Some(path[0].name.clone()); } },
                }
                return None;
            }
            let mut p: String = String::new();
            for i in 0..path.len()
                invariant 0 <= i && i <= path.len(),
            {
                if i > 0 {
                    p.push_str("::");
                }
                p.push_str(path[i].name.as_str());
            }
            if self.c.fns.has(p.as_str()) {
                return Some(p);
            }
            None
        }

        #[summary("return과 return 값: 값은 함수가 내는 타입이다. 명세에는 없다 (E0503)")]
        #[effects(alloc)]
        fn return_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, x: &Option<Box<ast::Expr>>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if !exec_mode(mode) {
                self.c.help("E0503", e.span, "`return` is not allowed in a specification", "a specification is one expression: put the value in the branch (`if c { a } else { b }`)");
            }
            let want: ast::TypeKind = cx.ret.clone();
            let wt: String = types::text(&want);
            match x {
                None => { if !decls::is_unit(&want) && !types::is_error(&want) { self.c.help("E0401", e.span, types::cat3("expected `", wt.as_str(), "`, found `()`").as_str(), types::cat3("the function returns `", wt.as_str(), "`: write `return <value>`").as_str()); } },
                Some(v) => { let hint: Option<ast::TypeKind> = Some(want.clone()); let t: ast::TypeKind = self.expr(cx, &**v, &hint, mode, f - 1); if !self.deref_fix(&t, &want, &**v) && !types::same(&t, &want) && !types::is_error(&t) && !is_never(&t) && !types::is_error(&want) { self.c.help("E0401", v.span, types::cat5("expected `", wt.as_str(), "`, found `", types::text(&t).as_str(), "`").as_str(), types::cat3("the function returns `", wt.as_str(), "`: return a value of that type").as_str()); } },
            }
            ast::TypeKind::Never
        }

        #[summary("타입 없는 let의 E0201을 고친다 (백로그 2N-12): 타입은 그 변수가 뒤에서 처음 쓰이는 자리에서 온다. 산술·비교·비트 연산의 다른 쪽(리터럴이 아닌 것), 색인(usize), 함수의 인자(매개변수의 타입), Vec이면 첫 push(원소의 타입). 그런 자리가 없으면 초기값의 타입을 둔다")]
        #[effects(alloc)]
        fn settle_lets(self: &mut Body, d: &ast::FnDef, mp: &str) -> () {
            let open: Vec<OpenLet> = self.open_lets.clone();
            self.open_lets = Vec::new();
            let typed: Vec<TypedUse> = self.typed_uses.clone();
            self.typed_uses = Vec::new();
            let spec_at: Vec<source::Span> = self.spec_at.clone();
            self.spec_at = Vec::new();
            if open.len() == 0 {
                return;
            }
            let mut body: ast::FnDef = d.clone();
            for o in 0..open.len()
                invariant 0 <= o && o <= open.len(),
            {
                let facts: Vec<Fact> = Vec::new();
                let calls: Vec<CallUse> = Vec::new();
                let mut uses: Uses = Uses { name: open[o].name.name.clone(), after: open[o].name.span.hi, vec_new: open[o].vec_new, spec_at: spec_at.clone(), facts: facts, calls: calls };
                ast::fn_exprs_mut::<Uses>(&mut body, &mut uses, true, 1000000000);
                let mut best: Best = Best { found: false, lo: 0, ty: ast::TypeKind::Error };
                for i in 0..uses.facts.len()
                    invariant 0 <= i && i <= uses.facts.len(),
                {
                    if uses.facts[i].kind == 0 {
                        if !uses.facts[i].literal {
                            match self.types.find(span_key(uses.facts[i].other).as_str()) {
                                None => {},
                                Some(at) => { if types::is_int(&self.types.items[at]) { better(&mut best, uses.facts[i].lo, &self.types.items[at]); } },
                            }
                        }
                    } else if uses.facts[i].kind == 1 {
                        better(&mut best, uses.facts[i].lo, &ast::TypeKind::Int(ast::IntTy::Usize));
                    } else {
                        match self.types.find(span_key(uses.facts[i].other).as_str()) {
                            None => {},
                            Some(at) => { let v: ast::TypeKind = ast::TypeKind::Vec(Box::new(ast::Type { kind: self.types.items[at].clone(), span: uses.facts[i].other })); better(&mut best, uses.facts[i].lo, &v); },
                        }
                    }
                }
                for i in 0..typed.len()
                    invariant 0 <= i && i <= typed.len(),
                {
                    if typed[i].name == open[o].name.name && typed[i].lo > open[o].name.span.hi && fits_let(&typed[i].ty, open[o].vec_new) {
                        better(&mut best, typed[i].lo, &typed[i].ty);
                    }
                }
                for i in 0..uses.calls.len()
                    invariant 0 <= i && i <= uses.calls.len(),
                {
                    match self.resolve(uses.calls[i].path.as_slice(), mp) {
                        None => {},
                        Some(p) => { match self.c.fns.find(p.as_str()) { None => {}, Some(at) => { let k: usize = uses.calls[i].k; if k < self.c.fns.items[at].params.len() && fits_let(&self.c.fns.items[at].params[k], open[o].vec_new) { better(&mut best, uses.calls[i].lo, &self.c.fns.items[at].params[k]); } }, } },
                    }
                }
                if best.found {
                    let r: String = types::cat3(open[o].name.name.as_str(), ": ", types::text(&best.ty).as_str());
                    settle_diag(&mut self.c.diags, &open[o].name, r.as_str());
                }
            }
        }

        #[summary("공유 참조 수신자(x: &T)로 self: &mut T 메서드를 부르면 E0401: 참조는 그대로 넘기므로(한 걸음, ADR-0051) &를 지나 쓰게 된다. 알렸는가")]
        #[effects(alloc)]
        fn shared_receiver(self: &mut Body, cx: &FnCtx, rt: &ast::TypeKind, sig: &types::FnSig, owner: &str, recv: &ast::Expr, name: &ast::Ident) -> bool {
            let shared: bool = is_ref(rt) && !types::is_ref_mut(rt);
            let wants_mut: bool = sig.params.len() > 0 && types::is_ref_mut(&sig.params[0]);
            if !(shared && wants_mut) {
                return false;
            }
            let callee: String = variant_text(owner, name.name.as_str(), cx.mod_path.as_str());
            let inner: ast::TypeKind = match ref_inner(rt) {
                None => rt.clone(),
                Some(under) => under,
            };
            self.c.help("E0401", recv.span, types::cat5("`", callee.as_str(), "` takes `self: &mut`, found the shared reference `", types::text_in(rt, cx.mod_path.as_str()).as_str(), "`").as_str(), types::cat5("pass a `&mut ", types::text_in(&inner, cx.mod_path.as_str()).as_str(), "` receiver: declare `", fmt::expr_text(recv).as_str(), "` with that type").as_str());
            true
        }

        #[summary("a << s, a >> s (ADR-0048 §2): a는 정수, 양 s도 어느 정수 타입이든 (리터럴 양은 u32). 값은 a의 타입. 양의 범위는 증명 의무다 (E0803)")]
        #[effects(alloc)]
        fn shift(self: &mut Body, cx: &mut FnCtx, op: ast::BinOp, l: &ast::Expr, r: &ast::Expr, expected: &Option<ast::TypeKind>, mode: Mode, span: source::Span, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let lh: Option<ast::TypeKind> = match expected {
                None => None,
                Some(x) => { if types::is_int(x) { Some(x.clone()) } else { None } },
            };
            let lt: ast::TypeKind = self.expr(cx, l, &lh, mode, f - 1);
            let rh: Option<ast::TypeKind> = if untyped_literal(r, 1000000000) {
                Some(ast::TypeKind::Int(ast::IntTy::U32))
            } else {
                None
            };
            let rt: ast::TypeKind = self.expr(cx, r, &rh, mode, f - 1);
            if types::is_error(&lt) || types::is_error(&rt) {
                return ast::TypeKind::Error;
            }
            if !types::is_int(&lt) {
                self.c.help("E0401", span, types::cat5("`", op_symbol(op).as_str(), "` is not defined for `", types::text(&lt).as_str(), "`").as_str(), "only integers shift");
                return ast::TypeKind::Error;
            }
            if !types::is_int(&rt) {
                self.c.help("E0401", r.span, types::cat3("a shift amount is an integer, found `", types::text(&rt).as_str(), "`").as_str(), "shift by an integer of any type: `x << k` with `k: u32`");
                return ast::TypeKind::Error;
            }
            lt
        }

        #[summary("Vec으로 만든 &[T] / &mut [T] 인자 (ADR-0031 §1): v.as_slice(), v.as_mut_slice(), 그리고 Rust의 버릇인 &v, &mut v, 넘겨받은 &Vec<T> (E0218). about이 거짓이면 Vec에 관한 인자가 아니고, 참이면 root가 ref_arg의 결과다")]
        #[effects(alloc)]
        fn slice_of_vec(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, pm: bool, pe: &ast::TypeKind, want: &str, mode: Mode, f: usize) -> VecSlice
            decreases f * 3,
        {
            let none: Option<String> = None;
            if f == 0 {
                return VecSlice { about: false, root: none };
            }
            let no: Option<ast::TypeKind> = None;
            let want_m: String = if pm {
                String::from("as_mut_slice")
            } else {
                String::from("as_slice")
            };
            match method_of(a) {
                None => {},
                Some(mc) => { if mc.name.name == "as_slice" || mc.name.name == "as_mut_slice" { let rt: ast::TypeKind = self.expr(cx, &*mc.recv, &no, mode, f - 1); let et: ast::TypeKind = match vec_elem(&rt) { None => { if !types::is_error(&rt) { self.c.err("E0404", mc.name.span, types::cat5("`", mc.name.name.as_str(), "` is not defined for `", types::text(&rt).as_str(), "`").as_str()); } return VecSlice { about: true, root: none }; }, Some(e) => e, }; if mc.args.len() != 0 { self.c.err("E0405", mc.name.span, types::cat3("`", mc.name.name.as_str(), "` takes no arguments").as_str()); } let is_mut: bool = mc.name.name == "as_mut_slice"; let st: ast::TypeKind = ast::TypeKind::Ref(is_mut, types::boxed(ast::TypeKind::Slice(types::boxed(et.clone())))); let found: String = types::text(&st); self.types.insert(span_key(a.span).as_str(), st); if !types::same(&et, pe) || is_mut != pm { let r: String = types::cat4(fmt::expr_text(&*mc.recv).as_str(), ".", want_m.as_str(), "()"); let msg: String = types::cat5("expected `", want, "`, found `", found.as_str(), "`"); if types::same(&et, pe) { self.c.fixed("E0401", a.span, msg.as_str(), types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str()); } else { self.c.err("E0401", a.span, msg.as_str()); } return VecSlice { about: true, root: none }; } if !pm || !exec_mode(mode) { return VecSlice { about: true, root: none }; } let can_write: bool = match vec_var(cx, &*mc.recv) { None => false, Some(l) => { if is_ref(&l.ty) { types::is_ref_mut(&l.ty) } else { l.mutable } }, }; if !can_write { self.c.help("E0408", mc.recv.span, "`.as_mut_slice()` needs a mutable `Vec`", "declare it with `let mut` or take `&mut Vec<T>`"); return VecSlice { about: true, root: none }; } return VecSlice { about: true, root: root_name(&*mc.recv, 1000000000) }; } },
            }
            let under: Option<ast::Expr> = match ref_of(a) {
                None => old_of(a),
                Some(x) => Some(x),
            };
            match under {
                None => {},
                Some(x) => { if has_vec_var(cx, &x) { self.e0218(cx, a, &x, want_m.as_str(), mode, f - 1); return VecSlice { about: true, root: none }; } return VecSlice { about: false, root: none }; },
            }
            if has_vec_var(cx, a) {
                self.e0218(cx, a, a, want_m.as_str(), mode, f - 1);
                return VecSlice { about: true, root: none };
            }
            VecSlice { about: false, root: none }
        }

        #[summary("check_slots의 한 자리의 값을 본다: 인자 at, 또는 필드 at의 값")]
        #[effects(alloc)]
        fn slot_expr(self: &mut Body, cx: &mut FnCtx, args: &[ast::Expr], fields: &[ast::FieldInit], by_field: bool, at: usize, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if by_field {
                if at < fields.len() {
                    return self.expr(cx, &fields[at].value, expected, mode, f - 1);
                }
            } else {
                if at < args.len() {
                    return self.expr(cx, &args[at], expected, mode, f - 1);
                }
            }
            ast::TypeKind::Error
        }

        #[summary("E0503: 명세는 식 하나이고 루프가 없다")]
        #[effects(alloc)]
        fn spec_loop(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0503", span, "loops are not allowed in a specification", "state the property with `forall`, or with a recursive spec fn and `decreases`");
        }

        #[summary("E0402: 명세는 String을 그 &str로 본다 (ADR-0050 §3)")]
        #[effects(alloc)]
        fn spec_string(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0402", span, "a spec function cannot take or return a `String`", "take `&str` and pass `s.as_str()`");
        }

        #[summary("E0402: 명세는 Vec을 조각으로 본다 (ADR-0031 §3)")]
        #[effects(alloc)]
        fn spec_vec(self: &mut Body, span: source::Span) -> () {
            self.c.help("E0402", span, "a spec function cannot take or return a `Vec`", "take `&[T]` and pass `v.as_slice()`");
        }

        #[summary("문장 하나")]
        #[effects(alloc)]
        fn stmt(self: &mut Body, cx: &mut FnCtx, s: &ast::Stmt, mode: Mode, f: usize) -> ()
            decreases f * 3 + 1,
        {
            if f == 0 {
                return;
            }
            match s {
                ast::Stmt::Let(sl) => { if sl.ty_missing { self.let_untyped(cx, sl, mode, f); } else { self.let_typed(cx, sl, mode, f); } },
                ast::Stmt::Assign(sa) => self.assign_stmt(cx, sa, mode, f),
                ast::Stmt::While(sw) => self.while_stmt(cx, sw, mode, f),
                ast::Stmt::For(sf) => self.for_stmt(cx, sf, mode, f),
                ast::Stmt::Assert(sc) => self.assert_stmt(cx, sc, mode, f),
                ast::Stmt::Assume(su) => self.assume_stmt(cx, su, mode, f),
                ast::Stmt::Proof(sp) => self.proof_stmt(cx, sp, mode, f),
                ast::Stmt::LetFields(sd) => self.let_fields(cx, sd, mode, f),
                ast::Stmt::Expr(se) => { let no: Option<ast::TypeKind> = None; let unused: ast::TypeKind = self.expr(cx, se, &no, mode, f - 1); },
            }
        }

        #[summary("문자열 리터럴은 &str, 곧 참조다: 호출의 인자로만 쓴다 (E0409, ADR-0015, ADR-0050 §1)")]
        #[effects(alloc)]
        fn str_lit(self: &mut Body, s: &str, span: source::Span) -> ast::TypeKind {
            self.c.fixed("E0409", span, "a string literal may only appear directly as a call argument", "pass it to a `&str` parameter, or own it: `String::from(\"..\")`", types::cat3("String::from(", lexer::str_text(s, 34).as_str(), ")").as_str());
            ast::TypeKind::Error
        }

        #[summary("구조체 값 t가 구조체만을 지나(필드, Vec, 배열, Box) 자기를 담는가 (ADR-0047 §3)")]
        #[effects(alloc)]
        fn struct_cycle(self: &Body, t: &ast::TypeKind) -> bool {
            let v: ast::TypeKind = match ref_inner(t) {
                None => t.clone(),
                Some(inner) => inner,
            };
            let target: String = types::text(&v);
            let mut seen: Vec<String> = Vec::new();
            let mut todo: Vec<ast::TypeKind> = self.struct_parts(&v);
            let mut fuel: usize = 1000000000;
            while todo.len() > 0 && fuel > 0
                decreases fuel,
            {
                fuel = fuel - 1;
                match todo.pop() {
                    None => {},
                    Some(c) => { let k: String = types::text(&c); if k == target { return true; } if types::add(&mut seen, k.as_str()) { let more: Vec<ast::TypeKind> = self.struct_parts(&c); push_all(&mut todo, more.as_slice()); } },
                }
            }
            false
        }

        #[summary("구조체 리터럴 식: 자식 구조체는 손으로 짓지 않고, 재귀 구조체의 값은 명세에서 짓지 않는다 (E0432, ADR-0047 §3)")]
        #[effects(alloc)]
        fn struct_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, sl: &ast::StructLit, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            let t: ast::TypeKind = self.struct_lit(cx, sl, expected, e.span, mode, f);
            if is_child(&t) {
                self.child_by_hand(e.span);
                return ast::TypeKind::Error;
            }
            if !exec_mode(mode) && self.struct_cycle(&t) {
                self.c.help("E0432", e.span, types::cat3("a value of the recursive struct `", types::text(&t).as_str(), "` is built in a specification").as_str(), "state its fields instead (`r.v == x && r.kids.len() == 0`)");
            }
            t
        }

        #[summary("타입 t가 가리키는 구조체의 경로와 필드 (참조 하나와 Box들을 지나: p: &Point나 p: &Box<Point>의 p.x). 구조체가 아니면 found가 거짓")]
        #[effects(alloc)]
        fn struct_fields(self: &Body, t: &ast::TypeKind) -> Fields {
            let mut out: Vec<types::FieldSig> = Vec::new();
            let mut cur: ast::TypeKind = match ref_inner(t) {
                None => t.clone(),
                Some(inner) => inner,
            };
            let mut more: bool = true;
            let mut fuel: usize = 1000000000;
            while more && fuel > 0
                decreases fuel,
            {
                match box_inner(&cur) {
                    None => { more = false; },
                    Some(inner) => { cur = inner; },
                }
                fuel = fuel - 1;
            }
            let path: String = match types::named_path(&cur) {
                None => { return Fields { found: false, path: String::new(), fields: out }; },
                Some(p) => p,
            };
            let at: usize = match self.c.adts.find(path.as_str()) {
                None => { return Fields { found: false, path: String::new(), fields: out }; },
                Some(i) => i,
            };
            let m: types::Subst = types::adt_subst(&self.c.adts.items[at], &cur);
            let mut is_struct: bool = false;
            match &self.c.adts.items[at].kind {
                types::AdtKind::Struct(fs) => { is_struct = true; for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { out.push(types::FieldSig { name: fs[i].name.clone(), ty: types::subst(&fs[i].ty, &m) }); } },
                types::AdtKind::Enum(q4_vs) => {},
            }
            Fields { found: is_struct, path: self.c.adts.items[at].path.clone(), fields: out }
        }

        #[summary("t가 구조체면 그 필드 (참조나 Box를 지나지 않는다)")]
        #[effects(alloc)]
        fn struct_fields_of(self: &Body, t: &ast::TypeKind) -> Fields {
            if is_ref(t) || is_box(t) {
                let none: Vec<types::FieldSig> = Vec::new();
                return Fields { found: false, path: String::new(), fields: none };
            }
            self.struct_fields(t)
        }

        #[summary("T { f: e, .. }: 필드마다 한 번(E0422), 선언 순서로(E0434), `..base`는 없다(E0223)")]
        #[effects(alloc)]
        fn struct_lit(self: &mut Body, cx: &mut FnCtx, sl: &ast::StructLit, expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            let n: usize = sl.path.len();
            if f == 0 || n == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let name: String = decls::path_text(sl.path.as_slice());
            let mut tp: String = String::new();
            let mut state: u8 = 0;
            let mut fs: Vec<types::FieldSig> = Vec::new();
            match self.c.type_path(sl.path.as_slice(), cx.mod_path.as_str()) {
                None => {},
                Some(p) => { state = 2; match self.c.adts.find(p.as_str()) { None => {}, Some(at) => { match &self.c.adts.items[at].kind { types::AdtKind::Struct(xs) => { state = 1; fs = xs.clone(); }, types::AdtKind::Enum(q4_vs) => {}, } }, } tp = p; },
            }
            if state == 2 {
                self.c.help("E0422", span, types::cat3("`", name.as_str(), "` is an enum, not a struct").as_str(), types::cat3("build a variant: `", name.as_str(), "::V(..)`").as_str());
            }
            if state == 0 {
                let tn: Vec<String> = names_of(sl.path.as_slice());
                let d: diag::Diag = self.c.unknown_type(tn.as_slice(), decls::span_to(sl.path[0].span, sl.path[n - 1].span), cx.mod_path.as_str());
                self.c.diags.push(d);
            }
            if state != 1 {
                for i in 0..sl.fields.len()
                    invariant 0 <= i && i <= sl.fields.len(),
                {
                    self.expr(cx, &sl.fields[i].value, &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            let fnames: Vec<String> = field_names(fs.as_slice());
            let ps: Vec<types::TParam> = match self.c.adts.find(tp.as_str()) {
                None => Vec::new(),
                Some(at2) => self.c.adts.items[at2].generics.clone(),
            };
            let mut tm: types::Subst = self.expected_args(tp.as_str(), expected);
            let mut slots: Vec<Slot> = Vec::new();
            let mut given: Vec<String> = Vec::new();
            let mut order: Vec<usize> = Vec::new();
            for j in 0..sl.fields.len()
                invariant 0 <= j && j <= sl.fields.len(),
            {
                if types::has(given.as_slice(), sl.fields[j].name.name.as_str()) {
                    self.c.help("E0422", sl.fields[j].name.span, types::cat3("field `", sl.fields[j].name.name.as_str(), "` is given more than once").as_str(), "give each field once");
                } else {
                    given.push(sl.fields[j].name.name.clone());
                }
                match decls::index_of(fnames.as_slice(), sl.fields[j].name.name.as_str()) {
                    None => { let msg: String = types::cat5("`", tp.as_str(), "` has no field `", sl.fields[j].name.name.as_str(), "`"); match types::closest(sl.fields[j].name.name.as_str(), fnames.as_slice()) { None => self.c.help("E0306", sl.fields[j].name.span, msg.as_str(), types::cat4("fields of `", tp.as_str(), "`: ", types::join(fnames.as_slice(), ", ").as_str()).as_str()), Some(near) => self.c.fixed("E0306", sl.fields[j].name.span, msg.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()), } self.expr(cx, &sl.fields[j].value, &no, mode, f - 1); },
                    Some(k) => { if k < fs.len() { slots.push(Slot { at: j, ty: fs[k].ty.clone() }); order.push(k); } },
                }
            }
            let noargs: Vec<ast::Expr> = Vec::new();
            self.check_slots(cx, ps.as_slice(), &mut tm, noargs.as_slice(), sl.fields.as_slice(), true, slots.as_slice(), mode, f - 1);
            let whole: ast::TypeKind = if ps.len() == 0 {
                let targs: Vec<ast::Type> = Vec::new();
                ast::TypeKind::Named(refs::split_path(tp.as_str()), targs)
            } else {
                self.instance(tp.as_str(), &tm, types::cat3("`", sl.path[n - 1].name.as_str(), " { .. }`").as_str(), span)
            };
            let has_rest: bool = match &sl.rest {
                None => false,
                Some(q4_r) => true,
            };
            if !has_rest && order.len() == sl.fields.len() && given.len() == sl.fields.len() && unsorted(order.as_slice()) {
                let mut sorted: Vec<String> = Vec::new();
                for a in 0..fnames.len()
                    invariant 0 <= a && a <= fnames.len(),
                {
                    match field_at(sl.fields.as_slice(), fnames[a].as_str()) {
                        None => {},
                        Some(b) => sorted.push(types::cat3(fnames[a].as_str(), ": ", fmt::expr_text(&sl.fields[b].value).as_str())),
                    }
                }
                self.c.fixed("E0434", span, types::cat5("the fields of `", tp.as_str(), "` are given out of their declaration order (", types::join(fnames.as_slice(), ", ").as_str(), ")").as_str(), "give the fields in declaration order (they are evaluated in the order written)", types::cat4(name.as_str(), " { ", types::join(sorted.as_slice(), ", ").as_str(), " }").as_str());
            }
            match &sl.rest {
                None => { let mut missing: Vec<String> = Vec::new(); for c in 0..fnames.len() invariant 0 <= c && c <= fnames.len(), { if !types::has(given.as_slice(), fnames[c].as_str()) { missing.push(fnames[c].clone()); } } if missing.len() > 0 { self.c.help("E0422", span, types::cat5("missing field(s) `", types::join(missing.as_slice(), "`, `").as_str(), "` of `", tp.as_str(), "`").as_str(), "give every field a value (ADR-0026: no `..` update syntax)"); } },
                Some(r) => { let hint: Option<ast::TypeKind> = Some(whole.clone()); let rt: ast::TypeKind = self.expr(cx, &**r, &hint, mode, f - 1); self.expect_ty(&rt, &whole, r.span); if var_or_field(&r.kind) { let base: String = fmt::expr_text(&**r); let mut all: Vec<String> = Vec::new(); for g in 0..fnames.len() invariant 0 <= g && g <= fnames.len(), { match field_at(sl.fields.as_slice(), fnames[g].as_str()) { None => all.push(types::cat5(fnames[g].as_str(), ": ", base.as_str(), ".", fnames[g].as_str())), Some(h) => all.push(types::cat3(fnames[g].as_str(), ": ", fmt::expr_text(&sl.fields[h].value).as_str())), } } self.c.fixed("E0223", span, "struct update syntax `..` is not allowed", "write every field", types::cat4(name.as_str(), " { ", types::join(all.as_slice(), ", ").as_str(), " }").as_str()); } else { self.c.help("E0223", span, "struct update syntax `..` is not allowed", "write every field: `f: base.f`"); } },
            }
            whole
        }

        #[summary("구조체 t의 필드가 Vec·배열·Box·조각·참조를 지나 담는 구조체들")]
        #[effects(alloc)]
        fn struct_parts(self: &Body, t: &ast::TypeKind) -> Vec<ast::TypeKind> {
            let mut out: Vec<ast::TypeKind> = Vec::new();
            let decl: Fields = self.struct_fields_of(t);
            for i in 0..decl.fields.len()
                invariant 0 <= i && i <= decl.fields.len(),
            {
                self.struct_under(&decl.fields[i].ty, &mut out, 1000000000);
            }
            out
        }

        #[summary("t 아래의 구조체를 out에: t가 구조체면 그것, Vec·배열·Box·조각·참조면 그 안")]
        #[effects(alloc)]
        fn struct_under(self: &Body, t: &ast::TypeKind, out: &mut Vec<ast::TypeKind>, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            match under(t) {
                None => { match types::named_path(t) { None => {}, Some(path) => { match self.c.adts.find(path.as_str()) { None => {}, Some(at) => { if struct_kind(&self.c.adts.items[at].kind) { out.push(t.clone()); } }, } }, } },
                Some(e) => self.struct_under(&e, out, f - 1),
            }
        }

        #[summary("&[T] 매개변수의 &v[lo..hi] (백로그 4C-05): v는 정수 타입 T의 배열·Vec·조각(읽기만), lo와 hi는 usize. 범위는 의무(E0805)이고, 조각은 lo부터 hi까지의 원소다")]
        #[effects(alloc)]
        fn sub_slice_arg(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, base: &ast::Expr, lo: &ast::Expr, hi: &ast::Expr, pm: bool, want_elem: &ast::TypeKind, want: &str, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            let bt: ast::TypeKind = self.expr(cx, base, &no, mode, f - 1);
            let u: ast::TypeKind = ast::TypeKind::Int(ast::IntTy::Usize);
            let hint: Option<ast::TypeKind> = Some(u.clone());
            let lt: ast::TypeKind = self.expr(cx, lo, &hint, mode, f - 1);
            self.expect_ty(&lt, &u, lo.span);
            let ht: ast::TypeKind = self.expr(cx, hi, &hint, mode, f - 1);
            self.expect_ty(&ht, &u, hi.span);
            if types::is_error(&bt) {
                return;
            }
            let et: ast::TypeKind = match elem_of(&bt) {
                None => { self.c.help("E0401", a.span, types::cat5("expected `", want, "`, found a range of `", types::text(&bt).as_str(), "`").as_str(), "a range argument `&v[lo..hi]` is of an array, a `Vec` or a slice"); return; },
                Some(e) => e,
            };
            if !types::is_int(&et) {
                self.c.help("E0409", a.span, types::cat3("a part of a slice of `", types::text(&et).as_str(), "` is not passed").as_str(), "a range argument `&v[lo..hi]` is of integers; pass the whole slice and the bounds");
                return;
            }
            if pm || !types::same(&et, want_elem) {
                self.c.help("E0401", a.span, types::cat5("expected `", want, "`, found `&[", types::text(&et).as_str(), "]` (read-only)").as_str(), "a range argument `&v[lo..hi]` is a shared slice of the elements' type");
                return;
            }
            match ref_of(a) {
                None => {},
                Some(x) => { self.types.insert(span_key(x.span).as_str(), ast::TypeKind::Slice(types::boxed(et.clone()))); },
            }
            self.types.insert(span_key(a.span).as_str(), ast::TypeKind::Ref(false, types::boxed(ast::TypeKind::Slice(types::boxed(et)))));
        }

        #[summary("E0237: 추론한 m으로 타입 인자를 써 넣은 호출 (하나라도 추론하지 못했으면 false)")]
        #[effects(alloc)]
        fn targs_fix(self: &mut Body, path: &[ast::Ident], targs: &[ast::TArgs], sig: &types::FnSig, m: &types::Subst, mp: &str) -> bool {
            let n: usize = path.len();
            if n == 0 {
                return false;
            }
            let mut hi: source::Span = path[n - 1].span;
            let mut have: bool = false;
            for i in 0..targs.len()
                invariant 0 <= i && i <= targs.len(),
            {
                if !have || targs[i].span.hi >= hi.hi {
                    hi = targs[i].span;
                    have = true;
                }
            }
            if !have || path[n - 1].span.hi >= hi.hi {
                hi = path[n - 1].span;
            }
            let span: source::Span = decls::span_to(path[0].span, hi);
            let mut unbound_names: Vec<String> = Vec::new();
            for i in 0..sig.generics.len()
                invariant 0 <= i && i <= sig.generics.len(),
            {
                if !types::has(m.names.as_slice(), sig.generics[i].name.as_str()) {
                    unbound_names.push(sig.generics[i].name.clone());
                }
            }
            let name: String = decls::path_text(path);
            if unbound_names.len() > 0 {
                self.c.help("E0237", span, types::cat5("the type arguments of `", name.as_str(), "` are not written, and `", types::join(unbound_names.as_slice(), "`, `").as_str(), "` cannot be inferred from the arguments").as_str(), types::cat3("write them: `", name.as_str(), "::<..>(..)`").as_str());
                return false;
            }
            let ig: usize = sig.impl_generics;
            let mut own: Vec<String> = Vec::new();
            let mut theirs: Vec<String> = Vec::new();
            for i in 0..sig.generics.len()
                invariant 0 <= i && i <= sig.generics.len(),
            {
                let shown: String = types::text_in(&bound_or_error(m, sig.generics[i].name.as_str()), mp);
                let written: String = if has_dollar(shown.as_str()) {
                    String::from("_")
                } else {
                    shown
                };
                if i < ig {
                    own.push(written);
                } else {
                    theirs.push(written);
                }
            }
            let mut segs: Vec<String> = Vec::new();
            for i in 0..n
                invariant 0 <= i && i <= n && n == path.len(),
            {
                if i + 2 == n && ig > 0 && no_text(&sig.trait_of) {
                    segs.push(types::cat4(path[i].name.as_str(), "::<", types::join(own.as_slice(), ", ").as_str(), ">"));
                } else if i + 1 == n && sig.generics.len() > ig {
                    segs.push(types::cat4(path[i].name.as_str(), "::<", types::join(theirs.as_slice(), ", ").as_str(), ">"));
                } else {
                    segs.push(path[i].name.clone());
                }
            }
            let r: String = types::join(segs.as_slice(), "::");
            self.c.fixed("E0237", span, types::cat5("the type arguments of `", name.as_str(), "` are written out: `", r.as_str(), "`").as_str(), "write the inferred type arguments (ADR-0046 §3)", r.as_str());
            true
        }

        #[summary("경로의 마디 seg 뒤에 쓴 타입 인자를 매개변수 ps에 묶는다 (has_seg가 거짓이면 그런 마디가 없다). 쓰지 않았는데 매개변수가 있으면 true")]
        #[effects(alloc)]
        fn targs_level(self: &mut Body, cx: &FnCtx, path: &[ast::Ident], targs: &[ast::TArgs], is_trait: bool, m: &mut types::Subst, has_seg: bool, seg: usize, ps: &[types::TParam], of_type: bool) -> bool {
            let mut written: usize = 0;
            let mut first: usize = 0;
            for i in 0..targs.len()
                invariant 0 <= i && i <= targs.len() && written <= i && first <= i,
            {
                if has_seg && targs[i].seg == seg {
                    if written == 0 {
                        first = i;
                    }
                    written = written + 1;
                }
            }
            if written == 0 || first >= targs.len() {
                return ps.len() > 0;
            }
            let name: String = decls::path_text(path);
            if written == 1 && is_trait && of_type {
                self.c.fixed("E0429", targs[first].span, types::cat3("the trait of `", name.as_str(), "` takes no type arguments: `Self` comes from the arguments").as_str(), "remove them", "");
            } else if written == 1 && targs[first].args.len() == ps.len() {
                for k in 0..ps.len()
                    invariant 0 <= k && k <= ps.len() && first < targs.len() && targs[first].args.len() == ps.len(),
                {
                    let kind: ast::TypeKind = self.c.canon(&targs[first].args[k], cx.mod_path.as_str(), true, 1000000000);
                    if self.c.targ_ok(&kind, &ps[k], name.as_str(), targs[first].args[k].span, true) {
                        sub_put(m, ps[k].name.as_str(), kind);
                    } else {
                        sub_put(m, ps[k].name.as_str(), ast::TypeKind::Error);
                    }
                }
            } else {
                let what: String = if of_type {
                    String::from("the type")
                } else {
                    String::from("the function")
                };
                let mut names: Vec<String> = Vec::new();
                for k in 0..ps.len()
                    invariant 0 <= k && k <= ps.len(),
                {
                    names.push(ps[k].name.clone());
                }
                self.c.help("E0429", targs[first].span, decls::counts(types::cat4(what.as_str(), " `", name.as_str(), "` takes ").as_str(), ps.len(), " type argument(s), found ", targs[first].args.len(), "").as_str(), types::cat3("write one type for each of `", types::join(names.as_slice(), "`, `").as_str(), "`").as_str());
                for k in 0..ps.len()
                    invariant 0 <= k && k <= ps.len(),
                {
                    sub_put(m, ps[k].name.as_str(), ast::TypeKind::Error);
                }
            }
            false
        }

        #[summary("&str 매개변수의 인자 (ADR-0050 §2): 문자열 리터럴, String의 s.as_str(), 넘겨받은 &str, 둘 가운데 하나의 &s[a..b]. Rust의 버릇인 String의 &s와 s는 E0218")]
        #[effects(alloc)]
        fn text_arg(self: &mut Body, cx: &mut FnCtx, a: &ast::Expr, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            let no: Option<ast::TypeKind> = None;
            let key: String = span_key(a.span);
            if is_str_lit(&a.kind) {
                self.types.insert(key.as_str(), str_ref());
                return;
            }
            match as_str_of(a) {
                None => {},
                Some(m) => { let rt: ast::TypeKind = self.expr(cx, &*m.recv, &no, mode, f - 1); if m.args.len() != 0 { self.c.err("E0405", m.name.span, "`as_str` takes no arguments"); } if !owned_text(&rt) { if !types::is_error(&rt) { self.c.err("E0404", m.name.span, types::cat3("`as_str` is not defined for `", types::text(&rt).as_str(), "`").as_str()); } return; } self.types.insert(key.as_str(), str_ref()); return; },
            }
            match slice_of(a) {
                None => {},
                Some(s) => { let bt: ast::TypeKind = self.text_operand(cx, &s.base, &no, mode, f - 1); let u: ast::TypeKind = ast::TypeKind::Int(ast::IntTy::Usize); let hint: Option<ast::TypeKind> = Some(u.clone()); let lt: ast::TypeKind = self.expr(cx, &s.lo, &hint, mode, f - 1); self.expect_ty(&lt, &u, s.lo.span); let ht: ast::TypeKind = self.expr(cx, &s.hi, &hint, mode, f - 1); self.expect_ty(&ht, &u, s.hi.span); if !is_text(&bt) { if !types::is_error(&bt) { self.c.help("E0401", a.span, types::cat3("expected `&str`, found a range of `", types::text(&bt).as_str(), "`").as_str(), "a range argument `&s[a..b]` is of a `String` or a `&str`"); } return; } self.types.insert(key.as_str(), str_ref()); return; },
            }
            match ref_var(a) {
                None => {},
                Some(x) => { let t: ast::TypeKind = self.expr(cx, &x, &no, mode, f - 1); if owned_text(&t) { let r: String = types::cat2(fmt::expr_text(&x).as_str(), ".as_str()"); self.c.fixed("E0218", a.span, "a `String` is not a `&str`", types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str()); } else if !types::is_error(&t) { self.c.err("E0401", a.span, types::cat3("expected `&str`, found `&", types::text(&t).as_str(), "`").as_str()); } return; },
            }
            let at: ast::TypeKind = self.expr(cx, a, &no, mode, f - 1);
            if types::same(&at, &str_ref()) || types::is_error(&at) || is_never(&at) {
                return;
            }
            if owned_text(&at) {
                let r: String = types::cat2(fmt::expr_text(a).as_str(), ".as_str()");
                self.c.fixed("E0218", a.span, "a `String` is not a `&str`", types::cat3("pass `", r.as_str(), "`").as_str(), r.as_str());
            } else {
                self.c.err("E0401", a.span, types::cat3("expected `&str`, found `", types::text(&at).as_str(), "`").as_str());
            }
        }

        #[summary("String::new(), String::with_capacity(n), String::from(t), String::from_utf8(v), char::from_u32(x) (ADR-0050 §2)")]
        #[effects(alloc)]
        fn text_call(self: &mut Body, cx: &mut FnCtx, path: &[ast::Ident], args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 || path.len() != 2 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let what: String = types::cat3("`", decls::path_text(path).as_str(), "`");
            let owner: String = path[0].name.clone();
            let last: String = path[1].name.clone();
            if !exec_mode(mode) && owner == "String" {
                self.c.err("E0503", span, types::cat2(what.as_str(), " is not allowed in a specification").as_str());
            }
            let arity: usize = if last == "new" {
                0
            } else {
                1
            };
            if args.len() != arity {
                self.c.help("E0405", span, decls::counts(types::cat2(what.as_str(), " takes ").as_str(), arity, " argument(s), found ", args.len(), "").as_str(), "Rust's signatures: `String::new()`, `String::with_capacity(n)`, `String::from(t)`, `String::from_utf8(v)`, `char::from_u32(x)`");
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            if exec_mode(mode) && (last == "new" || last == "with_capacity" || last == "from") {
                need_own(cx, alloc_effect(), what.as_str());
            }
            if owner == "String" && last == "new" {
                return ast::TypeKind::String;
            }
            if args.len() == 0 {
                return ast::TypeKind::Error;
            }
            if owner == "String" && last == "with_capacity" {
                let u: ast::TypeKind = ast::TypeKind::Int(ast::IntTy::Usize);
                let hint: Option<ast::TypeKind> = Some(u.clone());
                let t: ast::TypeKind = self.expr(cx, &args[0], &hint, mode, f - 1);
                self.expect_ty(&t, &u, args[0].span);
                return ast::TypeKind::String;
            }
            if owner == "String" && last == "from" {
                self.text_arg(cx, &args[0], mode, f - 1);
                return ast::TypeKind::String;
            }
            if owner == "String" && last == "from_utf8" {
                let v: ast::TypeKind = ast::TypeKind::Vec(types::boxed(ast::TypeKind::Int(ast::IntTy::U8)));
                let want: Option<ast::TypeKind> = Some(v.clone());
                let vt: ast::TypeKind = self.expr(cx, &args[0], &want, mode, f - 1);
                self.expect_ty(&vt, &v, args[0].span);
                let mut both: Vec<ast::Type> = Vec::new();
                both.push(types::ty(ast::TypeKind::String));
                both.push(types::ty(v));
                return ast::TypeKind::Named(single("Result"), both);
            }
            let w: ast::TypeKind = ast::TypeKind::Int(ast::IntTy::U32);
            let scalar: Option<ast::TypeKind> = Some(w.clone());
            let ct: ast::TypeKind = self.expr(cx, &args[0], &scalar, mode, f - 1);
            self.expect_ty(&ct, &w, args[0].span);
            option_of(ast::TypeKind::Char)
        }

        #[summary("글의 메서드 (ADR-0050 §2): len, is_char_boundary, String의 push_str·push·clone. as_str과 as_bytes는 인자다 (또는 색인, s.as_bytes()[i])")]
        #[effects(alloc)]
        fn text_method(self: &mut Body, cx: &mut FnCtx, recv: &ast::Expr, rt: &ast::TypeKind, name: &ast::Ident, args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            let m: String = name.name.clone();
            let owned: bool = owned_text(rt);
            let mut arity: usize = 0;
            let mut mutates: bool = false;
            let mut ret: ast::TypeKind = ast::TypeKind::Unit;
            if m == "len" {
                ret = ast::TypeKind::Int(ast::IntTy::Usize);
            } else if m == "is_char_boundary" {
                arity = 1;
                ret = ast::TypeKind::Bool;
            } else if (m == "push_str" || m == "push") && owned {
                arity = 1;
                mutates = true;
            } else if m == "clone" && owned {
                ret = ast::TypeKind::String;
            } else if m == "as_str" || m == "as_bytes" {
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                let msg: String = types::cat3("`.", m.as_str(), "()` may only appear directly as a call argument");
                if m == "as_bytes" {
                    self.c.help("E0409", span, msg.as_str(), "pass it to a `&[u8]` parameter, or read a byte: `s.as_bytes()[i]`");
                } else {
                    self.c.help("E0409", span, msg.as_str(), "pass it to a `&str` parameter");
                }
                return ast::TypeKind::Error;
            } else {
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.text_operand(cx, &args[i], &no, mode, f - 1);
                }
                self.c.help("E0404", name.span, types::cat5("unknown method `", m.as_str(), "` of `", types::text(rt).as_str(), "`").as_str(), text_missing(m.as_str()).as_str());
                return ast::TypeKind::Error;
            }
            if args.len() != arity {
                self.c.err("E0405", name.span, decls::counts(types::cat3("`", m.as_str(), "` takes ").as_str(), arity, " argument(s), found ", args.len(), "").as_str());
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            let call: String = types::cat3("`.", m.as_str(), "()`");
            if !exec_mode(mode) && mutates {
                if cx.ghost {
                    self.ghost_violation(span, call.as_str(), "change the value outside the `proof` block");
                } else {
                    self.c.err("E0503", span, types::cat2(call.as_str(), " is not allowed in a specification").as_str());
                }
            }
            if !exec_mode(mode) && m == "clone" {
                self.c.fixed("E0503", span, "`.clone()` is not allowed in a specification", "a specification reads the value itself: drop `.clone()`", fmt::expr_text(recv).as_str());
            }
            if exec_mode(mode) && (m == "push_str" || m == "push" || m == "clone") {
                need_own(cx, alloc_effect(), types::cat3("`String::", m.as_str(), "`").as_str());
            }
            if args.len() > 0 {
                if m == "is_char_boundary" {
                    let u: ast::TypeKind = ast::TypeKind::Int(ast::IntTy::Usize);
                    let hint: Option<ast::TypeKind> = Some(u.clone());
                    let t: ast::TypeKind = self.expr(cx, &args[0], &hint, mode, f - 1);
                    self.expect_ty(&t, &u, args[0].span);
                } else if m == "push_str" {
                    self.text_arg(cx, &args[0], mode, f - 1);
                } else if m == "push" {
                    let c: ast::TypeKind = ast::TypeKind::Char;
                    let want: Option<ast::TypeKind> = Some(c.clone());
                    let pt: ast::TypeKind = self.expr(cx, &args[0], &want, mode, f - 1);
                    if types::same(&pt, &ast::TypeKind::Int(ast::IntTy::U8)) {
                        self.c.help("E0401", args[0].span, "expected `char`, found `u8`: a `String` holds characters", "push a character literal `'a'`, or the byte's character `char::from_u32(u32::from(b))`");
                    } else {
                        self.expect_ty(&pt, &c, args[0].span);
                    }
                }
            }
            if mutates && exec_mode(mode) && !writable(cx, recv, 1000000000) && !types::is_error(rt) {
                let need: String = types::cat2(call.as_str(), " needs a mutable `String`");
                if is_ref(rt) {
                    self.c.help("E0408", recv.span, need.as_str(), "take the parameter as `&mut String`");
                } else {
                    self.c.help("E0408", recv.span, need.as_str(), "declare it with `let mut`");
                }
            }
            ret
        }

        #[summary("견줌의 글 피연산자: 문자열 리터럴은 거기서 &str다 (Rust의 버릇 s == \"abc\", ADR-0050 §2)")]
        #[effects(alloc)]
        fn text_operand(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, hint: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if is_str_lit(&e.kind) {
                let t: ast::TypeKind = str_ref();
                self.types.insert(span_key(e.span).as_str(), t.clone());
                return t;
            }
            if as_str_call(e) || str_slice(e) {
                self.text_arg(cx, e, mode, f - 1);
                return self.type_at(e.span);
            }
            self.expr(cx, e, hint, mode, f - 1)
        }

        #[summary("경계 있는 Self의 호출을 지나는 재귀 (ADR-0046 §2): 타입 매개변수 없는 정의에서 닿는 인스턴스의 그래프에서 그런 호출을 지나는 순환. 제네릭 정의는 한 번 증명되고 거기서 그 호출은 trait의 계약만 이름하는데, 계약에는 척도가 없다. 그런 순환의 정의에 E0207을 내고 그 정의들을 돌려준다. 구조를 따라 맡기는 것(impl<T: Shape> Shape for Wrap<T>가 T의 것을 부름)은 순환이 아니다")]
        #[effects(alloc)]
        fn trait_cycles(self: &mut Body, defs: &table::Table<DefRow>) -> Vec<String> {
            let mut edges: table::Table<Vec<Edge>> = table::new::<Vec<Edge>>();
            for i in 0..self.gcalls.len()
                invariant 0 <= i && i <= self.gcalls.len(),
            {
                add_edge(&mut edges, self.gcalls[i].caller.as_str(), Edge { callee: self.gcalls[i].callee.clone(), args: self.gcalls[i].args.clone() });
            }
            let callers: usize = self.calls.len();
            for n in 0..callers
                invariant 0 <= n && n <= callers,
            {
                match self.calls.nth(n) {
                    None => {},
                    Some(at) => { let caller: String = self.calls.key(n); let cs: Vec<String> = decls::sorted(self.calls.items[at].as_slice()); for j in 0..cs.len() invariant 0 <= j && j <= cs.len(), { if self.plain_fn(cs[j].as_str()) { let none: Vec<ast::TypeKind> = Vec::new(); add_edge(&mut edges, caller.as_str(), Edge { callee: cs[j].clone(), args: none }); } } },
                }
            }
            let mut graph: table::Table<Vec<String>> = table::new::<Vec<String>>();
            let mut bound_edges: Vec<Pair> = Vec::new();
            let mut base_of: table::Table<String> = table::new::<String>();
            let mut work: Vec<Edge> = Vec::new();
            let total: usize = defs.len();
            for n in 0..total
                invariant 0 <= n && n <= total,
            {
                let path: String = defs.key(n);
                if self.plain_fn(path.as_str()) {
                    let none: Vec<ast::TypeKind> = Vec::new();
                    work.push(Edge { callee: path.clone(), args: none });
                }
            }
            let mut fuel: usize = 1000000000;
            while work.len() > 0 && fuel > 0
                invariant 0 <= fuel,
                decreases fuel,
            {
                fuel = fuel - 1;
                match work.pop() {
                    None => {},
                    Some(w) => { self.instance_edges(&w, &edges, &mut graph, &mut bound_edges, &mut base_of, &mut work); },
                }
            }
            let mut out: Vec<String> = Vec::new();
            let comps: Vec<Vec<String>> = sccs_with_cycles(&graph);
            for i in 0..comps.len()
                invariant 0 <= i && i <= comps.len(),
            {
                match first_bound(bound_edges.as_slice(), comps[i].as_slice()) {
                    None => {},
                    Some(to) => { for j in 0..comps[i].len() invariant 0 <= j && j <= comps[i].len(), { match base_of.find(comps[i][j].as_str()) { None => {}, Some(at) => { let b: String = base_of.items[at].clone(); if types::add(&mut out, b.as_str()) { match defs.find(b.as_str()) { None => {}, Some(d) => { self.c.help("E0207", defs.items[d].span, types::cat5("`", b.as_str(), "` is recursive through a call on a bounded `Self` (reaching `", to.as_str(), "`), which carries no measure (ADR-0046 §4)").as_str(), "call with a known `Self` type, or break the cycle"); }, } } }, } } },
                }
            }
            out
        }

        #[summary("trait의 메서드인가")]
        #[effects(alloc)]
        fn trait_method(self: &Body, path: &str) -> bool {
            match self.c.fns.find(path) {
                None => false,
                Some(at) => !no_text(&self.c.fns.items[at].trait_of),
            }
        }

        #[summary("#[trigger] 항: 명세의 forall·exists 몸 안에서만")]
        #[effects(alloc)]
        fn trigger_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, x: &ast::Expr, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if exec_mode(mode) {
                self.c.err("E0503", e.span, "`#[trigger]` is only allowed in specifications");
            } else if cx.forall_depth == 0 {
                self.c.help("E0510", e.span, "`#[trigger]` outside `forall`", "remove `#[trigger]`, or move the term into a `forall` or `exists` body");
            }
            self.expr(cx, x, expected, mode, f - 1)
        }

        #[summary("x? (ADR-0049 §1): x는 Option을 내는 함수 안의 Option, 또는 같은 오류 타입의 Result를 내는 함수 안의 Result (암묵 변환 없음, E0241). 타입은 페이로드")]
        #[effects(alloc)]
        fn try_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, x: &ast::Expr, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if !exec_mode(mode) {
                self.c.help("E0503", e.span, "`?` is not allowed in a specification", "a specification is one expression: test the variant with `match`");
            }
            let no: Option<ast::TypeKind> = None;
            let xt: ast::TypeKind = self.expr(cx, x, &no, mode, f - 1);
            let kind: u8 = try_variants(&xt);
            if kind == 0 {
                if !types::is_error(&xt) && !is_never(&xt) {
                    let through: bool = match ref_inner(&xt) {
                        None => false,
                        Some(inner) => try_variants(&inner) != 0,
                    };
                    let msg: String = types::cat3("`?` applies to an `Option` or a `Result`, found `", types::text(&xt).as_str(), "`");
                    if through {
                        self.c.help("E0401", x.span, msg.as_str(), "`?` takes the value itself: `(*x)?` when it is `Copy`, otherwise `match` the reference");
                    } else {
                        self.c.help("E0401", x.span, msg.as_str(), "test the value with `if` or `match` instead");
                    }
                }
                return ast::TypeKind::Error;
            }
            let args: Vec<ast::TypeKind> = types::named_args(&xt);
            if args.len() == 0 {
                return ast::TypeKind::Error;
            }
            let payload: ast::TypeKind = args[0].clone();
            if !exec_mode(mode) {
                return payload;
            }
            let ret: ast::TypeKind = cx.ret.clone();
            if try_variants(&ret) == kind {
                let ra: Vec<ast::TypeKind> = types::named_args(&ret);
                if kind == 1 || ra.len() < 2 || args.len() < 2 {
                    return payload;
                }
                if types::same(&ra[1], &args[1]) {
                    return payload;
                }
                let want: String = types::text(&ra[1]);
                self.c.help("E0241", e.span, types::cat5("the error type `", types::text(&args[1]).as_str(), "` of `?` is not the function's `", want.as_str(), "`").as_str(), types::cat3("convert it explicitly: `match` the value and `return Err(..)` with a `", want.as_str(), "`").as_str());
                return payload;
            }
            if types::is_error(&ret) {
                return payload;
            }
            if kind == 1 {
                self.c.help("E0241", e.span, types::cat5("`?` on `", types::text(&xt).as_str(), "` returns its `None` from a function returning `", types::text(&ret).as_str(), "`").as_str(), "`?` needs the function to return `Option<..>`; otherwise `match` the value");
            } else {
                self.c.help("E0241", e.span, types::cat5("`?` on `", types::text(&xt).as_str(), "` returns its `Err` from a function returning `", types::text(&ret).as_str(), "`").as_str(), "`?` needs the function to return `Result<.., E>`; otherwise `match` the value");
            }
            payload
        }

        #[summary("그 자리의 식에 적힌 타입 (없으면 오류 타입)")]
        #[effects(alloc)]
        fn type_at(self: &Body, span: source::Span) -> ast::TypeKind {
            match self.types.find(span_key(span).as_str()) {
                None => ast::TypeKind::Error,
                Some(i) => self.types.items[i].clone(),
            }
        }

        #[summary("-x와 !x: 음수는 부호 있는 정수와 f64에 (명세의 정수는 수학의 정수다, ADR-0024), !는 bool의 논리 부정이자 정수의 비트 부정이다 (ADR-0048 §2)")]
        #[effects(alloc)]
        fn unary_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, op: ast::UnOp, x: &ast::Expr, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            if is_neg(op) {
                match consts::int_lit(x) {
                    None => {},
                    Some(v) => { if opt_f64(expected) { let mut s: String = String::from("-"); wide::push_radix(&mut s, v, 10); let ft: ast::TypeKind = self.int_for_float(s.as_str(), e.span); self.types.insert(span_key(x.span).as_str(), ft.clone()); return ft; } return self.int_lit(v, true, expected, e.span, mode); },
                }
                let t: ast::TypeKind = self.expr(cx, x, expected, mode, f - 1);
                match int_of(&t) {
                    None => {},
                    Some(i) => { if signed(i) { return t; } if !exec_mode(mode) { return ast::TypeKind::Int(ast::IntTy::I64); } self.unsigned_negation(e.span, &t); return ast::TypeKind::Error; },
                }
                if is_f64(&t) || types::is_error(&t) {
                    return t;
                }
                self.c.err("E0401", e.span, types::cat3("cannot negate `", types::text(&t).as_str(), "`").as_str());
                return ast::TypeKind::Error;
            }
            let hint: Option<ast::TypeKind> = match expected {
                None => None,
                Some(h) => { if types::is_int(h) || is_bool(h) { Some(h.clone()) } else { None } },
            };
            let nt: ast::TypeKind = self.expr(cx, x, &hint, mode, f - 1);
            if is_bool(&nt) || types::is_int(&nt) || types::is_error(&nt) {
                return nt;
            }
            self.c.help("E0401", e.span, types::cat3("`!` is not defined for `", types::text(&nt).as_str(), "`").as_str(), "`!` is logical not on `bool` and bitwise not on integers");
            ast::TypeKind::Error
        }

        #[summary("E0301: 범위에 없는 이름. 보이는 이름 가운데 가장 가까운 하나(편집 거리 2 이하)를 고칠 글로 (백로그 2D-18)")]
        #[effects(alloc)]
        fn unknown_local(self: &mut Body, cx: &FnCtx, name: &str, span: source::Span) -> () {
            let msg: String = types::cat3("unknown name `", name, "`");
            if types::has(cx.for_vars.as_slice(), name) {
                self.c.help("E0301", span, msg.as_str(), "a `for` variable lives only in its loop; keep what you need in a local declared before it");
                return;
            }
            let mut cands: Vec<String> = Vec::new();
            for i in 0..cx.scopes.len()
                invariant 0 <= i && i <= cx.scopes.len(),
            {
                let mut names: Vec<String> = Vec::new();
                for j in 0..cx.scopes[i].len()
                    invariant 0 <= j && j <= cx.scopes[i].len(),
                {
                    types::add(&mut names, cx.scopes[i][j].name.as_str());
                }
                let ordered: Vec<String> = decls::sorted(names.as_slice());
                push_names(&mut cands, ordered.as_slice());
            }
            match types::closest(name, cands.as_slice()) {
                None => self.c.err("E0301", span, msg.as_str()),
                Some(near) => self.c.fixed("E0301", span, msg.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()),
            }
        }

        #[summary("타입의 impl에도 그 trait들(경계나 구현한 trait)에도 없는 메서드 이름의 E0404, 가진 메서드들과 함께")]
        #[effects(alloc)]
        fn unknown_method(self: &mut Body, cx: &FnCtx, value: &ast::TypeKind, name: &ast::Ident, traits: &[String]) -> () {
            let mut have: Vec<String> = Vec::new();
            let named: bool = is_named(value);
            let tp: String = match types::named_path(value) {
                None => String::new(),
                Some(p) => p,
            };
            if named {
                let depth: usize = refs::split_path(tp.as_str()).len();
                let total: usize = self.c.fns.len();
                for n in 0..total
                    invariant 0 <= n && n <= total,
                {
                    match self.c.fns.nth(n) {
                        None => {},
                        Some(at) => { let segs: Vec<String> = refs::split_path(self.c.fns.key(n).as_str()); if segs.len() == depth + 1 && types::join_head(segs.as_slice(), depth) == tp && no_text(&self.c.fns.items[at].trait_of) && self.c.fns.items[at].in_impl && self.c.fns.items[at].params.len() > 0 { let first: ast::TypeKind = match ref_inner(&self.c.fns.items[at].params[0]) { None => self.c.fns.items[at].params[0].clone(), Some(inner) => inner, }; let same: bool = match types::named_path(&first) { None => false, Some(q) => is_named(&first) && q == tp, }; if same { have.push(segs[depth].clone()); } } },
                    }
                }
            }
            for i in 0..traits.len()
                invariant 0 <= i && i <= traits.len(),
            {
                match self.c.traits.find(traits[i].as_str()) {
                    None => {},
                    Some(at) => { for j in 0..self.c.traits.items[at].methods.len() invariant 0 <= j && j <= self.c.traits.items[at].methods.len(), { have.push(self.c.traits.items[at].methods[j].clone()); } },
                }
            }
            let methods: Vec<String> = sorted_set(have.as_slice());
            let ty: String = types::text_in(value, cx.mod_path.as_str());
            let moving: Vec<String> = self.c.moving_params();
            let copied: bool = name.name == "clone" && named && !types::is_move_in(value, &self.c.adts, moving.as_slice());
            let fix: String = if copied {
                types::cat3("a `", ty.as_str(), "` is copied by value; remove `.clone()`")
            } else if methods.len() == 0 {
                types::cat5("`", ty.as_str(), "` has no methods; define `", name.name.as_str(), "` in an `impl` of it")
            } else {
                types::cat5("the methods of `", ty.as_str(), "` are `", types::join(methods.as_slice(), "`, `").as_str(), "`")
            };
            self.c.help("E0404", name.span, types::cat5("unknown method `", name.name.as_str(), "` of `", ty.as_str(), "`").as_str(), fix.as_str());
        }

        #[summary("경로가 변형이 아닐 때의 진단: 그런 변형이 없는 열거형(E0307), 또는 모르는 타입(E0305)")]
        #[effects(alloc)]
        fn unknown_variant(self: &mut Body, cx: &FnCtx, segs: &[ast::Ident]) -> () {
            let n: usize = segs.len();
            if n < 2 {
                return;
            }
            let ty: Vec<ast::Ident> = head(segs);
            match self.c.type_path(ty.as_slice(), cx.mod_path.as_str()) {
                None => { let tn: Vec<String> = names_of(ty.as_slice()); let d: diag::Diag = self.c.unknown_type(tn.as_slice(), decls::span_to(segs[0].span, segs[n - 2].span), cx.mod_path.as_str()); self.c.diags.push(d); },
                Some(tp) => { let mut names: Vec<String> = Vec::new(); match self.c.adts.find(tp.as_str()) { None => {}, Some(at) => { match &self.c.adts.items[at].kind { types::AdtKind::Struct(q4_fs) => {}, types::AdtKind::Enum(vs) => { names = variant_names(vs.as_slice()); }, } }, } let msg: String = types::cat5("`", tp.as_str(), "` has no variant `", segs[n - 1].name.as_str(), "`"); match types::closest(segs[n - 1].name.as_str(), names.as_slice()) { None => { if names.len() == 0 { self.c.help("E0307", segs[n - 1].span, msg.as_str(), types::cat5("`", tp.as_str(), "` is a struct: build it with `", segs[n - 2].name.as_str(), " { .. }`").as_str()); } else { self.c.help("E0307", segs[n - 1].span, msg.as_str(), types::cat4("variants of `", tp.as_str(), "`: ", types::join(names.as_slice(), ", ").as_str()).as_str()); } }, Some(near) => self.c.fixed("E0307", segs[n - 1].span, msg.as_str(), types::cat3("did you mean `", near.as_str(), "`?").as_str(), near.as_str()), } },
            }
        }

        #[summary("E0411: 부호 없는 값에는 음수가 없다")]
        #[effects(alloc)]
        fn unsigned_negation(self: &mut Body, span: source::Span, t: &ast::TypeKind) -> () {
            self.c.help("E0411", span, types::cat3("cannot negate a value of type `", types::text(t).as_str(), "`").as_str(), "an unsigned type has no negative values: use a signed type, or subtract from a larger value");
        }

        #[summary("변수: 지역 변수, 아니면 const, 아니면 모르는 이름 (E0301). 가려지지 않은 None은 내장 변형이다")]
        #[effects(alloc)]
        fn var_expr(self: &mut Body, cx: &mut FnCtx, e: &ast::Expr, id: &ast::Ident, expected: &Option<ast::TypeKind>, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3 + 1,
        {
            let found: Option<Local> = lookup(cx, id.name.as_str());
            match &found {
                None => {},
                Some(l) => { return l.ty.clone(); },
            }
            if id.name == "None" {
                let noargs: Vec<ast::Expr> = Vec::new();
                return self.builtin_variant(cx, "None", noargs.as_slice(), expected, e.span, mode, f);
            }
            let one: Vec<String> = single(id.name.as_str());
            match self.const_ref(cx.path.as_str(), one.as_slice(), cx.mod_path.as_str(), e.span) {
                None => {},
                Some(t) => { return t; },
            }
            if id.name == "result" {
                self.c.help("E0301", id.span, "unknown name `result`", "name the result: `-> (r: T)` and use `r`");
            } else {
                self.unknown_local(cx, id.name.as_str(), id.span);
            }
            ast::TypeKind::Error
        }

        #[summary("변수인 자리: 참조면 그 참조가 &mut인가, 아니면 let mut인가")]
        #[effects(alloc)]
        fn var_place(self: &mut Body, cx: &mut FnCtx, id: &ast::Ident) -> Place {
            match lookup(cx, id.name.as_str()) {
                None => { self.unknown_local(cx, id.name.as_str(), id.span); Place { ty: ast::TypeKind::Error, writable: false } },
                Some(l) => { let w: bool = if is_ref(&l.ty) { types::is_ref_mut(&l.ty) } else { l.mutable }; Place { ty: l.ty, writable: w } },
            }
        }

        #[summary("T::V, unit::T::V: 열거형의 경로, 변형의 차례, 페이로드의 타입")]
        #[effects(alloc)]
        fn variant(self: &Body, segs: &[ast::Ident], mp: &str) -> VariantAt {
            let n: usize = segs.len();
            if n < 2 {
                return no_variant();
            }
            let ty: Vec<ast::Ident> = head(segs);
            let tp: String = match self.c.type_path(ty.as_slice(), mp) {
                None => { return no_variant(); },
                Some(p) => p,
            };
            let at: usize = match self.c.adts.find(tp.as_str()) {
                None => { return no_variant(); },
                Some(i) => i,
            };
            match &self.c.adts.items[at].kind {
                types::AdtKind::Struct(q4_fs) => no_variant(),
                types::AdtKind::Enum(vs) => { for k in 0..vs.len() invariant 0 <= k && k <= vs.len(), { if vs[k].name == segs[n - 1].name { return VariantAt { found: true, tp: tp.clone(), k: k, payload: vs[k].tys.clone() }; } } no_variant() },
            }
        }

        #[summary("변형 값: T::V (페이로드 없음) 또는 T::V(a, ..)")]
        #[effects(alloc)]
        fn variant_value(self: &mut Body, cx: &mut FnCtx, segs: &[ast::Ident], args: &[ast::Expr], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            let n: usize = segs.len();
            if f == 0 || n == 0 {
                return ast::TypeKind::Error;
            }
            let va: VariantAt = self.variant(segs, cx.mod_path.as_str());
            if !va.found {
                self.unknown_variant(cx, segs);
                let no: Option<ast::TypeKind> = None;
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                return ast::TypeKind::Error;
            }
            if args.len() != va.payload.len() {
                let mut tys: Vec<String> = Vec::new();
                for j in 0..va.payload.len()
                    invariant 0 <= j && j <= va.payload.len(),
                {
                    tys.push(types::text(&va.payload[j]));
                }
                self.c.help("E0405", span, decls::counts(types::cat3("`", segs[n - 1].name.as_str(), "` takes ").as_str(), va.payload.len(), " value(s), found ", args.len(), "").as_str(), types::cat3("the payload is `(", types::join(tys.as_slice(), ", ").as_str(), ")`").as_str());
            }
            let ps: Vec<types::TParam> = match self.c.adts.find(va.tp.as_str()) {
                None => Vec::new(),
                Some(at) => self.c.adts.items[at].generics.clone(),
            };
            let mut tm: types::Subst = self.expected_args(va.tp.as_str(), expected);
            let mut slots: Vec<Slot> = Vec::new();
            for k in 0..va.payload.len()
                invariant 0 <= k && k <= va.payload.len(),
            {
                if k < args.len() {
                    slots.push(Slot { at: k, ty: va.payload[k].clone() });
                }
            }
            let nofields: Vec<ast::FieldInit> = Vec::new();
            self.check_slots(cx, ps.as_slice(), &mut tm, args, nofields.as_slice(), false, slots.as_slice(), mode, f - 1);
            if ps.len() == 0 {
                let targs: Vec<ast::Type> = Vec::new();
                return ast::TypeKind::Named(refs::split_path(va.tp.as_str()), targs);
            }
            self.instance(va.tp.as_str(), &tm, types::cat3("`", decls::path_text(segs).as_str(), "`").as_str(), span)
        }

        #[summary("Vec::new(), Vec::with_capacity(n) (원소 타입은 기대한 타입의 것), 그리고 Rust의 버릇 drop(v), mem::take (E0219)")]
        #[effects(alloc)]
        fn vec_call(self: &mut Body, cx: &mut FnCtx, path: &[ast::Ident], args: &[ast::Expr], expected: &Option<ast::TypeKind>, span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 || path.len() == 0 {
                return ast::TypeKind::Error;
            }
            let last: String = path[path.len() - 1].name.clone();
            if path.len() == 2 && path[0].name == "mem" && (last == "replace" || last == "swap") {
                let full: String = types::cat2("std::mem::", last.as_str());
                self.c.fixed("E0214", decls::span_to(path[0].span, path[1].span), types::cat3("`mem::", last.as_str(), "` comes from a `use`").as_str(), types::cat3("write `", full.as_str(), "`").as_str(), full.as_str());
                return ast::TypeKind::Error;
            }
            if path[0].name != "Vec" {
                let no: Option<ast::TypeKind> = None;
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                self.c.help("E0219", span, types::cat3("`", decls::path_text(path).as_str(), "` is not used").as_str(), "a `Vec` is freed at the end of its block; assign a new value to replace it");
                return ast::TypeKind::Error;
            }
            if !exec_mode(mode) {
                self.c.err("E0503", span, types::cat3("`Vec::", last.as_str(), "` is not allowed in a specification").as_str());
            }
            let arity: usize = if last == "with_capacity" {
                1
            } else {
                0
            };
            if args.len() != arity {
                self.c.err("E0405", span, decls::counts(types::cat3("`Vec::", last.as_str(), "` takes ").as_str(), arity, " argument(s), found ", args.len(), "").as_str());
            }
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Int(ast::IntTy::Usize));
            for j in 0..args.len()
                invariant 0 <= j && j <= args.len(),
            {
                let t: ast::TypeKind = self.expr(cx, &args[j], &wu, mode, f - 1);
                self.expect_ty(&t, &ast::TypeKind::Int(ast::IntTy::Usize), args[j].span);
            }
            match expected {
                None => {},
                Some(x) => { if is_vec(x) { return x.clone(); } if types::is_error(x) { return ast::TypeKind::Error; } },
            }
            self.c.help("E0401", span, types::cat3("the element type of `Vec::", last.as_str(), "()` comes from the expected type").as_str(), "write it: `let v: Vec<T> = Vec::new();`");
            ast::TypeKind::Error
        }

        #[summary("Vec<T>의 내장 메서드 (ADR-0031 §1): push, pop, len, truncate, clone, copy_within. as_slice와 as_mut_slice는 인자로만")]
        #[effects(alloc)]
        fn vec_method(self: &mut Body, cx: &mut FnCtx, recv: &ast::Expr, rt: &ast::TypeKind, et: &ast::TypeKind, name: &ast::Ident, args: &[ast::Expr], span: source::Span, mode: Mode, f: usize) -> ast::TypeKind
            decreases f * 3,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            let no: Option<ast::TypeKind> = None;
            if name.name == "copy_within" {
                return self.copy_within(cx, recv, rt, et, name, args, span, mode, f - 1);
            }
            let push: bool = name.name == "push";
            let cloned: bool = name.name == "clone";
            if exec_mode(mode) && (push || cloned) {
                need_own(cx, alloc_effect(), types::cat3("`Vec::", name.name.as_str(), "`").as_str());
            }
            let mut arity: usize = 0;
            let mut mutates: bool = false;
            let mut ret: ast::TypeKind = ast::TypeKind::Unit;
            if push {
                arity = 1;
                mutates = true;
            } else if name.name == "pop" {
                mutates = true;
                ret = option_of(et.clone());
            } else if name.name == "truncate" {
                arity = 1;
                mutates = true;
            } else if name.name == "len" {
                ret = ast::TypeKind::Int(ast::IntTy::Usize);
            } else if cloned {
                let whole: ast::TypeKind = ast::TypeKind::Vec(types::boxed(et.clone()));
                let moving: Vec<String> = self.c.moving_params();
                let why: String = clone_blocked(et, &self.c.adts, moving.as_slice());
                if why.len() > 0 {
                    self.no_clone(name.span, &whole, why.as_str());
                    return ast::TypeKind::Error;
                }
                ret = whole;
            } else {
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    self.expr(cx, &args[i], &no, mode, f - 1);
                }
                if name.name == "as_slice" || name.name == "as_mut_slice" {
                    self.c.help("E0409", span, types::cat3("`.", name.name.as_str(), "()` may only appear directly as a call argument").as_str(), "pass it to a `&[T]` / `&mut [T]` parameter");
                    return ast::TypeKind::Error;
                }
                let msg: String = types::cat3("unknown method `", name.name.as_str(), "`");
                let fix: String = vec_missing(name.name.as_str());
                if fix.len() > 0 {
                    self.c.help("E0404", name.span, msg.as_str(), fix.as_str());
                } else {
                    self.c.err("E0404", name.span, msg.as_str());
                }
                return ast::TypeKind::Error;
            }
            let call: String = types::cat3("`.", name.name.as_str(), "()`");
            if !exec_mode(mode) && name.name != "len" {
                if cx.ghost && mutates {
                    self.ghost_violation(span, call.as_str(), "change the value outside the `proof` block");
                } else {
                    self.c.err("E0503", span, types::cat2(call.as_str(), " is not allowed in a specification").as_str());
                }
            }
            if args.len() != arity {
                self.c.err("E0405", name.span, decls::counts(types::cat3("`", name.name.as_str(), "` takes ").as_str(), arity, " argument(s), found ", args.len(), "").as_str());
            }
            let want: ast::TypeKind = if push {
                et.clone()
            } else {
                ast::TypeKind::Int(ast::IntTy::Usize)
            };
            let hint: Option<ast::TypeKind> = Some(want.clone());
            for j in 0..args.len()
                invariant 0 <= j && j <= args.len(),
            {
                let at: ast::TypeKind = self.expr(cx, &args[j], &hint, mode, f - 1);
                self.expect_ty(&at, &want, args[j].span);
            }
            if mutates && exec_mode(mode) && !writable(cx, recv, 1000000000) && !types::is_error(rt) {
                let need: String = types::cat2(call.as_str(), " needs a mutable `Vec`");
                if is_ref(rt) {
                    self.c.help("E0408", recv.span, need.as_str(), "take the parameter as `&mut Vec<T>`");
                } else {
                    self.c.help("E0408", recv.span, need.as_str(), "declare it with `let mut`");
                }
            }
            ret
        }

        #[summary("while")]
        #[effects(alloc)]
        fn while_stmt(self: &mut Body, cx: &mut FnCtx, w: &ast::While, mode: Mode, f: usize) -> ()
            decreases f * 3,
        {
            if f == 0 {
                return;
            }
            if ghost_mode(mode) {
                self.ghost_loop(w.span);
            } else if !exec_mode(mode) {
                self.spec_loop(w.span);
            }
            let wb: Option<ast::TypeKind> = Some(ast::TypeKind::Bool);
            let ct: ast::TypeKind = self.expr(cx, &w.cond, &wb, operand(mode), f - 1);
            self.expect_ty(&ct, &ast::TypeKind::Bool, w.cond.span);
            let missing: source::Span = source::Span { file: w.span.file, lo: w.span.lo, hi: w.cond.span.hi };
            self.loop_clauses(cx, w.invariants.as_slice(), &w.measure, missing, "while", f - 1);
            cx.loops.push(LoopCx { label: label_name(&w.label), is_loop: false, value: None });
            let wu: Option<ast::TypeKind> = Some(ast::TypeKind::Unit);
            let bt: ast::TypeKind = self.block(cx, &w.body, &wu, mode, f - 1);
            cx.loops.pop();
            self.expect_ty(&bt, &ast::TypeKind::Unit, w.body.span);
        }

        #[summary("`_ =>` 갈래의 E0224와 if let의 E0225: 고침은 match 전체다. 변형마다 갈래 하나를 선언 순서로, 와일드카드의 몸은 그것이 덮던 변형마다")]
        #[effects(alloc)]
        fn wildcard_arms(self: &mut Body, cx: &FnCtx, scrut: &ast::Expr, arms: &[ast::Arm], kinds: &[Option<usize>], tp: &str, vs: &[types::VariantSig], span: source::Span) -> () {
            let mut w: usize = arms.len();
            for i in 0..arms.len()
                invariant 0 <= i && i <= arms.len() && w <= arms.len(),
            {
                if w == arms.len() && (if_let_else(&arms[i].pat) || written(&arms[i].pat) && wild_name(&arms[i].pat)) {
                    w = i;
                }
            }
            if w >= arms.len() {
                return;
            }
            let if_let: bool = if_let_else(&arms[w].pat);
            let mut exact: bool = true;
            for j in 0..arms.len()
                invariant 0 <= j && j <= arms.len(),
            {
                if j != w && j < kinds.len() {
                    let named: bool = match kinds[j] {
                        None => false,
                        Some(q4_k) => true,
                    };
                    if !named || !written(&arms[j].pat) {
                        exact = false;
                    }
                }
            }
            let mut text: String = String::new();
            if exact {
                let wild_body: String = fmt::expr_text(&arms[w].body);
                let mut rows: Vec<String> = Vec::new();
                for k in 0..vs.len()
                    invariant 0 <= k && k <= vs.len(),
                {
                    match kind_at(kinds, k) {
                        None => { let vt: String = variant_text(tp, vs[k].name.as_str(), cx.mod_path.as_str()); rows.push(types::cat3(variant_pat(vt.as_str(), vs[k].tys.len()).as_str(), " => ", wild_body.as_str())); },
                        Some(a) => { if a < arms.len() { rows.push(types::cat3(fmt::pat_str(&arms[a].pat).as_str(), " => ", fmt::expr_text(&arms[a].body).as_str())); } },
                    }
                }
                text = types::cat5("match ", fmt::expr_text(scrut).as_str(), " { ", types::join(rows.as_slice(), ", ").as_str(), " }");
            }
            if if_let {
                if exact {
                    self.c.fixed("E0225", span, "`if let` is not allowed", "`match` with one arm per variant", text.as_str());
                } else {
                    self.c.help("E0225", span, "`if let` is not allowed", "`match` with one arm per variant");
                }
            } else {
                if exact {
                    self.c.fixed("E0224", span, "a wildcard arm is not allowed", "one arm per variant, the wildcard's body on each it stood for", text.as_str());
                } else {
                    self.c.help("E0224", span, "a wildcard arm is not allowed", "one arm per variant, the wildcard's body on each it stood for");
                }
            }
        }

        #[summary("sig의 호출에 쓴 타입 인자 (ADR-0046 §3): impl의 것은 타입 마디 뒤, 함수의 것은 제 이름 뒤. m에 묶고, 빠뜨린 단이 있는가를 돌려준다")]
        #[effects(alloc)]
        fn written_targs(self: &mut Body, cx: &FnCtx, path: &[ast::Ident], targs: &[ast::TArgs], sig: &types::FnSig, m: &mut types::Subst) -> bool {
            let n: usize = path.len();
            if n == 0 {
                return false;
            }
            let ig: usize = sig.impl_generics;
            let is_trait: bool = !no_text(&sig.trait_of);
            let mut own: Vec<types::TParam> = Vec::new();
            let mut theirs: Vec<types::TParam> = Vec::new();
            for i in 0..sig.generics.len()
                invariant 0 <= i && i <= sig.generics.len(),
            {
                if i < ig {
                    if !is_trait {
                        own.push(sig.generics[i].clone());
                    }
                } else {
                    theirs.push(sig.generics[i].clone());
                }
            }
            let has_type: bool = n >= 2;
            let type_seg: usize = if has_type {
                n - 2
            } else {
                0
            };
            let mut missing: bool = self.targs_level(cx, path, targs, is_trait, m, has_type, type_seg, own.as_slice(), true);
            if self.targs_level(cx, path, targs, is_trait, m, true, n - 1, theirs.as_slice(), false) {
                missing = true;
            }
            for i in 0..targs.len()
                invariant 0 <= i && i <= targs.len(),
            {
                if targs[i].seg != n - 1 && !(has_type && targs[i].seg == type_seg) {
                    self.c.err("E0429", targs[i].span, "type arguments follow the type or the function name");
                }
            }
            missing
        }
    }

    #[summary("변수가 인자로 쓰인 호출: 자리, 호출의 경로, 몇 번째 인자인가")]
    struct CallUse { lo: u32, path: Vec<ast::Ident>, k: usize }

    #[summary("검사를 마친 프로그램: 메서드 호출이 경로 호출로 풀리고 상수의 쓰임이 리터럴 나무가 된 프로그램, 검사기의 표, 신뢰되지 않을 수 있는 정의들")]
    struct Checked { program: ast::Program, b: Body, untrusted: Vec<String> }

    #[summary("const의 쓰임마다 그 값의 리터럴 나무로 고쳐 쓰는 손님 (stage0 consts::literal_tree): 마디마다 제 자리(파일 source::CONST_VALUES, next부터)와 타입을 types에 적는다")]
    struct ConstTrees { uses: table::Table<ConstUse>, adts: table::Table<types::Adt>, types: table::Table<ast::TypeKind>, next: u32 }

    impl ConstTrees {
        #[summary("구조체나 변형의 값 d를 타입 ty의 식으로: 필드나 페이로드를 먼저 짓고, 이어서 경로와 필드 이름의 자리를 센다")]
        #[effects(alloc)]
        fn data_tree(self: &mut ConstTrees, d: &consts::Data, ty: &ast::TypeKind, f: usize) -> ast::ExprKind
            decreases f,
        {
            if f == 0 {
                return ast::ExprKind::Error;
            }
            let targs: Vec<ast::TypeKind> = types::named_args(ty);
            let var: String = match &d.variant {
                None => String::new(),
                Some(v) => v.clone(),
            };
            let is_variant: bool = !no_text(&d.variant);
            let mut decl: Vec<ast::TypeKind> = Vec::new();
            if d.ty == "Option" && is_variant && var == "Some" || d.ty == "Result" && is_variant && var == "Ok" {
                if targs.len() > 0 {
                    decl.push(targs[0].clone());
                }
            } else if d.ty == "Result" && is_variant && var == "Err" {
                if targs.len() > 1 {
                    decl.push(targs[1].clone());
                }
            } else if d.ty != "Option" {
                match self.adts.find(d.ty.as_str()) {
                    None => {},
                    Some(at) => { let mut sub: types::Subst = empty_subst(); for i in 0..self.adts.items[at].generics.len() invariant 0 <= i && i <= self.adts.items[at].generics.len(), { if i < targs.len() { sub_put(&mut sub, self.adts.items[at].generics[i].name.as_str(), targs[i].clone()); } } let raw: Vec<ast::TypeKind> = decl_types(&self.adts.items[at].kind, is_variant, var.as_str()); for i in 0..raw.len() invariant 0 <= i && i <= raw.len(), { decl.push(types::subst(&raw[i], &sub)); } },
                }
            }
            let mut names: Vec<String> = Vec::new();
            let mut parts: Vec<ast::Expr> = Vec::new();
            for i in 0..d.fields.len()
                invariant 0 <= i && i <= d.fields.len(),
            {
                if i < decl.len() {
                    let sp: source::Span = self.fresh();
                    names.push(d.fields[i].name.clone());
                    parts.push(self.tree(&d.fields[i].v, &decl[i], sp, f - 1));
                }
            }
            let no_targs: Vec<ast::TArgs> = Vec::new();
            if !is_variant {
                let path: Vec<ast::Ident> = self.segs(d.ty.as_str(), "");
                let mut fields: Vec<ast::FieldInit> = Vec::new();
                for i in 0..parts.len()
                    invariant 0 <= i && i <= parts.len(),
                {
                    if i < names.len() {
                        let place: source::Span = self.fresh();
                        fields.push(ast::FieldInit { name: ast::Ident { name: names[i].clone(), span: place }, value: parts[i].clone() });
                    }
                }
                return ast::ExprKind::StructLit(ast::StructLit { path: path, fields: fields, rest: None });
            }
            if var == "None" && d.ty == "Option" {
                let place: source::Span = self.fresh();
                return ast::ExprKind::Var(ast::Ident { name: String::from("None"), span: place });
            }
            if d.ty == "Option" || d.ty == "Result" {
                let place: source::Span = self.fresh();
                let mut one: Vec<ast::Ident> = Vec::new();
                one.push(ast::Ident { name: var.clone(), span: place });
                return ast::ExprKind::Call(ast::Call { path: one, targs: no_targs, args: parts, method: None });
            }
            let whole: Vec<ast::Ident> = self.segs(d.ty.as_str(), var.as_str());
            if parts.len() == 0 {
                return ast::ExprKind::Path(whole);
            }
            ast::ExprKind::Call(ast::Call { path: whole, targs: no_targs, args: parts, method: None })
        }

        #[summary("새 자리 하나")]
        #[effects(pure)]
        fn fresh(self: &mut ConstTrees) -> source::Span {
            if self.next < 4294967295 {
                self.next = self.next + 1;
            }
            source::Span { file: source::CONST_VALUES, lo: self.next, hi: self.next }
        }

        #[summary("경로 a::b의 마디마다 새 자리의 이름으로, extra가 있으면 그것을 끝에")]
        #[effects(alloc)]
        fn segs(self: &mut ConstTrees, path: &str, extra: &str) -> Vec<ast::Ident> {
            let parts: Vec<String> = refs::split_path(path);
            let mut out: Vec<ast::Ident> = Vec::new();
            for i in 0..parts.len()
                invariant 0 <= i && i <= parts.len(),
            {
                let at: source::Span = self.fresh();
                out.push(ast::Ident { name: parts[i].clone(), span: at });
            }
            if extra.len() > 0 {
                let at: source::Span = self.fresh();
                out.push(ast::Ident { name: String::from(extra), span: at });
            }
            out
        }

        #[summary("검사된 타입 ty의 값 v를 자리 at의 식으로: 리터럴, 배열, 구조체 리터럴과 변형. 검사기가 붙였을 타입을 마디마다 적는다")]
        #[effects(alloc)]
        fn tree(self: &mut ConstTrees, v: &consts::CVal, ty: &ast::TypeKind, at: source::Span, f: usize) -> ast::Expr
            decreases f,
        {
            if f == 0 {
                return ast::Expr { kind: ast::ExprKind::Error, span: at };
            }
            let kind: ast::ExprKind = match v {
                consts::CVal::Int(n, q4_t) => { let mag: ast::ExprKind = ast::ExprKind::Int(wide::U128 { hi: 0, lo: n.mag }, ast::Radix::Dec); if n.neg && n.mag > 0 { ast::ExprKind::Unary(ast::UnOp::Neg, Box::new(ast::Expr { kind: mag, span: at })) } else { mag } },
                consts::CVal::Bool(b) => ast::ExprKind::Bool(*b),
                consts::CVal::Char(c) => ast::ExprKind::CharLit(*c),
                consts::CVal::Array(vs) => { let el: ast::TypeKind = match array_elem(ty) { None => ast::TypeKind::Error, Some(e) => e, }; let mut xs: Vec<ast::Expr> = Vec::new(); for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { let sp: source::Span = self.fresh(); xs.push(self.tree(&vs[i], &el, sp, f - 1)); } ast::ExprKind::Array(xs) },
                consts::CVal::Data(d) => self.data_tree(d, ty, f - 1),
            };
            self.types.insert(span_key(at).as_str(), ty.clone());
            ast::Expr { kind: kind, span: at }
        }
    }

    impl ast::ExprFn for ConstTrees {
        #[effects(alloc)]
        fn expr(self: &mut ConstTrees, e: &mut ast::Expr) -> () {
            match self.uses.find(span_key(e.span).as_str()) {
                None => {},
                Some(i) => { let u: ConstUse = self.uses.items[i].clone(); let made: ast::Expr = self.tree(&u.v, &u.ty, e.span, 1000000000); *e = made; },
            }
        }
    }

    #[summary("해소된 프로그램이 읽을 const의 참조: 값과 타입")]
    struct ConstUse { v: consts::CVal, ty: ast::TypeKind }

    #[summary("몸이 있는 정의 하나: 경로, 단위, 이름의 자리, decreases가 있는가")]
    struct DefRow { path: String, unit: String, span: source::Span, has_dec: bool }

    #[summary("trait 메서드의 호출이 돌리는 함수: impl의 함수와 그 타입 인자 (impl의 것, 이어서 메서드의 것)")]
    struct Dispatched { path: String, args: Vec<ast::TypeKind> }

    #[summary("인스턴스 그래프의 호출 하나, 또는 인스턴스 하나: 정의와 타입 인자")]
    struct Edge { callee: String, args: Vec<ast::TypeKind> }

    #[summary("변수가 쓰인 자리 하나. kind 0은 연산의 한 쪽(other는 다른 쪽, literal은 그것이 리터럴인가), 1은 색인, 2는 push의 받는 쪽(other는 넣는 값)")]
    struct Fact { kind: u8, lo: u32, other: source::Span, literal: bool }

    #[summary("struct_fields의 답")]
    struct Fields { found: bool, path: String, fields: Vec<types::FieldSig> }

    #[summary("first_index_on의 손님: 가장 앞 자리의 name[var]")]
    struct FirstIndex { var: String, found: bool, at: source::Span }

    impl ast::ExprFn for FirstIndex {
        #[effects(alloc)]
        fn expr(self: &mut FirstIndex, e: &mut ast::Expr) -> () {
            if index_on(e, self.var.as_str()) && (!self.found || e.span.lo < self.at.lo) {
                self.found = true;
                self.at = e.span;
            }
        }
    }

    #[summary("함수 하나를 검사하는 동안의 문맥. scopes는 안쪽이 뒤, all_names는 지금까지 묶은 이름, reserved는 몸이 묶을 수 없는 이름(ensures의 결과 이름), loops는 둘러싼 루프(안쪽이 뒤), needs는 효과마다 처음 요구한 자리")]
    struct FnCtx { path: String, mod_path: String, effect: types::Effects, scopes: Vec<Vec<Local>>, all_names: Vec<String>, reserved: Vec<String>, forall_depth: usize, ret: ast::TypeKind, loops: Vec<LoopCx>, for_vars: Vec<String>, ghost: bool, needs: Vec<Need>, own: types::Effects }

    #[summary("method_target의 결과: 이름하는 함수가 없음, 여기서 알림, 찾은 함수")]
    enum Found { No, Reported, Target(MethodTarget) }

    #[summary("타입 인자가 있는 호출 하나: 부르는 함수, 불리는 함수, 자리, 타입 인자")]
    struct GCall { caller: String, callee: String, span: source::Span, args: Vec<ast::TypeKind> }

    #[summary("범위의 이름 하나")]
    struct Local { name: String, ty: ast::TypeKind, mutable: bool, is_param: bool }

    #[summary("break나 continue가 가리킬 수 있는 루프. is_loop는 값을 낼 수 있는 loop, value는 본 break 값의 타입")]
    struct LoopCx { label: Option<String>, is_loop: bool, value: Option<ast::TypeKind> }

    #[summary("메서드 호출이 이름하는 함수 (ADR-0051), 뒤 단계가 읽는 경로 호출의 꼴로: path::<type_args>::f(adjust(x), ..). type_args는 타입의 매개변수의 인자(제네릭 타입의 impl)로, 이름 앞 마디 뒤에 쓴다")]
    struct MethodTarget { path: Vec<String>, type_args: Vec<ast::TypeKind>, adjust: ast::Adjust }

    #[summary("메서드 호출 x.f(..)를 그것이 뜻하는 경로 호출로 고쳐 쓰는 손님 (ADR-0051)")]
    struct Methodize { methods: table::Table<MethodTarget> }

    impl ast::ExprFn for Methodize {
        #[effects(alloc)]
        fn expr(self: &mut Methodize, e: &mut ast::Expr) -> () {
            match self.methods.find(span_key(e.span).as_str()) {
                None => {},
                Some(i) => { match method_of(e) { None => {}, Some(m) => { let call: ast::Expr = method_call(&*m.recv, &m.name, m.args.as_slice(), &self.methods.items[i], e.span); *e = call; }, } },
            }
        }
    }

    #[summary("검사하는 자리: 실행 코드, 명세(Spec의 값은 old를 쓸 수 있는가), 유령 코드")]
    enum Mode { Exec, Spec(bool), Ghost }

    #[summary("&mut 인자가 출발하는 변수와 그 인자의 차례")]
    struct MutRoot { root: String, at: usize }

    #[summary("효과 e를 처음 요구한 것")]
    struct Need { e: types::Effects, what: String }

    #[summary("실행 정의의 효과: 제 연산의 것과 몸이 요구하는 것")]
    struct Needs { own: types::Effects, body: types::Effects }

    #[summary("타입 없는 let: 이름과, 초기값이 Vec::new()인가")]
    struct OpenLet { name: ast::Ident, vec_new: bool }

    struct Pair { from: String, to: String }

    #[summary("자리의 타입과 쓸 수 있는가")]
    struct Place { ty: ast::TypeKind, writable: bool }

    #[summary("한정자를 찾는 손님")]
    struct Quants { found: bool }

    impl ast::ExprFn for Quants {
        #[effects(alloc)]
        fn expr(self: &mut Quants, e: &mut ast::Expr) -> () {
            if is_quant(&e.kind) {
                self.found = true;
            }
        }
    }

    #[summary("강한 연결 성분을 찾는 걸음의 상태 (Tarjan)")]
    struct Scc { index: table::Table<usize>, low: table::Table<usize>, on: Vec<String>, stack: Vec<String>, next: usize, out: Vec<Vec<String>> }

    #[summary("&s[a..b]의 글과 두 끝")]
    struct SliceOf { base: ast::Expr, lo: ast::Expr, hi: ast::Expr }

    #[summary("check_slots의 한 자리: at은 인자(또는 필드)의 차례, ty는 선언된 타입")]
    struct Slot { at: usize, ty: ast::TypeKind }

    #[summary("타입을 쓴 let의 초기값 전체로 쓰인 지역 변수: 이름, 자리, 선언한 타입")]
    struct TypedUse { name: String, lo: u32, ty: ast::TypeKind }

    #[summary("타입 없는 let의 변수 name이 after 뒤에서 쓰인 자리를 모으는 손님. spec_at은 명세로 검사한 식의 자리(그 정수는 수학의 것이라 타입을 말하지 않는다)")]
    struct Uses { name: String, after: u32, vec_new: bool, spec_at: Vec<source::Span>, facts: Vec<Fact>, calls: Vec<CallUse> }

    impl Uses {
        #[summary("e가 그 변수를 쓴 자리인가")]
        #[effects(alloc)]
        fn is_var(self: &Uses, e: &ast::Expr) -> bool {
            match ast::var_name(e) {
                None => false,
                Some(v) => v == self.name && e.span.lo > self.after && !has_span(self.spec_at.as_slice(), e.span),
            }
        }
    }

    impl ast::ExprFn for Uses {
        #[effects(alloc)]
        fn expr(self: &mut Uses, e: &mut ast::Expr) -> () {
            match &e.kind {
                ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => {},
                ast::ExprKind::Float(q4_ek_float0) => {},
                ast::ExprKind::ByteLit(q4_ek_bytelit0) => {},
                ast::ExprKind::ByteStr(q4_ek_bytestr0) => {},
                ast::ExprKind::StrLit(q4_ek_strlit0) => {},
                ast::ExprKind::CharLit(q4_ek_charlit0) => {},
                ast::ExprKind::Bool(q4_ek_bool0) => {},
                ast::ExprKind::Unit => {},
                ast::ExprKind::Var(q4_ek_var0) => {},
                ast::ExprKind::Call(c) => { for i in 0..c.args.len() invariant 0 <= i && i <= c.args.len(), { if self.is_var(&c.args[i]) { self.calls.push(CallUse { lo: c.args[i].span.lo, path: c.path.clone(), k: i }); } } },
                ast::ExprKind::Method(m) => { if self.vec_new && m.name.name == "push" && self.is_var(&*m.recv) && m.args.len() == 1 && !is_int_kind(&m.args[0].kind) { self.facts.push(Fact { kind: 2, lo: m.recv.span.lo, other: m.args[0].span, literal: false }); } },
                ast::ExprKind::Index(q4_ek_index0, index) => { if !self.vec_new && self.is_var(&**index) { self.facts.push(Fact { kind: 1, lo: index.span.lo, other: index.span, literal: false }); } },
                ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => {},
                ast::ExprKind::Binary(op, a, b) => { if !self.vec_new && (is_arith(*op) || is_cmp(*op) || is_bit(*op)) { if self.is_var(&**a) { self.facts.push(Fact { kind: 0, lo: a.span.lo, other: b.span, literal: is_int_kind(&b.kind) }); } else if self.is_var(&**b) { self.facts.push(Fact { kind: 0, lo: b.span.lo, other: a.span, literal: is_int_kind(&a.kind) }); } } },
                ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => {},
                ast::ExprKind::If(q4_ek_if0) => {},
                ast::ExprKind::Block(q4_ek_block0) => {},
                ast::ExprKind::Array(q4_ek_array0) => {},
                ast::ExprKind::Repeat(q4_ek_repeat0) => {},
                ast::ExprKind::Old(q4_ek_old0) => {},
                ast::ExprKind::Quant(q4_ek_quant0) => {},
                ast::ExprKind::Trigger(q4_ek_trigger0) => {},
                ast::ExprKind::Closure(q4_ek_closure0) => {},
                ast::ExprKind::StructLit(q4_ek_structlit0) => {},
                ast::ExprKind::Path(q4_ek_path0) => {},
                ast::ExprKind::Deref(q4_ek_deref0) => {},
                ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => {},
                ast::ExprKind::Match(q4_ek_match0) => {},
                ast::ExprKind::Return(q4_ek_return0) => {},
                ast::ExprKind::Try(q4_ek_try0) => {},
                ast::ExprKind::Loop(q4_ek_loop0) => {},
                ast::ExprKind::Break(q4_ek_break0) => {},
                ast::ExprKind::Continue(q4_ek_continue0) => {},
                ast::ExprKind::Range(q4_ek_range0) => {},
                ast::ExprKind::Error => {},
            }
        }
    }

    #[summary("경로가 가리킨 변형: 열거형의 경로, 변형의 차례, 페이로드의 타입")]
    struct VariantAt { found: bool, tp: String, k: usize, payload: Vec<ast::TypeKind> }

    #[summary("match가 덮을 변형들: 타입의 경로와 선언 순서의 변형 (Option은 None, Some; Result는 Ok, Err)")]
    struct Variants { found: bool, path: String, vs: Vec<types::VariantSig> }

    #[summary("slice_of_vec의 결과: Vec에 관한 인자인가, 그렇다면 출발하는 변수")]
    struct VecSlice { about: bool, root: Option<String> }

    #[effects(alloc)]
    fn add_edge(edges: &mut table::Table<Vec<Edge>>, from: &str, e: Edge) -> () {
        let mut es: Vec<Edge> = match edges.find(from) {
            None => Vec::new(),
            Some(at) => edges.items[at].clone(),
        };
        es.push(e);
        edges.insert(from, es);
    }

    #[summary("구조체의 필드 타입들이나 열거형의 페이로드 타입들")]
    #[effects(alloc)]
    fn adt_parts(k: &types::AdtKind) -> Vec<ast::TypeKind> {
        let mut out: Vec<ast::TypeKind> = Vec::new();
        match k {
            types::AdtKind::Struct(fs) => { for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { out.push(fs[i].ty.clone()); } },
            types::AdtKind::Enum(vs) => { for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { for j in 0..vs[i].tys.len() invariant 0 <= j && j <= vs[i].tys.len(), { out.push(vs[i].tys[j].clone()); } } },
        }
        out
    }

    #[summary("lo + 4 (loop 낱말의 끝)")]
    #[effects(pure)]
    fn after4(lo: u32) -> u32 {
        if lo < 4294967291 {
            lo + 4
        } else {
            lo
        }
    }

    #[summary("ps의 매개변수가 모두 tm에 오류 아닌 타입으로 묶였는가")]
    #[effects(alloc)]
    fn all_bound(ps: &[types::TParam], tm: &types::Subst) -> bool {
        for i in 0..ps.len()
            invariant 0 <= i && i <= ps.len(),
        {
            if types::is_error(&bound_or_error(tm, ps[i].name.as_str())) {
                return false;
            }
        }
        true
    }

    #[effects(pure)]
    fn alloc_effect() -> types::Effects {
        types::Effects { alloc: true, io: false, nondet: false, panic: false }
    }

    #[summary("bound의 이름 가운데 e가 말하는 것이 있는가")]
    #[effects(pure)]
    fn any_bound(e: &ast::Expr, bound: &[String]) -> bool {
        for i in 0..bound.len()
            invariant 0 <= i && i <= bound.len(),
        {
            if mentions(e, bound[i].as_str(), 1000000000) {
                return true;
            }
        }
        false
    }

    #[summary("xs 가운데 ys에 든 것이 있는가")]
    #[effects(pure)]
    fn any_in(xs: &[String], ys: &[String]) -> bool {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if types::has(ys, xs[i].as_str()) {
                return true;
            }
        }
        false
    }

    #[summary("xs 가운데 하나가 name을 말하는가 (strict면 mentions_strict로)")]
    #[effects(pure)]
    fn any_mentions(xs: &[ast::Expr], name: &str, strict: bool, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if strict {
                if mentions_strict(&xs[i], name, f - 1) {
                    return true;
                }
            } else {
                if mentions(&xs[i], name, f - 1) {
                    return true;
                }
            }
        }
        false
    }

    #[summary("정수의 산술 메서드: wrapping_*, saturating_*, checked_* (ADR-0028 §3)")]
    #[effects(pure)]
    fn arith_method(m: &str) -> bool {
        m == "wrapping_add" || m == "wrapping_sub" || m == "wrapping_mul" || m == "saturating_add" || m == "saturating_sub" || m == "saturating_mul" || checked_arith(m)
    }

    #[summary("배열 타입이면 그 원소의 타입")]
    #[effects(alloc)]
    fn array_elem(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(el, q4_n) => Some(el.kind.clone()),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => None,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(q4_tk_vec0) => None,
            ast::TypeKind::Box(q4_tk_box0) => None,
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("s.as_bytes() (인자 없음)면 s")]
    #[effects(alloc)]
    fn as_bytes_of(e: &ast::Expr) -> Option<ast::Expr> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(q4_ek_call0) => None,
            ast::ExprKind::Method(m) => { if m.name.name == "as_bytes" && m.args.len() == 0 { Some((*m.recv).clone()) } else { None } },
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(q4_ek_deref0) => None,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("x.as_str() 꼴인가")]
    #[effects(pure)]
    fn as_str_call(e: &ast::Expr) -> bool {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => false,
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(m) => m.name.name == "as_str",
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => false,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => false,
            ast::ExprKind::Block(q4_ek_block0) => false,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => false,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => false,
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => false,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[summary("e가 x.as_str(..)면 그 메서드 호출")]
    #[effects(alloc)]
    fn as_str_of(e: &ast::Expr) -> Option<ast::Method> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(q4_ek_call0) => None,
            ast::ExprKind::Method(m) => { if m.name.name == "as_str" { Some(m.clone()) } else { None } },
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(q4_ek_deref0) => None,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("표에서 k의 수, 없으면 0")]
    #[effects(alloc)]
    fn at_or_zero(t: &table::Table<usize>, k: &str) -> usize {
        match t.find(k) {
            None => 0,
            Some(i) => t.items[i],
        }
    }

    #[summary("lo가 더 앞이면 고른 것을 바꾼다")]
    #[effects(alloc)]
    fn better(best: &mut Best, lo: u32, t: &ast::TypeKind) -> () {
        if !best.found || lo < best.lo {
            best.found = true;
            best.lo = lo;
            best.ty = t.clone();
        }
    }

    #[summary("값을 내는 연산이 틀렸으면 오류 타입, 견줌이면 bool")]
    #[effects(pure)]
    fn bin_fail(valued: bool) -> ast::TypeKind {
        if valued {
            ast::TypeKind::Error
        } else {
            ast::TypeKind::Bool
        }
    }

    #[summary("비트 메서드 m이 세는 것인가 (0..=w의 u32)")]
    #[effects(pure)]
    fn bit_count(m: &str) -> bool {
        m == "count_ones" || m == "count_zeros" || m == "leading_zeros" || m == "trailing_zeros" || m == "leading_ones" || m == "trailing_ones"
    }

    #[summary("정수의 비트 메서드 m (ADR-0048 §2): 0은 아님, 1은 인자 없음(세기, swap_bytes, reverse_bits, is_power_of_two), 2는 u32 양 하나(회전, wrapping·checked 밀기)")]
    #[effects(pure)]
    fn bit_method(m: &str) -> u8 {
        if m == "rotate_left" || m == "rotate_right" || m == "wrapping_shl" || m == "wrapping_shr" || m == "checked_shl" || m == "checked_shr" {
            2
        } else if m == "swap_bytes" || m == "reverse_bits" || m == "is_power_of_two" || bit_count(m) {
            1
        } else {
            0
        }
    }

    #[summary("정수 타입의 비트 수")]
    #[effects(pure)]
    fn bits(t: ast::IntTy) -> u32 {
        match t {
            ast::IntTy::I8 => 8,
            ast::IntTy::I16 => 16,
            ast::IntTy::I32 => 32,
            ast::IntTy::I64 => 64,
            ast::IntTy::Isize => 64,
            ast::IntTy::U8 => 8,
            ast::IntTy::U16 => 16,
            ast::IntTy::U32 => 32,
            ast::IntTy::U64 => 64,
            ast::IntTy::Usize => 64,
        }
    }

    #[summary("블록의 문장이나 꼬리가 name을 말하는가")]
    #[effects(pure)]
    fn block_mentions(b: &ast::Block, name: &str, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        for i in 0..b.stmts.len()
            invariant 0 <= i && i <= b.stmts.len(),
        {
            if stmt_mentions(&b.stmts[i], name, f - 1) {
                return true;
            }
        }
        opt_mentions(&b.tail, name, true, f - 1)
    }

    #[summary("tm이 n에 묶은 타입, 없으면 Error")]
    #[effects(alloc)]
    fn bound_or_error(tm: &types::Subst, n: &str) -> ast::TypeKind {
        match types::sub_get(tm, n) {
            None => ast::TypeKind::Error,
            Some(t) => t,
        }
    }

    #[summary("t가 Box면 담은 타입")]
    #[effects(alloc)]
    fn box_inner(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => None,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => None,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(q4_tk_vec0) => None,
            ast::TypeKind::Box(e) => Some(e.kind.clone()),
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("m이 어떤 내장 타입의 내장 메서드 이름인가: 내장 타입에서 그 이름의 trait 메서드는 경로로 부른다")]
    #[effects(pure)]
    fn builtin_method_name(m: &str) -> bool {
        m == "len" || m == "is_char_boundary" || m == "push_str" || m == "push" || m == "pop" || m == "truncate" || m == "clone" || m == "as_str" || m == "as_bytes" || m == "as_slice" || m == "as_mut_slice" || m == "copy_within" || m == "len_utf8" || m == "unwrap" || m == "expect" || m == "ok" || m == "to_be_bytes" || m == "to_le_bytes" || arith_method(m) || bit_method(m) > 0 || f64_sig(m) > 0
    }

    #[summary("Option::Some, Option::None, Result::Ok, Result::Err: 내장 변형을 타입과 함께 쓴 경로인가")]
    #[effects(pure)]
    fn builtin_path(segs: &[ast::Ident]) -> bool {
        segs.len() == 2 && (segs[0].name == "Option" && (segs[1].name == "Some" || segs[1].name == "None") || segs[0].name == "Result" && (segs[1].name == "Ok" || segs[1].name == "Err"))
    }

    #[summary("성분들을 첫 원소의 순서로 (성분은 서로 겹치지 않고 저마다 정렬되어 있어, 이것이 stage0의 Vec<Vec<String>> 정렬이다)")]
    #[effects(alloc)]
    fn by_first(xs: &[Vec<String>]) -> Vec<Vec<String>> {
        let mut out: Vec<Vec<String>> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            let mut at: usize = out.len();
            for j in 0..out.len()
                invariant 0 <= j && j <= out.len() && at <= out.len(),
            {
                if at == out.len() && comp_lt(xs[i].as_slice(), out[j].as_slice()) {
                    at = j;
                }
            }
            let mut next: Vec<Vec<String>> = Vec::new();
            for j in 0..out.len()
                invariant 0 <= j && j <= out.len(),
            {
                if j == at {
                    next.push(xs[i].clone());
                }
                next.push(out[j].clone());
            }
            if at == out.len() {
                next.push(xs[i].clone());
            }
            out = next;
        }
        out
    }

    #[summary("main들을 글의 순서(파일, 시작)로. 같은 자리는 온 순서를 지킨다")]
    #[effects(alloc)]
    fn by_place(xs: &[ast::FnDef]) -> Vec<ast::FnDef> {
        let mut out: Vec<ast::FnDef> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            let mut at: usize = out.len();
            for j in 0..out.len()
                invariant 0 <= j && j <= out.len() && at <= out.len(),
            {
                if at == out.len() && place_lt(xs[i].name.span, out[j].name.span) {
                    at = j;
                }
            }
            let mut next: Vec<ast::FnDef> = Vec::new();
            for j in 0..out.len()
                invariant 0 <= j && j <= out.len(),
            {
                if j == at {
                    next.push(xs[i].clone());
                }
                next.push(out[j].clone());
            }
            if at == out.len() {
                next.push(xs[i].clone());
            }
            out = next;
        }
        out
    }

    #[summary("&[u8]")]
    #[effects(alloc)]
    fn bytes_ref() -> ast::TypeKind {
        ast::TypeKind::Ref(false, types::boxed(ast::TypeKind::Slice(types::boxed(ast::TypeKind::Int(ast::IntTy::U8)))))
    }

    #[summary("정수의 바이트들의 타입: [u8; w / 8]")]
    #[effects(alloc)]
    fn bytes_ty(i: ast::IntTy) -> ast::TypeKind {
        ast::TypeKind::Array(types::boxed(ast::TypeKind::Int(ast::IntTy::U8)), (bits(i) / 8) as u64)
    }

    #[summary("e가 호출이면 그 호출")]
    #[effects(alloc)]
    fn call_of(e: &ast::Expr) -> Option<ast::Call> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(c) => Some(c.clone()),
            ast::ExprKind::Method(q4_ek_method0) => None,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(q4_ek_deref0) => None,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("x as t의 글: x가 변환보다 느슨하게 묶이면 괄호로 싼다 (stage0 fmt::cast_text)")]
    #[effects(alloc)]
    fn cast_text(x: &ast::Expr, t: &str) -> String {
        let xs: String = fmt::expr_text(x);
        if fmt::prec(x) < 11 {
            types::cat4("(", xs.as_str(), ") as ", t)
        } else {
            types::cat3(xs.as_str(), " as ", t)
        }
    }

    #[summary("모르는 char 메서드 m의 고침 글 (없으면 빈 글)")]
    #[effects(alloc)]
    fn char_missing(m: &str) -> String {
        if m == "to_digit" || m == "is_digit" || m == "is_ascii_digit" || m == "is_alphabetic" || m == "is_whitespace" {
            return String::from("compare the scalar value: `'0' <= c && c <= '9'`");
        }
        if m == "to_string" {
            return String::from("build a `String` and `push(c)`");
        }
        String::new()
    }

    #[summary("프로그램 p를 검사한다 (stage0 check::check_resolved): 함수 값을 낮추고 상수를 푼 뒤, 쓴 사람의 함수의 메서드 호출(ADR-0051)을 경로 호출로 고쳐 쓰며 하나도 남지 않을 때까지 다시 검사한다. 진단은 마지막 검사의 것이다")]
    #[effects(alloc)]
    fn check_resolved(p: ast::Program, diags: &mut diag::Diags) -> Checked {
        let mut program: ast::Program = p;
        let lowered: closures::Lowered = closures::lower(&mut program, diags);
        let consts: table::Table<consts::Const> = consts::resolve(&mut program, diags);
        let base: Vec<diag::Diag> = diags.items.clone();
        let mut b: Body = checked(&program, &consts, base.as_slice());
        let mut fuel: usize = 1000000;
        while b.methods.len() > 0 && fuel > 0
            invariant 0 <= fuel,
            decreases fuel,
        {
            fuel = fuel - 1;
            let mut g: Methodize = Methodize { methods: b.methods.clone() };
            ast::exprs_mut::<Methodize>(&mut program, &mut g);
            b = checked(&program, &consts, base.as_slice());
        }
        for i in 0..b.aliases.len()
            invariant 0 <= i && i <= b.aliases.len(),
        {
            diags.aliases.push(b.aliases[i].clone());
        }
        diags.items = once_each(b.c.diags.as_slice(), lowered.quiet.as_slice());
        let mut trees: ConstTrees = ConstTrees { uses: b.const_uses.clone(), adts: b.c.adts.clone(), types: b.types.clone(), next: 0 };
        ast::exprs_mut::<ConstTrees>(&mut program, &mut trees);
        b.types = trees.types;
        let untrusted: Vec<String> = b.may_untrusted();
        Checked { program: program, b: b, untrusted: untrusted }
    }

    #[summary("프로그램을 한 번 검사한 검사기. 진단은 그 앞 단계의 것(base)에서 시작한다: 상수의 검사가 평가기의 진단을 거기서 뺀다")]
    #[effects(alloc)]
    fn checked(p: &ast::Program, consts: &table::Table<consts::Const>, base: &[diag::Diag]) -> Body {
        let mut c: decls::Checker = decls::new();
        for i in 0..base.len()
            invariant 0 <= i && i <= base.len(),
        {
            c.diags.push(base[i].clone());
        }
        let mut b: Body = new(c, consts.clone());
        b.check_program(p);
        b
    }

    #[summary("checked_add, checked_sub, checked_mul, checked_div, checked_rem: 결과가 범위 안일 때만 Some")]
    #[effects(pure)]
    fn checked_arith(m: &str) -> bool {
        m == "checked_add" || m == "checked_sub" || m == "checked_mul" || m == "checked_div" || m == "checked_rem"
    }

    #[summary("언어가 t의 clone을 짓지 않는 까닭 (ADR-0141 §2), 지으면 빈 글: Copy 없는 타입 매개변수를 말하거나 자식 프로세스를 든다")]
    #[effects(alloc)]
    fn clone_blocked(t: &ast::TypeKind, adts: &table::Table<types::Adt>, moving: &[String]) -> String {
        if names_moving(t, moving, 100000) {
            return String::from("a type parameter without `Copy` may own memory: copy the value where its type is known, or bound the parameter with `Copy`");
        }
        let mut seen: Vec<String> = Vec::new();
        if holds_child(t, adts, &mut seen, 100000) {
            return String::from("a child process is one resource with one owner; it is not copied");
        }
        String::new()
    }

    #[summary("한정의 몸에서 #[trigger] 항들을 모은다 (안쪽 한정으로는 들어가지 않는다)")]
    #[effects(alloc)]
    fn collect_triggers(e: &ast::Expr, out: &mut Vec<ast::Expr>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => {},
            ast::ExprKind::Float(q4_ek_float0) => {},
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => {},
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => {},
            ast::ExprKind::StrLit(q4_ek_strlit0) => {},
            ast::ExprKind::CharLit(q4_ek_charlit0) => {},
            ast::ExprKind::Bool(q4_ek_bool0) => {},
            ast::ExprKind::Unit => {},
            ast::ExprKind::Var(q4_ek_var0) => {},
            ast::ExprKind::Call(c) => triggers_each(c.args.as_slice(), out, f - 1),
            ast::ExprKind::Method(m) => { collect_triggers(&*m.recv, out, f - 1); triggers_each(m.args.as_slice(), out, f - 1); },
            ast::ExprKind::Index(x, y) => { collect_triggers(&**x, out, f - 1); collect_triggers(&**y, out, f - 1); },
            ast::ExprKind::Unary(q4_op, x) => collect_triggers(&**x, out, f - 1),
            ast::ExprKind::Binary(q4_bop, x, y) => { collect_triggers(&**x, out, f - 1); collect_triggers(&**y, out, f - 1); },
            ast::ExprKind::Ref(q4_m, x) => collect_triggers(&**x, out, f - 1),
            ast::ExprKind::If(ife) => { collect_triggers(&*ife.cond, out, f - 1); triggers_opt(&ife.then.tail, out, f - 1); triggers_opt(&ife.els, out, f - 1); },
            ast::ExprKind::Block(b) => triggers_opt(&b.tail, out, f - 1),
            ast::ExprKind::Array(xs) => triggers_each(xs.as_slice(), out, f - 1),
            ast::ExprKind::Repeat(rp) => collect_triggers(&*rp.value, out, f - 1),
            ast::ExprKind::Old(x) => collect_triggers(&**x, out, f - 1),
            ast::ExprKind::Quant(q4_ek_quant0) => {},
            ast::ExprKind::Trigger(x) => { out.push((**x).clone()); collect_triggers(&**x, out, f - 1); },
            ast::ExprKind::Closure(q4_ek_closure0) => {},
            ast::ExprKind::StructLit(sl) => { for i in 0..sl.fields.len() invariant 0 <= i && i <= sl.fields.len(), { collect_triggers(&sl.fields[i].value, out, f - 1); } },
            ast::ExprKind::Path(q4_ek_path0) => {},
            ast::ExprKind::Deref(x) => collect_triggers(&**x, out, f - 1),
            ast::ExprKind::Field(x, q4_id) => collect_triggers(&**x, out, f - 1),
            ast::ExprKind::Match(ma) => { collect_triggers(&*ma.scrut, out, f - 1); for j in 0..ma.arms.len() invariant 0 <= j && j <= ma.arms.len(), { collect_triggers(&ma.arms[j].body, out, f - 1); } },
            ast::ExprKind::Return(q4_ek_return0) => {},
            ast::ExprKind::Try(x) => collect_triggers(&**x, out, f - 1),
            ast::ExprKind::Loop(q4_ek_loop0) => {},
            ast::ExprKind::Break(q4_ek_break0) => {},
            ast::ExprKind::Continue(q4_ek_continue0) => {},
            ast::ExprKind::Range(r) => { collect_triggers(&*r.lo, out, f - 1); collect_triggers(&*r.hi, out, f - 1); },
            ast::ExprKind::Error => {},
        }
    }

    #[summary("글의 목록 a가 b보다 앞인가 (사전 순서)")]
    #[effects(pure)]
    fn comp_lt(a: &[String], b: &[String]) -> bool {
        for i in 0..a.len()
            invariant 0 <= i && i <= a.len(),
        {
            if i >= b.len() {
                return false;
            }
            if a[i].as_str() < b[i].as_str() {
                return true;
            }
            if b[i].as_str() < a[i].as_str() {
                return false;
            }
        }
        a.len() < b.len()
    }

    #[summary("T::try_from(x) 꼴인가 (T는 정수 타입)")]
    #[effects(pure)]
    fn conv_call(e: &ast::Expr) -> bool {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => false,
            ast::ExprKind::Call(c) => c.path.len() == 2 && c.path[1].name == "try_from" && types::int_name(c.path[0].name.as_str()),
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => false,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => false,
            ast::ExprKind::Block(q4_ek_block0) => false,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => false,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => false,
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => false,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[summary("source에서 target으로의 변환에 범위 의무가 있는가: 정수가 아니거나 source의 값이 모두 target의 값이지는 않다")]
    #[effects(pure)]
    fn conv_obligation(source: &ast::TypeKind, target: &ast::TypeKind) -> bool {
        match int_of(source) {
            None => true,
            Some(s) => { match int_of(target) { None => true, Some(t) => !fits(s, t), } },
        }
    }

    #[summary("선언의 필드나 페이로드의 타입들: 구조체의 필드, 또는 변형 var의 페이로드")]
    #[effects(alloc)]
    fn decl_types(k: &types::AdtKind, is_variant: bool, var: &str) -> Vec<ast::TypeKind> {
        let mut out: Vec<ast::TypeKind> = Vec::new();
        match k {
            types::AdtKind::Struct(fs) => { if !is_variant { for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { out.push(fs[i].ty.clone()); } } },
            types::AdtKind::Enum(vs) => { if is_variant { let mut found: bool = false; for i in 0..vs.len() invariant 0 <= i && i <= vs.len(), { if !found && vs[i].name.as_str() == var { found = true; for j in 0..vs[i].tys.len() invariant 0 <= j && j <= vs[i].tys.len(), { out.push(vs[i].tys[j].clone()); } } } } },
        }
        out
    }

    #[summary("#[effects(..)]에 io가 있는가")]
    #[effects(pure)]
    fn declares_io(attrs: &[ast::Attr]) -> bool {
        for i in 0..attrs.len()
            invariant 0 <= i && i <= attrs.len(),
        {
            if attrs[i].name.name == "effects" {
                for j in 0..attrs[i].args.len()
                    invariant 0 <= j && j <= attrs[i].args.len(),
                {
                    if io_arg(&attrs[i].args[j]) {
                        return true;
                    }
                }
            }
        }
        false
    }

    #[effects(alloc)]
    fn def_row(path: String, unit: &str, d: &ast::FnDef) -> DefRow {
        let has_dec: bool = match &d.measure {
            None => false,
            Some(e) => true,
        };
        DefRow { path: path, unit: String::from(unit), span: d.name.span, has_dec: has_dec }
    }

    #[summary("몸이 있는 모든 정의를 걷는 순서로 (단위마다 안의 단위 먼저, 이어서 함수, impl T의 함수, trait impl의 함수, 기본 메서드의 몸). trait impl의 함수는 검사기가 준 경로(<T as Trait>::f)를 갖고, 거절된 것은 빠진다")]
    #[effects(alloc)]
    fn defs_of(p: &ast::Program, fns: &table::Table<types::FnSig>) -> Vec<DefRow> {
        let mut by_span: table::Table<String> = table::new::<String>();
        let total: usize = fns.len();
        for n in 0..total
            invariant 0 <= n && n <= total,
        {
            match fns.nth(n) {
                None => {},
                Some(at) => { if fns.items[at].in_impl && impl_path(fns.items[at].path.as_str()) { by_span.insert(span_key(fns.items[at].span).as_str(), fns.items[at].path.clone()); } },
            }
        }
        let mut out: Vec<DefRow> = Vec::new();
        for i in 0..p.mods.len()
            invariant 0 <= i && i <= p.mods.len(),
        {
            defs_walk(&p.mods[i], "", &by_span, &mut out, 100000);
        }
        out
    }

    #[effects(alloc)]
    fn defs_walk(m: &ast::Mod, prefix: &str, by_span: &table::Table<String>, out: &mut Vec<DefRow>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mp: String = types::cat2(prefix, m.name.name.as_str());
        let sub: String = types::cat2(mp.as_str(), "::");
        for i in 0..m.mods.len()
            invariant 0 <= i && i <= m.mods.len(),
        {
            defs_walk(&m.mods[i], sub.as_str(), by_span, out, f - 1);
        }
        for i in 0..m.fns.len()
            invariant 0 <= i && i <= m.fns.len(),
        {
            out.push(def_row(types::cat2(sub.as_str(), m.fns[i].name.name.as_str()), mp.as_str(), &m.fns[i]));
        }
        for i in 0..m.impls.len()
            invariant 0 <= i && i <= m.impls.len(),
        {
            for j in 0..m.impls[i].fns.len()
                invariant 0 <= j && j <= m.impls[i].fns.len(),
            {
                out.push(def_row(types::cat4(sub.as_str(), m.impls[i].ty.name.as_str(), "::", m.impls[i].fns[j].name.name.as_str()), mp.as_str(), &m.impls[i].fns[j]));
            }
        }
        for i in 0..m.trait_impls.len()
            invariant 0 <= i && i <= m.trait_impls.len(),
        {
            for j in 0..m.trait_impls[i].fns.len()
                invariant 0 <= j && j <= m.trait_impls[i].fns.len(),
            {
                match by_span.find(span_key(m.trait_impls[i].fns[j].span).as_str()) {
                    None => {},
                    Some(at) => { out.push(def_row(by_span.items[at].clone(), mp.as_str(), &m.trait_impls[i].fns[j])); },
                }
            }
        }
        for i in 0..m.traits.len()
            invariant 0 <= i && i <= m.traits.len(),
        {
            for j in 0..m.traits[i].fns.len()
                invariant 0 <= j && j <= m.traits[i].fns.len(),
            {
                if m.traits[i].fns[j].has_body {
                    out.push(def_row(types::cat4(sub.as_str(), m.traits[i].name.name.as_str(), "::", m.traits[i].fns[j].f.name.name.as_str()), mp.as_str(), &m.traits[i].fns[j].f));
                }
            }
        }
    }

    #[summary("e가 *x면 x")]
    #[effects(alloc)]
    fn deref_inner(e: &ast::Expr) -> Option<ast::Expr> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(q4_ek_call0) => None,
            ast::ExprKind::Method(q4_ek_method0) => None,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(x) => Some((**x).clone()),
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("타입 인자 args(Self가 처음)로 부른 trait 메서드 target이 돌리는 함수: impl의 함수와 그 타입 인자. target이 trait 메서드가 아니거나 Self가 타입 매개변수면(trait의 시그니처가 대신한다) None")]
    #[effects(alloc)]
    fn dispatch(fns: &table::Table<types::FnSig>, impls: &[types::TraitImplInfo], target: &str, args: &[ast::TypeKind]) -> Option<Dispatched> {
        let at: usize = match fns.find(target) {
            None => { return None; },
            Some(i) => i,
        };
        let tr: String = match &fns.items[at].trait_of {
            None => { return None; },
            Some(p) => p.clone(),
        };
        let segs: Vec<String> = refs::split_path(target);
        if args.len() == 0 || segs.len() == 0 {
            return None;
        }
        for k in 0..impls.len()
            invariant 0 <= k && k <= impls.len(),
        {
            if impls[k].trait_path == tr {
                match types::matches(&impls[k], &args[0]) {
                    None => {},
                    Some(m) => { let path: String = types::fn_path(&impls[k], segs[segs.len() - 1].as_str()); let mut out: Vec<ast::TypeKind> = Vec::new(); if !fns.has(path.as_str()) { if !fns.items[at].default { return None; } for j in 0..args.len() invariant 0 <= j && j <= args.len(), { out.push(args[j].clone()); } return Some(Dispatched { path: String::from(target), args: out }); } for g in 0..impls[k].generics.len() invariant 0 <= g && g <= impls[k].generics.len(), { out.push(bound_or_error(&m, impls[k].generics[g].name.as_str())); } for j in 1..args.len() invariant 1 <= j && j <= args.len(), { out.push(args[j].clone()); } return Some(Dispatched { path: path, args: out }); },
                }
            }
        }
        None
    }

    #[summary("색인한 원소의 타입: 배열, Vec, 그리고 조각이나 Vec의 참조")]
    #[effects(alloc)]
    fn elem_of(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(e, q4_tk_array1) => Some(e.kind.clone()),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, inner) => ref_elem(&inner.kind),
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(e) => Some(e.kind.clone()),
            ast::TypeKind::Box(q4_tk_box0) => None,
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[effects(alloc)]
    fn empty_subst() -> types::Subst {
        types::Subst { names: Vec::new(), tys: Vec::new() }
    }

    #[effects(pure)]
    fn exec_mode(m: Mode) -> bool {
        match m {
            Mode::Exec => true,
            Mode::Spec(q4_old) => false,
            Mode::Ghost => false,
        }
    }

    #[effects(alloc)]
    fn exprs_copy(xs: &[ast::Expr]) -> Vec<ast::Expr> {
        let mut out: Vec<ast::Expr> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(xs[i].clone());
        }
        out
    }

    #[summary("f64::NAN, f64::MAX 같은 f64의 연관 상수인가 (ADR-0061 §2)")]
    #[effects(pure)]
    fn f64_const(path: &[ast::Ident]) -> bool {
        path.len() == 2 && path[0].name == "f64" && (path[1].name == "INFINITY" || path[1].name == "NEG_INFINITY" || path[1].name == "NAN" || path[1].name == "MAX" || path[1].name == "MIN" || path[1].name == "MIN_POSITIVE" || path[1].name == "EPSILON")
    }

    #[summary("모르는 f64 메서드 m의 고침 글")]
    #[effects(alloc)]
    fn f64_missing(m: &str) -> String {
        if m == "to_bits" || m == "from_bits" || m == "to_be_bytes" || m == "to_le_bytes" || m == "to_ne_bytes" {
            return String::from("bit reinterpretation of `f64` is not available (ADR-0061 §4: NaN payloads are not portable)");
        }
        if m == "total_cmp" || m == "partial_cmp" || m == "clamp" {
            return String::from("not available yet (ADR-0061 open question 4): compare with `<`, `<=`, `>`, `>=`");
        }
        if m == "round" || m == "floor" || m == "ceil" || m == "trunc" || m == "fract" || m == "rem_euclid" || m == "div_euclid" || m == "signum" || m == "copysign" || m == "mul_add" || m == "recip" || m == "to_int_unchecked" {
            return String::from("not available yet: the `f64` methods are `sqrt`, `abs`, `min`, `max`, `is_nan` and `is_finite` (ADR-0061 §3)");
        }
        String::from("the `f64` methods are `sqrt`, `abs`, `min`, `max`, `is_nan` and `is_finite` (ADR-0061 §3); libm functions (`sin`, `exp`, `ln`, `powf`, ..) are not available (open question 2)")
    }

    #[summary("f64의 메서드 m (ADR-0061 §3): 0은 없음, 1은 인자 없이 f64(sqrt, abs), 2는 인자 없이 bool(is_nan, is_finite), 3은 f64 하나를 받아 f64(min, max)")]
    #[effects(pure)]
    fn f64_sig(m: &str) -> u8 {
        if m == "sqrt" || m == "abs" {
            1
        } else if m == "is_nan" || m == "is_finite" {
            2
        } else if m == "min" || m == "max" {
            3
        } else {
            0
        }
    }

    #[summary("이름이 name인 첫 필드 값의 차례")]
    #[effects(pure)]
    fn field_at(xs: &[ast::FieldInit], name: &str) -> (r: Option<usize>)
        ensures match r { None => true, Some(i) => i < xs.len(), },
    {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if xs[i].name.name == name {
                return Some(i);
            }
        }
        None
    }

    #[effects(alloc)]
    fn field_names(fs: &[types::FieldSig]) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..fs.len()
            invariant 0 <= i && i <= fs.len(),
        {
            out.push(fs[i].name.clone());
        }
        out
    }

    #[summary("필드 n의 타입")]
    #[effects(alloc)]
    fn field_ty(fs: &[types::FieldSig], n: &str) -> Option<ast::TypeKind> {
        for i in 0..fs.len()
            invariant 0 <= i && i <= fs.len(),
        {
            if fs[i].name.as_str() == n {
                return Some(fs[i].ty.clone());
            }
        }
        None
    }

    #[summary("필드 값 가운데 하나가 name을 말하는가")]
    #[effects(pure)]
    fn fields_mention(xs: &[ast::FieldInit], name: &str, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if mentions(&xs[i].value, name, f - 1) {
                return true;
            }
        }
        false
    }

    #[summary("성분 comp 안의 경계 있는 호출 가운데 순서로 첫 것이 닿는 인스턴스")]
    #[effects(alloc)]
    fn first_bound(pairs: &[Pair], comp: &[String]) -> Option<String> {
        let mut found: bool = false;
        let mut best: usize = 0;
        for i in 0..pairs.len()
            invariant 0 <= i && i <= pairs.len() && best <= i,
        {
            if types::has(comp, pairs[i].from.as_str()) && types::has(comp, pairs[i].to.as_str()) {
                if !found || best < pairs.len() && pair_lt(&pairs[i], &pairs[best]) {
                    best = i;
                    found = true;
                }
            }
        }
        if found && best < pairs.len() {
            Some(pairs[best].to.clone())
        } else {
            None
        }
    }

    #[summary("몸에서 가장 앞에 있는 name[var]의 자리: E0511의 고침이 표시할 트리거")]
    #[effects(alloc)]
    fn first_index_on(body: &ast::Expr, var: &str) -> Option<source::Span> {
        let mut copy: ast::Expr = body.clone();
        let mut v: FirstIndex = FirstIndex { var: String::from(var), found: false, at: body.span };
        ast::expr_mut::<FirstIndex>(&mut copy, &mut v, false, 1000000000);
        if v.found {
            Some(v.at)
        } else {
            None
        }
    }

    #[summary("s의 값이 모두 t의 값인가")]
    #[effects(pure)]
    fn fits(s: ast::IntTy, t: ast::IntTy) -> bool {
        if signed(s) == signed(t) {
            return bits(s) <= bits(t);
        }
        !signed(s) && bits(s) < bits(t)
    }

    #[summary("타입 없는 let에 맞는 타입인가: Vec::new()면 Vec, 아니면 정수")]
    #[effects(pure)]
    fn fits_let(t: &ast::TypeKind, vec_new: bool) -> bool {
        if vec_new {
            return is_vec(t);
        }
        types::is_int(t)
    }

    #[summary("T::from_be_bytes, T::from_le_bytes면 정수 타입 T (ADR-0048 §2, 백로그 2N-09c)")]
    #[effects(pure)]
    fn from_bytes_int(path: &[ast::Ident]) -> Option<ast::IntTy> {
        if path.len() == 2 && (path[1].name == "from_be_bytes" || path[1].name == "from_le_bytes") {
            ast::int_of(path[0].name.as_str())
        } else {
            None
        }
    }

    #[summary("T::from 꼴인가 (T는 정수 타입; Rust의 버릇, E0212)")]
    #[effects(pure)]
    fn from_call(path: &[ast::Ident]) -> bool {
        path.len() == 2 && path[1].name == "from" && types::int_name(path[0].name.as_str())
    }

    #[effects(pure)]
    fn ghost_mode(m: Mode) -> bool {
        match m {
            Mode::Exec => false,
            Mode::Spec(q4_old) => false,
            Mode::Ghost => true,
        }
    }

    #[summary("if·match·블록·loop인가")]
    #[effects(pure)]
    fn ghost_shape(k: &ast::ExprKind) -> bool {
        match k {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => false,
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => false,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => true,
            ast::ExprKind::Block(q4_ek_block0) => true,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => false,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => false,
            ast::ExprKind::Match(q4_ek_match0) => true,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => true,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[effects(pure)]
    fn has_attr(attrs: &[ast::Attr], name: &str) -> bool {
        for i in 0..attrs.len()
            invariant 0 <= i && i <= attrs.len(),
        {
            if attrs[i].name.name == name {
                return true;
            }
        }
        false
    }

    #[summary("글에 $가 있는가: 컴파일러가 지은 타입의 이름 (closures::lower)")]
    #[effects(pure)]
    fn has_dollar(s: &str) -> bool {
        for i in 0..s.len()
            invariant 0 <= i && i <= s.len(),
        {
            if s.as_bytes()[i] == 36 {
                return true;
            }
        }
        false
    }

    #[effects(pure)]
    fn has_file(xs: &[u32], n: u32) -> bool {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if xs[i] == n {
                return true;
            }
        }
        false
    }

    #[summary("t가 타입 매개변수를 말하는가")]
    #[effects(pure)]
    fn has_param(t: &ast::TypeKind, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(e, q4_n) => has_param(&e.kind, f - 1),
            ast::TypeKind::ArrayN(e, q4_ns) => has_param(&e.kind, f - 1),
            ast::TypeKind::Slice(e) => has_param(&e.kind, f - 1),
            ast::TypeKind::Ref(q4_m, e) => has_param(&e.kind, f - 1),
            ast::TypeKind::Named(q4_p, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if has_param(&args[i].kind, f - 1) { return true; } } false },
            ast::TypeKind::Vec(e) => has_param(&e.kind, f - 1),
            ast::TypeKind::Box(e) => has_param(&e.kind, f - 1),
            ast::TypeKind::Param(q4_pn) => true,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("t가 ps의 매개변수 가운데 tm이 아직 묶지 않은 것을 말하는가")]
    #[effects(pure)]
    fn has_param_of(t: &ast::TypeKind, ps: &[types::TParam], tm: &types::Subst) -> bool {
        for i in 0..ps.len()
            invariant 0 <= i && i <= ps.len(),
        {
            if !types::has(tm.names.as_slice(), ps[i].name.as_str()) && types::mentions_param(t, ps[i].name.as_str(), 100000) {
                return true;
            }
        }
        false
    }

    #[effects(pure)]
    fn has_prover(o: &Option<ast::Prover>) -> bool {
        match o {
            None => false,
            Some(q4_p) => true,
        }
    }

    #[summary("e 안에 한정자가 있는가")]
    #[effects(alloc)]
    fn has_quant(e: &ast::Expr) -> bool {
        let mut copy: ast::Expr = e.clone();
        let mut v: Quants = Quants { found: false };
        ast::expr_mut::<Quants>(&mut copy, &mut v, true, 1000000000);
        v.found
    }

    #[effects(pure)]
    fn has_span(xs: &[source::Span], s: source::Span) -> bool {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if same_span(xs[i], s) {
                return true;
            }
        }
        false
    }

    #[effects(pure)]
    fn has_type(o: &Option<ast::TypeKind>) -> bool {
        match o {
            None => false,
            Some(q4_t) => true,
        }
    }

    #[effects(pure)]
    fn has_usize(xs: &[usize], k: usize) -> bool {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if xs[i] == k {
                return true;
            }
        }
        false
    }

    #[summary("x가 Vec(또는 그 참조)인 지역 변수인가")]
    #[effects(alloc)]
    fn has_vec_var(cx: &FnCtx, x: &ast::Expr) -> bool {
        match vec_var(cx, x) {
            None => false,
            Some(l) => true,
        }
    }

    #[summary("경로의 마지막 마디를 뺀 앞")]
    #[effects(alloc)]
    fn head(segs: &[ast::Ident]) -> Vec<ast::Ident> {
        let mut out: Vec<ast::Ident> = Vec::new();
        if segs.len() == 0 {
            return out;
        }
        for i in 0..segs.len() - 1
            invariant 0 <= i && i <= segs.len() - 1,
        {
            out.push(segs[i].clone());
        }
        out
    }

    #[summary("배열, Box, Vec이 담는 타입")]
    #[effects(alloc)]
    fn held(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(e, q4_tk_array1) => Some(e.kind.clone()),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => None,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(e) => Some(e.kind.clone()),
            ast::TypeKind::Box(e) => Some(e.kind.clone()),
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("t가 자식 프로세스를 드는가 (배열·Vec·Box·구조체·열거형을 지나)")]
    #[effects(alloc)]
    fn holds_child(t: &ast::TypeKind, adts: &table::Table<types::Adt>, seen: &mut Vec<String>, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(e, q4_n) => holds_child(&e.kind, adts, seen, f - 1),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
            ast::TypeKind::Slice(q4_tk_slice0) => false,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => false,
            ast::TypeKind::Named(path, args) => { let p: String = types::join(path.as_slice(), "::"); if p == "std::process::Child" { return true; } for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if holds_child(&args[i].kind, adts, seen, f - 1) { return true; } } if !types::add(seen, p.as_str()) { return false; } match adts.find(p.as_str()) { None => false, Some(at) => kind_holds_child(&adts.items[at].kind, adts, seen, f - 1), } },
            ast::TypeKind::Vec(e) => holds_child(&e.kind, adts, seen, f - 1),
            ast::TypeKind::Box(e) => holds_child(&e.kind, adts, seen, f - 1),
            ast::TypeKind::Param(q4_tk_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("`_`를 n개: `_, _`")]
    #[effects(alloc)]
    fn holes(n: usize) -> String {
        let mut s: String = String::new();
        for i in 0..n
            invariant 0 <= i && i <= n,
        {
            if i > 0 {
                s.push_str(", ");
            }
            s.push_str("_");
        }
        s
    }

    #[effects(alloc)]
    fn idents(xs: &[ast::Ident]) -> Vec<ast::Ident> {
        let mut out: Vec<ast::Ident> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(xs[i].clone());
        }
        out
    }

    #[summary("else가 if let의 것인 갈래인가 (E0225)")]
    #[effects(pure)]
    fn if_let_else(p: &ast::Pat) -> bool {
        match &p.origin {
            ast::PatOrigin::Written => false,
            ast::PatOrigin::IfLetElse => true,
            ast::PatOrigin::Rejected => false,
        }
    }

    #[summary("impl i의 머리가 t에 맞는가")]
    #[effects(alloc)]
    fn impl_matches(i: &types::TraitImplInfo, t: &ast::TypeKind) -> bool {
        match types::matches(i, t) {
            None => false,
            Some(m) => true,
        }
    }

    #[summary("인스턴스가 아닌 trait impl 함수의 경로인가: <로 시작하고 >로 끝나지 않는다 (<..>::f<i64>는 인코더의 표가 넣는 인스턴스)")]
    #[effects(pure)]
    fn impl_path(p: &str) -> bool {
        p.len() > 0 && p.as_bytes()[0] == 60 && p.as_bytes()[p.len() - 1] != 62
    }

    #[summary("name[var] 꼴인가 (name은 변수나 그 필드 경로)")]
    #[effects(alloc)]
    fn index_on(e: &ast::Expr, var: &str) -> bool {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => false,
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(b, i) => is_place_path(&**b, 1000000000) && var_named(&**i, var),
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => false,
            ast::ExprKind::Block(q4_ek_block0) => false,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => false,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => false,
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => false,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
