    #[effects(pure)]
    fn struct_kind(k: &types::AdtKind) -> bool {
        match k {
            types::AdtKind::Struct(q4_fs) => true,
            types::AdtKind::Enum(q4_vs) => false,
        }
    }

    #[summary("m에서 n을 t로 (있던 이름이면 바꾼다)")]
    #[effects(alloc)]
    fn sub_put(m: &mut types::Subst, n: &str, t: ast::TypeKind) -> () {
        match types::sub_at(m, n) {
            None => { m.names.push(String::from(n)); m.tys.push(t); },
            Some(i) => { m.tys[i] = t; },
        }
    }

    #[summary("&place나 &mut place가 출발하는 변수")]
    #[effects(alloc)]
    fn swap_root(a: &ast::Expr) -> Option<String> {
        match ref_of(a) {
            None => None,
            Some(x) => root_name(&x, 1000000000),
        }
    }

    #[effects(alloc)]
    fn targs_copy(xs: &[ast::TArgs]) -> Vec<ast::TArgs> {
        let mut out: Vec<ast::TArgs> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(xs[i].clone());
        }
        out
    }

    #[summary("ADR-0050 §2의 내장 호출인가: String::new, String::with_capacity, String::from, String::from_utf8, char::from_u32")]
    #[effects(pure)]
    fn text_builtin(path: &[ast::Ident]) -> bool {
        path.len() == 2 && (path[0].name == "String" && (path[1].name == "new" || path[1].name == "with_capacity" || path[1].name == "from" || path[1].name == "from_utf8") || path[0].name == "char" && path[1].name == "from_u32")
    }

    #[summary("String 또는 str")]
    #[effects(pure)]
    fn text_kind(t: &ast::TypeKind) -> bool {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => true,
            ast::TypeKind::Str => true,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => false,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
            ast::TypeKind::Slice(q4_tk_slice0) => false,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => false,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => false,
            ast::TypeKind::Vec(q4_tk_vec0) => false,
            ast::TypeKind::Box(q4_tk_box0) => false,
            ast::TypeKind::Param(q4_tk_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("모르는 글 메서드 m의 고침 글")]
    #[effects(alloc)]
    fn text_missing(m: &str) -> String {
        let std: String = String::from("the text methods are the built-in `len`, `as_bytes`, `as_str`, `is_char_boundary`, `push`, `push_str`, `clone`, and `std::str`'s `starts_with`, `ends_with`, `find`, `strip_prefix`, `strip_suffix`, `trim_ascii_start`, `trim_ascii_end`, `decode_utf8`");
        if m == "push_str" || m == "push" || m == "clone" {
            return String::from("a `&str` is read-only: build a `String` (`String::from(t)`)");
        }
        if m == "to_string" || m == "to_owned" || m == "into" {
            return String::from("own it: `String::from(t)` (one form, ADR-0050 §2)");
        }
        if m == "chars" || m == "bytes" || m == "char_indices" || m == "iter" {
            return String::from("read the bytes with `while` and `s.as_bytes()[i]` (no iterators, ADR-0049)");
        }
        if m == "is_empty" {
            return String::from("compare `s.len() == 0`");
        }
        if m == "trim" || m == "trim_start" || m == "trim_end" {
            return types::cat2("`std::str` trims ASCII whitespace and returns the position: `s.trim_ascii_start()`, `s.trim_ascii_end()`, then `&s[a..b]`; ", std.as_str());
        }
        if m == "contains" {
            return types::cat2("`s.find(p)` is `Some` where `s` contains `p` (`std::str`); ", std.as_str());
        }
        if m == "split_once" || m == "split" || m == "lines" {
            return types::cat2("find the separator with `s.find(p)` and slice at the position (`std::str`); ", std.as_str());
        }
        if m == "parse" || m == "to_uppercase" || m == "to_lowercase" || m == "replace" {
            return types::cat2("not in the standard library yet: write it over the bytes; ", std.as_str());
        }
        std
    }

    #[summary("<T as unit::Trait>::m이면 unit::Trait::m")]
    #[effects(alloc)]
    fn trait_decl_of(p: &str) -> Option<String> {
        if p.len() == 0 || p.as_bytes()[0] != 60 {
            return None;
        }
        let end: usize = match last_of(p, ">::", p.len()) {
            None => { return None; },
            Some(i) => i,
        };
        let from: usize = match last_of(p, " as ", end) {
            None => { return None; },
            Some(j) => j,
        };
        if from + 4 > end || end + 3 > p.len() {
            return None;
        }
        Some(types::cat3(lexer::cut(p, from + 4, end).as_str(), "::", lexer::cut(p, end + 3, p.len()).as_str()))
    }

    #[effects(alloc)]
    fn triggers_each(xs: &[ast::Expr], out: &mut Vec<ast::Expr>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            collect_triggers(&xs[i], out, f - 1);
        }
    }

    #[effects(alloc)]
    fn triggers_opt(o: &Option<Box<ast::Expr>>, out: &mut Vec<ast::Expr>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match o {
            None => {},
            Some(x) => collect_triggers(&**x, out, f - 1),
        }
    }

    #[summary("`?`를 받는 타입인가: 0 아님, 1 Option<T>, 2 Result<T, E>")]
    #[effects(alloc)]
    fn try_variants(t: &ast::TypeKind) -> u8 {
        match types::named_path(t) {
            None => 0,
            Some(p) => { let n: usize = types::named_args(t).len(); if p == "Option" && n == 1 { 1 } else if p == "Result" && n == 2 { 2 } else { 0 } },
        }
    }

    #[effects(alloc)]
    fn two_variants(a: &str, at: Vec<ast::TypeKind>, b: &str, bt: Vec<ast::TypeKind>) -> Vec<types::VariantSig> {
        let mut out: Vec<types::VariantSig> = Vec::new();
        out.push(types::VariantSig { name: String::from(a), tys: at });
        out.push(types::VariantSig { name: String::from(b), tys: bt });
        out
    }

    #[summary("t 안에 Error가 있는가: 그 결함은 난 자리에서 알렸다")]
    #[effects(pure)]
    fn ty_has_error(t: &ast::TypeKind, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(e, q4_tk_array1) => ty_has_error(&e.kind, f - 1),
            ast::TypeKind::ArrayN(e, q4_tk_arrayn1) => ty_has_error(&e.kind, f - 1),
            ast::TypeKind::Slice(e) => ty_has_error(&e.kind, f - 1),
            ast::TypeKind::Ref(q4_tk_ref0, e) => ty_has_error(&e.kind, f - 1),
            ast::TypeKind::Named(q4_tk_named0, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if ty_has_error(&args[i].kind, f - 1) { return true; } } false },
            ast::TypeKind::Vec(e) => ty_has_error(&e.kind, f - 1),
            ast::TypeKind::Box(e) => ty_has_error(&e.kind, f - 1),
            ast::TypeKind::Param(q4_tk_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => true,
        }
    }

    #[summary("타입의 깊이: 배열·조각·Vec·Box·참조·이름 붙은 타입이 한 겹씩")]
    #[effects(pure)]
    fn type_depth(t: &ast::TypeKind, f: usize) -> (r: usize)
        ensures r <= f,
        decreases f,
    {
        if f == 0 {
            return 0;
        }
        match t {
            ast::TypeKind::Int(q4_tk_int0) => 0,
            ast::TypeKind::F64 => 0,
            ast::TypeKind::Bool => 0,
            ast::TypeKind::Unit => 0,
            ast::TypeKind::Char => 0,
            ast::TypeKind::String => 0,
            ast::TypeKind::Str => 0,
            ast::TypeKind::Array(e, q4_n) => 1 + type_depth(&e.kind, f - 1),
            ast::TypeKind::ArrayN(e, q4_ns) => 1 + type_depth(&e.kind, f - 1),
            ast::TypeKind::Slice(e) => 1 + type_depth(&e.kind, f - 1),
            ast::TypeKind::Ref(q4_m, e) => 1 + type_depth(&e.kind, f - 1),
            ast::TypeKind::Named(q4_p, args) => { let mut deepest: usize = 0; for i in 0..args.len() invariant 0 <= i && i <= args.len() && deepest <= f - 1, { let d: usize = type_depth(&args[i].kind, f - 1); if d > deepest { deepest = d; } } 1 + deepest },
            ast::TypeKind::Vec(e) => 1 + type_depth(&e.kind, f - 1),
            ast::TypeKind::Box(e) => 1 + type_depth(&e.kind, f - 1),
            ast::TypeKind::Param(q4_tk_param0) => 0,
            ast::TypeKind::Never => 0,
            ast::TypeKind::Error => 0,
        }
    }

    #[summary("t에 아직 묶이지 않은 ps의 매개변수가 남는가: tm으로 바꾼 뒤에도 매개변수를 말하고, t가 말하는 ps의 매개변수 가운데 tm에 없는 것이 있다")]
    #[effects(alloc)]
    fn unbound(ps: &[types::TParam], tm: &types::Subst, t: &ast::TypeKind) -> bool {
        if !has_param(&types::subst(t, tm), 100000) {
            return false;
        }
        for i in 0..ps.len()
            invariant 0 <= i && i <= ps.len(),
        {
            if types::mentions_param(t, ps[i].name.as_str(), 100000) && !types::has(tm.names.as_slice(), ps[i].name.as_str()) {
                return true;
            }
        }
        false
    }

    #[effects(alloc)]
    fn unboxed(o: &Option<Box<ast::Expr>>) -> Option<ast::Expr> {
        match o {
            None => None,
            Some(x) => Some((**x).clone()),
        }
    }

    #[summary("Vec, 배열, Box, 조각, 참조의 안쪽 타입")]
    #[effects(alloc)]
    fn under(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(e, q4_tk_array1) => Some(e.kind.clone()),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(e) => Some(e.kind.clone()),
            ast::TypeKind::Ref(q4_tk_ref0, e) => Some(e.kind.clone()),
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(e) => Some(e.kind.clone()),
            ast::TypeKind::Box(e) => Some(e.kind.clone()),
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("이웃한 두 값이 내려가는 자리가 있는가")]
    #[effects(pure)]
    fn unsorted(xs: &[usize]) -> bool {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if i > 0 && xs[i - 1] > xs[i] {
                return true;
            }
        }
        false
    }

    #[summary("문맥의 타입을 받는 리터럴 식인가: 정수 리터럴과 그것들의 산술·비트 연산, 시프트의 왼쪽, 그런 식 하나뿐인 블록과 if")]
    #[effects(pure)]
    fn untyped_literal(e: &ast::Expr, f: usize) -> bool
        decreases f * 2 + 1,
    {
        if f == 0 {
            return false;
        }
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => true,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => false,
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => false,
            ast::ExprKind::Unary(q4_ek_unary0, x) => untyped_literal(&**x, f - 1),
            ast::ExprKind::Binary(op, l, r) => { if is_shift(*op) { untyped_literal(&**l, f - 1) } else { (is_arith(*op) || is_bit(*op)) && untyped_literal(&**l, f - 1) && untyped_literal(&**r, f - 1) } },
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(c) => c.then.stmts.len() == 0 && opt_literal(&c.then.tail, f) && opt_literal(&c.els, f),
            ast::ExprKind::Block(b) => b.stmts.len() == 0 && opt_literal(&b.tail, f),
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => false,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => false,
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => false,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[effects(alloc)]
    fn var_named(e: &ast::Expr, var: &str) -> bool {
        match ast::var_name(e) {
            None => false,
            Some(v) => v.as_str() == var,
        }
    }

    #[summary("값이 변수나 필드인가")]
    #[effects(pure)]
    fn var_or_field(k: &ast::ExprKind) -> bool {
        match k {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => true,
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => false,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => false,
            ast::ExprKind::Block(q4_ek_block0) => false,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => false,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => true,
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => false,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[effects(alloc)]
    fn variant_names(vs: &[types::VariantSig]) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..vs.len()
            invariant 0 <= i && i <= vs.len(),
        {
            out.push(vs[i].name.clone());
        }
        out
    }

    #[summary("페이로드가 n개인 변형의 패턴: vt 또는 vt(_, _)")]
    #[effects(alloc)]
    fn variant_pat(vt: &str, n: usize) -> String {
        if n == 0 {
            return String::from(vt);
        }
        types::cat4(vt, "(", holes(n).as_str(), ")")
    }

    #[summary("단위 mp에서 변형을 쓰는 글: Some, Shape::Dot, geo::Shape::Dot")]
    #[effects(alloc)]
    fn variant_text(tp: &str, v: &str, mp: &str) -> String {
        if tp == "Option" || tp == "Result" {
            return String::from(v);
        }
        let path: Vec<String> = refs::split_path(tp);
        types::cat3(types::local(path.as_slice(), mp).as_str(), "::", v)
    }

    #[summary("Vec::new, Vec::with_capacity, 그리고 drop과 mem::take 따위 (Rust의 버릇, E0219)")]
    #[effects(pure)]
    fn vec_builtin(path: &[ast::Ident]) -> bool {
        if path.len() == 1 {
            return path[0].name == "drop";
        }
        if path.len() == 2 {
            return path[0].name == "Vec" && (path[1].name == "new" || path[1].name == "with_capacity") || (path[0].name == "mem" || path[0].name == "std::mem") && (path[1].name == "take" || path[1].name == "replace" || path[1].name == "swap");
        }
        path.len() == 3 && path[0].name == "std" && path[1].name == "mem" && path[2].name == "take"
    }

    #[summary("Vec<T> 또는 그것의 참조면 T")]
    #[effects(alloc)]
    fn vec_elem(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        let v: ast::TypeKind = match ref_inner(t) {
            None => t.clone(),
            Some(inner) => inner,
        };
        match &v {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => None,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => None,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(e) => Some(e.kind.clone()),
            ast::TypeKind::Box(q4_tk_box0) => None,
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("모르는 Vec 메서드 m의 고침 글 (없으면 빈 글)")]
    #[effects(alloc)]
    fn vec_missing(m: &str) -> String {
        if m == "get" || m == "first" || m == "last" {
            return String::from("index with `v[i]`: its bound is proved");
        }
        if m == "is_empty" {
            return String::from("compare `v.len() == 0`");
        }
        if m == "iter" || m == "iter_mut" || m == "into_iter" {
            return String::from("use `while` with an index");
        }
        if m == "extend_from_slice" || m == "resize" || m == "insert" || m == "remove" || m == "swap_remove" || m == "sort" || m == "reverse" || m == "contains" {
            return String::from("not available; write the loop (ADR-0031 §1)");
        }
        String::new()
    }

    #[summary("초기값이 Vec::new()나 Vec::with_capacity(n)인가")]
    #[effects(alloc)]
    fn vec_new_call(e: &ast::Expr) -> bool {
        match call_of(e) {
            None => false,
            Some(c) => c.path.len() == 2 && c.path[0].name == "Vec" && (c.path[1].name == "new" && c.args.len() == 0 || c.path[1].name == "with_capacity" && c.args.len() == 1),
        }
    }

    #[summary("x가 Vec(또는 그 참조)인 지역 변수면 그 변수")]
    #[effects(alloc)]
    fn vec_var(cx: &FnCtx, x: &ast::Expr) -> Option<Local> {
        match ast::var_name(x) {
            None => None,
            Some(n) => { match lookup(cx, n.as_str()) { None => None, Some(l) => { match vec_elem(&l.ty) { None => None, Some(e) => Some(l), } }, } },
        }
    }

    #[summary("배열 리터럴의 원소에 기대하는 타입: 기대한 배열 타입의 원소. 쓴 타입이 틀려 보고됐으면 원소도 그렇다")]
    #[effects(alloc)]
    fn want_elem(expected: &Option<ast::TypeKind>) -> Option<ast::TypeKind> {
        match expected {
            None => None,
            Some(x) => { if types::is_error(x) { Some(ast::TypeKind::Error) } else { array_elem(x) } },
        }
    }

    #[summary("정수 타입 from이 다른 정수 타입 to로 넓어지는가: from의 값이 모두 to의 값이다 (ADR-0099)")]
    #[effects(alloc)]
    fn widens(from: &ast::TypeKind, to: &ast::TypeKind) -> bool {
        !types::same(from, to) && types::is_int(from) && types::is_int(to) && !conv_obligation(from, to)
    }

    #[summary("`_` 하나인 패턴인가")]
    #[effects(pure)]
    fn wild_name(p: &ast::Pat) -> bool {
        p.path.len() == 1 && p.path[0].name == "_"
    }

    #[summary("xs에서 s를 뺀 것")]
    #[effects(alloc)]
    fn without(xs: &[String], s: &str) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if xs[i].as_str() != s {
                out.push(xs[i].clone());
            }
        }
        out
    }

    #[summary("tm에서 Error로 묶인 것을 뺀 것")]
    #[effects(alloc)]
    fn without_errors(tm: &types::Subst) -> types::Subst {
        let mut out: types::Subst = empty_subst();
        for i in 0..tm.names.len()
            invariant 0 <= i && i <= tm.names.len(),
        {
            if i < tm.tys.len() && !types::is_error(&tm.tys[i]) {
                out.names.push(tm.names[i].clone());
                out.tys.push(tm.tys[i].clone());
            }
        }
        out
    }

    #[summary("타입 매개변수를 더 큰 타입에 싼 첫 타입 인자")]
    #[effects(alloc)]
    fn wrapped_param(args: &[ast::TypeKind]) -> Option<ast::TypeKind> {
        for i in 0..args.len()
            invariant 0 <= i && i <= args.len(),
        {
            if has_param(&args[i], 100000) && !types::is_param(&args[i]) {
                return Some(args[i].clone());
            }
        }
        None
    }

    #[summary("자리 e에 쓸 수 있는가: let mut 지역 변수나 &mut 매개변수 아래, 필드·Box·원소를 지나 (s.buf, b.v, (*b).w)")]
    #[effects(alloc)]
    fn writable(cx: &FnCtx, e: &ast::Expr, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(id) => { match lookup(cx, id.name.as_str()) { None => false, Some(l) => { if is_ref(&l.ty) { types::is_ref_mut(&l.ty) } else { l.mutable } }, } },
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(x, q4_i) => writable(cx, &**x, f - 1),
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => false,
            ast::ExprKind::Block(q4_ek_block0) => false,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(x) => writable(cx, &**x, f - 1),
            ast::ExprKind::Field(x, q4_id) => writable(cx, &**x, f - 1),
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => false,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[summary("쓴 그대로의 패턴인가 (if let의 else도, 파서가 물리친 것도 아니다)")]
    #[effects(pure)]
    fn written(p: &ast::Pat) -> bool {
        match &p.origin {
            ast::PatOrigin::Written => true,
            ast::PatOrigin::IfLetElse => false,
            ast::PatOrigin::Rejected => false,
        }
    }
}
