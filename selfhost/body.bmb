    #[summary("t가 String인가")]
    #[effects(pure)]
    fn is_string(t: &ast::TypeKind) -> bool {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => true,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => false,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
            ast::TypeKind::Slice(q4_tk_slice0) => false,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => false,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => false,
            ast::TypeKind::Vec(q4_tk_vec0) => false,
            ast::TypeKind::Box(q4_tk_box0) => false,
            ast::TypeKind::Param(q4_tk_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("글인가: String, str, 또는 그것의 참조")]
    #[effects(alloc)]
    fn is_text(t: &ast::TypeKind) -> bool {
        if text_kind(t) {
            return true;
        }
        match ref_inner(t) {
            None => false,
            Some(inner) => text_kind(&inner),
        }
    }

    #[effects(pure)]
    fn is_u32(t: ast::IntTy) -> bool {
        bits(t) == 32 && !signed(t)
    }

    #[effects(pure)]
    fn is_vec(t: &ast::TypeKind) -> bool {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => false,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
            ast::TypeKind::Slice(q4_tk_slice0) => false,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => false,
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => false,
            ast::TypeKind::Vec(q4_tk_vec0) => true,
            ast::TypeKind::Box(q4_tk_box0) => false,
            ast::TypeKind::Param(q4_tk_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("열쇠의 from부터 열 자리 수")]
    #[effects(pure)]
    fn key_part(k: &str, from: usize) -> u32 {
        if from > 20 {
            return 0;
        }
        let mut n: u64 = 0;
        let digits: usize = 10;
        for i in 0..digits
            invariant 0 <= i && i <= digits && n <= 9999999999,
        {
            if from + i < k.len() && k.as_bytes()[from + i] >= 48 && k.as_bytes()[from + i] <= 57 && n <= 999999999 {
                n = n * 10 + (k.as_bytes()[from + i] - 48) as u64;
            }
        }
        if n <= 4294967295 {
            n as u32
        } else {
            0
        }
    }

    #[summary("span_key가 지은 열쇠의 자리")]
    #[effects(pure)]
    fn key_span(k: &str) -> source::Span {
        source::Span { file: key_part(k, 0), lo: key_part(k, 10), hi: key_part(k, 20) }
    }

    #[summary("변형 k를 이름한 첫 갈래의 차례")]
    #[effects(pure)]
    fn kind_at(kinds: &[Option<usize>], k: usize) -> (r: Option<usize>)
        ensures match r { None => true, Some(i) => i < kinds.len(), },
    {
        for i in 0..kinds.len()
            invariant 0 <= i && i <= kinds.len(),
        {
            match kinds[i] {
                None => {},
                Some(x) => { if x == k { return Some(i); } },
            }
        }
        None
    }

    #[effects(alloc)]
    fn kind_holds_child(k: &types::AdtKind, adts: &table::Table<types::Adt>, seen: &mut Vec<String>, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        let parts: Vec<ast::TypeKind> = adt_parts(k);
        for i in 0..parts.len()
            invariant 0 <= i && i <= parts.len(),
        {
            if holds_child(&parts[i], adts, seen, f - 1) {
                return true;
            }
        }
        false
    }

    #[effects(alloc)]
    fn label_name(l: &Option<ast::Ident>) -> Option<String> {
        match l {
            None => None,
            Some(i) => Some(i.name.clone()),
        }
    }

    #[summary("s의 처음부터 upto 앞까지에서 pat이 마지막으로 시작하는 자리 (첫 바이트는 건너뛴다)")]
    #[effects(pure)]
    fn last_of(s: &str, pat: &str, upto: usize) -> (r: Option<usize>)
        ensures match r { None => true, Some(i) => i + pat.len() <= s.len() && i < upto, },
    {
        if upto < 1 || pat.len() > s.len() || pat.len() > upto {
            return None;
        }
        let room: usize = s.len() - pat.len();
        let last: usize = upto - pat.len();
        let mut found: bool = false;
        let mut at: usize = 0;
        for i in 1..upto
            invariant 1 <= i && i <= upto && (!found || at <= room && at < i),
        {
            if i <= room && i <= last {
                let mut same: bool = true;
                for j in 0..pat.len()
                    invariant 0 <= j && j <= pat.len(),
                {
                    if s.as_bytes()[i + j] != pat.as_bytes()[j] {
                        same = false;
                    }
                }
                if same {
                    found = true;
                    at = i;
                }
            }
        }
        if found {
            Some(at)
        } else {
            None
        }
    }

    #[summary("범위를 안쪽부터 보아 이름 name")]
    #[effects(alloc)]
    fn lookup(cx: &FnCtx, name: &str) -> Option<Local> {
        let mut i: usize = cx.scopes.len();
        while i > 0
            invariant i <= cx.scopes.len(),
            decreases i,
        {
            i = i - 1;
            let mut j: usize = cx.scopes[i].len();
            while j > 0
                invariant j <= cx.scopes[i].len(),
                decreases j,
            {
                j = j - 1;
                if cx.scopes[i][j].name == name {
                    return Some(cx.scopes[i][j].clone());
                }
            }
        }
        None
    }

    #[summary("경로 path가 가리키는 const: 이 단위의 것(이름 하나일 때)이 먼저, 그다음 온 경로")]
    #[effects(alloc)]
    fn lookup_const(consts: &table::Table<consts::Const>, path: &[String], unit: &str) -> Option<String> {
        let joined: String = types::join(path, "::");
        let local: String = types::cat3(unit, "::", joined.as_str());
        if path.len() == 1 && consts.has(local.as_str()) {
            return Some(local);
        }
        if consts.has(joined.as_str()) {
            return Some(joined);
        }
        None
    }

    #[summary("가장 뒤의 진단에 고침이 없으면 msg를 고침으로")]
    #[effects(alloc)]
    fn loop_fix(diags: &mut Vec<diag::Diag>, msg: &str) -> () {
        let n: usize = diags.len();
        if n == 0 {
            return;
        }
        let bare: bool = match &diags[n - 1].fix {
            None => true,
            Some(q4_fx) => false,
        };
        if bare {
            diags[n - 1] = diag::fix(diags[n - 1].clone(), msg, None);
        }
    }

    #[summary("표에서 k의 수를 n보다 크지 않게")]
    #[effects(alloc)]
    fn lower_to(t: &mut table::Table<usize>, k: &str, n: usize) -> () {
        if n < at_or_zero(t, k) {
            t.insert(k, n);
        }
    }

    #[summary("단위 m과 그 안의 단위들의 실행 함수 main (안의 단위 먼저)")]
    #[effects(alloc)]
    fn mains_of(m: &ast::Mod, out: &mut Vec<ast::FnDef>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..m.mods.len()
            invariant 0 <= i && i <= m.mods.len(),
        {
            mains_of(&m.mods[i], out, f - 1);
        }
        for i in 0..m.fns.len()
            invariant 0 <= i && i <= m.fns.len(),
        {
            if is_exec(m.fns[i].kind) && m.fns[i].name.name == "main" {
                out.push(m.fns[i].clone());
            }
        }
    }

    #[summary("std::mem::replace, std::mem::swap (ADR-0047 §2)")]
    #[effects(pure)]
    fn mem_op(path: &[ast::Ident]) -> bool {
        path.len() == 3 && path[0].name == "std" && path[1].name == "mem" && (path[2].name == "replace" || path[2].name == "swap")
    }

    #[summary("식 e가 변수 name을 말하는가 (stage0 mentions): if·블록·한정·match·loop은 그렇다고 본다")]
    #[effects(pure)]
    fn mentions(e: &ast::Expr, name: &str, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(id) => id.name == name,
            ast::ExprKind::Call(c) => any_mentions(c.args.as_slice(), name, false, f - 1),
            ast::ExprKind::Method(m) => mentions(&*m.recv, name, f - 1) || any_mentions(m.args.as_slice(), name, false, f - 1),
            ast::ExprKind::Index(x, y) => mentions(&**x, name, f - 1) || mentions(&**y, name, f - 1),
            ast::ExprKind::Unary(q4_op, x) => mentions(&**x, name, f - 1),
            ast::ExprKind::Binary(q4_bop, x, y) => mentions(&**x, name, f - 1) || mentions(&**y, name, f - 1),
            ast::ExprKind::Ref(q4_m, x) => mentions(&**x, name, f - 1),
            ast::ExprKind::If(q4_ek_if0) => true,
            ast::ExprKind::Block(q4_ek_block0) => true,
            ast::ExprKind::Array(xs) => any_mentions(xs.as_slice(), name, false, f - 1),
            ast::ExprKind::Repeat(rp) => mentions(&*rp.value, name, f - 1),
            ast::ExprKind::Old(x) => mentions(&**x, name, f - 1),
            ast::ExprKind::Quant(q4_ek_quant0) => true,
            ast::ExprKind::Trigger(x) => mentions(&**x, name, f - 1),
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(sl) => fields_mention(sl.fields.as_slice(), name, f - 1),
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(x) => mentions(&**x, name, f - 1),
            ast::ExprKind::Field(x, q4_id) => mentions(&**x, name, f - 1),
            ast::ExprKind::Match(q4_ek_match0) => true,
            ast::ExprKind::Return(o) => opt_mentions(o, name, false, f - 1),
            ast::ExprKind::Try(x) => mentions(&**x, name, f - 1),
            ast::ExprKind::Loop(q4_ek_loop0) => true,
            ast::ExprKind::Break(b) => opt_mentions(&b.value, name, false, f - 1),
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(r) => mentions(&*r.lo, name, f - 1) || mentions(&*r.hi, name, f - 1),
            ast::ExprKind::Error => false,
        }
    }

    #[summary("mentions와 같되 if·블록·한정의 안을 본다 (stage0 mentions_strict)")]
    #[effects(pure)]
    fn mentions_strict(e: &ast::Expr, name: &str, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => mentions(e, name, f - 1),
            ast::ExprKind::Float(q4_ek_float0) => mentions(e, name, f - 1),
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => mentions(e, name, f - 1),
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => mentions(e, name, f - 1),
            ast::ExprKind::StrLit(q4_ek_strlit0) => mentions(e, name, f - 1),
            ast::ExprKind::CharLit(q4_ek_charlit0) => mentions(e, name, f - 1),
            ast::ExprKind::Bool(q4_ek_bool0) => mentions(e, name, f - 1),
            ast::ExprKind::Unit => mentions(e, name, f - 1),
            ast::ExprKind::Var(q4_ek_var0) => mentions(e, name, f - 1),
            ast::ExprKind::Call(c) => any_mentions(c.args.as_slice(), name, true, f - 1),
            ast::ExprKind::Method(m) => mentions_strict(&*m.recv, name, f - 1) || any_mentions(m.args.as_slice(), name, true, f - 1),
            ast::ExprKind::Index(x, y) => mentions_strict(&**x, name, f - 1) || mentions_strict(&**y, name, f - 1),
            ast::ExprKind::Unary(q4_op, x) => mentions_strict(&**x, name, f - 1),
            ast::ExprKind::Binary(q4_bop, x, y) => mentions_strict(&**x, name, f - 1) || mentions_strict(&**y, name, f - 1),
            ast::ExprKind::Ref(q4_m, x) => mentions_strict(&**x, name, f - 1),
            ast::ExprKind::If(ife) => mentions_strict(&*ife.cond, name, f - 1) || block_mentions(&ife.then, name, f - 1) || opt_mentions(&ife.els, name, true, f - 1),
            ast::ExprKind::Block(b) => block_mentions(b, name, f - 1),
            ast::ExprKind::Array(xs) => any_mentions(xs.as_slice(), name, true, f - 1),
            ast::ExprKind::Repeat(rp) => mentions_strict(&*rp.value, name, f - 1),
            ast::ExprKind::Old(x) => mentions_strict(&**x, name, f - 1),
            ast::ExprKind::Quant(q) => mentions_strict(&*q.body, name, f - 1),
            ast::ExprKind::Trigger(x) => mentions_strict(&**x, name, f - 1),
            ast::ExprKind::Closure(q4_ek_closure0) => mentions(e, name, f - 1),
            ast::ExprKind::StructLit(q4_ek_structlit0) => mentions(e, name, f - 1),
            ast::ExprKind::Path(q4_ek_path0) => mentions(e, name, f - 1),
            ast::ExprKind::Deref(q4_ek_deref0) => mentions(e, name, f - 1),
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => mentions(e, name, f - 1),
            ast::ExprKind::Match(q4_ek_match0) => mentions(e, name, f - 1),
            ast::ExprKind::Return(q4_ek_return0) => mentions(e, name, f - 1),
            ast::ExprKind::Try(q4_ek_try0) => mentions(e, name, f - 1),
            ast::ExprKind::Loop(q4_ek_loop0) => mentions(e, name, f - 1),
            ast::ExprKind::Break(q4_ek_break0) => mentions(e, name, f - 1),
            ast::ExprKind::Continue(q4_ek_continue0) => mentions(e, name, f - 1),
            ast::ExprKind::Range(q4_ek_range0) => mentions(e, name, f - 1),
            ast::ExprKind::Error => mentions(e, name, f - 1),
        }
    }

    #[summary("x.f(args)가 뜻하는 경로 호출 (ADR-0051): t의 함수에 수신자를 맞춰 넘긴다. 메서드 호출의 자리를 지니고, 수신자에 붙인 빌림은 x.f의 자리다 (다른 식에는 없는 자리)")]
    #[effects(alloc)]
    fn method_call(recv: &ast::Expr, name: &ast::Ident, args: &[ast::Expr], t: &MethodTarget, span: source::Span) -> ast::Expr {
        let mut path: Vec<ast::Ident> = Vec::new();
        for i in 0..t.path.len()
            invariant 0 <= i && i <= t.path.len(),
        {
            path.push(ast::Ident { name: t.path[i].clone(), span: name.span });
        }
        let mut targs: Vec<ast::TArgs> = Vec::new();
        if t.type_args.len() > 0 && path.len() >= 2 {
            let mut tys: Vec<ast::Type> = Vec::new();
            for i in 0..t.type_args.len()
                invariant 0 <= i && i <= t.type_args.len(),
            {
                tys.push(ast::Type { kind: t.type_args[i].clone(), span: name.span });
            }
            targs.push(ast::TArgs { seg: path.len() - 2, args: tys, span: name.span });
        }
        let at: source::Span = decls::span_to(recv.span, name.span);
        let none: Vec<ast::Expr> = Vec::new();
        let first: ast::Expr = match t.adjust {
            ast::Adjust::Value => recv.clone(),
            ast::Adjust::Ref => ast::Expr { kind: ast::ExprKind::Ref(false, Box::new(recv.clone())), span: at },
            ast::Adjust::RefMut => ast::Expr { kind: ast::ExprKind::Ref(true, Box::new(recv.clone())), span: at },
            ast::Adjust::AsStr => ast::Expr { kind: ast::ExprKind::Method(ast::Method { recv: Box::new(recv.clone()), name: ast::Ident { name: String::from("as_str"), span: name.span }, args: none }), span: at },
        };
        let mut all: Vec<ast::Expr> = Vec::new();
        all.push(first);
        for i in 0..args.len()
            invariant 0 <= i && i <= args.len(),
        {
            all.push(args[i].clone());
        }
        ast::Expr { kind: ast::ExprKind::Call(ast::Call { path: path, targs: targs, args: all, method: Some(t.adjust) }), span: span }
    }

    #[summary("모르는 메서드 m의 고침 글 (없으면 빈 글)")]
    #[effects(alloc)]
    fn method_missing(m: &str) -> String {
        if m == "unwrap" || m == "expect" {
            return String::from("handle each case explicitly; panics are not allowed");
        }
        if m == "iter" || m == "iter_mut" || m == "into_iter" || m == "map" || m == "for_each" {
            return String::from("use `while` with an index");
        }
        if m == "clone" {
            return String::from("arrays and scalars are copied by value; remove `.clone()`");
        }
        if m == "pow" || m == "abs" || m == "overflowing_add" || m == "overflowing_sub" || m == "overflowing_mul" {
            return String::from("not available; use `checked_*`, `saturating_*` or `wrapping_*` (ADR-0028 §3)");
        }
        String::new()
    }

    #[summary("e가 메서드 호출이면 그것")]
    #[effects(alloc)]
    fn method_of(e: &ast::Expr) -> Option<ast::Method> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(q4_ek_call0) => None,
            ast::ExprKind::Method(m) => Some(m.clone()),
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(q4_ek_deref0) => None,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("t가 이름 하나짜리 타입 name인가 (쓴 그대로의 Vec, String)")]
    #[effects(pure)]
    fn named_one(t: &ast::TypeKind, name: &str) -> bool {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => false,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
            ast::TypeKind::Slice(q4_tk_slice0) => false,
            ast::TypeKind::Ref(q4_tk_ref0, q4_tk_ref1) => false,
            ast::TypeKind::Named(path, q4_tk_named1) => path.len() == 1 && path[0] == name,
            ast::TypeKind::Vec(q4_tk_vec0) => false,
            ast::TypeKind::Box(q4_tk_box0) => false,
            ast::TypeKind::Param(q4_tk_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("t가 moving의 타입 매개변수를 말하는가")]
    #[effects(pure)]
    fn names_moving(t: &ast::TypeKind, moving: &[String], f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match t {
            ast::TypeKind::Int(q4_tk_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(e, q4_n) => names_moving(&e.kind, moving, f - 1),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => false,
            ast::TypeKind::Slice(e) => names_moving(&e.kind, moving, f - 1),
            ast::TypeKind::Ref(q4_m, e) => names_moving(&e.kind, moving, f - 1),
            ast::TypeKind::Named(q4_p, args) => { for i in 0..args.len() invariant 0 <= i && i <= args.len(), { if names_moving(&args[i].kind, moving, f - 1) { return true; } } false },
            ast::TypeKind::Vec(e) => names_moving(&e.kind, moving, f - 1),
            ast::TypeKind::Box(e) => names_moving(&e.kind, moving, f - 1),
            ast::TypeKind::Param(n) => types::has(moving, n.as_str()),
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[effects(alloc)]
    fn names_of(segs: &[ast::Ident]) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..segs.len()
            invariant 0 <= i && i <= segs.len(),
        {
            out.push(segs[i].name.clone());
        }
        out
    }

    #[summary("효과 e의 원자마다, 아직 없으면 처음 요구한 것으로 what을 적는다")]
    #[effects(alloc)]
    fn need(cx: &mut FnCtx, e: types::Effects, what: &str) -> () {
        if e.alloc {
            need_atom(cx, types::Effects { alloc: true, io: false, nondet: false, panic: false }, what);
        }
        if e.io {
            need_atom(cx, types::Effects { alloc: false, io: true, nondet: false, panic: false }, what);
        }
        if e.nondet {
            need_atom(cx, types::Effects { alloc: false, io: false, nondet: true, panic: false }, what);
        }
        if e.panic {
            need_atom(cx, panic_effect(), what);
        }
    }

    #[effects(alloc)]
    fn need_atom(cx: &mut FnCtx, atom: types::Effects, what: &str) -> () {
        for i in 0..cx.needs.len()
            invariant 0 <= i && i <= cx.needs.len(),
        {
            if types::e_contains(cx.needs[i].e, atom) {
                return;
            }
        }
        cx.needs.push(Need { e: atom, what: String::from(what) });
    }

    #[summary("몸 자신의 연산이 효과 e를 낸다")]
    #[effects(alloc)]
    fn need_own(cx: &mut FnCtx, e: types::Effects, what: &str) -> () {
        cx.own = types::e_union(cx.own, e);
        need(cx, e, what);
    }

    #[summary("몸이 요구하는 효과의 합")]
    #[effects(pure)]
    fn needed(cx: &FnCtx) -> types::Effects {
        let mut acc: types::Effects = types::pure();
        for i in 0..cx.needs.len()
            invariant 0 <= i && i <= cx.needs.len(),
        {
            acc = types::e_union(acc, cx.needs[i].e);
        }
        acc
    }

    #[summary("필드, 원소, `*`인가")]
    #[effects(pure)]
    fn nested_place(k: &ast::ExprKind) -> bool {
        match k {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => false,
            ast::ExprKind::Float(q4_ek_float0) => false,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => false,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => false,
            ast::ExprKind::StrLit(q4_ek_strlit0) => false,
            ast::ExprKind::CharLit(q4_ek_charlit0) => false,
            ast::ExprKind::Bool(q4_ek_bool0) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(q4_ek_var0) => false,
            ast::ExprKind::Call(q4_ek_call0) => false,
            ast::ExprKind::Method(q4_ek_method0) => false,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => true,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => false,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => false,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => false,
            ast::ExprKind::If(q4_ek_if0) => false,
            ast::ExprKind::Block(q4_ek_block0) => false,
            ast::ExprKind::Array(q4_ek_array0) => false,
            ast::ExprKind::Repeat(q4_ek_repeat0) => false,
            ast::ExprKind::Old(q4_ek_old0) => false,
            ast::ExprKind::Quant(q4_ek_quant0) => false,
            ast::ExprKind::Trigger(q4_ek_trigger0) => false,
            ast::ExprKind::Closure(q4_ek_closure0) => false,
            ast::ExprKind::StructLit(q4_ek_structlit0) => false,
            ast::ExprKind::Path(q4_ek_path0) => false,
            ast::ExprKind::Deref(q4_ek_deref0) => true,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => true,
            ast::ExprKind::Match(q4_ek_match0) => false,
            ast::ExprKind::Return(q4_ek_return0) => false,
            ast::ExprKind::Try(q4_ek_try0) => false,
            ast::ExprKind::Loop(q4_ek_loop0) => false,
            ast::ExprKind::Break(q4_ek_break0) => false,
            ast::ExprKind::Continue(q4_ek_continue0) => false,
            ast::ExprKind::Range(q4_ek_range0) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[summary("빈 표의 검사기: c는 1패스를 마친 것, consts는 평가한 상수")]
    #[effects(alloc)]
    fn new(c: decls::Checker, consts: table::Table<consts::Const>) -> Body {
        let external: Vec<String> = Vec::new();
        let open_lets: Vec<OpenLet> = Vec::new();
        let typed_uses: Vec<TypedUse> = Vec::new();
        let spec_at: Vec<source::Span> = Vec::new();
        let aliases: Vec<diag::Diag> = Vec::new();
        let gcalls: Vec<GCall> = Vec::new();
        Body { c: c, recursive: table::new::<usize>(), gcalls: gcalls, targs: table::new::<Vec<ast::TypeKind>>(), aliases: aliases, consts: consts, calls: table::new::<Vec<String>>(), needs: table::new::<Needs>(), external: external, types: table::new::<ast::TypeKind>(), open_lets: open_lets, typed_uses: typed_uses, spec_at: spec_at, locals: table::new::<table::Table<ast::TypeKind>>(), const_reads: table::new::<Vec<String>>(), const_uses: table::new::<ConstUse>(), methods: table::new::<MethodTarget>(), spec_widen: false }
    }

    #[summary("함수 하나의 빈 문맥: 범위 하나")]
    #[effects(alloc)]
    fn new_ctx(path: &str, mp: &str, effect: types::Effects, ghost: bool) -> FnCtx {
        let mut scopes: Vec<Vec<Local>> = Vec::new();
        let first: Vec<Local> = Vec::new();
        scopes.push(first);
        let all_names: Vec<String> = Vec::new();
        let reserved: Vec<String> = Vec::new();
        let loops: Vec<LoopCx> = Vec::new();
        let for_vars: Vec<String> = Vec::new();
        let needs: Vec<Need> = Vec::new();
        FnCtx { path: String::from(path), mod_path: String::from(mp), effect: effect, scopes: scopes, all_names: all_names, reserved: reserved, forall_depth: 0, ret: ast::TypeKind::Error, loops: loops, for_vars: for_vars, ghost: ghost, needs: needs, own: types::pure() }
    }

    #[effects(pure)]
    fn no_index(o: &Option<usize>) -> bool {
        match o {
            None => true,
            Some(q4_i) => false,
        }
    }

    #[summary("글이 없는가")]
    #[effects(pure)]
    fn no_text(o: &Option<String>) -> bool {
        match o {
            None => true,
            Some(s) => false,
        }
    }

    #[effects(alloc)]
    fn no_variant() -> VariantAt {
        VariantAt { found: false, tp: String::new(), k: 0, payload: Vec::new() }
    }

    #[effects(alloc)]
    fn no_variants() -> Variants {
        Variants { found: false, path: String::new(), vs: Vec::new() }
    }

    #[summary("e가 old(x)면 x")]
    #[effects(alloc)]
    fn old_of(e: &ast::Expr) -> Option<ast::Expr> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(q4_ek_call0) => None,
            ast::ExprKind::Method(q4_ek_method0) => None,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(x) => Some((**x).clone()),
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(q4_ek_deref0) => None,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(q4_ek_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("e가 old(x)이고 x가 변수면 그 이름")]
    #[effects(alloc)]
    fn old_var(e: &ast::Expr) -> Option<String> {
        match old_of(e) {
            None => None,
            Some(x) => ast::var_name(&x),
        }
    }

    #[summary("진단들에서 낮추기가 조용히 하라고 한 파일의 것을 빼고(이미 알린 E0608의 인자), 같은 발견은 한 번만 (코드·자리·글이 같은 것: 클로저의 절은 낮춘 자리마다 검사된다, 백로그 2V-20f)")]
    #[effects(alloc)]
    fn once_each(items: &[diag::Diag], quiet: &[u32]) -> Vec<diag::Diag> {
        let mut seen: table::Table<bool> = table::new::<bool>();
        let mut out: Vec<diag::Diag> = Vec::new();
        for i in 0..items.len()
            invariant 0 <= i && i <= items.len(),
        {
            if !has_file(quiet, items[i].span.file) {
                let key: String = types::cat3(items[i].code.as_str(), span_key(items[i].span).as_str(), items[i].message.as_str());
                if !seen.has(key.as_str()) {
                    seen.insert(key.as_str(), true);
                    out.push(items[i].clone());
                }
            }
        }
        out
    }

    #[effects(alloc)]
    fn one_type(t: &ast::TypeKind) -> Vec<ast::TypeKind> {
        let mut out: Vec<ast::TypeKind> = Vec::new();
        out.push(t.clone());
        out
    }

    #[summary("빠진 효과가 io뿐인가")]
    #[effects(pure)]
    fn only_io(e: types::Effects) -> bool {
        e.io && !e.alloc && !e.nondet && !e.panic
    }

    #[effects(alloc)]
    fn op_symbol(op: ast::BinOp) -> String {
        let mut s: String = String::new();
        ast::push_bin_symbol(&mut s, &op);
        s
    }

    #[summary("조건이나 살피는 값의 자리: 유령 코드에서는 old를 쓸 수 있는 명세")]
    #[effects(pure)]
    fn operand(m: Mode) -> Mode {
        match m {
            Mode::Exec => Mode::Exec,
            Mode::Spec(allow_old) => Mode::Spec(allow_old),
            Mode::Ghost => Mode::Spec(true),
        }
    }

    #[effects(pure)]
    fn opt_char(o: &Option<ast::TypeKind>) -> bool {
        match o {
            None => false,
            Some(t) => is_char(t),
        }
    }

    #[effects(pure)]
    fn opt_f64(o: &Option<ast::TypeKind>) -> bool {
        match o {
            None => false,
            Some(t) => is_f64(t),
        }
    }

    #[summary("o가 타입 없는 리터럴인 식을 담는가")]
    #[effects(pure)]
    fn opt_literal(o: &Option<Box<ast::Expr>>, f: usize) -> bool
        decreases f * 2,
    {
        if f == 0 {
            return false;
        }
        match o {
            None => false,
            Some(e) => untyped_literal(&**e, f - 1),
        }
    }

    #[summary("o가 담은 식이 name을 말하는가")]
    #[effects(pure)]
    fn opt_mentions(o: &Option<Box<ast::Expr>>, name: &str, strict: bool, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return true;
        }
        match o {
            None => false,
            Some(x) => { if strict { mentions_strict(&**x, name, f - 1) } else { mentions(&**x, name, f - 1) } },
        }
    }

    #[effects(pure)]
    fn opt_u8(o: &Option<ast::TypeKind>) -> bool {
        match o {
            None => false,
            Some(t) => { match int_of(t) { None => false, Some(i) => bits(i) == 8 && !signed(i), } },
        }
    }

    #[summary("Option<t>")]
    #[effects(alloc)]
    fn option_of(t: ast::TypeKind) -> ast::TypeKind {
        let mut targs: Vec<ast::Type> = Vec::new();
        targs.push(types::ty(t));
        ast::TypeKind::Named(single("Option"), targs)
    }

    #[summary("t가 가진 글인가: String, 또는 그것의 참조")]
    #[effects(alloc)]
    fn owned_text(t: &ast::TypeKind) -> bool {
        match ref_inner(t) {
            None => is_string(t),
            Some(inner) => is_string(&inner),
        }
    }

    #[summary("t가 수신자의 타입인가: by_self면 Self, 아니면 타입 owner")]
    #[effects(alloc)]
    fn owns(t: &ast::TypeKind, owner: &str, by_self: bool) -> bool {
        if by_self {
            match types::param_name(t) {
                None => false,
                Some(p) => p == "Self",
            }
        } else {
            match types::named_path(t) {
                None => false,
                Some(p) => is_named(t) && p.as_str() == owner,
            }
        }
    }

    #[summary("n을 열 자리 10진수로 out에: 글의 순서가 수의 순서다")]
    #[effects(alloc)]
    fn pad10(out: &mut String, n: u32) -> () {
        let x: u64 = n as u64;
        let mut lim: u64 = 1000000000;
        while lim > x && lim > 1
            invariant lim <= 1000000000,
            decreases lim,
        {
            out.push_str("0");
            lim = lim / 10;
        }
        std::num::push_u64(out, x);
    }

    #[effects(pure)]
    fn pair_lt(a: &Pair, b: &Pair) -> bool {
        a.from.as_str() < b.from.as_str() || a.from == b.from && a.to.as_str() < b.to.as_str()
    }

    #[effects(pure)]
    fn panic_effect() -> types::Effects {
        types::Effects { alloc: false, io: false, nondet: false, panic: true }
    }

    #[effects(pure)]
    fn place_lt(a: source::Span, b: source::Span) -> bool {
        a.file < b.file || a.file == b.file && a.lo < b.lo
    }

    #[summary("참조나 Box가 가리키는 타입")]
    #[effects(alloc)]
    fn pointee(t: &ast::TypeKind) -> Option<ast::TypeKind> {
        match t {
            ast::TypeKind::Int(q4_tk_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(q4_tk_array0, q4_tk_array1) => None,
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => None,
            ast::TypeKind::Slice(q4_tk_slice0) => None,
            ast::TypeKind::Ref(q4_m, e) => Some(e.kind.clone()),
            ast::TypeKind::Named(q4_tk_named0, q4_tk_named1) => None,
            ast::TypeKind::Vec(q4_tk_vec0) => None,
            ast::TypeKind::Box(e) => Some(e.kind.clone()),
            ast::TypeKind::Param(q4_tk_param0) => None,
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[effects(alloc)]
    fn push_all(out: &mut Vec<ast::TypeKind>, xs: &[ast::TypeKind]) -> () {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(xs[i].clone());
        }
    }

    #[effects(alloc)]
    fn push_names(out: &mut Vec<String>, xs: &[String]) -> () {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(xs[i].clone());
        }
    }

    #[effects(alloc)]
    fn quant_kw(q: &ast::Quantifier) -> String {
        match q {
            ast::Quantifier::Forall => String::from("forall"),
            ast::Quantifier::Exists => String::from("exists"),
        }
    }

    #[summary("e가 lo..hi면 그 범위")]
    #[effects(alloc)]
    fn range_of(e: &ast::Expr) -> Option<ast::Range> {
        match &e.kind {
            ast::ExprKind::Int(q4_ek_int0, q4_ek_int1) => None,
            ast::ExprKind::Float(q4_ek_float0) => None,
            ast::ExprKind::ByteLit(q4_ek_bytelit0) => None,
            ast::ExprKind::ByteStr(q4_ek_bytestr0) => None,
            ast::ExprKind::StrLit(q4_ek_strlit0) => None,
            ast::ExprKind::CharLit(q4_ek_charlit0) => None,
            ast::ExprKind::Bool(q4_ek_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(q4_ek_var0) => None,
            ast::ExprKind::Call(q4_ek_call0) => None,
            ast::ExprKind::Method(q4_ek_method0) => None,
            ast::ExprKind::Index(q4_ek_index0, q4_ek_index1) => None,
            ast::ExprKind::Unary(q4_ek_unary0, q4_ek_unary1) => None,
            ast::ExprKind::Binary(q4_ek_binary0, q4_ek_binary1, q4_ek_binary2) => None,
            ast::ExprKind::Ref(q4_ek_ref0, q4_ek_ref1) => None,
            ast::ExprKind::If(q4_ek_if0) => None,
            ast::ExprKind::Block(q4_ek_block0) => None,
            ast::ExprKind::Array(q4_ek_array0) => None,
            ast::ExprKind::Repeat(q4_ek_repeat0) => None,
            ast::ExprKind::Old(q4_ek_old0) => None,
            ast::ExprKind::Quant(q4_ek_quant0) => None,
            ast::ExprKind::Trigger(q4_ek_trigger0) => None,
            ast::ExprKind::Closure(q4_ek_closure0) => None,
            ast::ExprKind::StructLit(q4_ek_structlit0) => None,
            ast::ExprKind::Path(q4_ek_path0) => None,
            ast::ExprKind::Deref(q4_ek_deref0) => None,
            ast::ExprKind::Field(q4_ek_field0, q4_ek_field1) => None,
            ast::ExprKind::Match(q4_ek_match0) => None,
            ast::ExprKind::Return(q4_ek_return0) => None,
            ast::ExprKind::Try(q4_ek_try0) => None,
            ast::ExprKind::Loop(q4_ek_loop0) => None,
            ast::ExprKind::Break(q4_ek_break0) => None,
            ast::ExprKind::Continue(q4_ek_continue0) => None,
            ast::ExprKind::Range(r) => Some(r.clone()),
            ast::ExprKind::Error => None,
        }
