    #[summary("제네릭 정의 path의 인스턴스의 열쇠 (타입 인자가 없으면 경로 자신)")]
    #[effects(alloc)]
    fn inst_key(path: &str, args: &[ast::TypeKind]) -> String {
        if args.len() == 0 {
            return String::from(path);
        }
        let mut texts: Vec<String> = Vec::new();
        for i in 0..args.len()
            invariant 0 <= i && i <= args.len(),
        {
            texts.push(types::text(&args[i]));
        }
        types::cat4(path, "<", types::join(texts.as_slice(), ", ").as_str(), ">")
    }

    #[summary("T::MIN, T::MAX인가")]
    #[effects(pure)]
    fn int_const(path: &[ast::Ident]) -> bool {
        match consts::int_const(path) {
            None => false,
            Some(q4_c) => true,
        }
    }

