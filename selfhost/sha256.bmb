#[summary("SHA-256 (FIPS 180-4) (stage0 compiler/src/sha256.rs의 포트, 백로그 4D-03f1). 정의의 해시가 쓴다 (ADR-0019, ADR-0059)")]
mod sha256 {
    #[summary("한 덩이(msg의 at부터 64바이트)를 상태 h에 섞은 새 상태")]
    #[effects(alloc)]
    fn block(h: &[u32], msg: &[u8], at: usize) -> (r: Vec<u32>)
        requires h.len() == 8 && at <= msg.len() && msg.len() - at >= 64,
        ensures r.len() == 8,
    {
        let mut w: Vec<u32> = Vec::new();
        let mut i: usize = 0;
        while i < 16
            invariant i <= 16 && w.len() == i,
            decreases 16 - i,
        {
            let p: usize = at + i * 4;
            w.push(word(msg[p], msg[p + 1], msg[p + 2], msg[p + 3]));
            i = i + 1;
        }
        while i < 64
            invariant 16 <= i && i <= 64 && w.len() == i,
            decreases 64 - i,
        {
            let x: u32 = w[i - 15];
            let y: u32 = w[i - 2];
            let s0: u32 = x.rotate_right(7) ^ x.rotate_right(18) ^ x >> 3;
            let s1: u32 = y.rotate_right(17) ^ y.rotate_right(19) ^ y >> 10;
            w.push(w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1));
            i = i + 1;
        }
        let mut a: u32 = h[0];
        let mut b: u32 = h[1];
        let mut c: u32 = h[2];
        let mut d: u32 = h[3];
        let mut e: u32 = h[4];
        let mut g5: u32 = h[5];
        let mut g6: u32 = h[6];
        let mut g7: u32 = h[7];
        let mut n: usize = 0;
        while n < 64
            invariant n <= 64 && w.len() == 64,
            decreases 64 - n,
        {
            let s1: u32 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch: u32 = e & g5 ^ !e & g6;
            let t1: u32 = g7.wrapping_add(s1).wrapping_add(ch).wrapping_add(k(n)).wrapping_add(w[n]);
            let s0: u32 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj: u32 = a & b ^ a & c ^ b & c;
            let t2: u32 = s0.wrapping_add(maj);
            g7 = g6;
            g6 = g5;
            g5 = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
            n = n + 1;
        }
        let mut out: Vec<u32> = Vec::new();
        out.push(h[0].wrapping_add(a));
        out.push(h[1].wrapping_add(b));
        out.push(h[2].wrapping_add(c));
        out.push(h[3].wrapping_add(d));
        out.push(h[4].wrapping_add(e));
        out.push(h[5].wrapping_add(g5));
        out.push(h[6].wrapping_add(g6));
        out.push(h[7].wrapping_add(g7));
        out
    }

    #[summary("data의 해시: 32비트 낱말 여덟")]
    #[effects(alloc)]
    fn digest(data: &[u8]) -> (r: Vec<u32>)
        ensures r.len() == 8,
    {
        let mut msg: Vec<u8> = Vec::new();
        let total: usize = data.len();
        for i in 0..total
            invariant 0 <= i && i <= total,
        {
            let at: usize = i as usize;
            if at < data.len() {
                msg.push(data[at]);
            }
        }
        msg.push(128);
        while msg.len() % 64 != 56
            decreases 63 - (msg.len() + 7) % 64,
        {
            msg.push(0);
        }
        let bits: u64 = (total as u64).wrapping_mul(8);
        let mut shift: u32 = 64;
        while shift >= 8
            invariant shift <= 64 && shift % 8 == 0,
            decreases shift,
        {
            shift = shift - 8;
            msg.push((bits >> shift & 255) as u8);
        }
        let mut h: Vec<u32> = Vec::new();
        h.push(0x6a09e667);
        h.push(0xbb67ae85);
        h.push(0x3c6ef372);
        h.push(0xa54ff53a);
        h.push(0x510e527f);
        h.push(0x9b05688c);
        h.push(0x1f83d9ab);
        h.push(0x5be0cd19);
        let mut at: usize = 0;
        while at < msg.len() && msg.len() - at >= 64
            invariant h.len() == 8 && at <= msg.len(),
            decreases msg.len() - at,
        {
            h = block(h.as_slice(), msg.as_slice(), at);
            at = at + 64;
        }
        h
    }

    #[summary("sha256:과 16진 자리 64개")]
    #[effects(alloc)]
    fn hex(data: &[u8]) -> String {
        let h: Vec<u32> = digest(data);
        let mut s: String = String::from("sha256:");
        let mut i: usize = 0;
        while i < 8
            invariant i <= 8 && h.len() == 8,
            decreases 8 - i,
        {
            let v: u32 = h[i];
            let mut shift: u32 = 32;
            while shift >= 4
                invariant shift <= 32 && shift % 4 == 0,
                decreases shift,
            {
                shift = shift - 4;
                let d: u32 = v >> shift & 15;
                push_digit(&mut s, d);
            }
            i = i + 1;
        }
        s
    }

    #[summary("FIPS 180-4의 상수 K")]
    #[effects(pure)]
    fn k(i: usize) -> u32
        requires i < 64,
    {
        let ks: [u32; 64] = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0xfc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x6ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];
        ks[i]
    }

    #[summary("16진 자리 d(0..15)를 붙인다")]
    #[effects(alloc)]
    fn push_digit(out: &mut String, d: u32) -> () {
        let code: u32 = if d < 10 {
            48 + d % 16
        } else {
            87 + d % 16
        };
        match char::from_u32(code) {
            None => {},
            Some(c) => out.push(c),
        }
    }

    #[summary("바이트 넷을 큰 끝부터 읽은 낱말")]
    #[effects(pure)]
    fn word(b0: u8, b1: u8, b2: u8, b3: u8) -> u32 {
        (b0 as u32) << 24 | (b1 as u32) << 16 | (b2 as u32) << 8 | b3 as u32
    }
}
