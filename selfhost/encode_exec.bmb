#[summary("Proof encoding, fourth to sixth pieces (port of the executable side of stage0 compiler/src/verify.rs, of verify/invariants.rs and of the code of verify/text.rs, semantics in ADR-0017, ADR-0049, ADR-0050, ADR-0060 §2 and ADR-0062 §2): the symbolic state of an executable or proof definition (Exec, the fields of stage0 Enc that code reads, around the state of specifications), its entry (parameters, the refinement of a trait's contract, requires), the values and obligations of expressions (Exec::eval, split by kind of expression), branches and their merge, calls with their contracts, places, loops (loop_core and its parts, the jumps out of them), ghost code (proof fn bodies and proof blocks), the operations that change a Vec or a String, the operations of text, the validity of values of types with invariants, `assert .. by` with the reads and free variables of its assertion (sub_proof; the query itself is encode_sub), and the exec rows of `bmb dump smt`. stage0's closures over the encoder (branch) are a start, a turn and a join around the two sides; its thread-local switches are fields of Exec; a loop's condition and decreases clause are passed as copies, since no struct or Option holds a reference. The f of recursive functions is the remaining depth (ADR-0140)")]
mod encode_exec {
    #[summary("A branch that was entered (the start of stage0 Enc::branch): the locals before it, the length of the path condition before it, and its condition")]
    struct Branch { vars: table::Table<encode_terms::Val>, n: usize, c: String }

    #[summary("Symbolic state of one executable or proof definition (stage0 Enc, the fields code reads). enc is the state specifications read: the declarations, the path condition, the obligations. vars are the locals, var_rank the order in which each was first bound (ADR-0063 §2), was the values behind &mut parameters on entry (`old`), entry_measure the decreases measure on entry, inputs the entry values of the parameters in order. dead says the current path has returned or left a loop (ADR-0049 §3). loops are the loops around the code being encoded, innermost last. ghost says ghost code is being encoded (ADR-0062 §2): a proof fn body or a proof block, whose expressions are specifications and whose effects are the facts it proves. texts are the text values known valid UTF-8, bytes and length. valid_decl are the validity symbols declared, valid_depth the nesting depth of element quantifiers, valid_defs the definitions of the recursive types' validity functions, valid_memo whether a type has a validity, by its text (a RefCell of stage0 Prog: a memo, so each definition may fill its own). reaching and reach are stage0's thread-local REACH and the points it records; trust is its thread-local TRUST, None trusting everything")]
    struct Exec { enc: encode_spec::Enc, vars: table::Table<encode_terms::Val>, var_rank: table::Table<usize>, was: table::Table<encode_terms::Val>, entry_measure: Option<encode_spec::Measure>, inputs: Vec<encode_spec::Shown>, dead: bool, ghost: bool, texts: Vec<encode_terms::Pair>, valid_decl: table::Table<bool>, valid_depth: u64, valid_defs: Vec<encode_spec::AxiomParts>, valid_memo: table::Table<bool>, reaching: bool, reach: Vec<Reach>, trust: Option<Trust>, loops: Vec<VLoop> }

    impl Exec {
        #[summary("abstract_reads for block b (stage0 Enc::abstract_block): each `let` binds its name for what follows it")]
        #[effects(alloc)]
        fn abstract_block(self: &Exec, b: &ast::Block, bound: &mut Vec<String>, reads: &mut Vec<Read>, pg: &encode_spec::Prog, f: usize) -> ast::Block
            decreases f,
        {
            if f == 0 {
                return b.clone();
            }
            let n: usize = bound.len();
            let mut stmts: Vec<ast::Stmt> = Vec::new();
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                match &b.stmts[i] {
                    ast::Stmt::Let(sl) => { let init: ast::Expr = self.abstract_reads(&sl.init, bound, reads, pg, f - 1); bound.push(sl.name.name.clone()); stmts.push(ast::Stmt::Let(ast::Let { mutable: sl.mutable, name: sl.name.clone(), ty: sl.ty.clone(), ty_missing: sl.ty_missing, init: init, span: sl.span })); },
                    ast::Stmt::Assign(_) => stmts.push(b.stmts[i].clone()),
                    ast::Stmt::While(_) => stmts.push(b.stmts[i].clone()),
                    ast::Stmt::For(_) => stmts.push(b.stmts[i].clone()),
                    ast::Stmt::Assert(_) => stmts.push(b.stmts[i].clone()),
                    ast::Stmt::Assume(_) => stmts.push(b.stmts[i].clone()),
                    ast::Stmt::Proof(_) => stmts.push(b.stmts[i].clone()),
                    ast::Stmt::LetFields(_) => stmts.push(b.stmts[i].clone()),
                    ast::Stmt::Expr(_) => stmts.push(b.stmts[i].clone()),
                }
            }
            let tail: Option<Box<ast::Expr>> = match &b.tail {
                None => None,
                Some(t) => Some(Box::new(self.abstract_reads(&**t, bound, reads, pg, f - 1))),
            };
            bound.truncate(n);
            ast::Block { stmts: stmts, tail: tail, span: b.span }
        }

        #[summary("e with each scalar read of another value (an element, a field, a value behind a reference, a method of a non-scalar receiver) that names no `let` of the assertion replaced by a variable, one per distinct read by its text, listed in reads with the read (stage0 Enc::abstract_reads). The variable keeps the read's span, so it has the read's type. The read's text names it, which no local's name can be; a text that an SMT quoted symbol cannot hold (`|`, `\\`) is named by its number")]
        #[effects(alloc)]
        fn abstract_reads(self: &Exec, e: &ast::Expr, bound: &mut Vec<String>, reads: &mut Vec<Read>, pg: &encode_spec::Prog, f: usize) -> ast::Expr
            decreases f,
        {
            if f == 0 {
                return e.clone();
            }
            let read: bool = match &e.kind {
                ast::ExprKind::Int(_, _) => false,
                ast::ExprKind::Float(_) => false,
                ast::ExprKind::ByteLit(_) => false,
                ast::ExprKind::ByteStr(_) => false,
                ast::ExprKind::StrLit(_) => false,
                ast::ExprKind::CharLit(_) => false,
                ast::ExprKind::Bool(_) => false,
                ast::ExprKind::Unit => false,
                ast::ExprKind::Var(_) => false,
                ast::ExprKind::Call(_) => false,
                ast::ExprKind::Method(rm) => !types::is_scalar(&self.enc.ty(&*rm.recv, pg)),
                ast::ExprKind::Index(_, _) => true,
                ast::ExprKind::Unary(_, _) => false,
                ast::ExprKind::Binary(_, _, _) => false,
                ast::ExprKind::Ref(_, _) => false,
                ast::ExprKind::If(_) => false,
                ast::ExprKind::Block(_) => false,
                ast::ExprKind::Array(_) => false,
                ast::ExprKind::Repeat(_) => false,
                ast::ExprKind::Old(_) => false,
                ast::ExprKind::Quant(_) => false,
                ast::ExprKind::Trigger(_) => false,
                ast::ExprKind::Closure(_) => false,
                ast::ExprKind::StructLit(_) => false,
                ast::ExprKind::Path(_) => false,
                ast::ExprKind::Deref(_) => true,
                ast::ExprKind::Field(_, _) => true,
                ast::ExprKind::Match(_) => false,
                ast::ExprKind::Return(_) => false,
                ast::ExprKind::Try(_) => false,
                ast::ExprKind::Loop(_) => false,
                ast::ExprKind::Break(_) => false,
                ast::ExprKind::Continue(_) => false,
                ast::ExprKind::Range(_) => false,
                ast::ExprKind::Error => false,
            };
            if read && types::is_scalar(&self.enc.ty(e, pg)) && !body::any_bound(e, bound.as_slice()) {
                let text: String = fmt::expr_text(e);
                let mut at: usize = reads.len();
                for i in 0..reads.len()
                    invariant 0 <= i && i <= reads.len() && at <= reads.len(),
                {
                    if at == reads.len() && reads[i].text.as_str() == text.as_str() {
                        at = i;
                    }
                }
                if at == reads.len() {
                    let name: String = if encode_decls::has_text(text.as_str(), "|") || encode_decls::has_text(text.as_str(), "\\") {
                        types::cat2("read#", encode_terms::dec(reads.len() as u64).as_str())
                    } else {
                        text.clone()
                    };
                    reads.push(Read { name: name, e: e.clone(), text: text.clone() });
                }
                if at < reads.len() {
                    return ast::Expr { kind: ast::ExprKind::Var(ast::Ident { name: reads[at].name.clone(), span: e.span }), span: e.span };
                }
                return e.clone();
            }
            match &e.kind {
                ast::ExprKind::Int(_, _) => e.clone(),
                ast::ExprKind::Float(_) => e.clone(),
                ast::ExprKind::ByteLit(_) => e.clone(),
                ast::ExprKind::ByteStr(_) => e.clone(),
                ast::ExprKind::StrLit(_) => e.clone(),
                ast::ExprKind::CharLit(_) => e.clone(),
                ast::ExprKind::Bool(_) => e.clone(),
                ast::ExprKind::Unit => e.clone(),
                ast::ExprKind::Var(_) => e.clone(),
                ast::ExprKind::Call(c) => { let mut cargs: Vec<ast::Expr> = Vec::new(); for i in 0..c.args.len() invariant 0 <= i && i <= c.args.len(), { cargs.push(self.abstract_reads(&c.args[i], bound, reads, pg, f - 1)); } ast::Expr { kind: ast::ExprKind::Call(ast::Call { path: c.path.clone(), targs: c.targs.clone(), args: cargs, method: c.method }), span: e.span } },
                ast::ExprKind::Method(m) => { let nr: ast::Expr = self.abstract_reads(&*m.recv, bound, reads, pg, f - 1); let mut margs: Vec<ast::Expr> = Vec::new(); for i in 0..m.args.len() invariant 0 <= i && i <= m.args.len(), { margs.push(self.abstract_reads(&m.args[i], bound, reads, pg, f - 1)); } ast::Expr { kind: ast::ExprKind::Method(ast::Method { recv: Box::new(nr), name: m.name.clone(), args: margs }), span: e.span } },
                ast::ExprKind::Index(_, _) => e.clone(),
                ast::ExprKind::Unary(op, x) => ast::Expr { kind: ast::ExprKind::Unary(*op, Box::new(self.abstract_reads(&**x, bound, reads, pg, f - 1))), span: e.span },
                ast::ExprKind::Binary(bop, a, b) => { let na: ast::Expr = self.abstract_reads(&**a, bound, reads, pg, f - 1); let nb: ast::Expr = self.abstract_reads(&**b, bound, reads, pg, f - 1); ast::Expr { kind: ast::ExprKind::Binary(*bop, Box::new(na), Box::new(nb)), span: e.span } },
                ast::ExprKind::Ref(_, _) => e.clone(),
                ast::ExprKind::If(ie) => { let nc: ast::Expr = self.abstract_reads(&*ie.cond, bound, reads, pg, f - 1); let nt: ast::Block = self.abstract_block(&ie.then, bound, reads, pg, f - 1); let ne: Option<Box<ast::Expr>> = match &ie.els { None => None, Some(el) => Some(Box::new(self.abstract_reads(&**el, bound, reads, pg, f - 1))), }; ast::Expr { kind: ast::ExprKind::If(ast::If { cond: Box::new(nc), then: nt, els: ne }), span: e.span } },
                ast::ExprKind::Block(blk) => ast::Expr { kind: ast::ExprKind::Block(self.abstract_block(blk, bound, reads, pg, f - 1)), span: e.span },
                ast::ExprKind::Array(_) => e.clone(),
                ast::ExprKind::Repeat(_) => e.clone(),
                ast::ExprKind::Old(_) => e.clone(),
                ast::ExprKind::Quant(_) => e.clone(),
                ast::ExprKind::Trigger(_) => e.clone(),
                ast::ExprKind::Closure(_) => e.clone(),
                ast::ExprKind::StructLit(_) => e.clone(),
                ast::ExprKind::Path(_) => e.clone(),
                ast::ExprKind::Deref(_) => e.clone(),
                ast::ExprKind::Field(_, _) => e.clone(),
                ast::ExprKind::Match(_) => e.clone(),
                ast::ExprKind::Return(_) => e.clone(),
                ast::ExprKind::Try(_) => e.clone(),
                ast::ExprKind::Loop(_) => e.clone(),
                ast::ExprKind::Break(_) => e.clone(),
                ast::ExprKind::Continue(_) => e.clone(),
                ast::ExprKind::Range(_) => e.clone(),
                ast::ExprKind::Error => e.clone(),
            }
        }

        #[summary("Records text value v as valid UTF-8 where it enters the definition (stage0 Enc::assume_text): a parameter, a call's result, a &mut argument after the call. No obligation goes with it (ADR-0050 §3)")]
        #[effects(alloc)]
        fn assume_text(self: &mut Exec, v: &encode_terms::Val) -> () {
            match encode_terms::parts(v) {
                None => {},
                Some(p) => { let mut known: bool = false; for i in 0..self.texts.len() invariant 0 <= i && i <= self.texts.len(), { if self.texts[i].a.as_str() == p.a.as_str() && self.texts[i].b.as_str() == p.b.as_str() { known = true; } } if !known { self.texts.push(p.clone()); } },
            }
        }

        #[summary("Assumes v of type t valid (stage0 Enc::assume_valid): a new value of code. Ghost code assumes nothing")]
        #[effects(alloc)]
        fn assume_valid(self: &mut Exec, v: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog) -> () {
            if self.ghost {
                return;
            }
            let facts: Vec<String> = self.valid(v, t, pg, 100000);
            extend(&mut self.enc.pc, facts.as_slice());
        }

        #[summary("The obligations of going back to the head of loop k from here (stage0 Enc::back_to_head): the end of its body, or a `continue`. The locals it havocs that have a validity are valid again (E0823), a `for`'s bounds and the invariants hold (E0807), and the measure decreased and was not negative (E0808); a `for`'s measure is hi - i (ADR-0049 §2)")]
        #[effects(alloc)]
        fn back_to_head(self: &mut Exec, k: usize, pg: &encode_spec::Prog) -> () {
            if k >= self.loops.len() {
                return;
            }
            let span: source::Span = self.loops[k].span;
            let vv: Vec<Typed> = self.loops[k].valid_vars.clone();
            let step: Option<ForStep> = self.loops[k].step.clone();
            let invs: Vec<ast::Expr> = self.loops[k].invariants.clone();
            let dec: Option<ast::Expr> = self.loops[k].dec.clone();
            let m0: Option<String> = self.loops[k].measure.clone();
            for i in 0..vv.len()
                invariant 0 <= i && i <= vv.len(),
            {
                match self.vars.find(vv[i].name.as_str()) {
                    None => {},
                    Some(at) => { let cur: encode_terms::Val = self.vars.items[at].clone(); self.oblige_valid(span, types::cat3("`", vv[i].name.as_str(), "` when the loop goes back to its head").as_str(), types::cat2(vv[i].name.as_str(), " after the iteration").as_str(), &cur, &vv[i].ty, pg); },
                }
            }
            match &step {
                None => {},
                Some(st) => { let g: String = for_bounds(st, encode_terms::scalar_of(&var_of(&self.vars, st.var.as_str())).as_str()); self.oblige("E0807", st.span, "loop invariant may not be preserved", g.as_str()); },
            }
            for i in 0..invs.len()
                invariant 0 <= i && i <= invs.len(),
            {
                let env: table::Table<encode_terms::Val> = self.vars.clone();
                let was: table::Table<encode_terms::Val> = self.was.clone();
                let ig: String = encode_terms::scalar_of(&self.enc.spec_expr(&invs[i], &env, &was, pg, 100000));
                self.oblige("E0807", invs[i].span, "loop invariant may not be preserved", ig.as_str());
            }
            let mut d1: Option<String> = None;
            let mut at_span: source::Span = span;
            match &step {
                None => { match &dec { None => {}, Some(d) => { let denv: table::Table<encode_terms::Val> = self.vars.clone(); let dwas: table::Table<encode_terms::Val> = self.was.clone(); d1 = Some(encode_terms::scalar_of(&self.enc.spec_expr(d, &denv, &dwas, pg, 100000))); at_span = d.span; }, } },
                Some(fs) => { d1 = Some(types::cat5("(- ", fs.hi.as_str(), " ", encode_terms::scalar_of(&var_of(&self.vars, fs.var.as_str())).as_str(), ")")); at_span = fs.span; },
            }
            match &m0 {
                None => {},
                Some(d0) => { match &d1 { None => {}, Some(dn) => self.oblige("E0808", at_span, "`decreases` may not decrease or may be negative", types::cat7("(and (<= 0 ", d0.as_str(), ") (< ", dn.as_str(), " ", d0.as_str(), "))").as_str()), } },
            }
        }

        #[summary("The value behind a &mut parameter after the callee (stage0 Enc::behind_mut_after): it may change the place, the elements of a slice but never its length; a &mut Vec<T> or a &mut String also its length when grows is set. before is the value on entry, ty the parameter's type")]
        #[effects(alloc)]
        fn behind_mut_after(self: &mut Exec, base: &str, before: &encode_terms::Val, ty: &ast::TypeKind, grows: bool, pg: &encode_spec::Prog) -> encode_terms::Val {
            let e: ast::TypeKind = encode_decls::elem_ty(ty);
            match before {
                encode_terms::Val::S(bmv_s0) => self.enc.fresh_val(base, ty, pg, 100000),
                encode_terms::Val::A(bm_elems, len) => { let elems: String = self.enc.fresh_elems(base, &e, false); let nl: String = self.new_len(base, len.as_str(), &e, grows); encode_terms::Val::A(elems, nl) },
                encode_terms::Val::Unit => self.enc.fresh_val(base, ty, pg, 100000),
                encode_terms::Val::Struct(bmv_struct0) => self.enc.fresh_val(base, ty, pg, 100000),
                encode_terms::Val::Arr(bm_elem, alen) => { let elem: encode_terms::Val = self.enc.fresh_struct_elems(base, &e, pg); let al: String = self.new_len(base, alen.as_str(), &e, grows); encode_terms::Val::Arr(Box::new(elem), al) },
            }
        }

        #[summary("Binds local k to v, noting when it was first bound (stage0 Enc::bind_var)")]
        #[effects(alloc)]
        fn bind_var(self: &mut Exec, k: &str, v: encode_terms::Val) -> () {
            if !self.var_rank.has(k) {
                let r: usize = self.var_rank.len();
                self.var_rank.insert(k, r);
            }
            self.vars.insert(k, v);
        }

        #[summary("A bit method in code (stage0 Enc::bit_method_code): the operand is a named bit-vector, and the term's facts are assumed. The amount is converted as in a specification, so the two read alike for the congruence facts. A constant amount is linear and names nothing")]
        #[effects(alloc)]
        fn bit_method_code(self: &mut Exec, m: &str, i: ast::IntTy, a: &str, n: &Option<String>) -> String {
            let constant: bool = match n {
                None => false,
                Some(nn) => encode_spec::is_num(nn.as_str()),
            };
            let none: Option<String> = None;
            if constant || m == "swap_bytes" && body::bits(i) == 8 {
                return encode_terms::method_term(m, i, a, "", n, &none);
            }
            let xa: String = self.operand_bv(i, a);
            let xn: Option<String> = match n {
                None => None,
                Some(amount) => Some(encode_terms::to_bv(i, amount.as_str())),
            };
            let t: String = encode_terms::method_term(m, i, a, xa.as_str(), n, &xn);
            let facts: Vec<String> = encode_terms::method_facts(m, i, a, t.as_str());
            extend(&mut self.enc.pc, facts.as_slice());
            t
        }

        #[summary("The value of block b in code (stage0 Enc::block): its statements in order, then its tail. What follows a `return` on this path does not run")]
        #[effects(alloc)]
        fn block(self: &mut Exec, b: &ast::Block, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                if self.dead {
                    return encode_terms::Val::Unit;
                }
                self.stmt(&b.stmts[i], pg, f - 1);
            }
            if self.dead {
                return encode_terms::Val::Unit;
            }
            match &b.tail {
                None => encode_terms::Val::Unit,
                Some(t) => self.eval(&**t, pg, f - 1),
            }
        }

        #[summary("The first side of a branch on c has run (the middle of stage0 Enc::branch): what it left is taken, and the second side starts from the state before the branch under the negation of c")]
        #[effects(alloc)]
        fn branch_else(self: &mut Exec, b: &Branch) -> Side {
            let side: Side = Side { vars: self.vars.clone(), facts: tail(self.enc.pc.as_slice(), b.n.saturating_add(1)), dead: self.dead };
            self.vars = b.vars.clone();
            self.dead = false;
            self.enc.pc.truncate(b.n);
            self.enc.pc.push(types::cat3("(not ", b.c.as_str(), ")"));
            side
        }

        #[summary("Both sides of a branch on c have run, the first leaving first with value tv, the second leaving the current state with value ev (the end of stage0 Enc::branch): the state and the value after the join. A side that returned does not reach the join (ADR-0049 §3): the path goes on under the other side's condition and facts, and the names that side bound end with it. Otherwise every local of before is merged in the order they were first bound, and each side's facts hold under its condition")]
        #[effects(alloc)]
        fn branch_join(self: &mut Exec, b: &Branch, first: &Side, tv: encode_terms::Val, ev: encode_terms::Val, ty: &ast::TypeKind, pg: &encode_spec::Prog) -> encode_terms::Val {
            let else_vars: table::Table<encode_terms::Val> = self.vars.clone();
            let else_facts: Vec<String> = tail(self.enc.pc.as_slice(), b.n.saturating_add(1));
            let else_dead: bool = self.dead;
            self.dead = false;
            self.enc.pc.truncate(b.n);
            let not_c: String = types::cat3("(not ", b.c.as_str(), ")");
            if first.dead && else_dead {
                self.dead = true;
                self.vars = b.vars.clone();
                return tv;
            }
            if first.dead {
                self.vars = retain(&else_vars, &b.vars);
                self.enc.pc.push(not_c.clone());
                extend(&mut self.enc.pc, else_facts.as_slice());
                return ev;
            }
            if else_dead {
                self.vars = retain(&first.vars, &b.vars);
                self.enc.pc.push(b.c.clone());
                extend(&mut self.enc.pc, first.facts.as_slice());
                return tv;
            }
            let names: Vec<String> = self.in_binding_order(&b.vars);
            let mut merged: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
            for i in 0..names.len()
                invariant 0 <= i && i <= names.len(),
            {
                let x: encode_terms::Val = var_of(&first.vars, names[i].as_str());
                let y: encode_terms::Val = var_of(&else_vars, names[i].as_str());
                let t: ast::TypeKind = if same_val(&x, &y, 100000) {
                    ast::TypeKind::Error
                } else {
                    self.enc.local_ty(names[i].as_str(), pg)
                };
                let v: encode_terms::Val = self.merge(b.c.as_str(), &x, &y, &t, pg, 100000);
                merged.insert(names[i].as_str(), v);
            }
            self.vars = merged;
            let then_g: Vec<String> = encode_terms::guarded(b.c.as_str(), first.facts.as_slice());
            extend(&mut self.enc.pc, then_g.as_slice());
            let else_g: Vec<String> = encode_terms::guarded(not_c.as_str(), else_facts.as_slice());
            extend(&mut self.enc.pc, else_g.as_slice());
            self.merge(b.c.as_str(), &tv, &ev, ty, pg, 100000)
        }

        #[summary("Enters a branch on c (the start of stage0 Enc::branch): the first side runs under c")]
        #[effects(alloc)]
        fn branch_start(self: &mut Exec, c: &str) -> Branch {
            let b: Branch = Branch { vars: self.vars.clone(), n: self.enc.pc.len(), c: String::from(c) };
            self.enc.pc.push(String::from(c));
            b
        }

        #[summary("A call of a function (stage0 Enc::call). A generic callee's contract is read under the call's type arguments; a trait method's is its impl's when Self is known. The arguments are evaluated in order (in ghost code they are specifications); then a built-in function has its own rules (call_builtin) and a definition its contract (call_def)")]
        #[effects(alloc)]
        fn call(self: &mut Exec, path: &[ast::Ident], args: &[ast::Expr], span: source::Span, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let mut target: String = encode_decls::resolve_in(&pg.pr.t, path, self.enc.unit.as_str());
            let mut csub: types::Subst = self.enc.call_subst(target.as_str(), span, pg);
            match pg.pr.t.fns.find(target.as_str()) {
                None => {},
                Some(sg) => { match &pg.pr.t.fns.items[sg].trait_of { None => {}, Some(tr) => { let mut targs: Vec<ast::TypeKind> = Vec::new(); for i in 0..pg.pr.t.fns.items[sg].generics.len() invariant 0 <= i && i <= pg.pr.t.fns.items[sg].generics.len(), { match types::sub_get(&csub, pg.pr.t.fns.items[sg].generics[i].name.as_str()) { None => targs.push(ast::TypeKind::Error), Some(ta) => targs.push(ta), } } let d: body::Dispatched = encode_decls::dispatched(&pg.pr.t, target.as_str(), targs.as_slice()); csub = match pg.pr.t.fns.find(d.path.as_str()) { None => types::Subst { names: Vec::new(), tys: Vec::new() }, Some(dg) => encode_decls::zip(pg.pr.t.fns.items[dg].generics.as_slice(), d.args.as_slice()), }; target = d.path.clone(); }, } },
            }
            let mut argv: Vec<encode_terms::Val> = Vec::new();
            for i in 0..args.len()
                invariant 0 <= i && i <= args.len(),
            {
                if self.ghost {
                    let env: table::Table<encode_terms::Val> = self.vars.clone();
                    let was: table::Table<encode_terms::Val> = self.was.clone();
                    argv.push(self.enc.spec_expr(&args[i], &env, &was, pg, 100000));
                } else {
                    argv.push(self.eval(&args[i], pg, f - 1));
                }
            }
            match pg.defs.find(target.as_str()) {
                None => self.call_builtin(target.as_str(), args, argv.as_slice(), span, pg, f - 1),
                Some(at) => self.call_def(target.as_str(), &pg.defs.items[at], &csub, args, argv.as_slice(), span, pg, f - 1),
            }
        }

        #[summary("A call of built-in function target, which has no definition (the built-in part of stage0 Enc::call). std::process::exit ends the path (ADR-0091): the postconditions are not owed on it. A value from outside is any value of its type; input and output change a &mut buffer to any valid value of its type and give any value of the result type (ADR-0091 §3). print_f64 has its precision bound (E0801). Anything else has no contract")]
        #[effects(alloc)]
        fn call_builtin(self: &mut Exec, target: &str, args: &[ast::Expr], argv: &[encode_terms::Val], span: source::Span, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            if target == "std::process::exit" && !self.ghost {
                self.dead = true;
            }
            let result: String = types::cat2(target, ".result");
            if target == "std::env::args" || target == "std::env::var" || target == "std::time::monotonic_ms" {
                let t: ast::TypeKind = ret_of(pg, target);
                let v: encode_terms::Val = self.enc.fresh_val(result.as_str(), &t, pg, 100000);
                self.assume_valid(&v, &t, pg);
                return v;
            }
            if moves::starts_with(target, "std::io::") || moves::starts_with(target, "std::fs::") || moves::starts_with(target, "std::process::") {
                let ptys: Vec<ast::TypeKind> = params_of(pg, target);
                for i in 0..ptys.len()
                    invariant 0 <= i && i <= ptys.len(),
                {
                    if i < args.len() && mut_ref(&ptys[i]) && has_root(&args[i]) {
                        let mut steps: Vec<encode_terms::Step> = Vec::new();
                        let root: String = self.place(&args[i], &mut steps, false, pg, f - 1);
                        let nv: encode_terms::Val = self.enc.fresh_val(root.as_str(), &ptys[i], pg, 100000);
                        self.assume_valid(&nv, &ptys[i], pg);
                        if text_at(pg, target, i) {
                            self.assume_text(&nv);
                        }
                        let cur: encode_terms::Val = var_of(&self.vars, root.as_str());
                        let whole: encode_terms::Val = encode_terms::set_at(&cur, steps.as_slice(), 0, &nv, &pg.pr.t, &mut self.enc.fr);
                        self.bind_var(root.as_str(), whole);
                    }
                }
                let rt: ast::TypeKind = ret_of(pg, target);
                let r: encode_terms::Val = self.enc.fresh_val(result.as_str(), &rt, pg, 100000);
                self.assume_valid(&r, &rt, pg);
                return r;
            }
            if target == "print_f64" && !self.ghost && argv.len() > 1 {
                let d: String = encode_terms::scalar_of(&argv[1]);
                self.oblige("E0801", span, "`print_f64` may get more than 65535 decimals (Rust panics)", types::cat3("(<= ", d.as_str(), " 65535)").as_str());
            }
            encode_terms::Val::Unit
        }

        #[summary("A call of definition def at path target with the values argv of the arguments args (the contract part of stage0 Enc::call). Every argument leaves the caller's hands valid (E0823); a lemma's arguments lie in its parameter types (E0819, ADR-0062 §2); each precondition holds (E0801); a call into the caller's recursion component decreases the measure (E0809). Then the callee has run: the value behind each &mut argument is new and valid, the result is a fresh valid value, and the postconditions are facts unless the pass does not trust the callee (ADR-0029 §2)")]
        #[effects(alloc)]
        fn call_def(self: &mut Exec, target: &str, def: &encode_spec::Def, csub: &types::Subst, args: &[ast::Expr], argv: &[encode_terms::Val], span: source::Span, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let none: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
            let pre_env: table::Table<encode_terms::Val> = encode_spec::bind_params(&def.d, argv);
            let mut param_tys: Vec<ast::TypeKind> = Vec::new();
            let sig_tys: Vec<ast::TypeKind> = params_of(pg, target);
            for i in 0..sig_tys.len()
                invariant 0 <= i && i <= sig_tys.len(),
            {
                param_tys.push(types::subst(&sig_tys[i], csub));
            }
            for i in 0..args.len()
                invariant 0 <= i && i <= args.len(),
            {
                if i < argv.len() && i < param_tys.len() {
                    self.oblige_valid_arg(&args[i], target, &argv[i], &param_tys[i], pg);
                }
            }
            if body::is_proof(def.d.kind) {
                for i in 0..args.len()
                    invariant 0 <= i && i <= args.len(),
                {
                    if i < argv.len() && i < param_tys.len() {
                        let tf: Vec<String> = encode_spec::type_facts(&argv[i], &param_tys[i], pg, 100000);
                        for k in 0..tf.len()
                            invariant 0 <= k && k <= tf.len(),
                        {
                            if !types::has(self.enc.pc.as_slice(), tf[k].as_str()) {
                                self.oblige("E0819", args[i].span, types::cat7("argument `", fmt::expr_text(&args[i]).as_str(), "` of `", target, "` may be outside `", types::text(&param_tys[i]).as_str(), "`").as_str(), tf[k].as_str());
                            }
                        }
                    }
                }
            }
            for i in 0..def.d.pre.len()
                invariant 0 <= i && i <= def.d.pre.len(),
            {
                let g: String = self.spec_in(def.unit.as_str(), csub, &def.d.pre[i], &pre_env, &none, pg);
                self.oblige("E0801", span, types::cat5("precondition `", pred_name(&def.d.pre[i]).as_str(), "` of `", target, "` may not hold").as_str(), g.as_str());
            }
            match pg.recursive.find(target) {
                None => {},
                Some(rc) => { match &def.d.measure { None => {}, Some(dm) => { if encode_spec::same_comp(pg, self.enc.path.as_str(), pg.recursive.items[rc]) { let em: Option<encode_spec::Measure> = self.entry_measure.clone(); match em { None => {}, Some(m0) => { let saved_sub: types::Subst = self.enc.tsub.clone(); let saved_mod: String = self.enc.spec_mod.clone(); self.enc.tsub = csub.clone(); self.enc.spec_mod = def.unit.clone(); let m1: encode_spec::Measure = self.enc.measure(dm, &pre_env, &none, pg, 100000); self.enc.spec_mod = saved_mod; self.enc.tsub = saved_sub; let goal: String = encode_spec::decrease_goal(pg, &m0, &m1); self.oblige("E0809", span, types::cat3("recursive call to `", target, "` may not decrease its measure").as_str(), goal.as_str()); }, } } }, } },
            }
            let mut post_args: Vec<encode_terms::Val> = Vec::new();
            for i in 0..argv.len()
                invariant 0 <= i && i <= argv.len(),
            {
                post_args.push(argv[i].clone());
            }
            let mut old_env: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
            for i in 0..def.d.params.len()
                invariant 0 <= i && i <= def.d.params.len(),
            {
                if i < args.len() && i < argv.len() && i < param_tys.len() && mut_ref(&def.d.params[i].ty.kind) && has_root(&args[i]) {
                    let mut steps: Vec<encode_terms::Step> = Vec::new();
                    let root: String = self.place(&args[i], &mut steps, false, pg, f - 1);
                    let grows: bool = match body::ref_inner(&def.d.params[i].ty.kind) {
                        None => false,
                        Some(inner) => growable(&inner),
                    };
                    let nv: encode_terms::Val = self.behind_mut_after(root.as_str(), &argv[i], &param_tys[i], grows, pg);
                    old_env.insert(def.d.params[i].name.name.as_str(), argv[i].clone());
                    self.assume_valid(&nv, &param_tys[i], pg);
                    if text_at(pg, target, i) {
                        self.assume_text(&nv);
                    }
                    let cur: encode_terms::Val = var_of(&self.vars, root.as_str());
                    let whole: encode_terms::Val = encode_terms::set_at(&cur, steps.as_slice(), 0, &nv, &pg.pr.t, &mut self.enc.fr);
                    self.bind_var(root.as_str(), whole);
                    if i < post_args.len() {
                        post_args[i] = nv.clone();
                    }
                }
            }
            let mut post_env: table::Table<encode_terms::Val> = encode_spec::bind_params(&def.d, post_args.as_slice());
            let ret_ty: ast::TypeKind = types::subst(&ret_of(pg, target), csub);
            let result: encode_terms::Val = self.enc.fresh_val(types::cat2(target, ".result").as_str(), &ret_ty, pg, 100000);
            self.assume_valid(&result, &ret_ty, pg);
            if text_ret(pg, target) {
                self.assume_text(&result);
            }
            match &def.d.ret.name {
                None => {},
                Some(rn) => post_env.insert(rn.name.as_str(), result.clone()),
            }
            if self.trusts_callee(target) {
                for i in 0..def.d.post.len()
                    invariant 0 <= i && i <= def.d.post.len(),
                {
                    let g: String = self.spec_in(def.unit.as_str(), csub, &def.d.post[i], &post_env, &old_env, pg);
                    self.enc.pc.push(g);
                }
            }
            result
        }

        #[summary("The elements after a copy_within whose bounds are not constants (the quantified part of stage0 Enc::copy_within): fresh arrays for the elements was of type el, each stated equal to the old one shifted inside the destination range and to the old one elsewhere")]
        #[effects(alloc)]
        fn copy_shifted(self: &mut Exec, was: &encode_terms::Val, el: &ast::TypeKind, lo: &str, hi: &str, dest: &str, pg: &encode_spec::Prog) -> encode_terms::Val {
            let scalar_elems: bool = match was {
                encode_terms::Val::S(csw_s0) => true,
                encode_terms::Val::A(csw_a0, csw_a1) => false,
                encode_terms::Val::Unit => false,
                encode_terms::Val::Struct(csw_struct0) => false,
                encode_terms::Val::Arr(csw_arr0, csw_arr1) => false,
            };
            let new: encode_terms::Val = if scalar_elems {
                encode_terms::Val::S(encode_terms::fresh(&mut self.enc.fr, "copy_within", types::cat3("(Array Int ", encode_decls::sort_of(el).as_str(), ")").as_str()))
            } else {
                self.enc.fresh_struct_elems("copy_within", el, pg)
            };
            let mut pairs: Vec<encode_terms::Pair> = Vec::new();
            encode_terms::leaf_pairs(&new, was, &mut pairs, 100000);
            let inside: String = types::cat7("(and (<= ", dest, " k) (< k (+ ", dest, " (- ", hi, types::cat3(" ", lo, "))))").as_str());
            for i in 0..pairs.len()
                invariant 0 <= i && i <= pairs.len(),
            {
                let n: String = pairs[i].a.clone();
                let o: String = pairs[i].b.clone();
                let mut s: String = types::cat5("(forall ((k Int)) (! (= (select ", n.as_str(), " k) (ite ", inside.as_str(), " (select ");
                s.push_str(types::cat5(o.as_str(), " (+ (- k ", dest, ") ", lo).as_str());
                s.push_str(types::cat5(")) (select ", o.as_str(), " k))) :pattern ((select ", n.as_str(), " k))))").as_str());
                self.enc.pc.push(s);
            }
            new
        }

        #[summary("`a.copy_within(lo..hi, dest)` (stage0 Enc::copy_within, ADR-0083): the source range and the destination range lie in the array (E0805), and the length stays. Constant bounds of a short copy (at most 16 elements) are stores of the old values, which a model can satisfy without instantiating anything; otherwise the new elements are fresh arrays, equal to the old ones shifted on [dest, dest + hi - lo) and to the old ones elsewhere, one quantified fact per leaf array triggered by a read of the new array")]
        #[effects(alloc)]
        fn copy_within(self: &mut Exec, e: &ast::Expr, x: &ast::Method, rv: &encode_terms::Val, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            if x.args.len() < 2 {
                return encode_terms::Val::Unit;
            }
            let rg: ast::Range = match body::range_of(&x.args[0]) {
                None => { return encode_terms::Val::Unit; },
                Some(found) => found,
            };
            let lo: String = encode_terms::scalar_of(&self.eval(&*rg.lo, pg, f - 1));
            let hi: String = encode_terms::scalar_of(&self.eval(&*rg.hi, pg, f - 1));
            let dest: String = encode_terms::scalar_of(&self.eval(&x.args[1], pg, f - 1));
            let el: ast::TypeKind = encode_decls::elem_ty(&self.enc.ty(&*x.recv, pg));
            let len: String = encode_spec::len_of(rv);
            let was: encode_terms::Val = elems_of(rv);
            self.oblige("E0805", e.span, "`copy_within` source range may be out of bounds", types::cat5("(and (<= ", lo.as_str(), " ", hi.as_str(), types::cat5(") (<= ", hi.as_str(), " ", len.as_str(), "))").as_str()).as_str());
            self.oblige("E0805", e.span, "`copy_within` destination may be out of bounds", types::cat7("(<= (+ ", dest.as_str(), " (- ", hi.as_str(), " ", lo.as_str(), types::cat3(")) ", len.as_str(), ")").as_str()).as_str());
            let cl: Option<u64> = small(lo.as_str());
            let ch: Option<u64> = small(hi.as_str());
            let cd: Option<u64> = small(dest.as_str());
            let mut unrolled: Option<encode_terms::Val> = None;
            match cl {
                None => {},
                Some(l) => { match ch { None => {}, Some(h) => { match cd { None => {}, Some(d) => { if l <= h && h - l <= 16 { let mut cur: encode_terms::Val = was.clone(); let count: u64 = h - l; for k in 0..count invariant 0 <= k && k <= count, { let item: encode_terms::Val = encode_terms::select_val(&was, encode_terms::dec(l.wrapping_add(k)).as_str(), 100000); cur = encode_terms::store_val(&cur, encode_terms::dec(d.wrapping_add(k)).as_str(), &item, 100000); } unrolled = Some(cur); } }, } }, } },
            }
            let new: encode_terms::Val = match unrolled {
                None => self.copy_shifted(&was, &el, lo.as_str(), hi.as_str(), dest.as_str(), pg),
                Some(done) => done,
            };
            let value: encode_terms::Val = encode_spec::whole_array(new, len.clone());
            self.write_place(&*x.recv, &value, false, pg, f - 1);
            encode_terms::Val::Unit
        }

        #[summary("`&v[lo..hi]` of an array, Vec or slice in code (stage0 Enc::elem_slice): the bounds obligation (E0805, Rust's panics on a range that starts after its end or ends past the length) and the elements from lo, the shifted array")]
        #[effects(alloc)]
        fn elem_slice(self: &mut Exec, e: &ast::Expr, base: &ast::Expr, lo: &ast::Expr, hi: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let v: encode_terms::Val = self.eval(base, pg, f - 1);
            let a: String = encode_terms::scalar_of(&self.eval(lo, pg, f - 1));
            let b: String = encode_terms::scalar_of(&self.eval(hi, pg, f - 1));
            let n: String = encode_spec::len_of(&v);
            self.oblige("E0805", e.span, "the range may be out of bounds", types::cat5("(and (<= ", a.as_str(), " ", b.as_str(), types::cat5(") (<= ", b.as_str(), " ", n.as_str(), "))").as_str()).as_str());
            encode_spec::sub_text(&v, a.as_str(), b.as_str())
        }

        #[summary("The end of an iteration of loop k (stage0 Enc::end_iteration): its body's end, or a `continue`. A `for` steps its variable as `if i == hi { break; } i = i + 1;` would (the test only for lo..=hi, the step with its overflow obligation, E0803), then the path goes back to the head")]
        #[effects(alloc)]
        fn end_iteration(self: &mut Exec, k: usize, pg: &encode_spec::Prog) -> () {
            if k >= self.loops.len() {
                return;
            }
            let step: Option<ForStep> = self.loops[k].step.clone();
            match &step {
                None => {},
                Some(st) => { let i: String = encode_terms::scalar_of(&var_of(&self.vars, st.var.as_str())); if st.inclusive { let b: Branch = self.branch_start(types::cat5("(= ", i.as_str(), " ", st.hi.as_str(), ")").as_str()); self.record_break(k, encode_terms::Val::Unit); let first: Side = self.branch_else(&b); let unit: ast::TypeKind = ast::TypeKind::Unit; self.branch_join(&b, &first, encode_terms::Val::Unit, encode_terms::Val::Unit, &unit, pg); if self.dead { return; } } let next: String = types::cat3("(+ ", i.as_str(), " 1)"); match encode_terms::range(&st.ty, next.as_str()) { None => {}, Some(rg) => self.oblige("E0803", st.span, types::cat3("`+` may overflow `", types::text(&st.ty).as_str(), "`").as_str(), rg.as_str()), } self.bind_var(st.var.as_str(), encode_terms::Val::S(next)); },
            }
            self.back_to_head(k, pg);
        }

        #[summary("The entry state of the executable function d, this state's definition (stage0 Enc::entry_params): each parameter is a fresh value in its type's range, valid (ADR-0060 §2: its caller proved it) and, where it is text, valid UTF-8 (ADR-0050 §3); the value behind a &mut parameter is also its `old`. The parameters are inputs, in order")]
        #[effects(alloc)]
        fn entry_params(self: &mut Exec, d: &ast::FnDef, pg: &encode_spec::Prog) -> () {
            let path: String = self.enc.path.clone();
            for i in 0..d.params.len()
                invariant 0 <= i && i <= d.params.len(),
            {
                let name: String = d.params[i].name.name.clone();
                let ty: ast::TypeKind = self.enc.local_ty(name.as_str(), pg);
                let v: encode_terms::Val = self.enc.fresh_val(name.as_str(), &ty, pg, 100000);
                self.assume_valid(&v, &ty, pg);
                if text_at(pg, path.as_str(), i) {
                    self.assume_text(&v);
                }
                if mut_ref(&d.params[i].ty.kind) {
                    self.was.insert(name.as_str(), v.clone());
                }
                self.inputs.push(encode_spec::Shown { name: name.clone(), v: v.clone(), ty: ty });
                self.bind_var(name.as_str(), v);
            }
        }

        #[summary("The requires clauses of d on the entry state (stage0 Enc::entry_requires), one term per clause")]
        #[effects(alloc)]
        fn entry_requires(self: &mut Exec, d: &ast::FnDef, pg: &encode_spec::Prog) -> Vec<String> {
            let env: table::Table<encode_terms::Val> = self.vars.clone();
            let was: table::Table<encode_terms::Val> = self.was.clone();
            let mut out: Vec<String> = Vec::new();
            for i in 0..d.pre.len()
                invariant 0 <= i && i <= d.pre.len(),
            {
                out.push(encode_terms::scalar_of(&self.enc.spec_expr(&d.pre[i], &env, &was, pg, 100000)));
            }
            out
        }

        #[summary("The value of expression e in code, with its obligations and what the path learns (stage0 Enc::eval): one function per kind of expression. In ghost code an expression has no value: its effect is ghost_expr's. The unit value for a construct of specifications, a closure and a range, none of which code holds after checking")]
        #[effects(alloc)]
        fn eval(self: &mut Exec, e: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            if self.ghost {
                self.ghost_expr(e, pg, f - 1);
                return encode_terms::Val::Unit;
            }
            match &e.kind {
                ast::ExprKind::Int(v, ev_r) => encode_terms::Val::S(encode_terms::num(&encode_terms::Int { neg: false, mag: *v })),
                ast::ExprKind::Float(bits) => encode_terms::Val::S(encode_terms::f64_lit(*bits)),
                ast::ExprKind::ByteLit(bl) => encode_terms::Val::S(encode_terms::dec(*bl as u64)),
                ast::ExprKind::ByteStr(bs) => encode_terms::Val::A(encode_terms::byte_array(bs.as_slice()), encode_terms::dec(bs.len() as u64)),
                ast::ExprKind::StrLit(sl) => encode_terms::Val::A(encode_terms::byte_array(sl.as_bytes()), encode_terms::dec(sl.len() as u64)),
                ast::ExprKind::CharLit(ch) => encode_terms::Val::S(encode_terms::dec(*ch as u64)),
                ast::ExprKind::Bool(on) => { if *on { encode_terms::Val::S(String::from("true")) } else { encode_terms::Val::S(String::from("false")) } },
                ast::ExprKind::Unit => encode_terms::Val::Unit,
                ast::ExprKind::Var(id) => { if id.name == "None" && !self.vars.has("None") { let no: Vec<encode_terms::Val> = Vec::new(); encode_spec::variant_value(&self.enc.ty(e, pg), "None", no.as_slice()) } else { var_of(&self.vars, id.name.as_str()) } },
                ast::ExprKind::Call(c) => self.eval_call(e, c, pg, f - 1),
                ast::ExprKind::Method(mc) => self.eval_method(e, mc, pg, f - 1),
                ast::ExprKind::Index(ib, ii) => self.eval_index(e, &**ib, &**ii, pg, f - 1),
                ast::ExprKind::Unary(uop, ux) => self.eval_unary(e, *uop, &**ux, pg, f - 1),
                ast::ExprKind::Binary(bop, lhs, rhs) => self.eval_binary(e, *bop, &**lhs, &**rhs, pg, f - 1),
                ast::ExprKind::Ref(ev_m, rx) => self.eval(&**rx, pg, f - 1),
                ast::ExprKind::If(ifx) => self.eval_if(e, ifx, pg, f - 1),
                ast::ExprKind::Block(b) => self.block(b, pg, f - 1),
                ast::ExprKind::Array(items) => self.eval_array(e, items.as_slice(), pg, f - 1),
                ast::ExprKind::Repeat(rp) => self.eval_repeat(e, rp, pg, f - 1),
                ast::ExprKind::Old(eve_old0) => encode_terms::Val::Unit,
                ast::ExprKind::Quant(eve_quant0) => encode_terms::Val::Unit,
                ast::ExprKind::Trigger(eve_trigger0) => encode_terms::Val::Unit,
                ast::ExprKind::Closure(eve_closure0) => encode_terms::Val::Unit,
                ast::ExprKind::StructLit(lit) => self.eval_struct_lit(e, lit, pg, f - 1),
                ast::ExprKind::Path(segs) => self.enc.spec_path(e, segs.as_slice(), pg),
                ast::ExprKind::Deref(dx) => self.eval(&**dx, pg, f - 1),
                ast::ExprKind::Field(fb, fname) => self.eval_field(&**fb, fname.name.as_str(), pg, f - 1),
                ast::ExprKind::Match(mx) => self.eval_match(e, mx, pg, f - 1),
                ast::ExprKind::Return(rv) => self.eval_return(e, rv, pg, f - 1),
                ast::ExprKind::Try(tx) => self.eval_try(e, &**tx, pg, f - 1),
                ast::ExprKind::Loop(lp) => self.eval_loop(e, lp, pg, f - 1),
                ast::ExprKind::Break(bk) => self.eval_break(bk, pg, f - 1),
                ast::ExprKind::Continue(label) => self.eval_continue(label, pg),
                ast::ExprKind::Range(eve_range0) => encode_terms::Val::Unit,
                ast::ExprKind::Error => encode_terms::Val::Unit,
            }
        }

        #[summary("An array literal in code (the Array arms of stage0 Enc::eval). An array of structs or enums is fresh element arrays with each item stored, so no default value is needed; an array of scalars is a constant array of the type's default with each item stored")]
        #[effects(alloc)]
        fn eval_array(self: &mut Exec, e: &ast::Expr, items: &[ast::Expr], pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let elem: ast::TypeKind = encode_decls::elem_ty(&self.enc.ty(e, pg));
            let agg: bool = encode_decls::agg_elem(&elem, &pg.pr.t);
            let len: String = encode_terms::dec(items.len() as u64);
            if body::is_named(&elem) || agg {
                let mut vals: Vec<encode_terms::Val> = Vec::new();
                for i in 0..items.len()
                    invariant 0 <= i && i <= items.len(),
                {
                    vals.push(self.eval(&items[i], pg, f - 1));
                }
                let mut arr: encode_terms::Val = if agg {
                    self.enc.fresh_struct_elems("arr", &elem, pg)
                } else {
                    encode_terms::Val::S(encode_terms::fresh(&mut self.enc.fr, "arr.e", types::cat3("(Array Int ", encode_decls::sort_of(&elem).as_str(), ")").as_str()))
                };
                for k in 0..vals.len()
                    invariant 0 <= k && k <= vals.len(),
                {
                    arr = encode_terms::store_val(&arr, encode_terms::dec(k as u64).as_str(), &vals[k], 100000);
                }
                return encode_spec::whole_array(arr, len.clone());
            }
            let mut elems: String = types::cat5("((as const (Array Int ", encode_decls::sort_of(&elem).as_str(), ")) ", encode_terms::default_of(&elem).as_str(), ")");
            for k in 0..items.len()
                invariant 0 <= k && k <= items.len(),
            {
                let v: String = encode_terms::scalar_of(&self.eval(&items[k], pg, f - 1));
                elems = types::cat7("(store ", elems.as_str(), " ", encode_terms::dec(k as u64).as_str(), " ", v.as_str(), ")");
            }
            encode_terms::Val::A(elems, len)
        }

        #[summary("A binary operation in code (the Binary arms of stage0 Enc::eval). `&&` and `||` short-circuit: the right operand runs only when it matters, what it learns holds whenever it ran, and one that returned leaves the left value on the path where it did not run. Text compares by bytes (text_cmp_code, ADR-0050 §2). f64 arithmetic is total (ADR-0061 §3). A bit operation has its shift obligation and, unless it is linear, a bit-vector term with its facts. `/` and `%` have a divisor obligation (E0804) and their lemmas; the arithmetic results must lie in the type (E0803)")]
        #[effects(alloc)]
        fn eval_binary(self: &mut Exec, e: &ast::Expr, op: ast::BinOp, l: &ast::Expr, r: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let k: u8 = encode_spec::op_code(op);
            if k == 11 || k == 12 {
                let lt: String = encode_terms::scalar_of(&self.eval(l, pg, f - 1));
                let n: usize = self.enc.pc.len();
                let guard: String = if k == 11 {
                    lt.clone()
                } else {
                    types::cat3("(not ", lt.as_str(), ")")
                };
                self.enc.pc.push(guard.clone());
                let rt: String = encode_terms::scalar_of(&self.eval(r, pg, f - 1));
                if self.dead {
                    self.dead = false;
                    self.enc.pc.truncate(n);
                    self.enc.pc.push(types::cat3("(not ", guard.as_str(), ")"));
                    return encode_terms::Val::S(lt);
                }
                let facts: Vec<String> = tail(self.enc.pc.as_slice(), n.saturating_add(1));
                self.enc.pc.truncate(n);
                let lifted: Vec<String> = encode_terms::guarded(guard.as_str(), facts.as_slice());
                extend(&mut self.enc.pc, lifted.as_slice());
                if k == 11 {
                    return encode_terms::Val::S(types::cat5("(and ", lt.as_str(), " ", rt.as_str(), ")"));
                }
                return encode_terms::Val::S(types::cat5("(or ", lt.as_str(), " ", rt.as_str(), ")"));
            }
            if body::is_cmp(op) && (self.enc.is_text_expr(l, pg) || self.enc.is_text_expr(r, pg)) {
                let tl: encode_terms::Val = self.eval(l, pg, f - 1);
                let tr: encode_terms::Val = self.eval(r, pg, f - 1);
                return encode_terms::Val::S(self.text_cmp_code(k, &tl, &tr));
            }
            let ty: ast::TypeKind = self.enc.ty(l, pg);
            let a: String = encode_terms::scalar_of(&self.eval(l, pg, f - 1));
            let b: String = encode_terms::scalar_of(&self.eval(r, pg, f - 1));
            if body::is_f64(&ty) {
                return match encode_terms::f64_binary(op, a.as_str(), b.as_str()) { None => encode_terms::Val::Unit, Some(ft) => encode_terms::Val::S(ft), };
            }
            if k == 14 {
                return self.eval_bits(e, op, r, &ty, a.as_str(), b.as_str(), pg);
            }
            if k == 5 {
                return encode_terms::Val::S(types::cat5("(= ", a.as_str(), " ", b.as_str(), ")"));
            }
            if k == 6 {
                return encode_terms::Val::S(types::cat5("(not (= ", a.as_str(), " ", b.as_str(), "))"));
            }
            if k >= 7 && k <= 10 {
                return encode_terms::Val::S(encode_terms::ord_term(op, &ty, a.as_str(), b.as_str()));
            }
            let signed: bool = codegen::is_signed(&ty);
            let t: String = if k == 0 {
                types::cat5("(+ ", a.as_str(), " ", b.as_str(), ")")
            } else if k == 1 {
                types::cat5("(- ", a.as_str(), " ", b.as_str(), ")")
            } else if k == 2 {
                self.enc.mul_facts(a.as_str(), b.as_str());
                types::cat5("(* ", a.as_str(), " ", b.as_str(), ")")
            } else if k == 3 || k == 4 {
                self.eval_div(e, k == 4, r, &ty, signed, a.as_str(), b.as_str())
            } else {
                return encode_terms::Val::Unit;
            };
            match encode_terms::range(&ty, t.as_str()) {
                None => {},
                Some(rg) => self.oblige("E0803", e.span, types::cat5("`", body::op_symbol(op).as_str(), "` may overflow `", types::text(&ty).as_str(), "`").as_str(), rg.as_str()),
            }
            encode_terms::Val::S(t)
        }

        #[summary("A bit operation or a shift a op b in code on operands of type ty (the bit part of the Binary arm of stage0 Enc::eval): on bool the connective; on an integer the shift obligation, then the linear form where there is one, else the bit-vector term over the named operands with its facts")]
        #[effects(alloc)]
        fn eval_bits(self: &mut Exec, e: &ast::Expr, op: ast::BinOp, amount: &ast::Expr, ty: &ast::TypeKind, a: &str, b: &str, pg: &encode_spec::Prog) -> encode_terms::Val {
            let i: ast::IntTy = match body::int_of(ty) {
                None => { return encode_terms::Val::S(encode_terms::bool_bit(op, a, b)); },
                Some(found) => found,
            };
            if body::is_shift(op) {
                self.shift_obligation(e, op, i, amount, b, pg);
            }
            match encode_terms::linear_bit(op, i, a, b) {
                None => {},
                Some(lin) => { return encode_terms::Val::S(lin); },
            }
            let xa: String = self.operand_bv(i, a);
            let xb: String = self.operand_bv(i, b);
            let t: String = encode_terms::bv_term(op, i, xa.as_str(), xb.as_str());
            let facts: Vec<String> = encode_terms::bit_facts(op, i, a, b, t.as_str());
            extend(&mut self.enc.pc, facts.as_slice());
            encode_terms::Val::S(t)
        }

        #[summary("`break` in code (the Break arm of stage0 Enc::eval): the state goes to the exit of its loop with the value it carries, and the path ends")]
        #[effects(alloc)]
        fn eval_break(self: &mut Exec, x: &ast::Break, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let v: encode_terms::Val = match &x.value {
                None => encode_terms::Val::Unit,
                Some(bx) => self.eval(&**bx, pg, f - 1),
            };
            if !self.dead {
                let k: usize = self.jump_target(&x.label);
                self.record_break(k, v.clone());
            }
            encode_terms::Val::Unit
        }

        #[summary("A call expression in code (the Call arms of stage0 Enc::eval): Vec::new and its kin, the built-ins of text and char (plain values, char::from_u32 and String::from_utf8), Box::new, an integer from its bytes, f64::from (E0815 for a 64-bit source), std::mem::replace and swap, a variant with its payload; otherwise a call of a function (call)")]
        #[effects(alloc)]
        fn eval_call(self: &mut Exec, e: &ast::Expr, c: &ast::Call, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let two: bool = c.path.len() == 2;
            let p0: String = if c.path.len() > 0 {
                c.path[0].name.clone()
            } else {
                String::new()
            };
            let p1: String = if c.path.len() > 1 {
                c.path[1].name.clone()
            } else {
                String::new()
            };
            let one_arg: bool = c.args.len() > 0;
            if two && (p0 == "Vec" || p0 == "String") && (p1 == "new" || p1 == "with_capacity") {
                return self.vec_new(e, c, pg, f - 1);
            }
            if body::text_builtin(c.path.as_slice()) || two && p0 == "u32" && p1 == "from" {
                if !one_arg {
                    return encode_terms::Val::Unit;
                }
                let tv: encode_terms::Val = self.eval(&c.args[0], pg, f - 1);
                if p1 == "from_utf8" {
                    return self.string_from_utf8(e, &tv, pg);
                }
                if p1 == "from_u32" {
                    return self.enc.char_from_u32(e, encode_terms::scalar_of(&tv).as_str(), pg);
                }
                return tv;
            }
            if body::is_box_new(c.path.as_slice()) {
                if one_arg {
                    return self.eval(&c.args[0], pg, f - 1);
                }
                return encode_terms::Val::Unit;
            }
            match body::from_bytes_int(c.path.as_slice()) {
                None => {},
                Some(it) => { if one_arg { let bv: encode_terms::Val = self.eval(&c.args[0], pg, f - 1); let rv: encode_terms::Val = encode_terms::from_bytes_val(it, p1 == "from_le_bytes", &bv); match encode_terms::parts(&bv) { None => {}, Some(bp) => match encode_terms::from_bytes_fact(it, p1 == "from_le_bytes", bp.a.as_str()) { None => {}, Some(fact) => self.enc.pc.push(fact), }, } return rv; } return encode_terms::Val::Unit; },
            }
            if body::is_f64_from(c.path.as_slice()) {
                if !one_arg {
                    return encode_terms::Val::Unit;
                }
                let fv: String = encode_terms::scalar_of(&self.eval(&c.args[0], pg, f - 1));
                return match body::int_of(&self.enc.ty(&c.args[0], pg)) { None => encode_terms::Val::S(fv), Some(src) => { if body::bits(src) == 64 { let ex: String = encode_terms::f64_exact(); self.oblige("E0815", e.span, types::cat3("`f64::from` of `", body::int_text(src).as_str(), "` may not be exact (|x| <= 2^53)").as_str(), types::cat5("(and (<= (- ", ex.as_str(), ") ", fv.as_str(), types::cat5(") (<= ", fv.as_str(), " ", ex.as_str(), "))").as_str()).as_str()); } encode_terms::Val::S(types::cat3("(f64.from ", fv.as_str(), ")")) }, };
            }
            if body::mem_op(c.path.as_slice()) {
                return self.mem_call(last_name(c.path.as_slice()) == "replace", c.args.as_slice(), pg, f - 1);
            }
            if self.enc.is_variant(c.path.as_slice(), pg) {
                let mut vals: Vec<encode_terms::Val> = Vec::new();
                for i in 0..c.args.len()
                    invariant 0 <= i && i <= c.args.len(),
                {
                    vals.push(self.eval(&c.args[i], pg, f - 1));
                }
                return encode_spec::variant_value(&self.enc.ty(e, pg), last_name(c.path.as_slice()).as_str(), vals.as_slice());
            }
            self.call(c.path.as_slice(), c.args.as_slice(), e.span, pg, f - 1)
        }

        #[summary("`continue` in code (the Continue arm of stage0 Enc::eval): back to the head of its loop, which owes its invariants and its measure (a `for` steps its variable first), and the path ends")]
        #[effects(alloc)]
        fn eval_continue(self: &mut Exec, label: &Option<ast::Ident>, pg: &encode_spec::Prog) -> encode_terms::Val {
            if !self.dead {
                let k: usize = self.jump_target(label);
                self.end_iteration(k, pg);
                self.dead = true;
            }
            encode_terms::Val::Unit
        }

        #[summary("`/` (or `%` when rem) of a by b in code on operands of type ty (the Div and Rem part of stage0 Enc::eval): the divisor is not zero (E0804, at the divisor r), a signed `%` is not MIN % -1 (E0803), and the lemmas of the quotient and the remainder are facts. Truncating on signed operands, SMT's on unsigned ones. The term")]
        #[effects(alloc)]
        fn eval_div(self: &mut Exec, e: &ast::Expr, rem: bool, r: &ast::Expr, ty: &ast::TypeKind, signed: bool, a: &str, b: &str) -> String {
            self.oblige("E0804", r.span, "divisor may be zero", types::cat3("(not (= ", b, " 0))").as_str());
            if rem && signed {
                match body::int_of(ty) {
                    None => {},
                    Some(it) => self.oblige("E0803", e.span, types::cat3("`", body::int_text(it).as_str(), "::MIN % -1` may occur").as_str(), types::cat7("(not (and (= ", a, " ", encode_terms::num(&encode_terms::from_num(consts::min_of(it))).as_str(), ") (= ", b, " (- 1))))").as_str()),
                }
            }
            let q: String = if signed {
                types::cat5("(bmb_tdiv ", a, " ", b, ")")
            } else {
                types::cat5("(div ", a, " ", b, ")")
            };
            let m: String = if signed {
                types::cat5("(bmb_trem ", a, " ", b, ")")
            } else {
                types::cat5("(mod ", a, " ", b, ")")
            };
            let lemmas: Vec<String> = if signed {
                encode_terms::signed_div_lemmas()
            } else {
                encode_terms::unsigned_div_lemmas()
            };
            for i in 0..lemmas.len()
                invariant 0 <= i && i <= lemmas.len(),
            {
                self.enc.pc.push(encode_terms::instantiate(lemmas[i].as_str(), a, b, q.as_str(), m.as_str()));
            }
            if rem {
                m
            } else {
                q
            }
        }

        #[summary("A field read in code (the Field arm of stage0 Enc::eval): the field's value of a struct held as leaves, the selector's of a recursive struct (its facts are added to each query, struct_facts). A place under & or &mut has no recorded type: its type is read from the place")]
        #[effects(alloc)]
        fn eval_field(self: &mut Exec, base: &ast::Expr, name: &str, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let recorded: ast::TypeKind = self.enc.ty(base, pg);
            let bt: ast::TypeKind = if types::is_error(&recorded) {
                self.place_ty(base, pg, f - 1)
            } else {
                recorded
            };
            let k: usize = encode_decls::field_index(&bt, &pg.pr.t, name);
            let bv: encode_terms::Val = self.eval(base, pg, f - 1);
            match &bv {
                encode_terms::Val::S(x) => { if encode_decls::dt_struct(&bt, &pg.pr.t) { let dfs: Vec<encode_terms::Val> = encode_terms::dt_fields(&lowered::value_ty(&bt), x.as_str(), &pg.pr.t); if k < dfs.len() { dfs[k].clone() } else { encode_terms::Val::Unit } } else { encode_terms::Val::Unit } },
                encode_terms::Val::A(efv_a0, efv_a1) => encode_terms::Val::Unit,
                encode_terms::Val::Unit => encode_terms::Val::Unit,
                encode_terms::Val::Struct(fs) => { if k < fs.len() { fs[k].clone() } else { encode_terms::Val::Unit } },
                encode_terms::Val::Arr(efv_arr0, efv_arr1) => encode_terms::Val::Unit,
            }
        }

        #[summary("An `if` in code (the If arm of stage0 Enc::eval): both sides from the same state, merged under the condition")]
        #[effects(alloc)]
        fn eval_if(self: &mut Exec, e: &ast::Expr, x: &ast::If, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let c: String = encode_terms::scalar_of(&self.eval(&*x.cond, pg, f - 1));
            let t: ast::TypeKind = self.enc.ty(e, pg);
            let b: Branch = self.branch_start(c.as_str());
            let tv: encode_terms::Val = self.block(&x.then, pg, f - 1);
            let first: Side = self.branch_else(&b);
            let ev: encode_terms::Val = match &x.els {
                None => encode_terms::Val::Unit,
                Some(el) => self.eval(&**el, pg, f - 1),
            };
            self.branch_join(&b, &first, tv, ev, &t, pg)
        }

        #[summary("An index in code (the Index arms of stage0 Enc::eval): `&v[a..b]` is a slice, of text (str_slice) or of an array (elem_slice); `a[i]` has its bounds obligation (E0805), and the element read is in its range, leaf by leaf for an aggregate")]
        #[effects(alloc)]
        fn eval_index(self: &mut Exec, e: &ast::Expr, base: &ast::Expr, index: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            match codegen::range_of(index) {
                None => {},
                Some(rg) => { if self.enc.is_text_expr(base, pg) { return self.str_slice(e, base, &*rg.lo, &*rg.hi, pg, f - 1); } return self.elem_slice(e, base, &*rg.lo, &*rg.hi, pg, f - 1); },
            }
            let bv: encode_terms::Val = self.eval(base, pg, f - 1);
            let i: String = encode_terms::scalar_of(&self.eval(index, pg, f - 1));
            let len: String = encode_spec::len_of(&bv);
            self.oblige("E0805", e.span, "index may be out of bounds", types::cat7("(and (<= 0 ", i.as_str(), ") (< ", i.as_str(), " ", len.as_str(), "))").as_str());
            match &bv {
                encode_terms::Val::S(eiv_s0) => encode_terms::Val::Unit,
                encode_terms::Val::A(elems, ei_l) => { let t: String = types::cat5("(select ", elems.as_str(), " ", i.as_str(), ")"); match encode_terms::range(&self.enc.ty(e, pg), t.as_str()) { None => {}, Some(r) => self.enc.pc.push(r), } encode_terms::Val::S(t) },
                encode_terms::Val::Unit => encode_terms::Val::Unit,
                encode_terms::Val::Struct(eiv_struct0) => encode_terms::Val::Unit,
                encode_terms::Val::Arr(elem, ei_n) => { let v: encode_terms::Val = encode_terms::select_val(&**elem, i.as_str(), 100000); let et: ast::TypeKind = self.enc.ty(e, pg); let mut ls: Vec<encode_decls::NamedLeaf> = Vec::new(); encode_decls::leaves(&et, &pg.pr.t, "", &mut ls, 100000); let mut terms: Vec<String> = Vec::new(); encode_terms::flatten(&v, &mut terms, 100000); for j in 0..ls.len() invariant 0 <= j && j <= ls.len(), { if j < terms.len() { match encode_terms::leaf_fact(&ls[j].leaf, terms[j].as_str()) { None => {}, Some(fact) => self.enc.pc.push(fact), } } } v },
            }
        }

        #[summary("`loop` in code (the Loop arm of stage0 Enc::eval): a loop with neither a condition nor a step, whose value is its breaks'")]
        #[effects(alloc)]
        fn eval_loop(self: &mut Exec, e: &ast::Expr, x: &ast::Loop, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let cond: Option<ast::Expr> = None;
            let dec: Option<ast::Expr> = match &x.measure {
                None => None,
                Some(d) => Some(copy_expr(&**d)),
            };
            let step: Option<ForStep> = None;
            self.loop_core(&x.label, &cond, x.invariants.as_slice(), &dec, &x.body, &step, e.span, pg, f - 1)
        }

        #[summary("An executable `match` (the Match arm of stage0 Enc::eval). For a match on &mut (ADR-0055) the arm's bindings are written back to the scrutinee's place at its end")]
        #[effects(alloc)]
        fn eval_match(self: &mut Exec, e: &ast::Expr, x: &ast::Match, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let sv: String = encode_terms::scalar_of(&self.eval(&*x.scrut, pg, f - 1));
            let st: ast::TypeKind = self.enc.ty(&*x.scrut, pg);
            let t: ast::TypeKind = self.enc.ty(e, pg);
            let back: Option<ast::Expr> = if mut_ref(&st) {
                match body::ref_of(&*x.scrut) {
                    None => Some(copy_expr(&*x.scrut)),
                    Some(inner) => Some(inner),
                }
            } else {
                None
            };
            self.match_arms(sv.as_str(), &st, x.arms.as_slice(), 0, &t, &back, pg, f - 1)
        }

        #[summary("A built-in method call in code (the Method arms of stage0 Enc::eval): T::try_from(x).unwrap() with its range obligation (E0815) and .ok() as an Option (ADR-0028); len; the views of a Vec and of text, and clone; push_str and push on text (text_change); push, pop and truncate on a Vec (vec_change); copy_within; is_char_boundary and len_utf8; the methods of f64; the bit methods through a named bit-vector; the bytes of an integer; the arithmetic methods (a checked one is an Option, with its lemmas)")]
        #[effects(alloc)]
        fn eval_method(self: &mut Exec, e: &ast::Expr, x: &ast::Method, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let m: String = x.name.name.clone();
            match codegen::conv_parts(&*x.recv) {
                None => {},
                Some(cv) => { let v: String = encode_terms::scalar_of(&self.eval(&cv.arg, pg, f - 1)); let st: ast::TypeKind = self.enc.ty(&cv.arg, pg); let target: ast::TypeKind = ast::TypeKind::Int(cv.target); let r: String = encode_terms::range_int(cv.target, v.as_str()); if m == "unwrap" { if body::conv_obligation(&st, &target) { self.oblige("E0815", e.span, types::cat3("conversion to `", types::text(&target).as_str(), "` may be out of range").as_str(), r.as_str()); } return encode_terms::Val::S(v); } return self.enc.checked(e, r.as_str(), v.as_str(), pg); },
            }
            let rv: encode_terms::Val = self.eval(&*x.recv, pg, f - 1);
            if m == "len" {
                return match &rv { encode_terms::Val::S(mlv_s0) => encode_terms::Val::Unit, encode_terms::Val::A(ml_e, al) => encode_terms::Val::S(al.clone()), encode_terms::Val::Unit => encode_terms::Val::Unit, encode_terms::Val::Struct(mlv_struct0) => encode_terms::Val::Unit, encode_terms::Val::Arr(ml_t, tl) => encode_terms::Val::S(tl.clone()), };
            }
            if m == "as_slice" || m == "as_mut_slice" || m == "clone" || m == "as_str" || m == "as_bytes" {
                return rv;
            }
            if (m == "push_str" || m == "push") && self.enc.is_text_expr(&*x.recv, pg) {
                return self.text_change(&*x.recv, &rv, m == "push_str", x.args.as_slice(), pg, f - 1);
            }
            if m == "push" || m == "pop" || m == "truncate" {
                return self.vec_change(e, x, &rv, pg, f - 1);
            }
            if m == "copy_within" {
                return self.copy_within(e, x, &rv, pg, f - 1);
            }
            let first: Option<String> = if m == "len_utf8" || x.args.len() == 0 {
                None
            } else {
                Some(encode_terms::scalar_of(&self.eval(&x.args[0], pg, f - 1)))
            };
            let arg: String = match &first {
                None => String::new(),
                Some(a0) => a0.clone(),
            };
            if m == "is_char_boundary" {
                return match encode_terms::parts(&rv) { None => encode_terms::Val::Unit, Some(p) => encode_terms::Val::S(encode_terms::boundary(p.a.as_str(), p.b.as_str(), arg.as_str())), };
            }
            let r: String = encode_terms::scalar_of(&rv);
            if m == "len_utf8" {
                self.enc.pc.push(encode_terms::scalar(r.as_str()));
                return encode_terms::Val::S(encode_terms::utf8_len(r.as_str()));
            }
            let rt: ast::TypeKind = self.enc.ty(&*x.recv, pg);
            if body::is_f64(&lowered::value_ty(&rt)) {
                return encode_terms::Val::S(encode_terms::f64_method(m.as_str(), r.as_str(), &first));
            }
            let i: ast::IntTy = match body::int_of(&rt) {
                None => { return encode_terms::Val::Unit; },
                Some(found) => found,
            };
            if m == "checked_shl" || m == "checked_shr" {
                let w: String = if m == "checked_shl" {
                    String::from("wrapping_shl")
                } else {
                    String::from("wrapping_shr")
                };
                let sv: String = self.bit_method_code(w.as_str(), i, r.as_str(), &first);
                return self.enc.checked(e, types::cat5("(< ", arg.as_str(), " ", encode_terms::dec(body::bits(i) as u64).as_str(), ")").as_str(), sv.as_str(), pg);
            }
            if m == "to_be_bytes" || m == "to_le_bytes" {
                self.enc.pc.push(encode_terms::bytes_fact(i, m == "to_le_bytes", r.as_str()));
                return encode_terms::bytes_val(i, m == "to_le_bytes", r.as_str(), false);
            }
            if m == "is_power_of_two" {
                let no_amount: Option<String> = None;
                let ones: String = self.bit_method_code("count_ones", i, r.as_str(), &no_amount);
                return encode_terms::Val::S(types::cat3("(= ", ones.as_str(), " 1)"));
            }
            if body::bit_method(m.as_str()) != 0 {
                return encode_terms::Val::S(self.bit_method_code(m.as_str(), i, r.as_str(), &first));
            }
            if encode_decls::ends_with(m.as_str(), "_mul") {
                self.enc.mul_facts(r.as_str(), arg.as_str());
            }
            let im: encode_terms::IntMethod = encode_terms::int_method(m.as_str(), i, r.as_str(), arg.as_str());
            if im.checked {
                extend(&mut self.enc.pc, im.lemmas.as_slice());
                return self.enc.checked(e, im.ok.as_str(), im.v.as_str(), pg);
            }
            encode_terms::Val::S(im.v.clone())
        }

        #[summary("`[v; N]` in code (the Repeat arms of stage0 Enc::eval): one constant array, or one per leaf of an aggregate element value")]
        #[effects(alloc)]
        fn eval_repeat(self: &mut Exec, e: &ast::Expr, x: &ast::Repeat, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let elem: ast::TypeKind = encode_decls::elem_ty(&self.enc.ty(e, pg));
            let count: String = encode_terms::num(&encode_terms::Int { neg: false, mag: x.count });
            let v: encode_terms::Val = self.eval(&*x.value, pg, f - 1);
            if encode_decls::agg_elem(&elem, &pg.pr.t) {
                return encode_terms::Val::Arr(Box::new(encode_terms::const_elems(&elem, &v, &pg.pr.t, 100000)), count);
            }
            encode_terms::Val::A(types::cat5("((as const (Array Int ", encode_decls::sort_of(&elem).as_str(), ")) ", encode_terms::scalar_of(&v).as_str(), ")"), count)
        }

        #[summary("`return x` in code (the Return arm of stage0 Enc::eval): the postconditions hold here, and the path ends (ADR-0049 §3)")]
        #[effects(alloc)]
        fn eval_return(self: &mut Exec, e: &ast::Expr, x: &Option<Box<ast::Expr>>, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let v: encode_terms::Val = match x {
                None => encode_terms::Val::Unit,
                Some(rx) => self.eval(&**rx, pg, f - 1),
            };
            if !self.dead {
                self.post_check(&v, e.span, "at this `return`", pg);
                self.dead = true;
            }
            encode_terms::Val::Unit
        }

        #[summary("A struct literal in code (the StructLit arm of stage0 Enc::eval): the fields are evaluated as written, the value is in declaration order; a recursive struct is a fresh constant with its selectors stated (mk_struct)")]
        #[effects(alloc)]
        fn eval_struct_lit(self: &mut Exec, e: &ast::Expr, x: &ast::StructLit, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let t: ast::TypeKind = self.enc.ty(e, pg);
            let mut at: Vec<usize> = Vec::new();
            let mut vals: Vec<encode_terms::Val> = Vec::new();
            for i in 0..x.fields.len()
                invariant 0 <= i && i <= x.fields.len(),
            {
                let v: encode_terms::Val = self.eval(&x.fields[i].value, pg, f - 1);
                at.push(encode_decls::field_index(&t, &pg.pr.t, x.fields[i].name.name.as_str()));
                vals.push(v);
            }
            let count: usize = match lowered::struct_fields(&t, &pg.pr.t) {
                None => 0,
                Some(fs) => fs.len(),
            };
            let mut out: Vec<encode_terms::Val> = Vec::new();
            for k in 0..count
                invariant 0 <= k && k <= count,
            {
                for i in 0..at.len()
                    invariant 0 <= i && i <= at.len(),
                {
                    if at[i] == k && i < vals.len() {
                        out.push(vals[i].clone());
                    }
                }
            }
            for i in 0..at.len()
                invariant 0 <= i && i <= at.len(),
            {
                if at[i] >= count && i < vals.len() {
                    out.push(vals[i].clone());
                }
            }
            if encode_decls::dt_struct(&t, &pg.pr.t) {
                return encode_terms::mk_struct(&mut self.enc.fr, &t, out.as_slice(), &pg.pr.t);
            }
            encode_terms::Val::Struct(out)
        }

        #[summary("`x?` in code (the Try arm of stage0 Enc::eval, ADR-0049 §3), encoded as its expansion: match x { None => return None, Some(v) => v } and Ok(v) => v, Err(e) => return Err(e), the arms in declaration order. The side that leaves builds the function's result type and owes the postconditions")]
        #[effects(alloc)]
        fn eval_try(self: &mut Exec, e: &ast::Expr, x: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let sv: String = encode_terms::scalar_of(&self.eval(x, pg, f - 1));
            let st: ast::TypeKind = self.enc.ty(x, pg);
            let option: bool = body::try_variants(&st) == 1;
            let t: ast::TypeKind = self.enc.ty(e, pg);
            if option {
                let b: Branch = self.branch_start(types::cat5("((_ is ", encode_decls::ctor(&st, "None").as_str(), ") ", sv.as_str(), ")").as_str());
                let tv: encode_terms::Val = self.try_leave(e, &st, "None", sv.as_str(), pg);
                let first: Side = self.branch_else(&b);
                let ev: encode_terms::Val = self.try_go_on(&st, "Some", sv.as_str(), pg);
                return self.branch_join(&b, &first, tv, ev, &t, pg);
            }
            let b2: Branch = self.branch_start(types::cat5("((_ is ", encode_decls::ctor(&st, "Ok").as_str(), ") ", sv.as_str(), ")").as_str());
            let tv2: encode_terms::Val = self.try_go_on(&st, "Ok", sv.as_str(), pg);
            let first2: Side = self.branch_else(&b2);
            let ev2: encode_terms::Val = self.try_leave(e, &st, "Err", sv.as_str(), pg);
            self.branch_join(&b2, &first2, tv2, ev2, &t, pg)
        }

        #[summary("A unary operation in code (the Unary arms of stage0 Enc::eval): the negation of an f64 is total, of a literal its numeral, of another integer an overflow obligation (E0803); `!` flips every bit of an integer and negates a bool")]
        #[effects(alloc)]
        fn eval_unary(self: &mut Exec, e: &ast::Expr, op: ast::UnOp, x: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let xt: ast::TypeKind = self.enc.ty(x, pg);
            if body::is_neg(op) {
                if body::is_f64(&xt) {
                    let fv: String = encode_terms::scalar_of(&self.eval(x, pg, f - 1));
                    return encode_terms::Val::S(encode_spec::f64_neg(x, fv.as_str()));
                }
                match encode_spec::int_lit(x) {
                    None => {},
                    Some(mag) => { return encode_terms::Val::S(encode_terms::num(&encode_terms::Int { neg: mag.hi != 0 || mag.lo != 0, mag: mag })); },
                }
                let t: String = types::cat3("(- ", encode_terms::scalar_of(&self.eval(x, pg, f - 1)).as_str(), ")");
                match encode_terms::range(&self.enc.ty(e, pg), t.as_str()) {
                    None => {},
                    Some(r) => self.oblige("E0803", e.span, "negation may overflow", r.as_str()),
                }
                return encode_terms::Val::S(t);
            }
            let v: String = encode_terms::scalar_of(&self.eval(x, pg, f - 1));
            match body::int_of(&xt) {
                None => encode_terms::Val::S(types::cat3("(not ", v.as_str(), ")")),
                Some(i) => encode_terms::Val::S(encode_terms::not_term(i, v.as_str())),
            }
        }

        #[summary("The obligations of the executable function d, this state's definition (stage0 Enc::exec_body): on the entry state, the refinement of its trait's contract, then the body under its requires and the postconditions where it ends")]
        #[effects(alloc)]
        fn exec_body(self: &mut Exec, d: &ast::FnDef, pg: &encode_spec::Prog) -> () {
            self.entry_params(d, pg);
            match encode_decls::refinement_of(&pg.pr.t, self.enc.path.as_str()) {
                None => {},
                Some(rf) => self.refines(d, rf.base.as_str(), &rf.sub, 0, pg),
            }
            let req: Vec<String> = self.entry_requires(d, pg);
            extend(&mut self.enc.pc, req.as_slice());
            match &d.measure {
                None => {},
                Some(dec) => { let env: table::Table<encode_terms::Val> = self.vars.clone(); let was: table::Table<encode_terms::Val> = self.was.clone(); let m: encode_spec::Measure = self.enc.measure(dec, &env, &was, pg, 100000); self.entry_measure = Some(m); },
            }
            let result: encode_terms::Val = self.block(&d.body, pg, 100000);
            if !self.dead {
                self.mark_reach(d.name.span, "end of the body");
                let at: source::Span = match &d.body.tail {
                    None => d.name.span,
                    Some(t) => t.span,
                };
                self.post_check(&result, at, "at the end of the body", pg);
            }
        }

        #[summary("The obligations at an exit of the function (stage0 Enc::exit_valid, ADR-0060 §2, with the postconditions): its result and the current value of each &mut parameter are valid")]
        #[effects(alloc)]
        fn exit_valid(self: &mut Exec, result: &encode_terms::Val, span: source::Span, how: &str, pg: &encode_spec::Prog) -> () {
            let at: usize = match pg.defs.find(self.enc.path.as_str()) {
                None => { return; },
                Some(found) => found,
            };
            if body::is_spec(pg.defs.items[at].d.kind) || body::is_proof(pg.defs.items[at].d.kind) {
                return;
            }
            let ret: ast::TypeKind = self.ret_ty(pg);
            self.oblige_valid(span, types::cat2("the result ", how).as_str(), "result", result, &ret, pg);
            for i in 0..pg.defs.items[at].d.params.len()
                invariant 0 <= i && i <= pg.defs.items[at].d.params.len(),
            {
                if mut_ref(&pg.defs.items[at].d.params[i].ty.kind) {
                    let name: String = pg.defs.items[at].d.params[i].name.name.clone();
                    match self.vars.find(name.as_str()) {
                        None => {},
                        Some(vi) => { let v: encode_terms::Val = self.vars.items[vi].clone(); let ty: ast::TypeKind = self.enc.local_ty(name.as_str(), pg); self.oblige_valid(span, types::cat4("`*", name.as_str(), "` (a `&mut` parameter) ", how).as_str(), types::cat2("*", name.as_str()).as_str(), &v, &ty, pg); },
                    }
                }
            }
        }

        #[summary("The free variables of block b of a `by (bit_vector)` assertion (stage0 Enc::free_block)")]
        #[effects(alloc)]
        fn free_block(self: &Exec, b: &ast::Block, bound: &mut Vec<String>, out: &mut table::Table<encode_sub::Sort>, pg: &encode_spec::Prog, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let n: usize = bound.len();
            for i in 0..b.stmts.len()
                invariant 0 <= i && i <= b.stmts.len(),
            {
                match &b.stmts[i] {
                    ast::Stmt::Let(sl) => { self.free_scalars(&sl.init, bound, out, pg, f - 1); bound.push(sl.name.name.clone()); },
                    ast::Stmt::Assign(_) => {},
                    ast::Stmt::While(_) => {},
                    ast::Stmt::For(_) => {},
                    ast::Stmt::Assert(_) => {},
                    ast::Stmt::Assume(_) => {},
                    ast::Stmt::Proof(_) => {},
                    ast::Stmt::LetFields(_) => {},
                    ast::Stmt::Expr(_) => {},
                }
            }
            match &b.tail {
                None => {},
                Some(t) => self.free_scalars(&**t, bound, out, pg, f - 1),
            }
            bound.truncate(n);
        }

        #[summary("The free variables of a `by (bit_vector)` assertion (integers, f64s and bools, E0515) with their sorts (stage0 Enc::free_scalars); bound are the `let`s around")]
        #[effects(alloc)]
        fn free_scalars(self: &Exec, e: &ast::Expr, bound: &mut Vec<String>, out: &mut table::Table<encode_sub::Sort>, pg: &encode_spec::Prog, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            match &e.kind {
                ast::ExprKind::Int(_, _) => {},
                ast::ExprKind::Float(_) => {},
                ast::ExprKind::ByteLit(_) => {},
                ast::ExprKind::ByteStr(_) => {},
                ast::ExprKind::StrLit(_) => {},
                ast::ExprKind::CharLit(_) => {},
                ast::ExprKind::Bool(_) => {},
                ast::ExprKind::Unit => {},
                ast::ExprKind::Var(id) => { if !types::has(bound.as_slice(), id.name.as_str()) { let sort: encode_sub::Sort = match encode_sub::sort_of(&self.enc.ty(e, pg)) { None => encode_sub::Sort::Bool, Some(s) => s, }; out.insert(id.name.as_str(), sort); } },
                ast::ExprKind::Call(c) => { for i in 0..c.args.len() invariant 0 <= i && i <= c.args.len(), { self.free_scalars(&c.args[i], bound, out, pg, f - 1); } },
                ast::ExprKind::Method(m) => { self.free_scalars(&*m.recv, bound, out, pg, f - 1); for i in 0..m.args.len() invariant 0 <= i && i <= m.args.len(), { self.free_scalars(&m.args[i], bound, out, pg, f - 1); } },
                ast::ExprKind::Index(_, _) => {},
                ast::ExprKind::Unary(_, x) => self.free_scalars(&**x, bound, out, pg, f - 1),
                ast::ExprKind::Binary(_, a, b) => { self.free_scalars(&**a, bound, out, pg, f - 1); self.free_scalars(&**b, bound, out, pg, f - 1); },
                ast::ExprKind::Ref(_, _) => {},
                ast::ExprKind::If(ie) => { self.free_scalars(&*ie.cond, bound, out, pg, f - 1); self.free_block(&ie.then, bound, out, pg, f - 1); match &ie.els { None => {}, Some(el) => self.free_scalars(&**el, bound, out, pg, f - 1), } },
                ast::ExprKind::Block(blk) => self.free_block(blk, bound, out, pg, f - 1),
                ast::ExprKind::Array(_) => {},
                ast::ExprKind::Repeat(_) => {},
                ast::ExprKind::Old(_) => {},
                ast::ExprKind::Quant(_) => {},
                ast::ExprKind::Trigger(_) => {},
                ast::ExprKind::Closure(_) => {},
                ast::ExprKind::StructLit(_) => {},
                ast::ExprKind::Path(_) => {},
                ast::ExprKind::Deref(_) => {},
                ast::ExprKind::Field(_, _) => {},
                ast::ExprKind::Match(_) => {},
                ast::ExprKind::Return(_) => {},
                ast::ExprKind::Try(_) => {},
                ast::ExprKind::Loop(_) => {},
                ast::ExprKind::Break(_) => {},
                ast::ExprKind::Continue(_) => {},
                ast::ExprKind::Range(_) => {},
                ast::ExprKind::Error => {},
            }
        }

        #[summary("Ghost code (stage0 Enc::ghost_expr, ADR-0062 §2): `if` and `match` branch on specifications (the facts proved on a side hold under its condition), a block runs its statements, a call of a proof fn proves its preconditions and assumes its ensures, and any other expression is a specification with no effect")]
        #[effects(alloc)]
        fn ghost_expr(self: &mut Exec, e: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let unit: ast::TypeKind = ast::TypeKind::Unit;
            match &e.kind {
                ast::ExprKind::Int(gxe_int0, gxe_int1) => {},
                ast::ExprKind::Float(gxe_float0) => {},
                ast::ExprKind::ByteLit(gxe_bytelit0) => {},
                ast::ExprKind::ByteStr(gxe_bytestr0) => {},
                ast::ExprKind::StrLit(gxe_strlit0) => {},
                ast::ExprKind::CharLit(gxe_charlit0) => {},
                ast::ExprKind::Bool(gxe_bool0) => {},
                ast::ExprKind::Unit => {},
                ast::ExprKind::Var(gxe_var0) => {},
                ast::ExprKind::Call(c) => { let target: String = encode_decls::resolve_in(&pg.pr.t, c.path.as_slice(), self.enc.unit.as_str()); let lemma: bool = match pg.pr.t.fns.find(target.as_str()) { None => false, Some(sg) => body::is_proof(pg.pr.t.fns.items[sg].kind), }; if lemma { self.call(c.path.as_slice(), c.args.as_slice(), e.span, pg, f - 1); } },
                ast::ExprKind::Method(gxe_method0) => {},
                ast::ExprKind::Index(gxe_index0, gxe_index1) => {},
                ast::ExprKind::Unary(gxe_unary0, gxe_unary1) => {},
                ast::ExprKind::Binary(gxe_binary0, gxe_binary1, gxe_binary2) => {},
                ast::ExprKind::Ref(gxe_ref0, gxe_ref1) => {},
                ast::ExprKind::If(x) => { let env: table::Table<encode_terms::Val> = self.vars.clone(); let was: table::Table<encode_terms::Val> = self.was.clone(); let c0: String = encode_terms::scalar_of(&self.enc.spec_expr(&*x.cond, &env, &was, pg, 100000)); let b: Branch = self.branch_start(c0.as_str()); let tv: encode_terms::Val = self.block(&x.then, pg, f - 1); let first: Side = self.branch_else(&b); let ev: encode_terms::Val = match &x.els { None => encode_terms::Val::Unit, Some(el) => self.eval(&**el, pg, f - 1), }; self.branch_join(&b, &first, tv, ev, &unit, pg); },
                ast::ExprKind::Block(gb) => { self.block(gb, pg, f - 1); },
                ast::ExprKind::Array(gxe_array0) => {},
                ast::ExprKind::Repeat(gxe_repeat0) => {},
                ast::ExprKind::Old(gxe_old0) => {},
                ast::ExprKind::Quant(gxe_quant0) => {},
                ast::ExprKind::Trigger(gxe_trigger0) => {},
                ast::ExprKind::Closure(gxe_closure0) => {},
                ast::ExprKind::StructLit(gxe_structlit0) => {},
                ast::ExprKind::Path(gxe_path0) => {},
                ast::ExprKind::Deref(gxe_deref0) => {},
                ast::ExprKind::Field(gxe_field0, gxe_field1) => {},
                ast::ExprKind::Match(mx) => { let menv: table::Table<encode_terms::Val> = self.vars.clone(); let mwas: table::Table<encode_terms::Val> = self.was.clone(); let sv: String = encode_terms::scalar_of(&self.enc.spec_expr(&*mx.scrut, &menv, &mwas, pg, 100000)); let st: ast::TypeKind = lowered::value_ty(&self.enc.ty(&*mx.scrut, pg)); let back: Option<ast::Expr> = None; self.match_arms(sv.as_str(), &st, mx.arms.as_slice(), 0, &unit, &back, pg, f - 1); },
                ast::ExprKind::Return(gxe_return0) => {},
                ast::ExprKind::Try(gxe_try0) => {},
                ast::ExprKind::Loop(gxe_loop0) => {},
                ast::ExprKind::Break(gxe_break0) => {},
                ast::ExprKind::Continue(gxe_continue0) => {},
                ast::ExprKind::Range(gxe_range0) => {},
                ast::ExprKind::Error => {},
            }
        }

        #[summary("A fresh value for local v, whose value before the loop is cur (the havoc of stage0 Enc::loop_core): any value of its type; of an array the elements may change, and the length only of a Vec or a String (loop_len: keeping it made the code after a push loop unreachable)")]
        #[effects(alloc)]
        fn havoc(self: &mut Exec, v: &str, cur: &encode_terms::Val, pg: &encode_spec::Prog) -> encode_terms::Val {
            let ty: ast::TypeKind = self.enc.local_ty(v, pg);
            let e: ast::TypeKind = encode_decls::elem_ty(&ty);
            let grows: bool = self.is_vec_local(v, pg);
            match cur {
                encode_terms::Val::S(hvv_s0) => self.enc.fresh_val(v, &ty, pg, 100000),
                encode_terms::Val::A(hv_elems, len) => { let elems: String = self.enc.fresh_elems(v, &e, false); let nl: String = self.new_len(v, len.as_str(), &e, grows); encode_terms::Val::A(elems, nl) },
                encode_terms::Val::Unit => encode_terms::Val::Unit,
                encode_terms::Val::Struct(hvv_struct0) => self.enc.fresh_val(v, &ty, pg, 100000),
                encode_terms::Val::Arr(hv_elem, alen) => { let elem: encode_terms::Val = self.enc.fresh_struct_elems(v, &e, pg); let al: String = self.new_len(v, alen.as_str(), &e, grows); encode_terms::Val::Arr(Box::new(elem), al) },
            }
        }

        #[summary("The keys of vars in the order they were first bound (stage0 Enc::in_binding_order, ADR-0063 §2), so that a renamed local leaves the query text the same. A name never bound through bind_var comes last, in key order")]
        #[effects(alloc)]
        fn in_binding_order(self: &Exec, vars: &table::Table<encode_terms::Val>) -> Vec<String> {
            let mut slots: Vec<String> = Vec::new();
            let mut used: Vec<bool> = Vec::new();
            let ranks: usize = self.var_rank.len();
            for i in 0..ranks
                invariant 0 <= i && i <= ranks,
            {
                slots.push(String::new());
                used.push(false);
            }
            let mut rest: Vec<String> = Vec::new();
            for n in 0..vars.len()
                invariant 0 <= n,
            {
                let k: String = vars.key(n);
                let r: usize = match self.var_rank.find(k.as_str()) {
                    None => slots.len(),
                    Some(at) => self.var_rank.items[at],
                };
                if r < slots.len() && r < used.len() {
                    slots[r] = k;
                    used[r] = true;
                } else {
                    rest.push(k);
                }
            }
            let mut out: Vec<String> = Vec::new();
            for i in 0..slots.len()
                invariant 0 <= i && i <= slots.len(),
            {
                if i < used.len() && used[i] {
                    out.push(slots[i].clone());
                }
            }
            extend(&mut out, rest.as_slice());
            out
        }

        #[summary("The invariant atom of v of type t, if t has one (stage0 Enc::inv_app): the predicate, an instance for a generic type, applied to the leaves of v")]
        #[effects(alloc)]
        fn inv_app(self: &Exec, v: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog) -> Vec<String> {
            let mut out: Vec<String> = Vec::new();
            match inv_target(t, &pg.pr.t) {
                None => {},
                Some(target) => { let mut flat: Vec<String> = Vec::new(); encode_terms::flatten(v, &mut flat, 100000); let fnm: String = encode_decls::sym(target.as_str()); if flat.len() == 0 { out.push(fnm); } else { out.push(types::cat5("(", fnm.as_str(), " ", encode_terms::join(flat.as_slice(), " ").as_str(), ")")); } },
            }
            out
        }

        #[summary("Whether name is a &mut parameter of this state's definition")]
        #[effects(pure)]
        fn is_mut_param(self: &Exec, name: &str, pg: &encode_spec::Prog) -> bool {
            match pg.defs.find(self.enc.path.as_str()) {
                None => false,
                Some(d) => { for i in 0..pg.defs.items[d].d.params.len() invariant 0 <= i && i <= pg.defs.items[d].d.params.len(), { if pg.defs.items[d].d.params[i].name.name.as_str() == name && mut_ref(&pg.defs.items[d].d.params[i].ty.kind) { return true; } } false },
            }
        }

        #[summary("Whether local or parameter name is a Vec or a String, or a reference to one (stage0 Enc::is_vec_local): the encoder's tables show them as slices, the program text does not")]
        #[effects(alloc)]
        fn is_vec_local(self: &Exec, name: &str, pg: &encode_spec::Prog) -> bool {
            match pg.defs.find(self.enc.path.as_str()) {
                None => false,
                Some(d) => { for i in 0..pg.defs.items[d].d.params.len() invariant 0 <= i && i <= pg.defs.items[d].d.params.len(), { if pg.defs.items[d].d.params[i].name.name.as_str() == name { return surface(&pg.defs.items[d].d.params[i].ty.kind, 100000); } } match encode_spec::find_let(&pg.defs.items[d].d.body, name, 100000) { None => false, Some(t) => surface(&t, 100000), } },
            }
        }

        #[summary("The loop a `break` or `continue` leaves (stage0 Enc::jump_target): the innermost one of that label, or the innermost")]
        #[effects(pure)]
        fn jump_target(self: &Exec, label: &Option<ast::Ident>) -> usize {
            let n: usize = self.loops.len();
            match label {
                None => {},
                Some(l) => { let mut found: usize = n; for i in 0..n invariant 0 <= i && i <= n, { let same: bool = match &self.loops[i].label { None => false, Some(name) => name.as_str() == l.name.as_str(), }; if same { found = i; } } if found < n { return found; } },
            }
            if n > 0 {
                n - 1
            } else {
                0
            }
        }

        #[summary("A `while` (with cond), a range `for` (with step) or a `loop` (with neither), stage0 Enc::loop_core (ADR-0049 §2, §3): the invariants hold on entry; everything the loop may change is havocked and the invariants assumed; one arbitrary iteration runs under the condition and comes back to the head; the state after the loop is the head with the condition false or the state at a `break`. Its value is that of the breaks that leave a `loop`")]
        #[effects(alloc)]
        fn loop_core(self: &mut Exec, label: &Option<ast::Ident>, cond: &Option<ast::Expr>, invariants: &[ast::Expr], dec: &Option<ast::Expr>, body: &ast::Block, step: &Option<ForStep>, span: source::Span, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            self.loop_entry(invariants, step, pg);
            let modified: Vec<String> = self.loop_modified(cond, body, step, pg);
            let valid_vars: Vec<Typed> = self.loop_havoc(modified.as_slice(), span, pg);
            self.loop_head(invariants, step, pg);
            let c: String = match cond {
                None => { match step { None => String::from("true"), Some(st) => { let op: ast::BinOp = if st.inclusive { ast::BinOp::Le } else { ast::BinOp::Lt }; encode_terms::ord_term(op, &st.ty, encode_terms::scalar_of(&var_of(&self.vars, st.var.as_str())).as_str(), st.hi.as_str()) }, } },
                Some(ce) => encode_terms::scalar_of(&self.eval(ce, pg, f - 1)),
            };
            let after: table::Table<encode_terms::Val> = self.vars.clone();
            let n: usize = self.enc.pc.len();
            self.enc.pc.push(c.clone());
            let measure: Option<String> = match step {
                None => { match dec { None => None, Some(d) => { let env: table::Table<encode_terms::Val> = self.vars.clone(); let was: table::Table<encode_terms::Val> = self.was.clone(); Some(encode_terms::scalar_of(&self.enc.spec_expr(d, &env, &was, pg, 100000))) }, } },
                Some(ms) => Some(types::cat5("(- ", ms.hi.as_str(), " ", encode_terms::scalar_of(&var_of(&self.vars, ms.var.as_str())).as_str(), ")")),
            };
            let name: Option<String> = match label {
                None => None,
                Some(l) => Some(l.name.clone()),
            };
            self.loops.push(VLoop { label: name, start: n, invariants: copy_exprs(invariants), dec: dec.clone(), measure: measure, breaks: Vec::new(), step: step.clone(), span: span, valid_vars: valid_vars });
            self.block(body, pg, f - 1);
            if !self.dead && self.loops.len() > 0 {
                let k: usize = self.loops.len() - 1;
                self.end_iteration(k, pg);
            }
            self.dead = false;
            let lp: VLoop = match self.loops.pop() {
                None => { return encode_terms::Val::Unit; },
                Some(top) => top,
            };
            self.enc.pc.truncate(n);
            self.loop_exit(&lp, c.as_str(), &after, cond, pg)
        }

        #[summary("The obligations on entry to a loop (the start of stage0 Enc::loop_core, E0806): a `for`'s bounds at its first value, then each invariant")]
        #[effects(alloc)]
        fn loop_entry(self: &mut Exec, invariants: &[ast::Expr], step: &Option<ForStep>, pg: &encode_spec::Prog) -> () {
            match step {
                None => {},
                Some(st) => { let g: String = for_bounds(st, st.lo.as_str()); self.oblige("E0806", st.span, "loop invariant may not hold on entry", g.as_str()); },
            }
            for i in 0..invariants.len()
                invariant 0 <= i && i <= invariants.len(),
            {
                let env: table::Table<encode_terms::Val> = self.vars.clone();
                let was: table::Table<encode_terms::Val> = self.was.clone();
                let ig: String = encode_terms::scalar_of(&self.enc.spec_expr(&invariants[i], &env, &was, pg, 100000));
                self.oblige("E0806", invariants[i].span, "loop invariant may not hold on entry", ig.as_str());
            }
        }

        #[summary("The state after loop lp, which has run and whose condition at the head was c (the end of stage0 Enc::loop_core). The exit is the head with the condition false (a `while` or a `for`), or the state at a `break`: the conditions are exclusive, a `break` runs in an iteration, under the condition. A `loop` without a `break` does not finish. Each local of after, the state at the head, is merged with its value at each break, in the order they were first bound; the exits are reach points; the value is the breaks'")]
        #[effects(alloc)]
        fn loop_exit(self: &mut Exec, lp: &VLoop, c: &str, after: &table::Table<encode_terms::Val>, cond: &Option<ast::Expr>, pg: &encode_spec::Prog) -> encode_terms::Val {
            let has_cond: bool = match cond {
                None => false,
                Some(lx_c) => true,
            };
            let has_step: bool = match &lp.step {
                None => false,
                Some(lx_s) => true,
            };
            let exits: bool = has_cond || has_step;
            let nb: usize = lp.breaks.len();
            let mut conds: Vec<String> = Vec::new();
            for i in 0..nb
                invariant 0 <= i && i <= nb,
            {
                conds.push(encode_terms::and(lp.breaks[i].pc.as_slice()));
            }
            let mut alts: Vec<String> = Vec::new();
            if exits {
                alts.push(types::cat3("(not ", c, ")"));
            }
            extend(&mut alts, conds.as_slice());
            if alts.len() == 0 {
                self.vars = after.clone();
                self.dead = true;
                return encode_terms::Val::Unit;
            }
            if alts.len() == 1 {
                self.enc.pc.push(alts[0].clone());
            } else {
                self.enc.pc.push(types::cat3("(or ", encode_terms::join(alts.as_slice(), " ").as_str(), ")"));
            }
            let names: Vec<String> = self.in_binding_order(after);
            let merges: usize = if exits {
                nb
            } else if nb > 0 {
                nb - 1
            } else {
                0
            };
            let mut vars: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
            for x in 0..names.len()
                invariant 0 <= x && x <= names.len(),
            {
                let mut v: encode_terms::Val = if exits || nb == 0 {
                    var_of(after, names[x].as_str())
                } else {
                    var_of(&lp.breaks[nb - 1].vars, names[x].as_str())
                };
                for j in 0..merges
                    invariant 0 <= j && j <= merges,
                {
                    let i: usize = merges - 1 - j;
                    if i < nb && i < conds.len() {
                        let bv: encode_terms::Val = var_of(&lp.breaks[i].vars, names[x].as_str());
                        if !same_val(&bv, &v, 100000) {
                            let t: ast::TypeKind = self.enc.local_ty(names[x].as_str(), pg);
                            v = self.merge(conds[i].as_str(), &bv, &v, &t, pg, 100000);
                        }
                    }
                }
                vars.insert(names[x].as_str(), v);
            }
            self.vars = vars;
            match cond {
                None => {},
                Some(ce) => self.mark_reach(ce.span, "exit of the loop"),
            }
            match &lp.step {
                None => {},
                Some(st) => self.mark_reach(st.span, "exit of the loop"),
            }
            if nb == 0 {
                return encode_terms::Val::Unit;
            }
            let mut out: encode_terms::Val = lp.breaks[nb - 1].v.clone();
            for j in 0..nb - 1
                invariant 0 <= j && j <= nb - 1,
            {
                let i: usize = nb - 2 - j;
                if i < conds.len() {
                    out = encode_terms::ite_val(conds[i].as_str(), &lp.breaks[i].v, &out, 100000);
                }
            }
            out
        }

        #[summary("Havocs the locals modified, a loop's (the middle of stage0 Enc::loop_core): those that have a validity are valid on entry (E0823, ADR-0060 §2), each bound one gets a fresh value in the order they were first bound, and the fresh values are assumed valid. The locals with a validity and their types, which the loop keeps for the way back to its head")]
        #[effects(alloc)]
        fn loop_havoc(self: &mut Exec, modified: &[String], span: source::Span, pg: &encode_spec::Prog) -> Vec<Typed> {
            let valid_vars: Vec<Typed> = self.loop_valid_vars(modified, pg);
            for i in 0..valid_vars.len()
                invariant 0 <= i && i <= valid_vars.len(),
            {
                let cur: encode_terms::Val = var_of(&self.vars, valid_vars[i].name.as_str());
                self.oblige_valid(span, types::cat3("`", valid_vars[i].name.as_str(), "` on entry to the loop").as_str(), types::cat2(valid_vars[i].name.as_str(), " on entry").as_str(), &cur, &valid_vars[i].ty, pg);
            }
            let ordered: Vec<String> = self.rank_order(modified);
            for i in 0..ordered.len()
                invariant 0 <= i && i <= ordered.len(),
            {
                match self.vars.find(ordered[i].as_str()) {
                    None => {},
                    Some(at) => { let before: encode_terms::Val = self.vars.items[at].clone(); let any: encode_terms::Val = self.havoc(ordered[i].as_str(), &before, pg); self.bind_var(ordered[i].as_str(), any); },
                }
            }
            for i in 0..valid_vars.len()
                invariant 0 <= i && i <= valid_vars.len(),
            {
                let now: encode_terms::Val = var_of(&self.vars, valid_vars[i].name.as_str());
                self.assume_valid(&now, &valid_vars[i].ty, pg);
            }
            valid_vars
        }

        #[summary("What holds at the head of a loop (stage0 Enc::loop_core after the havoc): a `for`'s bounds at its variable, then each invariant. Earlier facts mention only earlier constants, so they stay valid")]
        #[effects(alloc)]
        fn loop_head(self: &mut Exec, invariants: &[ast::Expr], step: &Option<ForStep>, pg: &encode_spec::Prog) -> () {
            match step {
                None => {},
                Some(st) => { let at: String = encode_terms::scalar_of(&var_of(&self.vars, st.var.as_str())); self.enc.pc.push(for_bounds(st, at.as_str())); },
            }
            for i in 0..invariants.len()
                invariant 0 <= i && i <= invariants.len(),
            {
                let env: table::Table<encode_terms::Val> = self.vars.clone();
                let was: table::Table<encode_terms::Val> = self.was.clone();
                let ig: String = encode_terms::scalar_of(&self.enc.spec_expr(&invariants[i], &env, &was, pg, 100000));
                self.enc.pc.push(ig);
            }
        }

        #[summary("The locals a loop may change, sorted (the modified set of stage0 Enc::loop_core): what its body and its condition assign (assigned_in_block, assigned_in_expr) and a `for`'s variable. A name passed on to a callee or matched on (marked `?`) counts only when it is a &mut parameter of the definition")]
        #[effects(alloc)]
        fn loop_modified(self: &Exec, cond: &Option<ast::Expr>, body: &ast::Block, step: &Option<ForStep>, pg: &encode_spec::Prog) -> Vec<String> {
            let mut marked: table::Table<bool> = table::new::<bool>();
            assigned_in_block(body, &mut marked, 100000);
            match cond {
                None => {},
                Some(ce) => assigned_in_expr(ce, &mut marked, 100000),
            }
            match step {
                None => {},
                Some(st) => marked.insert(st.var.as_str(), true),
            }
            let mut names: table::Table<bool> = table::new::<bool>();
            for n in 0..marked.len()
                invariant 0 <= n,
            {
                let k: String = marked.key(n);
                if moves::starts_with(k.as_str(), "?") {
                    let name: String = lexer::cut(k.as_str(), 1, k.len());
                    if self.is_mut_param(name.as_str(), pg) {
                        names.insert(name.as_str(), true);
                    }
                } else {
                    names.insert(k.as_str(), true);
                }
            }
            let mut out: Vec<String> = Vec::new();
            for n in 0..names.len()
                invariant 0 <= n,
            {
                out.push(names.key(n));
            }
            out
        }

        #[summary("The locals a loop havocs that have a validity, with their types (stage0 Enc::loop_valid_vars), in the order they were first bound (ADR-0063 §2). None in ghost code")]
        #[effects(alloc)]
        fn loop_valid_vars(self: &mut Exec, modified: &[String], pg: &encode_spec::Prog) -> Vec<Typed> {
            let mut out: Vec<Typed> = Vec::new();
            if self.ghost {
                return out;
            }
            let ordered: Vec<String> = self.rank_order(modified);
            for i in 0..ordered.len()
                invariant 0 <= i && i <= ordered.len(),
            {
                if self.vars.has(ordered[i].as_str()) {
                    let t: ast::TypeKind = self.enc.local_ty(ordered[i].as_str(), pg);
                    if self.needs_valid(&t, pg) {
                        out.push(Typed { name: ordered[i].clone(), ty: t.clone() });
                    }
                }
            }
            out
        }

        #[summary("Records the path condition here as a reach point when the pass asks for them (stage0 Enc::mark_reach, under vacuous_ends)")]
        #[effects(alloc)]
        fn mark_reach(self: &mut Exec, span: source::Span, what: &str) -> () {
            if self.reaching {
                let mut pc: Vec<String> = self.enc.pc.clone();
                extend(&mut pc, self.enc.spec_pc.as_slice());
                self.reach.push(Reach { span: span, what: String::from(what), pc: pc });
            }
        }

        #[summary("Arms i.. of an executable `match` on sv of type st (stage0 Enc::match_arms): each arm runs under its tester, the last one under the others' negations (arms are exhaustive), with its bindings and their range facts")]
        #[effects(alloc)]
        fn match_arms(self: &mut Exec, sv: &str, st: &ast::TypeKind, arms: &[ast::Arm], i: usize, t: &ast::TypeKind, back: &Option<ast::Expr>, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            if i >= arms.len() {
                return encode_terms::Val::Unit;
            }
            let v: String = last_name(arms[i].pat.path.as_slice());
            if i + 1 == arms.len() {
                return self.run_arm(sv, st, &arms[i], v.as_str(), back, pg, f - 1);
            }
            let b: Branch = self.branch_start(types::cat5("((_ is ", encode_decls::ctor(st, v.as_str()).as_str(), ") ", sv, ")").as_str());
            let tv: encode_terms::Val = self.run_arm(sv, st, &arms[i], v.as_str(), back, pg, f - 1);
            let first: Side = self.branch_else(&b);
            let ev: encode_terms::Val = self.match_arms(sv, st, arms, i + 1, t, back, pg, f - 1);
            self.branch_join(&b, &first, tv, ev, t, pg)
        }

        #[summary("std::mem::replace(&mut p, v), the old value of p, which now holds v; std::mem::swap(&mut a, &mut b) exchanges the values of two places (stage0 Enc::mem_call, ADR-0047 §2). Both values are read before either place is written")]
        #[effects(alloc)]
        fn mem_call(self: &mut Exec, replace: bool, args: &[ast::Expr], pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            if args.len() < 2 {
                return encode_terms::Val::Unit;
            }
            let p0: ast::Expr = match body::ref_of(&args[0]) {
                None => args[0].clone(),
                Some(x0) => x0,
            };
            let p1: ast::Expr = match body::ref_of(&args[1]) {
                None => args[1].clone(),
                Some(x1) => x1,
            };
            let was: encode_terms::Val = self.eval(&p0, pg, f - 1);
            let new: encode_terms::Val = if replace {
                self.eval(&args[1], pg, f - 1)
            } else {
                self.eval(&p1, pg, f - 1)
            };
            self.write_place(&p0, &new, true, pg, f - 1);
            if replace {
                return was;
            }
            self.write_place(&p1, &was, true, pg, f - 1);
            encode_terms::Val::Unit
        }

        #[summary("ite(c, a, b) of two values of type t (stage0 Enc::merge). A scalar or element term above 24 atoms is bound to a fresh constant, so that later merges refer to it instead of copying it: copying doubles the term at every sequential `if`. The size is in atoms, not characters, so a renamed local binds the same merges (ADR-0063 §2). The error type for t says the two are the same or have no sort")]
        #[effects(alloc)]
        fn merge(self: &mut Exec, c: &str, a: &encode_terms::Val, b: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return a.clone();
            }
            match a {
                encode_terms::Val::S(x) => match b { encode_terms::Val::S(y) => { let term: String = encode_terms::ite(c, x.as_str(), y.as_str()); if size(term.as_str()) > 24 && !types::is_error(t) && !decls::is_unit(t) && !encode_decls::is_array(t) { let v: String = encode_terms::fresh(&mut self.enc.fr, "merge", encode_decls::sort_of(t).as_str()); self.enc.pc.push(types::cat5("(= ", v.as_str(), " ", term.as_str(), ")")); encode_terms::Val::S(v) } else { encode_terms::Val::S(term) } }, encode_terms::Val::A(mbv_a0, mbv_a1) => a.clone(), encode_terms::Val::Unit => a.clone(), encode_terms::Val::Struct(mbv_struct0) => a.clone(), encode_terms::Val::Arr(mbv_arr0, mbv_arr1) => a.clone(), },
                encode_terms::Val::A(e1, l1) => match b { encode_terms::Val::S(mcv_s0) => a.clone(), encode_terms::Val::A(e2, l2) => { let mut elems: String = encode_terms::ite(c, e1.as_str(), e2.as_str()); if size(elems.as_str()) > 24 && encode_decls::is_array(t) { let av: String = encode_terms::fresh(&mut self.enc.fr, "merge", types::cat3("(Array Int ", encode_decls::sort_of(&encode_decls::elem_ty(t)).as_str(), ")").as_str()); self.enc.pc.push(types::cat5("(= ", av.as_str(), " ", elems.as_str(), ")")); elems = av; } encode_terms::Val::A(elems, encode_terms::ite(c, l1.as_str(), l2.as_str())) }, encode_terms::Val::Unit => a.clone(), encode_terms::Val::Struct(mcv_struct0) => a.clone(), encode_terms::Val::Arr(mcv_arr0, mcv_arr1) => a.clone(), },
                encode_terms::Val::Unit => a.clone(),
                encode_terms::Val::Struct(xs) => match b { encode_terms::Val::S(mdv_s0) => a.clone(), encode_terms::Val::A(mdv_a0, mdv_a1) => a.clone(), encode_terms::Val::Unit => a.clone(), encode_terms::Val::Struct(ys) => { let fs: Option<Vec<types::FieldSig>> = encode_decls::flat_fields(t, &pg.pr.t); let mut out: Vec<encode_terms::Val> = Vec::new(); for k in 0..xs.len() invariant 0 <= k && k <= xs.len(), { if k < ys.len() { let ft: ast::TypeKind = match &fs { None => ast::TypeKind::Error, Some(fl) => { if k < fl.len() && !same_val(&xs[k], &ys[k], 100000) { fl[k].ty.clone() } else { ast::TypeKind::Error } }, }; let known: bool = match &fs { None => true, Some(fl2) => k < fl2.len(), }; if known { out.push(self.merge(c, &xs[k], &ys[k], &ft, pg, f - 1)); } } } encode_terms::Val::Struct(out) }, encode_terms::Val::Arr(mdv_arr0, mdv_arr1) => a.clone(), },
                encode_terms::Val::Arr(xe, xl) => match b { encode_terms::Val::S(mev_s0) => a.clone(), encode_terms::Val::A(mev_a0, mev_a1) => a.clone(), encode_terms::Val::Unit => a.clone(), encode_terms::Val::Struct(mev_struct0) => a.clone(), encode_terms::Val::Arr(ye, yl) => encode_terms::ite_val(c, a, b, 100000), },
            }
        }

        #[summary("Whether a value of t has a validity other than `true` (stage0 Prog::needs_valid): some type it holds, itself included, has an invariant or is a type parameter. Remembered by the type's text")]
        #[effects(alloc)]
        fn needs_valid(self: &mut Exec, t: &ast::TypeKind, pg: &encode_spec::Prog) -> bool {
            let key: String = types::text(t);
            match self.valid_memo.find(key.as_str()) {
                None => {},
                Some(at) => { return self.valid_memo.items[at]; },
            }
            let mut seen: table::Table<bool> = table::new::<bool>();
            let mut todo: Vec<ast::TypeKind> = Vec::new();
            todo.push(t.clone());
            let mut found: bool = false;
            let mut fuel: usize = 1000000000;
            while todo.len() > 0 && fuel > 0 && !found
                decreases fuel,
            {
                fuel = fuel - 1;
                match todo.pop() {
                    None => {},
                    Some(u) => { let has_inv: bool = match inv_target(&u, &pg.pr.t) { None => false, Some(iv) => true, }; if encode_decls::shape(&u) == 8 || has_inv { found = true; } else { let k: String = types::text(&u); if !seen.has(k.as_str()) { seen.insert(k.as_str(), true); let more: Vec<ast::TypeKind> = encode_decls::holds(&u, &pg.pr.t); body::push_all(&mut todo, more.as_slice()); } } },
                }
            }
            self.valid_memo.insert(key.as_str(), found);
            found
        }

        #[summary("The length after a callee that took the value by &mut (the new_len closure of stage0 Enc::behind_mut_after): the same length, or for a growable value a fresh one within the bounds of a length")]
        #[effects(alloc)]
        fn new_len(self: &mut Exec, base: &str, len: &str, e: &ast::TypeKind, grows: bool) -> String {
            if !grows {
                return String::from(len);
            }
            let l: String = encode_terms::fresh(&mut self.enc.fr, types::cat2(base, ".len").as_str(), "Int");
            self.enc.pc.push(types::cat7("(and (<= 0 ", l.as_str(), ") (<= ", l.as_str(), " ", encode_terms::len_max(e).as_str(), "))"));
            l
        }

        #[summary("The obligation that goal holds here (stage0 Enc::oblige)")]
        #[effects(alloc)]
        fn oblige(self: &mut Exec, code: &str, span: source::Span, msg: &str, goal: &str) -> () {
            let none: Option<String> = None;
            self.enc.oblige_given(code, span, msg, &none, goal);
        }

        #[summary("The obligation that v of type t is valid where it leaves the function at span (stage0 Enc::oblige_valid, E0823): what names the place in the message, shown the value in a counterexample. Ghost code owes nothing")]
        #[effects(alloc)]
        fn oblige_valid(self: &mut Exec, span: source::Span, what: &str, shown: &str, v: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog) -> () {
            if self.ghost {
                return;
            }
            let goals: Vec<String> = self.valid_goals(v, t, pg);
            if goals.len() == 0 {
                return;
            }
            self.push_valid(span, what, shown, v, t, goals.as_slice());
        }

        #[summary("oblige_valid for argument a of a call of callee (stage0 Boundary::Arg): the text of the argument is written only when there is an obligation")]
        #[effects(alloc)]
        fn oblige_valid_arg(self: &mut Exec, a: &ast::Expr, callee: &str, v: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog) -> () {
            if self.ghost {
                return;
            }
            let goals: Vec<String> = self.valid_goals(v, t, pg);
            if goals.len() == 0 {
                return;
            }
            self.push_valid(a.span, types::cat5("argument `", fmt::expr_text(a).as_str(), "` of `", callee, "`").as_str(), "argument", v, t, goals.as_slice());
        }

        #[summary("A bit-vector of the width of i standing for operand x of a bit operation in code (stage0 Enc::operand_bv): a literal, or a fresh constant whose value is stated (x is in range there, as every value of code is, and a shift amount is below the width by its obligation)")]
        #[effects(alloc)]
        fn operand_bv(self: &mut Exec, i: ast::IntTy, x: &str) -> String {
            let w: u32 = encode_terms::width(i);
            match encode_terms::numeral(x) {
                None => {},
                Some(v) => { return types::cat5("(_ bv", encode_terms::dec(low_bits(&v, w)).as_str(), " ", encode_terms::dec(w as u64).as_str(), ")"); },
            }
            let c: String = encode_terms::fresh(&mut self.enc.fr, "'bv", types::cat3("(_ BitVec ", encode_terms::dec(w as u64).as_str(), ")").as_str());
            self.enc.pc.push(types::cat5("(= (bv2nat ", c.as_str(), ") ", encode_terms::bv_value(i, x).as_str(), ")"));
            c
        }

        #[summary("The variable a place expression writes, and the steps from it to the place (stage0 Enc::place): fields, *p (the reference is its value) and array elements, whose index is checked against the length when check is set (E0805). Empty text for an expression that is no place, which the checker admits none of")]
        #[effects(alloc)]
        fn place(self: &mut Exec, e: &ast::Expr, steps: &mut Vec<encode_terms::Step>, check: bool, pg: &encode_spec::Prog, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            match &e.kind {
                ast::ExprKind::Int(ple_int0, ple_int1) => String::new(),
                ast::ExprKind::Float(ple_float0) => String::new(),
                ast::ExprKind::ByteLit(ple_bytelit0) => String::new(),
                ast::ExprKind::ByteStr(ple_bytestr0) => String::new(),
                ast::ExprKind::StrLit(ple_strlit0) => String::new(),
                ast::ExprKind::CharLit(ple_charlit0) => String::new(),
                ast::ExprKind::Bool(ple_bool0) => String::new(),
                ast::ExprKind::Unit => String::new(),
                ast::ExprKind::Var(id) => id.name.clone(),
                ast::ExprKind::Call(ple_call0) => String::new(),
                ast::ExprKind::Method(mc) => self.place(&*mc.recv, steps, check, pg, f - 1),
                ast::ExprKind::Index(ib, ii) => { let iroot: String = self.place(&**ib, steps, check, pg, f - 1); let len: String = encode_spec::len_of(&self.eval(&**ib, pg, f - 1)); let i: String = encode_terms::scalar_of(&self.eval(&**ii, pg, f - 1)); if check { self.oblige("E0805", e.span, "index may be out of bounds", types::cat7("(and (<= 0 ", i.as_str(), ") (< ", i.as_str(), " ", len.as_str(), "))").as_str()); } steps.push(encode_terms::Step::Index(i)); iroot },
                ast::ExprKind::Unary(ple_unary0, ple_unary1) => String::new(),
                ast::ExprKind::Binary(ple_binary0, ple_binary1, ple_binary2) => String::new(),
                ast::ExprKind::Ref(pl_m, rx) => self.place(&**rx, steps, check, pg, f - 1),
                ast::ExprKind::If(ple_if0) => String::new(),
                ast::ExprKind::Block(ple_block0) => String::new(),
                ast::ExprKind::Array(ple_array0) => String::new(),
                ast::ExprKind::Repeat(ple_repeat0) => String::new(),
                ast::ExprKind::Old(ple_old0) => String::new(),
                ast::ExprKind::Quant(ple_quant0) => String::new(),
                ast::ExprKind::Trigger(ple_trigger0) => String::new(),
                ast::ExprKind::Closure(ple_closure0) => String::new(),
                ast::ExprKind::StructLit(ple_structlit0) => String::new(),
                ast::ExprKind::Path(ple_path0) => String::new(),
                ast::ExprKind::Deref(dx) => self.place(&**dx, steps, check, pg, f - 1),
                ast::ExprKind::Field(fb, fname) => { let root: String = self.place(&**fb, steps, check, pg, f - 1); let bt: ast::TypeKind = self.place_ty(&**fb, pg, f - 1); let k: usize = encode_decls::field_index(&bt, &pg.pr.t, fname.name.as_str()); if encode_decls::dt_struct(&bt, &pg.pr.t) { steps.push(encode_terms::Step::DataField(k, lowered::value_ty(&bt))); } else { steps.push(encode_terms::Step::Field(k)); } root },
                ast::ExprKind::Match(ple_match0) => String::new(),
                ast::ExprKind::Return(ple_return0) => String::new(),
                ast::ExprKind::Try(ple_try0) => String::new(),
                ast::ExprKind::Loop(ple_loop0) => String::new(),
                ast::ExprKind::Break(ple_break0) => String::new(),
                ast::ExprKind::Continue(ple_continue0) => String::new(),
                ast::ExprKind::Range(ple_range0) => String::new(),
                ast::ExprKind::Error => String::new(),
            }
        }

        #[summary("The type of a place expression (stage0 Enc::place_ty): the checker does not record them")]
        #[effects(alloc)]
        fn place_ty(self: &Exec, e: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> ast::TypeKind
            decreases f,
        {
            if f == 0 {
                return ast::TypeKind::Error;
            }
            match &e.kind {
                ast::ExprKind::Int(pte_int0, pte_int1) => self.enc.ty(e, pg),
                ast::ExprKind::Float(pte_float0) => self.enc.ty(e, pg),
                ast::ExprKind::ByteLit(pte_bytelit0) => self.enc.ty(e, pg),
                ast::ExprKind::ByteStr(pte_bytestr0) => self.enc.ty(e, pg),
                ast::ExprKind::StrLit(pte_strlit0) => self.enc.ty(e, pg),
                ast::ExprKind::CharLit(pte_charlit0) => self.enc.ty(e, pg),
                ast::ExprKind::Bool(pte_bool0) => self.enc.ty(e, pg),
                ast::ExprKind::Unit => self.enc.ty(e, pg),
                ast::ExprKind::Var(id) => self.enc.local_ty(id.name.as_str(), pg),
                ast::ExprKind::Call(pte_call0) => self.enc.ty(e, pg),
                ast::ExprKind::Method(pte_method0) => self.enc.ty(e, pg),
                ast::ExprKind::Index(ib, ii) => encode_decls::elem_ty(&self.place_ty(&**ib, pg, f - 1)),
                ast::ExprKind::Unary(pte_unary0, pte_unary1) => self.enc.ty(e, pg),
                ast::ExprKind::Binary(pte_binary0, pte_binary1, pte_binary2) => self.enc.ty(e, pg),
                ast::ExprKind::Ref(pt_m, rx) => { let rt: ast::TypeKind = self.place_ty(&**rx, pg, f - 1); match body::ref_inner(&rt) { None => rt, Some(ri) => ri, } },
                ast::ExprKind::If(pte_if0) => self.enc.ty(e, pg),
                ast::ExprKind::Block(pte_block0) => self.enc.ty(e, pg),
                ast::ExprKind::Array(pte_array0) => self.enc.ty(e, pg),
                ast::ExprKind::Repeat(pte_repeat0) => self.enc.ty(e, pg),
                ast::ExprKind::Old(pte_old0) => self.enc.ty(e, pg),
                ast::ExprKind::Quant(pte_quant0) => self.enc.ty(e, pg),
                ast::ExprKind::Trigger(pte_trigger0) => self.enc.ty(e, pg),
                ast::ExprKind::Closure(pte_closure0) => self.enc.ty(e, pg),
                ast::ExprKind::StructLit(pte_structlit0) => self.enc.ty(e, pg),
                ast::ExprKind::Path(pte_path0) => self.enc.ty(e, pg),
                ast::ExprKind::Deref(dx) => { let dt: ast::TypeKind = self.place_ty(&**dx, pg, f - 1); match body::ref_inner(&dt) { None => dt, Some(di) => di, } },
                ast::ExprKind::Field(fb, fname) => { let bt: ast::TypeKind = self.place_ty(&**fb, pg, f - 1); let k: usize = encode_decls::field_index(&bt, &pg.pr.t, fname.name.as_str()); match lowered::struct_fields(&bt, &pg.pr.t) { None => ast::TypeKind::Error, Some(fs) => { if k < fs.len() { fs[k].ty.clone() } else { ast::TypeKind::Error } }, } },
                ast::ExprKind::Match(pte_match0) => self.enc.ty(e, pg),
                ast::ExprKind::Return(pte_return0) => self.enc.ty(e, pg),
                ast::ExprKind::Try(pte_try0) => self.enc.ty(e, pg),
                ast::ExprKind::Loop(pte_loop0) => self.enc.ty(e, pg),
                ast::ExprKind::Break(pte_break0) => self.enc.ty(e, pg),
                ast::ExprKind::Continue(pte_continue0) => self.enc.ty(e, pg),
                ast::ExprKind::Range(pte_range0) => self.enc.ty(e, pg),
                ast::ExprKind::Error => self.enc.ty(e, pg),
            }
        }

        #[summary("The postconditions of the function at a point where it returns result (stage0 Enc::post_check): the end of the body, or a `return` or `?` (ADR-0049 §3). Each ensures clause is an obligation (E0802), and what the function lets go is valid (ADR-0060 §2)")]
        #[effects(alloc)]
        fn post_check(self: &mut Exec, result: &encode_terms::Val, at: source::Span, how: &str, pg: &encode_spec::Prog) -> () {
            let d: usize = match pg.defs.find(self.enc.path.as_str()) {
                None => { return; },
                Some(found) => found,
            };
            let mut env: table::Table<encode_terms::Val> = self.vars.clone();
            let was: table::Table<encode_terms::Val> = self.was.clone();
            match &pg.defs.items[d].d.ret.name {
                None => {},
                Some(rn) => env.insert(rn.name.as_str(), result.clone()),
            }
            for i in 0..pg.defs.items[d].d.post.len()
                invariant 0 <= i && i <= pg.defs.items[d].d.post.len(),
            {
                let g: String = encode_terms::scalar_of(&self.enc.spec_expr(&pg.defs.items[d].d.post[i], &env, &was, pg, 100000));
                self.oblige("E0802", pg.defs.items[d].d.post[i].span, types::cat3("postcondition `", pred_name(&pg.defs.items[d].d.post[i]).as_str(), "` may not hold").as_str(), g.as_str());
            }
            self.exit_valid(result, at, how, pg);
        }

        #[summary("A `proof { .. }` block in code (stage0 Enc::proof_block): its statements are ghost code, the facts it proves hold from here on, and its `let`s end with it")]
        #[effects(alloc)]
        fn proof_block(self: &mut Exec, b: &ast::Block, pg: &encode_spec::Prog, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let before: table::Table<encode_terms::Val> = self.vars.clone();
            let ghost: bool = self.ghost;
            self.ghost = true;
            self.block(b, pg, f - 1);
            self.ghost = ghost;
            self.vars = retain(&self.vars, &before);
        }

        #[summary("The obligations of the proof fn d, this state's definition (stage0 Enc::proof_body, ADR-0062 §2): its body is ghost code, proved against its contract. Each parameter satisfies what every call proves of its argument (type_facts) and nothing more; the requires are assumed; the end of the body owes the postconditions")]
        #[effects(alloc)]
        fn proof_body(self: &mut Exec, d: &ast::FnDef, pg: &encode_spec::Prog) -> () {
            for i in 0..d.params.len()
                invariant 0 <= i && i <= d.params.len(),
            {
                let sh: encode_spec::Shown = self.enc.proof_param(d.params[i].name.name.as_str(), pg);
                let v: encode_terms::Val = sh.v.clone();
                self.inputs.push(sh);
                self.bind_var(d.params[i].name.name.as_str(), v);
            }
            let env: table::Table<encode_terms::Val> = self.vars.clone();
            let was: table::Table<encode_terms::Val> = self.was.clone();
            for i in 0..d.pre.len()
                invariant 0 <= i && i <= d.pre.len(),
            {
                let g: String = encode_terms::scalar_of(&self.enc.spec_expr(&d.pre[i], &env, &was, pg, 100000));
                self.enc.pc.push(g);
            }
            match &d.measure {
                None => {},
                Some(dec) => { let m: encode_spec::Measure = self.enc.measure(dec, &env, &was, pg, 100000); self.entry_measure = Some(m); },
            }
            self.ghost = true;
            self.block(&d.body, pg, 100000);
            self.ghost = false;
            self.mark_reach(d.name.span, "end of the body");
            self.post_check(&encode_terms::Val::Unit, d.name.span, "at the end of the body", pg);
        }

        #[summary("The obligation E0823 with goals, the conjuncts of the validity of v that the path does not hold yet (the end of stage0 Enc::oblige_valid); the counterexample shows v")]
        #[effects(alloc)]
        fn push_valid(self: &mut Exec, span: source::Span, what: &str, shown: &str, v: &encode_terms::Val, t: &ast::TypeKind, goals: &[String]) -> () {
            let ty: String = types::text(&lowered::value_ty(t));
            let n: usize = self.enc.obls.len();
            self.oblige("E0823", span, types::cat4("type invariant of `", ty.as_str(), "` may not hold for ", what).as_str(), encode_terms::and(goals).as_str());
            if n < self.enc.obls.len() {
                self.enc.obls[n].shown = Some(encode_spec::Shown { name: String::from(shown), v: v.clone(), ty: t.clone() });
            }
        }

        #[summary("names in the order they were first bound (stage0 Enc::in_binding_order of a set of names, ADR-0063 §2). A name never bound comes last, in the order given")]
        #[effects(alloc)]
        fn rank_order(self: &Exec, names: &[String]) -> Vec<String> {
            let mut slots: Vec<String> = Vec::new();
            let mut used: Vec<bool> = Vec::new();
            let ranks: usize = self.var_rank.len();
            for i in 0..ranks
                invariant 0 <= i && i <= ranks,
            {
                slots.push(String::new());
                used.push(false);
            }
            let mut rest: Vec<String> = Vec::new();
            for n in 0..names.len()
                invariant 0 <= n && n <= names.len(),
            {
                let r: usize = match self.var_rank.find(names[n].as_str()) {
                    None => slots.len(),
                    Some(at) => self.var_rank.items[at],
                };
                if r < slots.len() && r < used.len() {
                    slots[r] = names[n].clone();
                    used[r] = true;
                } else {
                    rest.push(names[n].clone());
                }
            }
            let mut out: Vec<String> = Vec::new();
            for i in 0..slots.len()
                invariant 0 <= i && i <= slots.len(),
            {
                if i < used.len() && used[i] {
                    out.push(slots[i].clone());
                }
            }
            extend(&mut out, rest.as_slice());
            out
        }

        #[summary("The state goes to the exit of loop k with value v, and the path ends (stage0 Enc::record_break): what was assumed in the iteration up to here follows it")]
        #[effects(alloc)]
        fn record_break(self: &mut Exec, k: usize, v: encode_terms::Val) -> () {
            if k >= self.loops.len() {
                return;
            }
            let pc: Vec<String> = tail(self.enc.pc.as_slice(), self.loops[k].start);
            let vars: table::Table<encode_terms::Val> = self.vars.clone();
            self.loops[k].breaks.push(Jump { pc: pc, vars: vars, v: v });
            self.dead = true;
        }

        #[summary("What the counterexample of a version comparison shows (the shown value of stage0 Enc::refines): the result, or for a `()` function the new value behind its first &mut parameter")]
        #[effects(alloc)]
        fn refine_shown(self: &Exec, d: &ast::FnDef, post: &table::Table<encode_terms::Val>, result: &encode_terms::Val, ret: &ast::TypeKind, pg: &encode_spec::Prog) -> encode_spec::Shown {
            if decls::is_unit(ret) {
                for i in 0..d.params.len()
                    invariant 0 <= i && i <= d.params.len(),
                {
                    if mut_ref(&d.params[i].ty.kind) {
                        return encode_spec::Shown { name: types::cat2(d.params[i].name.name.as_str(), " after"), v: var_of(post, d.params[i].name.name.as_str()), ty: self.enc.local_ty(d.params[i].name.name.as_str(), pg) };
                    }
                }
            }
            let name: String = match &d.ret.name {
                None => String::from("result"),
                Some(rn) => rn.name.clone(),
            };
            encode_spec::Shown { name: name, v: result.clone(), ty: ret.clone() }
        }

        #[summary("The refinement obligations of trait impl function d against trait method decl (stage0 Enc::refines, ADR-0046 §4, E0817), on its entry values. Nothing for a decl that has no definition row")]
        #[effects(alloc)]
        fn refines(self: &mut Exec, d: &ast::FnDef, decl: &str, tsub: &types::Subst, at: u8, pg: &encode_spec::Prog) -> () {
            match pg.defs.find(decl) {
                None => {},
                Some(td) => self.refines_with(d, decl, &pg.defs.items[td], tsub, at, pg),
            }
        }

        #[summary("refines against the definition row td of decl: the trait's requires imply each of d's, and the trait's requires with d's ensures imply each of the trait's ensures, on a new result and new values behind &mut parameters. Parameters match by position; tsub states the trait's contract for d. Nothing is assumed afterwards. at says where the obligations stand (stage0 RefineAt): 0 a trait impl function against its trait, the ensures obligations at the function's name; 1 and 2 two versions of a definition, each obligation at its clause with the result shown in a counterexample, 2 comparing the ensures on d's own requires")]
        #[effects(alloc)]
        fn refines_with(self: &mut Exec, d: &ast::FnDef, decl: &str, td: &encode_spec::Def, tsub: &types::Subst, at: u8, pg: &encode_spec::Prog) -> () {
            if td.d.pre.len() == 0 && td.d.post.len() == 0 && d.pre.len() == 0 {
                return;
            }
            let saved: Vec<String> = self.enc.pc.clone();
            let env: table::Table<encode_terms::Val> = self.vars.clone();
            let was: table::Table<encode_terms::Val> = self.was.clone();
            let tenv: table::Table<encode_terms::Val> = by_trait(&env, &td.d, d);
            let told: table::Table<encode_terms::Val> = by_trait(&was, &td.d, d);
            let mut treq: Vec<String> = Vec::new();
            for i in 0..td.d.pre.len()
                invariant 0 <= i && i <= td.d.pre.len(),
            {
                treq.push(self.spec_in(td.unit.as_str(), tsub, &td.d.pre[i], &tenv, &told, pg));
            }
            let pre: String = encode_terms::and(treq.as_slice());
            for i in 0..d.pre.len()
                invariant 0 <= i && i <= d.pre.len(),
            {
                let g: String = encode_terms::scalar_of(&self.enc.spec_expr(&d.pre[i], &env, &was, pg, 100000));
                self.oblige("E0817", d.pre[i].span, types::cat5("precondition `", pred_name(&d.pre[i]).as_str(), "` is not implied by the preconditions of `", decl, "`").as_str(), types::cat5("(=> ", pre.as_str(), " ", g.as_str(), ")").as_str());
                self.enc.pc = saved.clone();
            }
            if td.d.post.len() > 0 {
                let mut post: table::Table<encode_terms::Val> = env.clone();
                for i in 0..d.params.len()
                    invariant 0 <= i && i <= d.params.len(),
                {
                    if mut_ref(&d.params[i].ty.kind) {
                        let pty: ast::TypeKind = self.enc.local_ty(d.params[i].name.name.as_str(), pg);
                        let pv: encode_terms::Val = self.enc.fresh_val(types::cat2(d.params[i].name.name.as_str(), ".post").as_str(), &pty, pg, 100000);
                        post.insert(d.params[i].name.name.as_str(), pv);
                    }
                }
                let ret: ast::TypeKind = self.ret_ty(pg);
                let result: encode_terms::Val = self.enc.fresh_val("result.post", &ret, pg, 100000);
                let mut ipost: table::Table<encode_terms::Val> = post.clone();
                match &d.ret.name {
                    None => {},
                    Some(rn) => ipost.insert(rn.name.as_str(), result.clone()),
                }
                let mut assumed: Vec<String> = Vec::new();
                if at == 2 {
                    for i in 0..d.pre.len()
                        invariant 0 <= i && i <= d.pre.len(),
                    {
                        assumed.push(encode_terms::scalar_of(&self.enc.spec_expr(&d.pre[i], &env, &was, pg, 100000)));
                    }
                } else {
                    extend(&mut assumed, treq.as_slice());
                }
                for i in 0..d.post.len()
                    invariant 0 <= i && i <= d.post.len(),
                {
                    assumed.push(encode_terms::scalar_of(&self.enc.spec_expr(&d.post[i], &ipost, &was, pg, 100000)));
                }
                let mut tpost: table::Table<encode_terms::Val> = by_trait(&post, &td.d, d);
                match &td.d.ret.name {
                    None => {},
                    Some(tn) => tpost.insert(tn.name.as_str(), result.clone()),
                }
                let hyp: String = encode_terms::and(assumed.as_slice());
                let base: Vec<String> = self.enc.pc.clone();
                for i in 0..td.d.post.len()
                    invariant 0 <= i && i <= td.d.post.len(),
                {
                    let tg: String = self.spec_in(td.unit.as_str(), tsub, &td.d.post[i], &tpost, &told, pg);
                    let span: source::Span = if at == 0 {
                        d.name.span
                    } else {
                        td.d.post[i].span
                    };
                    let n: usize = self.enc.obls.len();
                    self.oblige("E0817", span, types::cat5("postcondition `", pred_name(&td.d.post[i]).as_str(), "` of `", decl, "` may not hold").as_str(), types::cat5("(=> ", hyp.as_str(), " ", tg.as_str(), ")").as_str());
                    if at != 0 && n < self.enc.obls.len() {
                        let sh: encode_spec::Shown = self.refine_shown(d, &post, &result, &ret, pg);
                        self.enc.obls[n].shown = Some(sh);
                    }
                    self.enc.pc = base.clone();
                }
            }
            self.enc.pc = saved;
        }

        #[summary("The result type of this state's definition, in the query's types")]
        #[effects(alloc)]
        fn ret_ty(self: &Exec, pg: &encode_spec::Prog) -> ast::TypeKind {
            types::subst(&ret_of(pg, self.enc.path.as_str()), &self.enc.tsub)
        }

        #[summary("One arm of an executable `match` on sv of type st, read as variant v (the run closure of stage0 Enc::match_arms): the payload's range facts hold, the bindings are locals, the body runs; for a match on &mut the bindings as they are at the end are written back to the scrutinee's place back")]
        #[effects(alloc)]
        fn run_arm(self: &mut Exec, sv: &str, st: &ast::TypeKind, arm: &ast::Arm, v: &str, back: &Option<ast::Expr>, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let pl: encode_spec::Payload = encode_spec::payload(pg, st, v, sv);
            extend(&mut self.enc.pc, pl.facts.as_slice());
            for k in 0..arm.pat.binds.len()
                invariant 0 <= k && k <= arm.pat.binds.len(),
            {
                if k < pl.vals.len() {
                    match &arm.pat.binds[k] {
                        None => {},
                        Some(id) => self.bind_var(id.name.as_str(), pl.vals[k].clone()),
                    }
                }
            }
            let r: encode_terms::Val = self.eval(&arm.body, pg, f - 1);
            match back {
                None => {},
                Some(place) => { let mut now: Vec<encode_terms::Val> = Vec::new(); for k in 0..arm.pat.binds.len() invariant 0 <= k && k <= arm.pat.binds.len(), { if k < pl.vals.len() { match &arm.pat.binds[k] { None => now.push(pl.vals[k].clone()), Some(bid) => now.push(var_of(&self.vars, bid.name.as_str())), } } } let new: encode_terms::Val = encode_spec::variant_value(st, v, now.as_slice()); self.write_place(place, &new, false, pg, f - 1); },
            }
            r
        }

        #[summary("A shift amount s (of any integer type) must be in 0..w, w the width of the shifted value's type i (stage0 Enc::shift_obligation, ADR-0048 §2: Rust's debug build panics there, so it is an overflow obligation, E0803). A constant amount is decided here")]
        #[effects(alloc)]
        fn shift_obligation(self: &mut Exec, e: &ast::Expr, op: ast::BinOp, i: ast::IntTy, amount: &ast::Expr, s: &str, pg: &encode_spec::Prog) -> () {
            let w: u32 = encode_terms::width(i);
            let ws: String = encode_terms::dec(w as u64);
            let goal: String = match encode_terms::numeral(s) {
                None => { if codegen::is_signed(&self.enc.ty(amount, pg)) { types::cat7("(and (<= 0 ", s, ") (< ", s, " ", ws.as_str(), "))") } else { types::cat5("(< ", s, " ", ws.as_str(), ")") } },
                Some(k) => { let zero: bool = k.mag.hi == 0 && k.mag.lo == 0; if (zero || !k.neg) && k.mag.hi == 0 && k.mag.lo < w as u64 { String::from("true") } else { String::from("false") } },
            };
            self.oblige("E0803", e.span, types::cat5("`", body::op_symbol(op).as_str(), "` may overflow `", body::int_text(i).as_str(), types::cat2("`: the shift amount may be outside 0..", ws.as_str()).as_str()).as_str(), goal.as_str());
        }

        #[summary("The term of specification e of another definition (stage0 Enc::in_def around Enc::spec): translated in its unit, its type parameters substituted by sub")]
        #[effects(alloc)]
        fn spec_in(self: &mut Exec, unit: &str, sub: &types::Subst, e: &ast::Expr, env: &table::Table<encode_terms::Val>, was: &table::Table<encode_terms::Val>, pg: &encode_spec::Prog) -> String {
            let saved_sub: types::Subst = self.enc.tsub.clone();
            let saved_mod: String = self.enc.spec_mod.clone();
            self.enc.tsub = sub.clone();
            self.enc.spec_mod = String::from(unit);
            let g: String = encode_terms::scalar_of(&self.enc.spec_expr(e, env, was, pg, 100000));
            self.enc.spec_mod = saved_mod;
            self.enc.tsub = saved_sub;
            g
        }

        #[summary("A statement of code (stage0 Enc::stmt): `let` binds the value of its initializer, in ghost code a specification value; an assignment evaluates the value, then the place and its bounds, as Rust does; `assert` is an obligation (E0810) and then a fact; `assume` is a trusted fact (ADR-0029 §2), only in a pass that trusts; `while` and `for` are loops (loop_core, stmt_for); a `proof` block is ghost code (proof_block). `assert .. by` is a sub-proof (sub_proof)")]
        #[effects(alloc)]
        fn stmt(self: &mut Exec, s: &ast::Stmt, pg: &encode_spec::Prog, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            match s {
                ast::Stmt::Let(sl) => { if self.ghost { let genv: table::Table<encode_terms::Val> = self.vars.clone(); let gwas: table::Table<encode_terms::Val> = self.was.clone(); let gv: encode_terms::Val = self.enc.spec_expr(&sl.init, &genv, &gwas, pg, 100000); self.bind_var(sl.name.name.as_str(), gv); } else { let v: encode_terms::Val = self.eval(&sl.init, pg, f - 1); self.bind_var(sl.name.name.as_str(), v); } },
                ast::Stmt::Assign(sa) => { let av: encode_terms::Val = self.eval(&sa.value, pg, f - 1); self.write_place(&sa.target, &av, true, pg, f - 1); },
                ast::Stmt::While(w) => { let wc: Option<ast::Expr> = Some(w.cond.clone()); let ws: Option<ForStep> = None; self.loop_core(&w.label, &wc, w.invariants.as_slice(), &w.measure, &w.body, &ws, w.span, pg, f - 1); },
                ast::Stmt::For(fo) => self.stmt_for(fo, pg, f - 1),
                ast::Stmt::Assert(sx) => { match &sx.by { None => { let env: table::Table<encode_terms::Val> = self.vars.clone(); let was: table::Table<encode_terms::Val> = self.was.clone(); let g: String = encode_terms::scalar_of(&self.enc.spec_expr(&sx.cond, &env, &was, pg, 100000)); self.oblige("E0810", sx.span, "assertion may not hold", g.as_str()); }, Some(_) => self.sub_proof(&sx.cond, sx.span, pg), } },
                ast::Stmt::Assume(su) => { if self.trusts_assumptions() { let uenv: table::Table<encode_terms::Val> = self.vars.clone(); let uwas: table::Table<encode_terms::Val> = self.was.clone(); let ug: String = encode_terms::scalar_of(&self.enc.spec_expr(&su.cond, &uenv, &uwas, pg, 100000)); self.enc.pc.push(ug); } },
                ast::Stmt::Proof(pb) => self.proof_block(&pb.body, pg, f - 1),
                ast::Stmt::LetFields(sms_letfields0) => {},
                ast::Stmt::Expr(x) => { self.eval(x, pg, f - 1); },
            }
        }

        #[summary("A range `for` (the For arm of stage0 Enc::stmt, ADR-0049 §2, §3): `let mut i = lo; while i < hi invariant lo <= i && (i <= hi || i == lo), .. decreases hi - i { body; i = i + 1; }` with the bounds evaluated once; the encoding is that expansion's, query for query. The variable ends with the loop")]
        #[effects(alloc)]
        fn stmt_for(self: &mut Exec, x: &ast::For, pg: &encode_spec::Prog, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let lo: String = encode_terms::scalar_of(&self.eval(&x.lo, pg, f - 1));
            let hi: String = encode_terms::scalar_of(&self.eval(&x.hi, pg, f - 1));
            let ty: ast::TypeKind = self.enc.local_ty(x.var.name.as_str(), pg);
            self.bind_var(x.var.name.as_str(), encode_terms::Val::S(lo.clone()));
            let step: Option<ForStep> = Some(ForStep { var: x.var.name.clone(), ty: ty, lo: lo, hi: hi, inclusive: x.inclusive, span: x.span });
            let cond: Option<ast::Expr> = None;
            let dec: Option<ast::Expr> = None;
            self.loop_core(&x.label, &cond, x.invariants.as_slice(), &dec, &x.body, &step, x.span, pg, f - 1);
            self.vars = without(&self.vars, x.var.name.as_str());
        }

        #[summary("`&s[lo..hi]` of text in code (stage0 Enc::str_slice): the boundary obligation (E0820), which alone assumes what UTF-8 holds of the bytes before each bound (utf8_window), and the value")]
        #[effects(alloc)]
        fn str_slice(self: &mut Exec, e: &ast::Expr, base: &ast::Expr, lo: &ast::Expr, hi: &ast::Expr, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let v: encode_terms::Val = self.eval(base, pg, f - 1);
            let a: String = encode_terms::scalar_of(&self.eval(lo, pg, f - 1));
            let b: String = encode_terms::scalar_of(&self.eval(hi, pg, f - 1));
            let p: encode_terms::Pair = match encode_terms::parts(&v) {
                None => { return encode_terms::Val::Unit; },
                Some(found) => found,
            };
            let given: Option<String> = Some(types::cat5("(and ", self.utf8_window(p.a.as_str(), p.b.as_str(), a.as_str()).as_str(), " ", self.utf8_window(p.a.as_str(), p.b.as_str(), b.as_str()).as_str(), ")"));
            let goal: String = types::cat7("(and (<= ", a.as_str(), " ", b.as_str(), ") ", encode_terms::boundary(p.a.as_str(), p.b.as_str(), a.as_str()).as_str(), types::cat3(" ", encode_terms::boundary(p.a.as_str(), p.b.as_str(), b.as_str()).as_str(), ")").as_str());
            self.enc.oblige_given("E0820", e.span, "the range may not lie on character boundaries of the string", &given, goal.as_str());
            encode_spec::sub_text(&v, a.as_str(), b.as_str())
        }

        #[summary("String::from_utf8(v) (stage0 Enc::string_from_utf8): Ok or Err of the same bytes, by a fresh condition (the prover does not model UTF-8 validity, ADR-0050 §3)")]
        #[effects(alloc)]
        fn string_from_utf8(self: &mut Exec, e: &ast::Expr, v: &encode_terms::Val, pg: &encode_spec::Prog) -> encode_terms::Val {
            let ok: String = encode_terms::fresh(&mut self.enc.fr, "utf8", "Bool");
            let t: ast::TypeKind = self.enc.ty(e, pg);
            let mut payload: Vec<encode_terms::Val> = Vec::new();
            payload.push(v.clone());
            let o: String = encode_terms::scalar_of(&encode_spec::variant_value(&t, "Ok", payload.as_slice()));
            let r: String = encode_terms::scalar_of(&encode_spec::variant_value(&t, "Err", payload.as_slice()));
            encode_terms::Val::S(encode_terms::ite(ok.as_str(), o.as_str(), r.as_str()))
        }

        #[summary("`assert(e) by (bit_vector)` (stage0 Enc::sub_proof, ADR-0048 §4): e is proved in a query of its own (encode_sub::bit_vector) that sees its free variables only, each over its whole type, and none of the path's facts. Elements, fields and the like are variables of the sub-proof (abstract_reads). The query translates the very term the enclosing query then assumes, under the free variables' ranges and the guards of unfolded spec fns (true of every value of code). Code, a `proof` block and a proof fn body treat it alike")]
        #[effects(alloc)]
        fn sub_proof(self: &mut Exec, cond: &ast::Expr, span: source::Span, pg: &encode_spec::Prog) -> () {
            let mut reads: Vec<Read> = Vec::new();
            let mut bound: Vec<String> = Vec::new();
            let bv_cond: ast::Expr = self.abstract_reads(cond, &mut bound, &mut reads, pg, 100000);
            let mut free: table::Table<encode_sub::Sort> = table::new::<encode_sub::Sort>();
            let mut around: Vec<String> = Vec::new();
            self.free_scalars(&bv_cond, &mut around, &mut free, pg, 100000);
            let mut env: table::Table<encode_terms::Val> = self.vars.clone();
            let was: table::Table<encode_terms::Val> = self.was.clone();
            for i in 0..reads.len()
                invariant 0 <= i && i <= reads.len(),
            {
                let rv: encode_terms::Val = self.enc.spec_expr(&reads[i].e, &env, &was, pg, 100000);
                env.insert(reads[i].name.as_str(), rv);
            }
            let mut fresh: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
            let mut vars: Vec<encode_sub::Var> = Vec::new();
            for n in 0..free.len()
                invariant 0 <= n,
            {
                match free.nth(n) {
                    None => {},
                    Some(at) => { let name: String = free.key(n); fresh.insert(name.as_str(), encode_terms::Val::S(encode_decls::sym(name.as_str()))); vars.push(encode_sub::Var { sym: encode_decls::sym(name.as_str()), sort: free.items[at] }); },
                }
            }
            let none: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
            let term: String = encode_terms::scalar_of(&self.enc.spec_expr(&bv_cond, &fresh, &none, pg, 100000));
            let fact: String = encode_terms::scalar_of(&self.enc.spec_expr(cond, &env, &was, pg, 100000));
            let revealed: Vec<String> = match pg.defs.find(self.enc.path.as_str()) {
                None => Vec::new(),
                Some(d) => encode_spec::revealed(pg, self.enc.path.as_str(), &pg.defs.items[d].d, self.enc.spec_mod.as_str()),
            };
            let query: Result<encode_sub::Query, encode_sub::Refused> = match encode_terms::parse(term.as_str()) {
                None => Err(encode_sub::Refused { why: String::from("the assertion has no SMT term"), hidden: Vec::new() }),
                Some(sx) => encode_sub::bit_vector(&sx, vars.as_slice(), revealed.as_slice(), &mut self.enc, pg),
            };
            let mut real: table::Table<encode_terms::Sexp> = table::new::<encode_terms::Sexp>();
            let mut ante: Vec<String> = Vec::new();
            for n in 0..free.len()
                invariant 0 <= n,
            {
                match free.nth(n) {
                    None => {},
                    Some(at) => { let name: String = free.key(n); match env.find(name.as_str()) { None => {}, Some(ev) => { let here: String = encode_terms::scalar_of(&env.items[ev]); match encode_terms::parse(here.as_str()) { None => {}, Some(hx) => real.insert(encode_decls::sym(name.as_str()).as_str(), hx), } match free.items[at] { encode_sub::Sort::Int(it) => ante.push(encode_terms::range_int(it, here.as_str())), encode_sub::Sort::Bool => {}, encode_sub::Sort::F64 => {}, } }, } },
                }
            }
            let mut goal: String = String::from("false");
            match &query {
                Ok(q) => { goal = q.goal.clone(); for i in 0..q.guards.len() invariant 0 <= i && i <= q.guards.len(), { match encode_terms::parse(q.guards[i].as_str()) { None => {}, Some(gx) => ante.push(encode_terms::print(&encode_terms::subst_atoms(&gx, &real, 100000), 100000)), } } },
                Err(_) => {},
            }
            self.enc.obls.push(encode_spec::Obl { code: String::from("E0818"), span: span, msg: String::from("bit-vector assertion may not hold"), assumptions: Vec::new(), goal: goal, shown: None, sub: Some(query) });
            if ante.len() == 0 {
                self.enc.pc.push(fact);
            } else {
                self.enc.pc.push(types::cat5("(=> ", encode_terms::and(ante.as_slice()).as_str(), " ", fact.as_str(), ")"));
            }
        }

        #[summary("s.push_str(t) and s.push(c) on a String place recv whose value is rv (stage0 Enc::text_change, ADR-0050 §2): the bytes change by characters. A growth that returns left the length within the maximum (the run time ends the program otherwise, ADR-0124). push_str gives a fresh array stated equal to both parts; push stores the four bytes of c: of a constant its encoding, otherwise an ASCII value itself and fresh lead and continuation bytes (utf8_classes)")]
        #[effects(alloc)]
        fn text_change(self: &mut Exec, recv: &ast::Expr, rv: &encode_terms::Val, whole: bool, args: &[ast::Expr], pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            if args.len() == 0 {
                return encode_terms::Val::Unit;
            }
            let p: encode_terms::Pair = match encode_terms::parts(rv) {
                None => { return encode_terms::Val::Unit; },
                Some(found) => found,
            };
            let n: String = p.b.clone();
            let limit: String = String::from("9223372036854775807");
            if whole {
                let t: encode_terms::Val = self.eval(&args[0], pg, f - 1);
                let tp: encode_terms::Pair = match encode_terms::parts(&t) {
                    None => { return encode_terms::Val::Unit; },
                    Some(tfound) => tfound,
                };
                let sum: String = types::cat5("(+ ", n.as_str(), " ", tp.b.as_str(), ")");
                self.enc.pc.push(types::cat5("(<= ", sum.as_str(), " ", limit.as_str(), ")"));
                let new: String = encode_terms::fresh(&mut self.enc.fr, "push_str", "(Array Int Int)");
                let k: String = self.enc.bound_name("cat");
                let mut s: String = types::cat5("(forall ((", k.as_str(), " Int)) (! (= (select ", new.as_str(), " ");
                s.push_str(types::cat5(k.as_str(), ") (ite (< ", k.as_str(), " ", n.as_str()).as_str());
                s.push_str(types::cat5(") (select ", p.a.as_str(), " ", k.as_str(), ") (select ").as_str());
                s.push_str(types::cat5(tp.a.as_str(), " (- ", k.as_str(), " ", n.as_str()).as_str());
                s.push_str(types::cat5(")))) :pattern ((select ", new.as_str(), " ", k.as_str(), "))))").as_str());
                self.enc.pc.push(s);
                self.write_place(recv, &encode_terms::Val::A(new, sum), false, pg, f - 1);
                return encode_terms::Val::Unit;
            }
            let c: String = encode_terms::scalar_of(&self.eval(&args[0], pg, f - 1));
            self.enc.pc.push(encode_terms::scalar(c.as_str()));
            let grown: String = types::cat5("(+ ", n.as_str(), " ", encode_terms::utf8_len(c.as_str()).as_str(), ")");
            self.enc.pc.push(types::cat5("(<= ", grown.as_str(), " ", limit.as_str(), ")"));
            let bs: Vec<String> = match utf8_const(c.as_str()) {
                None => self.utf8_classes(c.as_str()),
                Some(known) => known,
            };
            let mut arr: String = p.a.clone();
            for j in 0..bs.len()
                invariant 0 <= j && j <= bs.len(),
            {
                arr = types::cat7("(store ", arr.as_str(), " (+ ", n.as_str(), " ", encode_terms::dec(j as u64).as_str(), types::cat3(") ", bs[j].as_str(), ")").as_str());
            }
            self.write_place(recv, &encode_terms::Val::A(arr, grown), false, pg, f - 1);
            encode_terms::Val::Unit
        }

        #[summary("l op r on text in code (stage0 Enc::text_cmp_code, ADR-0050 §2), Rust's byte-lexicographic order: the longest common prefix p is a fresh constant with its defining facts, and every order follows from it. k is the code of op (op_code), a comparison. Empty text for a value that is no text, which the checker admits none of")]
        #[effects(alloc)]
        fn text_cmp_code(self: &mut Exec, k: u8, l: &encode_terms::Val, r: &encode_terms::Val) -> String {
            let pl: encode_terms::Pair = match encode_terms::parts(l) {
                None => { return String::new(); },
                Some(found_l) => found_l,
            };
            let pr: encode_terms::Pair = match encode_terms::parts(r) {
                None => { return String::new(); },
                Some(found_r) => found_r,
            };
            let a: String = pl.a.clone();
            let la: String = pl.b.clone();
            let b: String = pr.a.clone();
            let lb: String = pr.b.clone();
            let p: String = encode_terms::fresh(&mut self.enc.fr, "lcp", "Int");
            let j: String = self.enc.bound_name("lcp");
            let ap: String = types::cat5("(select ", a.as_str(), " ", p.as_str(), ")");
            let bp: String = types::cat5("(select ", b.as_str(), " ", p.as_str(), ")");
            self.enc.pc.push(types::cat3("(<= 0 ", p.as_str(), ")"));
            self.enc.pc.push(types::cat5("(<= ", p.as_str(), " ", la.as_str(), ")"));
            self.enc.pc.push(types::cat5("(<= ", p.as_str(), " ", lb.as_str(), ")"));
            let mut s: String = types::cat5("(forall ((", j.as_str(), " Int)) (! (=> (and (<= 0 ", j.as_str(), ") (< ");
            s.push_str(types::cat5(j.as_str(), " ", p.as_str(), ")) (= (select ", a.as_str()).as_str());
            s.push_str(types::cat5(" ", j.as_str(), ") (select ", b.as_str(), " ").as_str());
            s.push_str(types::cat5(j.as_str(), "))) :pattern ((select ", a.as_str(), " ", j.as_str()).as_str());
            s.push_str(types::cat5(")) :pattern ((select ", b.as_str(), " ", j.as_str(), "))))").as_str());
            self.enc.pc.push(s);
            self.enc.pc.push(types::cat7("(or (= ", p.as_str(), " ", la.as_str(), ") (= ", p.as_str(), types::cat5(" ", lb.as_str(), ") (not (= ", ap.as_str(), types::cat3(" ", bp.as_str(), ")))").as_str()).as_str()));
            let eq: String = types::cat7("(and (= ", la.as_str(), " ", lb.as_str(), ") (= ", p.as_str(), types::cat3(" ", la.as_str(), "))").as_str());
            let both: String = types::cat7("(< ", p.as_str(), " ", la.as_str(), ") (< ", p.as_str(), types::cat3(" ", lb.as_str(), ")").as_str());
            let lt: String = text_less(p.as_str(), la.as_str(), lb.as_str(), both.as_str(), ap.as_str(), bp.as_str());
            let gt: String = text_less(p.as_str(), lb.as_str(), la.as_str(), both.as_str(), bp.as_str(), ap.as_str());
            if k == 5 {
                return eq;
            }
            if k == 6 {
                return types::cat3("(not ", eq.as_str(), ")");
            }
            if k == 7 {
                return lt;
            }
            if k == 9 {
                return gt;
            }
            if k == 8 {
                return types::cat3("(not ", gt.as_str(), ")");
            }
            types::cat3("(not ", lt.as_str(), ")")
        }

        #[summary("Whether the current pass assumes `assume` facts (stage0 trusts_assumptions)")]
        #[effects(pure)]
        fn trusts_assumptions(self: &Exec) -> bool {
            match &self.trust {
                None => true,
                Some(t) => t.trusted,
            }
        }

        #[summary("Whether the current pass assumes the ensures of callee path (stage0 trusts_callee)")]
        #[effects(pure)]
        fn trusts_callee(self: &Exec, path: &str) -> bool {
            match &self.trust {
                None => true,
                Some(t) => t.trusted || !types::has(t.untrusted.as_slice(), path),
            }
        }

        #[summary("The side of `x?` that goes on (the go_on closure of stage0 Enc::eval): sv is variant ok of st, and the value is its payload, in its range")]
        #[effects(alloc)]
        fn try_go_on(self: &mut Exec, st: &ast::TypeKind, ok: &str, sv: &str, pg: &encode_spec::Prog) -> encode_terms::Val {
            let pl: encode_spec::Payload = encode_spec::payload(pg, st, ok, sv);
            extend(&mut self.enc.pc, pl.facts.as_slice());
            if pl.vals.len() > 0 {
                pl.vals[0].clone()
            } else {
                encode_terms::Val::Unit
            }
        }

        #[summary("The side of `x?` that leaves (the leave closure of stage0 Enc::eval): sv is variant bad of st, the function returns that variant of its own result type with the same payload, the postconditions hold there, and the path ends")]
        #[effects(alloc)]
        fn try_leave(self: &mut Exec, e: &ast::Expr, st: &ast::TypeKind, bad: &str, sv: &str, pg: &encode_spec::Prog) -> encode_terms::Val {
            let rt: ast::TypeKind = self.ret_ty(pg);
            let pl: encode_spec::Payload = encode_spec::payload(pg, st, bad, sv);
            extend(&mut self.enc.pc, pl.facts.as_slice());
            let r: encode_terms::Val = encode_spec::variant_value(&rt, bad, pl.vals.as_slice());
            self.post_check(&r, e.span, "at this `?`", pg);
            self.dead = true;
            encode_terms::Val::Unit
        }

        #[summary("The bytes of push(c) for a c that is not a constant (stage0 Enc::utf8_classes): an ASCII value is its own byte, and otherwise the bytes are fresh, a lead byte and continuation bytes. The exact encoding's div and mod of c made the solver give up on queries that also hold the quantified facts of text")]
        #[effects(alloc)]
        fn utf8_classes(self: &mut Exec, c: &str) -> Vec<String> {
            let lead: String = encode_terms::fresh(&mut self.enc.fr, "utf8.lead", "Int");
            self.enc.pc.push(types::cat5("(and (<= 192 ", lead.as_str(), ") (<= ", lead.as_str(), " 244))"));
            let mut bs: Vec<String> = Vec::new();
            bs.push(types::cat7("(ite (< ", c, " 128) ", c, " ", lead.as_str(), ")"));
            for i in 0..3
                invariant 0 <= i && i <= 3,
            {
                let x: String = encode_terms::fresh(&mut self.enc.fr, "utf8.cont", "Int");
                self.enc.pc.push(types::cat5("(and (<= 128 ", x.as_str(), ") (<= ", x.as_str(), " 191))"));
                bs.push(x);
            }
            bs
        }

        #[summary("What UTF-8 holds where boundary i of text (a, n) is asked (stage0 Enc::utf8_window): the bytes before i (utf8_before) of that text and of every text known valid here (another text's bytes may equal these), and the end of each known text (its last character is whole: a prefix that matched it ends at a boundary)")]
        #[effects(alloc)]
        fn utf8_window(self: &Exec, a: &str, n: &str, i: &str) -> String {
            let mut ps: Vec<String> = Vec::new();
            ps.push(encode_terms::utf8_before(a, n, i));
            for k in 0..self.texts.len()
                invariant 0 <= k && k <= self.texts.len(),
            {
                let b: String = self.texts[k].a.clone();
                let m: String = self.texts[k].b.clone();
                if !(b.as_str() == a && m.as_str() == n) {
                    ps.push(encode_terms::utf8_before(b.as_str(), m.as_str(), i));
                }
                ps.push(encode_terms::utf8_before(b.as_str(), m.as_str(), m.as_str()));
            }
            types::cat3("(and ", encode_terms::join(ps.as_slice(), " ").as_str(), ")")
        }

        #[summary("The conjuncts of the validity of v of type t (stage0 Enc::valid, ADR-0060 §2), none when t has no invariant anywhere: a type parameter's is an uninterpreted predicate, declared on first use; an array's is quantified over its elements; a struct held as leaves has its invariant atom and its fields'; a datatype on a cycle has a validity function; another datatype one level of its variants")]
        #[effects(alloc)]
        fn valid(self: &mut Exec, v: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog, f: usize) -> Vec<String>
            decreases f,
        {
            if f == 0 {
                return Vec::new();
            }
            if !self.needs_valid(t, pg) {
                return Vec::new();
            }
            let arr: bool = encode_decls::is_array(t);
            if !arr {
                match body::ref_inner(t) {
                    None => {},
                    Some(inner) => { return self.valid(v, &inner, pg, f - 1); },
                }
            }
            match param_name(t) {
                None => {},
                Some(pn) => { let pf: String = encode_decls::sym(types::cat3("'", pn.as_str(), ".valid").as_str()); if !self.valid_decl.has(pf.as_str()) { self.valid_decl.insert(pf.as_str(), true); self.enc.fr.decls.push(types::cat5("(declare-fun ", pf.as_str(), " (", encode_decls::sort_of(t).as_str(), ") Bool)")); } let mut one: Vec<String> = Vec::new(); one.push(types::cat5("(", pf.as_str(), " ", encode_terms::scalar_of(v).as_str(), ")")); return one; },
            }
            if arr {
                return self.valid_array(v, t, pg, f - 1);
            }
            match encode_decls::flat_fields(t, &pg.pr.t) {
                None => {},
                Some(fs) => { match v { encode_terms::Val::S(vsv_s0) => {}, encode_terms::Val::A(vsv_a0, vsv_a1) => {}, encode_terms::Val::Unit => {}, encode_terms::Val::Struct(xs) => { let mut out: Vec<String> = self.inv_app(v, t, pg); for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { if i < xs.len() { let more: Vec<String> = self.valid(&xs[i], &fs[i].ty, pg, f - 1); extend(&mut out, more.as_slice()); } } return out; }, encode_terms::Val::Arr(vsv_arr0, vsv_arr1) => {}, } },
            }
            let c: String = match v {
                encode_terms::Val::S(x) => x.clone(),
                encode_terms::Val::A(vcv_a0, vcv_a1) => { return Vec::new(); },
                encode_terms::Val::Unit => { return Vec::new(); },
                encode_terms::Val::Struct(vcv_struct0) => { return Vec::new(); },
                encode_terms::Val::Arr(vcv_arr0, vcv_arr1) => { return Vec::new(); },
            };
            if rec_valid(t, &pg.pr.t) {
                let vf: String = self.valid_fn(t, pg, f - 1);
                let mut app: Vec<String> = Vec::new();
                app.push(types::cat5("(", vf.as_str(), " ", c.as_str(), ")"));
                return app;
            }
            self.valid_dt(c.as_str(), t, pg, f - 1)
        }

        #[summary("The validity of array value v of type t (the array part of stage0 Enc::valid): every element below the length is valid, triggered on the element read. The bound name is by nesting depth: the same value has the same text, so a fact already on the path is not proved again")]
        #[effects(alloc)]
        fn valid_array(self: &mut Exec, v: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog, f: usize) -> Vec<String>
            decreases f,
        {
            if f == 0 {
                return Vec::new();
            }
            let e: ast::TypeKind = encode_decls::elem_ty(t);
            let k: String = encode_decls::sym(types::cat2("valid!k", encode_terms::dec(self.valid_depth).as_str()).as_str());
            let mut pats: Vec<String> = Vec::new();
            let len: String = encode_spec::len_of(v);
            let elem: encode_terms::Val = match v {
                encode_terms::Val::S(vav_s0) => { return Vec::new(); },
                encode_terms::Val::A(elems, va_l) => { let x: String = types::cat5("(select ", elems.as_str(), " ", k.as_str(), ")"); pats.push(x.clone()); encode_terms::Val::S(x) },
                encode_terms::Val::Unit => { return Vec::new(); },
                encode_terms::Val::Struct(vav_struct0) => { return Vec::new(); },
                encode_terms::Val::Arr(el, va_n) => { let mut ls: Vec<String> = Vec::new(); encode_terms::flatten_elem(&**el, &mut ls, 100000); for i in 0..ls.len() invariant 0 <= i && i <= ls.len(), { pats.push(types::cat5("(select ", ls[i].as_str(), " ", k.as_str(), ")")); } encode_terms::select_val(&**el, k.as_str(), 100000) },
            };
            self.valid_depth = self.valid_depth.saturating_add(1);
            let inner: Vec<String> = self.valid(&elem, &e, pg, f - 1);
            if self.valid_depth > 0 {
                self.valid_depth = self.valid_depth - 1;
            }
            let mut out: Vec<String> = Vec::new();
            if inner.len() == 0 {
                return out;
            }
            let mut ps: Vec<String> = Vec::new();
            for i in 0..pats.len()
                invariant 0 <= i && i <= pats.len(),
            {
                ps.push(types::cat3(":pattern (", pats[i].as_str(), ")"));
            }
            out.push(types::cat5("(forall ((", k.as_str(), " Int)) (! (=> (and (<= 0 ", k.as_str(), types::cat5(") (< ", k.as_str(), " ", len.as_str(), types::cat5(")) ", encode_terms::and(inner.as_slice()).as_str(), ") ", encode_terms::join(ps.as_slice(), " ").as_str(), "))").as_str()).as_str()));
            out
        }

        #[summary("The validity of datatype value c of type t, one level (stage0 Enc::valid_dt): its invariant, and each variant's payloads (a recursive struct's fields) when it is that variant. A value written with its constructor is that variant, and its payloads are the arguments")]
        #[effects(alloc)]
        fn valid_dt(self: &mut Exec, c: &str, t: &ast::TypeKind, pg: &encode_spec::Prog, f: usize) -> Vec<String>
            decreases f,
        {
            if f == 0 {
                return Vec::new();
            }
            let mut out: Vec<String> = self.inv_app(&encode_terms::Val::S(String::from(c)), t, pg);
            if encode_decls::dt_struct(t, &pg.pr.t) {
                match lowered::struct_fields(t, &pg.pr.t) {
                    None => {},
                    Some(fs) => { let xs: Vec<encode_terms::Val> = encode_terms::dt_fields(&lowered::value_ty(t), c, &pg.pr.t); for i in 0..xs.len() invariant 0 <= i && i <= xs.len(), { if i < fs.len() { let fv: Vec<String> = self.valid(&xs[i], &fs[i].ty, pg, f - 1); extend(&mut out, fv.as_slice()); } } },
                }
                return out;
            }
            let vs: Vec<types::VariantSig> = match lowered::enum_variants(t, &pg.pr.t) {
                None => Vec::new(),
                Some(found) => found,
            };
            let mut built: usize = vs.len();
            for i in 0..vs.len()
                invariant 0 <= i && i <= vs.len(),
            {
                let k: String = encode_decls::ctor(t, vs[i].name.as_str());
                if built == vs.len() && (c == k.as_str() || moves::starts_with(c, types::cat3("(", k.as_str(), " ").as_str())) {
                    built = i;
                }
            }
            for i in 0..vs.len()
                invariant 0 <= i && i <= vs.len(),
            {
                let mut any: bool = false;
                for j in 0..vs[i].tys.len()
                    invariant 0 <= j && j <= vs[i].tys.len(),
                {
                    if !any && self.needs_valid(&vs[i].tys[j], pg) {
                        any = true;
                    }
                }
                if (built == vs.len() || built == i) && any {
                    let args: Option<Vec<encode_terms::Val>> = if built == i {
                        ctor_args(c, vs[i].tys.as_slice(), &pg.pr.t)
                    } else {
                        None
                    };
                    let vals: Vec<encode_terms::Val> = match args {
                        None => { let pl: encode_spec::Payload = encode_spec::payload(pg, t, vs[i].name.as_str(), c); pl.vals.clone() },
                        Some(found_args) => found_args,
                    };
                    let mut inner: Vec<String> = Vec::new();
                    for j in 0..vals.len()
                        invariant 0 <= j && j <= vals.len(),
                    {
                        if j < vs[i].tys.len() {
                            let pv: Vec<String> = self.valid(&vals[j], &vs[i].tys[j], pg, f - 1);
                            extend(&mut inner, pv.as_slice());
                        }
                    }
                    if inner.len() > 0 {
                        if built == i {
                            extend(&mut out, inner.as_slice());
                        } else {
                            out.push(types::cat7("(=> ((_ is ", encode_decls::ctor(t, vs[i].name.as_str()).as_str(), ") ", c, ") ", encode_terms::and(inner.as_slice()).as_str(), ")"));
                        }
                    }
                }
            }
            out
        }

        #[summary("The validity function of recursive datatype t, declared and defined (for ground instances) on first use (stage0 Enc::valid_fn)")]
        #[effects(alloc)]
        fn valid_fn(self: &mut Exec, t: &ast::TypeKind, pg: &encode_spec::Prog, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            let vt: ast::TypeKind = lowered::value_ty(t);
            let name: String = encode_decls::sym(types::cat2(types::text(&vt).as_str(), ".'valid").as_str());
            if !self.valid_decl.has(name.as_str()) {
                self.valid_decl.insert(name.as_str(), true);
                let sort: String = encode_decls::sort_of(&vt);
                self.enc.fr.decls.push(types::cat5("(declare-fun ", name.as_str(), " (", sort.as_str(), ") Bool)"));
                let x: String = encode_decls::sym("valid!x");
                let inner: Vec<String> = self.valid_dt(x.as_str(), &vt, pg, f - 1);
                let mut params: Vec<String> = Vec::new();
                params.push(x.clone());
                let mut binders: Vec<String> = Vec::new();
                binders.push(types::cat5("(", x.as_str(), " ", sort.as_str(), ")"));
                self.valid_defs.push(encode_spec::AxiomParts { sym: name.clone(), params: params, binders: binders, guard: String::from("true"), body: encode_terms::and(inner.as_slice()), sort: String::from("Bool"), recursive: true });
            }
            name
        }

        #[summary("The conjuncts of the validity of v of type t that are not on the path condition yet")]
        #[effects(alloc)]
        fn valid_goals(self: &mut Exec, v: &encode_terms::Val, t: &ast::TypeKind, pg: &encode_spec::Prog) -> Vec<String> {
            let all: Vec<String> = self.valid(v, t, pg, 100000);
            let mut goals: Vec<String> = Vec::new();
            for i in 0..all.len()
                invariant 0 <= i && i <= all.len(),
            {
                if !types::has(self.enc.pc.as_slice(), all[i].as_str()) {
                    goals.push(all[i].clone());
                }
            }
            goals
        }

        #[summary("push, pop and truncate on a Vec place x.recv whose value is rv (stage0 Enc::vec_change, ADR-0031 §3): the new elements and length are written back to the receiver's place. A push that returns left the length within the maximum (a fact, ADR-0124); pop is None exactly on an empty Vec; truncate keeps the smaller of the two lengths")]
        #[effects(alloc)]
        fn vec_change(self: &mut Exec, e: &ast::Expr, x: &ast::Method, rv: &encode_terms::Val, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let m: String = x.name.name.clone();
            let el: ast::TypeKind = encode_decls::elem_ty(&self.enc.ty(&*x.recv, pg));
            let len: String = encode_spec::len_of(rv);
            let elems: encode_terms::Val = elems_of(rv);
            if m == "pop" {
                let empty: String = types::cat3("(= ", len.as_str(), " 0)");
                let last_at: String = types::cat3("(- ", len.as_str(), " 1)");
                let opt: ast::TypeKind = self.enc.ty(e, pg);
                let mut payload: Vec<encode_terms::Val> = Vec::new();
                payload.push(encode_terms::select_val(&elems, last_at.as_str(), 100000));
                let some: String = encode_terms::scalar_of(&encode_spec::variant_value(&opt, "Some", payload.as_slice()));
                let nothing: Vec<encode_terms::Val> = Vec::new();
                let none: String = encode_terms::scalar_of(&encode_spec::variant_value(&opt, "None", nothing.as_slice()));
                let popped: encode_terms::Val = encode_spec::whole_array(elems, encode_terms::ite(empty.as_str(), "0", last_at.as_str()));
                self.write_place(&*x.recv, &popped, false, pg, f - 1);
                return encode_terms::Val::S(encode_terms::ite(empty.as_str(), none.as_str(), some.as_str()));
            }
            if x.args.len() == 0 {
                return encode_terms::Val::Unit;
            }
            if m == "push" {
                let item: encode_terms::Val = self.eval(&x.args[0], pg, f - 1);
                self.enc.pc.push(types::cat5("(< ", len.as_str(), " ", encode_terms::len_max(&el).as_str(), ")"));
                let stored: encode_terms::Val = encode_terms::store_val(&elems, len.as_str(), &item, 100000);
                let pushed: encode_terms::Val = encode_spec::whole_array(stored, types::cat3("(+ ", len.as_str(), " 1)"));
                self.write_place(&*x.recv, &pushed, false, pg, f - 1);
                return encode_terms::Val::Unit;
            }
            let n: String = encode_terms::scalar_of(&self.eval(&x.args[0], pg, f - 1));
            let cut: encode_terms::Val = encode_spec::whole_array(elems, encode_terms::ite(types::cat5("(< ", n.as_str(), " ", len.as_str(), ")").as_str(), n.as_str(), len.as_str()));
            self.write_place(&*x.recv, &cut, false, pg, f - 1);
            encode_terms::Val::Unit
        }

        #[summary("Vec::new() and Vec::with_capacity(n), and the same of String (stage0 Enc::vec_new): length 0, elements unknown; a capacity above the maximum length is E0816 (Rust panics)")]
        #[effects(alloc)]
        fn vec_new(self: &mut Exec, e: &ast::Expr, c: &ast::Call, pg: &encode_spec::Prog, f: usize) -> encode_terms::Val
            decreases f,
        {
            if f == 0 {
                return encode_terms::Val::Unit;
            }
            let el: ast::TypeKind = encode_decls::elem_ty(&self.enc.ty(e, pg));
            if c.path.len() > 1 && c.path[1].name == "with_capacity" && c.args.len() > 0 {
                let n: String = encode_terms::scalar_of(&self.eval(&c.args[0], pg, f - 1));
                self.oblige("E0816", e.span, "the capacity may exceed the maximum length of a `Vec`", types::cat5("(<= ", n.as_str(), " ", encode_terms::len_max(&el).as_str(), ")").as_str());
            }
            if encode_decls::agg_elem(&el, &pg.pr.t) {
                return encode_terms::Val::Arr(Box::new(self.enc.fresh_struct_elems("vec", &el, pg)), String::from("0"));
            }
            encode_terms::Val::A(self.enc.fresh_elems("vec", &el, false), String::from("0"))
        }

        #[summary("Writes new to place expression e (the place, set_at and bind_var steps of stage0 Enc::stmt, mem_call and match_arms): the variable's value with the place replaced is bound to the variable")]
        #[effects(alloc)]
        fn write_place(self: &mut Exec, e: &ast::Expr, new: &encode_terms::Val, check: bool, pg: &encode_spec::Prog, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut steps: Vec<encode_terms::Step> = Vec::new();
            let root: String = self.place(e, &mut steps, check, pg, f - 1);
            let cur: encode_terms::Val = var_of(&self.vars, root.as_str());
            let nv: encode_terms::Val = encode_terms::set_at(&cur, steps.as_slice(), 0, new, &pg.pr.t, &mut self.enc.fr);
            self.bind_var(root.as_str(), nv);
        }
    }

    #[summary("A range `for` (stage0 ForStep): var from lo to hi, excluded or included, the bounds evaluated once on entry; ty is the variable's type and span the loop")]
    struct ForStep { var: String, ty: ast::TypeKind, lo: String, hi: String, inclusive: bool, span: source::Span }

    #[summary("A `break` of a loop (the breaks of stage0 VLoop): the path condition of the iteration there, the locals, and the value it carries")]
    struct Jump { pc: Vec<String>, vars: table::Table<encode_terms::Val>, v: encode_terms::Val }

    #[summary("A reach point (stage0 Enc::reach): where, what it is, and the path condition there")]
    struct Reach { span: source::Span, what: String, pc: Vec<String> }

    #[summary("A scalar read that an `assert .. by` takes as a variable of its sub-proof: the variable's name, the read, and the read's text")]
    struct Read { name: String, e: ast::Expr, text: String }

    #[summary("One side of a branch that has run (the middle of stage0 Enc::branch): the locals it left, the facts it added to the path condition, whether it returned")]
    struct Side { vars: table::Table<encode_terms::Val>, facts: Vec<String>, dead: bool }

    #[summary("The trust of the pass being run (stage0 TrustPass, ADR-0029 §2): whether trusted facts enter the proof, and the callees that are not proved, sorted")]
    struct Trust { trusted: bool, untrusted: Vec<String> }

    #[summary("A local and its type")]
    struct Typed { name: String, ty: ast::TypeKind }

    #[summary("A loop a `break` or `continue` may leave (stage0 VLoop, ADR-0049 §3). start is the length of the path condition at the head of the iteration: what was assumed in the iteration up to a `break` follows it. dec is the decreases clause and measure its term at the head of the iteration. step is a range `for`'s variable and bounds: the end of an iteration steps it (ADR-0049 §2). valid_vars are the locals the loop havocs that have a validity: valid again when an iteration goes back to the head (ADR-0060 §2)")]
    struct VLoop { label: Option<String>, start: usize, invariants: Vec<ast::Expr>, dec: Option<ast::Expr>, measure: Option<String>, breaks: Vec<Jump>, step: Option<ForStep>, span: source::Span, valid_vars: Vec<Typed> }

    #[summary("The locals block b may assign, added to out (stage0 assigned_in_block): the root of each assignment's target, what its expressions assign, and the variable of each `for` (local to its loop, and stepped by it). Ghost code assigns nothing (E0257)")]
    #[effects(alloc)]
    fn assigned_in_block(b: &ast::Block, out: &mut table::Table<bool>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..b.stmts.len()
            invariant 0 <= i && i <= b.stmts.len(),
        {
            match &b.stmts[i] {
                ast::Stmt::Let(sl) => assigned_in_expr(&sl.init, out, f - 1),
                ast::Stmt::Assign(sa) => { match root_var(&sa.target, 100000) { None => {}, Some(r) => out.insert(r.as_str(), true), } assigned_in_expr(&sa.value, out, f - 1); },
                ast::Stmt::While(w) => { assigned_in_expr(&w.cond, out, f - 1); assigned_in_block(&w.body, out, f - 1); },
                ast::Stmt::For(fo) => { assigned_in_expr(&fo.lo, out, f - 1); assigned_in_expr(&fo.hi, out, f - 1); assigned_in_block(&fo.body, out, f - 1); out.insert(fo.var.name.as_str(), true); },
                ast::Stmt::Assert(abs_assert0) => {},
                ast::Stmt::Assume(abs_assume0) => {},
                ast::Stmt::Proof(abs_proof0) => {},
                ast::Stmt::LetFields(lf) => assigned_in_expr(&lf.init, out, f - 1),
                ast::Stmt::Expr(x) => assigned_in_expr(x, out, f - 1),
            }
        }
        match &b.tail {
            None => {},
            Some(t) => assigned_in_expr(&**t, out, f - 1),
        }
    }

    #[summary("The locals expression e may assign, added to out (stage0 assigned_in_expr): the root of a place passed by &mut, of the receiver of a method that changes it, of the scrutinee of a `match` on &mut (it writes the place through its bindings, ADR-0055), and what the expressions inside assign. A variable passed on or matched on is marked `?name` (mark_passed)")]
    #[effects(alloc)]
    fn assigned_in_expr(e: &ast::Expr, out: &mut table::Table<bool>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match &e.kind {
            ast::ExprKind::Int(aie_int0, aie_int1) => {},
            ast::ExprKind::Float(aie_float0) => {},
            ast::ExprKind::ByteLit(aie_bytelit0) => {},
            ast::ExprKind::ByteStr(aie_bytestr0) => {},
            ast::ExprKind::StrLit(aie_strlit0) => {},
            ast::ExprKind::CharLit(aie_charlit0) => {},
            ast::ExprKind::Bool(aie_bool0) => {},
            ast::ExprKind::Unit => {},
            ast::ExprKind::Var(aie_var0) => {},
            ast::ExprKind::Call(c) => { for i in 0..c.args.len() invariant 0 <= i && i <= c.args.len(), { mark_passed(&c.args[i], out); assigned_in_expr(&c.args[i], out, f - 1); } },
            ast::ExprKind::Method(mc) => { if receiver_mut(mc.name.name.as_str()) { match root_var(&*mc.recv, 100000) { None => {}, Some(r) => out.insert(r.as_str(), true), } } assigned_in_expr(&*mc.recv, out, f - 1); assigned_in_exprs(mc.args.as_slice(), out, f - 1); },
            ast::ExprKind::Index(ib, ii) => { assigned_in_expr(&**ib, out, f - 1); assigned_in_expr(&**ii, out, f - 1); },
            ast::ExprKind::Unary(uop, ux) => assigned_in_expr(&**ux, out, f - 1),
            ast::ExprKind::Binary(bop, lhs, rhs) => { assigned_in_expr(&**lhs, out, f - 1); assigned_in_expr(&**rhs, out, f - 1); },
            ast::ExprKind::Ref(rm, rx) => assigned_in_expr(&**rx, out, f - 1),
            ast::ExprKind::If(x) => { assigned_in_expr(&*x.cond, out, f - 1); assigned_in_block(&x.then, out, f - 1); match &x.els { None => {}, Some(el) => assigned_in_expr(&**el, out, f - 1), } },
            ast::ExprKind::Block(blk) => assigned_in_block(blk, out, f - 1),
            ast::ExprKind::Array(items) => assigned_in_exprs(items.as_slice(), out, f - 1),
            ast::ExprKind::Repeat(rp) => assigned_in_expr(&*rp.value, out, f - 1),
            ast::ExprKind::Old(aie_old0) => {},
            ast::ExprKind::Quant(aie_quant0) => {},
            ast::ExprKind::Trigger(aie_trigger0) => {},
            ast::ExprKind::Closure(aie_closure0) => {},
            ast::ExprKind::StructLit(lit) => { for k in 0..lit.fields.len() invariant 0 <= k && k <= lit.fields.len(), { assigned_in_expr(&lit.fields[k].value, out, f - 1); } },
            ast::ExprKind::Path(aie_path0) => {},
            ast::ExprKind::Deref(dx) => assigned_in_expr(&**dx, out, f - 1),
            ast::ExprKind::Field(fb, fname) => assigned_in_expr(&**fb, out, f - 1),
            ast::ExprKind::Match(mx) => { mark_passed(&*mx.scrut, out); assigned_in_expr(&*mx.scrut, out, f - 1); for j in 0..mx.arms.len() invariant 0 <= j && j <= mx.arms.len(), { assigned_in_expr(&mx.arms[j].body, out, f - 1); } },
            ast::ExprKind::Return(rv) => { match rv { None => {}, Some(rvx) => assigned_in_expr(&**rvx, out, f - 1), } },
            ast::ExprKind::Try(tx) => assigned_in_expr(&**tx, out, f - 1),
            ast::ExprKind::Loop(lp) => assigned_in_block(&lp.body, out, f - 1),
            ast::ExprKind::Break(bk) => { match &bk.value { None => {}, Some(bvx) => assigned_in_expr(&**bvx, out, f - 1), } },
            ast::ExprKind::Continue(aie_continue0) => {},
            ast::ExprKind::Range(aie_range0) => {},
            ast::ExprKind::Error => {},
        }
    }

    #[summary("assigned_in_expr for each of xs")]
    #[effects(alloc)]
    fn assigned_in_exprs(xs: &[ast::Expr], out: &mut table::Table<bool>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            assigned_in_expr(&xs[i], out, f - 1);
        }
    }

    #[summary("The values of m by the trait method's parameter names (the by_trait closure of stage0 Enc::refines): the trait method tf and the impl function d match by position")]
    #[effects(alloc)]
    fn by_trait(m: &table::Table<encode_terms::Val>, tf: &ast::FnDef, d: &ast::FnDef) -> table::Table<encode_terms::Val> {
        let mut out: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
        for i in 0..tf.params.len()
            invariant 0 <= i && i <= tf.params.len(),
        {
            if i < d.params.len() {
                match m.find(d.params[i].name.name.as_str()) {
                    None => {},
                    Some(at) => out.insert(tf.params[i].name.name.as_str(), m.items[at].clone()),
                }
            }
        }
        out
    }

    #[summary("A copy of expression e")]
    #[effects(alloc)]
    fn copy_expr(e: &ast::Expr) -> ast::Expr {
        e.clone()
    }

    #[summary("Copies of xs")]
    #[effects(alloc)]
    fn copy_exprs(xs: &[ast::Expr]) -> Vec<ast::Expr> {
        let mut out: Vec<ast::Expr> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(xs[i].clone());
        }
        out
    }

    #[summary("The payloads of constructor application c, a variant with payload types tys (the built case of stage0 Enc::valid_dt): its arguments are the leaves of the payloads in order. None for text that is no application")]
    #[effects(alloc)]
    fn ctor_args(c: &str, tys: &[ast::TypeKind], tb: &lowered::Tables) -> Option<Vec<encode_terms::Val>> {
        let mut terms: Vec<String> = Vec::new();
        let mut list: bool = false;
        match encode_terms::parse(c) {
            None => {},
            Some(sx) => { match &sx { encode_terms::Sexp::Atom(ca_a) => {}, encode_terms::Sexp::List(xs) => { list = true; for j in 0..xs.len() invariant 0 <= j && j <= xs.len(), { if j > 0 { terms.push(encode_terms::print(&xs[j], 100000)); } } }, } },
        }
        if !list {
            return None;
        }
        let mut pos: usize = 0;
        let mut out: Vec<encode_terms::Val> = Vec::new();
        for j in 0..tys.len()
            invariant 0 <= j && j <= tys.len(),
        {
            out.push(encode_terms::build(&tys[j], tb, terms.as_slice(), &mut pos, 100000));
        }
        Some(out)
    }

    #[summary("The rows of an executable or proof function d of unit, for `bmb dump smt` (the exec part of stage0 verify::dump_smt): an exec row with the declarations, the obligations that hold by their own text, whether the end of the body is unreachable, the path condition there, the entry values, the texts known valid, the validity functions defined and the reach points with their path conditions (recorded as under stage0 vacuous_ends); then an obl row per obligation")]
    #[effects(alloc)]
    fn dump_body(out: &mut String, pg: &encode_spec::Prog, path: &str, d: &ast::FnDef, unit: &str) -> () {
        let mut ex: Exec = new_exec(pg, path, unit);
        ex.reaching = true;
        if body::is_proof(d.kind) {
            ex.proof_body(d, pg);
        } else {
            ex.exec_body(d, pg);
        }
        encode_spec::push_row_head(out, "exec", path, &ex.enc);
        out.push_str(",\"dead\":");
        decls::push_bool(out, ex.dead);
        out.push_str(",\"pc\":");
        encode_decls::push_list(out, ex.enc.pc.as_slice());
        out.push_str(",\"inputs\":[");
        for i in 0..ex.inputs.len()
            invariant 0 <= i && i <= ex.inputs.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            encode_spec::push_shown(out, &ex.inputs[i]);
        }
        out.push_str("],\"texts\":[");
        for i in 0..ex.texts.len()
            invariant 0 <= i && i <= ex.texts.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            out.push_str("[");
            std::json::push_string(out, ex.texts[i].a.as_str());
            out.push_str(",");
            std::json::push_string(out, ex.texts[i].b.as_str());
            out.push_str("]");
        }
        out.push_str("],\"valid\":[");
        for i in 0..ex.valid_defs.len()
            invariant 0 <= i && i <= ex.valid_defs.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            encode_spec::push_part(out, &ex.valid_defs[i]);
        }
        out.push_str("],\"reach\":[");
        for i in 0..ex.reach.len()
            invariant 0 <= i && i <= ex.reach.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            out.push_str("[");
            std::num::push_u64(out, ex.reach[i].span.file as u64);
            out.push_str(",");
            std::num::push_u64(out, ex.reach[i].span.lo as u64);
            out.push_str(",");
            std::num::push_u64(out, ex.reach[i].span.hi as u64);
            out.push_str(",");
            std::json::push_string(out, ex.reach[i].what.as_str());
            out.push_str(",");
            encode_decls::push_list(out, ex.reach[i].pc.as_slice());
            out.push_str("]");
        }
        out.push_str("]}\n");
        encode_spec::push_obls(out, pg, path, ex.enc.obls.as_slice());
    }

    #[summary("The elements of array value v as a value to select from and store into (the split of stage0 Enc::vec_change and copy_within): the element array of an array of scalars, the leaf arrays of an array of aggregates. The unit value for a value that is no array, which the checker admits none of")]
    #[effects(alloc)]
    fn elems_of(v: &encode_terms::Val) -> encode_terms::Val {
        match v {
            encode_terms::Val::S(eov_s0) => encode_terms::Val::Unit,
            encode_terms::Val::A(elems, eo_len) => encode_terms::Val::S(elems.clone()),
            encode_terms::Val::Unit => encode_terms::Val::Unit,
            encode_terms::Val::Struct(eov_struct0) => encode_terms::Val::Unit,
            encode_terms::Val::Arr(elem, eo_alen) => (**elem).clone(),
        }
    }

    #[summary("Appends copies of xs to out")]
    #[effects(alloc)]
    fn extend(out: &mut Vec<String>, xs: &[String]) -> () {
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            out.push(xs[i].clone());
        }
    }

    #[summary("The head invariant of range `for` st at i (stage0 for_bounds): lo <= i && (i <= hi || i == lo); the second part also holds on entry to an empty range")]
    #[effects(alloc)]
    fn for_bounds(st: &ForStep, i: &str) -> String {
        types::cat5("(and ", encode_terms::ord_term(ast::BinOp::Le, &st.ty, st.lo.as_str(), i).as_str(), " (or ", encode_terms::ord_term(ast::BinOp::Le, &st.ty, i, st.hi.as_str()).as_str(), types::cat5(" (= ", i, " ", st.lo.as_str(), ")))").as_str())
    }

    #[summary("Whether a type as written is one whose length changes (stage0 growable): a Vec or a String, both an array and a length to the encoder")]
    #[effects(pure)]
    fn growable(t: &ast::TypeKind) -> bool {
        match t {
            ast::TypeKind::Int(grt_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => true,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(grt_array0, grt_array1) => false,
            ast::TypeKind::ArrayN(grt_arrayn0, grt_arrayn1) => false,
            ast::TypeKind::Slice(grt_slice0) => false,
            ast::TypeKind::Ref(grt_ref0, grt_ref1) => false,
            ast::TypeKind::Named(path, gr_args) => path.len() == 1 && (path[0] == "Vec" || path[0] == "String"),
            ast::TypeKind::Vec(gr_e) => true,
            ast::TypeKind::Box(grt_box0) => false,
            ast::TypeKind::Param(grt_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("Whether place expression e starts from a variable (stage0 root_var(e).is_some())")]
    #[effects(alloc)]
    fn has_root(e: &ast::Expr) -> bool {
        match root_var(e, 100000) {
            None => false,
            Some(r) => true,
        }
    }

    #[summary("The predicate instance of the invariant of t (stage0 invariants::inv_target): its path, or the instance key of a generic type's (the predicate's parameters are the type's, in order: E0254)")]
    #[effects(alloc)]
    fn inv_target(t: &ast::TypeKind, tb: &lowered::Tables) -> Option<String> {
        let vt: ast::TypeKind = lowered::value_ty(t);
        match encode_decls::inv_of(&vt, tb) {
            None => None,
            Some(p) => { let args: Vec<ast::TypeKind> = types::named_args(&vt); if args.len() == 0 { Some(p) } else { Some(body::inst_key(p.as_str(), args.as_slice())) } },
        }
    }

    #[summary("The last name of a path. Empty text for an empty path")]
    #[effects(alloc)]
    fn last_name(path: &[ast::Ident]) -> String {
        if path.len() > 0 {
            path[path.len() - 1].name.clone()
        } else {
            String::new()
        }
    }

    #[summary("The value of numeral v modulo 2^w as a number below it (stage0's rem_euclid for the bit-vector literal of an operand), w the width of an integer type: the low word of the magnitude, or of its two's complement for a negative value")]
    #[effects(pure)]
    fn low_bits(v: &encode_terms::Int, w: u32) -> u64 {
        if w >= 64 {
            if v.neg && v.mag.lo != 0 {
                return 18446744073709551615 - v.mag.lo + 1;
            }
            return v.mag.lo;
        }
        let size: u64 = if w == 8 {
            256
        } else if w == 16 {
            65536
        } else {
            4294967296
        };
        let m: u64 = v.mag.lo % size;
        if v.neg && m != 0 {
            size - m
        } else {
            m
        }
    }

    #[summary("Marks what passing or matching on a may assign (the argument and scrutinee tests of stage0 assigned_in_expr): the root of `&mut place`; a variable as `?name`, since a reference parameter passed on may be modified by the callee, until the loop knows which names are &mut parameters")]
    #[effects(alloc)]
    fn mark_passed(a: &ast::Expr, out: &mut table::Table<bool>) -> () {
        match &a.kind {
            ast::ExprKind::Int(mpa_int0, mpa_int1) => {},
            ast::ExprKind::Float(mpa_float0) => {},
            ast::ExprKind::ByteLit(mpa_bytelit0) => {},
            ast::ExprKind::ByteStr(mpa_bytestr0) => {},
            ast::ExprKind::StrLit(mpa_strlit0) => {},
            ast::ExprKind::CharLit(mpa_charlit0) => {},
            ast::ExprKind::Bool(mpa_bool0) => {},
            ast::ExprKind::Unit => {},
            ast::ExprKind::Var(id) => out.insert(types::cat2("?", id.name.as_str()).as_str(), true),
            ast::ExprKind::Call(mpa_call0) => {},
            ast::ExprKind::Method(mpa_method0) => {},
            ast::ExprKind::Index(mpa_index0, mpa_index1) => {},
            ast::ExprKind::Unary(mpa_unary0, mpa_unary1) => {},
            ast::ExprKind::Binary(mpa_binary0, mpa_binary1, mpa_binary2) => {},
            ast::ExprKind::Ref(m, rx) => { if *m { match root_var(&**rx, 100000) { None => {}, Some(r) => out.insert(r.as_str(), true), } } },
            ast::ExprKind::If(mpa_if0) => {},
            ast::ExprKind::Block(mpa_block0) => {},
            ast::ExprKind::Array(mpa_array0) => {},
            ast::ExprKind::Repeat(mpa_repeat0) => {},
            ast::ExprKind::Old(mpa_old0) => {},
            ast::ExprKind::Quant(mpa_quant0) => {},
            ast::ExprKind::Trigger(mpa_trigger0) => {},
            ast::ExprKind::Closure(mpa_closure0) => {},
            ast::ExprKind::StructLit(mpa_structlit0) => {},
            ast::ExprKind::Path(mpa_path0) => {},
            ast::ExprKind::Deref(mpa_deref0) => {},
            ast::ExprKind::Field(mpa_field0, mpa_field1) => {},
            ast::ExprKind::Match(mpa_match0) => {},
            ast::ExprKind::Return(mpa_return0) => {},
            ast::ExprKind::Try(mpa_try0) => {},
            ast::ExprKind::Loop(mpa_loop0) => {},
            ast::ExprKind::Break(mpa_break0) => {},
            ast::ExprKind::Continue(mpa_continue0) => {},
            ast::ExprKind::Range(mpa_range0) => {},
            ast::ExprKind::Error => {},
        }
    }

    #[summary("Whether t is a &mut reference")]
    #[effects(pure)]
    fn mut_ref(t: &ast::TypeKind) -> bool {
        match t {
            ast::TypeKind::Int(mrt_int0) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => false,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(mrt_array0, mrt_array1) => false,
            ast::TypeKind::ArrayN(mrt_arrayn0, mrt_arrayn1) => false,
            ast::TypeKind::Slice(mrt_slice0) => false,
            ast::TypeKind::Ref(m, mr_inner) => *m,
            ast::TypeKind::Named(mrt_named0, mrt_named1) => false,
            ast::TypeKind::Vec(mrt_vec0) => false,
            ast::TypeKind::Box(mrt_box0) => false,
            ast::TypeKind::Param(mrt_param0) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("The state of executable definition path of unit before anything is encoded (stage0 Enc::new): no reach points are recorded and every fact is trusted, as in a pass without escapes")]
    #[effects(alloc)]
    fn new_exec(pg: &encode_spec::Prog, path: &str, unit: &str) -> Exec {
        Exec { enc: encode_spec::new_enc(pg, path, unit), vars: table::new::<encode_terms::Val>(), var_rank: table::new::<usize>(), was: table::new::<encode_terms::Val>(), entry_measure: None, inputs: Vec::new(), dead: false, ghost: false, texts: Vec::new(), valid_decl: table::new::<bool>(), valid_depth: 0, valid_defs: Vec::new(), valid_memo: table::new::<bool>(), reaching: false, reach: Vec::new(), trust: None, loops: Vec::new() }
    }

    #[summary("The name of a type parameter, if t is one")]
    #[effects(alloc)]
    fn param_name(t: &ast::TypeKind) -> Option<String> {
        match t {
            ast::TypeKind::Int(pnt_int0) => None,
            ast::TypeKind::F64 => None,
            ast::TypeKind::Bool => None,
            ast::TypeKind::Unit => None,
            ast::TypeKind::Char => None,
            ast::TypeKind::String => None,
            ast::TypeKind::Str => None,
            ast::TypeKind::Array(pnt_array0, pnt_array1) => None,
            ast::TypeKind::ArrayN(pnt_arrayn0, pnt_arrayn1) => None,
            ast::TypeKind::Slice(pnt_slice0) => None,
            ast::TypeKind::Ref(pnt_ref0, pnt_ref1) => None,
            ast::TypeKind::Named(pnt_named0, pnt_named1) => None,
            ast::TypeKind::Vec(pnt_vec0) => None,
            ast::TypeKind::Box(pnt_box0) => None,
            ast::TypeKind::Param(n) => Some(n.clone()),
            ast::TypeKind::Never => None,
            ast::TypeKind::Error => None,
        }
    }

    #[summary("The parameter types of function path in the encoder's tables. None for a path the tables lack")]
    #[effects(alloc)]
    fn params_of(pg: &encode_spec::Prog, path: &str) -> Vec<ast::TypeKind> {
        match pg.pr.t.fns.find(path) {
            None => Vec::new(),
            Some(at) => pg.pr.t.fns.items[at].params.clone(),
        }
    }

    #[summary("A contract clause in a message (stage0 pred_name, ADR-0095 A2): the predicate's name, or the clause's own text when it is an expression. A function value's contract reads as it was written, f.requires(x) (ADR-0053)")]
    #[effects(alloc)]
    fn pred_name(e: &ast::Expr) -> String {
        let path: Vec<ast::Ident> = match encode_decls::call_path(e) {
            None => { return fmt::expr_text(e); },
            Some(p) => p,
        };
        let n: usize = path.len();
        if n >= 2 && moves::starts_with(path[n - 2].name.as_str(), "__fn$") && (path[n - 1].name == "pre" || path[n - 1].name == "post") {
            match body::call_of(e) {
                None => {},
                Some(c) => { if c.args.len() > 0 { let recv: String = fmt::expr_text(&c.args[0]); let mut lead: usize = 0; for i in 0..recv.len() invariant 0 <= i && i <= recv.len(), { if lead == i && recv.as_bytes()[i] == 38 { lead = i + 1; } } let mut rest: Vec<String> = Vec::new(); for i in 0..c.args.len() invariant 0 <= i && i <= c.args.len(), { if i > 0 { rest.push(fmt::expr_text(&c.args[i])); } } let which: String = if path[n - 1].name == "pre" { String::from("requires") } else { String::from("ensures") }; return types::cat5(lexer::cut(recv.as_str(), lead, recv.len()).as_str(), ".", which.as_str(), "(", types::cat2(encode_terms::join(rest.as_slice(), ", ").as_str(), ")").as_str()); } },
            }
        }
        let mut names: Vec<String> = Vec::new();
        for i in 0..path.len()
            invariant 0 <= i && i <= path.len(),
        {
            names.push(path[i].name.clone());
        }
        encode_terms::join(names.as_slice(), "::")
    }

    #[summary("Whether t is a datatype (an enum, or a struct that holds itself through structs) that holds itself (stage0 Prog::rec_valid): its validity is a function")]
    #[effects(alloc)]
    fn rec_valid(t: &ast::TypeKind, tb: &lowered::Tables) -> bool {
        let vt: ast::TypeKind = lowered::value_ty(t);
        let is_enum: bool = match lowered::enum_variants(&vt, tb) {
            None => false,
            Some(vs) => true,
        };
        if !encode_decls::dt_struct(&vt, tb) && !is_enum {
            return false;
        }
        let me: String = types::text(&vt);
        let mut seen: table::Table<bool> = table::new::<bool>();
        let mut todo: Vec<ast::TypeKind> = encode_decls::holds(&vt, tb);
        let mut fuel: usize = 1000000000;
        while todo.len() > 0 && fuel > 0
            decreases fuel,
        {
            fuel = fuel - 1;
            match todo.pop() {
                None => {},
                Some(u) => { if types::text(&lowered::value_ty(&u)) == me { return true; } let k: String = types::text(&u); if !seen.has(k.as_str()) { seen.insert(k.as_str(), true); let more: Vec<ast::TypeKind> = encode_decls::holds(&u, tb); body::push_all(&mut todo, more.as_slice()); } },
            }
        }
        false
    }

    #[summary("Whether m is a method that changes its receiver (stage0 check::RECEIVER_MUT_METHODS): a loop havocs the receiver of one")]
    #[effects(pure)]
    fn receiver_mut(m: &str) -> bool {
        m == "push" || m == "pop" || m == "truncate" || m == "as_mut_slice" || m == "copy_within" || m == "push_str"
    }

    #[summary("The result type of function path in the encoder's tables. The error type for a path the tables lack")]
    #[effects(alloc)]
    fn ret_of(pg: &encode_spec::Prog, path: &str) -> ast::TypeKind {
        match pg.pr.t.fns.find(path) {
            None => ast::TypeKind::Error,
            Some(at) => pg.pr.t.fns.items[at].ret.clone(),
        }
    }

    #[summary("The locals of vars that base also has (stage0's retain at a join one side of which returned): the names that side bound end with it")]
    #[effects(alloc)]
    fn retain(vars: &table::Table<encode_terms::Val>, base: &table::Table<encode_terms::Val>) -> table::Table<encode_terms::Val> {
        let mut out: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
        for n in 0..vars.len()
            invariant 0 <= n,
        {
            match vars.nth(n) {
                None => {},
                Some(at) => { let k: String = vars.key(n); if base.has(k.as_str()) { out.insert(k.as_str(), vars.items[at].clone()); } },
            }
        }
        out
    }

    #[summary("The variable a place expression starts from (stage0 root_var): through &, *, fields, elements and the as_slice and as_mut_slice of a Vec. None for another expression")]
    #[effects(alloc)]
    fn root_var(e: &ast::Expr, f: usize) -> Option<String>
        decreases f,
    {
        if f == 0 {
            return None;
        }
        match &e.kind {
            ast::ExprKind::Int(rve_int0, rve_int1) => None,
            ast::ExprKind::Float(rve_float0) => None,
            ast::ExprKind::ByteLit(rve_bytelit0) => None,
            ast::ExprKind::ByteStr(rve_bytestr0) => None,
            ast::ExprKind::StrLit(rve_strlit0) => None,
            ast::ExprKind::CharLit(rve_charlit0) => None,
            ast::ExprKind::Bool(rve_bool0) => None,
            ast::ExprKind::Unit => None,
            ast::ExprKind::Var(id) => Some(id.name.clone()),
            ast::ExprKind::Call(rve_call0) => None,
            ast::ExprKind::Method(mc) => { if mc.name.name == "as_mut_slice" || mc.name.name == "as_slice" { root_var(&*mc.recv, f - 1) } else { None } },
            ast::ExprKind::Index(ib, ii) => root_var(&**ib, f - 1),
            ast::ExprKind::Unary(rve_unary0, rve_unary1) => None,
            ast::ExprKind::Binary(rve_binary0, rve_binary1, rve_binary2) => None,
            ast::ExprKind::Ref(rv_m, rx) => root_var(&**rx, f - 1),
            ast::ExprKind::If(rve_if0) => None,
            ast::ExprKind::Block(rve_block0) => None,
            ast::ExprKind::Array(rve_array0) => None,
            ast::ExprKind::Repeat(rve_repeat0) => None,
            ast::ExprKind::Old(rve_old0) => None,
            ast::ExprKind::Quant(rve_quant0) => None,
            ast::ExprKind::Trigger(rve_trigger0) => None,
            ast::ExprKind::Closure(rve_closure0) => None,
            ast::ExprKind::StructLit(rve_structlit0) => None,
            ast::ExprKind::Path(rve_path0) => None,
            ast::ExprKind::Deref(dx) => root_var(&**dx, f - 1),
            ast::ExprKind::Field(fb, fname) => root_var(&**fb, f - 1),
            ast::ExprKind::Match(rve_match0) => None,
            ast::ExprKind::Return(rve_return0) => None,
            ast::ExprKind::Try(rve_try0) => None,
            ast::ExprKind::Loop(rve_loop0) => None,
            ast::ExprKind::Break(rve_break0) => None,
            ast::ExprKind::Continue(rve_continue0) => None,
            ast::ExprKind::Range(rve_range0) => None,
            ast::ExprKind::Error => None,
        }
    }

    #[summary("Whether two values are the same, leaf by leaf (stage0's == on Val)")]
    #[effects(pure)]
    fn same_val(a: &encode_terms::Val, b: &encode_terms::Val, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match a {
            encode_terms::Val::S(x) => match b { encode_terms::Val::S(y) => x.as_str() == y.as_str(), encode_terms::Val::A(sbv_a0, sbv_a1) => false, encode_terms::Val::Unit => false, encode_terms::Val::Struct(sbv_struct0) => false, encode_terms::Val::Arr(sbv_arr0, sbv_arr1) => false, },
            encode_terms::Val::A(e1, l1) => match b { encode_terms::Val::S(scv_s0) => false, encode_terms::Val::A(e2, l2) => e1.as_str() == e2.as_str() && l1.as_str() == l2.as_str(), encode_terms::Val::Unit => false, encode_terms::Val::Struct(scv_struct0) => false, encode_terms::Val::Arr(scv_arr0, scv_arr1) => false, },
            encode_terms::Val::Unit => match b { encode_terms::Val::S(sdv_s0) => false, encode_terms::Val::A(sdv_a0, sdv_a1) => false, encode_terms::Val::Unit => true, encode_terms::Val::Struct(sdv_struct0) => false, encode_terms::Val::Arr(sdv_arr0, sdv_arr1) => false, },
            encode_terms::Val::Struct(xs) => match b { encode_terms::Val::S(sev_s0) => false, encode_terms::Val::A(sev_a0, sev_a1) => false, encode_terms::Val::Unit => false, encode_terms::Val::Struct(ys) => { if xs.len() != ys.len() { return false; } for i in 0..xs.len() invariant 0 <= i && i <= xs.len(), { if i < ys.len() && !same_val(&xs[i], &ys[i], f - 1) { return false; } } true }, encode_terms::Val::Arr(sev_arr0, sev_arr1) => false, },
            encode_terms::Val::Arr(xe, xl) => match b { encode_terms::Val::S(sfv_s0) => false, encode_terms::Val::A(sfv_a0, sfv_a1) => false, encode_terms::Val::Unit => false, encode_terms::Val::Struct(sfv_struct0) => false, encode_terms::Val::Arr(ye, yl) => xl.as_str() == yl.as_str() && same_val(&**xe, &**ye, f - 1), },
        }
    }

    #[summary("The size of a term in atoms (the size of stage0 Enc::merge): the runs of characters between parentheses and whitespace")]
    #[effects(pure)]
    fn size(term: &str) -> usize {
        let mut n: usize = 0;
        let mut inside: bool = false;
        for i in 0..term.len()
            invariant 0 <= i && i <= term.len(),
        {
            let c: u8 = term.as_bytes()[i];
            let sep: bool = c == 40 || c == 41 || c == 32 || c >= 9 && c <= 13;
            if !sep && !inside {
                n = n.saturating_add(1);
            }
            inside = !sep;
        }
        n
    }

    #[summary("The value of a term that is a plain decimal numeral within 64 bits (stage0's parse::<u64> of a bound of copy_within). None for any other term")]
    #[effects(pure)]
    fn small(t: &str) -> Option<u64> {
        if t.len() == 0 {
            return None;
        }
        let mut v: u64 = 0;
        for i in 0..t.len()
            invariant 0 <= i && i <= t.len(),
        {
            let c: u8 = t.as_bytes()[i];
            if c < 48 || c > 57 {
                return None;
            }
            let d: u64 = (c - 48) as u64;
            if v > (18446744073709551615 - d) / 10 {
                return None;
            }
            v = v * 10 + d;
        }
        Some(v)
    }

    #[summary("Whether a type as written is a Vec or a String, or a reference to one (the surface of stage0 Enc::is_vec_local)")]
    #[effects(alloc)]
    fn surface(t: &ast::TypeKind, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match body::ref_inner(t) {
            None => growable(t),
            Some(inner) => surface(&inner, f - 1),
        }
    }

    #[summary("The elements of xs from position from on")]
    #[effects(alloc)]
    fn tail(xs: &[String], from: usize) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if i >= from {
                out.push(xs[i].clone());
            }
        }
        out
    }

    #[summary("Whether parameter i of function path is text (stage0 Enc::text_at with Some(i))")]
    #[effects(pure)]
    fn text_at(pg: &encode_spec::Prog, path: &str, i: usize) -> bool {
        match pg.pr.text_sigs.find(path) {
            None => false,
            Some(at) => { if i < pg.pr.text_sigs.items[at].params.len() { pg.pr.text_sigs.items[at].params[i] } else { false } },
        }
    }

    #[summary("x < y on text given the longest common prefix p of both (the lt and gt of stage0 Enc::text_cmp_code): x ends at p and y is longer, or both go on (both, p below either length) and the byte of x at p, xp, is below that of y, yp")]
    #[effects(alloc)]
    fn text_less(p: &str, x: &str, y: &str, both: &str, xp: &str, yp: &str) -> String {
        types::cat7("(or (and (= ", p, " ", x, ") (< ", x, types::cat7(" ", y, ")) (and ", both, " (< ", xp, types::cat3(" ", yp, ")))").as_str()).as_str())
    }

    #[summary("Whether the result of function path is text (stage0 Enc::text_at with None)")]
    #[effects(pure)]
    fn text_ret(pg: &encode_spec::Prog, path: &str) -> bool {
        match pg.pr.text_sigs.find(path) {
            None => false,
            Some(at) => pg.pr.text_sigs.items[at].ret,
        }
    }

    #[summary("The four bytes push(c) stores for a constant c that is a Unicode scalar value (the constant case of stage0 Enc::text_change): its UTF-8 encoding, 0 where it has fewer bytes. None for a term that is no such constant")]
    #[effects(alloc)]
    fn utf8_const(c: &str) -> Option<Vec<String>> {
        let v: encode_terms::Int = match encode_terms::numeral(c) {
            None => { return None; },
            Some(found) => found,
        };
        let zero: bool = v.mag.hi == 0 && v.mag.lo == 0;
        if v.neg && !zero || v.mag.hi != 0 {
            return None;
        }
        let x: u64 = v.mag.lo;
        if x > 1114111 || x >= 55296 && x <= 57343 {
            return None;
        }
        let mut out: Vec<String> = Vec::new();
        if x < 128 {
            out.push(encode_terms::dec(x));
            out.push(String::from("0"));
            out.push(String::from("0"));
            out.push(String::from("0"));
        } else if x < 2048 {
            out.push(encode_terms::dec(192 + x / 64));
            out.push(encode_terms::dec(128 + x % 64));
            out.push(String::from("0"));
            out.push(String::from("0"));
        } else if x < 65536 {
            out.push(encode_terms::dec(224 + x / 4096));
            out.push(encode_terms::dec(128 + x / 64 % 64));
            out.push(encode_terms::dec(128 + x % 64));
            out.push(String::from("0"));
        } else {
            out.push(encode_terms::dec(240 + x / 262144));
            out.push(encode_terms::dec(128 + x / 4096 % 64));
            out.push(encode_terms::dec(128 + x / 64 % 64));
            out.push(encode_terms::dec(128 + x % 64));
        }
        Some(out)
    }

    #[summary("The value of local k. The unit value for a name that is not bound, which the checker admits none of")]
    #[effects(alloc)]
    fn var_of(vars: &table::Table<encode_terms::Val>, k: &str) -> encode_terms::Val {
        match vars.find(k) {
            None => encode_terms::Val::Unit,
            Some(at) => vars.items[at].clone(),
        }
    }

    #[summary("The locals of vars except name (stage0's remove of a `for`'s variable after its loop)")]
    #[effects(alloc)]
    fn without(vars: &table::Table<encode_terms::Val>, name: &str) -> table::Table<encode_terms::Val> {
        let mut out: table::Table<encode_terms::Val> = table::new::<encode_terms::Val>();
        for n in 0..vars.len()
            invariant 0 <= n,
        {
            match vars.nth(n) {
                None => {},
                Some(at) => { let k: String = vars.key(n); if k.as_str() != name { out.insert(k.as_str(), vars.items[at].clone()); } },
            }
        }
        out
    }
}
