#[summary("Normal form printer: one text per program (ADR-0019) (port of stage0 compiler/src/fmt.rs). There are three ways of writing names (Names): as written, qualified text that writes other definitions by full path (ADR-0019 §2), identity text with names erased (ADR-0059 §1, identity computes the hash). f is the remaining depth")]
mod fmt {
    #[summary("What a call path refers to in identity text: a definition (full path), the k-th variant of an enum (full path), a built-in")]
    enum Callee { Def(String), Variant(String, usize), Plain }

    #[summary("The item at path path and one position (position in the table of types, declaration position of a variant or field)")]
    struct Found { path: String, at: usize }

    #[summary("Repeat count written as the name of a const: position of the count and that name")]
    struct LenName { file: u32, lo: u32, hi: u32, name: String }

    #[summary("Ways of writing names: as written, qualified (other definitions by full path), identity reference collection (records a key per reference and writes #?), identity (references as the text of table refs)")]
    enum Mode { Plain, Qualify, Collect, Identity }

    #[summary("What the printer uses to resolve names. Qualified and identity read the checker's tables (fns, adts, expression types types) and unit, the unit of the definition being printed. Identity additionally holds the full paths of traits traits, the reference texts refs (the key is the kind digit 0 definition·1 type·2 trait, a colon, the full path), the collected keys seen, and the slots of bound names (binders: from name to _k, labels: from label to _k). A binding name is unique within a function (E0303), so one table holds the whole definition")]
    struct Names { mode: Mode, unit: String, fns: table::Table<types::FnSig>, adts: table::Table<types::Adt>, types: table::Table<ast::TypeKind>, traits: Vec<String>, refs: table::Table<RefRow>, seen: Vec<String>, binders: table::Table<String>, labels: table::Table<String>, next: usize, next_label: usize }

    struct Printer { out: String, lens: Vec<LenName>, names: Names }

    impl Printer {
        #[summary("Declared struct or enum that the expression at position span has: full path and position in table adts. References and Box are stripped")]
        #[effects(alloc)]
        fn adt_at(self: &Printer, span: source::Span) -> Option<Found> {
            let at: usize = match self.names.types.find(body::span_key(span).as_str()) {
                None => { return None; },
                Some(i) => i,
            };
            let full: String = peeled(&self.names.types.items[at], 100000);
            if full.len() == 0 {
                return None;
            }
            match self.names.adts.find(full.as_str()) {
                None => None,
                Some(k) => Some(Found { path: full, at: k }),
            }
        }

        #[summary("Type name of this unit with arguments attached (head of an impl)")]
        #[effects(alloc)]
        fn applied_ty(self: &mut Printer, name: &str, args: &[ast::Type]) -> String {
            let mut s: String = String::new();
            if self.is_id() {
                let mut one: Vec<String> = Vec::new();
                one.push(String::from(name));
                s = self.type_ref(one.as_slice());
            } else {
                s.push_str(name);
            }
            if args.len() > 0 {
                s.push_str("<");
                let mut i: usize = 0;
                while i < args.len()
                    decreases args.len() - i,
                {
                    if i > 0 {
                        s.push_str(", ");
                    }
                    s.push_str(self.ty(&args[i]).as_str());
                    i = i + 1;
                }
                s.push_str(">");
            }
            s
        }

        #[effects(alloc)]
        fn attr_line(self: &mut Printer, a: &ast::Attr, depth: usize) -> () {
            if a.name.name == "summary" {
                return;
            }
            let mut row: String = String::from("#[");
            row.push_str(a.name.name.as_str());
            row.push_str("(");
            if a.name.name == "invariant" {
                let mut i: usize = 0;
                while i < a.args.len()
                    decreases a.args.len() - i,
                {
                    if i > 0 {
                        row.push_str(", ");
                    }
                    match &a.args[i] {
                        ast::AttrArg::Ident(id) => row.push_str(self.uses_name(id.name.as_str()).as_str()),
                        ast::AttrArg::Str(s, sp) => row.push_str(attr_arg(&a.args[i], 100).as_str()),
                        ast::AttrArg::Pair(pk, pv) => row.push_str(attr_arg(&a.args[i], 100).as_str()),
                    }
                    i = i + 1;
                }
            } else {
                row.push_str(attr_args(a.args.as_slice()).as_str());
            }
            row.push_str(")]");
            self.line(depth, row.as_str());
        }

        #[summary("Binds name name (parameter, local variable, type parameter, ..): in identity text, the bound slot _k")]
        #[effects(alloc)]
        fn bind(self: &mut Printer, name: &str) -> String {
            if !self.is_id() {
                return String::from(name);
            }
            let mut b: String = String::from("_");
            push_n(&mut b, self.names.next);
            self.names.next = self.names.next.saturating_add(1);
            self.names.binders.insert(name, b.clone());
            b
        }

        #[summary("Binds label name: in identity text, the bound slot _k")]
        #[effects(alloc)]
        fn bind_label(self: &mut Printer, name: &str) -> String {
            if !self.is_id() {
                return String::from(name);
            }
            let mut b: String = String::from("_");
            push_n(&mut b, self.names.next_label);
            self.names.next_label = self.names.next_label.saturating_add(1);
            self.names.labels.insert(name, b.clone());
            b
        }

        #[summary("Prints prefix{ ... }suffix, with the block's contents indented")]
        #[effects(alloc)]
        fn block_open(self: &mut Printer, b: &ast::Block, depth: usize, prefix: &str, suffix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut head: String = String::from(prefix);
            if b.stmts.len() == 0 && !is_some_box(&b.tail) {
                head.push_str("{}");
                head.push_str(suffix);
                self.line(depth, head.as_str());
                return;
            }
            head.push_str("{");
            self.line(depth, head.as_str());
            let mut i: usize = 0;
            while i < b.stmts.len()
                decreases b.stmts.len() - i,
            {
                self.stmt(&b.stmts[i], depth.saturating_add(1), f - 1);
                i = i + 1;
            }
            match &b.tail {
                None => {},
                Some(t) => self.expr_stmt(&**t, depth.saturating_add(1), "", f - 1),
            }
            let mut close: String = String::from("}");
            close.push_str(suffix);
            self.line(depth, close.as_str());
        }

        #[summary("Trait bound b: declared traits as references, Copy·Eq·Ord by name")]
        #[effects(alloc)]
        fn bound(self: &mut Printer, b: &[ast::Ident]) -> String {
            let plain: String = path_str(b);
            let local: String = types::cat3(self.names.unit.as_str(), "::", plain.as_str());
            if b.len() == 1 && types::has(self.names.traits.as_slice(), local.as_str()) {
                self.entity("2", local.as_str())
            } else if types::has(self.names.traits.as_slice(), plain.as_str()) {
                self.entity("2", plain.as_str())
            } else {
                plain
            }
        }

        #[effects(alloc)]
        fn call_text(self: &mut Printer, ca: &ast::Call, span: source::Span, f: usize) -> String
            decreases f,
        {
            let mut s: String = String::new();
            if f == 0 {
                return s;
            }
            if self.is_id() {
                let a: String = self.exprs(ca.args.as_slice(), f - 1);
                let mut ts: String = String::new();
                let mut n: usize = 0;
                while n < ca.targs.len()
                    decreases ca.targs.len() - n,
                {
                    ts.push_str("::[");
                    push_n(&mut ts, ca.path.len().saturating_sub(1).saturating_sub(ca.targs[n].seg));
                    ts.push_str("]<");
                    let mut j: usize = 0;
                    while j < ca.targs[n].args.len()
                        decreases ca.targs[n].args.len() - j,
                    {
                        if j > 0 {
                            ts.push_str(", ");
                        }
                        ts.push_str(self.ty(&ca.targs[n].args[j]).as_str());
                        j = j + 1;
                    }
                    ts.push_str(">");
                    n = n + 1;
                }
                s = match self.callee(ca.path.as_slice(), span) {
                    Callee::Def(p) => self.def_ref(p.as_str()),
                    Callee::Variant(tp, k) => self.variant_ref(tp.as_str(), k),
                    Callee::Plain => path_str(ca.path.as_slice()),
                };
                s.push_str(ts.as_str());
                s.push_str("(");
                s.push_str(a.as_str());
                s.push_str(")");
                return s;
            }
            let mut written: bool = false;
            let mut by_ref: bool = false;
            let mut as_str: bool = false;
            match &ca.method {
                None => {},
                Some(adj) => { written = ca.args.len() > 0; match adj { ast::Adjust::Value => {}, ast::Adjust::Ref => { by_ref = true; }, ast::Adjust::RefMut => { by_ref = true; }, ast::Adjust::AsStr => { as_str = true; }, } },
            }
            if written && ca.path.len() > 0 {
                s.push_str(self.recv_text(&ca.args[0], by_ref, as_str, f - 1).as_str());
                s.push_str(".");
                s.push_str(ca.path[ca.path.len() - 1].name.as_str());
                s.push_str("(");
                let mut i: usize = 1;
                while i < ca.args.len()
                    decreases ca.args.len() - i,
                {
                    if i > 1 {
                        s.push_str(", ");
                    }
                    s.push_str(self.expr(&ca.args[i], 0, f - 1).as_str());
                    i = i + 1;
                }
                s.push_str(")");
                return s;
            }
            if self.qualified(ca.path.as_slice()) {
                s.push_str(self.names.unit.as_str());
                s.push_str("::");
            }
            let mut k: usize = 0;
            while k < ca.path.len()
                decreases ca.path.len() - k,
            {
                if k > 0 {
                    s.push_str("::");
                }
                s.push_str(ca.path[k].name.as_str());
                let mut t: usize = 0;
                while t < ca.targs.len()
                    decreases ca.targs.len() - t,
                {
                    if ca.targs[t].seg == k {
                        s.push_str("::<");
                        s.push_str(types_str(ca.targs[t].args.as_slice()).as_str());
                        s.push_str(">");
                    }
                    t = t + 1;
                }
                k = k + 1;
            }
            s.push_str("(");
            s.push_str(self.exprs(ca.args.as_slice(), f - 1).as_str());
            s.push_str(")");
            s
        }

        #[summary("What call path path refers to, as the checker resolves it: this unit's f, T::f, Trait::f, a full path, otherwise a variant of the call's enum type")]
        #[effects(alloc)]
        fn callee(self: &Printer, path: &[ast::Ident], span: source::Span) -> Callee {
            let plain: String = path_str(path);
            if path.len() <= 2 {
                let local: String = types::cat3(self.names.unit.as_str(), "::", plain.as_str());
                match self.names.fns.find(local.as_str()) {
                    None => {},
                    Some(at) => { if !self.names.fns.items[at].builtin && (path.len() == 1 || self.names.fns.items[at].in_impl || is_some_text(&self.names.fns.items[at].trait_of)) { return Callee::Def(local); } },
                }
            }
            match self.names.fns.find(plain.as_str()) {
                None => {},
                Some(at) => { if !self.names.fns.items[at].builtin { return Callee::Def(plain); } },
            }
            if path.len() == 0 {
                return Callee::Plain;
            }
            match self.variant_at(span, path[path.len() - 1].name.as_str()) {
                None => Callee::Plain,
                Some(v) => Callee::Variant(v.path, v.at),
            }
        }

        #[summary("Text of the x of the integer conversion T::try_from(x).unwrap() printed at CAST precedence")]
        #[effects(alloc)]
        fn cast_operand(self: &mut Printer, recv: &ast::Expr, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            match &recv.kind {
                ast::ExprKind::Int(iv, ir) => String::new(),
                ast::ExprKind::Float(fb) => String::new(),
                ast::ExprKind::ByteLit(by) => String::new(),
                ast::ExprKind::ByteStr(bys) => String::new(),
                ast::ExprKind::StrLit(st) => String::new(),
                ast::ExprKind::CharLit(ch) => String::new(),
                ast::ExprKind::Bool(bo) => String::new(),
                ast::ExprKind::Unit => String::new(),
                ast::ExprKind::Var(id) => String::new(),
                ast::ExprKind::Call(ca) => { if ca.args.len() == 1 { self.expr(&ca.args[0], 11, f - 1) } else { String::new() } },
                ast::ExprKind::Method(me) => String::new(),
                ast::ExprKind::Index(ib, ii) => String::new(),
                ast::ExprKind::Unary(uo, ux) => String::new(),
                ast::ExprKind::Binary(bop, bl, br) => String::new(),
                ast::ExprKind::Ref(rm, rx) => String::new(),
                ast::ExprKind::If(ife) => String::new(),
                ast::ExprKind::Block(blk) => String::new(),
                ast::ExprKind::Array(ar) => String::new(),
                ast::ExprKind::Repeat(rp) => String::new(),
                ast::ExprKind::Old(ox) => String::new(),
                ast::ExprKind::Quant(qu) => String::new(),
                ast::ExprKind::Trigger(tx) => String::new(),
                ast::ExprKind::Closure(cl) => String::new(),
                ast::ExprKind::StructLit(sl) => String::new(),
                ast::ExprKind::Path(pa) => String::new(),
                ast::ExprKind::Deref(dx) => String::new(),
                ast::ExprKind::Field(fx, fnm) => String::new(),
                ast::ExprKind::Match(ma) => String::new(),
                ast::ExprKind::Return(rv) => String::new(),
                ast::ExprKind::Try(tr) => String::new(),
                ast::ExprKind::Loop(lp) => String::new(),
                ast::ExprKind::Break(bk) => String::new(),
                ast::ExprKind::Continue(co) => String::new(),
                ast::ExprKind::Range(rg) => String::new(),
                ast::ExprKind::Error => String::new(),
            }
        }

        #[summary("kw and comma-joined expressions, with a trailing comma. Writes nothing if there are no expressions")]
        #[effects(alloc)]
        fn clause_line(self: &mut Printer, kw: &str, items: &[ast::Expr], depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 || items.len() == 0 {
                return;
            }
            let mut row: String = String::from(kw);
            row.push_str(self.exprs(items, f - 1).as_str());
            row.push_str(",");
            self.line(depth, row.as_str());
        }

        #[effects(alloc)]
        fn clauses(self: &mut Printer, d: &ast::FnDef, depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            self.clause_line("requires ", d.pre.as_slice(), depth.saturating_add(1), f - 1);
            self.clause_line("ensures ", d.post.as_slice(), depth.saturating_add(1), f - 1);
            match &d.measure {
                None => {},
                Some(m) => { let mut row: String = String::from("decreases "); row.push_str(self.expr(m, 0, f - 1).as_str()); row.push_str(","); self.line(depth.saturating_add(1), row.as_str()); },
            }
        }

        #[summary("move |x: T| -> (r: R) requires P, ensures Q, { .. } on one line (ADR-0053 §1)")]
        #[effects(alloc)]
        fn closure_text(self: &mut Printer, c: &ast::Closure, f: usize) -> String
            decreases f,
        {
            let mut head: String = String::new();
            if f == 0 {
                return head;
            }
            if c.is_move {
                head.push_str("move ");
            }
            head.push_str("|");
            head.push_str(self.params_text(c.params.as_slice(), false).as_str());
            head.push_str("| -> ");
            head.push_str(self.ret_text(&c.ret, false).as_str());
            if c.pre.len() > 0 {
                head.push_str(" requires ");
                head.push_str(self.exprs(c.pre.as_slice(), f - 1).as_str());
                head.push_str(",");
            }
            if c.post.len() > 0 {
                head.push_str(" ensures ");
                head.push_str(self.exprs(c.post.as_slice(), f - 1).as_str());
                head.push_str(",");
            }
            let saved: String = std::mem::replace(&mut self.out, String::new());
            self.block_open(&c.body, 0, "", "", f - 1);
            let body: String = std::mem::replace(&mut self.out, saved);
            head.push_str(" ");
            head.push_str(joined_lines(body.as_str()).as_str());
            head
        }

        #[summary("Whether references are being collected")]
        #[effects(pure)]
        fn collecting(self: &Printer) -> bool {
            match &self.names.mode {
                Mode::Plain => false,
                Mode::Qualify => false,
                Mode::Collect => true,
                Mode::Identity => false,
            }
        }

        #[summary("Condition or match scrutinee: parenthesized if it contains a struct expression (Rust does not accept an unparenthesized one there)")]
        #[effects(alloc)]
        fn cond(self: &mut Printer, e: &ast::Expr, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            let s: String = self.expr(e, 0, f - 1);
            if has_struct_lit(e, f - 1) {
                paren(s.as_str())
            } else {
                s
            }
        }

        #[summary("The name if the count is written as the name of a const, otherwise the number")]
        #[effects(alloc)]
        #[uses(wide::divisor)]
        fn count_text(self: &Printer, rp: &ast::Repeat) -> String {
            let mut i: usize = self.lens.len();
            while i > 0
                invariant i <= self.lens.len(),
                decreases i,
            {
                i = i - 1;
                if self.lens[i].file == rp.count_span.file && self.lens[i].lo == rp.count_span.lo && self.lens[i].hi == rp.count_span.hi {
                    return self.lens[i].name.clone();
                }
            }
            let mut s: String = String::new();
            wide::push_radix(&mut s, rp.count, 10);
            s
        }

        #[summary("Reference of the function, spec fn, or trait method at path path")]
        #[effects(alloc)]
        fn def_ref(self: &mut Printer, path: &str) -> String {
            let tr: Option<String> = match self.names.fns.find(path) {
                None => None,
                Some(at) => self.names.fns.items[at].trait_of.clone(),
            };
            match tr {
                None => self.entity("0", path),
                Some(t) => self.method_ref(t.as_str(), last_seg(path).as_str()),
            }
        }

        #[summary("Reference of the item of kind kind (0 definition, 1 type, 2 trait) and full path path: when collecting, records the key and writes #?, otherwise the text of table refs, and if not in the table (never so in a checked program) #? and the path")]
        #[effects(alloc)]
        fn entity(self: &mut Printer, kind: &str, path: &str) -> String {
            let key: String = types::cat3(kind, ":", path);
            if self.collecting() {
                if !types::has(self.names.seen.as_slice(), key.as_str()) {
                    self.names.seen.push(key.clone());
                }
                return String::from("#?");
            }
            match self.names.refs.find(key.as_str()) {
                None => types::cat3("#?", path, ""),
                Some(at) => self.names.refs.items[at].text.clone(),
            }
        }

        #[summary("Prints e. Parenthesized if its precedence is lower than min")]
        #[effects(alloc)]
        fn expr(self: &mut Printer, e: &ast::Expr, min: u8, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            let s: String = self.expr_raw(e, f - 1);
            let p: u8 = prec(e);
            if p < min || p == 0 && min > 0 {
                paren(s.as_str())
            } else {
                s
            }
        }

        #[effects(alloc)]
        fn expr_raw(self: &mut Printer, e: &ast::Expr, f: usize) -> String
            decreases f,
        {
            let mut s: String = String::new();
            if f == 0 {
                return s;
            }
            match &e.kind {
                ast::ExprKind::Int(iv, ir) => { s = ast::radix_text(radix_copy(ir), *iv); },
                ast::ExprKind::Float(fb) => { s = lexer::float_text(*fb); },
                ast::ExprKind::ByteLit(by) => { let mut one: Vec<u8> = Vec::new(); one.push(*by); s = lexer::byte_text(one.as_slice(), 39); },
                ast::ExprKind::ByteStr(bys) => { s = lexer::byte_text(bys.as_slice(), 34); },
                ast::ExprKind::StrLit(st) => { s = lexer::str_text(st.as_str(), 34); },
                ast::ExprKind::CharLit(ch) => { let mut cs: String = String::new(); match char::from_u32(*ch) { None => cs.push('\0'), Some(c) => cs.push(c), } s = lexer::str_text(cs.as_str(), 39); },
                ast::ExprKind::Bool(bo) => { if *bo { s.push_str("true"); } else { s.push_str("false"); } },
                ast::ExprKind::Unit => s.push_str("()"),
                ast::ExprKind::Var(id) => { s = self.local(id.name.as_str()); },
                ast::ExprKind::Call(ca) => { s = self.call_text(ca, e.span, f - 1); },
                ast::ExprKind::Method(me) => { if is_cast(me) && !self.is_id() { s = self.cast_operand(&*me.recv, f - 1); s.push_str(" as "); s.push_str(cast_name(&*me.recv).as_str()); } else { s = self.expr(&*me.recv, 13, f - 1); s.push_str("."); s.push_str(me.name.name.as_str()); s.push_str("("); s.push_str(self.exprs(me.args.as_slice(), f - 1).as_str()); s.push_str(")"); } },
                ast::ExprKind::Index(ib, ii) => { s = self.expr(&**ib, 13, f - 1); s.push_str("["); s.push_str(self.expr(&**ii, 0, f - 1).as_str()); s.push_str("]"); },
                ast::ExprKind::Unary(uo, ux) => { match uo { ast::UnOp::Neg => s.push_str("-"), ast::UnOp::Not => s.push_str("!"), } s.push_str(self.expr(&**ux, 12, f - 1).as_str()); },
                ast::ExprKind::Binary(bop, bl, br) => { let p: u8 = bin_prec(bop); let mut lm: u8 = p; let mut rm2: u8 = p + 1; if p == 1 { lm = p + 1; rm2 = p; } else if p == 4 { lm = p + 1; } if splits_cast(bop) && prec(&**bl) == 11 { lm = 13; } s = self.expr(&**bl, lm, f - 1); s.push_str(" "); ast::push_bin_symbol(&mut s, bop); s.push_str(" "); s.push_str(self.expr(&**br, rm2, f - 1).as_str()); },
                ast::ExprKind::Ref(rm, rx) => { s.push_str("&"); if *rm { s.push_str("mut "); } s.push_str(self.expr(&**rx, 12, f - 1).as_str()); },
                ast::ExprKind::If(ife) => { s = self.one_line(e, f - 1); },
                ast::ExprKind::Block(blk) => { s = self.one_line(e, f - 1); },
                ast::ExprKind::Array(ar) => { s.push_str("["); s.push_str(self.exprs(ar.as_slice(), f - 1).as_str()); s.push_str("]"); },
                ast::ExprKind::Repeat(rp) => { s.push_str("["); s.push_str(self.expr(&*rp.value, 0, f - 1).as_str()); s.push_str("; "); s.push_str(self.count_text(rp).as_str()); s.push_str("]"); },
                ast::ExprKind::Old(ox) => { s.push_str("old("); s.push_str(self.expr(&**ox, 0, f - 1).as_str()); s.push_str(")"); },
                ast::ExprKind::Quant(qu) => { match &qu.q { ast::Quantifier::Forall => s.push_str("forall|"), ast::Quantifier::Exists => s.push_str("exists|"), } s.push_str(self.params_text(qu.binders.as_slice(), true).as_str()); s.push_str("| "); s.push_str(self.expr(&*qu.body, 0, f - 1).as_str()); },
                ast::ExprKind::Trigger(tx) => { s.push_str("#[trigger] "); s.push_str(self.expr(&**tx, 12, f - 1).as_str()); },
                ast::ExprKind::Closure(cl) => { s = self.closure_text(&**cl, f - 1); },
                ast::ExprKind::StructLit(sl) => { s = self.struct_text(sl, e.span, f - 1); },
                ast::ExprKind::Path(pa) => { s = self.path_text(pa.as_slice(), e.span); },
                ast::ExprKind::Deref(dx) => { s.push_str("*"); s.push_str(self.expr(&**dx, 12, f - 1).as_str()); },
                ast::ExprKind::Field(fx, fnm) => { if !is_capture_base(&**fx) { s = self.expr(&**fx, 13, f - 1); s.push_str("."); } s.push_str(self.field_name(fx.span, fnm.name.as_str()).as_str()); },
                ast::ExprKind::Match(ma) => { s = self.one_line(e, f - 1); },
                ast::ExprKind::Return(rv) => { s.push_str("return"); match rv { None => {}, Some(v) => { s.push_str(" "); s.push_str(self.expr(&**v, 0, f - 1).as_str()); }, } },
                ast::ExprKind::Try(tr) => { s = self.expr(&**tr, 13, f - 1); s.push_str("?"); },
                ast::ExprKind::Loop(lp) => { s = self.one_line(e, f - 1); },
                ast::ExprKind::Break(bk) => { s.push_str("break"); match &bk.label { None => {}, Some(l) => { s.push_str(" '"); s.push_str(self.label(l.name.as_str()).as_str()); }, } match &bk.value { None => {}, Some(bv) => { s.push_str(" "); s.push_str(self.expr(&**bv, 0, f - 1).as_str()); }, } },
                ast::ExprKind::Continue(co) => { s.push_str("continue"); match co { None => {}, Some(cl2) => { s.push_str(" '"); s.push_str(self.label(cl2.name.as_str()).as_str()); }, } },
                ast::ExprKind::Range(rg) => { s = self.cond(&*rg.lo, f - 1); if rg.inclusive { s.push_str("..="); } else { s.push_str(".."); } s.push_str(self.cond(&*rg.hi, f - 1).as_str()); },
                ast::ExprKind::Error => s.push_str("<error>"),
            }
            s
        }

        #[summary("Prints an expression that may span several lines (if, block) as a statement")]
        #[effects(alloc)]
        fn expr_stmt(self: &mut Printer, e: &ast::Expr, depth: usize, suffix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            if !self.lines_of(e, depth, "", suffix, f - 1) {
                let mut row: String = self.expr(e, 0, f - 1);
                row.push_str(suffix);
                self.line(depth, row.as_str());
            }
        }

        #[summary("Comma-joined expressions")]
        #[effects(alloc)]
        fn exprs(self: &mut Printer, xs: &[ast::Expr], f: usize) -> String
            decreases f,
        {
            let mut s: String = String::new();
            if f == 0 {
                return s;
            }
            let mut i: usize = 0;
            while i < xs.len()
                decreases xs.len() - i,
            {
                if i > 0 {
                    s.push_str(", ");
                }
                s.push_str(self.expr(&xs[i], 0, f - 1).as_str());
                i = i + 1;
            }
            s
        }

        #[summary("Declaration position of field name in the struct that the expression at position span has")]
        #[effects(alloc)]
        fn field_at(self: &Printer, span: source::Span, name: &str) -> Option<usize> {
            if !self.is_id() {
                return None;
            }
            match self.adt_at(span) {
                None => None,
                Some(a) => { if a.at < self.names.adts.items.len() { field_index(&self.names.adts.items[a.at].kind, name) } else { None } },
            }
        }

        #[summary("Name of a field: in identity text, its declaration position in the struct that the expression at base_span has")]
        #[effects(alloc)]
        fn field_name(self: &Printer, base_span: source::Span, name: &str) -> String {
            match self.field_at(base_span, name) {
                None => String::from(name),
                Some(k) => { let mut s: String = String::new(); push_n(&mut s, k); s },
            }
        }

        #[summary("Head and functions in name order: body of an impl block")]
        #[effects(alloc)]
        fn fn_block(self: &mut Printer, head: &str, fs: &[ast::FnDef], depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            if fs.len() == 0 {
                let mut empty: String = String::from(head);
                empty.push_str(" {}");
                self.line(depth, empty.as_str());
                return;
            }
            let mut open: String = String::from(head);
            open.push_str(" {");
            self.line(depth, open.as_str());
            let mut keys: Vec<String> = Vec::new();
            let mut i: usize = 0;
            while i < fs.len()
                decreases fs.len() - i,
            {
                keys.push(fs[i].name.name.clone());
                i = i + 1;
            }
            let ord: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < ord.len()
                decreases ord.len() - i,
            {
                if ord[i] < fs.len() {
                    if i > 0 {
                        self.out.push_str("\n");
                    }
                    self.function(&fs[ord[i]], depth.saturating_add(1), "", true, f - 1);
                }
                i = i + 1;
            }
            self.line(depth, "}");
        }

        #[summary("Head of a for: binds in the order label, range, variable")]
        #[effects(alloc)]
        fn for_head(self: &mut Printer, fo: &ast::For, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            let mut fhead: String = self.label_head(&fo.label);
            let a: String = self.cond(&fo.lo, f - 1);
            let b: String = self.cond(&fo.hi, f - 1);
            fhead.push_str("for ");
            fhead.push_str(self.bind(fo.var.name.as_str()).as_str());
            fhead.push_str(" in ");
            fhead.push_str(a.as_str());
            if fo.inclusive {
                fhead.push_str("..=");
            } else {
                fhead.push_str("..");
            }
            fhead.push_str(b.as_str());
            fhead
        }

        #[summary("One definition. If rename is not empty, the definition's name is written as that (_ for hashes)")]
        #[effects(alloc)]
        fn function(self: &mut Printer, d: &ast::FnDef, depth: usize, rename: &str, with_body: bool, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            self.summary_line(d.attrs.as_slice(), depth);
            let mut i: usize = 0;
            let mut done: bool = false;
            while i < d.attrs.len() && !done
                decreases d.attrs.len() - i,
            {
                if d.attrs[i].name.name == "rationale" {
                    if self.is_plain() {
                        self.rationale_line(&d.attrs[i], depth);
                    }
                    done = true;
                }
                i = i + 1;
            }
            i = 0;
            done = false;
            while i < d.attrs.len() && !done
                decreases d.attrs.len() - i,
            {
                if d.attrs[i].name.name == "external_body" {
                    self.line(depth, "#[external_body]");
                    done = true;
                }
                i = i + 1;
            }
            i = 0;
            done = false;
            while i < d.attrs.len() && !done
                decreases d.attrs.len() - i,
            {
                if d.attrs[i].name.name == "effects" {
                    let mut names: Vec<String> = Vec::new();
                    let mut k: usize = 0;
                    while k < d.attrs[i].args.len()
                        decreases d.attrs[i].args.len() - k,
                    {
                        names.push(attr_arg(&d.attrs[i].args[k], 100));
                        k = k + 1;
                    }
                    let mut row: String = String::from("#[effects(");
                    row.push_str(sorted_list(names.as_slice(), false).as_str());
                    row.push_str(")]");
                    self.line(depth, row.as_str());
                    done = true;
                }
                i = i + 1;
            }
            let mut uses: Vec<String> = Vec::new();
            i = 0;
            while i < d.attrs.len()
                decreases d.attrs.len() - i,
            {
                if d.attrs[i].name.name == "uses" {
                    let mut u: usize = 0;
                    while u < d.attrs[i].args.len()
                        decreases d.attrs[i].args.len() - u,
                    {
                        match &d.attrs[i].args[u] {
                            ast::AttrArg::Ident(id) => uses.push(self.uses_name(id.name.as_str())),
                            ast::AttrArg::Str(s, sp) => {},
                            ast::AttrArg::Pair(pk, pv) => {},
                        }
                        u = u + 1;
                    }
                }
                i = i + 1;
            }
            if uses.len() > 0 {
                let mut urow: String = String::from("#[uses(");
                urow.push_str(sorted_list(uses.as_slice(), true).as_str());
                urow.push_str(")]");
                self.line(depth, urow.as_str());
            }
            let mut sig: String = String::new();
            match &d.kind {
                ast::FnKind::Exec => sig.push_str("fn "),
                ast::FnKind::Spec => sig.push_str("spec fn "),
                ast::FnKind::Proof => sig.push_str("proof fn "),
            }
            if rename.len() > 0 {
                sig.push_str(rename);
            } else {
                sig.push_str(d.name.name.as_str());
            }
            sig.push_str(self.generics(d.generics.as_slice()).as_str());
            sig.push_str("(");
            sig.push_str(self.params_text(d.params.as_slice(), true).as_str());
            sig.push_str(")");
            let ret: String = self.ret_text(&d.ret, true);
            let is_proof: bool = match &d.kind {
                ast::FnKind::Exec => false,
                ast::FnKind::Spec => false,
                ast::FnKind::Proof => true,
            };
            if !is_proof {
                sig.push_str(" -> ");
                sig.push_str(ret.as_str());
            }
            let has_clauses: bool = d.pre.len() > 0 || d.post.len() > 0 || is_some(&d.measure);
            if !with_body {
                self.line(depth, sig.as_str());
                self.clauses(d, depth, f - 1);
                return;
            }
            if has_clauses {
                self.line(depth, sig.as_str());
                self.clauses(d, depth, f - 1);
                self.block_open(&d.body, depth, "", "", f - 1);
            } else {
                sig.push_str(" ");
                self.block_open(&d.body, depth, sig.as_str(), "", f - 1);
            }
        }

        #[summary("<T: Copy, U: Copy + geo::Shape>, or nothing. In identity text, binds the parameters and writes the bounds as references")]
        #[effects(alloc)]
        fn generics(self: &mut Printer, gs: &[ast::TypeParam]) -> String {
            if !self.is_id() {
                return generics_str(gs);
            }
            let mut s: String = String::new();
            if gs.len() == 0 {
                return s;
            }
            s.push_str("<");
            let mut i: usize = 0;
            while i < gs.len()
                decreases gs.len() - i,
            {
                if i > 0 {
                    s.push_str(", ");
                }
                s.push_str(self.bind(gs[i].name.name.as_str()).as_str());
                let mut k: usize = 0;
                while k < gs[i].bounds.len()
                    decreases gs[i].bounds.len() - k,
                {
                    if k == 0 {
                        s.push_str(": ");
                    } else {
                        s.push_str(" + ");
                    }
                    s.push_str(self.bound(gs[i].bounds[k].as_slice()).as_str());
                    k = k + 1;
                }
                i = i + 1;
            }
            s.push_str(">");
            s
        }

        #[summary("Type in identity text: declared types as references, type parameters as bound slots, built-ins by name")]
        #[effects(alloc)]
        fn id_kind(self: &mut Printer, t: &ast::TypeKind, f: usize) -> String
            decreases f,
        {
            let mut s: String = String::new();
            if f == 0 {
                return s;
            }
            match t {
                ast::TypeKind::Int(it) => push_kind(&mut s, t, 1),
                ast::TypeKind::F64 => push_kind(&mut s, t, 1),
                ast::TypeKind::Bool => push_kind(&mut s, t, 1),
                ast::TypeKind::Unit => push_kind(&mut s, t, 1),
                ast::TypeKind::Char => push_kind(&mut s, t, 1),
                ast::TypeKind::String => push_kind(&mut s, t, 1),
                ast::TypeKind::Str => push_kind(&mut s, t, 1),
                ast::TypeKind::Array(e, n) => { s.push_str("["); s.push_str(self.id_kind(&e.kind, f - 1).as_str()); s.push_str("; "); std::num::push_u64(&mut s, *n); s.push_str("]"); },
                ast::TypeKind::ArrayN(e, p) => { s.push_str("["); s.push_str(self.id_kind(&e.kind, f - 1).as_str()); s.push_str("; "); s.push_str(types::join(p.as_slice(), "::").as_str()); s.push_str("]"); },
                ast::TypeKind::Slice(e) => { s.push_str("["); s.push_str(self.id_kind(&e.kind, f - 1).as_str()); s.push_str("]"); },
                ast::TypeKind::Ref(m, e) => { s.push_str("&"); if *m { s.push_str("mut "); } s.push_str(self.id_kind(&e.kind, f - 1).as_str()); },
                ast::TypeKind::Named(np, a) => { s = self.type_ref(np.as_slice()); if a.len() > 0 { s.push_str("<"); let mut j: usize = 0; while j < a.len() decreases a.len() - j, { if j > 0 { s.push_str(", "); } s.push_str(self.id_kind(&a[j].kind, f - 1).as_str()); j = j + 1; } s.push_str(">"); } },
                ast::TypeKind::Vec(e) => { s.push_str("Vec<"); s.push_str(self.id_kind(&e.kind, f - 1).as_str()); s.push_str(">"); },
                ast::TypeKind::Box(e) => { s.push_str("Box<"); s.push_str(self.id_kind(&e.kind, f - 1).as_str()); s.push_str(">"); },
                ast::TypeKind::Param(pn) => { s = self.local(pn.as_str()); },
                ast::TypeKind::Never => push_kind(&mut s, t, 1),
                ast::TypeKind::Error => push_kind(&mut s, t, 1),
            }
            s
        }

        #[effects(alloc)]
        fn if_lines(self: &mut Printer, ife: &ast::If, depth: usize, prefix: &str, suffix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut head: String = String::from(prefix);
            head.push_str("if ");
            head.push_str(self.cond(&*ife.cond, f - 1).as_str());
            head.push_str(" ");
            match &ife.els {
                None => self.block_open(&ife.then, depth, head.as_str(), suffix, f - 1),
                Some(x) => { let saved: String = std::mem::replace(&mut self.out, String::new()); self.block_open(&ife.then, depth, head.as_str(), "", f - 1); let then: String = std::mem::replace(&mut self.out, String::new()); self.lines_of(&**x, depth, "", suffix, f - 1); let rest: String = std::mem::replace(&mut self.out, saved); self.out.push_str(lexer::cut(then.as_str(), 0, then.len().saturating_sub(1)).as_str()); self.out.push_str(" else "); self.out.push_str(trim_start(rest.as_str()).as_str()); },
            }
        }

        #[effects(alloc)]
        fn impl_block(self: &mut Printer, i: &ast::Impl, depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut head: String = String::from("impl");
            head.push_str(generics_str(i.generics.as_slice()).as_str());
            head.push_str(" ");
            head.push_str(i.ty.name.as_str());
            if i.ty_args.len() > 0 {
                head.push_str("<");
                head.push_str(types_str(i.ty_args.as_slice()).as_str());
                head.push_str(">");
            }
            self.fn_block(head.as_str(), i.fns.as_slice(), depth, f - 1);
        }

        #[summary("Whether this is identity text (collecting or writing references)")]
        #[effects(pure)]
        fn is_id(self: &Printer) -> bool {
            match &self.names.mode {
                Mode::Plain => false,
                Mode::Qualify => false,
                Mode::Collect => true,
                Mode::Identity => true,
            }
        }

        #[summary("Whether this is as-written text")]
        #[effects(pure)]
        fn is_plain(self: &Printer) -> bool {
            match &self.names.mode {
                Mode::Plain => true,
                Mode::Qualify => false,
                Mode::Collect => false,
                Mode::Identity => false,
            }
        }

        #[summary("Use of a label: its slot if it is a bound label")]
        #[effects(alloc)]
        fn label(self: &Printer, name: &str) -> String {
            if self.is_id() {
                match self.names.labels.find(name) {
                    None => {},
                    Some(at) => { return self.names.labels.items[at].clone(); },
                }
            }
            String::from(name)
        }

        #[summary("'l: (binds the label), or nothing")]
        #[effects(alloc)]
        fn label_head(self: &mut Printer, l: &Option<ast::Ident>) -> String {
            let mut s: String = String::new();
            match l {
                None => {},
                Some(i) => { s.push_str("'"); s.push_str(self.bind_label(i.name.as_str()).as_str()); s.push_str(": "); },
            }
            s
        }

        #[summary("Head of let T { a, b } = : the type as a reference in identity text, fields bound in written order")]
        #[effects(alloc)]
        fn let_fields_head(self: &mut Printer, lf: &ast::LetFields) -> String {
            let mut lhead: String = String::from("let ");
            if self.is_id() {
                let mut names: Vec<String> = Vec::new();
                let mut k: usize = 0;
                while k < lf.path.len()
                    decreases lf.path.len() - k,
                {
                    names.push(lf.path[k].name.clone());
                    k = k + 1;
                }
                lhead.push_str(self.type_ref(names.as_slice()).as_str());
            } else {
                lhead.push_str(self.path(lf.path.as_slice()).as_str());
            }
            lhead.push_str(" { ");
            let mut i: usize = 0;
            while i < lf.fields.len()
                decreases lf.fields.len() - i,
            {
                if i > 0 {
                    lhead.push_str(", ");
                }
                lhead.push_str(self.bind(lf.fields[i].name.as_str()).as_str());
                i = i + 1;
            }
            lhead.push_str(" } = ");
            lhead
        }

        #[summary("Head of let [mut ]x: T =")]
        #[effects(alloc)]
        fn let_head(self: &mut Printer, le: &ast::Let) -> String {
            let mut head: String = String::from("let ");
            if le.mutable {
                head.push_str("mut ");
            }
            head.push_str(self.bind(le.name.name.as_str()).as_str());
            head.push_str(": ");
            head.push_str(self.ty(&le.ty).as_str());
            head.push_str(" = ");
            head
        }

        #[summary("One indented line")]
        #[effects(alloc)]
        fn line(self: &mut Printer, depth: usize, text: &str) -> () {
            let mut k: usize = 0;
            while k < depth
                decreases depth - k,
            {
                self.out.push_str("    ");
                k = k + 1;
            }
            self.out.push_str(text);
            self.out.push_str("\n");
        }

        #[summary("If the form spans several lines (if, block, match, loop), prints it as lines with head and suffix attached and returns true")]
        #[effects(alloc)]
        fn lines_of(self: &mut Printer, e: &ast::Expr, depth: usize, head: &str, suffix: &str, f: usize) -> bool
            decreases f,
        {
            if f == 0 {
                return false;
            }
            match &e.kind {
                ast::ExprKind::Int(iv, ir) => false,
                ast::ExprKind::Float(fb) => false,
                ast::ExprKind::ByteLit(by) => false,
                ast::ExprKind::ByteStr(bys) => false,
                ast::ExprKind::StrLit(st) => false,
                ast::ExprKind::CharLit(ch) => false,
                ast::ExprKind::Bool(bo) => false,
                ast::ExprKind::Unit => false,
                ast::ExprKind::Var(id) => false,
                ast::ExprKind::Call(ca) => false,
                ast::ExprKind::Method(me) => false,
                ast::ExprKind::Index(ib, ii) => false,
                ast::ExprKind::Unary(uo, ux) => false,
                ast::ExprKind::Binary(bop, bl, br) => false,
                ast::ExprKind::Ref(rm, rx) => false,
                ast::ExprKind::If(ife) => { self.if_lines(ife, depth, head, suffix, f - 1); true },
                ast::ExprKind::Block(blk) => { self.block_open(blk, depth, head, suffix, f - 1); true },
                ast::ExprKind::Array(ar) => false,
                ast::ExprKind::Repeat(rp) => false,
                ast::ExprKind::Old(ox) => false,
                ast::ExprKind::Quant(qu) => false,
                ast::ExprKind::Trigger(tx) => false,
                ast::ExprKind::Closure(cl) => false,
                ast::ExprKind::StructLit(sl) => false,
                ast::ExprKind::Path(pa) => false,
                ast::ExprKind::Deref(dx) => false,
                ast::ExprKind::Field(fx, fnm) => false,
                ast::ExprKind::Match(ma) => { self.match_lines(ma, depth, head, suffix, f - 1); true },
                ast::ExprKind::Return(rv) => false,
                ast::ExprKind::Try(tr) => false,
                ast::ExprKind::Loop(lp) => { self.loop_lines(lp, depth, head, suffix, f - 1); true },
                ast::ExprKind::Break(bk) => false,
                ast::ExprKind::Continue(co) => false,
                ast::ExprKind::Range(rg) => false,
                ast::ExprKind::Error => false,
            }
        }

        #[summary("Use of a bound name: its slot if it is a bound name, other names (None etc.) as written")]
        #[effects(alloc)]
        fn local(self: &Printer, name: &str) -> String {
            if self.is_id() {
                match self.names.binders.find(name) {
                    None => {},
                    Some(at) => { return self.names.binders.items[at].clone(); },
                }
            }
            String::from(name)
        }

        #[summary("Lines of invariant and decreases")]
        #[effects(alloc)]
        fn loop_clauses(self: &mut Printer, invariants: &[ast::Expr], measure: Option<String>, depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            self.clause_line("invariant ", invariants, depth.saturating_add(1), f - 1);
            match measure {
                None => {},
                Some(m) => { let mut row: String = String::from("decreases "); row.push_str(m.as_str()); row.push_str(","); self.line(depth.saturating_add(1), row.as_str()); },
            }
        }

        #[summary("head['l: ]loop, clauses on their own lines as in while, then the body")]
        #[effects(alloc)]
        fn loop_lines(self: &mut Printer, lp: &ast::Loop, depth: usize, head: &str, suffix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut row: String = String::from(head);
            row.push_str(self.label_head(&lp.label).as_str());
            let has: bool = is_some_box(&lp.measure);
            if lp.invariants.len() == 0 && !has {
                row.push_str("loop ");
                self.block_open(&lp.body, depth, row.as_str(), suffix, f - 1);
                return;
            }
            row.push_str("loop");
            self.line(depth, row.as_str());
            let m: Option<String> = match &lp.measure {
                None => None,
                Some(x) => Some(self.expr(&**x, 0, f - 1)),
            };
            self.loop_clauses(lp.invariants.as_slice(), m, depth, f - 1);
            self.block_open(&lp.body, depth, "", suffix, f - 1);
        }

        #[summary("match, one line per arm (arm bodies on one line)")]
        #[effects(alloc)]
        fn match_lines(self: &mut Printer, ma: &ast::Match, depth: usize, prefix: &str, suffix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut head: String = String::from(prefix);
            head.push_str("match ");
            head.push_str(self.cond(&*ma.scrut, f - 1).as_str());
            head.push_str(" {");
            self.line(depth, head.as_str());
            let mut i: usize = 0;
            while i < ma.arms.len()
                decreases ma.arms.len() - i,
            {
                let mut row: String = self.pat(&ma.arms[i].pat, ma.scrut.span);
                row.push_str(" => ");
                row.push_str(self.expr(&ma.arms[i].body, 0, f - 1).as_str());
                row.push_str(",");
                self.line(depth.saturating_add(1), row.as_str());
                i = i + 1;
            }
            let mut close: String = String::from("}");
            close.push_str(suffix);
            self.line(depth, close.as_str());
        }

        #[summary("Method name of trait trait_path: in identity text, the trait's reference and the method's position within the trait (#<id>#k)")]
        #[effects(alloc)]
        fn method_ref(self: &mut Printer, trait_path: &str, name: &str) -> String {
            if !self.is_id() {
                return types::cat3(trait_path, "::", name);
            }
            let mut s: String = self.entity("2", trait_path);
            if self.collecting() {
                return String::from("#?#?");
            }
            let key: String = types::cat3("2", ":", trait_path);
            let k: Option<usize> = match self.names.refs.find(key.as_str()) {
                None => None,
                Some(at) => decls::index_of(self.names.refs.items[at].methods.as_slice(), name),
            };
            match k {
                None => s.push_str("#?"),
                Some(n) => { s.push_str("#"); push_n(&mut s, n); },
            }
            s
        }

        #[effects(alloc)]
        fn module(self: &mut Printer, m: &ast::Mod, depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut a: usize = 0;
            let mut found: bool = false;
            while a < m.attrs.len() && !found
                decreases m.attrs.len() - a,
            {
                if m.attrs[a].name.name == "summary" && m.attrs[a].args.len() > 0 {
                    match &m.attrs[a].args[0] {
                        ast::AttrArg::Ident(ai) => {},
                        ast::AttrArg::Str(s, sp) => { found = true; let mut head: String = String::from("#[summary(\""); head.push_str(escape(s.as_str()).as_str()); head.push_str("\")]"); self.line(depth, head.as_str()); },
                        ast::AttrArg::Pair(k, v) => {},
                    }
                }
                a = a + 1;
            }
            let mut open: String = String::from("mod ");
            open.push_str(m.name.name.as_str());
            open.push_str(" {");
            self.line(depth, open.as_str());
            let mut l: usize = 0;
            while l < m.lens.len()
                decreases m.lens.len() - l,
            {
                self.lens.push(LenName { file: m.lens[l].at.file, lo: m.lens[l].at.lo, hi: m.lens[l].at.hi, name: path_str(m.lens[l].path.as_slice()) });
                l = l + 1;
            }
            let mut keys: Vec<String> = Vec::new();
            let mut i: usize = 0;
            let mut first: bool = true;
            while i < m.consts.len()
                decreases m.consts.len() - i,
            {
                keys.push(m.consts[i].name.name.clone());
                i = i + 1;
            }
            let consts: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < consts.len()
                decreases consts.len() - i,
            {
                if consts[i] < m.consts.len() {
                    self.summary_line(m.consts[consts[i]].attrs.as_slice(), depth.saturating_add(1));
                    let mut row: String = String::from("const ");
                    row.push_str(m.consts[consts[i]].name.name.as_str());
                    row.push_str(": ");
                    row.push_str(type_str(&m.consts[consts[i]].ty).as_str());
                    row.push_str(" = ");
                    row.push_str(self.expr(&m.consts[consts[i]].value, 0, f - 1).as_str());
                    row.push_str(";");
                    self.line(depth.saturating_add(1), row.as_str());
                    first = false;
                }
                i = i + 1;
            }
            keys = Vec::new();
            i = 0;
            while i < m.mods.len()
                decreases m.mods.len() - i,
            {
                keys.push(m.mods[i].name.name.clone());
                i = i + 1;
            }
            let subs: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < subs.len()
                decreases subs.len() - i,
            {
                if subs[i] < m.mods.len() {
                    if !first {
                        self.out.push_str("\n");
                    }
                    first = false;
                    self.module(&m.mods[subs[i]], depth.saturating_add(1), f - 1);
                }
                i = i + 1;
            }
            keys = Vec::new();
            i = 0;
            while i < m.traits.len()
                decreases m.traits.len() - i,
            {
                keys.push(m.traits[i].name.name.clone());
                i = i + 1;
            }
            let traits: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < traits.len()
                decreases traits.len() - i,
            {
                if traits[i] < m.traits.len() {
                    if !first {
                        self.out.push_str("\n");
                    }
                    first = false;
                    self.trait_def(&m.traits[traits[i]], depth.saturating_add(1), f - 1);
                }
                i = i + 1;
            }
            keys = Vec::new();
            i = 0;
            while i < m.trait_impls.len()
                decreases m.trait_impls.len() - i,
            {
                let mut key: String = path_str(m.trait_impls[i].trait_path.as_slice());
                key.push_str("\0");
                key.push_str(type_str(&m.trait_impls[i].self_ty).as_str());
                keys.push(key);
                i = i + 1;
            }
            let timpls: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < timpls.len()
                decreases timpls.len() - i,
            {
                if timpls[i] < m.trait_impls.len() {
                    let own: String = own_type(&m.trait_impls[timpls[i]].self_ty);
                    if !has_type(m.types.as_slice(), own.as_str()) {
                        if !first {
                            self.out.push_str("\n");
                        }
                        first = false;
                        self.trait_impl(&m.trait_impls[timpls[i]], depth.saturating_add(1), f - 1);
                    }
                }
                i = i + 1;
            }
            keys = Vec::new();
            i = 0;
            while i < m.impls.len()
                decreases m.impls.len() - i,
            {
                keys.push(m.impls[i].ty.name.clone());
                i = i + 1;
            }
            let impls: Vec<usize> = order(keys.as_slice());
            keys = Vec::new();
            i = 0;
            while i < m.types.len()
                decreases m.types.len() - i,
            {
                keys.push(m.types[i].name.name.clone());
                i = i + 1;
            }
            let types: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < types.len()
                decreases types.len() - i,
            {
                if types[i] < m.types.len() {
                    if !first {
                        self.out.push_str("\n");
                    }
                    first = false;
                    self.type_def(&m.types[types[i]], depth.saturating_add(1));
                    let mut j: usize = 0;
                    while j < impls.len()
                        decreases impls.len() - j,
                    {
                        if impls[j] < m.impls.len() && m.impls[impls[j]].ty.name == m.types[types[i]].name.name {
                            self.out.push_str("\n");
                            self.impl_block(&m.impls[impls[j]], depth.saturating_add(1), f - 1);
                        }
                        j = j + 1;
                    }
                    j = 0;
                    while j < timpls.len()
                        decreases timpls.len() - j,
                    {
                        if timpls[j] < m.trait_impls.len() && own_type(&m.trait_impls[timpls[j]].self_ty) == m.types[types[i]].name.name {
                            self.out.push_str("\n");
                            self.trait_impl(&m.trait_impls[timpls[j]], depth.saturating_add(1), f - 1);
                        }
                        j = j + 1;
                    }
                }
                i = i + 1;
            }
            i = 0;
            while i < impls.len()
                decreases impls.len() - i,
            {
                if impls[i] < m.impls.len() && !has_type(m.types.as_slice(), m.impls[impls[i]].ty.name.as_str()) {
                    if !first {
                        self.out.push_str("\n");
                    }
                    first = false;
                    self.impl_block(&m.impls[impls[i]], depth.saturating_add(1), f - 1);
                }
                i = i + 1;
            }
            keys = Vec::new();
            i = 0;
            while i < m.fns.len()
                decreases m.fns.len() - i,
            {
                keys.push(m.fns[i].name.name.clone());
                i = i + 1;
            }
            let fns: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < fns.len()
                decreases fns.len() - i,
            {
                if fns[i] < m.fns.len() {
                    if !first {
                        self.out.push_str("\n");
                    }
                    first = false;
                    self.function(&m.fns[fns[i]], depth.saturating_add(1), "", true, f - 1);
                }
                i = i + 1;
            }
            self.line(depth, "}");
        }

        #[summary("head value suffix: the value may be a multi-line if or block")]
        #[effects(alloc)]
        fn multiline_value(self: &mut Printer, v: &ast::Expr, depth: usize, head: &str, suffix: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            if !self.lines_of(v, depth, head, suffix, f - 1) {
                let mut row: String = String::from(head);
                row.push_str(self.expr(v, 0, f - 1).as_str());
                row.push_str(suffix);
                self.line(depth, row.as_str());
            }
        }

        #[summary("A multi-line form on one line inside an expression: trims each line and joins with a space")]
        #[effects(alloc)]
        fn one_line(self: &mut Printer, e: &ast::Expr, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            let saved: String = std::mem::replace(&mut self.out, String::new());
            self.expr_stmt(e, 0, "", f - 1);
            let text: String = std::mem::replace(&mut self.out, saved);
            joined_lines(text.as_str())
        }

        #[summary("x: T, y: U. If bind, binds the names (parameters of functions and quantifiers; those of closures are not bound)")]
        #[effects(alloc)]
        fn params_text(self: &mut Printer, ps: &[ast::Param], bind: bool) -> String {
            let mut s: String = String::new();
            let mut i: usize = 0;
            while i < ps.len()
                decreases ps.len() - i,
            {
                if i > 0 {
                    s.push_str(", ");
                }
                if bind {
                    s.push_str(self.bind(ps[i].name.name.as_str()).as_str());
                } else {
                    s.push_str(ps[i].name.name.as_str());
                }
                s.push_str(": ");
                s.push_str(self.ty(&ps[i].ty).as_str());
                i = i + 1;
            }
            s
        }

        #[summary("Pattern: in identity text, variants as positions within the enum of the scrutinee (position scrut), binding names as bound slots")]
        #[effects(alloc)]
        fn pat(self: &mut Printer, p: &ast::Pat, scrut: source::Span) -> String {
            if !self.is_id() {
                return pat_str(p);
            }
            let v: Option<Found> = if p.path.len() > 0 {
                self.variant_at(scrut, p.path[p.path.len() - 1].name.as_str())
            } else {
                None
            };
            let mut s: String = match v {
                None => path_str(p.path.as_slice()),
                Some(x) => self.variant_ref(x.path.as_str(), x.at),
            };
            if !p.parens {
                return s;
            }
            s.push_str("(");
            let mut i: usize = 0;
            while i < p.binds.len()
                decreases p.binds.len() - i,
            {
                if i > 0 {
                    s.push_str(", ");
                }
                match &p.binds[i] {
                    None => s.push_str("_"),
                    Some(b) => s.push_str(self.bind(b.name.as_str()).as_str()),
                }
                i = i + 1;
            }
            s.push_str(")");
            s
        }

        #[summary("Path: in qualified text, this unit's f, T::f (function of an impl), Trait::f (method of a trait) as full paths, as the checker resolves them")]
        #[effects(alloc)]
        fn path(self: &Printer, path: &[ast::Ident]) -> String {
            let plain: String = path_str(path);
            if self.qualified(path) {
                return types::cat3(self.names.unit.as_str(), "::", plain.as_str());
            }
            plain
        }

        #[summary("Path written as an expression: in identity text, its reference if it is a variant of the enum of the expression (position span)")]
        #[effects(alloc)]
        fn path_text(self: &mut Printer, pa: &[ast::Ident], span: source::Span) -> String {
            if self.is_id() && pa.len() > 0 {
                match self.variant_at(span, pa[pa.len() - 1].name.as_str()) {
                    None => {},
                    Some(v) => { return self.variant_ref(v.path.as_str(), v.at); },
                }
            }
            self.path(pa)
        }

        #[summary("Whether path path refers to a definition of this unit in qualified text")]
        #[effects(alloc)]
        fn qualified(self: &Printer, path: &[ast::Ident]) -> bool {
            let on: bool = match &self.names.mode {
                Mode::Plain => false,
                Mode::Qualify => true,
                Mode::Collect => false,
                Mode::Identity => false,
            };
            if !on || path.len() > 2 {
                return false;
            }
            let local: String = types::cat3(self.names.unit.as_str(), "::", path_str(path).as_str());
            match self.names.fns.find(local.as_str()) {
                None => false,
                Some(at) => path.len() == 1 || self.names.fns.items[at].in_impl || is_some_text(&self.names.fns.items[at].trait_of),
            }
        }

        #[summary("#[rationale(..)] (ADR-0029 §1)")]
        #[effects(alloc)]
        fn rationale_line(self: &mut Printer, a: &ast::Attr, depth: usize) -> () {
            let mut row: String = String::from("#[rationale(");
            row.push_str(attr_args(a.args.as_slice()).as_str());
            row.push_str(")]");
            self.line(depth, row.as_str());
        }

        #[summary("Receiver of a call written as x.f(..): with the & or .as_str() added by the passing mode stripped")]
        #[effects(alloc)]
        fn recv_text(self: &mut Printer, arg: &ast::Expr, by_ref: bool, as_str: bool, f: usize) -> String
            decreases f,
        {
            if f == 0 {
                return String::new();
            }
            match &arg.kind {
                ast::ExprKind::Int(iv, ir) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Float(fb) => self.expr(arg, 13, f - 1),
                ast::ExprKind::ByteLit(by) => self.expr(arg, 13, f - 1),
                ast::ExprKind::ByteStr(bys) => self.expr(arg, 13, f - 1),
                ast::ExprKind::StrLit(st) => self.expr(arg, 13, f - 1),
                ast::ExprKind::CharLit(ch) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Bool(bo) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Unit => self.expr(arg, 13, f - 1),
                ast::ExprKind::Var(id) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Call(ca) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Method(me) => { if as_str { self.expr(&*me.recv, 13, f - 1) } else { self.expr(arg, 13, f - 1) } },
                ast::ExprKind::Index(ib, ii) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Unary(uo, ux) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Binary(bop, bl, br) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Ref(rm, rx) => { if by_ref { self.expr(&**rx, 13, f - 1) } else { self.expr(arg, 13, f - 1) } },
                ast::ExprKind::If(ife) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Block(blk) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Array(ar) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Repeat(rp) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Old(ox) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Quant(qu) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Trigger(tx) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Closure(cl) => self.expr(arg, 13, f - 1),
                ast::ExprKind::StructLit(sl) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Path(pa) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Deref(dx) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Field(fx, fnm) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Match(ma) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Return(rv) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Try(tr) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Loop(lp) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Break(bk) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Continue(co) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Range(rg) => self.expr(arg, 13, f - 1),
                ast::ExprKind::Error => self.expr(arg, 13, f - 1),
            }
        }

        #[summary("Forgets the bound names (a new definition, or the next method of a trait)")]
        #[effects(alloc)]
        fn reset_binders(self: &mut Printer) -> () {
            self.names.binders = table::new::<String>();
            self.names.labels = table::new::<String>();
            self.names.next = 0;
            self.names.next_label = 0;
        }

        #[summary("Result type T, or (r: T). If bind, binds the result's name")]
        #[effects(alloc)]
        fn ret_text(self: &mut Printer, r: &ast::Ret, bind: bool) -> String {
            match &r.name {
                None => self.ty(&r.ty),
                Some(n) => { let mut s: String = String::from("("); if bind { s.push_str(self.bind(n.name.as_str()).as_str()); } else { s.push_str(n.name.as_str()); } s.push_str(": "); s.push_str(self.ty(&r.ty).as_str()); s.push_str(")"); s },
            }
        }

        #[effects(alloc)]
        fn stmt(self: &mut Printer, s: &ast::Stmt, depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            match s {
                ast::Stmt::Let(le) => { let head: String = self.let_head(le); self.multiline_value(&le.init, depth, head.as_str(), ";", f - 1); },
                ast::Stmt::Assign(asg) => { let mut ahead: String = self.expr(&asg.target, 0, f - 1); ahead.push_str(" = "); self.multiline_value(&asg.value, depth, ahead.as_str(), ";", f - 1); },
                ast::Stmt::While(wh) => { let mut whead: String = self.label_head(&wh.label); whead.push_str("while "); whead.push_str(self.cond(&wh.cond, f - 1).as_str()); self.line(depth, whead.as_str()); let wm: Option<String> = match &wh.measure { None => None, Some(x) => Some(self.expr(x, 0, f - 1)), }; self.loop_clauses(wh.invariants.as_slice(), wm, depth, f - 1); self.block_open(&wh.body, depth, "", "", f - 1); },
                ast::Stmt::For(fo) => { let mut fhead: String = self.for_head(fo, f - 1); if fo.invariants.len() == 0 { fhead.push_str(" "); self.block_open(&fo.body, depth, fhead.as_str(), "", f - 1); } else { self.line(depth, fhead.as_str()); self.loop_clauses(fo.invariants.as_slice(), None, depth, f - 1); self.block_open(&fo.body, depth, "", "", f - 1); } },
                ast::Stmt::Assert(asr) => { let mut row: String = String::from("assert("); row.push_str(self.expr(&asr.cond, 0, f - 1).as_str()); row.push_str(")"); match &asr.by { None => {}, Some(p) => { match p { ast::Prover::BitVector => row.push_str(" by (bit_vector)"), } }, } row.push_str(";"); self.line(depth, row.as_str()); },
                ast::Stmt::Assume(asm) => { match &asm.rationale { None => {}, Some(ra) => { if self.is_plain() { self.rationale_line(ra, depth); } }, } let mut urow: String = String::from("assume("); urow.push_str(self.expr(&asm.cond, 0, f - 1).as_str()); urow.push_str(");"); self.line(depth, urow.as_str()); },
                ast::Stmt::Proof(pb) => self.block_open(&pb.body, depth, "proof ", "", f - 1),
                ast::Stmt::LetFields(lf) => { let lhead: String = self.let_fields_head(lf); self.multiline_value(&lf.init, depth, lhead.as_str(), ";", f - 1); },
                ast::Stmt::Expr(e) => { if !self.lines_of(e, depth, "", "", f - 1) { let mut erow: String = self.expr(e, 0, f - 1); erow.push_str(";"); self.line(depth, erow.as_str()); } },
            }
        }

        #[summary("Struct expression: in identity text, fields as declaration positions and the type as a reference (from the type at the expression's position span)")]
        #[effects(alloc)]
        fn struct_text(self: &mut Printer, sl: &ast::StructLit, span: source::Span, f: usize) -> String
            decreases f,
        {
            let mut s: String = String::new();
            if f == 0 {
                return s;
            }
            let mut i: usize = 0;
            while i < sl.fields.len()
                decreases sl.fields.len() - i,
            {
                if i > 0 {
                    s.push_str(", ");
                }
                s.push_str(self.field_name(span, sl.fields[i].name.name.as_str()).as_str());
                s.push_str(": ");
                s.push_str(self.expr(&sl.fields[i].value, 0, f - 1).as_str());
                i = i + 1;
            }
            match &sl.rest {
                None => {},
                Some(r) => { if sl.fields.len() > 0 { s.push_str(", "); } s.push_str(".."); s.push_str(self.expr(&**r, 0, f - 1).as_str()); },
            }
            let named: Option<Found> = if self.is_id() {
                self.adt_at(span)
            } else {
                None
            };
            let mut head: String = match named {
                None => self.path(sl.path.as_slice()),
                Some(a) => self.entity("1", a.path.as_str()),
            };
            head.push_str(" { ");
            head.push_str(s.as_str());
            head.push_str(" }");
            head
        }

        #[summary("The definition's #[summary(\"..\")] (ADR-0117). Only in as-written text: no hash reads it")]
        #[effects(alloc)]
        fn summary_line(self: &mut Printer, attrs: &[ast::Attr], depth: usize) -> () {
            if !self.is_plain() {
                return;
            }
            let mut i: usize = 0;
            while i < attrs.len()
                decreases attrs.len() - i,
            {
                if attrs[i].name.name == "summary" {
                    let mut row: String = String::from("#[summary(");
                    row.push_str(attr_args(attrs[i].args.as_slice()).as_str());
                    row.push_str(")]");
                    self.line(depth, row.as_str());
                    return;
                }
                i = i + 1;
            }
        }

        #[summary("trait T { fn m(..) -> R; .. }, methods in name order (ADR-0046 §1)")]
        #[effects(alloc)]
        fn trait_def(self: &mut Printer, t: &ast::TraitDef, depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            self.summary_line(t.attrs.as_slice(), depth);
            let mut a: usize = 0;
            while a < t.attrs.len()
                decreases t.attrs.len() - a,
            {
                self.attr_line(&t.attrs[a], depth);
                a = a + 1;
            }
            let mut head: String = String::from("trait ");
            head.push_str(t.name.name.as_str());
            if t.fns.len() == 0 {
                head.push_str(" {}");
                self.line(depth, head.as_str());
                return;
            }
            head.push_str(" {");
            self.line(depth, head.as_str());
            let mut keys: Vec<String> = Vec::new();
            let mut i: usize = 0;
            while i < t.fns.len()
                decreases t.fns.len() - i,
            {
                keys.push(t.fns[i].f.name.name.clone());
                i = i + 1;
            }
            let ord: Vec<usize> = order(keys.as_slice());
            i = 0;
            while i < ord.len()
                decreases ord.len() - i,
            {
                if ord[i] < t.fns.len() {
                    if i > 0 {
                        self.out.push_str("\n");
                    }
                    self.trait_fn(&t.fns[ord[i]], depth.saturating_add(1), "", f - 1);
                }
                i = i + 1;
            }
            self.line(depth, "}");
        }

        #[summary("Trait method: a default body, or a signature ending in ;")]
        #[effects(alloc)]
        fn trait_fn(self: &mut Printer, tf: &ast::TraitFn, depth: usize, rename: &str, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            if tf.has_body {
                self.function(&tf.f, depth, rename, true, f - 1);
            } else {
                let saved: String = std::mem::replace(&mut self.out, String::new());
                self.function(&tf.f, depth, rename, false, f - 1);
                let sig: String = std::mem::replace(&mut self.out, saved);
                let n: usize = sig.len();
                if n >= 2 && sig.as_bytes()[n - 2] == 44 && sig.as_bytes()[n - 1] == 10 {
                    self.out.push_str(lexer::cut(sig.as_str(), 0, n - 2).as_str());
                } else {
                    self.out.push_str(lexer::cut(sig.as_str(), 0, n.saturating_sub(1)).as_str());
                }
                self.out.push_str(";\n");
            }
        }

        #[summary("Identity text of a trait (ADR-0059 §1): attributes and the nameless methods in the order of order (positions in t.fns)")]
        #[effects(alloc)]
        fn trait_identity(self: &mut Printer, t: &ast::TraitDef, order: &[usize], f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut a: usize = 0;
            while a < t.attrs.len()
                decreases t.attrs.len() - a,
            {
                self.attr_line(&t.attrs[a], 0);
                a = a + 1;
            }
            self.line(0, "trait _ {");
            let mut k: usize = 0;
            while k < order.len()
                decreases order.len() - k,
            {
                if order[k] < t.fns.len() {
                    if k > 0 {
                        self.out.push_str("\n");
                    }
                    self.reset_binders();
                    self.trait_fn(&t.fns[order[k]], 1, "_", f - 1);
                }
                k = k + 1;
            }
            self.line(0, "}");
        }

        #[summary("impl<..> Trait for T { .. }, functions in name order (ADR-0046 §2)")]
        #[effects(alloc)]
        fn trait_impl(self: &mut Printer, i: &ast::TraitImpl, depth: usize, f: usize) -> ()
            decreases f,
        {
            if f == 0 {
                return;
            }
            let mut head: String = String::from("impl");
            head.push_str(generics_str(i.generics.as_slice()).as_str());
            head.push_str(" ");
            head.push_str(path_str(i.trait_path.as_slice()).as_str());
            head.push_str(" for ");
            head.push_str(type_str(&i.self_ty).as_str());
            self.fn_block(head.as_str(), i.fns.as_slice(), depth, f - 1);
        }

        #[summary("Written type: without names in identity text")]
        #[effects(alloc)]
        fn ty(self: &mut Printer, t: &ast::Type) -> String {
            if self.is_id() {
                self.id_kind(&t.kind, 100000)
            } else {
                type_str(t)
            }
        }

        #[summary("struct T { f: U, .. } / enum T { A, B(U), .. } on one line. Fields and variants keep declaration order (ADR-0026 §6)")]
        #[effects(alloc)]
        fn type_def(self: &mut Printer, t: &ast::TypeDef, depth: usize) -> () {
            self.type_def_as(t, depth, t.name.name.as_str());
        }

        #[summary("Type declaration under name name. In identity text, fields and variants as positions: only their types are written (ADR-0059 §1)")]
        #[effects(alloc)]
        fn type_def_as(self: &mut Printer, t: &ast::TypeDef, depth: usize, name: &str) -> () {
            self.summary_line(t.attrs.as_slice(), depth);
            let mut a: usize = 0;
            while a < t.attrs.len()
                decreases t.attrs.len() - a,
            {
                self.attr_line(&t.attrs[a], depth);
                a = a + 1;
            }
            let gens: String = self.generics(t.generics.as_slice());
            let id: bool = self.is_id();
            let mut items: String = String::new();
            let mut row: String = String::new();
            match &t.kind {
                ast::TypeDefKind::Struct(fs) => { row.push_str("struct "); let mut i: usize = 0; while i < fs.len() decreases fs.len() - i, { if i > 0 { items.push_str(", "); } if !id { items.push_str(fs[i].name.name.as_str()); items.push_str(": "); } items.push_str(self.ty(&fs[i].ty).as_str()); i = i + 1; } },
                ast::TypeDefKind::Enum(vs) => { row.push_str("enum "); let mut k: usize = 0; while k < vs.len() decreases vs.len() - k, { if k > 0 { items.push_str(", "); } if !id { items.push_str(vs[k].name.name.as_str()); } if id || vs[k].payload.len() > 0 { items.push_str("("); let mut j: usize = 0; while j < vs[k].payload.len() decreases vs[k].payload.len() - j, { if j > 0 { items.push_str(", "); } items.push_str(self.ty(&vs[k].payload[j]).as_str()); j = j + 1; } items.push_str(")"); } k = k + 1; } },
            }
            row.push_str(name);
            row.push_str(gens.as_str());
            if items.len() == 0 && !id {
                row.push_str(" {}");
            } else {
                row.push_str(" { ");
                row.push_str(items.as_str());
                row.push_str(" }");
            }
            self.line(depth, row.as_str());
        }

        #[summary("Type path written in a unit: type parameter (bound slot), declared type (reference), built-in (name)")]
        #[effects(alloc)]
        fn type_ref(self: &mut Printer, path: &[String]) -> String {
            if path.len() == 1 {
                match self.names.binders.find(path[0].as_str()) {
                    None => {},
                    Some(at) => { return self.names.binders.items[at].clone(); },
                }
            }
            let plain: String = types::join(path, "::");
            let full: String = if path.len() == 1 {
                types::cat3(self.names.unit.as_str(), "::", plain.as_str())
            } else {
                plain.clone()
            };
            if self.names.adts.has(full.as_str()) {
                self.entity("1", full.as_str())
            } else {
                plain
            }
        }

        #[summary("Name of #[uses(name)] or #[invariant(name)]: full path in qualified text, reference in identity text")]
        #[effects(alloc)]
        fn uses_name(self: &mut Printer, name: &str) -> String {
            if self.is_plain() {
                return String::from(name);
            }
            match decls::uses_target(name, self.names.unit.as_str(), &self.names.fns) {
                None => String::from(name),
                Some(p) => { if self.is_id() { self.def_ref(p.as_str()) } else { p } },
            }
        }

        #[summary("Variant name in the enum that the expression at position span has: the enum's full path and the variant's declaration position")]
        #[effects(alloc)]
        fn variant_at(self: &Printer, span: source::Span, name: &str) -> Option<Found> {
            match self.adt_at(span) {
                None => None,
                Some(a) => { if a.at >= self.names.adts.items.len() { return None; } match variant_index(&self.names.adts.items[a.at].kind, name) { None => None, Some(k) => Some(Found { path: a.path, at: k }), } },
            }
        }

        #[summary("Reference of the k-th variant of enum tp: #<id>#k")]
        #[effects(alloc)]
        fn variant_ref(self: &mut Printer, tp: &str, k: usize) -> String {
            let mut s: String = self.entity("1", tp);
            s.push_str("#");
            push_n(&mut s, k);
            s
        }
    }

    #[summary("One line of qualified text (dump texts): the definition's path, qualified normal form, the surface that callers read")]
    struct QualRow { path: String, text: String, caller: String }

    #[summary("Text with which identity text writes one reference (#<id>, #self, #self<color>, #self.k) and, for a trait, the identity order of its methods")]
    struct RefRow { text: String, methods: Vec<String> }

    #[summary("Normal form of one top-level unit")]
    struct Unit { name: String, text: String }

    #[summary("Attribute arguments as written: name, string, key = value. f is the remaining depth")]
    #[effects(alloc)]
    fn attr_arg(x: &ast::AttrArg, f: usize) -> String
        decreases f,
    {
        if f == 0 {
            return String::new();
        }
        match x {
            ast::AttrArg::Ident(i) => i.name.clone(),
            ast::AttrArg::Str(s, sp) => { let mut q: String = String::from("\""); q.push_str(escape(s.as_str()).as_str()); q.push_str("\""); q },
            ast::AttrArg::Pair(k, v) => { let mut p: String = k.name.clone(); p.push_str(" = "); p.push_str(attr_arg(&**v, f - 1).as_str()); p },
        }
    }

    #[summary("Comma-joined attribute arguments")]
    #[effects(alloc)]
    fn attr_args(xs: &[ast::AttrArg]) -> String {
        let mut s: String = String::new();
        let mut i: usize = 0;
        while i < xs.len()
            decreases xs.len() - i,
        {
            if i > 0 {
                s.push_str(", ");
            }
            s.push_str(attr_arg(&xs[i], 100).as_str());
            i = i + 1;
        }
        s
    }

    #[summary("Rust's operator precedence (ADR-0019 §1, ADR-0048 §2)")]
    #[effects(pure)]
    fn bin_prec(op: &ast::BinOp) -> (r: u8)
        ensures r >= 1, r <= 10,
    {
        match op {
            ast::BinOp::Add => 9,
            ast::BinOp::Sub => 9,
            ast::BinOp::Mul => 10,
            ast::BinOp::Div => 10,
            ast::BinOp::Rem => 10,
            ast::BinOp::Eq => 4,
            ast::BinOp::Ne => 4,
            ast::BinOp::Lt => 4,
            ast::BinOp::Le => 4,
            ast::BinOp::Gt => 4,
            ast::BinOp::Ge => 4,
            ast::BinOp::And => 3,
            ast::BinOp::Or => 2,
            ast::BinOp::Implies => 1,
            ast::BinOp::BitAnd => 7,
            ast::BinOp::BitOr => 5,
            ast::BinOp::BitXor => 6,
            ast::BinOp::Shl => 8,
            ast::BinOp::Shr => 8,
        }
    }

    #[summary("What a caller's query reads from an executable function: the qualified surface without #[uses]. A definition's #[uses] reveals the body of a spec fn only in its own query, so the caller's incremental key excludes it")]
    #[effects(alloc)]
    fn caller_text(pr: &mut Printer, heads: &table::Table<String>, d: &ast::FnDef, unit: &str) -> String {
        let g: ast::FnDef = without_uses(d);
        qualified_text(pr, heads, &g, unit, false)
    }

    #[summary("Whether it is a self whose file is source::CAPTURE")]
    #[effects(pure)]
    fn captured_self(e: &ast::Expr) -> bool {
        match &e.kind {
            ast::ExprKind::Int(iv, ir) => false,
            ast::ExprKind::Float(fb) => false,
            ast::ExprKind::ByteLit(by) => false,
            ast::ExprKind::ByteStr(bys) => false,
            ast::ExprKind::StrLit(st) => false,
            ast::ExprKind::CharLit(ch) => false,
            ast::ExprKind::Bool(bo) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(id) => id.name == "self" && id.span.file == source::CAPTURE,
            ast::ExprKind::Call(ca) => false,
            ast::ExprKind::Method(me) => false,
            ast::ExprKind::Index(ib, ii) => false,
            ast::ExprKind::Unary(uo, ux) => false,
            ast::ExprKind::Binary(bop, bl, br) => false,
            ast::ExprKind::Ref(rm, rx) => false,
            ast::ExprKind::If(ife) => false,
            ast::ExprKind::Block(blk) => false,
            ast::ExprKind::Array(ar) => false,
            ast::ExprKind::Repeat(rp) => false,
            ast::ExprKind::Old(ox) => false,
            ast::ExprKind::Quant(qu) => false,
            ast::ExprKind::Trigger(tx) => false,
            ast::ExprKind::Closure(cl) => false,
            ast::ExprKind::StructLit(sl) => false,
            ast::ExprKind::Path(pa) => false,
            ast::ExprKind::Deref(dx) => false,
            ast::ExprKind::Field(fx, fnm) => false,
            ast::ExprKind::Match(ma) => false,
            ast::ExprKind::Return(rv) => false,
            ast::ExprKind::Try(tr) => false,
            ast::ExprKind::Loop(lp) => false,
            ast::ExprKind::Break(bk) => false,
            ast::ExprKind::Continue(co) => false,
            ast::ExprKind::Range(rg) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[summary("Name of T if of the form T::try_from(x) (T an integer type), otherwise empty text")]
    #[effects(alloc)]
    fn cast_name(recv: &ast::Expr) -> String {
        match &recv.kind {
            ast::ExprKind::Int(iv, ir) => String::new(),
            ast::ExprKind::Float(fb) => String::new(),
            ast::ExprKind::ByteLit(by) => String::new(),
            ast::ExprKind::ByteStr(bys) => String::new(),
            ast::ExprKind::StrLit(st) => String::new(),
            ast::ExprKind::CharLit(ch) => String::new(),
            ast::ExprKind::Bool(bo) => String::new(),
            ast::ExprKind::Unit => String::new(),
            ast::ExprKind::Var(id) => String::new(),
            ast::ExprKind::Call(ca) => { if ca.path.len() == 2 && ca.path[1].name == "try_from" && ca.targs.len() == 0 && ca.args.len() == 1 { match ast::int_of(ca.path[0].name.as_str()) { None => String::new(), Some(t) => ca.path[0].name.clone(), } } else { String::new() } },
            ast::ExprKind::Method(me) => String::new(),
            ast::ExprKind::Index(ib, ii) => String::new(),
            ast::ExprKind::Unary(uo, ux) => String::new(),
            ast::ExprKind::Binary(bop, bl, br) => String::new(),
            ast::ExprKind::Ref(rm, rx) => String::new(),
            ast::ExprKind::If(ife) => String::new(),
            ast::ExprKind::Block(blk) => String::new(),
            ast::ExprKind::Array(ar) => String::new(),
            ast::ExprKind::Repeat(rp) => String::new(),
            ast::ExprKind::Old(ox) => String::new(),
            ast::ExprKind::Quant(qu) => String::new(),
            ast::ExprKind::Trigger(tx) => String::new(),
            ast::ExprKind::Closure(cl) => String::new(),
            ast::ExprKind::StructLit(sl) => String::new(),
            ast::ExprKind::Path(pa) => String::new(),
            ast::ExprKind::Deref(dx) => String::new(),
            ast::ExprKind::Field(fx, fnm) => String::new(),
            ast::ExprKind::Match(ma) => String::new(),
            ast::ExprKind::Return(rv) => String::new(),
            ast::ExprKind::Try(tr) => String::new(),
            ast::ExprKind::Loop(lp) => String::new(),
            ast::ExprKind::Break(bk) => String::new(),
            ast::ExprKind::Continue(co) => String::new(),
            ast::ExprKind::Range(rg) => String::new(),
            ast::ExprKind::Error => String::new(),
        }
    }

    #[summary("Text with \\ and \" escaped")]
    #[effects(alloc)]
    fn escape(s: &str) -> String {
        let mut o: String = String::new();
        let mut a: usize = 0;
        let mut i: usize = 0;
        while i < s.len()
            invariant a <= i,
            decreases s.len() - i,
        {
            let b: u8 = s.as_bytes()[i];
            if b == 92 || b == 34 {
                o.push_str(lexer::cut(s, a, i).as_str());
                o.push_str("\\");
                a = i;
            }
            i = i + 1;
        }
        o.push_str(lexer::cut(s, a, s.len()).as_str());
        o
    }

    #[summary("Normal form of one expression")]
    #[effects(alloc)]
    fn expr_text(e: &ast::Expr) -> String {
        let mut pr: Printer = plain();
        pr.expr(e, 0, 1000000000)
    }

    #[summary("Declaration position of field name of the struct")]
    #[effects(pure)]
    fn field_index(k: &types::AdtKind, name: &str) -> Option<usize> {
        match k {
            types::AdtKind::Struct(fs) => { let mut i: usize = 0; while i < fs.len() decreases fs.len() - i, { if fs[i].name == name { return Some(i); } i = i + 1; } None },
            types::AdtKind::Enum(vs) => None,
        }
    }

    #[summary("Normal form of the whole program: one text per top-level unit, in unit name order (ADR-0019 §3). For the same name, the later one")]
    #[effects(alloc)]
    fn format_units(p: &ast::Program) -> Vec<Unit> {
        let mut keys: Vec<String> = Vec::new();
        let mut i: usize = 0;
        while i < p.mods.len()
            decreases p.mods.len() - i,
        {
            keys.push(p.mods[i].name.name.clone());
            i = i + 1;
        }
        let ord: Vec<usize> = order(keys.as_slice());
        let mut out: Vec<Unit> = Vec::new();
        i = 0;
        while i < ord.len()
            decreases ord.len() - i,
        {
            if ord[i] < p.mods.len() {
                let mut last: bool = true;
                if i + 1 < ord.len() && ord[i + 1] < p.mods.len() {
                    last = p.mods[ord[i + 1]].name.name != p.mods[ord[i]].name.name;
                }
                if last {
                    let mut pr: Printer = plain();
                    pr.module(&p.mods[ord[i]], 0, 1000000000);
                    out.push(Unit { name: p.mods[ord[i]].name.name.clone(), text: pr.out });
                }
            }
            i = i + 1;
        }
        out
    }

    #[summary("<T: Copy, U: Copy + geo::Shape>, or nothing (ADR-0046)")]
    #[effects(alloc)]
    fn generics_str(gs: &[ast::TypeParam]) -> String {
        let mut s: String = String::new();
        if gs.len() == 0 {
            return s;
        }
        s.push_str("<");
        let mut i: usize = 0;
        while i < gs.len()
            decreases gs.len() - i,
        {
            if i > 0 {
                s.push_str(", ");
            }
            s.push_str(gs[i].name.name.as_str());
            let mut n: usize = 0;
            match &gs[i].fn_bound {
                None => {},
                Some(fb) => { s.push_str(": "); match &fb.kind { ast::FnTrait::Fn => s.push_str("Fn"), ast::FnTrait::FnMut => s.push_str("FnMut"), ast::FnTrait::FnOnce => s.push_str("FnOnce"), } s.push_str("("); s.push_str(types_str(fb.params.as_slice()).as_str()); s.push_str(")"); if !is_unit(&fb.ret) { s.push_str(" -> "); s.push_str(type_str(&fb.ret).as_str()); } n = 1; },
            }
            let mut k: usize = 0;
            while k < gs[i].bounds.len()
                decreases gs[i].bounds.len() - k,
            {
                if n == 0 {
                    s.push_str(": ");
                } else {
                    s.push_str(" + ");
                }
                n = 1;
                s.push_str(path_str(gs[i].bounds[k].as_slice()).as_str());
                k = k + 1;
            }
            i = i + 1;
        }
        s.push_str(">");
        s
    }

    #[summary("Whether e contains a struct expression outside a parenthesis-delimited argument list. f is the remaining depth")]
    #[effects(pure)]
    fn has_struct_lit(e: &ast::Expr, f: usize) -> bool
        decreases f,
    {
        if f == 0 {
            return false;
        }
        match &e.kind {
            ast::ExprKind::Int(iv, ir) => false,
            ast::ExprKind::Float(fb) => false,
            ast::ExprKind::ByteLit(by) => false,
            ast::ExprKind::ByteStr(bys) => false,
            ast::ExprKind::StrLit(st) => false,
            ast::ExprKind::CharLit(ch) => false,
            ast::ExprKind::Bool(bo) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(id) => false,
            ast::ExprKind::Call(ca) => false,
            ast::ExprKind::Method(me) => has_struct_lit(&*me.recv, f - 1),
            ast::ExprKind::Index(ib, ii) => has_struct_lit(&**ib, f - 1),
            ast::ExprKind::Unary(uo, ux) => has_struct_lit(&**ux, f - 1),
            ast::ExprKind::Binary(bop, bl, br) => has_struct_lit(&**bl, f - 1) || has_struct_lit(&**br, f - 1),
            ast::ExprKind::Ref(rm, rx) => has_struct_lit(&**rx, f - 1),
            ast::ExprKind::If(ife) => false,
            ast::ExprKind::Block(blk) => false,
            ast::ExprKind::Array(ar) => false,
            ast::ExprKind::Repeat(rp) => false,
            ast::ExprKind::Old(ox) => false,
            ast::ExprKind::Quant(qu) => false,
            ast::ExprKind::Trigger(tx) => false,
            ast::ExprKind::Closure(cl) => false,
            ast::ExprKind::StructLit(sl) => true,
            ast::ExprKind::Path(pa) => false,
            ast::ExprKind::Deref(dx) => has_struct_lit(&**dx, f - 1),
            ast::ExprKind::Field(fx, fnm) => has_struct_lit(&**fx, f - 1),
            ast::ExprKind::Match(ma) => false,
            ast::ExprKind::Return(rv) => false,
            ast::ExprKind::Try(tr) => has_struct_lit(&**tr, f - 1),
            ast::ExprKind::Loop(lp) => false,
            ast::ExprKind::Break(bk) => false,
            ast::ExprKind::Continue(co) => false,
            ast::ExprKind::Range(rg) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[summary("Whether any of the types is named name")]
    #[effects(pure)]
    fn has_type(ts: &[ast::TypeDef], name: &str) -> bool {
        let mut i: usize = 0;
        while i < ts.len()
            decreases ts.len() - i,
        {
            if ts[i].name.name == name {
                return true;
            }
            i = i + 1;
        }
        false
    }

    #[summary("Identity printer: holds the checker's tables and the full paths of traits. The unit and the reference texts are set at each print (names.unit, names.refs)")]
    #[effects(alloc)]
    fn identity(fns: table::Table<types::FnSig>, adts: table::Table<types::Adt>, tys: table::Table<ast::TypeKind>, traits: Vec<String>) -> Printer {
        Printer { out: String::new(), lens: Vec::new(), names: Names { mode: Mode::Identity, unit: String::new(), fns: fns, adts: adts, types: tys, traits: traits, refs: table::new::<RefRow>(), seen: Vec::new(), binders: table::new::<String>(), labels: table::new::<String>(), next: 0, next_label: 0 } }
    }

    #[summary("Head of the impl in which the function is checked and proved, empty text if none: the impl's type parameters and their bounds, then what precedes the path's last segment (the trait and type for a trait method or a trait impl function: the contract and refinement obligations hang on them)")]
    #[effects(alloc)]
    fn impl_head(sig: &types::FnSig) -> String {
        let n: usize = sig.path.len();
        if !(sig.impl_generics > 0 || n > 0 && sig.path.as_bytes()[0] == 60) {
            return String::new();
        }
        let mut cut_at: usize = n;
        let mut i: usize = n;
        let mut found: bool = false;
        while i >= 2 && !found
            invariant i <= n,
            decreases i,
        {
            if sig.path.as_bytes()[i - 1] == 58 && sig.path.as_bytes()[i - 2] == 58 {
                cut_at = i - 2;
                found = true;
            }
            i = i - 1;
        }
        if !found {
            return String::new();
        }
        let mut out: String = String::from("impl<");
        let mut g: usize = 0;
        while g < sig.impl_generics && g < sig.generics.len()
            decreases sig.generics.len() - g,
        {
            if g > 0 {
                out.push_str(", ");
            }
            out.push_str(sig.generics[g].name.as_str());
            out.push_str(": ");
            out.push_str(types::join(sig.generics[g].bounds.as_slice(), " + ").as_str());
            g = g + 1;
        }
        out.push_str("> ");
        out.push_str(lexer::cut(sig.path.as_str(), 0, cut_at).as_str());
        out.push_str("\n");
        out
    }

    #[summary("For each function position (key), the head of its impl: that of the first signature (in path order) at that position that is neither a built-in nor an instance (path ends with >)")]
    #[effects(alloc)]
    fn impl_heads(fns: &table::Table<types::FnSig>) -> table::Table<String> {
        let mut out: table::Table<String> = table::new::<String>();
        let total: usize = fns.len();
        let mut n: usize = 0;
        while n < total
            decreases total - n,
        {
            match fns.nth(n) {
                None => {},
                Some(at) => { let len: usize = fns.items[at].path.len(); let instance: bool = len > 0 && fns.items[at].path.as_bytes()[len - 1] == 62; if !fns.items[at].builtin && !instance { let key: String = body::span_key(fns.items[at].span); if !out.has(key.as_str()) { out.insert(key.as_str(), impl_head(&fns.items[at])); } } },
            }
            n = n + 1;
        }
        out
    }

    #[summary("Whether it is a self referring to a value captured by a closure: a self whose file is source::CAPTURE, or its old")]
    #[effects(pure)]
    fn is_capture_base(base: &ast::Expr) -> bool {
        match &base.kind {
            ast::ExprKind::Int(iv, ir) => false,
            ast::ExprKind::Float(fb) => false,
            ast::ExprKind::ByteLit(by) => false,
            ast::ExprKind::ByteStr(bys) => false,
            ast::ExprKind::StrLit(st) => false,
            ast::ExprKind::CharLit(ch) => false,
            ast::ExprKind::Bool(bo) => false,
            ast::ExprKind::Unit => false,
            ast::ExprKind::Var(id) => id.name == "self" && id.span.file == source::CAPTURE,
            ast::ExprKind::Call(ca) => false,
            ast::ExprKind::Method(me) => false,
            ast::ExprKind::Index(ib, ii) => false,
            ast::ExprKind::Unary(uo, ux) => false,
            ast::ExprKind::Binary(bop, bl, br) => false,
            ast::ExprKind::Ref(rm, rx) => false,
            ast::ExprKind::If(ife) => false,
            ast::ExprKind::Block(blk) => false,
            ast::ExprKind::Array(ar) => false,
            ast::ExprKind::Repeat(rp) => false,
            ast::ExprKind::Old(ox) => captured_self(&**ox),
            ast::ExprKind::Quant(qu) => false,
            ast::ExprKind::Trigger(tx) => false,
            ast::ExprKind::Closure(cl) => false,
            ast::ExprKind::StructLit(sl) => false,
            ast::ExprKind::Path(pa) => false,
            ast::ExprKind::Deref(dx) => false,
            ast::ExprKind::Field(fx, fnm) => false,
            ast::ExprKind::Match(ma) => false,
            ast::ExprKind::Return(rv) => false,
            ast::ExprKind::Try(tr) => false,
            ast::ExprKind::Loop(lp) => false,
            ast::ExprKind::Break(bk) => false,
            ast::ExprKind::Continue(co) => false,
            ast::ExprKind::Range(rg) => false,
            ast::ExprKind::Error => false,
        }
    }

    #[summary("Whether it is an integer conversion: the tree of T::try_from(x).unwrap(), whose canonical form is x as T (ADR-0095 A4) (T an integer type)")]
    #[effects(alloc)]
    fn is_cast(me: &ast::Method) -> bool {
        me.name.name == "unwrap" && me.args.len() == 0 && cast_name(&*me.recv).len() > 0
    }

    #[effects(pure)]
    fn is_some(o: &Option<ast::Expr>) -> bool {
        match o {
            None => false,
            Some(e) => true,
        }
    }

    #[effects(pure)]
    fn is_some_box(o: &Option<Box<ast::Expr>>) -> bool {
        match o {
            None => false,
            Some(e) => true,
        }
    }

    #[effects(pure)]
    fn is_some_text(o: &Option<String>) -> bool {
        match o {
            None => false,
            Some(s) => true,
        }
    }

    #[effects(pure)]
    fn is_unit(t: &ast::Type) -> bool {
        match &t.kind {
            ast::TypeKind::Int(it) => false,
            ast::TypeKind::F64 => false,
            ast::TypeKind::Bool => false,
            ast::TypeKind::Unit => true,
            ast::TypeKind::Char => false,
            ast::TypeKind::String => false,
            ast::TypeKind::Str => false,
            ast::TypeKind::Array(e, n) => false,
            ast::TypeKind::ArrayN(e, p) => false,
            ast::TypeKind::Slice(e) => false,
            ast::TypeKind::Ref(m, e) => false,
            ast::TypeKind::Named(np, a) => false,
            ast::TypeKind::Vec(e) => false,
            ast::TypeKind::Box(e) => false,
            ast::TypeKind::Param(s) => false,
            ast::TypeKind::Never => false,
            ast::TypeKind::Error => false,
        }
    }

    #[summary("Text with whitespace trimmed from both ends of each line, joined with one space")]
    #[effects(alloc)]
    fn joined_lines(text: &str) -> String {
        let mut o: String = String::new();
        let n: usize = text.len();
        let mut a: usize = 0;
        let mut i: usize = 0;
        let mut k: usize = 0;
        while i < n
            invariant a <= i,
            decreases n - i,
        {
            if text.as_bytes()[i] == 10 {
                if k > 0 {
                    o.push_str(" ");
                }
                o.push_str(trim(lexer::cut(text, a, i).as_str()).as_str());
                k = k.saturating_add(1);
                a = i + 1;
            }
            i = i + 1;
        }
        if a < n {
            if k > 0 {
                o.push_str(" ");
            }
            o.push_str(trim(lexer::cut(text, a, n).as_str()).as_str());
        }
        o
    }

    #[summary("Last segment of the path (after ::). The whole if there is no ::")]
    #[effects(alloc)]
    fn last_seg(path: &str) -> String {
        let n: usize = path.len();
        let mut i: usize = n;
        while i >= 2
            invariant i <= n,
            decreases i,
        {
            if path.as_bytes()[i - 1] == 58 && path.as_bytes()[i - 2] == 58 {
                return lexer::cut(path, i, n);
            }
            i = i - 1;
        }
        String::from(path)
    }

    #[summary("Stable sort order of the keys: a sequence of positions. Keys in byte lexicographic order")]
    #[effects(alloc)]
    fn order(keys: &[String]) -> Vec<usize> {
        std::slice::sort_indices::<String>(keys)
    }

    #[summary("Name that may be a type of this unit: the name if it is a type with a one-segment name regardless of arguments, otherwise empty text")]
    #[effects(alloc)]
    fn own_type(t: &ast::Type) -> String {
        match &t.kind {
            ast::TypeKind::Int(it) => String::new(),
            ast::TypeKind::F64 => String::new(),
            ast::TypeKind::Bool => String::new(),
            ast::TypeKind::Unit => String::new(),
            ast::TypeKind::Char => String::new(),
            ast::TypeKind::String => String::new(),
            ast::TypeKind::Str => String::new(),
            ast::TypeKind::Array(e, n) => String::new(),
            ast::TypeKind::ArrayN(e, p) => String::new(),
            ast::TypeKind::Slice(e) => String::new(),
            ast::TypeKind::Ref(m, e) => String::new(),
            ast::TypeKind::Named(np, a) => { if np.len() == 1 { np[0].clone() } else { String::new() } },
            ast::TypeKind::Vec(e) => String::new(),
            ast::TypeKind::Box(e) => String::new(),
            ast::TypeKind::Param(s) => String::new(),
            ast::TypeKind::Never => String::new(),
            ast::TypeKind::Error => String::new(),
        }
    }

    #[summary("x: T, y: U")]
    #[effects(alloc)]
    fn params_str(ps: &[ast::Param]) -> String {
        let mut s: String = String::new();
        let mut i: usize = 0;
        while i < ps.len()
            decreases ps.len() - i,
        {
            if i > 0 {
                s.push_str(", ");
            }
            s.push_str(ps[i].name.name.as_str());
            s.push_str(": ");
            s.push_str(type_str(&ps[i].ty).as_str());
            i = i + 1;
        }
        s
    }

    #[summary("(s)")]
    #[effects(alloc)]
    fn paren(s: &str) -> String {
        let mut o: String = String::from("(");
        o.push_str(s);
        o.push_str(")");
        o
    }

    #[effects(alloc)]
    fn pat_str(p: &ast::Pat) -> String {
        let mut s: String = path_str(p.path.as_slice());
        if !p.parens {
            return s;
        }
        s.push_str("(");
        let mut i: usize = 0;
        while i < p.binds.len()
            decreases p.binds.len() - i,
        {
            if i > 0 {
                s.push_str(", ");
            }
            match &p.binds[i] {
                None => s.push_str("_"),
                Some(b) => s.push_str(b.name.as_str()),
            }
            i = i + 1;
        }
        s.push_str(")");
        s
    }

    #[summary("Text joining the names with sep")]
    #[effects(alloc)]
    fn path_join(p: &[ast::Ident], sep: &str) -> String {
        let mut s: String = String::new();
        let mut i: usize = 0;
        while i < p.len()
            decreases p.len() - i,
        {
            if i > 0 {
                s.push_str(sep);
            }
            s.push_str(p[i].name.as_str());
            i = i + 1;
        }
        s
    }

    #[effects(alloc)]
    fn path_str(p: &[ast::Ident]) -> String {
        path_join(p, "::")
    }

    #[summary("Path (joined with ::) if the type with references and Box stripped is a named type, otherwise empty text")]
    #[effects(alloc)]
    fn peeled(t: &ast::TypeKind, f: usize) -> String
        decreases f,
    {
        if f == 0 {
            return String::new();
        }
        match t {
            ast::TypeKind::Int(it) => String::new(),
            ast::TypeKind::F64 => String::new(),
            ast::TypeKind::Bool => String::new(),
            ast::TypeKind::Unit => String::new(),
            ast::TypeKind::Char => String::new(),
            ast::TypeKind::String => String::new(),
            ast::TypeKind::Str => String::new(),
            ast::TypeKind::Array(e, n) => String::new(),
            ast::TypeKind::ArrayN(e, p) => String::new(),
            ast::TypeKind::Slice(e) => String::new(),
            ast::TypeKind::Ref(m, e) => peeled(&e.kind, f - 1),
            ast::TypeKind::Named(np, a) => types::join(np.as_slice(), "::"),
            ast::TypeKind::Vec(e) => String::new(),
            ast::TypeKind::Box(e) => peeled(&e.kind, f - 1),
            ast::TypeKind::Param(s) => String::new(),
            ast::TypeKind::Never => String::new(),
            ast::TypeKind::Error => String::new(),
        }
    }

    #[summary("Printer that prints as written")]
    #[effects(alloc)]
    fn plain() -> Printer {
        Printer { out: String::new(), lens: Vec::new(), names: Names { mode: Mode::Plain, unit: String::new(), fns: table::new::<types::FnSig>(), adts: table::new::<types::Adt>(), types: table::new::<ast::TypeKind>(), traits: Vec::new(), refs: table::new::<RefRow>(), seen: Vec::new(), binders: table::new::<String>(), labels: table::new::<String>(), next: 0, next_label: 0 } }
    }

    #[summary("Precedence of an expression. 0 is a form always parenthesized when nested (ADR-0019 §1)")]
    #[effects(alloc)]
    fn prec(e: &ast::Expr) -> u8 {
        match &e.kind {
            ast::ExprKind::Int(iv, ir) => 13,
            ast::ExprKind::Float(fb) => 13,
            ast::ExprKind::ByteLit(by) => 13,
            ast::ExprKind::ByteStr(bys) => 13,
            ast::ExprKind::StrLit(st) => 13,
            ast::ExprKind::CharLit(ch) => 13,
            ast::ExprKind::Bool(bo) => 13,
            ast::ExprKind::Unit => 13,
            ast::ExprKind::Var(id) => 13,
            ast::ExprKind::Call(ca) => 13,
            ast::ExprKind::Method(me) => { if is_cast(me) { 11 } else { 13 } },
            ast::ExprKind::Index(ib, ii) => 13,
            ast::ExprKind::Unary(uo, ux) => 12,
            ast::ExprKind::Binary(bop, bl, br) => bin_prec(bop),
            ast::ExprKind::Ref(rm, rx) => 12,
            ast::ExprKind::If(ife) => 0,
            ast::ExprKind::Block(blk) => 0,
            ast::ExprKind::Array(ar) => 13,
            ast::ExprKind::Repeat(rp) => 13,
            ast::ExprKind::Old(ox) => 13,
            ast::ExprKind::Quant(qu) => 0,
            ast::ExprKind::Trigger(tx) => 12,
            ast::ExprKind::Closure(cl) => 13,
            ast::ExprKind::StructLit(sl) => 13,
            ast::ExprKind::Path(pa) => 13,
            ast::ExprKind::Deref(dx) => 12,
            ast::ExprKind::Field(fx, fnm) => 13,
            ast::ExprKind::Match(ma) => 0,
            ast::ExprKind::Return(rv) => 0,
            ast::ExprKind::Try(tr) => 13,
            ast::ExprKind::Loop(lp) => 0,
            ast::ExprKind::Break(bk) => 0,
            ast::ExprKind::Continue(co) => 13,
            ast::ExprKind::Range(rg) => 13,
            ast::ExprKind::Error => 13,
        }
    }

    #[summary("Appends the type as written (stage0 check::ty_str). f is the remaining depth")]
    #[effects(alloc)]
    fn push_kind(out: &mut String, t: &ast::TypeKind, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match t {
            ast::TypeKind::Int(it) => ast::push_int_name(out, it),
            ast::TypeKind::F64 => out.push_str("f64"),
            ast::TypeKind::Bool => out.push_str("bool"),
            ast::TypeKind::Unit => out.push_str("()"),
            ast::TypeKind::Char => out.push_str("char"),
            ast::TypeKind::String => out.push_str("String"),
            ast::TypeKind::Str => out.push_str("str"),
            ast::TypeKind::Array(e, n) => { out.push_str("["); push_kind(out, &e.kind, f - 1); out.push_str("; "); std::num::push_u64(out, *n); out.push_str("]"); },
            ast::TypeKind::ArrayN(e, p) => { out.push_str("["); push_kind(out, &e.kind, f - 1); out.push_str("; "); let mut i: usize = 0; while i < p.len() decreases p.len() - i, { if i > 0 { out.push_str("::"); } out.push_str(p[i].as_str()); i = i + 1; } out.push_str("]"); },
            ast::TypeKind::Slice(e) => { out.push_str("["); push_kind(out, &e.kind, f - 1); out.push_str("]"); },
            ast::TypeKind::Ref(m, e) => { out.push_str("&"); if *m { out.push_str("mut "); } push_kind(out, &e.kind, f - 1); },
            ast::TypeKind::Named(np, a) => { let mut k: usize = 0; while k < np.len() decreases np.len() - k, { if k > 0 { out.push_str("::"); } out.push_str(np[k].as_str()); k = k + 1; } if a.len() > 0 { out.push_str("<"); let mut j: usize = 0; while j < a.len() decreases a.len() - j, { if j > 0 { out.push_str(", "); } push_kind(out, &a[j].kind, f - 1); j = j + 1; } out.push_str(">"); } },
            ast::TypeKind::Vec(e) => { out.push_str("Vec<"); push_kind(out, &e.kind, f - 1); out.push_str(">"); },
            ast::TypeKind::Box(e) => { out.push_str("Box<"); push_kind(out, &e.kind, f - 1); out.push_str(">"); },
            ast::TypeKind::Param(s) => out.push_str(s.as_str()),
            ast::TypeKind::Never => out.push_str("!"),
            ast::TypeKind::Error => out.push_str("{error}"),
        }
    }

    #[summary("Appends number n in decimal")]
    #[effects(alloc)]
    fn push_n(out: &mut String, n: usize) -> () {
        std::num::push_u64(out, n as u64);
    }

    #[summary("Appends the type as written. f is the remaining depth")]
    #[effects(alloc)]
    fn push_type(out: &mut String, t: &ast::Type, f: usize) -> () {
        push_kind(out, &t.kind, f);
    }

    #[summary("Line of one definition")]
    #[effects(alloc)]
    fn qual_row(path: String, unit: &str, d: &ast::FnDef, heads: &table::Table<String>, pr: &mut Printer) -> QualRow {
        let text: String = qualified_text(pr, heads, d, unit, true);
        let caller: String = caller_text(pr, heads, d, unit);
        QualRow { path: path, text: text, caller: caller }
    }

    #[summary("Qualified text of every definition with a body, in the order of body::defs_of (per unit, inner units first, then functions, functions of impl T, functions of trait impls, bodies of default methods)")]
    #[effects(alloc)]
    fn qual_rows(p: &ast::Program, fns: &table::Table<types::FnSig>) -> Vec<QualRow> {
        let mut by_span: table::Table<String> = table::new::<String>();
        let total: usize = fns.len();
        let mut n: usize = 0;
        while n < total
            decreases total - n,
        {
            match fns.nth(n) {
                None => {},
                Some(at) => { if fns.items[at].in_impl && body::impl_path(fns.items[at].path.as_str()) { by_span.insert(body::span_key(fns.items[at].span).as_str(), fns.items[at].path.clone()); } },
            }
            n = n + 1;
        }
        let heads: table::Table<String> = impl_heads(fns);
        let mut pr: Printer = qualifying(fns.clone(), "");
        let mut out: Vec<QualRow> = Vec::new();
        let mut i: usize = 0;
        while i < p.mods.len()
            decreases p.mods.len() - i,
        {
            qual_walk(&p.mods[i], "", &by_span, &heads, &mut pr, &mut out, 100000);
            i = i + 1;
        }
        out
    }

    #[effects(alloc)]
    fn qual_walk(m: &ast::Mod, prefix: &str, by_span: &table::Table<String>, heads: &table::Table<String>, pr: &mut Printer, out: &mut Vec<QualRow>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mp: String = types::cat3(prefix, m.name.name.as_str(), "");
        let sub: String = types::cat3(mp.as_str(), "::", "");
        let mut s: usize = 0;
        while s < m.mods.len()
            decreases m.mods.len() - s,
        {
            qual_walk(&m.mods[s], sub.as_str(), by_span, heads, pr, out, f - 1);
            s = s + 1;
        }
        let mut i: usize = 0;
        while i < m.fns.len()
            decreases m.fns.len() - i,
        {
            out.push(qual_row(types::cat3(sub.as_str(), m.fns[i].name.name.as_str(), ""), mp.as_str(), &m.fns[i], heads, pr));
            i = i + 1;
        }
        i = 0;
        while i < m.impls.len()
            decreases m.impls.len() - i,
        {
            let mut j: usize = 0;
            while j < m.impls[i].fns.len()
                decreases m.impls[i].fns.len() - j,
            {
                out.push(qual_row(types::cat7(sub.as_str(), m.impls[i].ty.name.as_str(), "::", m.impls[i].fns[j].name.name.as_str(), "", "", ""), mp.as_str(), &m.impls[i].fns[j], heads, pr));
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while i < m.trait_impls.len()
            decreases m.trait_impls.len() - i,
        {
            let mut j: usize = 0;
            while j < m.trait_impls[i].fns.len()
                decreases m.trait_impls[i].fns.len() - j,
            {
                match by_span.find(body::span_key(m.trait_impls[i].fns[j].span).as_str()) {
                    None => {},
                    Some(at) => out.push(qual_row(by_span.items[at].clone(), mp.as_str(), &m.trait_impls[i].fns[j], heads, pr)),
                }
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while i < m.traits.len()
            decreases m.traits.len() - i,
        {
            let mut j: usize = 0;
            while j < m.traits[i].fns.len()
                decreases m.traits[i].fns.len() - j,
            {
                if m.traits[i].fns[j].has_body {
                    out.push(qual_row(types::cat7(sub.as_str(), m.traits[i].name.name.as_str(), "::", m.traits[i].fns[j].f.name.name.as_str(), "", "", ""), mp.as_str(), &m.traits[i].fns[j].f, heads, pr));
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    #[summary("Qualified hashes of all definitions and type declarations, traits, trait impl heads, by path: what changed in a definition's own text (ADR-0019 §2). The commit reports this (workspace::Commit). rows is that of qual_rows")]
    #[effects(alloc)]
    fn qualified_hashes(p: &ast::Program, rows: &[QualRow]) -> table::Table<String> {
        let mut out: table::Table<String> = table::new::<String>();
        let mut i: usize = 0;
        while i < rows.len()
            decreases rows.len() - i,
        {
            out.insert(rows[i].path.as_str(), sha256::hex(rows[i].text.as_bytes()));
            i = i + 1;
        }
        i = 0;
        while i < p.mods.len()
            decreases p.mods.len() - i,
        {
            type_hashes(&p.mods[i], "", &mut out, 100000);
            i = i + 1;
        }
        i = 0;
        while i < p.mods.len()
            decreases p.mods.len() - i,
        {
            trait_hashes(&p.mods[i], "", &mut out, 100000);
            i = i + 1;
        }
        out
    }

    #[summary("Qualified normal form of one definition: other definitions by full path, its own name as _ (ADR-0019 §2). The incremental key reads it (ADR-0032); the identity hash does not (ADR-0059). pr is the qualified printer, heads is the table of impl_heads")]
    #[effects(alloc)]
    fn qualified_text(pr: &mut Printer, heads: &table::Table<String>, d: &ast::FnDef, unit: &str, with_body: bool) -> String {
        pr.out = match heads.find(body::span_key(d.span).as_str()) {
            None => String::new(),
            Some(at) => heads.items[at].clone(),
        };
        pr.names.unit = String::from(unit);
        pr.function(d, 0, "_", with_body, 1000000000);
        pr.out.clone()
    }

    #[summary("Type with the type names of unit mp (local) written as full paths (qualified normal form: T is mp::T). The insides of Vec and Box are left as is (same as stage0)")]
    #[effects(alloc)]
    fn qualify_type(t: &ast::Type, mp: &str, local: &[String], f: usize) -> ast::Type
        decreases f,
    {
        if f == 0 {
            return t.clone();
        }
        let kind: ast::TypeKind = match &t.kind {
            ast::TypeKind::Int(q4_tk_int0) => t.kind.clone(),
            ast::TypeKind::F64 => t.kind.clone(),
            ast::TypeKind::Bool => t.kind.clone(),
            ast::TypeKind::Unit => t.kind.clone(),
            ast::TypeKind::Char => t.kind.clone(),
            ast::TypeKind::String => t.kind.clone(),
            ast::TypeKind::Str => t.kind.clone(),
            ast::TypeKind::Array(e, n) => ast::TypeKind::Array(Box::new(qualify_type(&**e, mp, local, f - 1)), *n),
            ast::TypeKind::ArrayN(q4_tk_arrayn0, q4_tk_arrayn1) => t.kind.clone(),
            ast::TypeKind::Slice(e) => ast::TypeKind::Slice(Box::new(qualify_type(&**e, mp, local, f - 1))),
            ast::TypeKind::Ref(m, e) => ast::TypeKind::Ref(*m, Box::new(qualify_type(&**e, mp, local, f - 1))),
            ast::TypeKind::Named(np, a) => { let mut args: Vec<ast::Type> = Vec::new(); let mut i: usize = 0; while i < a.len() decreases a.len() - i, { args.push(qualify_type(&a[i], mp, local, f - 1)); i = i + 1; } if np.len() == 1 && types::has(local, np[0].as_str()) { let mut full: Vec<String> = Vec::new(); full.push(String::from(mp)); full.push(np[0].clone()); ast::TypeKind::Named(full, args) } else { ast::TypeKind::Named(np.clone(), args) } },
            ast::TypeKind::Vec(q4_tk_vec0) => t.kind.clone(),
            ast::TypeKind::Box(q4_tk_box0) => t.kind.clone(),
            ast::TypeKind::Param(q4_tk_param0) => t.kind.clone(),
            ast::TypeKind::Never => t.kind.clone(),
            ast::TypeKind::Error => t.kind.clone(),
        };
        ast::Type { kind: kind, span: t.span }
    }

    #[summary("Printer that prints the definitions of unit unit qualified (ADR-0019 §2): other definitions by full path")]
    #[effects(alloc)]
    fn qualifying(fns: table::Table<types::FnSig>, unit: &str) -> Printer {
        Printer { out: String::new(), lens: Vec::new(), names: Names { mode: Mode::Qualify, unit: String::from(unit), fns: fns, adts: table::new::<types::Adt>(), types: table::new::<ast::TypeKind>(), traits: Vec::new(), refs: table::new::<RefRow>(), seen: Vec::new(), binders: table::new::<String>(), labels: table::new::<String>(), next: 0, next_label: 0 } }
    }

    #[effects(pure)]
    fn radix_copy(r: &ast::Radix) -> ast::Radix {
        match r {
            ast::Radix::Dec => ast::Radix::Dec,
            ast::Radix::Hex => ast::Radix::Hex,
            ast::Radix::Oct => ast::Radix::Oct,
            ast::Radix::Bin => ast::Radix::Bin,
        }
    }

    #[summary("Result: (r: T) or T")]
    #[effects(alloc)]
    fn ret_str(r: &ast::Ret) -> String {
        match &r.name {
            None => type_str(&r.ty),
            Some(n) => { let mut s: String = String::from("("); s.push_str(n.name.as_str()); s.push_str(": "); s.push_str(type_str(&r.ty).as_str()); s.push_str(")"); s },
        }
    }

    #[summary("Text joining the names in byte lexicographic order with commas. If unique, the same name only once")]
    #[effects(alloc)]
    fn sorted_list(names: &[String], unique: bool) -> String {
        let ord: Vec<usize> = order(names);
        let mut s: String = String::new();
        let mut last: usize = names.len();
        let mut i: usize = 0;
        while i < ord.len()
            decreases ord.len() - i,
        {
            if ord[i] < names.len() {
                let mut skip: bool = false;
                if unique && last < names.len() {
                    skip = names[last] == names[ord[i]];
                }
                if !skip {
                    if last < names.len() {
                        s.push_str(", ");
                    }
                    s.push_str(names[ord[i]].as_str());
                    last = ord[i];
                }
            }
            i = i + 1;
        }
        s
    }

    #[summary("< or <<: operators whose left-hand conversion must be parenthesized")]
    #[effects(pure)]
    fn splits_cast(op: &ast::BinOp) -> bool {
        match op {
            ast::BinOp::Add => false,
            ast::BinOp::Sub => false,
            ast::BinOp::Mul => false,
            ast::BinOp::Div => false,
            ast::BinOp::Rem => false,
            ast::BinOp::Eq => false,
            ast::BinOp::Ne => false,
            ast::BinOp::Lt => true,
            ast::BinOp::Le => false,
            ast::BinOp::Gt => false,
            ast::BinOp::Ge => false,
            ast::BinOp::And => false,
            ast::BinOp::Or => false,
            ast::BinOp::Implies => false,
            ast::BinOp::BitAnd => false,
            ast::BinOp::BitOr => false,
            ast::BinOp::BitXor => false,
            ast::BinOp::Shl => true,
            ast::BinOp::Shr => false,
        }
    }

    #[summary("One line per trait (unit::Trait, its declaration) and per trait impl head (<unit::T as unit::Trait>, its parameters): so that the commit names every entry that put writes (ADR-0074 §5). Functions of an impl have their own lines")]
    #[effects(alloc)]
    fn trait_hashes(m: &ast::Mod, prefix: &str, out: &mut table::Table<String>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mp: String = types::cat3(prefix, m.name.name.as_str(), "");
        let sub: String = types::cat3(mp.as_str(), "::", "");
        let mut s: usize = 0;
        while s < m.mods.len()
            decreases m.mods.len() - s,
        {
            trait_hashes(&m.mods[s], sub.as_str(), out, f - 1);
            s = s + 1;
        }
        let mut i: usize = 0;
        while i < m.traits.len()
            decreases m.traits.len() - i,
        {
            let mut pr: Printer = plain();
            pr.trait_def(&m.traits[i], 0, 1000000000);
            out.insert(types::cat3(sub.as_str(), m.traits[i].name.name.as_str(), "").as_str(), sha256::hex(pr.out.as_bytes()));
            i = i + 1;
        }
        i = 0;
        while i < m.trait_impls.len()
            decreases m.trait_impls.len() - i,
        {
            let addr: String = trait_impl_address(mp.as_str(), m, &m.trait_impls[i]);
            let head: String = types::cat7("impl", generics_str(m.trait_impls[i].generics.as_slice()).as_str(), " ", addr.as_str(), "", "", "");
            out.insert(addr.as_str(), sha256::hex(head.as_bytes()));
            i = i + 1;
        }
    }

    #[summary("Address of trait impl i written in unit m (path mp), the name the checker gives its functions minus ::f (ADR-0074 §1): <mp::T as mp::Trait>. The trait is this unit's if it is one segment and a trait of m, otherwise as written; the unit's own type names by full path")]
    #[effects(alloc)]
    fn trait_impl_address(mp: &str, m: &ast::Mod, i: &ast::TraitImpl) -> String {
        let local: Vec<String> = type_names(m);
        let ty: String = type_str(&qualify_type(&i.self_ty, mp, local.as_slice(), 100000));
        let plain: String = path_str(i.trait_path.as_slice());
        let mut own: bool = false;
        let mut k: usize = 0;
        while k < m.traits.len()
            decreases m.traits.len() - k,
        {
            if m.traits[k].name.name == plain {
                own = true;
            }
            k = k + 1;
        }
        let tr: String = if i.trait_path.len() == 1 && own {
            types::cat3(mp, "::", plain.as_str())
        } else {
            plain
        };
        types::cat7("<", ty.as_str(), " as ", tr.as_str(), ">", "", "")
    }

    #[summary("Text with whitespace (Unicode) trimmed from both ends")]
    #[effects(alloc)]
    fn trim(s: &str) -> String {
        let mut start: usize = s.len();
        let mut end: usize = 0;
        let mut i: usize = 0;
        while i < s.len()
            decreases s.len() - i,
        {
            match std::str::decode_utf8(s, i) {
                None => { i = s.len(); },
                Some(dc) => { if dc.next <= i { i = s.len(); } else { if !unicode::whitespace(u32::from(dc.ch)) { if start > i { start = i; } end = dc.next; } i = dc.next; } },
            }
        }
        lexer::cut(s, start, end)
    }

    #[summary("Text with leading whitespace (Unicode) trimmed")]
    #[effects(alloc)]
    fn trim_start(s: &str) -> String {
        let mut i: usize = 0;
        while i < s.len()
            decreases s.len() - i,
        {
            match std::str::decode_utf8(s, i) {
                None => { return lexer::cut(s, i, s.len()); },
                Some(dc) => { if dc.next <= i || !unicode::whitespace(u32::from(dc.ch)) { return lexer::cut(s, i, s.len()); } i = dc.next; },
            }
        }
        String::new()
    }

    #[summary("Qualified hash of type declarations, by path. A type declaration is its own surface and its name is written as _ (ADR-0026 §6, as with definitions)")]
    #[effects(alloc)]
    fn type_hashes(m: &ast::Mod, prefix: &str, out: &mut table::Table<String>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        let mp: String = types::cat3(prefix, m.name.name.as_str(), "");
        let sub: String = types::cat3(mp.as_str(), "::", "");
        let mut s: usize = 0;
        while s < m.mods.len()
            decreases m.mods.len() - s,
        {
            type_hashes(&m.mods[s], sub.as_str(), out, f - 1);
            s = s + 1;
        }
        let local: Vec<String> = type_names(m);
        let mut i: usize = 0;
        while i < m.types.len()
            decreases m.types.len() - i,
        {
            let mut q: ast::TypeDef = m.types[i].clone();
            q.kind = match &m.types[i].kind {
                ast::TypeDefKind::Struct(fs) => { let mut qs: Vec<ast::Field> = Vec::new(); let mut a: usize = 0; while a < fs.len() decreases fs.len() - a, { qs.push(ast::Field { name: fs[a].name.clone(), ty: qualify_type(&fs[a].ty, mp.as_str(), local.as_slice(), 100000) }); a = a + 1; } ast::TypeDefKind::Struct(qs) },
                ast::TypeDefKind::Enum(vs) => { let mut qv: Vec<ast::Variant> = Vec::new(); let mut b: usize = 0; while b < vs.len() decreases vs.len() - b, { let mut ps: Vec<ast::Type> = Vec::new(); let mut c: usize = 0; while c < vs[b].payload.len() decreases vs[b].payload.len() - c, { ps.push(qualify_type(&vs[b].payload[c], mp.as_str(), local.as_slice(), 100000)); c = c + 1; } qv.push(ast::Variant { name: vs[b].name.clone(), payload: ps, span: vs[b].span }); b = b + 1; } ast::TypeDefKind::Enum(qv) },
            };
            let mut pr: Printer = plain();
            pr.type_def_as(&q, 0, "_");
            out.insert(types::cat3(sub.as_str(), m.types[i].name.name.as_str(), "").as_str(), sha256::hex(pr.out.as_bytes()));
            i = i + 1;
        }
    }

    #[summary("Names of the types declared in the unit")]
    #[effects(alloc)]
    fn type_names(m: &ast::Mod) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        let mut i: usize = 0;
        while i < m.types.len()
            decreases m.types.len() - i,
        {
            out.push(m.types[i].name.name.clone());
            i = i + 1;
        }
        out
    }

    #[effects(alloc)]
    fn type_str(t: &ast::Type) -> String {
        let mut s: String = String::new();
        push_type(&mut s, t, 100000);
        s
    }

    #[summary("Comma-joined types")]
    #[effects(alloc)]
    fn types_str(ts: &[ast::Type]) -> String {
        let mut s: String = String::new();
        let mut i: usize = 0;
        while i < ts.len()
            decreases ts.len() - i,
        {
            if i > 0 {
                s.push_str(", ");
            }
            push_type(&mut s, &ts[i], 100000);
            i = i + 1;
        }
        s
    }

    #[summary("Declaration position of variant name of the enum")]
    #[effects(pure)]
    fn variant_index(k: &types::AdtKind, name: &str) -> Option<usize> {
        match k {
            types::AdtKind::Struct(fs) => None,
            types::AdtKind::Enum(vs) => { let mut i: usize = 0; while i < vs.len() decreases vs.len() - i, { if vs[i].name == name { return Some(i); } i = i + 1; } None },
        }
    }

    #[summary("Copy of the definition without #[uses]")]
    #[effects(alloc)]
    fn without_uses(d: &ast::FnDef) -> ast::FnDef {
        let mut g: ast::FnDef = d.clone();
        let mut kept: Vec<ast::Attr> = Vec::new();
        let mut i: usize = 0;
        while i < d.attrs.len()
            decreases d.attrs.len() - i,
        {
            if d.attrs[i].name.name != "uses" {
                kept.push(d.attrs[i].clone());
            }
            i = i + 1;
        }
        g.attrs = kept;
        g
    }
}
