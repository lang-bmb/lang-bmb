#[summary("Entry points the commands call (port of stage0 compiler/src/lib.rs). Grows with each phase: for now dump tokens, dump parse, dump std, dump lower, dump decls, dump types, dump moves, dump lowered, dump layout, dump smt-decls, dump smt, dump smt-queries, check, verify, emit-llvm and build")]
mod lib {
    #[summary("One call the walk of a body finds (stage0 map::calls_in_expr): the path called, whether it is in specification context, and the position of the call")]
    struct CallAt { path: Vec<ast::Ident>, ghost: bool, span: source::Span }

    #[summary("Result of emit-llvm and build (stage0 LlvmOutput): built is whether the program checks, so that there is a module; ok whether it checks and every definition is proved; output the diagnostics and the status rows; ir the text of the module; todo the reasons for syntax not yet ported (if not empty, ir is not used); checks the runtime checks the module keeps because their obligation is not proved, outside the definitions compiled with every check (ADR-0029 §4); has_main whether the program has an entry point; hits and misses the proof cache's lookups; incr what the per-definition cache did, when the run went through it; cache_error and incr_error why the proof cache or the per-definition cache could not be written back, if it could not")]
    struct Emitted { built: bool, ok: bool, output: String, ir: String, todo: Vec<String>, checks: u32, has_main: bool, hits: usize, misses: usize, incr: Option<incremental::Stats>, cache_error: Option<String>, incr_error: Option<String> }

    #[summary("Result of bmb fmt: the Outcome of format, and for each given file the texts of the units it declares in name order, joined by one line (what fmt --check holds that file to, whatever the other files are; empty when not ok)")]
    struct Formatted { ok: bool, text: String, files: Vec<String> }

    #[summary("Result of the front end: the program as written (with library units attached) and its checked form")]
    struct Front { source: ast::Program, ck: body::Checked }

    #[summary("One source file: name and text")]
    struct Input { name: String, text: String }

    #[summary("Result of a command: if ok, the text to write to standard output, otherwise JSONL of diagnostics")]
    struct Outcome { ok: bool, text: String }

    #[summary("Result of bmb verify (stage0 VerifyOutput): ok when the program checks and every definition is proved; output is the diagnostics and the status rows; scripts holds per encoded definition (a) its script (b) as written before canonical symbols; hits and misses are the proof cache's lookups; missing names the definitions asked for that got no status; cache_error is why the proof cache could not be written back, if it could not; incr is what the per-definition cache did, when the run went through it, and incr_error why its file could not be written back, if it could not")]
    struct Proved { ok: bool, output: String, scripts: Vec<encode_terms::Pair>, hits: usize, misses: usize, missing: Vec<String>, cache_error: Option<String>, incr: Option<incremental::Stats>, incr_error: Option<String> }

    #[summary("The calls in block b (stage0 map::calls_in_block): the conditions of `assert` and `assume`, the invariants and measures of loops and `proof` blocks are specification context. f is the remaining depth")]
    #[effects(alloc)]
    fn calls_in_block(b: &ast::Block, ghost: bool, out: &mut Vec<CallAt>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..b.stmts.len()
            invariant 0 <= i && i <= b.stmts.len(),
        {
            match &b.stmts[i] {
                ast::Stmt::Let(l) => calls_in_expr(&l.init, ghost, out, f - 1),
                ast::Stmt::Assign(a) => { calls_in_expr(&a.target, ghost, out, f - 1); calls_in_expr(&a.value, ghost, out, f - 1); },
                ast::Stmt::While(w) => { calls_in_expr(&w.cond, ghost, out, f - 1); for k in 0..w.invariants.len() invariant 0 <= k && k <= w.invariants.len(), { calls_in_expr(&w.invariants[k], true, out, f - 1); } match &w.measure { None => {}, Some(m) => calls_in_expr(m, true, out, f - 1), } calls_in_block(&w.body, ghost, out, f - 1); },
                ast::Stmt::For(x) => { calls_in_expr(&x.lo, ghost, out, f - 1); calls_in_expr(&x.hi, ghost, out, f - 1); for k in 0..x.invariants.len() invariant 0 <= k && k <= x.invariants.len(), { calls_in_expr(&x.invariants[k], true, out, f - 1); } calls_in_block(&x.body, ghost, out, f - 1); },
                ast::Stmt::Assert(at) => calls_in_expr(&at.cond, true, out, f - 1),
                ast::Stmt::Assume(am) => calls_in_expr(&am.cond, true, out, f - 1),
                ast::Stmt::Proof(p) => calls_in_block(&p.body, true, out, f - 1),
                ast::Stmt::LetFields(lf) => calls_in_expr(&lf.init, ghost, out, f - 1),
                ast::Stmt::Expr(e) => calls_in_expr(e, ghost, out, f - 1),
            }
        }
        match &b.tail {
            None => {},
            Some(t) => calls_in_expr(&**t, ghost, out, f - 1),
        }
    }

    #[summary("The calls in expression e (stage0 map::calls_in_expr): a call and then those in its arguments; the bodies of quantifiers and the invariants and measures of loops are specification context, and closures are not walked. f is the remaining depth")]
    #[effects(alloc)]
    fn calls_in_expr(e: &ast::Expr, ghost: bool, out: &mut Vec<CallAt>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        match &e.kind {
            ast::ExprKind::Int(xv, xr) => {},
            ast::ExprKind::Float(xf) => {},
            ast::ExprKind::ByteLit(xb) => {},
            ast::ExprKind::ByteStr(xbs) => {},
            ast::ExprKind::StrLit(xs) => {},
            ast::ExprKind::CharLit(xc) => {},
            ast::ExprKind::Bool(xbo) => {},
            ast::ExprKind::Unit => {},
            ast::ExprKind::Var(var) => {},
            ast::ExprKind::Call(c) => { out.push(CallAt { path: c.path.clone(), ghost: ghost, span: e.span }); calls_in_exprs(c.args.as_slice(), ghost, out, f - 1); },
            ast::ExprKind::Method(m) => { calls_in_expr(&*m.recv, ghost, out, f - 1); calls_in_exprs(m.args.as_slice(), ghost, out, f - 1); },
            ast::ExprKind::Index(ib, ii) => { calls_in_expr(&**ib, ghost, out, f - 1); calls_in_expr(&**ii, ghost, out, f - 1); },
            ast::ExprKind::Unary(uo, ux) => calls_in_expr(&**ux, ghost, out, f - 1),
            ast::ExprKind::Binary(bo, bl, br) => { calls_in_expr(&**bl, ghost, out, f - 1); calls_in_expr(&**br, ghost, out, f - 1); },
            ast::ExprKind::Ref(rm, rx) => calls_in_expr(&**rx, ghost, out, f - 1),
            ast::ExprKind::If(ife) => { calls_in_expr(&*ife.cond, ghost, out, f - 1); calls_in_block(&ife.then, ghost, out, f - 1); match &ife.els { None => {}, Some(el) => calls_in_expr(&**el, ghost, out, f - 1), } },
            ast::ExprKind::Block(blk) => calls_in_block(blk, ghost, out, f - 1),
            ast::ExprKind::Array(arr) => calls_in_exprs(arr.as_slice(), ghost, out, f - 1),
            ast::ExprKind::Repeat(rp) => calls_in_expr(&*rp.value, ghost, out, f - 1),
            ast::ExprKind::Old(ox) => calls_in_expr(&**ox, ghost, out, f - 1),
            ast::ExprKind::Quant(qu) => calls_in_expr(&*qu.body, true, out, f - 1),
            ast::ExprKind::Trigger(tx) => calls_in_expr(&**tx, ghost, out, f - 1),
            ast::ExprKind::Closure(clo) => {},
            ast::ExprKind::StructLit(sl) => { for i in 0..sl.fields.len() invariant 0 <= i && i <= sl.fields.len(), { calls_in_expr(&sl.fields[i].value, ghost, out, f - 1); } },
            ast::ExprKind::Path(pa) => {},
            ast::ExprKind::Deref(dx) => calls_in_expr(&**dx, ghost, out, f - 1),
            ast::ExprKind::Field(fb, fname) => calls_in_expr(&**fb, ghost, out, f - 1),
            ast::ExprKind::Match(ma) => { calls_in_expr(&*ma.scrut, ghost, out, f - 1); for i in 0..ma.arms.len() invariant 0 <= i && i <= ma.arms.len(), { calls_in_expr(&ma.arms[i].body, ghost, out, f - 1); } },
            ast::ExprKind::Return(ret) => { match ret { None => {}, Some(rv) => calls_in_expr(&**rv, ghost, out, f - 1), } },
            ast::ExprKind::Try(trx) => calls_in_expr(&**trx, ghost, out, f - 1),
            ast::ExprKind::Loop(lo) => { for i in 0..lo.invariants.len() invariant 0 <= i && i <= lo.invariants.len(), { calls_in_expr(&lo.invariants[i], true, out, f - 1); } match &lo.measure { None => {}, Some(lm) => calls_in_expr(&**lm, true, out, f - 1), } calls_in_block(&lo.body, ghost, out, f - 1); },
            ast::ExprKind::Break(br2) => { match &br2.value { None => {}, Some(bv) => calls_in_expr(&**bv, ghost, out, f - 1), } },
            ast::ExprKind::Continue(cl) => {},
            ast::ExprKind::Range(ra) => { calls_in_expr(&*ra.lo, ghost, out, f - 1); calls_in_expr(&*ra.hi, ghost, out, f - 1); },
            ast::ExprKind::Error => {},
        }
    }

    #[summary("The calls in each expression of xs")]
    #[effects(alloc)]
    fn calls_in_exprs(xs: &[ast::Expr], ghost: bool, out: &mut Vec<CallAt>, f: usize) -> ()
        decreases f,
    {
        if f == 0 {
            return;
        }
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            calls_in_expr(&xs[i], ghost, out, f - 1);
        }
    }

    #[summary("bmb check: reads the files as one program and checks it. Diagnostics are JSONL, ok is false if there are errors")]
    #[effects(alloc)]
    fn check(files: &[Input]) -> Outcome {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let fe: Front = frontend(files, &mut sm, &mut diags);
        Outcome { ok: !diags.has_errors(), text: diags.to_jsonl(&sm) }
    }

    #[summary("The stage between the parser and the checker's body check, as text (stage0 lib::dump_stage): on a syntax error, diagnostics only, like dump parse. Otherwise the diagnostics so far, a --- line, the text of that stage. For now std (the normal form of the program with the library units it names added)")]
    #[effects(alloc)]
    #[uses(source::room, source::small)]
    fn dump_stage(stage: &str, files: &[Input], rlimit: u64) -> Outcome {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let mut mods: Vec<ast::Mod> = Vec::new();
        let mut k: usize = 0;
        while k < files.len()
            decreases files.len() - k,
        {
            if files[k].text.len() < 4294967295 && sm.files.len() < 4294967295 {
                let id: u32 = sm.add(files[k].name.clone(), files[k].text.clone());
                let toks: Vec<lexer::Token> = lexer::lex(id, files[k].text.as_str(), &mut diags);
                let p: ast::Program = parser::parse(toks, &mut diags, files[k].text.as_str());
                ast::append::<ast::Mod>(&mut mods, p.mods);
            }
            k = k + 1;
        }
        if diags.has_errors() {
            return Outcome { ok: false, text: diags.to_jsonl(&sm) };
        }
        let mut program: ast::Program = ast::Program { mods: mods };
        stdlib::add(&mut sm, &mut program, &mut diags);
        let mut body: String = String::new();
        if stage == "std" {
            push_units(&mut body, &program);
        } else if stage == "decls" {
            let lowered: closures::Lowered = closures::lower(&mut program, &mut diags);
            let consts: table::Table<consts::Const> = consts::resolve(&mut program, &mut diags);
            let mut c: decls::Checker = decls::new();
            c.collect(&program);
            for d in 0..c.diags.len()
                invariant 0 <= d && d <= c.diags.len(),
            {
                diags.push(c.diags[d].clone());
            }
            body.push_str(decls::dump(&c).as_str());
        } else if stage == "types" {
            let ck: body::Checked = body::check_resolved(program.clone(), &mut diags);
            push_tables(&mut body, &ck, &sm);
        } else if stage == "texts" {
            let tk: body::Checked = body::check_resolved(program.clone(), &mut diags);
            if !diags.has_errors() {
                push_texts(&mut body, &tk);
            }
        } else if stage == "lowered" {
            let lk: body::Checked = body::check_resolved(program.clone(), &mut diags);
            let low: lowered::Tables = lowered::tables(&lk);
            push_low(&mut body, &low, &sm);
        } else if stage == "layout" {
            let yk: body::Checked = body::check_resolved(program.clone(), &mut diags);
            if !diags.has_errors() {
                let ylow: lowered::Tables = lowered::tables(&yk);
                push_layout(&mut body, &yk, &ylow);
            }
        } else if stage == "smt-decls" {
            let sk: body::Checked = body::check_resolved(program.clone(), &mut diags);
            if !diags.has_errors() {
                body.push_str(encode_decls::dump(&sk).as_str());
            }
        } else if stage == "smt" {
            let ek: body::Checked = body::check_resolved(program.clone(), &mut diags);
            if !diags.has_errors() {
                body.push_str(encode_spec::dump(&ek).as_str());
            }
        } else if stage == "smt-queries" {
            let qk: body::Checked = body::check_resolved(program.clone(), &mut diags);
            if !diags.has_errors() {
                body.push_str(encode_query::dump(&qk, rlimit).as_str());
            }
        } else if stage == "moves" {
            let mk: body::Checked = body::check_resolved(program.clone(), &mut diags);
            push_moves(&mut body, &mk, &sm);
        } else {
            let lowered: closures::Lowered = closures::lower(&mut program, &mut diags);
            let consts: table::Table<consts::Const> = consts::resolve(&mut program, &mut diags);
            push_units(&mut body, &program);
            push_lowered(&mut body, &lowered, &consts, &sm);
        }
        let mut out: String = diags.to_jsonl(&sm);
        out.push_str("---\n");
        out.push_str(body.as_str());
        Outcome { ok: !diags.has_errors(), text: out }
    }

    #[summary("Tokens of the files as JSONL: the output the lexer's differential test compares")]
    #[effects(alloc)]
    #[uses(source::room, source::small)]
    fn dump_tokens(files: &[Input]) -> Outcome {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let mut out: String = String::new();
        let mut k: usize = 0;
        while k < files.len()
            decreases files.len() - k,
        {
            if files[k].text.len() < 4294967295 && sm.files.len() < 4294967295 {
                let id: u32 = sm.add(files[k].name.clone(), files[k].text.clone());
                let toks: Vec<lexer::Token> = lexer::lex(id, files[k].text.as_str(), &mut diags);
                let mut j: usize = 0;
                while j < toks.len()
                    decreases toks.len() - j,
                {
                    push_token(&mut out, files[k].name.as_str(), &toks[j]);
                    j = j + 1;
                }
            }
            k = k + 1;
        }
        if diags.has_errors() {
            return Outcome { ok: false, text: diags.to_jsonl(&sm) };
        }
        Outcome { ok: true, text: out }
    }

    #[summary("bmb emit-llvm and bmb build (stage0 lib::emit_llvm_sources_cached and emit_llvm_sources_with): checks the program and, when it checks, builds the module from the lowered tables. With all_checks the prover does not run and every obligation keeps its runtime check. Otherwise the program is proved first, through the caches in cache_dir when there is one (with audit, every reused proof and fragment of IR is computed again and compared), and the runtime check of an obligation is dropped when its proof is usable (usable_proofs). The module is built even when some obligations are not proved: those keep their checks")]
    #[effects(alloc, io, nondet)]
    fn emit_llvm(files: &[Input], all_checks: bool, cache_dir: &Option<String>, audit: bool) -> Emitted {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let fe: Front = frontend(files, &mut sm, &mut diags);
        if diags.has_errors() {
            return Emitted { built: false, ok: false, output: diags.to_jsonl(&sm), ir: String::new(), todo: Vec::new(), checks: 0, has_main: false, hits: 0, misses: 0, incr: None, cache_error: None, incr_error: None };
        }
        let low: lowered::Tables = lowered::tables(&fe.ck);
        if all_checks {
            let none: Vec<encode_spec::Trivial> = Vec::new();
            let mut no_incr: Option<incremental::Session> = None;
            let m: codegen::Module = codegen::emit(&fe.ck, &low, &codegen::proofs(none.as_slice()), &mut no_incr);
            let none_checked: Vec<String> = Vec::new();
            let has_main: bool = match &m.main {
                None => false,
                Some(x) => true,
            };
            return Emitted { built: true, ok: true, output: diags.to_jsonl(&sm), ir: m.ir, todo: m.todo, checks: kept_checks(&m.checks_by, none_checked.as_slice()), has_main: has_main, hits: 0, misses: 0, incr: None, cache_error: None, incr_error: None };
        }
        let mut store: Option<cache::ProofCache> = match cache_dir {
            None => None,
            Some(dir) => Some(cache::load(dir.as_str())),
        };
        let opts: prove::Opts = prove::Opts { only: None, bounded: false, seed: 0, rlimit: solver::rlimit(), query: solver::rlimit(), who: solver::Asker::Gate, stop: false };
        let pg: encode_spec::Prog = encode_spec::prog_of(&fe.ck);
        let mut incr: Option<incremental::Session> = match cache_dir {
            None => None,
            Some(dir0) => Some(incremental::new(dir0.as_str(), incremental::compiler_id().as_str(), &fe.ck, &pg.pr, &opts.only, false, audit)),
        };
        let mut z3: toolchain::Z3 = toolchain::new();
        let out: prove::Outcome = prove::run_cached(&fe.ck, &pg, &opts, &mut store, &mut incr, &mut z3, &mut diags);
        let mut hits: usize = 0;
        let mut misses: usize = 0;
        let mut cache_error: Option<String> = None;
        match &store {
            None => {},
            Some(c) => { hits = c.hits; misses = c.misses; match cache_dir { None => {}, Some(dir2) => { match cache::save(c, dir2.as_str()) { Ok(u) => {}, Err(why) => { cache_error = Some(why); }, } }, } },
        }
        let defs: Vec<codegen::Def> = codegen::sorted_defs(&fe.ck.program, &low);
        let usable: Vec<encode_spec::Trivial> = usable_proofs(&fe.ck, defs.as_slice(), &out);
        match &mut incr {
            None => {},
            Some(s0) => incremental::with_ir(s0, &fe.ck, &low, &sm),
        }
        let m2: codegen::Module = codegen::emit(&fe.ck, &low, &codegen::proofs(usable.as_slice()), &mut incr);
        let incr_error: Option<String> = incremental::save_slot(&mut incr);
        let mut output: String = diags.to_jsonl(&sm);
        output.push_str(prove::status_lines(out.statuses.as_slice(), &fe.ck).as_str());
        let mut ok: bool = !diags.has_errors();
        for j in 0..out.statuses.len()
            invariant 0 <= j && j <= out.statuses.len(),
        {
            if out.statuses[j].failed != 0 {
                ok = false;
            }
        }
        let has_main2: bool = match &m2.main {
            None => false,
            Some(y) => true,
        };
        Emitted { built: true, ok: ok, output: output, ir: m2.ir, todo: m2.todo, checks: kept_checks(&m2.checks_by, out.checked.as_slice()), has_main: has_main2, hits: hits, misses: misses, incr: incremental::stats_of(&incr), cache_error: cache_error, incr_error: incr_error }
    }

    #[summary("bmb examples (stage0 examples_sources): reads the files as one program, checks it and, when it checks, the examples of each named function's contract (examples::examples), as JSONL. Not ok with the diagnostics of a program that does not check, or with the line naming a path that is not an executable function")]
    #[effects(alloc, io, nondet)]
    fn examples(files: &[Input], defs: &[String], count: usize) -> Outcome {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let fe: Front = frontend(files, &mut sm, &mut diags);
        if diags.has_errors() {
            return Outcome { ok: false, text: diags.to_jsonl(&sm) };
        }
        match examples::examples(&fe.ck, defs, count) {
            Ok(found) => { let mut text: String = String::new(); for i in 0..found.len() invariant 0 <= i && i <= found.len(), { text.push_str(examples::jsonl(&found[i]).as_str()); } Outcome { ok: true, text: text } },
            Err(e) => Outcome { ok: false, text: types::cat2(e.as_str(), "\n") },
        }
    }

    #[summary("bmb fmt: normal form of the program (ADR-0019 §1), in unit name order with one line in between, and the same of each given file's units (Formatted). Method calls written as paths become method syntax (ADR-0051). Library units are not text of the program (ADR-0092 §1). If there are errors, emits only diagnostics and ok is false")]
    #[effects(alloc)]
    fn format(files: &[Input]) -> Formatted {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let fe: Front = frontend(files, &mut sm, &mut diags);
        if diags.has_errors() {
            return Formatted { ok: false, text: diags.to_jsonl(&sm), files: Vec::new() };
        }
        let normal: ast::Program = methodize::methodize(&fe.source, &fe.ck.program, &fe.ck.b.c.fns, &fe.ck.b.c.adts, &fe.ck.b.types);
        let units: Vec<fmt::Unit> = fmt::format_units(&normal);
        let mut each: Vec<String> = Vec::new();
        for k in 0..files.len()
            invariant each.len() == k,
        {
            each.push(String::new());
        }
        let mut out: String = String::new();
        let mut n: usize = 0;
        for i in 0..units.len()
            invariant 0 <= i && i <= units.len() && each.len() == files.len(),
        {
            if units[i].name != "std" {
                if n > 0 {
                    out.push_str("\n");
                }
                out.push_str(units[i].text.as_str());
                n = n.saturating_add(1);
                match unit_file(&normal, units[i].name.as_str()) {
                    None => {},
                    Some(f) => { if f < each.len() { if each[f].len() > 0 { each[f].push_str("\n"); } each[f].push_str(units[i].text.as_str()); } },
                }
            }
        }
        Formatted { ok: true, text: out, files: each }
    }

    #[summary("Normal form of the program as only read (not checked) from the files: the output the parser's differential test compares. Unit texts in name order with one blank line in between")]
    #[effects(alloc)]
    #[uses(source::room, source::small)]
    fn format_parsed(files: &[Input]) -> Outcome {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let mut mods: Vec<ast::Mod> = Vec::new();
        let mut k: usize = 0;
        while k < files.len()
            decreases files.len() - k,
        {
            if files[k].text.len() < 4294967295 && sm.files.len() < 4294967295 {
                let id: u32 = sm.add(files[k].name.clone(), files[k].text.clone());
                let toks: Vec<lexer::Token> = lexer::lex(id, files[k].text.as_str(), &mut diags);
                let p: ast::Program = parser::parse(toks, &mut diags, files[k].text.as_str());
                ast::append::<ast::Mod>(&mut mods, p.mods);
            }
            k = k + 1;
        }
        if diags.has_errors() {
            return Outcome { ok: false, text: diags.to_jsonl(&sm) };
        }
        let units: Vec<fmt::Unit> = fmt::format_units(&ast::Program { mods: mods });
        let mut out: String = String::new();
        let mut u: usize = 0;
        while u < units.len()
            decreases units.len() - u,
        {
            if u > 0 {
                out.push_str("\n");
            }
            out.push_str(units[u].text.as_str());
            u = u + 1;
        }
        Outcome { ok: true, text: out }
    }

    #[summary("Front end: reads the files as one program, attaches the library units it calls (ADR-0092 §1), and checks it (frontend of stage0 lib.rs)")]
    #[effects(alloc)]
    #[uses(source::room, source::small)]
    fn frontend(files: &[Input], sm: &mut source::SourceMap, diags: &mut diag::Diags) -> Front {
        let mut mods: Vec<ast::Mod> = Vec::new();
        let mut k: usize = 0;
        while k < files.len()
            decreases files.len() - k,
        {
            if files[k].text.len() < 4294967295 && sm.files.len() < 4294967295 {
                let id: u32 = sm.add(files[k].name.clone(), files[k].text.clone());
                let toks: Vec<lexer::Token> = lexer::lex(id, files[k].text.as_str(), diags);
                let p: ast::Program = parser::parse(toks, diags, files[k].text.as_str());
                ast::append::<ast::Mod>(&mut mods, p.mods);
            }
            k = k + 1;
        }
        let mut program: ast::Program = ast::Program { mods: mods };
        stdlib::add(sm, &mut program, diags);
        let ck: body::Checked = body::check_resolved(program.clone(), diags);
        Front { source: program, ck: ck }
    }

    #[summary("bmb hash (ADR-0059 §1): for each definition and type declaration, the identity and the hashes of body·surface in path order, as JSONL. If there are errors, emits only diagnostics and ok is false")]
    #[effects(alloc)]
    fn hash(files: &[Input]) -> Outcome {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let fe: Front = frontend(files, &mut sm, &mut diags);
        if diags.has_errors() {
            return Outcome { ok: false, text: diags.to_jsonl(&sm) };
        }
        let rows: Vec<identity::DefHash> = identity::hashes(&fe.ck.program, &fe.ck.b.c.fns, &fe.ck.b.c.adts, &fe.ck.b.types);
        let mut out: String = String::new();
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            out.push_str("{\"def\":");
            std::json::push_string(&mut out, rows[i].path.as_str());
            out.push_str(",\"id\":\"");
            out.push_str(rows[i].id.as_str());
            out.push_str("\",\"body\":\"");
            out.push_str(rows[i].body.as_str());
            out.push_str("\",\"iface\":\"");
            out.push_str(rows[i].iface.as_str());
            out.push_str("\"}\n");
        }
        Outcome { ok: true, text: out }
    }

    #[summary("Whether a name is held")]
    #[effects(pure)]
    fn is_some(o: &Option<String>) -> bool {
        match o {
            None => false,
            Some(x) => true,
        }
    }

    #[summary("The runtime checks of a module outside the definitions compiled with every check (stage0 sums checks_by over the definitions not in Outcome::checked: those checks are no missing proofs, ADR-0029 §4)")]
    #[effects(alloc)]
    fn kept_checks(by: &table::Table<u32>, checked: &[String]) -> u32 {
        let mut n: u32 = 0;
        for i in 0..by.len()
            invariant 0 <= i,
        {
            match by.nth(i) {
                None => {},
                Some(at) => { if !types::has(checked, by.key(i).as_str()) { n = n.saturating_add(by.items[at]); } },
            }
        }
        n
    }

    #[summary("The function a call names as the map resolves it (stage0 map::resolve): `f`, `T::f` of an impl function of the unit's type and `Trait::f` of a method of the unit's trait are local, any other path is as written")]
    #[effects(alloc)]
    fn map_resolve(path: &[ast::Ident], unit: &str, fns: &table::Table<types::FnSig>) -> String {
        let mut names: Vec<String> = Vec::new();
        for i in 0..path.len()
            invariant 0 <= i && i <= path.len(),
        {
            names.push(path[i].name.clone());
        }
        let plain: String = types::join(names.as_slice(), "::");
        let local: String = types::cat3(unit, "::", plain.as_str());
        match fns.find(local.as_str()) {
            None => plain,
            Some(at) => { if path.len() == 1 || path.len() == 2 && (fns.items[at].in_impl || is_some(&fns.items[at].trait_of)) { local } else { plain } },
        }
    }

    #[summary("The value of `--count` as Rust reads a usize (an optional `+`, then digits), when it is from 1 to 64")]
    #[effects(alloc)]
    fn parse_count(s: &str) -> Option<usize> {
        let digits: String = if encode_terms::starts_at(s, 0, "+") {
            lexer::cut(s, 1, s.len())
        } else {
            String::from(s)
        };
        if digits.len() == 0 {
            return None;
        }
        let mut n: usize = 0;
        for i in 0..digits.len()
            invariant 0 <= i && i <= digits.len() && n <= 64,
        {
            let b: u8 = digits.as_bytes()[i];
            if b < 48 || b > 57 {
                return None;
            }
            let d: usize = (b - 48) as usize;
            if n * 10 + d > 64 {
                return None;
            }
            n = n * 10 + d;
        }
        if n == 0 {
            None
        } else {
            Some(n)
        }
    }

    #[summary(",\"file\":..,\"lo\":..,\"hi\":..")]
    #[effects(alloc)]
    fn push_at(out: &mut String, s: source::Span, sm: &source::SourceMap) -> () {
        out.push_str(",\"file\":");
        sm.push_name(out, s.file);
        out.push_str(",\"lo\":");
        std::num::push_u64(out, s.lo as u64);
        out.push_str(",\"hi\":");
        std::num::push_u64(out, s.hi as u64);
    }

    #[summary("Appends v as 0x and sixteen hex digits")]
    #[effects(alloc)]
    fn push_bits(out: &mut String, v: u64) -> () {
        out.push_str("0x");
        let mut k: u64 = 16;
        while k > 0
            invariant k <= 16,
            decreases k,
        {
            k = k - 1;
            let d: u32 = (v >> 4 * k & 15) as u32;
            if d < 10 {
                lexer::push_code(out, 48 + d);
            } else {
                lexer::push_code(out, 87 + d);
            }
        }
    }

    #[summary("One table of drop places, one per line: {\"moves\":path,\"kind\":kind,place,\"names\":[..]} (names in recorded order)")]
    #[effects(alloc)]
    fn push_drops(out: &mut String, path: &str, kind: &str, t: &table::Table<Vec<String>>, sm: &source::SourceMap) -> () {
        let total: usize = t.len();
        for n in 0..total
            invariant 0 <= n && n <= total,
        {
            match t.nth(n) {
                None => {},
                Some(at) => { push_move_head(out, path, kind, t.key(n).as_str(), sm); out.push_str(",\"names\":["); for i in 0..t.items[at].len() invariant 0 <= i && i <= t.items[at].len(), { if i > 0 { out.push_str(","); } std::json::push_string(out, t.items[at][i].as_str()); } out.push_str("]}\n"); },
            }
        }
    }

    #[summary("[[name,type],..]")]
    #[effects(alloc)]
    fn push_fields(out: &mut String, fs: &[types::FieldSig]) -> () {
        out.push_str("[");
        for i in 0..fs.len()
            invariant 0 <= i && i <= fs.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            out.push_str("[");
            std::json::push_string(out, fs[i].name.as_str());
            out.push_str(",");
            std::json::push_string(out, types::text(&fs[i].ty).as_str());
            out.push_str("]");
        }
        out.push_str("]");
    }

    #[summary("\"file\":..,\"lo\":..,\"hi\":.. (the position of table key k)")]
    #[effects(alloc)]
    fn push_key(out: &mut String, k: &str, sm: &source::SourceMap) -> () {
        let s: source::Span = body::key_span(k);
        out.push_str("\"file\":");
        sm.push_name(out, s.file);
        out.push_str(",\"lo\":");
        std::num::push_u64(out, s.lo as u64);
        out.push_str(",\"hi\":");
        std::num::push_u64(out, s.hi as u64);
    }

    #[summary("Text of dump layout (stage0 codegen::dump_layout): for each type appearing in the tables, register type, memory type, size and alignment, predicates that hold, kind as an element. Then what the module header depends on (whether it mentions Vec, whether it has heap values, the entry point), a --- line, LLVM type definitions")]
    #[effects(alloc)]
    fn push_layout(out: &mut String, ck: &body::Checked, t: &lowered::Tables) -> () {
        let mut shapes: table::Table<ast::TypeKind> = table::new::<ast::TypeKind>();
        let no_extra: Vec<ast::TypeKind> = Vec::new();
        let all: Vec<ast::TypeKind> = codegen::all_types(t, no_extra.as_slice());
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            push_shape(&mut shapes, &all[i]);
        }
        let none: Vec<String> = Vec::new();
        let mut uses_vec: bool = false;
        for n in 0..shapes.len()
            invariant 0 <= n,
        {
            match shapes.nth(n) {
                None => {},
                Some(at) => { let lay: codegen::Lay = codegen::layout(&shapes.items[at], t); let kind: String = codegen::elem_kind(&shapes.items[at]); let mut is: Vec<String> = Vec::new(); if codegen::is_array(&shapes.items[at]) { is.push(String::from("array")); } if codegen::is_data(&shapes.items[at]) { is.push(String::from("data")); } if codegen::is_mem_elem(&shapes.items[at]) { is.push(String::from("mem_elem")); } if codegen::is_vec(&shapes.items[at]) { is.push(String::from("vec")); } if codegen::is_box(&shapes.items[at]) { is.push(String::from("box")); } if codegen::is_mem(&shapes.items[at]) { is.push(String::from("mem")); } if codegen::is_scalar_ty(&shapes.items[at]) { is.push(String::from("scalar")); } if codegen::holds_vec(&shapes.items[at], t) { is.push(String::from("holds_vec")); uses_vec = true; } if types::is_move_in(&lowered::value_ty(&shapes.items[at]), &t.adts, none.as_slice()) { is.push(String::from("move")); } if body::has_param(&shapes.items[at], 100000) { is.push(String::from("param")); } out.push_str("{\"of\":"); std::json::push_string(out, shapes.key(n).as_str()); out.push_str(",\"reg\":\""); out.push_str(codegen::llty(&shapes.items[at]).as_str()); out.push_str("\",\"mem\":"); std::json::push_string(out, codegen::mem_ty(&shapes.items[at]).as_str()); out.push_str(",\"size\":"); std::num::push_u64(out, lay.size); out.push_str(",\"align\":"); std::num::push_u64(out, lay.align); out.push_str(",\"is\":"); std::json::push_string(out, types::join(is.as_slice(), " ").as_str()); out.push_str(",\"elem_of\":"); std::json::push_string(out, types::text(&codegen::elem_of(&shapes.items[at])).as_str()); out.push_str(",\"elem\":{\"kind\":\""); out.push_str(kind.as_str()); out.push_str("\",\"mem\":\""); out.push_str(codegen::mem(kind.as_str()).as_str()); out.push_str("\",\"align\":"); std::num::push_u64(out, codegen::align(kind.as_str()) as u64); out.push_str("}}\n"); },
            }
        }
        out.push_str("{\"uses_vec\":");
        decls::push_bool(out, uses_vec);
        out.push_str(",\"uses_heap\":");
        decls::push_bool(out, codegen::uses_heap(t, uses_vec));
        out.push_str(",\"main\":");
        match codegen::entry(&ck.program, t) {
            None => out.push_str("null"),
            Some(m) => std::json::push_string(out, m.as_str()),
        }
        out.push_str("}\n---\n");
        out.push_str(codegen::type_defs(t, no_extra.as_slice()).as_str());
    }

    #[summary("Text of dump lowered (stage0 lib::dump_lowered): signatures of the lowered tables, data types, heads of trait impls, local variables, expression types, type arguments, places that are text, then for each type appearing in the tables the type with references stripped and the fields·variants of its instance")]
    #[effects(alloc)]
    fn push_low(out: &mut String, t: &lowered::Tables, sm: &source::SourceMap) -> () {
        let mut shapes: table::Table<ast::TypeKind> = table::new::<ast::TypeKind>();
        for n in 0..t.fns.len()
            invariant 0 <= n,
        {
            match t.fns.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"fn\":"); std::json::push_string(out, t.fns.key(n).as_str()); out.push_str(",\"params\":"); decls::push_types(out, t.fns.items[at].params.as_slice()); out.push_str(",\"ret\":"); std::json::push_string(out, types::text(&t.fns.items[at].ret).as_str()); out.push_str("}\n"); },
            }
        }
        for n in 0..t.adts.len()
            invariant 0 <= n,
        {
            match t.adts.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"adt\":"); std::json::push_string(out, t.adts.key(n).as_str()); match &t.adts.items[at].kind { types::AdtKind::Struct(fs) => { out.push_str(",\"kind\":\"struct\",\"body\":"); push_fields(out, fs.as_slice()); }, types::AdtKind::Enum(vs) => { out.push_str(",\"kind\":\"enum\",\"body\":"); push_variants(out, vs.as_slice()); }, } out.push_str("}\n"); },
            }
        }
        for i in 0..t.trait_impls.len()
            invariant 0 <= i && i <= t.trait_impls.len(),
        {
            out.push_str("{\"impl\":");
            std::json::push_string(out, t.trait_impls[i].trait_path.as_str());
            out.push_str(",\"for\":");
            std::json::push_string(out, types::text(&t.trait_impls[i].head).as_str());
            out.push_str("}\n");
        }
        for n in 0..t.locals.len()
            invariant 0 <= n,
        {
            match t.locals.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"locals\":"); std::json::push_string(out, t.locals.key(n).as_str()); out.push_str(",\"vars\":["); for v in 0..t.locals.items[at].len() invariant 0 <= v, { match t.locals.items[at].nth(v) { None => {}, Some(i) => { if v > 0 { out.push_str(","); } out.push_str("["); std::json::push_string(out, t.locals.items[at].key(v).as_str()); out.push_str(","); std::json::push_string(out, types::text(&t.locals.items[at].items[i]).as_str()); out.push_str("]"); }, } } out.push_str("]}\n"); },
            }
        }
        for n in 0..t.types.len()
            invariant 0 <= n,
        {
            match t.types.nth(n) {
                None => {},
                Some(at) => { out.push_str("{"); push_key(out, t.types.key(n).as_str(), sm); out.push_str(",\"type\":"); std::json::push_string(out, types::text(&t.types.items[at]).as_str()); out.push_str("}\n"); push_shape(&mut shapes, &t.types.items[at]); },
            }
        }
        for n in 0..t.targs.len()
            invariant 0 <= n,
        {
            match t.targs.nth(n) {
                None => {},
                Some(at) => { out.push_str("{"); push_key(out, t.targs.key(n).as_str(), sm); out.push_str(",\"targs\":"); decls::push_types(out, t.targs.items[at].as_slice()); out.push_str("}\n"); },
            }
        }
        for i in 0..t.text.len()
            invariant 0 <= i,
        {
            out.push_str("{");
            push_key(out, t.text.key(i).as_str(), sm);
            out.push_str(",\"text\":true}\n");
        }
        for n in 0..t.locals.len()
            invariant 0 <= n,
        {
            match t.locals.nth(n) {
                None => {},
                Some(at) => { for v in 0..t.locals.items[at].len() invariant 0 <= v, { match t.locals.items[at].nth(v) { None => {}, Some(i) => push_shape(&mut shapes, &t.locals.items[at].items[i]), } } },
            }
        }
        for n in 0..t.fns.len()
            invariant 0 <= n,
        {
            match t.fns.nth(n) {
                None => {},
                Some(at) => { if !t.fns.items[at].builtin { for k in 0..t.fns.items[at].params.len() invariant 0 <= k && k <= t.fns.items[at].params.len(), { push_shape(&mut shapes, &t.fns.items[at].params[k]); } push_shape(&mut shapes, &t.fns.items[at].ret); } },
            }
        }
        for n in 0..shapes.len()
            invariant 0 <= n,
        {
            match shapes.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"of\":"); std::json::push_string(out, shapes.key(n).as_str()); out.push_str(",\"value\":"); std::json::push_string(out, types::text(&lowered::value_ty(&shapes.items[at])).as_str()); match lowered::struct_fields(&shapes.items[at], t) { None => {}, Some(sf) => { out.push_str(",\"fields\":"); push_fields(out, sf.as_slice()); }, } match lowered::enum_variants(&shapes.items[at], t) { None => {}, Some(ev) => { out.push_str(",\"variants\":"); push_variants(out, ev.as_slice()); }, } out.push_str("}\n"); },
            }
        }
    }

    #[summary("Names made by lowering, places where a function value is passed, consts and their values, one per line (dump lower)")]
    #[effects(alloc)]
    fn push_lowered(out: &mut String, lowered: &closures::Lowered, consts: &table::Table<consts::Const>, sm: &source::SourceMap) -> () {
        for i in 0..lowered.names.len() {
            let path: String = lowered.names.key(i);
            out.push_str("{\"made\":");
            std::json::push_string(out, path.as_str());
            out.push_str(",\"name\":");
            match lowered.names.nth(i) {
                None => {},
                Some(j) => std::json::push_string(out, lowered.names.items[j].as_str()),
            }
            match lowered.at.find(path.as_str()) {
                None => {},
                Some(k) => push_at(out, lowered.at.items[k], sm),
            }
            out.push_str("}\n");
        }
        for p in 0..lowered.passes.len() {
            out.push_str("{\"passes\":");
            std::json::push_string(out, lowered.passes[p].what.as_str());
            push_at(out, lowered.passes[p].span, sm);
            out.push_str("}\n");
        }
        for c in 0..consts.len() {
            out.push_str("{\"const\":");
            std::json::push_string(out, consts.key(c).as_str());
            match consts.nth(c) {
                None => {},
                Some(ci) => { out.push_str(",\"unit\":"); std::json::push_string(out, consts.items[ci].unit.as_str()); out.push_str(",\"type\":"); std::json::push_string(out, consts::kind_text(&consts.items[ci].ty).as_str()); out.push_str(",\"value\":"); match &consts.items[ci].value { None => out.push_str("null"), Some(v) => std::json::push_string(out, consts::value_text(v).as_str()), } },
            }
            out.push_str("}\n");
        }
    }

    #[summary("{\"moves\":path,\"kind\":kind,place")]
    #[effects(alloc)]
    fn push_move_head(out: &mut String, path: &str, kind: &str, k: &str, sm: &source::SourceMap) -> () {
        out.push_str("{\"moves\":");
        std::json::push_string(out, path);
        out.push_str(",\"kind\":\"");
        out.push_str(kind);
        out.push_str("\",");
        push_key(out, k, sm);
    }

    #[summary("Drop places per function, one per line (moves of stage0 check::dump_tables, bmb dump moves)")]
    #[effects(alloc)]
    fn push_moves(out: &mut String, ck: &body::Checked, sm: &source::SourceMap) -> () {
        let total: usize = ck.b.needs.len();
        for n in 0..total
            invariant 0 <= n && n <= total,
        {
            match ck.b.needs.nth(n) {
                None => {},
                Some(at) => { let path: String = ck.b.needs.key(n); push_drops(out, path.as_str(), "drops", &ck.b.needs.items[at].moves.drops, sm); push_drops(out, path.as_str(), "arm_drops", &ck.b.needs.items[at].moves.arm_drops, sm); push_drops(out, path.as_str(), "partial_replaces", &ck.b.needs.items[at].moves.partial_replaces, sm); push_drops(out, path.as_str(), "exits", &ck.b.needs.items[at].moves.exits, sm); push_drops(out, path.as_str(), "branch_drops", &ck.b.needs.items[at].moves.branch_drops, sm); push_places(out, path.as_str(), "replaces", ck.b.needs.items[at].moves.replaces.as_slice(), sm); push_places(out, path.as_str(), "consumed", ck.b.needs.items[at].moves.consumed.as_slice(), sm); },
            }
        }
    }

    #[summary("Names in order as a JSON array")]
    #[effects(alloc)]
    fn push_names(out: &mut String, xs: &[String]) -> () {
        let sorted: Vec<String> = decls::sorted(xs);
        out.push_str("[");
        for i in 0..sorted.len()
            invariant 0 <= i && i <= sorted.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            std::json::push_string(out, sorted[i].as_str());
        }
        out.push_str("]");
    }

    #[summary("A set of places, one per line in place order")]
    #[effects(alloc)]
    fn push_places(out: &mut String, path: &str, kind: &str, keys: &[String], sm: &source::SourceMap) -> () {
        let sorted: Vec<String> = decls::sorted(keys);
        for i in 0..sorted.len()
            invariant 0 <= i && i <= sorted.len(),
        {
            push_move_head(out, path, kind, sorted[i].as_str(), sm);
            out.push_str("}\n");
        }
    }

    #[summary("Adds type x by its text to shapes: left as is if the same text exists")]
    #[effects(alloc)]
    fn push_shape(shapes: &mut table::Table<ast::TypeKind>, x: &ast::TypeKind) -> () {
        let k: String = types::text(x);
        if !shapes.has(k.as_str()) {
            shapes.insert(k.as_str(), x.clone());
        }
    }

    #[summary("Tables computed by the body check, as text (stage0 check::dump_tables, bmb dump types): normal form of the resolved program, then local variables, expression types, type arguments, calls, effects, recursion, external bodies, definitions that may be untrusted, constants read, one per line")]
    #[effects(alloc)]
    fn push_tables(out: &mut String, ck: &body::Checked, sm: &source::SourceMap) -> () {
        let units: Vec<fmt::Unit> = fmt::format_units(&ck.program);
        for u in 0..units.len()
            invariant 0 <= u && u <= units.len(),
        {
            out.push_str(units[u].text.as_str());
            out.push_str("\n");
        }
        let locals: usize = ck.b.locals.len();
        for n in 0..locals
            invariant 0 <= n && n <= locals,
        {
            match ck.b.locals.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"locals\":"); std::json::push_string(out, ck.b.locals.key(n).as_str()); out.push_str(",\"vars\":["); let vars: usize = ck.b.locals.items[at].len(); for v in 0..vars invariant 0 <= v && v <= vars, { match ck.b.locals.items[at].nth(v) { None => {}, Some(i) => { if v > 0 { out.push_str(","); } out.push_str("["); std::json::push_string(out, ck.b.locals.items[at].key(v).as_str()); out.push_str(","); std::json::push_string(out, types::text(&ck.b.locals.items[at].items[i]).as_str()); out.push_str("]"); }, } } out.push_str("]}\n"); },
            }
        }
        let typed: usize = ck.b.types.len();
        for n in 0..typed
            invariant 0 <= n && n <= typed,
        {
            match ck.b.types.nth(n) {
                None => {},
                Some(at) => { out.push_str("{"); push_key(out, ck.b.types.key(n).as_str(), sm); out.push_str(",\"type\":"); std::json::push_string(out, types::text(&ck.b.types.items[at]).as_str()); out.push_str("}\n"); },
            }
        }
        let with_targs: usize = ck.b.targs.len();
        for n in 0..with_targs
            invariant 0 <= n && n <= with_targs,
        {
            match ck.b.targs.nth(n) {
                None => {},
                Some(at) => { out.push_str("{"); push_key(out, ck.b.targs.key(n).as_str(), sm); out.push_str(",\"targs\":["); for i in 0..ck.b.targs.items[at].len() invariant 0 <= i && i <= ck.b.targs.items[at].len(), { if i > 0 { out.push_str(","); } std::json::push_string(out, types::text(&ck.b.targs.items[at][i]).as_str()); } out.push_str("]}\n"); },
            }
        }
        let callers: usize = ck.b.calls.len();
        for n in 0..callers
            invariant 0 <= n && n <= callers,
        {
            match ck.b.calls.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"calls\":"); std::json::push_string(out, ck.b.calls.key(n).as_str()); out.push_str(",\"to\":"); push_names(out, ck.b.calls.items[at].as_slice()); out.push_str("}\n"); },
            }
        }
        let needing: usize = ck.b.needs.len();
        for n in 0..needing
            invariant 0 <= n && n <= needing,
        {
            match ck.b.needs.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"needs\":"); std::json::push_string(out, ck.b.needs.key(n).as_str()); out.push_str(",\"own\":"); std::json::push_string(out, types::e_text(ck.b.needs.items[at].own).as_str()); out.push_str(",\"body\":"); std::json::push_string(out, types::e_text(ck.b.needs.items[at].body).as_str()); out.push_str("}\n"); },
            }
        }
        let recursive: usize = ck.b.recursive.len();
        for n in 0..recursive
            invariant 0 <= n && n <= recursive,
        {
            match ck.b.recursive.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"recursive\":"); std::json::push_string(out, ck.b.recursive.key(n).as_str()); out.push_str(",\"scc\":"); std::num::push_u64(out, ck.b.recursive.items[at] as u64); out.push_str("}\n"); },
            }
        }
        let external: Vec<String> = decls::sorted(ck.b.external.as_slice());
        for i in 0..external.len()
            invariant 0 <= i && i <= external.len(),
        {
            out.push_str("{\"external\":");
            std::json::push_string(out, external[i].as_str());
            out.push_str("}\n");
        }
        for i in 0..ck.untrusted.len()
            invariant 0 <= i && i <= ck.untrusted.len(),
        {
            out.push_str("{\"untrusted\":");
            std::json::push_string(out, ck.untrusted[i].as_str());
            out.push_str("}\n");
        }
        let reading: usize = ck.b.const_reads.len();
        for n in 0..reading
            invariant 0 <= n && n <= reading,
        {
            match ck.b.const_reads.nth(n) {
                None => {},
                Some(at) => { out.push_str("{\"reads\":"); std::json::push_string(out, ck.b.const_reads.key(n).as_str()); out.push_str(",\"consts\":"); push_names(out, ck.b.const_reads.items[at].as_slice()); out.push_str("}\n"); },
            }
        }
    }

    #[summary("Text of dump texts: for each definition the qualified normal form and the surface the caller reads, then for each item the qualified hash")]
    #[effects(alloc)]
    fn push_texts(out: &mut String, ck: &body::Checked) -> () {
        let rows: Vec<fmt::QualRow> = fmt::qual_rows(&ck.program, &ck.b.c.fns);
        for i in 0..rows.len()
            invariant 0 <= i && i <= rows.len(),
        {
            out.push_str("{\"def\":");
            std::json::push_string(out, rows[i].path.as_str());
            out.push_str(",\"text\":");
            std::json::push_string(out, rows[i].text.as_str());
            out.push_str(",\"caller\":");
            std::json::push_string(out, rows[i].caller.as_str());
            out.push_str("}\n");
        }
        let hashes: table::Table<String> = fmt::qualified_hashes(&ck.program, rows.as_slice());
        let total: usize = hashes.len();
        for n in 0..total
            invariant 0 <= n && n <= total,
        {
            match hashes.nth(n as usize) {
                None => {},
                Some(at) => { out.push_str("{\"item\":"); std::json::push_string(out, hashes.key(n as usize).as_str()); out.push_str(",\"hash\":\""); out.push_str(hashes.items[at].as_str()); out.push_str("\"}\n"); },
            }
        }
    }

    #[summary("JSON line of one token")]
    #[effects(alloc)]
    fn push_token(out: &mut String, name: &str, t: &lexer::Token) -> () {
        out.push_str("{\"file\":");
        std::json::push_string(out, name);
        out.push_str(",\"lo\":");
        std::num::push_u64(out, t.span.lo as u64);
        out.push_str(",\"hi\":");
        std::num::push_u64(out, t.span.hi as u64);
        out.push_str(",\"kind\":\"");
        match &t.tok {
            lexer::Tok::Ident(x) => { out.push_str("ident\",\"text\":"); std::json::push_string(out, x.as_str()); },
            lexer::Tok::Int(v, r) => { out.push_str("int\",\"text\":"); std::json::push_string(out, ast::radix_text(*r, *v).as_str()); out.push_str(",\"value\":\""); out.push_str(ast::radix_text(ast::Radix::Dec, *v).as_str()); out.push_str("\""); },
            lexer::Tok::Float(b) => { out.push_str("float\",\"text\":"); std::json::push_string(out, lexer::float_text(*b).as_str()); out.push_str(",\"bits\":\""); push_bits(out, *b); out.push_str("\""); },
            lexer::Tok::Str(x) => { out.push_str("str\",\"text\":"); std::json::push_string(out, x.as_str()); },
            lexer::Tok::Char(c) => { out.push_str("char\",\"value\":"); std::num::push_u64(out, *c as u64); },
            lexer::Tok::Byte(y) => { out.push_str("byte\",\"value\":"); std::num::push_u64(out, *y as u64); },
            lexer::Tok::Bytes(bs) => { out.push_str("bytes\",\"value\":["); let mut i: usize = 0; while i < bs.len() decreases bs.len() - i, { if i > 0 { out.push(','); } std::num::push_u64(out, bs[i] as u64); i = i + 1; } out.push(']'); },
            lexer::Tok::P(x) => { out.push_str("punct\",\"text\":"); std::json::push_string(out, x.as_str()); },
            lexer::Tok::Label(x) => { out.push_str("label\",\"text\":"); std::json::push_string(out, x.as_str()); },
            lexer::Tok::Eof => out.push_str("eof\""),
        }
        out.push_str("}\n");
    }

    #[summary("Normal forms of the units in name order, with one blank line in between")]
    #[effects(alloc)]
    fn push_units(out: &mut String, p: &ast::Program) -> () {
        let units: Vec<fmt::Unit> = fmt::format_units(p);
        let mut u: usize = 0;
        while u < units.len()
            decreases units.len() - u,
        {
            if u > 0 {
                out.push_str("\n");
            }
            out.push_str(units[u].text.as_str());
            u = u + 1;
        }
    }

    #[summary("[[name,[type,..]],..]")]
    #[effects(alloc)]
    fn push_variants(out: &mut String, vs: &[types::VariantSig]) -> () {
        out.push_str("[");
        for i in 0..vs.len()
            invariant 0 <= i && i <= vs.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            out.push_str("[");
            std::json::push_string(out, vs[i].name.as_str());
            out.push_str(",");
            decls::push_types(out, vs[i].tys.as_slice());
            out.push_str("]");
        }
        out.push_str("]");
    }

    #[summary("Index of the given file that declares the top-level unit of this name (its span's file), if a unit has the name")]
    #[effects(pure)]
    fn unit_file(p: &ast::Program, name: &str) -> Option<usize> {
        for m in 0..p.mods.len()
            invariant 0 <= m && m <= p.mods.len(),
        {
            if p.mods[m].name.name == name {
                return Some(p.mods[m].span.file as usize);
            }
        }
        None
    }

    #[summary("The proved obligations whose runtime checks may be dropped (stage0 usable_proofs). A proof assumes the function's `requires` (established by its callers), its callees' `ensures` (proved by them, under their own callees), and earlier facts in the same function, so a proof is usable only when every definition connected to its own by calls, in either direction, is fully proved: the calls of executable code to functions that are no lemmas (stage0's `calls` edges of the map, a trait call with a known `Self` naming its impl's function) join defs into components, and every obligation inside the text of a definition whose component holds a definition with a failure keeps its check")]
    #[effects(alloc)]
    fn usable_proofs(ck: &body::Checked, defs: &[codegen::Def], out: &prove::Outcome) -> Vec<encode_spec::Trivial> {
        let mut index: table::Table<usize> = table::new::<usize>();
        let mut adj: Vec<Vec<usize>> = Vec::new();
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            index.insert(defs[i].path.as_str(), i);
            adj.push(Vec::new());
        }
        for i in 0..defs.len()
            invariant 0 <= i && i <= defs.len(),
        {
            if body::is_exec(defs[i].d.kind) {
                let mut calls: Vec<CallAt> = Vec::new();
                calls_in_block(&defs[i].d.body, false, &mut calls, 1000000000);
                for c in 0..calls.len()
                    invariant 0 <= c && c <= calls.len(),
                {
                    if !calls[c].ghost {
                        let mut to: String = map_resolve(calls[c].path.as_slice(), defs[i].unit.as_str(), &ck.b.c.fns);
                        match ck.b.targs.find(body::span_key(calls[c].span).as_str()) {
                            None => {},
                            Some(ta) => { match body::dispatch(&ck.b.c.fns, ck.b.c.trait_impls.as_slice(), to.as_str(), ck.b.targs.items[ta].as_slice()) { None => {}, Some(dd) => { to = dd.path.clone(); }, } },
                        }
                        match ck.b.c.fns.find(to.as_str()) {
                            None => {},
                            Some(sa) => { if !body::is_proof(ck.b.c.fns.items[sa].kind) { match index.find(to.as_str()) { None => {}, Some(j) => { let k: usize = index.items[j]; if k < adj.len() && i < adj.len() { adj[i].push(k); adj[k].push(i); } }, } } },
                        }
                    }
                }
            }
        }
        let mut broken: Vec<bool> = Vec::new();
        for b in 0..defs.len()
            invariant 0 <= b && b <= defs.len(),
        {
            broken.push(false);
        }
        let mut todo: Vec<usize> = Vec::new();
        for s in 0..out.statuses.len()
            invariant 0 <= s && s <= out.statuses.len(),
        {
            if out.statuses[s].failed > 0 {
                match index.find(out.statuses[s].path.as_str()) {
                    None => {},
                    Some(at) => { let k2: usize = index.items[at]; if k2 < broken.len() && !broken[k2] { broken[k2] = true; todo.push(k2); } },
                }
            }
        }
        let mut fuel: usize = 1000000000;
        while todo.len() > 0 && fuel > 0
            decreases fuel,
        {
            fuel = fuel - 1;
            let n: usize = match todo.pop() {
                None => 0,
                Some(x) => x,
            };
            if n < adj.len() {
                for k3 in 0..adj[n].len()
                    invariant 0 <= k3 && k3 <= adj[n].len(),
                {
                    let m: usize = adj[n][k3];
                    if m < broken.len() && !broken[m] {
                        broken[m] = true;
                        todo.push(m);
                    }
                }
            }
        }
        let mut spans: Vec<source::Span> = Vec::new();
        for d in 0..defs.len()
            invariant 0 <= d && d <= defs.len(),
        {
            if d < broken.len() && broken[d] {
                spans.push(defs[d].d.span);
            }
        }
        let mut kept: Vec<encode_spec::Trivial> = Vec::new();
        for o in 0..out.proven.len()
            invariant 0 <= o && o <= out.proven.len(),
        {
            let at2: source::Span = out.proven[o].span;
            let mut inside: bool = false;
            for q in 0..spans.len()
                invariant 0 <= q && q <= spans.len(),
            {
                if spans[q].file == at2.file && spans[q].lo <= at2.lo && at2.hi <= spans[q].hi {
                    inside = true;
                }
            }
            if !inside {
                kept.push(out.proven[o].clone());
            }
        }
        kept
    }

    #[summary("bmb verify (stage0 lib::verify_sources_opts and verify_sources_only): reads the files as one program, checks it and, when it checks, proves it. cache_dir is the directory of the caches when there is one: proofs found before are not asked again and new ones are written back, and with reuse an unchanged fully proved definition is not encoded again (the per-definition cache; reuse is off for --emit-smt, which needs every script); audit proves such a definition anyway and compares. only names the definitions to prove when it is not empty; the whole program is still checked and each gets its whole-program status, and the per-definition cache is read lazily with the keys of those alone. bounded asks each undecided obligation once more with its inputs bounded")]
    #[effects(alloc, io, nondet)]
    fn verify(files: &[Input], cache_dir: &Option<String>, only: &[String], bounded: bool, reuse: bool, audit: bool) -> Proved {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let fe: Front = frontend(files, &mut sm, &mut diags);
        if diags.has_errors() {
            return Proved { ok: false, output: diags.to_jsonl(&sm), scripts: Vec::new(), hits: 0, misses: 0, missing: Vec::new(), cache_error: None, incr: None, incr_error: None };
        }
        let mut store: Option<cache::ProofCache> = match cache_dir {
            None => None,
            Some(dir) => Some(cache::load(dir.as_str())),
        };
        let mut wanted: Vec<String> = Vec::new();
        for i in 0..only.len()
            invariant 0 <= i && i <= only.len(),
        {
            wanted.push(only[i].clone());
        }
        let opts: prove::Opts = prove::Opts { only: if only.len() == 0 { None } else { Some(wanted) }, bounded: bounded, seed: 0, rlimit: solver::rlimit(), query: solver::rlimit(), who: solver::Asker::Gate, stop: false };
        let pg: encode_spec::Prog = encode_spec::prog_of(&fe.ck);
        let mut incr: Option<incremental::Session> = match cache_dir {
            None => None,
            Some(dir0) => { if reuse { Some(incremental::new(dir0.as_str(), incremental::compiler_id().as_str(), &fe.ck, &pg.pr, &opts.only, bounded, audit)) } else { None } },
        };
        let mut z3: toolchain::Z3 = toolchain::new();
        let out: prove::Outcome = prove::run_cached(&fe.ck, &pg, &opts, &mut store, &mut incr, &mut z3, &mut diags);
        let mut hits: usize = 0;
        let mut misses: usize = 0;
        let mut cache_error: Option<String> = None;
        match &store {
            None => {},
            Some(c) => { hits = c.hits; misses = c.misses; match cache_dir { None => {}, Some(dir2) => { match cache::save(c, dir2.as_str()) { Ok(u) => {}, Err(why) => { cache_error = Some(why); }, } }, } },
        }
        let mut output: String = diags.to_jsonl(&sm);
        output.push_str(prove::status_lines(out.statuses.as_slice(), &fe.ck).as_str());
        let incr_error: Option<String> = incremental::save_slot(&mut incr);
        let incr_stats: Option<incremental::Stats> = incremental::stats_of(&incr);
        let mut ok: bool = !diags.has_errors();
        let mut missing: Vec<String> = Vec::new();
        for k in 0..only.len()
            invariant 0 <= k && k <= only.len(),
        {
            let mut found: bool = false;
            for j in 0..out.statuses.len()
                invariant 0 <= j && j <= out.statuses.len(),
            {
                if out.statuses[j].path == only[k] {
                    found = true;
                }
            }
            if !found {
                missing.push(only[k].clone());
            }
        }
        for j2 in 0..out.statuses.len()
            invariant 0 <= j2 && j2 <= out.statuses.len(),
        {
            if out.statuses[j2].failed != 0 {
                ok = false;
            }
        }
        Proved { ok: ok, output: output, scripts: out.scripts, hits: hits, misses: misses, missing: missing, cache_error: cache_error, incr: incr_stats, incr_error: incr_error }
    }
}
