#[summary("표준 라이브러리 단위의 글: scripts/std_units.py가 lib/std/*.bmb에서 만든다(손으로 고치지 않는다). stage0의 build.rs가 만드는 STD_UNITS의 자리 (ADR-0092 §1, 백로그 4D-03b)")]
mod std_units {
    #[summary("단위의 수")]
    #[effects(pure)]
    fn count() -> usize {
        11
    }

    #[summary("i번째 단위의 이름(이름의 바이트 순서). 범위 밖이면 빈 글")]
    #[effects(alloc)]
    fn name(i: usize) -> String {
        if i == 0 {
            return String::from("base64");
        }
        if i == 1 {
            return String::from("bytes");
        }
        if i == 2 {
            return String::from("collections");
        }
        if i == 3 {
            return String::from("crc32");
        }
        if i == 4 {
            return String::from("intern");
        }
        if i == 5 {
            return String::from("json");
        }
        if i == 6 {
            return String::from("num");
        }
        if i == 7 {
            return String::from("sha256");
        }
        if i == 8 {
            return String::from("slice");
        }
        if i == 9 {
            return String::from("str");
        }
        if i == 10 {
            return String::from("utf8");
        }
        String::new()
    }

    #[summary("i번째 단위의 소스. 범위 밖이면 빈 글")]
    #[effects(alloc)]
    fn text(i: usize) -> String {
        if i == 0 {
            return String::from("#[summary(\"base64(T4-03): RFC 4648 §4의 표준 알파벳과 '=' 채우기. encode는 명세 enc_at과 같고 정규형이며 dec_byte로 되읽힘, decode는 정규형(§3.5: 버리는 비트가 0)만 받고 명세 dec_byte와 같음이 증명된다. 왕복 decode(encode(s)) == Some(s)도 증명된다\")]\nmod base64 {\n    // ---------- the alphabet (§4, table 1) ----------\n\n    // The character of the 6-bit value `x`.\n    spec fn alpha(x: u8) -> u8 {\n        if x < 26 { x + 65 } else if x < 52 { x + 71 } else if x < 62 { x - 4 } else if x == 62 { 43 } else { 47 }\n    }\n\n    // The value of character `c`: 0..64 for the alphabet, 64 for any other byte.\n    spec fn val(c: u8) -> u8 {\n        if 65 <= c && c <= 90 { c - 65 } else if 97 <= c && c <= 122 { c - 71 } else if 48 <= c && c <= 57 { c + 4 } else if c == 43 { 62 } else if c == 47 { 63 } else { 64 }\n    }\n\n    spec fn sym(c: u8) -> bool { val(c) < 64 }\n\n    // ---------- encoding (§4) ----------\n\n    // The four 6-bit values of a 24-bit group of bytes `a`, `b`, `c`, most\n    // significant first.\n    spec fn e0(a: u8) -> u8 { a / 4 }\n\n    spec fn e1(a: u8, b: u8) -> u8 { a % 4 * 16 + b / 16 }\n\n    spec fn e2(b: u8, c: u8) -> u8 { b % 16 * 4 + c / 64 }\n\n    spec fn e3(c: u8) -> u8 { c % 64 }\n\n    // Byte `k` of `s`, zero past the end.\n    spec fn at0(s: &[u8], k: usize) -> u8 { if k < s.len() { s[k] } else { 0 } }\n\n    spec fn enc_len(n: usize) -> usize { (n + 2) / 3 * 4 }\n\n    // Character `i` of the encoding of `s`: group `i / 4` holds bytes\n    // `3 * (i / 4)` to `3 * (i / 4) + 2` (zero past the end), and a group\n    // of one byte ends in `==`, of two in `=`.\n    spec fn enc_at(s: &[u8], i: usize) -> u8 {\n        if i % 4 == 0 {\n            alpha(e0(at0(s, 3 * (i / 4))))\n        } else if i % 4 == 1 {\n            alpha(e1(at0(s, 3 * (i / 4)), at0(s, 3 * (i / 4) + 1)))\n        } else if i % 4 == 2 {\n            if 3 * (i / 4) + 1 >= s.len() { 61 } else { alpha(e2(at0(s, 3 * (i / 4) + 1), at0(s, 3 * (i / 4) + 2))) }\n        } else {\n            if 3 * (i / 4) + 2 >= s.len() { 61 } else { alpha(e3(at0(s, 3 * (i / 4) + 2))) }\n        }\n    }\n\n    spec fn encoded(s: &[u8], t: &[u8]) -> bool {\n        t.len() == enc_len(s.len()) && forall|i: usize| i < t.len() ==> #[trigger] t[i] == enc_at(s, i)\n    }\n\n    // ---------- decoding (§3.3, §3.5) ----------\n\n    // The number of `=` at the end (at most two count).\n    spec fn pads(t: &[u8]) -> usize {\n        if t.len() >= 1 && t[t.len() - 1] == 61 { if t.len() >= 2 && t[t.len() - 2] == 61 { 2 } else { 1 } } else { 0 }\n    }\n\n    // A canonical encoding: whole groups of four, characters of the\n    // alphabet but for one or two `=` at the end, and the bits the padding\n    // drops are zero (§3.5), so no two byte strings have one encoding.\n    spec fn well_formed(t: &[u8]) -> bool {\n        t.len() % 4 == 0 && (forall|i: usize| i < t.len() ==> sym(#[trigger] t[i]) || (t[i] == 61 && i + pads(t) >= t.len())) && (pads(t) != 1 || val(t[t.len() - 2]) % 4 == 0) && (pads(t) != 2 || val(t[t.len() - 3]) % 16 == 0)\n    }\n\n    spec fn valid_result(t: &[u8], r: bool) -> bool { (r && well_formed(t)) || (!r && !well_formed(t)) }\n\n    // A character's value, `=` counting as zero.\n    spec fn vz(c: u8) -> u8 { if c == 61 { 0 } else { val(c) } }\n\n    // The bytes of four 6-bit values `x`, `y`, `z`, `w`.\n    spec fn d0(x: u8, y: u8) -> u8 { x * 4 + y / 16 }\n\n    spec fn d1(y: u8, z: u8) -> u8 { y % 16 * 16 + z / 4 }\n\n    spec fn d2(z: u8, w: u8) -> u8 { z % 4 * 64 + w }\n\n    // Byte `k` of the decoding of `t`: from the characters of group `k / 3`.\n    spec fn dec_byte(t: &[u8], k: usize) -> u8 {\n        if k % 3 == 0 {\n            d0(vz(t[4 * (k / 3)]), vz(t[4 * (k / 3) + 1]))\n        } else if k % 3 == 1 {\n            d1(vz(t[4 * (k / 3) + 1]), vz(t[4 * (k / 3) + 2]))\n        } else {\n            d2(vz(t[4 * (k / 3) + 2]), vz(t[4 * (k / 3) + 3]))\n        }\n    }\n\n    spec fn dec_len(t: &[u8]) -> usize { t.len() / 4 * 3 - pads(t) }\n\n    // `v` is the decoding of `t`.\n    spec fn decodes(t: &[u8], v: &[u8]) -> bool {\n        v.len() == dec_len(t) && forall|k: usize| k < v.len() ==> dec_byte(t, k) == #[trigger] v[k]\n    }\n\n    spec fn decoded(t: &[u8], r: Option<Vec<u8>>) -> bool {\n        match r {\n            None => !well_formed(t),\n            Some(v) => well_formed(t) && decodes(t, v.as_slice()),\n        }\n    }\n\n    // ---------- code: characters ----------\n\n    spec fn six(x: u8) -> bool { x < 64 }\n\n    // The character of `x`, whose value is `x` again.\n    spec fn char_result(x: u8, r: u8) -> bool { r == alpha(x) && sym(r) && vz(r) == x }\n\n    spec fn is_vz(c: u8, r: u8) -> bool { r == vz(c) }\n\n    // The character of a 6-bit value.\n    #[effects(pure)]\n    #[uses(alpha, sym, val, vz)]\n    fn char_of(x: u8) -> (r: u8)\n        requires six(x),\n        ensures char_result(x, r),\n    {\n        if x < 26 {\n            x + 65\n        } else if x < 52 {\n            x + 71\n        } else if x < 62 {\n            x - 4\n        } else if x == 62 {\n            43\n        } else {\n            47\n        }\n    }\n\n    // A character's value, `=` counting as zero, 64 for a byte outside the alphabet.\n    #[effects(pure)]\n    #[uses(vz, val)]\n    fn value(c: u8) -> (r: u8)\n        ensures is_vz(c, r),\n    {\n        if c >= 65 && c <= 90 {\n            c - 65\n        } else if c >= 97 && c <= 122 {\n            c - 71\n        } else if c >= 48 && c <= 57 {\n            c + 4\n        } else if c == 43 {\n            62\n        } else if c == 47 {\n            63\n        } else if c == 61 {\n            0\n        } else {\n            64\n        }\n    }\n\n    // ---------- code: bit fields ----------\n\n    spec fn is_e0(a: u8, r: u8) -> bool { r == e0(a) && r < 64 }\n\n    spec fn is_e1(a: u8, b: u8, r: u8) -> bool { r == e1(a, b) && r < 64 }\n\n    spec fn is_e2(b: u8, c: u8, r: u8) -> bool { r == e2(b, c) && r < 64 }\n\n    spec fn is_e3(c: u8, r: u8) -> bool { r == e3(c) && r < 64 }\n\n    #[effects(pure)]\n    #[uses(e0)]\n    fn field0(a: u8) -> (r: u8)\n        ensures is_e0(a, r),\n    {\n        a >> 2\n    }\n\n    // Two bits of `a`, four of `b`.\n    #[effects(pure)]\n    #[uses(e1)]\n    fn field1(a: u8, b: u8) -> (r: u8)\n        ensures is_e1(a, b, r),\n    {\n        ((a & 3) << 4) + (b >> 4)\n    }\n\n    // Four bits of `b`, two of `c`.\n    #[effects(pure)]\n    #[uses(e2)]\n    fn field2(b: u8, c: u8) -> (r: u8)\n        ensures is_e2(b, c, r),\n    {\n        ((b & 15) << 2) + (c >> 6)\n    }\n\n    #[effects(pure)]\n    #[uses(e3)]\n    fn field3(c: u8) -> (r: u8)\n        ensures is_e3(c, r),\n    {\n        c & 63\n    }\n\n    spec fn is_d0(x: u8, y: u8, r: u8) -> bool { r == d0(x, y) }\n\n    spec fn is_d1(y: u8, z: u8, r: u8) -> bool { r == d1(y, z) }\n\n    spec fn is_d2(z: u8, w: u8, r: u8) -> bool { r == d2(z, w) }\n\n    // `x` and two bits of `y`.\n    #[effects(pure)]\n    #[uses(d0)]\n    fn byte0(x: u8, y: u8) -> (r: u8)\n        requires six(x), six(y),\n        ensures is_d0(x, y, r),\n    {\n        assert(x < 64 && y < 64 ==> (x << 2) | (y >> 4) == x * 4 + y / 16) by (bit_vector);\n        (x << 2) | (y >> 4)\n    }\n\n    // Four bits of `y`, four of `z`.\n    #[effects(pure)]\n    #[uses(d1)]\n    fn byte1(y: u8, z: u8) -> (r: u8)\n        requires six(y), six(z),\n        ensures is_d1(y, z, r),\n    {\n        ((y & 15) << 4) + (z >> 2)\n    }\n\n    // Two bits of `z`, and `w`.\n    #[effects(pure)]\n    #[uses(d2)]\n    fn byte2(z: u8, w: u8) -> (r: u8)\n        requires six(z), six(w),\n        ensures is_d2(z, w, r),\n    {\n        ((z & 3) << 6) + w\n    }\n\n    // ---------- encode ----------\n\n    spec fn fits(s: &[u8]) -> bool { s.len() <= 4611686018427387903 }\n\n    spec fn kept(v: &[u8], w: &[u8]) -> bool {\n        w.len() <= v.len() && forall|k: usize| k < w.len() ==> #[trigger] v[k] == w[k]\n    }\n\n    spec fn groups_done(t: &[u8], g: usize) -> bool { t.len() == 4 * g }\n\n    spec fn grown(t: &[u8], u: &[u8], g: usize) -> bool { u.len() == 4 * g && t.len() == 4 * g + 4 && kept(t, u) }\n\n    spec fn group_in(s: &[u8], g: usize) -> bool { 3 * g + 3 <= s.len() }\n\n    spec fn tail_at(s: &[u8], g: usize, k: usize) -> bool { 3 * g + k == s.len() }\n\n    // Character `j` of group `g` is its encoding.\n    spec fn enc_c(s: &[u8], t: &[u8], g: usize, j: usize) -> bool { t[4 * g + j] == enc_at(s, 4 * g + j) }\n\n    // Byte `r` of group `g`, where `s` has it, decodes back.\n    spec fn dec_b(s: &[u8], t: &[u8], g: usize, r: usize) -> bool { 3 * g + r >= s.len() || dec_byte(t, 3 * g + r) == s[3 * g + r] }\n\n    spec fn syms4(t: &[u8], g: usize) -> bool { sym(t[4 * g]) && sym(t[4 * g + 1]) && sym(t[4 * g + 2]) && sym(t[4 * g + 3]) }\n\n    // A last group of one byte: `xx==`, the bits dropped zero.\n    spec fn last1(t: &[u8], g: usize) -> bool {\n        sym(t[4 * g]) && sym(t[4 * g + 1]) && t[4 * g + 2] == 61 && t[4 * g + 3] == 61 && val(t[4 * g + 1]) % 16 == 0\n    }\n\n    // A last group of two bytes: `xxx=`, the bits dropped zero.\n    spec fn last2(t: &[u8], g: usize) -> bool {\n        sym(t[4 * g]) && sym(t[4 * g + 1]) && sym(t[4 * g + 2]) && t[4 * g + 3] == 61 && val(t[4 * g + 2]) % 4 == 0\n    }\n\n    // Appends the encoding of the whole group `g` of `s`.\n    #[effects(alloc)]\n    #[uses(kept, enc_at, at0, dec_byte, d0, d1, d2, e0, e1, e2, e3)]\n    fn push_group(t: &mut Vec<u8>, s: &[u8], g: usize) -> ()\n        requires fits(s), group_in(s, g), groups_done(t.as_slice(), g),\n        ensures grown(t.as_slice(), old(t).as_slice(), g), enc_c(s, t.as_slice(), g, 0), enc_c(s, t.as_slice(), g, 1), enc_c(s, t.as_slice(), g, 2), enc_c(s, t.as_slice(), g, 3), dec_b(s, t.as_slice(), g, 0), dec_b(s, t.as_slice(), g, 1), dec_b(s, t.as_slice(), g, 2), syms4(t.as_slice(), g),\n    {\n        let b0: u8 = s[3 * g];\n        let b1: u8 = s[3 * g + 1];\n        let b2: u8 = s[3 * g + 2];\n        t.push(char_of(field0(b0)));\n        t.push(char_of(field1(b0, b1)));\n        t.push(char_of(field2(b1, b2)));\n        t.push(char_of(field3(b2)));\n    }\n\n    // Appends the encoding of the last group `g` of `s`, of one byte.\n    #[effects(alloc)]\n    #[uses(kept, enc_at, at0, dec_byte, d0, d1, d2, e0, e1, vz, val, sym)]\n    fn push_one(t: &mut Vec<u8>, s: &[u8], g: usize) -> ()\n        requires fits(s), tail_at(s, g, 1), groups_done(t.as_slice(), g),\n        ensures grown(t.as_slice(), old(t).as_slice(), g), enc_c(s, t.as_slice(), g, 0), enc_c(s, t.as_slice(), g, 1), enc_c(s, t.as_slice(), g, 2), enc_c(s, t.as_slice(), g, 3), dec_b(s, t.as_slice(), g, 0), last1(t.as_slice(), g),\n    {\n        let c0: u8 = s[3 * g];\n        t.push(char_of(field0(c0)));\n        t.push(char_of(field1(c0, 0)));\n        t.push(b'=');\n        t.push(b'=');\n    }\n\n    // Appends the encoding of the last group `g` of `s`, of two bytes.\n    #[effects(alloc)]\n    #[uses(kept, enc_at, at0, dec_byte, d0, d1, d2, e0, e1, e2, vz, val, sym)]\n    fn push_two(t: &mut Vec<u8>, s: &[u8], g: usize) -> ()\n        requires fits(s), tail_at(s, g, 2), groups_done(t.as_slice(), g),\n        ensures grown(t.as_slice(), old(t).as_slice(), g), enc_c(s, t.as_slice(), g, 0), enc_c(s, t.as_slice(), g, 1), enc_c(s, t.as_slice(), g, 2), enc_c(s, t.as_slice(), g, 3), dec_b(s, t.as_slice(), g, 0), dec_b(s, t.as_slice(), g, 1), last2(t.as_slice(), g),\n    {\n        let d0: u8 = s[3 * g];\n        let d1: u8 = s[3 * g + 1];\n        t.push(char_of(field0(d0)));\n        t.push(char_of(field1(d0, d1)));\n        t.push(char_of(field2(d1, 0)));\n        t.push(b'=');\n    }\n\n    spec fn enc_upto(s: &[u8], t: &[u8], g: usize) -> bool {\n        t.len() == 4 * g && forall|i: usize| i < 4 * g ==> #[trigger] t[i] == enc_at(s, i) && sym(t[i])\n    }\n\n    spec fn dec_upto(t: &[u8], s: &[u8], m: usize) -> bool {\n        m <= s.len() && forall|k: usize| k < m ==> dec_byte(t, k) == #[trigger] s[k]\n    }\n\n    spec fn round_trip(s: &[u8], t: &[u8]) -> bool { encoded(s, t) && well_formed(t) && decodes(t, s) }\n\n    // The base64 encoding of `s` (RFC 4648 §4, with padding). It is\n    // canonical and decodes back to `s`.\n    #[effects(alloc)]\n    #[uses(round_trip, enc_len, dec_len, dec_byte, pads, sym, val, kept)]\n    fn encode(s: &[u8]) -> (r: Vec<u8>)\n        requires fits(s),\n        ensures encoded(s, r.as_slice()), well_formed(r.as_slice()), decodes(r.as_slice(), s),\n    {\n        let n: usize = s.len();\n        let full: usize = n / 3;\n        let mut t: Vec<u8> = Vec::with_capacity((n + 2) / 3 * 4);\n        for g in 0..full\n            invariant full * 3 <= n, enc_upto(s, t.as_slice(), g), dec_upto(t.as_slice(), s, 3 * g),\n        {\n            push_group(&mut t, s, g);\n        }\n        if n - 3 * full == 1 {\n            push_one(&mut t, s, full);\n        } else if n - 3 * full == 2 {\n            push_two(&mut t, s, full);\n        }\n        t\n    }\n\n    // ---------- decode ----------\n\n    spec fn ok_upto(t: &[u8], n: usize) -> bool {\n        n <= t.len() && forall|i: usize| i < n ==> sym(#[trigger] t[i]) || (t[i] == 61 && i + pads(t) >= t.len())\n    }\n\n    spec fn bad_at(t: &[u8], i: usize) -> bool { i < t.len() && !sym(t[i]) && (t[i] != 61 || i + pads(t) < t.len()) }\n\n    // Whether `t` is a canonical encoding.\n    #[effects(pure)]\n    #[uses(well_formed, pads, sym, val, vz)]\n    fn is_valid(t: &[u8]) -> (r: bool)\n        ensures valid_result(t, r),\n    {\n        let m: usize = t.len();\n        if m % 4 != 0 {\n            return false;\n        }\n        let p: usize = if m >= 1 && t[m - 1] == b'=' {\n            if m >= 2 && t[m - 2] == b'=' { 2 } else { 1 }\n        } else {\n            0\n        };\n        let mut ok: bool = true;\n        let mut i: usize = 0;\n        while i < m && ok\n            invariant i <= m, ok ==> ok_upto(t, i), !ok ==> (0 < i && bad_at(t, i - 1)),\n            decreases m - i,\n        {\n            let c: u8 = t[i];\n            let v: u8 = value(c);\n            if !(v < 64 && c != b'=') && !(c == b'=' && i + p >= m) {\n                ok = false;\n            }\n            i = i + 1;\n        }\n        if !ok {\n            return false;\n        }\n        if p == 1 && value(t[m - 2]) % 4 != 0 {\n            return false;\n        }\n        if p == 2 && value(t[m - 3]) % 16 != 0 {\n            return false;\n        }\n        true\n    }\n\n    spec fn digits(t: &[u8], g: usize) -> bool {\n        4 * g + 4 <= t.len() && vz(t[4 * g]) < 64 && vz(t[4 * g + 1]) < 64 && vz(t[4 * g + 2]) < 64 && vz(t[4 * g + 3]) < 64\n    }\n\n    spec fn appended(v: &[u8], w: &[u8], t: &[u8], g: usize, c: usize) -> bool {\n        v.len() == w.len() + c && kept(v, w) && (c < 1 || v[w.len()] == dec_byte(t, 3 * g)) && (c < 2 || v[w.len() + 1] == dec_byte(t, 3 * g + 1)) && (c < 3 || v[w.len() + 2] == dec_byte(t, 3 * g + 2))\n    }\n\n    spec fn count_ok(c: usize) -> bool { 1 <= c && c <= 3 }\n\n    spec fn room(v: &[u8]) -> bool { v.len() + 3 <= 9223372036854775807 }\n\n    // Appends the first `c` bytes the characters of group `g` encode.\n    #[effects(alloc)]\n    #[uses(kept, dec_byte)]\n    fn push_bytes(v: &mut Vec<u8>, t: &[u8], g: usize, c: usize) -> ()\n        requires digits(t, g), count_ok(c),\n        ensures appended(v.as_slice(), old(v).as_slice(), t, g, c),\n    {\n        let x0: u8 = value(t[4 * g]);\n        let x1: u8 = value(t[4 * g + 1]);\n        let x2: u8 = value(t[4 * g + 2]);\n        let x3: u8 = value(t[4 * g + 3]);\n        v.push(byte0(x0, x1));\n        if c >= 2 {\n            v.push(byte1(x1, x2));\n        }\n        if c >= 3 {\n            v.push(byte2(x2, x3));\n        }\n    }\n\n    spec fn dec_prefix(t: &[u8], v: &[u8], n: usize) -> bool {\n        v.len() == n && forall|k: usize| k < n ==> dec_byte(t, k) == #[trigger] v[k]\n    }\n\n    // The bytes `t` encodes, or `None` when it is not a canonical encoding.\n    #[effects(alloc)]\n    #[uses(decodes, pads, sym, val, vz, dec_len, kept)]\n    fn decode(t: &[u8]) -> (r: Option<Vec<u8>>)\n        ensures decoded(t, r),\n    {\n        if !is_valid(t) {\n            return None;\n        }\n        let m: usize = t.len();\n        let groups: usize = m / 4;\n        let p: usize = if m >= 1 && t[m - 1] == b'=' {\n            if m >= 2 && t[m - 2] == b'=' { 2 } else { 1 }\n        } else {\n            0\n        };\n        let mut v: Vec<u8> = Vec::new();\n        if groups > 0 {\n            let last: usize = groups - 1;\n            for g in 0..last\n                invariant m == t.len(), groups * 4 == m, well_formed(t), dec_prefix(t, v.as_slice(), 3 * g),\n            {\n                push_bytes(&mut v, t, g, 3);\n            }\n            push_bytes(&mut v, t, last, 3 - p);\n        }\n        Some(v)\n    }\n\n    spec fn back(s: &[u8], r: Option<Vec<u8>>) -> bool {\n        match r {\n            None => false,\n            Some(v) => v.len() == s.len() && forall|k: usize| k < s.len() ==> #[trigger] v[k] == s[k],\n        }\n    }\n\n    // The round trip (RFC 4648 §3): decoding the encoding of `s` gives `s`.\n    // Proved from the two contracts alone; it runs both.\n    #[effects(alloc)]\n    #[uses(round_trip)]\n    fn round(s: &[u8]) -> (r: Option<Vec<u8>>)\n        requires fits(s),\n        ensures back(s, r),\n    {\n        let t: Vec<u8> = encode(s);\n        decode(t.as_slice())\n    }\n}\n");
        }
        if i == 1 {
            return String::from("#[summary(\"바이트 문자열 라이브러리: 비교·접두사·검색·덧붙이기·10진 서식과 해석 (ADR-0044 §4). 쓰는 프로그램이 이 파일을 함께 넘긴다\")]\nmod bytes {\n    // ---------- comparison ----------\n\n    spec fn same_upto(a: &[u8], b: &[u8], n: usize) -> bool {\n        n <= a.len() && n <= b.len() && forall|k: usize| k < n ==> #[trigger] a[k] == b[k]\n    }\n\n    spec fn same(a: &[u8], b: &[u8]) -> bool { a.len() == b.len() && same_upto(a, b, a.len()) }\n\n    spec fn eq_result(r: bool, a: &[u8], b: &[u8]) -> bool { (r && same(a, b)) || (!r && !same(a, b)) }\n\n    spec fn scan(ok: bool, a: &[u8], b: &[u8], i: usize) -> bool {\n        (ok && same_upto(a, b, i)) || (!ok && 0 < i && i <= a.len() && i <= b.len() && a[i - 1] != b[i - 1])\n    }\n\n    // `a == b` byte for byte.\n    #[effects(pure)]\n    #[uses(same_upto, same)]\n    fn eq(a: &[u8], b: &[u8]) -> (r: bool)\n        ensures eq_result(r, a, b),\n    {\n        if a.len() != b.len() {\n            false\n        } else {\n            let mut ok: bool = true;\n            let mut i: usize = 0;\n            while i < a.len() && ok\n                invariant i <= a.len(), a.len() == b.len(), scan(ok, a, b, i),\n                decreases a.len() - i,\n            {\n                if a[i] != b[i] {\n                    ok = false;\n                }\n                i = i + 1;\n            }\n            ok\n        }\n    }\n\n    spec fn prefix(p: &[u8], s: &[u8]) -> bool { p.len() <= s.len() && same_upto(s, p, p.len()) }\n\n    spec fn prefix_result(r: bool, s: &[u8], p: &[u8]) -> bool { (r && prefix(p, s)) || (!r && !prefix(p, s)) }\n\n    // Whether `s` starts with `p`.\n    #[effects(pure)]\n    #[uses(same_upto, prefix)]\n    fn starts_with(s: &[u8], p: &[u8]) -> (r: bool)\n        ensures prefix_result(r, s, p),\n    {\n        if p.len() > s.len() {\n            false\n        } else {\n            let mut ok: bool = true;\n            let mut i: usize = 0;\n            while i < p.len() && ok\n                invariant i <= p.len(), p.len() <= s.len(), scan(ok, s, p, i),\n                decreases p.len() - i,\n            {\n                if s[i] != p[i] {\n                    ok = false;\n                }\n                i = i + 1;\n            }\n            ok\n        }\n    }\n\n    // ---------- building ----------\n\n    spec fn kept(v: &[u8], w: &[u8]) -> bool {\n        w.len() <= v.len() && forall|k: usize| k < w.len() ==> #[trigger] v[k] == w[k]\n    }\n\n    spec fn copied(v: &[u8], at: usize, s: &[u8], n: usize) -> bool {\n        n <= s.len() && at + n <= v.len() && forall|k: usize| k < n ==> #[trigger] s[k] == v[at + k]\n    }\n\n    spec fn fits(v: &[u8], s: &[u8]) -> bool { v.len() + s.len() <= 9223372036854775807 }\n\n    spec fn appended(v: &[u8], w: &[u8], s: &[u8]) -> bool {\n        v.len() == w.len() + s.len() && kept(v, w) && copied(v, w.len(), s, s.len())\n    }\n\n    // Appends `s` (Rust `extend_from_slice`).\n    #[effects(alloc)]\n    fn extend(v: &mut Vec<u8>, s: &[u8]) -> ()\n        requires fits(v.as_slice(), s),\n        ensures appended(v.as_slice(), old(v).as_slice(), s),\n    {\n        for i in 0..s.len()\n            invariant i <= s.len(), v.len() == old(v).len() + i, kept(v.as_slice(), old(v).as_slice()), copied(v.as_slice(), old(v).len(), s, i),\n        {\n            v.push(s[i]);\n        }\n    }\n\n    // ---------- search ----------\n\n    spec fn at(s: &[u8], p: &[u8], i: usize, n: usize) -> bool {\n        i + p.len() <= s.len() && n <= p.len() && forall|k: usize| k < n ==> #[trigger] p[k] == s[i + k]\n    }\n\n    // No occurrence of `p` starts before `i`.\n    spec fn none_before(s: &[u8], p: &[u8], i: usize) -> bool {\n        forall|k: usize| k < i ==> !#[trigger] at(s, p, k, p.len())\n    }\n\n    // `p` occurs nowhere in `s`.\n    spec fn nowhere(s: &[u8], p: &[u8]) -> bool {\n        p.len() > s.len() || none_before(s, p, s.len() - p.len() + 1)\n    }\n\n    // `r` is the first position of `p` in `s`, or none when there is none\n    // (Rust's `find`).\n    spec fn found(r: Option<usize>, s: &[u8], p: &[u8]) -> bool {\n        match r {\n            None => nowhere(s, p),\n            Some(i) => at(s, p, i, p.len()) && none_before(s, p, i),\n        }\n    }\n\n    // The first position of `p` in `s`, scanning from the start: exactly\n    // Rust's `find` (an empty `p` is at 0).\n    #[effects(pure)]\n    #[uses(nowhere)]\n    fn find(s: &[u8], p: &[u8]) -> (r: Option<usize>)\n        ensures found(r, s, p),\n    {\n        if p.len() > s.len() {\n            None\n        } else {\n            let last: usize = s.len() - p.len();\n            let mut i: usize = 0;\n            let mut hit: bool = false;\n            while i <= last && !hit\n                invariant i <= last + 1, last + p.len() == s.len(),\n                    hit ==> (0 < i && at(s, p, i - 1, p.len()) && none_before(s, p, i - 1)),\n                    !hit ==> none_before(s, p, i),\n                decreases last + 1 - i,\n            {\n                let mut j: usize = 0;\n                let mut ok: bool = true;\n                while j < p.len() && ok\n                    invariant j <= p.len(), i <= last, last + p.len() == s.len(), ok ==> at(s, p, i, j),\n                        !ok ==> !at(s, p, i, p.len()),\n                    decreases p.len() - j,\n                {\n                    if s[i + j] != p[j] {\n                        ok = false;\n                    }\n                    j = j + 1;\n                }\n                if ok {\n                    hit = true;\n                }\n                i = i + 1;\n            }\n            if hit { Some(i - 1) } else { None }\n        }\n    }\n\n    // ---------- decimal ----------\n\n    spec fn room(v: &[u8], m: usize) -> bool { v.len() + m <= 9223372036854775807 }\n\n    spec fn grew_by(v: &[u8], w: &[u8], m: usize) -> bool { w.len() < v.len() && v.len() <= w.len() + m && kept(v, w) }\n\n    // Appends `x` in decimal (at most 20 bytes).\n    #[effects(alloc)]\n    fn push_u64(v: &mut Vec<u8>, x: u64) -> ()\n        ensures grew_by(v.as_slice(), old(v).as_slice(), 20),\n    {\n        let mut buf: [u8; 20] = [0; 20];\n        let mut n: usize = 0;\n        let mut y: u64 = x;\n        while y > 0 && n < 20\n            invariant n <= 20,\n            decreases 20 - n,\n        {\n            buf[n] = (y % 10) as u8 + b'0';\n            y = y / 10;\n            n = n + 1;\n        }\n        if n == 0 {\n            v.push(b'0');\n        } else {\n            let mut k: usize = n;\n            while k > 0\n                invariant k <= n, n <= 20, v.len() == old(v).len() + (n - k), kept(v.as_slice(), old(v).as_slice()),\n                decreases k,\n            {\n                k = k - 1;\n                v.push(buf[k]);\n            }\n        }\n    }\n\n    // Appends `x` in decimal, with `-` when negative (at most 21 bytes).\n    #[effects(alloc)]\n    #[uses(kept)]\n    fn push_i64(v: &mut Vec<u8>, x: i64) -> ()\n        ensures grew_by(v.as_slice(), old(v).as_slice(), 21),\n    {\n        if x < 0 {\n            v.push(b'-');\n            // `-x` overflows at `i64::MIN`; `-(x + 1)` does not.\n            push_u64(v, -(x + 1) as u64 + 1);\n        } else {\n            push_u64(v, x as u64);\n        }\n    }\n\n    spec fn digit(c: u8) -> bool { 48 <= c && c <= 57 }\n\n    spec fn digits(s: &[u8], n: usize) -> bool { n <= s.len() && forall|k: usize| k < n ==> digit(#[trigger] s[k]) }\n\n    // The value of the first `n` bytes of `s` read as decimal digits.\n    spec fn dec(s: &[u8], n: usize) -> i64\n        decreases n,\n    {\n        if n == 0 { 0 } else { dec(s, n - 1) * 10 + (s[n - 1] - 48) }\n    }\n\n    spec fn parsed(r: Option<u64>, s: &[u8]) -> bool {\n        match r {\n            None => true,\n            Some(v) => s.len() > 0 && digits(s, s.len()) && v == dec(s, s.len()),\n        }\n    }\n\n    // `s` read as a decimal `u64`: `None` when it is empty, holds a byte\n    // that is not a digit, or does not fit. `Some(v)` is proved to be the\n    // value of the digits.\n    #[effects(pure)]\n    #[uses(digit)]\n    fn parse_u64(s: &[u8]) -> (r: Option<u64>)\n        ensures parsed(r, s),\n    {\n        if s.len() == 0 {\n            None\n        } else {\n            let mut acc: u64 = 0;\n            let mut ok: bool = true;\n            let mut i: usize = 0;\n            while i < s.len() && ok\n                invariant i <= s.len(), ok ==> (digits(s, i) && acc == dec(s, i)),\n                decreases s.len() - i,\n            {\n                let c: u8 = s[i];\n                if c < b'0' || c > b'9' {\n                    ok = false;\n                } else {\n                    let d: u64 = (c - b'0') as u64;\n                    match acc.checked_mul(10) {\n                        None => {\n                            ok = false;\n                        }\n                        Some(m) => match m.checked_add(d) {\n                            None => {\n                                ok = false;\n                            }\n                            Some(t) => {\n                                acc = t;\n                            }\n                        },\n                    }\n                }\n                i = i + 1;\n            }\n            if ok { Some(acc) } else { None }\n        }\n    }\n}\n");
        }
        if i == 2 {
            return String::from("#[summary(\"정렬된 모음(Rust `BTreeSet`·`BTreeMap`의 이름과 뜻): 정렬된 Vec 위의 집합과 맵, 키는 오름차순이고 유일하며 옮겨지는 값(`String`)이어도 된다. 넣기·빼기는 배열이 어떻게 바뀌는지 정확히 말한다 (ADR-0092 §2, backlog 4B-02·4B-04)\")]\nmod collections {\n    // The keys are strictly ascending, so each occurs once.\n    spec fn strictly<K: Ord>(v: &[K]) -> bool {\n        forall |i: usize, j: usize| i < j && j < v.len() ==> #[trigger] v[i] < #[trigger] v[j]\n    }\n\n    // Where `k` is, or where it would go: the keys before it are below it,\n    // the keys from it on are not.\n    spec fn place<K: Ord>(v: &[K], k: &K, p: usize) -> bool {\n        p <= v.len()\n            && (forall |a: usize| a < p ==> #[trigger] v[a] < *k)\n            && (forall |b: usize| p <= b && b < v.len() ==> *k <= #[trigger] v[b])\n    }\n\n    // The place of `k` in ascending keys, by bisection.\n    #[effects(pure)]\n    fn locate<K: Ord>(v: &[K], k: &K) -> (p: usize)\n        requires strictly::<K>(v),\n        ensures place::<K>(v, k, p),\n    {\n        let mut lo: usize = 0;\n        let mut hi: usize = v.len();\n        while lo < hi\n            invariant lo <= hi, hi <= v.len(), place::<K>(v, k, lo) || lo < hi,\n                forall |a: usize| a < lo ==> #[trigger] v[a] < *k,\n                forall |b: usize| hi <= b && b < v.len() ==> *k <= #[trigger] v[b],\n            decreases hi - lo,\n        {\n            let mid: usize = lo + (hi - lo) / 2;\n            if v[mid] < *k {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        lo\n    }\n\n    // ---------- moving items in a Vec ----------\n\n    // Before `j` the items of `w`, after `j` the items of `w` one place on.\n    spec fn shifted<T>(v: &[T], w: &[T], j: usize) -> bool {\n        j <= w.len() && w.len() + 1 == v.len()\n            && (forall |i: usize| i < j ==> #[trigger] v[i] == w[i])\n            && (forall |m: usize| j < m && m <= w.len() ==> #[trigger] v[m] == w[m - 1])\n    }\n\n    // `v` is `w` with `x` at `p`.\n    spec fn inserted_at<T>(v: &[T], w: &[T], p: usize, x: &T) -> bool {\n        p <= w.len() && v[p] == *x && shifted::<T>(v, w, p)\n    }\n\n    // `v` is `w` without its item at `p`.\n    spec fn removed_at<T>(v: &[T], w: &[T], p: usize) -> bool {\n        p < w.len() && v.len() + 1 == w.len()\n            && (forall |i: usize| i < p ==> #[trigger] v[i] == w[i])\n            && (forall |m: usize| p <= m && m < v.len() ==> #[trigger] v[m] == w[m + 1])\n    }\n\n    // `r` holds the item of `w` at `p`.\n    spec fn was_at<T>(r: &Option<T>, w: &[T], p: usize) -> bool {\n        p < w.len() && *r == Some(w[p])\n    }\n\n    spec fn insert_room<T>(v: &[T], p: usize) -> bool {\n        p <= v.len() && v.len() + 1 < 1152921504606846975\n    }\n\n    spec fn insert_pos<T>(v: &[T], p: usize) -> bool {\n        p <= v.len()\n    }\n\n    spec fn remove_pos<T>(v: &[T], p: usize) -> bool {\n        p < v.len()\n    }\n\n    // Puts `x` at `i` and moves each item from `i` on one place up (Rust's\n    // `Vec::insert`). Recursive: an item moves by `std::mem::replace`, so no\n    // place is ever empty, and the contract speaks of `x` as it came in.\n    #[effects(alloc)]\n    #[uses(shifted)]\n    fn shift_in<T>(v: &mut Vec<T>, i: usize, x: T) -> ()\n        requires insert_pos::<T>(v.as_slice(), i),\n        ensures inserted_at::<T>(v.as_slice(), old(v).as_slice(), i, &x),\n        decreases v.len() - i,\n    {\n        if i == v.len() {\n            v.push(x);\n        } else {\n            let y: T = std::mem::replace(&mut v[i], x);\n            shift_in::<T>(v, i + 1, y);\n        }\n    }\n\n    // Takes the item at `i` out and moves each one after it a place down\n    // (Rust's `Vec::remove`, the item in `Some`).\n    #[effects(pure)]\n    fn shift_out<T>(v: &mut Vec<T>, i: usize) -> (r: Option<T>)\n        requires remove_pos::<T>(v.as_slice(), i),\n        ensures removed_at::<T>(v.as_slice(), old(v).as_slice(), i), was_at::<T>(&r, old(v).as_slice(), i),\n        decreases v.len() - i,\n    {\n        if i + 1 == v.len() {\n            return v.pop();\n        }\n        match shift_out::<T>(v, i + 1) {\n            None => None,\n            Some(z) => Some(std::mem::replace(&mut v[i], z)),\n        }\n    }\n\n    // ---------- sets ----------\n\n    // A set of keys in ascending order (Rust's `BTreeSet<K>`).\n    #[invariant(set_sound)]\n    struct BTreeSet<K: Ord> { keys: Vec<K> }\n\n    spec fn set_sound<K: Ord>(s: &BTreeSet<K>) -> bool {\n        strictly::<K>(s.keys.as_slice())\n    }\n\n    // `k` is in the set.\n    spec fn holds<K: Ord>(s: &BTreeSet<K>, k: &K) -> bool {\n        exists |i: usize| i < s.keys.len() && #[trigger] s.keys[i] == *k\n    }\n\n    spec fn contained<K: Ord>(r: bool, s: &BTreeSet<K>, k: &K) -> bool {\n        r == holds::<K>(s, k)\n    }\n\n    impl<K: Ord> BTreeSet<K> {\n        // An empty set.\n        #[effects(alloc)]\n        #[uses(set_sound, strictly)]\n        fn new() -> (r: BTreeSet<K>)\n            ensures empty_set::<K>(&r),\n        {\n            let v: Vec<K> = Vec::new();\n            BTreeSet { keys: v }\n        }\n\n        // The number of keys (Rust's `len`).\n        #[effects(pure)]\n        fn len(self: &BTreeSet<K>) -> (r: usize)\n            ensures set_size::<K>(r, self),\n        {\n            self.keys.len()\n        }\n\n        // Whether `k` is in the set (Rust's `contains`).\n        #[effects(pure)]\n        #[uses(holds, set_sound)]\n        fn contains(self: &BTreeSet<K>, k: &K) -> (r: bool)\n            ensures contained::<K>(r, self, k),\n        {\n            let p: usize = locate::<K>(self.keys.as_slice(), k);\n            p < self.keys.len() && self.keys[p] == *k\n        }\n\n        // Adds `k`; whether it was new (Rust's `insert`).\n        #[effects(alloc)]\n        #[uses(holds, kept_set, set_sound, shifted)]\n        fn insert(self: &mut BTreeSet<K>, k: K) -> (r: bool)\n            ensures added::<K>(r, self, old(self), &k), set_grew::<K>(self, old(self)),\n        {\n            let p: usize = locate::<K>(self.keys.as_slice(), &k);\n            if p < self.keys.len() && self.keys[p] == k {\n                return false;\n            }\n            // Shifted outside the set: its keys are in order at every step.\n            // The lemma names the new key by its place, `k` having moved.\n            let mut v: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());\n            shift_in::<K>(&mut v, p, k);\n            proof {\n                insert_keeps_order::<K>(v.as_slice(), old(self).keys.as_slice(), p, &v[p]);\n            }\n            self.keys = v;\n            true\n        }\n\n        // Takes `k` out; whether it was there (Rust's `remove`).\n        #[effects(alloc)]\n        #[uses(holds, kept_set, set_sound)]\n        fn remove(self: &mut BTreeSet<K>, k: &K) -> (r: bool)\n            ensures dropped::<K>(r, self, old(self), k), set_shrank::<K>(self, old(self)),\n        {\n            let p: usize = locate::<K>(self.keys.as_slice(), k);\n            if p >= self.keys.len() || self.keys[p] != *k {\n                return false;\n            }\n            let mut v: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());\n            let out: Option<K> = shift_out::<K>(&mut v, p);\n            proof {\n                remove_keeps_order::<K>(v.as_slice(), old(self).keys.as_slice(), p);\n            }\n            self.keys = v;\n            true\n        }\n\n        // The keys in ascending order (Rust's `into_iter().collect()`).\n        #[effects(pure)]\n        #[uses(set_sound, strictly)]\n        fn into_keys(self: BTreeSet<K>) -> (r: Vec<K>)\n            ensures set_keys::<K>(r.as_slice(), &self),\n        {\n            self.keys\n        }\n    }\n\n    // `r` is the set's keys in ascending order.\n    spec fn set_keys<K: Ord>(r: &[K], s: &BTreeSet<K>) -> bool {\n        r.len() == s.keys.len() && strictly::<K>(r) && forall |i: usize| i < r.len() ==> #[trigger] r[i] == s.keys[i]\n    }\n\n    spec fn remove_pre<K: Ord>(v: &[K], w: &[K], p: usize) -> bool {\n        strictly::<K>(w) && removed_at::<K>(v, w, p)\n    }\n\n    // Taking a key out keeps the keys strictly ascending.\n    #[uses(removed_at, strictly)]\n    proof fn remove_keeps_order<K: Ord>(v: &[K], w: &[K], p: usize)\n        requires remove_pre::<K>(v, w, p),\n        ensures in_order::<K>(v),\n    {\n    }\n\n    // `remove`'s result: there and taken out from its place, or not there\n    // and nothing changed.\n    spec fn dropped<K: Ord>(r: bool, s: &BTreeSet<K>, t: &BTreeSet<K>, k: &K) -> bool {\n        (r && holds::<K>(t, k) && exists |p: usize| p < t.keys.len() && t.keys[p] == *k && #[trigger] removed_at::<K>(s.keys.as_slice(), t.keys.as_slice(), p))\n            || (!r && !holds::<K>(t, k) && kept_set::<K>(s, t))\n    }\n\n    spec fn insert_pre<K: Ord>(v: &[K], w: &[K], p: usize, k: &K) -> bool {\n        strictly::<K>(w) && place::<K>(w, k, p) && (p == w.len() || w[p] != *k) && inserted_at::<K>(v, w, p, k)\n    }\n\n    spec fn in_order<K: Ord>(v: &[K]) -> bool {\n        strictly::<K>(v)\n    }\n\n    // Inserting a new key at its place keeps the keys strictly ascending.\n    #[uses(inserted_at, place, shifted, strictly)]\n    proof fn insert_keeps_order<K: Ord>(v: &[K], w: &[K], p: usize, k: &K)\n        requires insert_pre::<K>(v, w, p, k),\n        ensures in_order::<K>(v),\n    {\n    }\n\n    spec fn empty_set<K: Ord>(s: &BTreeSet<K>) -> bool {\n        s.keys.len() == 0\n    }\n\n    spec fn set_size<K: Ord>(r: usize, s: &BTreeSet<K>) -> bool {\n        r == s.keys.len()\n    }\n\n    // The set has at most one key more (what a caller needs to insert again).\n    spec fn set_grew<K: Ord>(s: &BTreeSet<K>, t: &BTreeSet<K>) -> bool {\n        t.keys.len() <= s.keys.len() && s.keys.len() <= t.keys.len() + 1\n    }\n\n    spec fn set_shrank<K: Ord>(s: &BTreeSet<K>, t: &BTreeSet<K>) -> bool {\n        s.keys.len() <= t.keys.len()\n    }\n\n    spec fn room_set<K: Ord>(s: &BTreeSet<K>) -> bool {\n        s.keys.len() + 1 < 1152921504606846975\n    }\n\n    spec fn kept_set<K: Ord>(s: &BTreeSet<K>, t: &BTreeSet<K>) -> bool {\n        s.keys.len() == t.keys.len() && forall |i: usize| i < s.keys.len() ==> #[trigger] s.keys[i] == t.keys[i]\n    }\n\n    // `insert`'s result: new and inserted in order, or there already and\n    // nothing changed.\n    spec fn added<K: Ord>(r: bool, s: &BTreeSet<K>, t: &BTreeSet<K>, k: &K) -> bool {\n        (r && !holds::<K>(t, k) && exists |p: usize| place::<K>(t.keys.as_slice(), k, p) && #[trigger] inserted_at::<K>(s.keys.as_slice(), t.keys.as_slice(), p, k))\n            || (!r && holds::<K>(t, k) && kept_set::<K>(s, t))\n    }\n\n    // ---------- maps ----------\n\n    // A map from keys in ascending order to values (Rust's `BTreeMap<K, V>`):\n    // the value of `keys[i]` is `vals[i]`. A value is copied out by `get`;\n    // one that moves goes in a `Vec` of its own, mapped to by its position.\n    #[invariant(map_sound)]\n    struct BTreeMap<K: Ord, V> { keys: Vec<K>, vals: Vec<V> }\n\n    spec fn map_sound<K: Ord, V>(m: &BTreeMap<K, V>) -> bool {\n        strictly::<K>(m.keys.as_slice()) && m.keys.len() == m.vals.len()\n    }\n\n    // `m` maps `k` to `v`.\n    spec fn maps<K: Ord, V>(m: &BTreeMap<K, V>, k: &K, v: V) -> bool {\n        exists |i: usize| i < m.keys.len() && #[trigger] m.keys[i] == *k && m.vals[i] == v\n    }\n\n    // `m` has the key `k`.\n    spec fn has_key<K: Ord, V>(m: &BTreeMap<K, V>, k: &K) -> bool {\n        exists |i: usize| i < m.keys.len() && #[trigger] m.keys[i] == *k\n    }\n\n    spec fn got<K: Ord, V>(r: Option<V>, m: &BTreeMap<K, V>, k: &K) -> bool {\n        match r {\n            None => !has_key::<K, V>(m, k),\n            Some(v) => maps::<K, V>(m, k, v),\n        }\n    }\n\n    spec fn key_pos<K: Ord, V>(m: &BTreeMap<K, V>, i: usize) -> bool {\n        i < m.keys.len()\n    }\n\n    spec fn map_room<K: Ord, V>(m: &BTreeMap<K, V>) -> bool {\n        m.keys.len() + 1 < 1152921504606846975\n    }\n\n    // `v` is `w` with `x` at `p` instead.\n    spec fn replaced<V>(v: &[V], w: &[V], p: usize, x: V) -> bool {\n        p < w.len() && v.len() == w.len() && v[p] == x\n            && forall |i: usize| i < w.len() && i != p ==> #[trigger] v[i] == w[i]\n    }\n\n    spec fn kept_map<K: Ord, V>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {\n        m.keys.len() == n.keys.len()\n            && (forall |i: usize| i < m.keys.len() ==> #[trigger] m.keys[i] == n.keys[i])\n            && (forall |j: usize| j < m.vals.len() ==> #[trigger] m.vals[j] == n.vals[j])\n    }\n\n    spec fn same_keys<K: Ord, V>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {\n        m.keys.len() == n.keys.len() && forall |i: usize| i < m.keys.len() ==> #[trigger] m.keys[i] == n.keys[i]\n    }\n\n    // `insert`'s result: a new key in its place with its value, or the old\n    // value of the key, replaced.\n    spec fn put<K: Ord, V>(r: Option<V>, m: &BTreeMap<K, V>, n: &BTreeMap<K, V>, k: &K, x: V) -> bool {\n        match r {\n            None => !has_key::<K, V>(n, k)\n                && exists |p: usize| place::<K>(n.keys.as_slice(), k, p)\n                    && #[trigger] inserted_at::<K>(m.keys.as_slice(), n.keys.as_slice(), p, k)\n                    && inserted_at::<V>(m.vals.as_slice(), n.vals.as_slice(), p, &x),\n            Some(y) => exists |q: usize| q < n.keys.len() && n.keys[q] == *k && n.vals[q] == y\n                && same_keys::<K, V>(m, n) && #[trigger] replaced::<V>(m.vals.as_slice(), n.vals.as_slice(), q, x),\n        }\n    }\n\n    // `remove`'s result: the key's value, the key taken out from its place,\n    // or none and nothing changed.\n    spec fn took<K: Ord, V>(r: Option<V>, m: &BTreeMap<K, V>, n: &BTreeMap<K, V>, k: &K) -> bool {\n        match r {\n            None => !has_key::<K, V>(n, k) && kept_map::<K, V>(m, n),\n            Some(y) => exists |p: usize| p < n.keys.len() && n.keys[p] == *k && n.vals[p] == y\n                && #[trigger] removed_at::<K>(m.keys.as_slice(), n.keys.as_slice(), p)\n                && removed_at::<V>(m.vals.as_slice(), n.vals.as_slice(), p),\n        }\n    }\n\n    impl<K: Ord, V> BTreeMap<K, V> {\n        // An empty map.\n        #[effects(alloc)]\n        #[uses(map_sound, strictly)]\n        fn new() -> (r: BTreeMap<K, V>)\n            ensures empty_map::<K, V>(&r),\n        {\n            let k: Vec<K> = Vec::new();\n            let v: Vec<V> = Vec::new();\n            BTreeMap { keys: k, vals: v }\n        }\n\n        // The number of keys (Rust's `len`).\n        #[effects(pure)]\n        fn len(self: &BTreeMap<K, V>) -> (r: usize)\n            ensures map_size::<K, V>(r, self),\n        {\n            self.keys.len()\n        }\n\n        // Whether the map has `k` (Rust's `contains_key`).\n        #[effects(pure)]\n        #[uses(has_key, map_sound)]\n        fn contains_key(self: &BTreeMap<K, V>, k: &K) -> (r: bool)\n            ensures has_result::<K, V>(r, self, k),\n        {\n            let p: usize = locate::<K>(self.keys.as_slice(), k);\n            p < self.keys.len() && self.keys[p] == *k\n        }\n\n        // Maps `k` to `x`; the old value (Rust's `insert`, which keeps the\n        // key there already).\n        #[effects(alloc)]\n        #[uses(has_key, map_sound, same_keys, shifted)]\n        fn insert(self: &mut BTreeMap<K, V>, k: K, x: V) -> (r: Option<V>)\n            ensures put::<K, V>(r, self, old(self), &k, x), map_grew::<K, V>(self, old(self)),\n        {\n            let p: usize = locate::<K>(self.keys.as_slice(), &k);\n            if p < self.keys.len() && self.keys[p] == k {\n                let y: V = std::mem::replace(&mut self.vals[p], x);\n                assert(replaced::<V>(self.vals.as_slice(), old(self).vals.as_slice(), p, x));\n                return Some(y);\n            }\n            let mut ks: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());\n            let mut vs: Vec<V> = std::mem::replace(&mut self.vals, Vec::new());\n            shift_in::<K>(&mut ks, p, k);\n            shift_in::<V>(&mut vs, p, x);\n            proof {\n                insert_keeps_order::<K>(ks.as_slice(), old(self).keys.as_slice(), p, &ks[p]);\n            }\n            self.keys = ks;\n            self.vals = vs;\n            None\n        }\n\n        // Takes `k` out; its value (Rust's `remove`).\n        #[effects(alloc)]\n        #[uses(has_key, kept_map, map_sound)]\n        fn remove(self: &mut BTreeMap<K, V>, k: &K) -> (r: Option<V>)\n            ensures took::<K, V>(r, self, old(self), k), map_shrank::<K, V>(self, old(self)),\n        {\n            let p: usize = locate::<K>(self.keys.as_slice(), k);\n            if p >= self.keys.len() || self.keys[p] != *k {\n                return None;\n            }\n            let mut ks: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());\n            let mut vs: Vec<V> = std::mem::replace(&mut self.vals, Vec::new());\n            let gone: Option<K> = shift_out::<K>(&mut ks, p);\n            let y: Option<V> = shift_out::<V>(&mut vs, p);\n            proof {\n                remove_keeps_order::<K>(ks.as_slice(), old(self).keys.as_slice(), p);\n            }\n            self.keys = ks;\n            self.vals = vs;\n            y\n        }\n\n        // The keys in ascending order (Rust's `into_keys().collect()`).\n        #[effects(pure)]\n        #[uses(map_sound, strictly)]\n        fn into_keys(self: BTreeMap<K, V>) -> (r: Vec<K>)\n            ensures map_keys::<K, V>(r.as_slice(), &self),\n        {\n            self.keys\n        }\n\n        // The values in the order of their keys (Rust's\n        // `into_values().collect()`).\n        #[effects(pure)]\n        #[uses(map_sound)]\n        fn into_values(self: BTreeMap<K, V>) -> (r: Vec<V>)\n            ensures map_values::<K, V>(r.as_slice(), &self),\n        {\n            self.vals\n        }\n    }\n\n    // Reading a value copies it (Rust's `get` returns a reference, ADR-0015):\n    // only a map of `Copy` values has these (ADR-0097).\n    impl<K: Ord, V: Copy> BTreeMap<K, V> {\n        // The value of `k` (Rust's `get`, the value copied).\n        #[effects(pure)]\n        #[uses(has_key, map_sound, maps)]\n        fn get(self: &BTreeMap<K, V>, k: &K) -> (r: Option<V>)\n            ensures got::<K, V>(r, self, k),\n        {\n            let p: usize = locate::<K>(self.keys.as_slice(), k);\n            if p < self.keys.len() && self.keys[p] == *k {\n                return Some(self.vals[p]);\n            }\n            None\n        }\n\n        // The value at position `i` in the order of the keys (Rust's\n        // `values().nth(i)`).\n        #[effects(pure)]\n        #[uses(map_sound)]\n        fn value_at(self: &BTreeMap<K, V>, i: usize) -> V\n            requires key_pos::<K, V>(self, i),\n        {\n            self.vals[i]\n        }\n    }\n\n    // `r` is the map's keys in ascending order.\n    spec fn map_keys<K: Ord, V>(r: &[K], m: &BTreeMap<K, V>) -> bool {\n        r.len() == m.keys.len() && strictly::<K>(r) && forall |i: usize| i < r.len() ==> #[trigger] r[i] == m.keys[i]\n    }\n\n    // `r` is the map's values in the order of their keys.\n    spec fn map_values<K: Ord, V>(r: &[V], m: &BTreeMap<K, V>) -> bool {\n        r.len() == m.keys.len() && forall |i: usize| i < r.len() ==> #[trigger] r[i] == m.vals[i]\n    }\n\n    spec fn empty_map<K: Ord, V>(m: &BTreeMap<K, V>) -> bool {\n        m.keys.len() == 0\n    }\n\n    spec fn map_size<K: Ord, V>(r: usize, m: &BTreeMap<K, V>) -> bool {\n        r == m.keys.len()\n    }\n\n    // The map has at most one key more.\n    spec fn map_grew<K: Ord, V>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {\n        n.keys.len() <= m.keys.len() && m.keys.len() <= n.keys.len() + 1\n    }\n\n    spec fn map_shrank<K: Ord, V>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {\n        m.keys.len() <= n.keys.len()\n    }\n\n    spec fn has_result<K: Ord, V>(r: bool, m: &BTreeMap<K, V>, k: &K) -> bool {\n        r == has_key::<K, V>(m, k)\n    }\n}\n");
