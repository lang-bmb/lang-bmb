        if i == 8 {
            return String::from("#[summary(\"슬라이스 연산(Rust `slice`의 이름과 뜻): 키의 안정 정렬 순서와 이진 탐색. 정렬은 위치의 순열로 돌려준다 (ADR-0092 §2, backlog 4B-02)\")]\nmod slice {\n    // ---------- sorted order ----------\n\n    // Every index of `r` is below `n`.\n    spec fn below(r: &[usize], n: usize) -> bool {\n        forall |i: usize| i < r.len() ==> #[trigger] r[i] < n\n    }\n\n    // Position `x` comes before position `y` in a stable sort by `keys`:\n    // a smaller key, or the same key and a smaller position.\n    spec fn before<T: Ord>(keys: &[T], x: usize, y: usize) -> bool {\n        keys[x] < keys[y] || (keys[x] == keys[y] && x < y)\n    }\n\n    // The positions `r[0..n]` are in stable order by `keys`, except that\n    // position `j` of `r` is left out (`n` when none is).\n    spec fn ordered_but<T: Ord>(keys: &[T], r: &[usize], j: usize, n: usize) -> bool {\n        n <= r.len()\n            && forall |a: usize, b: usize| a < b && b < n && a != j && b != j\n                ==> before::<T>(keys, #[trigger] r[a], #[trigger] r[b])\n    }\n\n    // `r` lists the positions of `keys` in stable order: a permutation of\n    // `0..n`, since stable order holds no position twice (two equal ones\n    // would need `x < x`).\n    spec fn sorted_order<T: Ord>(r: &[usize], keys: &[T]) -> bool {\n        r.len() == keys.len() && below(r, keys.len()) && ordered_but::<T>(keys, r, r.len(), r.len())\n    }\n\n    // A `Vec<usize>` of `keys.len()` positions fits (eight bytes each).\n    spec fn bounded<T: Ord>(keys: &[T]) -> bool {\n        keys.len() < 1152921504606846975\n    }\n\n    // Every position of `r` but `j` is below `x`.\n    spec fn others_below(r: &[usize], j: usize, n: usize, x: usize) -> bool {\n        n <= r.len() && forall |a: usize| a < n && a != j ==> #[trigger] r[a] < x\n    }\n\n    // The keys of `r` after position `j` are above `keys[x]`.\n    spec fn above<T: Ord>(keys: &[T], r: &[usize], j: usize, n: usize, x: usize) -> bool {\n        n <= r.len() && forall |b: usize| j < b && b < n ==> keys[x] < keys[#[trigger] r[b]]\n    }\n\n    // The positions of `keys` in the order of their keys, equal keys in the\n    // order of their positions: the order Rust's stable `sort_by_key` puts\n    // the items in (`v[r[0]], v[r[1]], ..` is the sorted `v`).\n    #[effects(alloc)]\n    #[uses(before)]\n    fn sort_indices<T: Ord>(keys: &[T]) -> (out: Vec<usize>)\n        ensures sorted_order::<T>(out.as_slice(), keys),\n    {\n        let mut r: Vec<usize> = Vec::new();\n        let mut i: usize = 0;\n        while i < keys.len()\n            invariant i <= keys.len(), r.len() == i, below(r.as_slice(), i),\n                ordered_but::<T>(keys, r.as_slice(), i, i),\n            decreases keys.len() - i,\n        {\n            r.push(i);\n            // Move `i` back past every position with a larger key.\n            let mut j: usize = i;\n            while j > 0 && keys[r[j - 1]] > keys[i]\n                invariant j <= i, r.len() == i + 1, i < keys.len(), r[j] == i, below(r.as_slice(), i + 1),\n                    others_below(r.as_slice(), j, i + 1, i),\n                    ordered_but::<T>(keys, r.as_slice(), j, i + 1), above::<T>(keys, r.as_slice(), j, i + 1, i),\n                decreases j,\n            {\n                let t: usize = r[j - 1];\n                r[j - 1] = i;\n                r[j] = t;\n                j = j - 1;\n            }\n            i = i + 1;\n        }\n        r\n    }\n\n    // No position of `r` occurs twice.\n    spec fn distinct(r: &[usize]) -> bool {\n        forall |i: usize, j: usize| i < j && j < r.len() ==> #[trigger] r[i] != #[trigger] r[j]\n    }\n\n    spec fn order_of<T: Ord>(r: &[usize], keys: &[T]) -> bool {\n        sorted_order::<T>(r, keys)\n    }\n\n    // A stable order of `keys` is a permutation of its positions: each\n    // below the length, none twice.\n    #[uses(before, below, ordered_but, sorted_order)]\n    proof fn sorted_is_perm<T: Ord>(r: &[usize], keys: &[T])\n        requires order_of::<T>(r, keys),\n        ensures distinct(r),\n    {\n    }\n\n    // ---------- binary search ----------\n\n    spec fn ascending<T: Copy + Ord>(v: &[T]) -> bool {\n        forall |i: usize, j: usize| i < j && j < v.len() ==> #[trigger] v[i] <= #[trigger] v[j]\n    }\n\n    // `x` is not in `v` before `a` nor from `b`.\n    spec fn outside<T: Copy + Ord>(v: &[T], x: T, a: usize, b: usize) -> bool {\n        a <= b && b <= v.len()\n            && (forall |k: usize| k < a ==> #[trigger] v[k] < x)\n            && (forall |m: usize| b <= m && m < v.len() ==> x < #[trigger] v[m])\n    }\n\n    // Rust's `binary_search` on a sorted slice: `Ok(i)` where `v[i] == x`\n    // (any of them when several are), `Err(i)` where inserting `x` keeps the\n    // order (everything before is below it, everything after above).\n    spec fn searched<T: Copy + Ord>(r: Result<usize, usize>, v: &[T], x: T) -> bool {\n        match r {\n            Ok(i) => i < v.len() && v[i] == x,\n            Err(j) => outside::<T>(v, x, j, j),\n        }\n    }\n\n    #[effects(pure)]\n    fn binary_search<T: Copy + Ord>(v: &[T], x: T) -> (r: Result<usize, usize>)\n        requires ascending::<T>(v),\n        ensures searched::<T>(r, v, x),\n    {\n        let mut lo: usize = 0;\n        let mut hi: usize = v.len();\n        while lo < hi\n            invariant outside::<T>(v, x, lo, hi),\n            decreases hi - lo,\n        {\n            let mid: usize = lo + (hi - lo) / 2;\n            if v[mid] < x {\n                lo = mid + 1;\n            } else if x < v[mid] {\n                hi = mid;\n            } else {\n                return Ok(mid);\n            }\n        }\n        Err(lo)\n    }\n}\n");
        }
        if i == 9 {
            return String::from("#[summary(\"텍스트 연산(Rust `str`의 이름과 뜻): 접두·접미, 찾기, 떼기, ASCII 공백 다듬기, 글자 해독. 결과는 바이트 명세와 정확히 같고 조각 대신 위치를 돌려준다 (ADR-0092 §2, backlog 4B-02)\")]\nmod str {\n    // ---------- prefixes and suffixes ----------\n\n    // The bytes of `p` begin `s`.\n    spec fn begins(s: &str, p: &str) -> bool {\n        p.len() <= s.len()\n            && forall |j: usize| j < p.len() ==> #[trigger] s.as_bytes()[j] == p.as_bytes()[j]\n    }\n\n    // The first `i` bytes of `p` begin `s`.\n    spec fn agree(s: &str, p: &str, i: usize) -> bool {\n        i <= p.len() && p.len() <= s.len()\n            && forall |j: usize| j < i ==> #[trigger] s.as_bytes()[j] == p.as_bytes()[j]\n    }\n\n    spec fn starts(r: bool, s: &str, p: &str) -> bool {\n        r == begins(s, p)\n    }\n\n    // Whether `p` begins `s` (Rust's `str::starts_with` of a `&str`).\n    #[effects(pure)]\n    #[uses(begins)]\n    fn starts_with(s: &str, p: &str) -> (r: bool)\n        ensures starts(r, s, p),\n    {\n        if p.len() > s.len() {\n            return false;\n        }\n        let mut i: usize = 0;\n        while i < p.len()\n            invariant agree(s, p, i),\n            decreases p.len() - i,\n        {\n            if s.as_bytes()[i] != p.as_bytes()[i] {\n                return false;\n            }\n            i = i + 1;\n        }\n        true\n    }\n\n    // The bytes of `p` end `s`.\n    spec fn ends(s: &str, p: &str) -> bool {\n        p.len() <= s.len()\n            && forall |j: usize| j < p.len() ==> #[trigger] p.as_bytes()[j] == s.as_bytes()[s.len() - p.len() + j]\n    }\n\n    // The first `i` bytes of `p` are the bytes of `s` from `s.len() - p.len()`.\n    spec fn agree_end(s: &str, p: &str, i: usize) -> bool {\n        i <= p.len() && p.len() <= s.len()\n            && forall |j: usize| j < i ==> #[trigger] p.as_bytes()[j] == s.as_bytes()[s.len() - p.len() + j]\n    }\n\n    spec fn ended(r: bool, s: &str, p: &str) -> bool {\n        r == ends(s, p)\n    }\n\n    // Whether `p` ends `s` (Rust's `str::ends_with` of a `&str`).\n    #[effects(pure)]\n    #[uses(ends)]\n    fn ends_with(s: &str, p: &str) -> (r: bool)\n        ensures ended(r, s, p),\n    {\n        if p.len() > s.len() {\n            return false;\n        }\n        let d: usize = s.len() - p.len();\n        let mut i: usize = 0;\n        while i < p.len()\n            invariant agree_end(s, p, i), d + p.len() == s.len(),\n            decreases p.len() - i,\n        {\n            if s.as_bytes()[d + i] != p.as_bytes()[i] {\n                return false;\n            }\n            i = i + 1;\n        }\n        true\n    }\n\n    // ---------- search ----------\n\n    // `r` is the first byte position of `p` in `s`, or none (Rust's `find`\n    // of a `&str`: the position is a character boundary).\n    spec fn found(r: Option<usize>, s: &str, p: &str) -> bool {\n        std::bytes::found(r, s.as_bytes(), p.as_bytes())\n    }\n\n    // The first position of `p` in `s` (Rust's `str::find` of a `&str`).\n    #[effects(pure)]\n    fn find(s: &str, p: &str) -> (r: Option<usize>)\n        ensures found(r, s, p),\n    {\n        std::bytes::find(s.as_bytes(), p.as_bytes())\n    }\n\n    // ---------- stripping ----------\n\n    // `r` is where `s` goes on after the prefix `p`, or none when `p` does\n    // not begin it (Rust's `strip_prefix`, whose result is `&s[r..]`).\n    spec fn stripped(r: Option<usize>, s: &str, p: &str) -> bool {\n        match r {\n            None => !begins(s, p),\n            Some(i) => i == p.len() && begins(s, p),\n        }\n    }\n\n    // The position after the prefix `p` of `s` (Rust's `str::strip_prefix`\n    // of a `&str`, whose result is `&s[i..]`).\n    #[effects(pure)]\n    #[uses(begins)]\n    fn strip_prefix(s: &str, p: &str) -> (r: Option<usize>)\n        ensures stripped(r, s, p),\n    {\n        if starts_with(s, p) {\n            return Some(p.len());\n        }\n        None\n    }\n\n    // `r` is where the suffix `p` of `s` begins, or none when `p` does not\n    // end it (Rust's `strip_suffix`, whose result is `&s[..r]`).\n    spec fn stripped_end(r: Option<usize>, s: &str, p: &str) -> bool {\n        match r {\n            None => !ends(s, p),\n            Some(i) => ends(s, p) && i + p.len() == s.len(),\n        }\n    }\n\n    // The position before the suffix `p` of `s` (Rust's\n    // `str::strip_suffix` of a `&str`, whose result is `&s[..i]`).\n    #[effects(pure)]\n    #[uses(ends)]\n    fn strip_suffix(s: &str, p: &str) -> (r: Option<usize>)\n        ensures stripped_end(r, s, p),\n    {\n        if ends_with(s, p) {\n            return Some(s.len() - p.len());\n        }\n        None\n    }\n\n    // ---------- ASCII whitespace ----------\n\n    // Rust's `u8::is_ascii_whitespace`: space, tab, line feed, form feed,\n    // carriage return.\n    spec fn space(b: u8) -> bool {\n        b == 32 || b == 9 || b == 10 || b == 12 || b == 13\n    }\n\n    spec fn is_space(r: bool, b: u8) -> bool {\n        r == space(b)\n    }\n\n    #[effects(pure)]\n    #[uses(space)]\n    fn ascii_space(b: u8) -> (r: bool)\n        ensures is_space(r, b),\n    {\n        b == b' ' || b == b'\\t' || b == b'\\n' || b == 12 || b == b'\\r'\n    }\n\n    // The bytes of `s` from `a` to `b` are all ASCII whitespace.\n    spec fn spaces(s: &str, a: usize, b: usize) -> bool {\n        a <= b && b <= s.len()\n            && forall |k: usize| a <= k && k < b ==> space(#[trigger] s.as_bytes()[k])\n    }\n\n    // `r` is where `s` goes on after its leading ASCII whitespace.\n    spec fn start_trimmed(r: usize, s: &str) -> bool {\n        spaces(s, 0, r) && (r == s.len() || !space(s.as_bytes()[r]))\n    }\n\n    // The position after the leading ASCII whitespace of `s` (Rust's\n    // `str::trim_ascii_start`, whose result is `&s[i..]`).\n    #[effects(pure)]\n    #[uses(space)]\n    fn trim_ascii_start(s: &str) -> (r: usize)\n        ensures start_trimmed(r, s),\n    {\n        let mut i: usize = 0;\n        while i < s.len() && ascii_space(s.as_bytes()[i])\n            invariant spaces(s, 0, i),\n            decreases s.len() - i,\n        {\n            i = i + 1;\n        }\n        i\n    }\n\n    // `r` is where the trailing ASCII whitespace of `s` begins.\n    spec fn end_trimmed(r: usize, s: &str) -> bool {\n        spaces(s, r, s.len()) && (r == 0 || !space(s.as_bytes()[r - 1]))\n    }\n\n    // The position before the trailing ASCII whitespace of `s` (Rust's\n    // `str::trim_ascii_end`, whose result is `&s[..i]`).\n    #[effects(pure)]\n    #[uses(space)]\n    fn trim_ascii_end(s: &str) -> (r: usize)\n        ensures end_trimmed(r, s),\n    {\n        let mut i: usize = s.len();\n        while i > 0 && ascii_space(s.as_bytes()[i - 1])\n            invariant spaces(s, i, s.len()),\n            decreases i,\n        {\n            i = i - 1;\n        }\n        i\n    }\n\n    // ---------- characters ----------\n\n    // A character of `s` and the position after it.\n    struct Decoded { ch: char, next: usize }\n\n    // The scalar value of the well-formed sequence of `w` bytes at `i`.\n    // `v` is the scalar value of the well-formed sequence of `w` bytes at\n    // `i` of `s`.\n    spec fn is_code(v: u32, s: &[u8], i: usize, w: usize) -> bool {\n        (w == 1 && v == s[i])\n            || (w == 2 && v == (s[i] - 192) * 64 + (s[i + 1] - 128))\n            || (w == 3 && v == (s[i] - 224) * 4096 + (s[i + 1] - 128) * 64 + (s[i + 2] - 128))\n            || (w == 4\n                && v == (s[i] - 240) * 262144 + (s[i + 1] - 128) * 4096 + (s[i + 2] - 128) * 64\n                    + (s[i + 3] - 128))\n    }\n\n    // `r` is the character at byte `i` of `s` and the position after it, or\n    // none where no character begins there (the end, or inside one): the\n    // well-formed sequence of Unicode table 3-7 (`std::utf8::seq_len`).\n    spec fn decoded(r: Option<Decoded>, s: &str, i: usize) -> bool {\n        match r {\n            None => std::utf8::seq_len(s.as_bytes(), i) == 0,\n            Some(d) => 0 < std::utf8::seq_len(s.as_bytes(), i)\n                && d.next == i + std::utf8::seq_len(s.as_bytes(), i)\n                && is_code(u32::from(d.ch), s.as_bytes(), i, std::utf8::seq_len(s.as_bytes(), i)),\n        }\n    }\n\n    spec fn below(i: usize, s: &str) -> bool {\n        i < s.len()\n    }\n\n    // The character at byte `i` of `s` and the position after it (Rust's\n    // `s[i..].chars().next()` at a boundary; ADR-0050 open question 2).\n    #[effects(pure)]\n    #[uses(below, is_code, std::utf8::cont, std::utf8::second3, std::utf8::second4, std::utf8::seq_len)]\n    fn decode_utf8(s: &str, i: usize) -> (r: Option<Decoded>)\n        ensures decoded(r, s, i),\n    {\n        if i >= s.len() {\n            return None;\n        }\n        let w: usize = std::utf8::width(s.as_bytes(), i);\n        if w == 0 {\n            return None;\n        }\n        let b0: u32 = s.as_bytes()[i] as u32;\n        let v: u32 = if w == 1 {\n            b0\n        } else if w == 2 {\n            (b0 - 192) * 64 + (s.as_bytes()[i + 1] as u32 - 128)\n        } else if w == 3 {\n            (b0 - 224) * 4096 + (s.as_bytes()[i + 1] as u32 - 128) * 64 + (s.as_bytes()[i + 2] as u32 - 128)\n        } else {\n            (b0 - 240) * 262144 + (s.as_bytes()[i + 1] as u32 - 128) * 4096\n                + (s.as_bytes()[i + 2] as u32 - 128) * 64 + (s.as_bytes()[i + 3] as u32 - 128)\n        };\n        match char::from_u32(v) {\n            None => None,\n            Some(c) => Some(Decoded { ch: c, next: i + w }),\n        }\n    }\n}\n");
        }
        if i == 10 {
            return String::from("#[summary(\"UTF-8 검증(T4-02): Unicode 표 3-7의 잘 짜인 바이트 시퀀스. 결과는 Rust str::from_utf8의 valid_up_to와 같다\")]\nmod utf8 {\n    spec fn cont(b: u8) -> bool { 128 <= b && b <= 191 }\n\n    // The second byte of a three-byte sequence led by `a` (table 3-7: E0 A0..BF, ED 80..9F, else 80..BF).\n    spec fn second3(a: u8, b: u8) -> bool {\n        (a == 224 && 160 <= b && b <= 191) || (a == 237 && 128 <= b && b <= 159) || (a != 224 && a != 237 && cont(b))\n    }\n\n    // The second byte of a four-byte sequence led by `a` (table 3-7: F0 90..BF, F4 80..8F, else 80..BF).\n    spec fn second4(a: u8, b: u8) -> bool {\n        (a == 240 && 144 <= b && b <= 191) || (a == 244 && 128 <= b && b <= 143) || (a != 240 && a != 244 && cont(b))\n    }\n\n    // Length of the well-formed sequence that starts at `i`, 0 when none does (ill-formed or cut off).\n    spec fn seq_len(s: &[u8], i: usize) -> usize {\n        if i >= s.len() {\n            0\n        } else if s[i] <= 127 {\n            1\n        } else if s[i] < 194 {\n            0\n        } else if s[i] <= 223 {\n            if i + 1 < s.len() && cont(s[i + 1]) { 2 } else { 0 }\n        } else if s[i] <= 239 {\n            if i + 2 < s.len() && second3(s[i], s[i + 1]) && cont(s[i + 2]) { 3 } else { 0 }\n        } else if s[i] <= 244 {\n            if i + 3 < s.len() && second4(s[i], s[i + 1]) && cont(s[i + 2]) && cont(s[i + 3]) { 4 } else { 0 }\n        } else {\n            0\n        }\n    }\n\n    // `s[i..n]` is a concatenation of well-formed sequences: the scan from `i` reaches `n` exactly.\n    spec fn parses(s: &[u8], i: usize, n: usize) -> bool\n        decreases n - i,\n    {\n        if i >= n { i == n } else { 0 < seq_len(s, i) && i + seq_len(s, i) <= n && parses(s, i + seq_len(s, i), n) }\n    }\n\n    // `s[0..n]` is a concatenation of well-formed sequences.\n    spec fn valid_upto(s: &[u8], n: usize) -> bool { n <= s.len() && parses(s, 0, n) }\n\n    // Where the scan stops: the end, or a byte that starts no well-formed sequence.\n    spec fn stops(s: &[u8], r: usize) -> bool { r == s.len() || seq_len(s, r) == 0 }\n\n    spec fn step_ok(s: &[u8], a: usize, i: usize) -> bool {\n        a <= i && parses(s, a, i) && 0 < seq_len(s, i) && i + seq_len(s, i) <= s.len()\n    }\n\n    spec fn extended(s: &[u8], a: usize, i: usize) -> bool { parses(s, a, i + seq_len(s, i)) }\n\n    // A concatenation followed by one more well-formed sequence is a concatenation: induction on\n    // the sequences of `s[a..i]` (ADR-0062).\n    #[uses(parses)]\n    proof fn parses_extend(s: &[u8], a: usize, i: usize)\n        requires step_ok(s, a, i),\n        ensures extended(s, a, i),\n        decreases i - a,\n    {\n        if a < i {\n            parses_extend(s, a + seq_len(s, a), i);\n        }\n    }\n\n    spec fn two_ends(s: &[u8], a: usize, r: usize, n: usize) -> bool {\n        a <= r && r < n && parses(s, a, r) && parses(s, a, n)\n    }\n\n    spec fn goes_on(s: &[u8], r: usize) -> bool { 0 < seq_len(s, r) }\n\n    // The scan is deterministic: a concatenation that reaches `r` and one that reaches past it\n    // agree up to `r`, so a sequence starts at `r`.\n    #[uses(parses)]\n    proof fn parse_goes_on(s: &[u8], a: usize, r: usize, n: usize)\n        requires two_ends(s, a, r, n),\n        ensures goes_on(s, r),\n        decreases r - a,\n    {\n        if a < r {\n            parse_goes_on(s, a + seq_len(s, a), r, n);\n        }\n    }\n\n    spec fn width_result(s: &[u8], i: usize, w: usize) -> bool { w == seq_len(s, i) }\n\n    spec fn at(s: &[u8], i: usize) -> bool { i < s.len() }\n\n    // `seq_len(s, i)` computed.\n    #[effects(pure)]\n    #[uses(seq_len, cont, second3, second4)]\n    fn width(s: &[u8], i: usize) -> (w: usize)\n        requires at(s, i),\n        ensures width_result(s, i, w),\n    {\n        let b: u8 = s[i];\n        if b <= 127 {\n            1\n        } else if b < 194 {\n            0\n        } else if b <= 223 {\n            if i + 1 < s.len() && s[i + 1] >= 128 && s[i + 1] <= 191 { 2 } else { 0 }\n        } else if b <= 239 {\n            if i + 2 < s.len() {\n                let c: u8 = s[i + 1];\n                let ok: bool = if b == 224 {\n                    c >= 160 && c <= 191\n                } else if b == 237 {\n                    c >= 128 && c <= 159\n                } else {\n                    c >= 128 && c <= 191\n                };\n                if ok && s[i + 2] >= 128 && s[i + 2] <= 191 { 3 } else { 0 }\n            } else {\n                0\n            }\n        } else if b <= 244 {\n            if i + 3 < s.len() {\n                let d: u8 = s[i + 1];\n                let fits: bool = if b == 240 {\n                    d >= 144 && d <= 191\n                } else if b == 244 {\n                    d >= 128 && d <= 143\n                } else {\n                    d >= 128 && d <= 191\n                };\n                if fits && s[i + 2] >= 128 && s[i + 2] <= 191 && s[i + 3] >= 128 && s[i + 3] <= 191 { 4 } else { 0 }\n            } else {\n                0\n            }\n        } else {\n            0\n        }\n    }\n\n    // The length of the longest prefix of `s` that is well-formed UTF-8 (Rust: `Utf8Error::valid_up_to`,\n    // or `s.len()` when `str::from_utf8(s)` succeeds).\n    #[effects(pure)]\n    #[uses(parses, seq_len)]\n    fn valid_up_to(s: &[u8]) -> (r: usize)\n        ensures valid_upto(s, r), stops(s, r),\n    {\n        let mut i: usize = 0;\n        while i < s.len()\n            invariant valid_upto(s, i),\n            decreases s.len() - i,\n        {\n            let w: usize = width(s, i);\n            if w == 0 {\n                break;\n            }\n            proof {\n                parses_extend(s, 0, i);\n            }\n            i = i + w;\n        }\n        i\n    }\n\n    spec fn valid(s: &[u8]) -> bool { valid_upto(s, s.len()) }\n\n    spec fn valid_result(s: &[u8], r: bool) -> bool { (r && valid(s)) || (!r && !valid(s)) }\n\n    // Whether all of `s` is well-formed UTF-8 (Rust: `str::from_utf8(s).is_ok()`).\n    #[effects(pure)]\n    fn is_valid(s: &[u8]) -> (r: bool)\n        ensures valid_result(s, r),\n    {\n        let n: usize = valid_up_to(s);\n        // Stopped early: no concatenation reaches the end (it would go on at `n`).\n        proof {\n            if n < s.len() && valid(s) {\n                parse_goes_on(s, 0, n, s.len());\n            }\n        }\n        n == s.len()\n    }\n}\n");
        }
        String::new()
    }
}
