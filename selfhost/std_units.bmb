            return String::from("#[summary(\"CRC-32(T4-04): ISO-HDLC/zlib의 반사 CRC-32(다항식 0xedb88320, 초기값·최종 xor 0xffffffff). 결과는 비트 단위 정의 reg와 같음이 증명된다. Rust crc32fast·Python zlib.crc32와 같은 값\")]\nmod crc32 {\n    // One bit of the register: shift right, and xor the reflected polynomial\n    // when the bit shifted out is set.\n    spec fn bit(c: u32) -> u32 {\n        if c & 1 == 1 { (c >> 1) ^ 0xedb88320 } else { c >> 1 }\n    }\n\n    // One byte: xor it into the low bits, then eight bit steps.\n    spec fn byte(c: u32, b: u8) -> u32 {\n        bit(bit(bit(bit(bit(bit(bit(bit(c ^ b))))))))\n    }\n\n    // The register after feeding `s[0..n]` to the register `c`.\n    spec fn run(c: u32, s: &[u8], n: usize) -> u32\n        decreases n,\n    {\n        if n == 0 || n > s.len() { c } else { byte(run(c, s, n - 1), s[n - 1]) }\n    }\n\n    spec fn bit_result(c: u32, r: u32) -> bool { r == bit(c) }\n\n    spec fn byte_result(c: u32, b: u8, r: u32) -> bool { r == byte(c, b) }\n\n    spec fn ran(c: u32, s: &[u8], n: usize, r: u32) -> bool { n <= s.len() && r == run(c, s, n) }\n\n    // zlib's `crc32(crc, s)`: the checksum `crc` of some bytes continued\n    // with `s`. The register holds the complement of the checksum.\n    spec fn continued(crc: u32, s: &[u8], r: u32) -> bool { r == !run(!crc, s, s.len()) }\n\n    spec fn checksum_of(s: &[u8], r: u32) -> bool { r == !run(0xffffffff, s, s.len()) }\n\n    // zlib's table: entry `k` is the register after the byte `k` from 0.\n    spec fn tabulated(t: &[u32]) -> bool {\n        t.len() == 256 && forall|k: usize| k < 256 ==> #[trigger] t[k] == byte(k, 0)\n    }\n\n    spec fn filled(t: &[u32], n: usize) -> bool {\n        t.len() == 256 && n <= 256 && forall|k: usize| k < n ==> #[trigger] t[k] == byte(k, 0)\n    }\n\n    // One byte by the table: the low byte of `c ^ b` picks the entry, and\n    // the rest of the register moves down a byte.\n    spec fn by_table(c: u32, b: u8) -> bool { byte(c, b) == byte((c ^ b) & 0xff, 0) ^ (c >> 8) }\n\n    #[effects(pure)]\n    #[uses(bit)]\n    fn bit_step(c: u32) -> (r: u32)\n        ensures bit_result(c, r),\n    {\n        if c & 1 == 1 { (c >> 1) ^ 0xedb88320 } else { c >> 1 }\n    }\n\n    // The register after one byte, bit by bit (it fills the table).\n    #[effects(pure)]\n    #[uses(byte)]\n    fn byte_step(c: u32, b: u8) -> (r: u32)\n        ensures byte_result(c, b, r),\n    {\n        let x0: u32 = c ^ b as u32;\n        let x1: u32 = bit_step(x0);\n        let x2: u32 = bit_step(x1);\n        let x3: u32 = bit_step(x2);\n        let x4: u32 = bit_step(x3);\n        let x5: u32 = bit_step(x4);\n        let x6: u32 = bit_step(x5);\n        let x7: u32 = bit_step(x6);\n        bit_step(x7)\n    }\n\n    // The table step is the bitwise one: a fact of the bits of `c` and `b`\n    // alone, proved over bit-vectors (backlog 2N-03; the mixed encoding did\n    // not decide it within rlimit 5,000,000).\n    #[uses(bit)]\n    proof fn table_lemma(c: u32, b: u8)\n        ensures by_table(c, b),\n    {\n        assert(byte(c, b) == byte((c ^ b) & 0xff, 0) ^ (c >> 8)) by (bit_vector);\n    }\n\n    // zlib's 256-entry table.\n    #[effects(pure)]\n    fn table() -> (t: [u32; 256])\n        ensures tabulated(&t),\n    {\n        let mut e: [u32; 256] = [0; 256];\n        for k in 0..e.len()\n            invariant filled(&e, k),\n        {\n            e[k] = byte_step(k as u32, 0);\n        }\n        e\n    }\n\n    // The register after one byte by the table.\n    #[effects(pure)]\n    fn table_step(t: &[u32], c: u32, b: u8) -> (r: u32)\n        requires tabulated(t),\n        ensures byte_result(c, b, r),\n    {\n        proof {\n            table_lemma(c, b);\n        }\n        t[((c ^ b as u32) & 0xff) as usize] ^ (c >> 8)\n    }\n\n    // The checksum `crc` of some bytes, continued with `s`, by the table `t`\n    // (from `table()`: one table serves any number of checksums).\n    #[effects(pure)]\n    #[uses(run)]\n    fn update_with(t: &[u32], crc: u32, s: &[u8]) -> (r: u32)\n        requires tabulated(t),\n        ensures continued(crc, s, r),\n    {\n        let mut c: u32 = !crc;\n        for i in 0..s.len()\n            invariant ran(!crc, s, i, c),\n        {\n            c = table_step(t, c, s[i]);\n        }\n        !c\n    }\n\n    // The checksum `crc` of some bytes, continued with `s` (zlib\n    // `crc32(crc, s)`; `update(0, s)` is the checksum of `s`).\n    #[effects(pure)]\n    fn update(crc: u32, s: &[u8]) -> (r: u32)\n        ensures continued(crc, s, r),\n    {\n        let t: [u32; 256] = table();\n        update_with(&t, crc, s)\n    }\n\n    // The CRC-32 of `s` (`\"123456789\"` gives `0xcbf43926`).\n    #[effects(pure)]\n    fn checksum(s: &[u8]) -> (r: u32)\n        ensures checksum_of(s, r),\n    {\n        update(0, s)\n    }\n}\n");
        }
        if i == 4 {
            return String::from("#[summary(\"인턴 표(rustc의 `Symbol` 표와 같은 뜻): 텍스트마다 번호가 하나, 처음 오면 0부터 다음 번호, 번호는 그 텍스트를 가리킨다. 정렬된 텍스트 키의 맵(std::collections) 위에 선다 (ADR-0092 §2, backlog 4B-02 (g))\")]\nmod intern {\n    // Interned texts: `names[i]` is the text of number `i`, and `ids` maps\n    // each text to its number.\n    #[invariant(sound)]\n    struct Interner { ids: std::collections::BTreeMap<String, usize>, names: Vec<String> }\n\n    // `m` maps each key to the number whose name it is.\n    spec fn consistent<K: Ord>(m: &std::collections::BTreeMap<K, usize>, names: &[K]) -> bool {\n        m.keys.len() == names.len() && m.vals.len() == names.len()\n            && forall |i: usize| i < m.keys.len() ==> #[trigger] m.vals[i] < names.len() && names[m.vals[i]] == m.keys[i]\n    }\n\n    spec fn sound(t: &Interner) -> bool {\n        consistent::<String>(&t.ids, t.names.as_slice())\n    }\n\n    // `names` is `before` with `k` after it.\n    spec fn appended<K: Ord>(names: &[K], before: &[K], k: &K) -> bool {\n        names.len() == before.len() + 1 && names[before.len()] == *k\n            && forall |j: usize| j < before.len() ==> #[trigger] names[j] == before[j]\n    }\n\n    spec fn insert_pre<K: Ord>(m: &std::collections::BTreeMap<K, usize>, n: &std::collections::BTreeMap<K, usize>, names: &[K], before: &[K], k: &K) -> bool {\n        (exists |p: usize| #[trigger] std::collections::inserted_at::<K>(m.keys.as_slice(), n.keys.as_slice(), p, k)\n            && std::collections::inserted_at::<usize>(m.vals.as_slice(), n.vals.as_slice(), p, &before.len()))\n            && consistent::<K>(n, before) && appended::<K>(names, before, k)\n    }\n\n    // A new key mapped to the next number, its name added at that number,\n    // keeps the map and the names consistent. Over any `Ord` keys: the\n    // instance for `String` is the same statement.\n    #[uses(appended, std::collections::inserted_at, std::collections::shifted)]\n    proof fn insert_keeps<K: Ord>(m: &std::collections::BTreeMap<K, usize>, n: &std::collections::BTreeMap<K, usize>, names: &[K], before: &[K], k: &K)\n        requires insert_pre::<K>(m, n, names, before, k),\n        ensures consistent::<K>(m, names),\n    {\n    }\n\n    // Number `r` names `s`.\n    spec fn named(t: &Interner, r: usize, s: &str) -> bool {\n        r < t.names.len() && t.names[r] == s\n    }\n\n    // `get`'s result: the number that names `s`, or none when no number\n    // does.\n    spec fn found(r: Option<usize>, t: &Interner, s: &str) -> bool {\n        match r {\n            None => forall |i: usize| i < t.ids.keys.len() ==> #[trigger] t.ids.keys[i] != s,\n            Some(j) => named(t, j, s),\n        }\n    }\n\n    spec fn id_pos(t: &Interner, i: usize) -> bool {\n        i < t.names.len()\n    }\n\n    spec fn room(t: &Interner) -> bool {\n        t.names.len() + 1 < 1152921504606846975\n    }\n\n    // At most one text more (what a caller needs to intern again).\n    spec fn grew(t: &Interner, u: &Interner) -> bool {\n        u.names.len() <= t.names.len() && t.names.len() <= u.names.len() + 1\n    }\n\n    spec fn empty(t: &Interner) -> bool {\n        t.names.len() == 0\n    }\n\n    spec fn size(r: usize, t: &Interner) -> bool {\n        r == t.names.len()\n    }\n\n    // `out` is `before` with the name of `i` after it.\n    spec fn pushed_name(out: &str, before: &str, t: &Interner, i: usize) -> bool {\n        i < t.names.len() && out.len() == before.len() + t.names[i].len()\n    }\n\n    spec fn name_room(out: &str, t: &Interner, i: usize) -> bool {\n        i < t.names.len() && out.len() + t.names[i].len() <= 9223372036854775807\n    }\n\n    impl Interner {\n        // An empty table.\n        #[effects(alloc)]\n        #[uses(consistent, sound, std::collections::map_sound)]\n        fn new() -> (r: Interner)\n            ensures empty(&r),\n        {\n            let m: std::collections::BTreeMap<String, usize> = std::collections::BTreeMap::<String, usize>::new();\n            let v: Vec<String> = Vec::new();\n            Interner { ids: m, names: v }\n        }\n\n        // How many texts the table has.\n        #[effects(pure)]\n        fn len(self: &Interner) -> (r: usize)\n            ensures size(r, self),\n        {\n            self.names.len()\n        }\n\n        // The number of `s`: its own if it came before, else the next one\n        // (rustc's `Symbol::intern`).\n        #[effects(alloc)]\n        #[uses(appended, sound, std::collections::has_key, std::collections::maps)]\n        fn intern(self: &mut Interner, s: &str) -> (r: usize)\n            ensures named(self, r, s), grew(self, old(self)),\n        {\n            let known: Option<usize> = self.ids.get(&String::from(s));\n            match known {\n                None => {\n                    let fresh: usize = self.names.len();\n                    let key: String = String::from(s);\n                    self.ids.insert(key.clone(), fresh);\n                    self.names.push(key);\n                    proof {\n                        insert_keeps::<String>(&self.ids, &old(self).ids, self.names.as_slice(), old(self).names.as_slice(), &self.names[fresh]);\n                    }\n                    fresh\n                }\n                Some(id) => id,\n            }\n        }\n\n        // The number of `s` if it came before (rustc's interner's `get`).\n        #[effects(alloc)]\n        #[uses(consistent, named, sound, std::collections::has_key, std::collections::maps)]\n        fn get(self: &Interner, s: &str) -> (r: Option<usize>)\n            ensures found(r, self, s),\n        {\n            self.ids.get(&String::from(s))\n        }\n\n        // Whether number `i` names `s`.\n        #[effects(pure)]\n        fn name_is(self: &Interner, i: usize, s: &str) -> bool\n            requires id_pos(self, i),\n        {\n            self.names[i] == s\n        }\n\n        // Adds the name of number `i` to `out` (rustc's `Symbol::as_str`,\n        // which borrows it).\n        #[effects(alloc)]\n        fn push_name(self: &Interner, i: usize, out: &mut String) -> ()\n            requires id_pos(self, i),\n            ensures pushed_name(out.as_str(), old(out).as_str(), self, i),\n        {\n            out.push_str(self.names[i].as_str());\n        }\n\n        // The names in the order of their numbers.\n        #[effects(pure)]\n        #[uses(sound)]\n        fn into_names(self: Interner) -> Vec<String> {\n            self.names\n        }\n    }\n}\n");
        }
        if i == 5 {
            return String::from("#[summary(\"JSON(RFC 8259) 읽기와 쓰기: 텍스트를 노드 배열(simdjson의 테이프)로 해석하고 쌓기로 중첩을 따라가며, 문자열을 serde_json과 같은 규칙으로 쓴다. JSONTestSuite의 y_·n_ 판정과 값이 Python json과 같다 (ADR-0092 §2, backlog 4B-02 (h)·T4-05)\")]\nmod json {\n    spec fn upto(t: &[u8], i: usize) -> bool {\n        i <= t.len()\n    }\n\n    spec fn moved_on(t: &[u8], i: usize, r: usize) -> bool {\n        i <= r && r <= t.len()\n    }\n\n    spec fn ended(t: &[u8], i: usize, r: Option<usize>) -> bool {\n        match r {\n            None => true,\n            Some(e) => i < e && e <= t.len(),\n        }\n    }\n\n    // The first position from `i` that is not JSON whitespace.\n    #[effects(pure)]\n    fn skip_ws(t: &[u8], i: usize) -> (r: usize)\n        requires upto(t, i),\n        ensures moved_on(t, i, r),\n    {\n        let mut j: usize = i;\n        while j < t.len() && (t[j] == b' ' || t[j] == b'\\t' || t[j] == b'\\n' || t[j] == b'\\r')\n            invariant i <= j, j <= t.len(),\n            decreases t.len() - j,\n        {\n            j = j + 1;\n        }\n        j\n    }\n\n    #[effects(pure)]\n    fn is_hex(b: u8) -> bool {\n        (b'0' <= b && b <= b'9') || (b'a' <= b && b <= b'f') || (b'A' <= b && b <= b'F')\n    }\n\n    #[effects(pure)]\n    fn is_digit(b: u8) -> bool {\n        b'0' <= b && b <= b'9'\n    }\n\n    // The end of the digits from `i`.\n    #[effects(pure)]\n    fn digits(t: &[u8], i: usize) -> (r: usize)\n        requires upto(t, i),\n        ensures moved_on(t, i, r),\n    {\n        let mut j: usize = i;\n        while j < t.len() && is_digit(t[j])\n            invariant i <= j, j <= t.len(),\n            decreases t.len() - j,\n        {\n            j = j + 1;\n        }\n        j\n    }\n\n    spec fn at(t: &[u8], i: usize) -> bool {\n        i < t.len()\n    }\n\n    // The end of the number at `i` (RFC 8259 §6: `-`, then `0` or digits\n    // not led by `0`, then `.` and digits, then `e` or `E`, a sign and\n    // digits), none when there is none.\n    #[effects(pure)]\n    fn number_end(t: &[u8], i: usize) -> (r: Option<usize>)\n        requires at(t, i),\n        ensures ended(t, i, r),\n    {\n        let mut j: usize = i;\n        if t[j] == b'-' {\n            j = j + 1;\n        }\n        if j >= t.len() || !is_digit(t[j]) {\n            return None;\n        }\n        if t[j] == b'0' {\n            j = j + 1;\n        } else {\n            j = digits(t, j + 1);\n        }\n        if j < t.len() && t[j] == b'.' {\n            let f: usize = digits(t, j + 1);\n            if f == j + 1 {\n                return None;\n            }\n            j = f;\n        }\n        if j < t.len() && (t[j] == b'e' || t[j] == b'E') {\n            let mut k: usize = j + 1;\n            if k < t.len() && (t[k] == b'+' || t[k] == b'-') {\n                k = k + 1;\n            }\n            let x: usize = digits(t, k);\n            if x == k {\n                return None;\n            }\n            j = x;\n        }\n        Some(j)\n    }\n\n    // The position after the string that starts at `i` (a `\"`), none when\n    // it is not one: no byte below 32, escapes `\\\"` `\\\\` `\\/` `\\b` `\\f`\n    // `\\n` `\\r` `\\t` and `\\u` with four hex digits, the rest UTF-8.\n    #[effects(pure)]\n    #[uses(std::utf8::seq_len)]\n    fn string_end(t: &[u8], i: usize) -> (r: Option<usize>)\n        requires at(t, i),\n        ensures ended(t, i, r),\n    {\n        let mut j: usize = i + 1;\n        while j < t.len()\n            invariant i < j, j <= t.len(),\n            decreases t.len() - j,\n        {\n            let b: u8 = t[j];\n            if b == b'\"' {\n                return Some(j + 1);\n            } else if b < 32 {\n                return None;\n            } else if b == b'\\\\' {\n                if j + 1 >= t.len() {\n                    return None;\n                }\n                let e: u8 = t[j + 1];\n                if e == b'u' {\n                    if j + 5 >= t.len() || !is_hex(t[j + 2]) || !is_hex(t[j + 3]) || !is_hex(t[j + 4]) || !is_hex(t[j + 5]) {\n                        return None;\n                    }\n                    j = j + 6;\n                } else if e == b'\"' || e == b'\\\\' || e == b'/' || e == b'b' || e == b'f' || e == b'n' || e == b'r' || e == b't' {\n                    j = j + 2;\n                } else {\n                    return None;\n                }\n            } else if b < 128 {\n                j = j + 1;\n            } else {\n                let w: usize = std::utf8::width(t, j);\n                if w == 0 {\n                    return None;\n                }\n                j = j + w;\n            }\n        }\n        None\n    }\n\n    // The end of the literal `true`, `false` or `null` at `i`.\n    #[effects(pure)]\n    fn literal_end(t: &[u8], i: usize) -> (r: Option<usize>)\n        requires at(t, i),\n        ensures ended(t, i, r),\n    {\n        if t[i] == b't' && i + 3 < t.len() && t[i + 1] == b'r' && t[i + 2] == b'u' && t[i + 3] == b'e' {\n            return Some(i + 4);\n        }\n        if t[i] == b'f' && i + 4 < t.len() && t[i + 1] == b'a' && t[i + 2] == b'l' && t[i + 3] == b's' && t[i + 4] == b'e' {\n            return Some(i + 5);\n        }\n        if t[i] == b'n' && i + 3 < t.len() && t[i + 1] == b'u' && t[i + 2] == b'l' && t[i + 3] == b'l' {\n            return Some(i + 4);\n        }\n        None\n    }\n\n    // The end of the scalar value (string, number, literal) at `i`.\n    #[effects(pure)]\n    fn scalar_end(t: &[u8], i: usize) -> (r: Option<usize>)\n        requires at(t, i),\n        ensures ended(t, i, r),\n    {\n        let b: u8 = t[i];\n        if b == b'\"' {\n            string_end(t, i)\n        } else if b == b'-' || is_digit(b) {\n            number_end(t, i)\n        } else {\n            literal_end(t, i)\n        }\n    }\n\n    spec fn short(t: &[u8]) -> bool {\n        t.len() < 1152921504606846975\n    }\n\n\n    // A value of a JSON text: its kind (0 `null`, 1 `false`, 2 `true`, 3\n    // number, 4 string, 5 array, 6 object), its bytes `start..end` and the\n    // node after it and all it holds (`next`). An array's elements and an\n    // object's keys and values (each key a string node before its value)\n    // follow it in order.\n    struct Node { kind: u8, start: usize, end: usize, next: usize }\n\n    // A parsed JSON text: its nodes in order, the first the whole value\n    // (simdjson's tape), and the length of the text.\n    #[invariant(doc_sound)]\n    struct Doc { nodes: Vec<Node>, len: usize }\n\n    // Every node lies in the first `len` bytes and its `next` is after it.\n    spec fn nodes_in(v: &[Node], n: usize, len: usize) -> bool {\n        n == v.len() && forall |k: usize| k < v.len() ==> #[trigger] v[k].start < v[k].end && v[k].end <= len && k < v[k].next && v[k].next <= n\n    }\n\n    spec fn doc_sound(d: &Doc) -> bool {\n        nodes_in(d.nodes.as_slice(), d.nodes.len(), d.len) && d.nodes.len() > 0 && d.len < 1152921504606846975\n    }\n\n    // The open arrays and objects are nodes.\n    spec fn opens(open: &[usize], n: usize) -> bool {\n        forall |k: usize| k < open.len() ==> #[trigger] open[k] < n\n    }\n\n    // The parser's state at byte `i`: the nodes so far lie before `i`, the\n    // open arrays and objects are among them, and both fit.\n    spec fn tape(v: &[Node], open: &[usize], i: usize) -> bool {\n        v.len() <= i && open.len() <= i && i < 1152921504606846975 && nodes_in(v, v.len(), i) && opens(open, v.len())\n    }\n\n    spec fn parsed(r: &Option<Doc>, t: &[u8]) -> bool {\n        match r {\n            None => true,\n            Some(d) => d.len == t.len(),\n        }\n    }\n\n    // The kind of the scalar value led by `b`.\n    #[effects(pure)]\n    fn scalar_kind(b: u8) -> u8 {\n        if b == b'n' {\n            0\n        } else if b == b'f' {\n            1\n        } else if b == b't' {\n            2\n        } else if b == b'\"' {\n            4\n        } else {\n            3\n        }\n    }\n\n    spec fn moved_pre(v: &[Node], open: &[usize], i: usize, j: usize) -> bool {\n        tape(v, open, i) && i < j && j < 1152921504606846975\n    }\n\n    spec fn add_pre(v: &[Node], open: &[usize], start: usize, end: usize, j: usize) -> bool {\n        tape(v, open, start) && start < end && end <= j && j < 1152921504606846975\n    }\n\n    spec fn one_node_more(v: &[Node], w: &[Node]) -> bool {\n        v.len() == w.len() + 1\n    }\n\n    spec fn same_len(v: &[Node], w: &[Node]) -> bool {\n        v.len() == w.len()\n    }\n\n    // The state holds at a later byte.\n    #[uses(nodes_in, opens)]\n    proof fn later(v: &[Node], open: &[usize], i: usize, j: usize)\n        requires moved_pre(v, open, i, j),\n        ensures tape(v, open, j),\n    {\n    }\n\n    // Adds a node of `kind` over `start..end` with nothing in it (its\n    // `next` is the node after it); the state holds at `j`.\n    #[effects(alloc)]\n    #[uses(nodes_in, opens)]\n    fn add(v: &mut Vec<Node>, open: &[usize], kind: u8, start: usize, end: usize, j: usize) -> ()\n        requires add_pre(v.as_slice(), open, start, end, j),\n        ensures tape(v.as_slice(), open, j), one_node_more(v.as_slice(), old(v).as_slice()),\n    {\n        let k: usize = v.len();\n        v.push(Node { kind: kind, start: start, end: end, next: k + 1 });\n    }\n\n    // Opens an array (`kind` 5) or object (6) at the bracket at `i`; the\n    // state holds at `j`.\n    #[effects(alloc)]\n    #[uses(nodes_in, opens)]\n    fn open_at(v: &mut Vec<Node>, open: &mut Vec<usize>, kind: u8, i: usize, j: usize) -> ()\n        requires moved_pre(v.as_slice(), open.as_slice(), i, j),\n        ensures tape(v.as_slice(), open.as_slice(), j),\n    {\n        let k: usize = v.len();\n        v.push(Node { kind: kind, start: i, end: i + 1, next: k + 1 });\n        open.push(k);\n    }\n\n    // Closes the innermost open array or object with the bracket at `i`:\n    // it ends after `i`, and the node after it is the next one to come;\n    // false when none is open. The state holds at `j`.\n    #[effects(pure)]\n    #[uses(nodes_in, opens)]\n    fn close(v: &mut Vec<Node>, open: &mut Vec<usize>, i: usize, j: usize) -> (r: bool)\n        requires moved_pre(v.as_slice(), open.as_slice(), i, j),\n        ensures tape(v.as_slice(), open.as_slice(), j), same_len(v.as_slice(), old(v).as_slice()),\n    {\n        match open.pop() {\n            None => false,\n            Some(k) => {\n                let n: usize = v.len();\n                v[k].end = i + 1;\n                v[k].next = n;\n                true\n            }\n        }\n    }\n\n    spec fn some_open(v: &[Node], open: &[usize], i: usize) -> bool {\n        tape(v, open, i) && open.len() > 0\n    }\n\n    // The kind of the innermost open array or object.\n    #[effects(pure)]\n    #[uses(nodes_in, opens, tape)]\n    fn top_kind(v: &[Node], open: &[usize], i: usize) -> u8\n        requires some_open(v, open, i),\n    {\n        v[open[open.len() - 1]].kind\n    }\n\n    spec fn done_pre(v: &[Node], open: &[usize], i: usize) -> bool {\n        tape(v, open, i) && v.len() > 0\n    }\n\n    spec fn doc_of(d: &Doc, n: usize) -> bool {\n        d.len == n\n    }\n\n    // The parsed text of length `n`.\n    #[effects(pure)]\n    #[uses(doc_sound, nodes_in, opens, tape)]\n    fn done(v: Vec<Node>, open: &[usize], n: usize) -> (d: Doc)\n        requires done_pre(v.as_slice(), open, n),\n        ensures doc_of(&d, n),\n    {\n        Doc { nodes: v, len: n }\n    }\n\n    // The nodes of `t` when it is one JSON text (RFC 8259 §2: a value\n    // between whitespace), none when it is not. The open arrays and objects\n    // are a stack, so the depth is not the machine's. The state (`tape`) is\n    // kept by the helpers above, so this function's queries do not see its\n    // quantifiers.\n    #[effects(alloc)]\n    fn parse(t: &[u8]) -> (r: Option<Doc>)\n        requires short(t),\n        ensures parsed(&r, t),\n    {\n        // `state`: 0 a value is due, 1 a value or `]` (just after `[`), 2 a\n        // key is due, 3 a key or `}` (just after `{`), 4 `:` is due, 5 a\n        // value has ended.\n        let mut nodes: Vec<Node> = Vec::new();\n        let mut open: Vec<usize> = Vec::new();\n        let mut state: u8 = 0;\n        let mut i: usize = skip_ws(t, 0);\n        proof {\n            first(nodes.as_slice(), open.as_slice(), i);\n        }\n        while i < t.len()\n            invariant i <= t.len(), tape(nodes.as_slice(), open.as_slice(), i),\n            decreases t.len() - i,\n        {\n            let b: u8 = t[i];\n            if state == 0 || state == 1 {\n                if state == 1 && b == b']' {\n                    let j1: usize = skip_ws(t, i + 1);\n                    if !close(&mut nodes, &mut open, i, j1) {\n                        return None;\n                    }\n                    state = 5;\n                    i = j1;\n                } else if b == b'[' || b == b'{' {\n                    let j2: usize = skip_ws(t, i + 1);\n                    if b == b'[' {\n                        open_at(&mut nodes, &mut open, 5, i, j2);\n                        state = 1;\n                    } else {\n                        open_at(&mut nodes, &mut open, 6, i, j2);\n                        state = 3;\n                    }\n                    i = j2;\n                } else {\n                    match scalar_end(t, i) {\n                        None => {\n                            return None;\n                        }\n                        Some(e) => {\n                            let j3: usize = skip_ws(t, e);\n                            add(&mut nodes, open.as_slice(), scalar_kind(t[i]), i, e, j3);\n                            state = 5;\n                            i = j3;\n                        }\n                    }\n                }\n            } else if state == 2 || state == 3 {\n                if state == 3 && b == b'}' {\n                    let j4: usize = skip_ws(t, i + 1);\n                    if !close(&mut nodes, &mut open, i, j4) {\n                        return None;\n                    }\n                    state = 5;\n                    i = j4;\n                } else if b == b'\"' {\n                    match string_end(t, i) {\n                        None => {\n                            return None;\n                        }\n                        Some(f) => {\n                            let j5: usize = skip_ws(t, f);\n                            add(&mut nodes, open.as_slice(), 4, i, f, j5);\n                            state = 4;\n                            i = j5;\n                        }\n                    }\n                } else {\n                    return None;\n                }\n            } else if state == 4 {\n                if b != b':' {\n                    return None;\n                }\n                let j6: usize = skip_ws(t, i + 1);\n                proof {\n                    later(nodes.as_slice(), open.as_slice(), i, j6);\n                }\n                state = 0;\n                i = j6;\n            } else {\n                if open.len() == 0 {\n                    return None;\n                }\n                let top: u8 = top_kind(nodes.as_slice(), open.as_slice(), i);\n                let j7: usize = skip_ws(t, i + 1);\n                if b == b',' {\n                    proof {\n                        later(nodes.as_slice(), open.as_slice(), i, j7);\n                    }\n                    state = if top == 5 {\n                        0\n                    } else {\n                        2\n                    };\n                    i = j7;\n                } else if (b == b']' && top == 5) || (b == b'}' && top == 6) {\n                    if !close(&mut nodes, &mut open, i, j7) {\n                        return None;\n                    }\n                    i = j7;\n                } else {\n                    return None;\n                }\n            }\n        }\n        if state == 5 && open.len() == 0 && nodes.len() > 0 {\n            return Some(done(nodes, open.as_slice(), t.len()));\n        }\n        None\n    }\n\n    spec fn first_pre(v: &[Node], open: &[usize], i: usize) -> bool {\n        v.len() == 0 && open.len() == 0 && i < 1152921504606846975\n    }\n\n    // The state holds at the start.\n    #[uses(nodes_in, opens)]\n    proof fn first(v: &[Node], open: &[usize], i: usize)\n        requires first_pre(v, open, i),\n        ensures tape(v, open, i),\n    {\n    }\n\n    // Whether `t` is one JSON text.\n    #[effects(alloc)]\n    fn is_json(t: &[u8]) -> bool\n        requires short(t),\n    {\n        match parse(t) {\n            None => false,\n            Some(d) => true,\n        }\n    }\n\n    // ---------- reading the nodes ----------\n\n    spec fn node_pos(d: &Doc, i: usize) -> bool {\n        i < d.nodes.len()\n    }\n\n    spec fn of_text(d: &Doc, t: &[u8]) -> bool {\n        d.len == t.len()\n    }\n\n    spec fn after(d: &Doc, i: usize, r: usize) -> bool {\n        i < r && r <= d.nodes.len()\n    }\n\n    spec fn node_count(d: &Doc, r: usize) -> bool {\n        r == d.nodes.len()\n    }\n\n    spec fn span_start(d: &Doc, i: usize, r: usize) -> bool {\n        r == d.nodes[i].start && r < d.nodes[i].end && d.nodes[i].end <= d.len\n    }\n\n    spec fn span_end(d: &Doc, i: usize, r: usize) -> bool {\n        r == d.nodes[i].end && d.nodes[i].start < r && r <= d.len\n    }\n\n    spec fn some_node(d: &Doc, r: Option<usize>) -> bool {\n        match r {\n            None => true,\n            Some(j) => j < d.nodes.len(),\n        }\n    }\n\n    impl Doc {\n        // How many nodes the text has (the whole value is node 0).\n        #[effects(pure)]\n        fn count(self: &Doc) -> (r: usize)\n            ensures node_count(self, r),\n        {\n            self.nodes.len()\n        }\n\n        // The kind of node `i`: 0 `null`, 1 `false`, 2 `true`, 3 number, 4\n        // string, 5 array, 6 object.\n        #[effects(pure)]\n        fn kind(self: &Doc, i: usize) -> u8\n            requires node_pos(self, i),\n        {\n            self.nodes[i].kind\n        }\n\n        // Where node `i` begins in the text.\n        #[effects(pure)]\n        #[uses(doc_sound, nodes_in)]\n        fn start(self: &Doc, i: usize) -> (r: usize)\n            requires node_pos(self, i),\n            ensures span_start(self, i, r),\n        {\n            self.nodes[i].start\n        }\n\n        // Where node `i` ends in the text.\n        #[effects(pure)]\n        #[uses(doc_sound, nodes_in)]\n        fn end(self: &Doc, i: usize) -> (r: usize)\n            requires node_pos(self, i),\n            ensures span_end(self, i, r),\n        {\n            self.nodes[i].end\n        }\n\n        // The node after node `i` and everything it holds.\n        #[effects(pure)]\n        #[uses(doc_sound, nodes_in)]\n        fn next(self: &Doc, i: usize) -> (r: usize)\n            requires node_pos(self, i),\n            ensures after(self, i, r),\n        {\n            self.nodes[i].next\n        }\n\n        // Element `n` of array node `a` (Rust's `serde_json::Value::get`\n        // with an index).\n        #[effects(pure)]\n        #[uses(doc_sound, nodes_in)]\n        fn element(self: &Doc, a: usize, n: usize) -> (r: Option<usize>)\n            requires node_pos(self, a),\n            ensures some_node(self, r),\n        {\n            if self.nodes[a].kind != 5 {\n                return None;\n            }\n            let end: usize = self.nodes[a].next;\n            let mut c: usize = a + 1;\n            let mut k: usize = 0;\n            while c < end && k < n\n                invariant a < c, c <= self.nodes.len(), end <= self.nodes.len(),\n                decreases end - c,\n            {\n                c = self.nodes[c].next;\n                k = k + 1;\n            }\n            if c < end {\n                return Some(c);\n            }\n            None\n        }\n\n        // Whether string node `i` is `k`, byte for byte between its quotes\n        // (a key with an escape is not; read it with `string_value`).\n        #[effects(pure)]\n        #[uses(doc_sound, nodes_in)]\n        fn raw_is(self: &Doc, t: &[u8], i: usize, k: &str) -> bool\n            requires node_pos(self, i), of_text(self, t),\n        {\n            let a: usize = self.nodes[i].start;\n            let b: usize = self.nodes[i].end;\n            if self.nodes[i].kind != 4 || b < a + 2 || b - a - 2 != k.len() {\n                return false;\n            }\n            let kb: usize = k.len();\n            let mut j: usize = 0;\n            while j < kb\n                invariant j <= kb, a + 1 + kb < b + 1, b <= t.len(),\n                decreases kb - j,\n            {\n                if t[a + 1 + j] != k.as_bytes()[j] {\n                    return false;\n                }\n                j = j + 1;\n            }\n            true\n        }\n\n        // The value of member `k` of object node `o` (Rust's\n        // `serde_json::Value::get` with a key; keys compared as `raw_is`).\n        #[effects(pure)]\n        #[uses(doc_sound, nodes_in)]\n        fn member(self: &Doc, t: &[u8], o: usize, k: &str) -> (r: Option<usize>)\n            requires node_pos(self, o), of_text(self, t),\n            ensures some_node(self, r),\n        {\n            if self.nodes[o].kind != 6 {\n                return None;\n            }\n            let end: usize = self.nodes[o].next;\n            let mut c: usize = o + 1;\n            while c + 1 < end\n                invariant o < c, c <= self.nodes.len(), end <= self.nodes.len(),\n                decreases end - c,\n            {\n                if self.raw_is(t, c, k) {\n                    return Some(c + 1);\n                }\n                c = self.nodes[c + 1].next;\n            }\n            None\n        }\n\n        // The integer of number node `i`, when it is one that fits.\n        #[effects(pure)]\n        #[uses(doc_sound, nodes_in)]\n        fn i64_value(self: &Doc, t: &[u8], i: usize) -> Option<i64>\n            requires node_pos(self, i), of_text(self, t),\n        {\n            if self.nodes[i].kind != 3 {\n                return None;\n            }\n            std::num::parse_i64_bytes(&t[self.nodes[i].start..self.nodes[i].end])\n        }\n\n        // The text of string node `i` with its escapes decoded, none when a\n        // `\\u` escape is a surrogate without its pair (as `serde_json`).\n        #[effects(alloc)]\n        #[uses(doc_sound, nodes_in)]\n        fn string_value(self: &Doc, t: &[u8], i: usize) -> Option<String>\n            requires node_pos(self, i), of_text(self, t),\n        {\n            if self.nodes[i].kind != 4 || self.nodes[i].end < self.nodes[i].start + 2 {\n                return None;\n            }\n            let b: usize = self.nodes[i].end - 1;\n            let mut v: Vec<u8> = Vec::new();\n            let mut j: usize = self.nodes[i].start + 1;\n            while j < b\n                invariant j <= b, b < t.len(), v.len() <= j,\n                decreases b - j,\n            {\n                let c: u8 = t[j];\n                if c != b'\\\\' || j + 1 >= b {\n                    v.push(c);\n                    j = j + 1;\n                } else {\n                    let e: u8 = t[j + 1];\n                    if e == b'u' {\n                        match unit_at(t, j, b) {\n                            None => {\n                                return None;\n                            }\n                            Some(u) => {\n                                if 55296 <= u && u <= 56319 {\n                                    // A high surrogate: its low one follows.\n                                    if j + 11 < b + 1 && t[j + 6] == b'\\\\' && t[j + 7] == b'u' {\n                                        match unit_at(t, j + 6, b) {\n                                            None => {\n                                                return None;\n                                            }\n                                            Some(w) => {\n                                                if 56320 <= w && w <= 57343 {\n                                                    push_utf8(&mut v, 65536 + (u - 55296) * 1024 + (w - 56320));\n                                                    j = j + 12;\n                                                } else {\n                                                    return None;\n                                                }\n                                            }\n                                        }\n                                    } else {\n                                        return None;\n                                    }\n                                } else if 56320 <= u && u <= 57343 {\n                                    return None;\n                                } else {\n                                    push_utf8(&mut v, u);\n                                    j = j + 6;\n                                }\n                            }\n                        }\n                    } else {\n                        v.push(unescaped(e));\n                        j = j + 2;\n                    }\n                }\n            }\n            match String::from_utf8(v) {\n                Ok(s) => Some(s),\n                Err(x) => None,\n            }\n        }\n    }\n\n    // The byte an escape `\\e` stands for (`e` one of `\"\\/bfnrt`).\n    #[effects(pure)]\n    fn unescaped(e: u8) -> u8 {\n        if e == b'b' {\n            8\n        } else if e == b'f' {\n            12\n        } else if e == b'n' {\n            10\n        } else if e == b'r' {\n            13\n        } else if e == b't' {\n            9\n        } else {\n            e\n        }\n    }\n\n    #[effects(pure)]\n    fn hex_value(b: u8) -> u32 {\n        if b'0' <= b && b <= b'9' {\n            (b - b'0') as u32\n        } else if b'a' <= b && b <= b'f' {\n            (b - b'a') as u32 + 10\n        } else if b'A' <= b && b <= b'F' {\n            (b - b'A') as u32 + 10\n        } else {\n            0\n        }\n    }\n\n    spec fn unit_pos(t: &[u8], j: usize, b: usize) -> bool {\n        j < b && b <= t.len()\n    }\n\n    spec fn unit_range(r: Option<u32>, j: usize, b: usize) -> bool {\n        match r {\n            None => true,\n            Some(u) => u <= 65535 && j + 6 <= b,\n        }\n    }\n\n    // The code unit of the escape `\\uXXXX` at `j`, when it ends by `b`.\n    #[effects(pure)]\n    fn unit_at(t: &[u8], j: usize, b: usize) -> (r: Option<u32>)\n        requires unit_pos(t, j, b),\n        ensures unit_range(r, j, b),\n    {\n        if j + 6 > b {\n            return None;\n        }\n        let a: u32 = hex_value(t[j + 2]);\n        let c: u32 = hex_value(t[j + 3]);\n        let d: u32 = hex_value(t[j + 4]);\n        let e: u32 = hex_value(t[j + 5]);\n        if a > 15 || c > 15 || d > 15 || e > 15 {\n            return None;\n        }\n        Some(a * 4096 + c * 256 + d * 16 + e)\n    }\n\n    spec fn scalar(c: u32) -> bool {\n        c <= 1114111\n    }\n\n    spec fn grew4(v: &[u8], w: &[u8]) -> bool {\n        v.len() <= w.len() + 4\n    }\n\n    spec fn room4(v: &[u8]) -> bool {\n        v.len() + 4 < 4611686018427387904\n    }\n\n    // Adds the UTF-8 bytes of `c` to `v`.\n    #[effects(alloc)]\n    fn push_utf8(v: &mut Vec<u8>, c: u32) -> ()\n        requires scalar(c),\n        ensures grew4(v.as_slice(), old(v).as_slice()),\n    {\n        if c < 128 {\n            v.push(c as u8);\n        } else if c < 2048 {\n            v.push((192 + c / 64) as u8);\n            v.push((128 + c % 64) as u8);\n        } else if c < 65536 {\n            v.push((224 + c / 4096) as u8);\n            v.push((128 + c / 64 % 64) as u8);\n            v.push((128 + c % 64) as u8);\n        } else {\n            v.push((240 + c / 262144) as u8);\n            v.push((128 + c / 4096 % 64) as u8);\n            v.push((128 + c / 64 % 64) as u8);\n            v.push((128 + c % 64) as u8);\n        }\n    }\n\n    // ---------- writing ----------\n\n    spec fn quote_room(out: &str, s: &str) -> bool {\n        out.len() + 6 * s.len() + 2 < 9223372036854775807\n    }\n\n    spec fn quote_grew(out: &str, before: &str, s: &str) -> bool {\n        before.len() + 2 <= out.len() && out.len() <= before.len() + 6 * s.len() + 2\n    }\n\n    spec fn quote_inv(out: &str, l: usize, a: usize, j: usize, s: &str) -> bool {\n        a <= j && j <= s.len() && l + 1 <= out.len() && out.len() + (j - a) <= l + 1 + 6 * j\n            && (a == 0 || s.as_bytes()[a - 1] < 128)\n    }\n\n    // Adds `s` to `out` as a JSON string: in quotes, `\"` and `\\` escaped,\n    // the control bytes as `\\b`, `\\f`, `\\n`, `\\r`, `\\t` or `\\u00xx`\n    // (what `serde_json` writes).\n    #[effects(alloc)]\n    fn push_string(out: &mut String, s: &str) -> ()\n        ensures quote_grew(out.as_str(), old(out).as_str(), s),\n    {\n        let l: usize = out.len();\n        out.push('\"');\n        let mut a: usize = 0;\n        let mut j: usize = 0;\n        while j < s.len()\n            invariant quote_inv(out.as_str(), l, a, j, s),\n            decreases s.len() - j,\n        {\n            let b: u8 = s.as_bytes()[j];\n            if b == b'\"' || b == b'\\\\' || b < 32 {\n                out.push_str(&s[a..j]);\n                if b == b'\"' {\n                    out.push_str(\"\\\\\\\"\");\n                } else if b == b'\\\\' {\n                    out.push_str(\"\\\\\\\\\");\n                } else if b == 8 {\n                    out.push_str(\"\\\\b\");\n                } else if b == 12 {\n                    out.push_str(\"\\\\f\");\n                } else if b == 10 {\n                    out.push_str(\"\\\\n\");\n                } else if b == 13 {\n                    out.push_str(\"\\\\r\");\n                } else if b == 9 {\n                    out.push_str(\"\\\\t\");\n                } else {\n                    out.push_str(\"\\\\u00\");\n                    push_hex_digit(out, b / 16);\n                    push_hex_digit(out, b % 16);\n                }\n                a = j + 1;\n            }\n            j = j + 1;\n        }\n        out.push_str(&s[a..s.len()]);\n        out.push('\"');\n    }\n\n    spec fn digit16(d: u8) -> bool {\n        d < 16\n    }\n\n    spec fn one_room(out: &str) -> bool {\n        out.len() + 1 < 9223372036854775807\n    }\n\n    spec fn one_more(out: &str, before: &str) -> bool {\n        out.len() == before.len() + 1\n    }\n\n    // Adds the lowercase hex digit of `d`.\n    #[effects(alloc)]\n    fn push_hex_digit(out: &mut String, d: u8) -> ()\n        requires digit16(d),\n        ensures one_more(out.as_str(), old(out).as_str()),\n    {\n        if d < 8 {\n            if d < 4 {\n                if d == 0 {\n                    out.push_str(\"0\");\n                } else if d == 1 {\n                    out.push_str(\"1\");\n                } else if d == 2 {\n                    out.push_str(\"2\");\n                } else {\n                    out.push_str(\"3\");\n                }\n            } else if d == 4 {\n                out.push_str(\"4\");\n            } else if d == 5 {\n                out.push_str(\"5\");\n            } else if d == 6 {\n                out.push_str(\"6\");\n            } else {\n                out.push_str(\"7\");\n            }\n        } else if d < 12 {\n            if d == 8 {\n                out.push_str(\"8\");\n            } else if d == 9 {\n                out.push_str(\"9\");\n            } else if d == 10 {\n                out.push_str(\"a\");\n            } else {\n                out.push_str(\"b\");\n            }\n        } else if d == 12 {\n            out.push_str(\"c\");\n        } else if d == 13 {\n            out.push_str(\"d\");\n        } else if d == 14 {\n            out.push_str(\"e\");\n        } else {\n            out.push_str(\"f\");\n        }\n    }\n}\n");
        }
        if i == 6 {
            return String::from("#[summary(\"정수의 10진·16진 읽기와 쓰기(Rust `str::parse`·`from_str_radix`·`Display`·`{:x}`의 뜻): 읽기는 바이트 명세와 정확히 같고, 쓰기는 정규형이며 되읽힌다 (ADR-0092 §2, backlog 4B-02)\")]\nmod num {\n    // ---------- decimal digits ----------\n\n    spec fn digit(c: u8) -> bool {\n        48 <= c && c <= 57\n    }\n\n    // The bytes of `s` from `a` to `n` are decimal digits.\n    spec fn digits(s: &[u8], a: usize, n: usize) -> bool {\n        a <= n && n <= s.len() && forall |k: usize| a <= k && k < n ==> digit(#[trigger] s[k])\n    }\n\n    // The value of the bytes of `s` from `a` to `n` read as decimal digits.\n    spec fn dec(s: &[u8], a: usize, n: usize) -> i64\n        decreases n,\n    {\n        if n <= a { 0 } else { dec(s, a, n - 1) * 10 + (s[n - 1] - 48) }\n    }\n\n    spec fn within_digits(s: &[u8], a: usize, i: usize, n: usize) -> bool {\n        digits(s, a, n) && a <= i && i <= n\n    }\n\n    spec fn no_less(s: &[u8], a: usize, i: usize, n: usize) -> bool {\n        dec(s, a, i) <= dec(s, a, n)\n    }\n\n    spec fn digits_to(s: &[u8], a: usize, n: usize) -> bool {\n        digits(s, a, n)\n    }\n\n    spec fn nonneg(s: &[u8], a: usize, n: usize) -> bool {\n        0 <= dec(s, a, n)\n    }\n\n    // Digits are worth at least zero.\n    #[uses(dec, digit, digits)]\n    proof fn dec_nonneg(s: &[u8], a: usize, n: usize)\n        requires digits_to(s, a, n),\n        ensures nonneg(s, a, n),\n        decreases n,\n    {\n        if n > a {\n            dec_nonneg(s, a, n - 1);\n        }\n    }\n\n    // More digits never make the value smaller.\n    #[uses(dec, digit, digits)]\n    proof fn dec_grows(s: &[u8], a: usize, i: usize, n: usize)\n        requires within_digits(s, a, i, n),\n        ensures no_less(s, a, i, n),\n        decreases n,\n    {\n        if i < n {\n            dec_grows(s, a, i, n - 1);\n            dec_nonneg(s, a, n - 1);\n        }\n    }\n\n    // ---------- hexadecimal digits ----------\n\n    spec fn hex_digit(c: u8) -> bool {\n        digit(c) || (97 <= c && c <= 102) || (65 <= c && c <= 70)\n    }\n\n    // The bytes of `s` from `a` to `n` are hexadecimal digits.\n    spec fn hexes(s: &[u8], a: usize, n: usize) -> bool {\n        a <= n && n <= s.len() && forall |k: usize| a <= k && k < n ==> hex_digit(#[trigger] s[k])\n    }\n\n    // The value of the bytes of `s` from `a` to `n` read as hexadecimal digits.\n    spec fn hex(s: &[u8], a: usize, n: usize) -> i64\n        decreases n,\n    {\n        if n <= a {\n            0\n        } else if s[n - 1] <= 57 {\n            hex(s, a, n - 1) * 16 + (s[n - 1] - 48)\n        } else if s[n - 1] >= 97 {\n            hex(s, a, n - 1) * 16 + (s[n - 1] - 87)\n        } else {\n            hex(s, a, n - 1) * 16 + (s[n - 1] - 55)\n        }\n    }\n\n    spec fn hexes_to(s: &[u8], a: usize, n: usize) -> bool {\n        hexes(s, a, n)\n    }\n\n    spec fn hex_nonneg_at(s: &[u8], a: usize, n: usize) -> bool {\n        0 <= hex(s, a, n)\n    }\n\n    #[uses(digit, hex, hex_digit, hexes)]\n    proof fn hex_nonneg(s: &[u8], a: usize, n: usize)\n        requires hexes_to(s, a, n),\n        ensures hex_nonneg_at(s, a, n),\n        decreases n,\n    {\n        if n > a {\n            hex_nonneg(s, a, n - 1);\n        }\n    }\n\n    spec fn within_hexes(s: &[u8], a: usize, i: usize, n: usize) -> bool {\n        hexes(s, a, n) && a <= i && i <= n\n    }\n\n    spec fn hex_no_less(s: &[u8], a: usize, i: usize, n: usize) -> bool {\n        hex(s, a, i) <= hex(s, a, n)\n    }\n\n    #[uses(digit, hex, hex_digit, hexes)]\n    proof fn hex_grows(s: &[u8], a: usize, i: usize, n: usize)\n        requires within_hexes(s, a, i, n),\n        ensures hex_no_less(s, a, i, n),\n        decreases n,\n    {\n        if i < n {\n            hex_grows(s, a, i, n - 1);\n            hex_nonneg(s, a, n - 1);\n        }\n    }\n\n    // ---------- reading ----------\n\n    // The digits of `s` from `a` to its end, at least one, fit a `u64`.\n    spec fn dec_fits(s: &[u8], a: usize) -> bool {\n        a < s.len() && digits(s, a, s.len()) && dec(s, a, s.len()) <= 18446744073709551615\n    }\n\n    spec fn scanned_dec(r: Option<u64>, s: &[u8], a: usize) -> bool {\n        match r {\n            None => !dec_fits(s, a),\n            Some(v) => dec_fits(s, a) && v == dec(s, a, s.len()),\n        }\n    }\n\n    // The scan so far: digits from `a` to `i` worth `acc`, or one that is not\n    // a digit, or a value past `u64`.\n    spec fn scanned(s: &[u8], a: usize, i: usize, acc: u64, bad: bool, over: bool) -> bool {\n        a <= i && i <= s.len()\n            && (bad ==> !digits(s, a, s.len()))\n            && (!bad ==> digits(s, a, i))\n            && (over ==> dec(s, a, i) > 18446744073709551615)\n            && (!bad && !over ==> acc == dec(s, a, i))\n    }\n\n    spec fn upto(a: usize, s: &[u8]) -> bool {\n        a <= s.len()\n    }\n\n    // The decimal digits of `s` from `a` to its end as a `u64`: none when\n    // there is none, one is not a digit, or the value does not fit.\n    #[effects(pure)]\n    #[uses(dec, dec_fits, digit, digits, digits_to, nonneg)]\n    fn scan_dec(s: &[u8], a: usize) -> (r: Option<u64>)\n        requires upto(a, s),\n        ensures scanned_dec(r, s, a),\n    {\n        if a >= s.len() {\n            return None;\n        }\n        let mut acc: u64 = 0;\n        let mut bad: bool = false;\n        let mut over: bool = false;\n        let mut i: usize = a;\n        while i < s.len() && !bad\n            invariant scanned(s, a, i, acc, bad, over),\n            decreases s.len() - i,\n        {\n            let c: u8 = s[i];\n            if c < b'0' || c > b'9' {\n                bad = true;\n            } else if !over {\n                let d: u64 = (c - b'0') as u64;\n                match acc.checked_mul(10) {\n                    None => {\n                        over = true;\n                    }\n                    Some(m) => match m.checked_add(d) {\n                        None => {\n                            over = true;\n                        }\n                        Some(t) => {\n                            acc = t;\n                        }\n                    },\n                }\n            }\n            i = i + 1;\n        }\n        if bad || over {\n            if over && !bad {\n                proof {\n                    dec_grows(s, a, i, s.len());\n                }\n            }\n            return None;\n        }\n        Some(acc)\n    }\n\n    spec fn hex_fits(s: &[u8], a: usize) -> bool {\n        a < s.len() && hexes(s, a, s.len()) && hex(s, a, s.len()) <= 18446744073709551615\n    }\n\n    spec fn scanned_hex(r: Option<u64>, s: &[u8], a: usize) -> bool {\n        match r {\n            None => !hex_fits(s, a),\n            Some(v) => hex_fits(s, a) && v == hex(s, a, s.len()),\n        }\n    }\n\n    spec fn scanning_hex(s: &[u8], a: usize, i: usize, acc: u64, bad: bool, over: bool) -> bool {\n        a <= i && i <= s.len()\n            && (bad ==> !hexes(s, a, s.len()))\n            && (!bad ==> hexes(s, a, i))\n            && (over ==> hex(s, a, i) > 18446744073709551615)\n            && (!bad && !over ==> acc == hex(s, a, i))\n    }\n\n    // The value of hexadecimal digit `c`, or 16 when it is not one.\n    spec fn hex_digit_value(r: u64, c: u8) -> bool {\n        (digit(c) && r == c - 48) || (97 <= c && c <= 102 && r == c - 87)\n            || (65 <= c && c <= 70 && r == c - 55) || (!hex_digit(c) && r == 16)\n    }\n\n    #[effects(pure)]\n    #[uses(digit, hex_digit)]\n    fn hex_of(c: u8) -> (r: u64)\n        ensures hex_digit_value(r, c),\n    {\n        if c >= b'0' && c <= b'9' {\n            (c - b'0') as u64\n        } else if c >= b'a' && c <= b'f' {\n            (c - 87) as u64\n        } else if c >= b'A' && c <= b'F' {\n            (c - 55) as u64\n        } else {\n            16\n        }\n    }\n\n    // The hexadecimal digits of `s` from `a` to its end as a `u64`.\n    #[effects(pure)]\n    #[uses(digit, hex, hex_digit, hex_fits, hex_nonneg_at, hexes, hexes_to)]\n    fn scan_hex(s: &[u8], a: usize) -> (r: Option<u64>)\n        requires upto(a, s),\n        ensures scanned_hex(r, s, a),\n    {\n        if a >= s.len() {\n            return None;\n        }\n        let mut acc: u64 = 0;\n        let mut bad: bool = false;\n        let mut over: bool = false;\n        let mut i: usize = a;\n        while i < s.len() && !bad\n            invariant scanning_hex(s, a, i, acc, bad, over),\n            decreases s.len() - i,\n        {\n            let d: u64 = hex_of(s[i]);\n            if d == 16 {\n                bad = true;\n            } else if !over {\n                match acc.checked_mul(16) {\n                    None => {\n                        over = true;\n                    }\n                    Some(m) => match m.checked_add(d) {\n                        None => {\n                            over = true;\n                        }\n                        Some(t) => {\n                            acc = t;\n                        }\n                    },\n                }\n            }\n            i = i + 1;\n        }\n        if bad || over {\n            if over && !bad {\n                proof {\n                    hex_grows(s, a, i, s.len());\n                }\n            }\n            return None;\n        }\n        Some(acc)\n    }\n\n    // Where the digits of `s` begin: after a leading `+` (Rust's `from_str`\n    // and `from_str_radix` take one for an unsigned integer).\n    spec fn start(s: &[u8]) -> usize {\n        if s.len() > 0 && s[0] == 43 { 1 } else { 0 }\n    }\n\n    // `s` is an unsigned decimal integer that fits a `u64`.\n    spec fn is_u64(s: &[u8]) -> bool {\n        dec_fits(s, start(s))\n    }\n\n    spec fn read_u64(r: Option<u64>, s: &[u8]) -> bool {\n        match r {\n            None => !is_u64(s),\n            Some(v) => is_u64(s) && v == dec(s, start(s), s.len()),\n        }\n    }\n\n    // `s` read as a `u64`: Rust's `u64::from_str` (`s.parse::<u64>()`).\n    #[effects(pure)]\n    #[uses(dec_fits, is_u64, start)]\n    fn parse_u64_bytes(s: &[u8]) -> (r: Option<u64>)\n        ensures read_u64(r, s),\n    {\n        let a: usize = if s.len() > 0 && s[0] == b'+' { 1 } else { 0 };\n        scan_dec(s, a)\n    }\n\n    spec fn read_u64_text(r: Option<u64>, s: &str) -> bool {\n        read_u64(r, s.as_bytes())\n    }\n\n    // `s.parse::<u64>()` in Rust.\n    #[effects(pure)]\n    fn parse_u64(s: &str) -> (r: Option<u64>)\n        ensures read_u64_text(r, s),\n    {\n        parse_u64_bytes(s.as_bytes())\n    }\n\n    // `s` begins with `-`.\n    spec fn minus(s: &[u8]) -> bool {\n        s.len() > 0 && s[0] == 45\n    }\n\n    // Where the digits of a signed integer begin: after a leading `+` or `-`.\n    spec fn sign_end(s: &[u8]) -> usize {\n        if s.len() > 0 && (s[0] == 43 || s[0] == 45) { 1 } else { 0 }\n    }\n\n    // `s` is a signed decimal integer that fits an `i64`.\n    spec fn is_i64(s: &[u8]) -> bool {\n        dec_fits(s, sign_end(s))\n            && ((minus(s) && dec(s, sign_end(s), s.len()) <= 9223372036854775808)\n                || (!minus(s) && dec(s, sign_end(s), s.len()) <= 9223372036854775807))\n    }\n\n    spec fn read_i64(r: Option<i64>, s: &[u8]) -> bool {\n        match r {\n            None => !is_i64(s),\n            Some(v) => is_i64(s)\n                && ((minus(s) && v == 0 - dec(s, sign_end(s), s.len()))\n                    || (!minus(s) && v == dec(s, sign_end(s), s.len()))),\n        }\n    }\n\n    // `s` read as an `i64`: Rust's `i64::from_str` (`s.parse::<i64>()`).\n    #[effects(pure)]\n    #[uses(dec_fits, is_i64, minus, sign_end)]\n    fn parse_i64_bytes(s: &[u8]) -> (r: Option<i64>)\n        ensures read_i64(r, s),\n    {\n        let neg: bool = s.len() > 0 && s[0] == b'-';\n        let a: usize = if s.len() > 0 && (s[0] == b'+' || s[0] == b'-') { 1 } else { 0 };\n        match scan_dec(s, a) {\n            None => None,\n            Some(m) => {\n                if neg {\n                    if m == 9223372036854775808 {\n                        Some(-9223372036854775807 - 1)\n                    } else if m < 9223372036854775808 {\n                        Some(0 - m as i64)\n                    } else {\n                        None\n                    }\n                } else if m <= 9223372036854775807 {\n                    Some(m as i64)\n                } else {\n                    None\n                }\n            }\n        }\n    }\n\n    spec fn read_i64_text(r: Option<i64>, s: &str) -> bool {\n        read_i64(r, s.as_bytes())\n    }\n\n    // `s.parse::<i64>()` in Rust.\n    #[effects(pure)]\n    fn parse_i64(s: &str) -> (r: Option<i64>)\n        ensures read_i64_text(r, s),\n    {\n        parse_i64_bytes(s.as_bytes())\n    }\n\n    // `s` is an unsigned hexadecimal integer that fits a `u64`.\n    spec fn is_u64_hex(s: &[u8]) -> bool {\n        hex_fits(s, start(s))\n    }\n\n    spec fn read_u64_hex(r: Option<u64>, s: &[u8]) -> bool {\n        match r {\n            None => !is_u64_hex(s),\n            Some(v) => is_u64_hex(s) && v == hex(s, start(s), s.len()),\n        }\n    }\n\n    // `s` read as a hexadecimal `u64`, either case: Rust's\n    // `u64::from_str_radix(s, 16)`.\n    #[effects(pure)]\n    #[uses(hex_fits, is_u64_hex, start)]\n    fn parse_u64_hex_bytes(s: &[u8]) -> (r: Option<u64>)\n        ensures read_u64_hex(r, s),\n    {\n        let a: usize = if s.len() > 0 && s[0] == b'+' { 1 } else { 0 };\n        scan_hex(s, a)\n    }\n\n    spec fn read_u64_hex_text(r: Option<u64>, s: &str) -> bool {\n        read_u64_hex(r, s.as_bytes())\n    }\n\n    // `u64::from_str_radix(s, 16)` in Rust.\n    #[effects(pure)]\n    fn parse_u64_hex(s: &str) -> (r: Option<u64>)\n        ensures read_u64_hex_text(r, s),\n    {\n        parse_u64_hex_bytes(s.as_bytes())\n    }\n\n    // ---------- writing ----------\n\n    // Digit `j` of `x` in decimal, counted from the last.\n    spec fn dig(x: u64, j: usize) -> u64\n        decreases j,\n    {\n        if j == 0 { x % 10 } else { dig(x / 10, j - 1) }\n    }\n\n    // `t[a..n]` is the decimal text of `x`: its `width(x)` digits, the\n    // first not `0` unless `x` is `0` (Rust's `Display` of an integer).\n    spec fn is_dec(t: &[u8], a: usize, n: usize, x: u64) -> bool {\n        n == a + width(x) && n <= t.len()\n            && forall |k: usize| a <= k && k < n ==> #[trigger] t[k] == 48 + dig(x, n - 1 - k)\n    }\n\n    // The number of decimal digits of `x`.\n    spec fn width(x: u64) -> usize {\n        if x < 10 { 1 }\n        else if x < 100 { 2 }\n        else if x < 1000 { 3 }\n        else if x < 10000 { 4 }\n        else if x < 100000 { 5 }\n        else if x < 1000000 { 6 }\n        else if x < 10000000 { 7 }\n        else if x < 100000000 { 8 }\n        else if x < 1000000000 { 9 }\n        else if x < 10000000000 { 10 }\n        else if x < 100000000000 { 11 }\n        else if x < 1000000000000 { 12 }\n        else if x < 10000000000000 { 13 }\n        else if x < 100000000000000 { 14 }\n        else if x < 1000000000000000 { 15 }\n        else if x < 10000000000000000 { 16 }\n        else if x < 100000000000000000 { 17 }\n        else if x < 1000000000000000000 { 18 }\n        else if x < 10000000000000000000 { 19 }\n        else { 20 }\n    }\n\n    // `t` and `u` have the same bytes from `a` to `n`.\n    spec fn same(t: &[u8], u: &[u8], a: usize, n: usize) -> bool {\n        n <= t.len() && n <= u.len() && forall |k: usize| a <= k && k < n ==> #[trigger] t[k] == u[k]\n    }\n\n    spec fn text_of(t: &[u8], a: usize, n: usize, x: u64) -> bool {\n        is_dec(t, a, n, x)\n    }\n\n    spec fn reads_as(t: &[u8], a: usize, n: usize, x: u64) -> bool {\n        digits(t, a, n) && dec(t, a, n) == x && n == a + width(x)\n    }\n\n    // The decimal text of `x` reads back as `x`, in `width(x)` digits.\n    #[uses(dec, dig, digit, digits, is_dec, width)]\n    proof fn dec_reads(t: &[u8], a: usize, n: usize, x: u64)\n        requires text_of(t, a, n, x),\n        ensures reads_as(t, a, n, x),\n        decreases x,\n    {\n        if x >= 10 {\n            dec_reads(t, a, n - 1, x / 10);\n        }\n    }\n\n    spec fn room(t: &[u8]) -> bool {\n        t.len() + 20 <= 9223372036854775807\n    }\n\n    // `t` is `u` with at most 21 bytes more: what a caller needs to know to\n    // write again (cheaper to reveal than `wrote`).\n    spec fn grew(t: &[u8], u: &[u8]) -> bool {\n        u.len() < t.len() && t.len() <= u.len() + 21\n    }\n\n    // `t` is `u` with the decimal text of `x` after it.\n    spec fn wrote(t: &[u8], u: &[u8], x: u64) -> bool {\n        t.len() == u.len() + width(x) && same(t, u, 0, u.len()) && is_dec(t, u.len(), t.len(), x)\n    }\n\n    // Appends `x` in decimal (Rust's `write!(s, \"{x}\")`).\n    #[effects(alloc)]\n    #[uses(dig, is_dec, same, width)]\n    fn push_u64(s: &mut String, x: u64) -> ()\n        ensures wrote(s.as_bytes(), old(s).as_bytes(), x), grew(s.as_bytes(), old(s).as_bytes()),\n        decreases x,\n    {\n        if x >= 10 {\n            push_u64(s, x / 10);\n        }\n        let d: u32 = (x % 10) as u32;\n        match char::from_u32(48 + d) {\n            None => {}\n            Some(c) => s.push(c),\n        }\n    }\n\n    // `t` is `u` with the decimal text of `x` after it, `-` first when it\n    // is negative (Rust's `Display` of an `i64`).\n    spec fn wrote_i64(t: &[u8], u: &[u8], x: i64) -> bool {\n        (x >= 0 && t.len() == u.len() + width(x) && same(t, u, 0, u.len()) && is_dec(t, u.len(), t.len(), x))\n            || (x < 0 && t.len() == u.len() + 1 + width(0 - x) && same(t, u, 0, u.len()) && t[u.len()] == 45\n                && is_dec(t, u.len() + 1, t.len(), 0 - x))\n    }\n\n    spec fn room1(t: &[u8]) -> bool {\n        t.len() + 21 <= 9223372036854775807\n    }\n\n    // Appends `x` in decimal, `-` first when it is negative (Rust's\n    // `write!(s, \"{x}\")`).\n    #[effects(alloc)]\n    #[uses(dig, is_dec, same, width)]\n    fn push_i64(s: &mut String, x: i64) -> ()\n        ensures wrote_i64(s.as_bytes(), old(s).as_bytes(), x), grew(s.as_bytes(), old(s).as_bytes()),\n    {\n        if x < 0 {\n            s.push('-');\n            // `-x` overflows at `i64::MIN`; `-(x + 1)` does not.\n            push_u64(s, (0 - (x + 1)) as u64 + 1);\n        } else {\n            push_u64(s, x as u64);\n        }\n    }\n\n    // ---------- hexadecimal writing ----------\n\n    // Digit `j` of `x` in hexadecimal, counted from the last.\n    spec fn hdig(x: u64, j: usize) -> u64\n        decreases j,\n    {\n        if j == 0 { x % 16 } else { hdig(x / 16, j - 1) }\n    }\n\n    // The lowercase hexadecimal digit for `d` (below 16).\n    spec fn hex_char(c: u8, d: u64) -> bool {\n        (d < 10 && c == 48 + d) || (d >= 10 && c == 87 + d)\n    }\n\n    // `t[a..n]` is the lowercase hexadecimal text of `x`, the first digit\n    // not `0` unless `x` is `0` (Rust's `{:x}`).\n    spec fn is_hex(t: &[u8], a: usize, n: usize, x: u64) -> bool {\n        n == a + width16(x) && n <= t.len()\n            && forall |k: usize| a <= k && k < n ==> hex_char(#[trigger] t[k], hdig(x, n - 1 - k))\n    }\n\n    // The number of hexadecimal digits of `x`.\n    spec fn width16(x: u64) -> usize {\n        if x < 16 { 1 }\n        else if x < 256 { 2 }\n        else if x < 4096 { 3 }\n        else if x < 65536 { 4 }\n        else if x < 1048576 { 5 }\n        else if x < 16777216 { 6 }\n        else if x < 268435456 { 7 }\n        else if x < 4294967296 { 8 }\n        else if x < 68719476736 { 9 }\n        else if x < 1099511627776 { 10 }\n        else if x < 17592186044416 { 11 }\n        else if x < 281474976710656 { 12 }\n        else if x < 4503599627370496 { 13 }\n        else if x < 72057594037927936 { 14 }\n        else if x < 1152921504606846976 { 15 }\n        else { 16 }\n    }\n\n    spec fn wrote_hex(t: &[u8], u: &[u8], x: u64) -> bool {\n        t.len() == u.len() + width16(x) && same(t, u, 0, u.len()) && is_hex(t, u.len(), t.len(), x)\n    }\n\n    // Appends `x` in lowercase hexadecimal (Rust's `write!(s, \"{x:x}\")`).\n    #[effects(alloc)]\n    #[uses(hdig, hex_char, is_hex, same, width16)]\n    fn push_u64_hex(s: &mut String, x: u64) -> ()\n        ensures wrote_hex(s.as_bytes(), old(s).as_bytes(), x), grew(s.as_bytes(), old(s).as_bytes()),\n        decreases x,\n    {\n        if x >= 16 {\n            push_u64_hex(s, x / 16);\n        }\n        let d: u32 = (x % 16) as u32;\n        let code: u32 = if d < 10 { 48 + d } else { 87 + d };\n        match char::from_u32(code) {\n            None => {}\n            Some(c) => s.push(c),\n        }\n    }\n\n    spec fn hex_text_of(t: &[u8], a: usize, n: usize, x: u64) -> bool {\n        is_hex(t, a, n, x)\n    }\n\n    spec fn hex_reads_as(t: &[u8], a: usize, n: usize, x: u64) -> bool {\n        hexes(t, a, n) && hex(t, a, n) == x && n == a + width16(x)\n    }\n\n    // The hexadecimal text of `x` reads back as `x`.\n    #[uses(digit, hdig, hex, hex_char, hex_digit, hexes, is_hex, width16)]\n    proof fn hex_reads(t: &[u8], a: usize, n: usize, x: u64)\n        requires hex_text_of(t, a, n, x),\n        ensures hex_reads_as(t, a, n, x),\n        decreases x,\n    {\n        if x >= 16 {\n            hex_reads(t, a, n - 1, x / 16);\n        }\n    }\n\n    // ---------- round trips ----------\n\n    spec fn whole_dec(t: &[u8], x: u64) -> bool {\n        is_dec(t, 0, t.len(), x)\n    }\n\n    spec fn reads_u64(t: &[u8], x: u64) -> bool {\n        read_u64(Some(x), t)\n    }\n\n    // What `push_u64` writes to an empty text, `parse_u64` reads back:\n    // `parse(format(x)) == Some(x)`.\n    #[uses(dec, dec_fits, dig, digit, digits, is_dec, is_u64, read_u64, start, width)]\n    proof fn u64_round_trip(t: &[u8], x: u64)\n        requires whole_dec(t, x),\n        ensures reads_u64(t, x),\n    {\n        dec_reads(t, 0, t.len(), x);\n    }\n\n    spec fn whole_hex(t: &[u8], x: u64) -> bool {\n        is_hex(t, 0, t.len(), x)\n    }\n\n    spec fn reads_u64_hex(t: &[u8], x: u64) -> bool {\n        read_u64_hex(Some(x), t)\n    }\n\n    // What `push_u64_hex` writes to an empty text, `parse_u64_hex` reads\n    // back.\n    #[uses(digit, hdig, hex, hex_char, hex_digit, hex_fits, hexes, is_hex, is_u64_hex, read_u64_hex, start, width16)]\n    proof fn u64_hex_round_trip(t: &[u8], x: u64)\n        requires whole_hex(t, x),\n        ensures reads_u64_hex(t, x),\n    {\n        hex_reads(t, 0, t.len(), x);\n    }\n}\n");
        }
        if i == 7 {
            return String::from("#[summary(\"SHA-256(T4-01): FIPS 180-4의 SHA-256. 결과가 명세(채우기 §5.1.1, 일정 §6.2.2, 라운드 §6.2.2, 상수 §4.2.2·§5.3.3)로 정의한 다이제스트와 같음이 증명된다. Python hashlib.sha256과 같은 값\")]\nmod sha256 {\n    // The working variables and the hash value (FIPS 180-4 §6.2).\n    struct State { a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32 }\n\n    // ---------- functions (§4.1.2) ----------\n\n    spec fn bs0(x: u32) -> u32 { x.rotate_right(2) ^ x.rotate_right(13) ^ x.rotate_right(22) }\n\n    spec fn bs1(x: u32) -> u32 { x.rotate_right(6) ^ x.rotate_right(11) ^ x.rotate_right(25) }\n\n    spec fn ss0(x: u32) -> u32 { x.rotate_right(7) ^ x.rotate_right(18) ^ (x >> 3) }\n\n    spec fn ss1(x: u32) -> u32 { x.rotate_right(17) ^ x.rotate_right(19) ^ (x >> 10) }\n\n    spec fn ch(e: u32, f: u32, g: u32) -> u32 { (e & f) ^ (!e & g) }\n\n    spec fn maj(a: u32, b: u32, c: u32) -> u32 { (a & b) ^ (a & c) ^ (b & c) }\n\n    // ---------- constants (§4.2.2, §5.3.3) ----------\n\n    spec fn kk(t: usize) -> u32 {\n        if t == 0 { 0x428a2f98 } else if t == 1 { 0x71374491 } else if t == 2 { 0xb5c0fbcf } else if t == 3 { 0xe9b5dba5 }\n        else if t == 4 { 0x3956c25b } else if t == 5 { 0x59f111f1 } else if t == 6 { 0x923f82a4 } else if t == 7 { 0xab1c5ed5 }\n        else if t == 8 { 0xd807aa98 } else if t == 9 { 0x12835b01 } else if t == 10 { 0x243185be } else if t == 11 { 0x550c7dc3 }\n        else if t == 12 { 0x72be5d74 } else if t == 13 { 0x80deb1fe } else if t == 14 { 0x9bdc06a7 } else if t == 15 { 0xc19bf174 }\n        else if t == 16 { 0xe49b69c1 } else if t == 17 { 0xefbe4786 } else if t == 18 { 0x0fc19dc6 } else if t == 19 { 0x240ca1cc }\n        else if t == 20 { 0x2de92c6f } else if t == 21 { 0x4a7484aa } else if t == 22 { 0x5cb0a9dc } else if t == 23 { 0x76f988da }\n        else if t == 24 { 0x983e5152 } else if t == 25 { 0xa831c66d } else if t == 26 { 0xb00327c8 } else if t == 27 { 0xbf597fc7 }\n        else if t == 28 { 0xc6e00bf3 } else if t == 29 { 0xd5a79147 } else if t == 30 { 0x06ca6351 } else if t == 31 { 0x14292967 }\n        else if t == 32 { 0x27b70a85 } else if t == 33 { 0x2e1b2138 } else if t == 34 { 0x4d2c6dfc } else if t == 35 { 0x53380d13 }\n        else if t == 36 { 0x650a7354 } else if t == 37 { 0x766a0abb } else if t == 38 { 0x81c2c92e } else if t == 39 { 0x92722c85 }\n        else if t == 40 { 0xa2bfe8a1 } else if t == 41 { 0xa81a664b } else if t == 42 { 0xc24b8b70 } else if t == 43 { 0xc76c51a3 }\n        else if t == 44 { 0xd192e819 } else if t == 45 { 0xd6990624 } else if t == 46 { 0xf40e3585 } else if t == 47 { 0x106aa070 }\n        else if t == 48 { 0x19a4c116 } else if t == 49 { 0x1e376c08 } else if t == 50 { 0x2748774c } else if t == 51 { 0x34b0bcb5 }\n        else if t == 52 { 0x391c0cb3 } else if t == 53 { 0x4ed8aa4a } else if t == 54 { 0x5b9cca4f } else if t == 55 { 0x682e6ff3 }\n        else if t == 56 { 0x748f82ee } else if t == 57 { 0x78a5636f } else if t == 58 { 0x84c87814 } else if t == 59 { 0x8cc70208 }\n        else if t == 60 { 0x90befffa } else if t == 61 { 0xa4506ceb } else if t == 62 { 0xbef9a3f7 } else { 0xc67178f2 }\n    }\n\n    spec fn h0() -> State {\n        State { a: 0x6a09e667, b: 0xbb67ae85, c: 0x3c6ef372, d: 0xa54ff53a, e: 0x510e527f, f: 0x9b05688c, g: 0x1f83d9ab, h: 0x5be0cd19 }\n    }\n\n    // ---------- padding (§5.1.1) ----------\n\n    // Messages shorter than 2^61 bytes: their length in bits fits 64 bits.\n    spec fn msg_ok(msg: &[u8]) -> bool { msg.len() < 2305843009213693952 }\n\n    // The padded length: the least multiple of 64 holding the message, the\n    // byte 0x80 and the 8-byte length.\n    spec fn padlen(n: usize) -> usize { (n + 72) / 64 * 64 }\n\n    // Byte `j` (0..8, most significant first) of the 64-bit length `l`.\n    spec fn len_byte(l: u64, j: usize) -> u64 {\n        if j == 0 { (l >> 56) & 0xff } else if j == 1 { (l >> 48) & 0xff } else if j == 2 { (l >> 40) & 0xff }\n        else if j == 3 { (l >> 32) & 0xff } else if j == 4 { (l >> 24) & 0xff } else if j == 5 { (l >> 16) & 0xff }\n        else if j == 6 { (l >> 8) & 0xff } else { l & 0xff }\n    }\n\n    // Byte `i` of the padded message.\n    spec fn pad_byte(msg: &[u8], i: usize) -> u64 {\n        if i < msg.len() { msg[i] } else if i == msg.len() { 0x80 } else if i + 8 < padlen(msg.len()) { 0 } else { len_byte(msg.len() * 8, i + 8 - padlen(msg.len())) }\n    }\n\n    spec fn padded(msg: &[u8], p: &[u8]) -> bool {\n        p.len() == padlen(msg.len()) && forall|i: usize| i < p.len() ==> #[trigger] p[i] == pad_byte(msg, i)\n    }\n\n    // ---------- message schedule (§6.2.2 step 1) ----------\n\n    spec fn be32(b0: u32, b1: u32, b2: u32, b3: u32) -> u32 { (b0 << 24) | (b1 << 16) | (b2 << 8) | b3 }\n\n    // The big-endian word at byte `i` of the padded message.\n    spec fn word(msg: &[u8], i: usize) -> u32 { be32(pad_byte(msg, i), pad_byte(msg, i + 1), pad_byte(msg, i + 2), pad_byte(msg, i + 3)) }\n\n    // `W[t]` from `W[t - 2]`, `W[t - 7]`, `W[t - 15]` and `W[t - 16]`.\n    spec fn expand(a: u32, b: u32, c: u32, d: u32) -> u32 { ss1(a).wrapping_add(b).wrapping_add(ss0(c)).wrapping_add(d) }\n\n    spec fn sched(msg: &[u8], blk: usize, t: usize) -> u32\n        decreases t,\n    {\n        if t < 16 {\n            word(msg, 64 * blk + 4 * t)\n        } else {\n            expand(sched(msg, blk, t - 2), sched(msg, blk, t - 7), sched(msg, blk, t - 15), sched(msg, blk, t - 16))\n        }\n    }\n\n    // ---------- compression (§6.2.2 steps 2-4) ----------\n\n    spec fn t1(s: State, k: u32, w: u32) -> u32 {\n        s.h.wrapping_add(bs1(s.e)).wrapping_add(ch(s.e, s.f, s.g)).wrapping_add(k).wrapping_add(w)\n    }\n\n    spec fn t2(s: State) -> u32 { bs0(s.a).wrapping_add(maj(s.a, s.b, s.c)) }\n\n    spec fn round(s: State, k: u32, w: u32) -> State {\n        State { a: t1(s, k, w).wrapping_add(t2(s)), b: s.a, c: s.b, d: s.c, e: s.d.wrapping_add(t1(s, k, w)), f: s.e, g: s.f, h: s.g }\n    }\n\n    // The working variables after `t` rounds of block `blk` from `s`.\n    spec fn rounds(msg: &[u8], blk: usize, s: State, t: usize) -> State\n        decreases t,\n    {\n        if t == 0 { s } else { round(rounds(msg, blk, s, t - 1), kk(t - 1), sched(msg, blk, t - 1)) }\n    }\n\n    spec fn add8(x: State, y: State) -> State {\n        State { a: x.a.wrapping_add(y.a), b: x.b.wrapping_add(y.b), c: x.c.wrapping_add(y.c), d: x.d.wrapping_add(y.d), e: x.e.wrapping_add(y.e), f: x.f.wrapping_add(y.f), g: x.g.wrapping_add(y.g), h: x.h.wrapping_add(y.h) }\n    }\n\n    spec fn compressed(msg: &[u8], blk: usize, h: State) -> State { add8(h, rounds(msg, blk, h, 64)) }\n\n    // The hash value after the first `n` blocks.\n    spec fn chain(msg: &[u8], n: usize) -> State\n        decreases n,\n    {\n        if n == 0 { h0() } else { compressed(msg, n - 1, chain(msg, n - 1)) }\n    }\n\n    // ---------- digest (§6.2.2 step 4) ----------\n\n    spec fn be_byte(w: u32, j: usize) -> u32 {\n        if j == 0 { w >> 24 } else if j == 1 { (w >> 16) & 0xff } else if j == 2 { (w >> 8) & 0xff } else { w & 0xff }\n    }\n\n    // Byte `i` of the hash value: word `i / 4`, byte `i % 4` of it, by\n    // cases on the word so the solver does no division.\n    spec fn out_byte(s: State, i: usize) -> u32 {\n        if i < 16 {\n            if i < 8 {\n                if i < 4 { be_byte(s.a, i) } else { be_byte(s.b, i - 4) }\n            } else if i < 12 { be_byte(s.c, i - 8) } else { be_byte(s.d, i - 12) }\n        } else if i < 24 {\n            if i < 20 { be_byte(s.e, i - 16) } else { be_byte(s.f, i - 20) }\n        } else if i < 28 { be_byte(s.g, i - 24) } else { be_byte(s.h, i - 28) }\n    }\n\n    spec fn bytes_of(s: State, r: &[u8]) -> bool {\n        r.len() == 32 && forall|i: usize| i < 32 ==> #[trigger] r[i] == out_byte(s, i)\n    }\n\n    // The SHA-256 digest of `msg`.\n    spec fn hashed(msg: &[u8], r: &[u8]) -> bool { bytes_of(chain(msg, padlen(msg.len()) / 64), r) }\n\n    // ---------- code ----------\n\n    spec fn is_bs0(x: u32, r: u32) -> bool { r == bs0(x) }\n\n    spec fn is_bs1(x: u32, r: u32) -> bool { r == bs1(x) }\n\n    spec fn is_ss0(x: u32, r: u32) -> bool { r == ss0(x) }\n\n    spec fn is_ss1(x: u32, r: u32) -> bool { r == ss1(x) }\n\n    spec fn is_ch(e: u32, f: u32, g: u32, r: u32) -> bool { r == ch(e, f, g) }\n\n    spec fn is_maj(a: u32, b: u32, c: u32, r: u32) -> bool { r == maj(a, b, c) }\n\n    spec fn is_expand(a: u32, b: u32, c: u32, d: u32, r: u32) -> bool { r == expand(a, b, c, d) }\n\n    spec fn is_round(s: State, k: u32, w: u32, r: State) -> bool { r == round(s, k, w) }\n\n    spec fn is_be32(b0: u32, b1: u32, b2: u32, b3: u32, r: u32) -> bool { r == be32(b0, b1, b2, b3) }\n\n    spec fn is_add8(x: State, y: State, r: State) -> bool { r == add8(x, y) }\n\n    spec fn is_h0(r: State) -> bool { r == h0() }\n\n    spec fn ktab(k: &[u32]) -> bool { k.len() == 64 && forall|t: usize| t < 64 ==> #[trigger] k[t] == kk(t) }\n\n    spec fn block(p: &[u8], blk: usize) -> bool { 64 * blk + 64 <= p.len() }\n\n    spec fn word_at(msg: &[u8], i: usize, r: u32) -> bool { r == word(msg, i) }\n\n    spec fn scheduled(w: &[u32], msg: &[u8], blk: usize, n: usize) -> bool {\n        w.len() == 64 && n <= 64 && forall|j: usize| j < n ==> #[trigger] w[j] == sched(msg, blk, j)\n    }\n\n    spec fn rounds_at(s: State, msg: &[u8], blk: usize, h: State, t: usize) -> bool { s == rounds(msg, blk, h, t) }\n\n    spec fn is_compressed(msg: &[u8], blk: usize, h: State, r: State) -> bool { r == compressed(msg, blk, h) }\n\n    spec fn chained(msg: &[u8], n: usize, h: State) -> bool { h == chain(msg, n) }\n\n    #[effects(pure)]\n    #[uses(bs0)]\n    fn big_sigma0(x: u32) -> (r: u32)\n        ensures is_bs0(x, r),\n    {\n        x.rotate_right(2) ^ x.rotate_right(13) ^ x.rotate_right(22)\n    }\n\n    #[effects(pure)]\n    #[uses(bs1)]\n    fn big_sigma1(x: u32) -> (r: u32)\n        ensures is_bs1(x, r),\n    {\n        x.rotate_right(6) ^ x.rotate_right(11) ^ x.rotate_right(25)\n    }\n\n    #[effects(pure)]\n    #[uses(ss0)]\n    fn small_sigma0(x: u32) -> (r: u32)\n        ensures is_ss0(x, r),\n    {\n        x.rotate_right(7) ^ x.rotate_right(18) ^ (x >> 3)\n    }\n\n    #[effects(pure)]\n    #[uses(ss1)]\n    fn small_sigma1(x: u32) -> (r: u32)\n        ensures is_ss1(x, r),\n    {\n        x.rotate_right(17) ^ x.rotate_right(19) ^ (x >> 10)\n    }\n\n    #[effects(pure)]\n    #[uses(ch)]\n    fn choose(e: u32, f: u32, g: u32) -> (r: u32)\n        ensures is_ch(e, f, g, r),\n    {\n        (e & f) ^ (!e & g)\n    }\n\n    #[effects(pure)]\n    #[uses(maj)]\n    fn majority(a: u32, b: u32, c: u32) -> (r: u32)\n        ensures is_maj(a, b, c, r),\n    {\n        (a & b) ^ (a & c) ^ (b & c)\n    }\n\n    #[effects(pure)]\n    #[uses(expand)]\n    fn next_word(a: u32, b: u32, c: u32, d: u32) -> (r: u32)\n        ensures is_expand(a, b, c, d, r),\n    {\n        small_sigma1(a).wrapping_add(b).wrapping_add(small_sigma0(c)).wrapping_add(d)\n    }\n\n    spec fn is_t1(s: State, k: u32, w: u32, r: u32) -> bool { r == t1(s, k, w) }\n\n    spec fn is_t2(s: State, r: u32) -> bool { r == t2(s) }\n\n    // `T1` of §6.2.2 step 3.\n    #[effects(pure)]\n    #[uses(t1)]\n    fn temp1(s: State, k: u32, w: u32) -> (r: u32)\n        ensures is_t1(s, k, w, r),\n    {\n        s.h.wrapping_add(big_sigma1(s.e)).wrapping_add(choose(s.e, s.f, s.g)).wrapping_add(k).wrapping_add(w)\n    }\n\n    // `T2` of §6.2.2 step 3.\n    #[effects(pure)]\n    #[uses(t2)]\n    fn temp2(s: State) -> (r: u32)\n        ensures is_t2(s, r),\n    {\n        big_sigma0(s.a).wrapping_add(majority(s.a, s.b, s.c))\n    }\n\n    // One round (§6.2.2 step 3).\n    #[effects(pure)]\n    #[uses(round)]\n    fn step(s: State, k: u32, w: u32) -> (r: State)\n        ensures is_round(s, k, w, r),\n    {\n        let x: u32 = temp1(s, k, w);\n        let y: u32 = temp2(s);\n        State { a: x.wrapping_add(y), b: s.a, c: s.b, d: s.c, e: s.d.wrapping_add(x), f: s.e, g: s.f, h: s.g }\n    }\n\n    #[effects(pure)]\n    #[uses(be32)]\n    fn join(b0: u32, b1: u32, b2: u32, b3: u32) -> (r: u32)\n        ensures is_be32(b0, b1, b2, b3, r),\n    {\n        (b0 << 24) | (b1 << 16) | (b2 << 8) | b3\n    }\n\n    spec fn word_in(p: &[u8], i: usize) -> bool { i + 4 <= p.len() }\n\n    // The word at byte `i` of the padded message `p` of `msg`.\n    #[effects(pure)]\n    #[uses(word)]\n    fn load(p: &[u8], msg: &[u8], i: usize) -> (r: u32)\n        requires padded(msg, p), word_in(p, i),\n        ensures word_at(msg, i, r),\n    {\n        join(p[i] as u32, p[i + 1] as u32, p[i + 2] as u32, p[i + 3] as u32)\n    }\n\n    #[effects(pure)]\n    #[uses(add8)]\n    fn add(x: State, y: State) -> (r: State)\n        ensures is_add8(x, y, r),\n    {\n        State { a: x.a.wrapping_add(y.a), b: x.b.wrapping_add(y.b), c: x.c.wrapping_add(y.c), d: x.d.wrapping_add(y.d), e: x.e.wrapping_add(y.e), f: x.f.wrapping_add(y.f), g: x.g.wrapping_add(y.g), h: x.h.wrapping_add(y.h) }\n    }\n\n    // The compression of block `blk` of the padded message `p` (§6.2.2).\n    #[effects(pure)]\n    #[uses(sched, rounds, compressed)]\n    fn compress(k: &[u32], p: &[u8], msg: &[u8], blk: usize, h: State) -> (r: State)\n        requires ktab(k), padded(msg, p), block(p, blk),\n        ensures is_compressed(msg, blk, h, r),\n    {\n        let words: usize = 16;\n        let total: usize = 64;\n        let mut w: [u32; 64] = [0; 64];\n        for t in 0..words\n            invariant scheduled(&w, msg, blk, t),\n        {\n            w[t] = load(p, msg, 64 * blk + 4 * t);\n        }\n        for u in words..total\n            invariant scheduled(&w, msg, blk, u),\n        {\n            w[u] = next_word(w[u - 2], w[u - 7], w[u - 15], w[u - 16]);\n        }\n        let mut s: State = h;\n        for v in 0..total\n            invariant scheduled(&w, msg, blk, 64), rounds_at(s, msg, blk, h, v),\n        {\n            s = step(s, k[v], w[v]);\n        }\n        add(h, s)\n    }\n\n    // ---------- the padded message and the tables ----------\n\n    spec fn pad_upto(msg: &[u8], p: &[u8], n: usize) -> bool {\n        p.len() == n && forall|i: usize| i < n ==> #[trigger] p[i] == pad_byte(msg, i)\n    }\n\n    // The padded message (§5.1.1): `msg`, the byte 0x80, zeros, and the\n    // length in bits as a big-endian 64-bit number.\n    #[effects(alloc)]\n    #[uses(padlen, pad_byte, len_byte)]\n    fn pad(msg: &[u8]) -> (r: Vec<u8>)\n        requires msg_ok(msg),\n        ensures padded(msg, r.as_slice()),\n    {\n        let n: usize = msg.len();\n        let total: usize = (n + 72) / 64 * 64;\n        let mut p: Vec<u8> = Vec::with_capacity(total);\n        for i in 0..n\n            invariant pad_upto(msg, p.as_slice(), i),\n        {\n            p.push(msg[i]);\n        }\n        p.push(0x80);\n        while p.len() + 8 < total\n            invariant n < p.len(), p.len() + 8 <= total, pad_upto(msg, p.as_slice(), p.len()),\n            decreases total - p.len(),\n        {\n            p.push(0);\n        }\n        let bits: u64 = n as u64 * 8;\n        p.push((bits >> 56) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p.push(((bits >> 48) & 0xff) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p.push(((bits >> 40) & 0xff) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p.push(((bits >> 32) & 0xff) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p.push(((bits >> 24) & 0xff) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p.push(((bits >> 16) & 0xff) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p.push(((bits >> 8) & 0xff) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p.push((bits & 0xff) as u8);\n        assert(pad_upto(msg, p.as_slice(), p.len()));\n        p\n    }\n\n    #[effects(pure)]\n    #[uses(kk)]\n    fn constants() -> (k: [u32; 64])\n        ensures ktab(&k),\n    {\n        [\n            0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n            0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n            0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n            0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n            0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n            0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n            0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n            0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,\n        ]\n    }\n\n    #[effects(pure)]\n    #[uses(h0)]\n    fn initial() -> (r: State)\n        ensures is_h0(r),\n    {\n        State { a: 0x6a09e667, b: 0xbb67ae85, c: 0x3c6ef372, d: 0xa54ff53a, e: 0x510e527f, f: 0x9b05688c, g: 0x1f83d9ab, h: 0x5be0cd19 }\n    }\n\n    // The 32 bytes of the hash value, each word big-endian.\n    #[effects(pure)]\n    #[uses(out_byte, be_byte)]\n    fn output(s: State) -> (out: [u8; 32])\n        ensures bytes_of(s, &out),\n    {\n        let mut r: [u8; 32] = [0; 32];\n        r[0] = (s.a >> 24) as u8;\n        r[1] = ((s.a >> 16) & 0xff) as u8;\n        r[2] = ((s.a >> 8) & 0xff) as u8;\n        r[3] = (s.a & 0xff) as u8;\n        r[4] = (s.b >> 24) as u8;\n        r[5] = ((s.b >> 16) & 0xff) as u8;\n        r[6] = ((s.b >> 8) & 0xff) as u8;\n        r[7] = (s.b & 0xff) as u8;\n        r[8] = (s.c >> 24) as u8;\n        r[9] = ((s.c >> 16) & 0xff) as u8;\n        r[10] = ((s.c >> 8) & 0xff) as u8;\n        r[11] = (s.c & 0xff) as u8;\n        r[12] = (s.d >> 24) as u8;\n        r[13] = ((s.d >> 16) & 0xff) as u8;\n        r[14] = ((s.d >> 8) & 0xff) as u8;\n        r[15] = (s.d & 0xff) as u8;\n        r[16] = (s.e >> 24) as u8;\n        r[17] = ((s.e >> 16) & 0xff) as u8;\n        r[18] = ((s.e >> 8) & 0xff) as u8;\n        r[19] = (s.e & 0xff) as u8;\n        r[20] = (s.f >> 24) as u8;\n        r[21] = ((s.f >> 16) & 0xff) as u8;\n        r[22] = ((s.f >> 8) & 0xff) as u8;\n        r[23] = (s.f & 0xff) as u8;\n        r[24] = (s.g >> 24) as u8;\n        r[25] = ((s.g >> 16) & 0xff) as u8;\n        r[26] = ((s.g >> 8) & 0xff) as u8;\n        r[27] = (s.g & 0xff) as u8;\n        r[28] = (s.h >> 24) as u8;\n        r[29] = ((s.h >> 16) & 0xff) as u8;\n        r[30] = ((s.h >> 8) & 0xff) as u8;\n        r[31] = (s.h & 0xff) as u8;\n        r\n    }\n\n    // The SHA-256 digest of `msg` (FIPS 180-4 §6.2).\n    #[effects(alloc)]\n    #[uses(padlen, chain)]\n    fn digest(msg: &[u8]) -> (r: [u8; 32])\n        requires msg_ok(msg),\n        ensures hashed(msg, &r),\n    {\n        let p: Vec<u8> = pad(msg);\n        let k: [u32; 64] = constants();\n        let mut h: State = initial();\n        let blocks: usize = p.len() / 64;\n        for blk in 0..blocks\n            invariant padded(msg, p.as_slice()), ktab(&k), blocks * 64 == p.len(), chained(msg, blk, h),\n        {\n            h = compress(&k, p.as_slice(), msg, blk, h);\n        }\n        output(h)\n    }\n}\n");
