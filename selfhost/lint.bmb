#[summary("The contract lint (port of stage0 compiler/src/lint.rs, lint_sources_selected): `bmb lint`, every check, alone or with others under `--select`. The checks that ask the solver: W0901, preconditions that cannot hold together; W0918, postconditions that allow two results for one input, with the witness (only on request); W0905, a loop exit or the end of a verified function's body that its own proof cannot reach; W0902, a precondition the function's proof does not need, W0903, a postcondition no caller's proof uses, and W0904, a single change to a body that the specification does not distinguish (unit mutate), each found by proving again with the clause removed or the change made, stopping at the first failure; W1002, an `assume` of a definition that is proved without trusted facts. The checks that read the program alone are in unit lint_syntax, and the input aliases the parser and the checker took (W0912, W0913, W0914, W0917) are reported as they noted them. Every query after the first verification is advisory (ADR-0131): the advisory memory limit, and for the full queries the advisory resource limit; a query that reaches either is undecided, so a report can be left out but none is added")]
mod lint {
    #[summary("Result of bmb lint: checked is false when the program does not check (text is then its diagnostics); otherwise text is the report, and ok is false when the proof gate could not run. trap is set where stage0 stops on a text range outside its file: nothing is printed then")]
    struct Linted { checked: bool, ok: bool, text: String, trap: bool }

    #[summary("The mutation sites of one function in the plan of W0904: its path, the text of its file and its sites")]
    struct Plan { path: String, file: usize, sites: Vec<mutate::Site> }

    #[summary("Whether the definitions in paths verify completely (stage0 clean): each has a status with no failed obligation and no diagnostic inside its span")]
    #[effects(alloc)]
    fn clean(statuses: &[prove::Status], diags: &[diag::Diag], spans: &table::Table<source::Span>, paths: &[String]) -> bool {
        for k in 0..paths.len()
            invariant 0 <= k && k <= paths.len(),
        {
            let sp: source::Span = match spans.find(paths[k].as_str()) {
                None => { return false; },
                Some(at) => { if at < spans.items.len() { spans.items[at] } else { return false; } },
            };
            let mut status: bool = false;
            for i in 0..statuses.len()
                invariant 0 <= i && i <= statuses.len(),
            {
                if statuses[i].path == paths[k] && statuses[i].failed == 0 {
                    status = true;
                }
            }
            if !status {
                return false;
            }
            for j in 0..diags.len()
                invariant 0 <= j && j <= diags.len(),
            {
                if diags[j].span.file == sp.file && diags[j].span.lo >= sp.lo && diags[j].span.hi <= sp.hi {
                    return false;
                }
            }
        }
        true
    }

    #[summary("The checks of stage0's lint by the code each reports (stage0 CODES), for the text of an unknown one")]
    #[effects(alloc)]
    fn codes() -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        out.push(String::from("W0901"));
        out.push(String::from("W0902"));
        out.push(String::from("W0903"));
        out.push(String::from("W0904"));
        out.push(String::from("W0905"));
        out.push(String::from("W0906"));
        out.push(String::from("W0907"));
        out.push(String::from("W0909"));
        out.push(String::from("W0910"));
        out.push(String::from("W0911"));
        out.push(String::from("W0912"));
        out.push(String::from("W0913"));
        out.push(String::from("W0914"));
        out.push(String::from("W0915"));
        out.push(String::from("W0916"));
        out.push(String::from("W0917"));
        out.push(String::from("W0918"));
        out.push(String::from("W1001"));
        out.push(String::from("W1002"));
        out
    }

    #[summary("A cost of a satisfiability check in the summary row: its resource units and its undecided count, or null twice when the check did not run")]
    #[effects(alloc)]
    fn cost_fields(out: &mut String, name: &str, c: &Option<sat::Cost>) -> () {
        out.push_str(",\"");
        out.push_str(name);
        out.push_str("_rlimit\":");
        match c {
            None => out.push_str("null"),
            Some(k) => std::num::push_u64(out, k.rlimit),
        }
        out.push_str(",\"");
        out.push_str(name);
        out.push_str("_undecided\":");
        match c {
            None => out.push_str("null"),
            Some(k2) => std::num::push_u64(out, k2.undecided as u64),
        }
    }

    #[summary("Rust's Debug text of a string, as stage0's message for an unknown check prints it: in double quotes, with a backslash before a quote and a backslash, and the escapes of the tab, the line feed, the carriage return, NUL and the other control characters of ASCII")]
    #[effects(alloc)]
    fn debug_str(s: &str) -> String {
        let mut out: String = String::from("\"");
        let mut from: usize = 0;
        for i in 0..s.len()
            invariant 0 <= i && i <= s.len() && from <= i,
        {
            let c: u8 = s.as_bytes()[i];
            if c == 34 || c == 92 || c < 32 || c == 127 {
                out.push_str(lexer::cut(s, from, i).as_str());
                if c == 34 {
                    out.push_str("\\\"");
                } else if c == 92 {
                    out.push_str("\\\\");
                } else if c == 9 {
                    out.push_str("\\t");
                } else if c == 10 {
                    out.push_str("\\n");
                } else if c == 13 {
                    out.push_str("\\r");
                } else if c == 0 {
                    out.push_str("\\0");
                } else {
                    out.push_str("\\u{");
                    out.push_str(hex(c).as_str());
                    out.push_str("}");
                }
                from = i + 1;
            }
        }
        out.push_str(lexer::cut(s, from, s.len()).as_str());
        out.push_str("\"");
        out
    }

    #[summary("The checks a plain `bmb lint` runs (stage0 default_codes): every one but W0918, which is information and runs only when `--select` names it")]
    #[effects(alloc)]
    fn default_codes() -> Vec<String> {
        let all: Vec<String> = codes();
        let mut out: Vec<String> = Vec::new();
        for i in 0..all.len()
            invariant 0 <= i && i <= all.len(),
        {
            if all[i] != "W0918" {
                out.push(all[i].clone());
            }
        }
        out
    }

    #[summary("The definitions with a body in walk order, each with its unit (stage0 check::defs_of with the definition)")]
    #[effects(alloc)]
    fn defs_of(ck: &body::Checked) -> Vec<codegen::Def> {
        let mut by_span: table::Table<ast::FnDef> = table::new::<ast::FnDef>();
        for i in 0..ck.program.mods.len()
            invariant 0 <= i && i <= ck.program.mods.len(),
        {
            codegen::fn_defs(&ck.program.mods[i], &mut by_span, 100000);
        }
        let rows: Vec<body::DefRow> = body::defs_of(&ck.program, &ck.b.c.fns);
        let mut defs: Vec<codegen::Def> = Vec::new();
        for r in 0..rows.len()
            invariant 0 <= r && r <= rows.len(),
        {
            match by_span.find(body::span_key(rows[r].span).as_str()) {
                None => {},
                Some(at) => defs.push(codegen::Def { path: rows[r].path.clone(), unit: rows[r].unit.clone(), d: by_span.items[at].clone() }),
            }
        }
        defs
    }

    #[summary("Two lowercase hexadecimal digits at most of a byte, without leading zeros (Rust's {:x})")]
    #[effects(alloc)]
    fn hex(c: u8) -> String {
        let mut out: String = String::new();
        if c >= 16 {
            out.push_str(lexer::cut("0123456789abcdef", (c / 16) as usize, (c / 16) as usize + 1).as_str());
        }
        out.push_str(lexer::cut("0123456789abcdef", (c % 16) as usize, (c % 16) as usize + 1).as_str());
        out
    }

    #[summary("Whether the definitions only verify completely in the changed program (one re-verification of stage0's W0902, W0903 and W0904, verify_defs): they alone are proved, every other definition seen as in the whole program, through the proof cache, at the advisory limits (rlimit is the gate's limit, of which the shares are, and advisory the limit of a full query), stopping at the first obligation that fails")]
    #[effects(alloc, io, nondet)]
    fn proves(changed: &body::Checked, only: &[String], store: &mut Option<cache::ProofCache>, z3: &mut toolchain::Z3, rlimit: u64, advisory: u64, spans: &table::Table<source::Span>) -> bool {
        let mut listed: Vec<String> = Vec::new();
        for i in 0..only.len()
            invariant 0 <= i && i <= only.len(),
        {
            listed.push(only[i].clone());
        }
        let opts: prove::Opts = prove::Opts { only: Some(listed), bounded: false, seed: 0, rlimit: rlimit, query: advisory, who: solver::Asker::Refutations, stop: true, jobs: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let o: prove::Outcome = prove::run(changed, &opts, store, z3, &mut diags);
        clean(o.statuses.as_slice(), diags.items.as_slice(), spans, only)
    }

    #[summary("Appends the diagnostics ds to out, in order")]
    #[effects(alloc)]
    fn push_all(out: &mut diag::Diags, ds: &[diag::Diag]) -> () {
        for i in 0..ds.len()
            invariant 0 <= i && i <= ds.len(),
        {
            out.push(ds[i].clone());
        }
    }

    #[summary("bmb lint (stage0 lint_sources_selected) over the files as one program, running the checks select names, each reporting what it reports in a full run. The first verification (the gate's limits, through a proof cache kept in memory, or loaded from cache_dir, where the per-definition cache serves it too) runs only for the checks that judge verified functions (W0902 to W0905, W1002), the precondition check also for the ones that skip the functions it refutes (W0902, W0904, W0905, W0918). Without a first verification, a solver that cannot run is still E0812 at the first unit's name when the precondition check runs. Re-verifications are capped: 32 for W0902, 32 for W0903, and 64 mutants for W0904, taken round-robin over the functions in path order; the rest are counted as skipped. A summary count of a check that did not run is 0, the cost of a satisfiability check that did not run null. With cache_dir the proof cache is written back there")]
    #[effects(alloc, io, nondet)]
    fn run(files: &[lib::Input], cache_dir: &Option<String>, select: &[String]) -> Linted {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let fe: lib::Front = lib::frontend(files, &mut sm, &mut diags);
        if diags.has_errors() {
            return Linted { checked: false, ok: false, text: diags.to_jsonl(&sm), trap: false };
        }
        let needs_base: bool = types::has(select, "W0902") || types::has(select, "W0903") || types::has(select, "W0904") || types::has(select, "W0905") || types::has(select, "W1002");
        let needs_pre: bool = types::has(select, "W0901") || types::has(select, "W0902") || types::has(select, "W0904") || types::has(select, "W0905") || types::has(select, "W0918");
        let mut store: Option<cache::ProofCache> = match cache_dir {
            None => Some(cache::empty()),
            Some(dir) => Some(cache::load(dir.as_str())),
        };
        let mut z3: toolchain::Z3 = toolchain::new();
        let gate: u64 = solver::rlimit();
        let mut statuses: Vec<prove::Status> = Vec::new();
        if !needs_base {
            if needs_pre {
                match toolchain::check_z3(&mut z3) {
                    Ok(v) => {},
                    Err(why) => { let first: source::Span = if fe.ck.program.mods.len() > 0 { fe.ck.program.mods[0].name.span } else { source::Span { file: 0, lo: 0, hi: 0 } }; diags.push(diag::new("E0812", first, types::cat2("proof gate cannot run: ", why.as_str()).as_str())); },
                }
            }
        } else {
            let opts: prove::Opts = prove::Opts { only: None, bounded: false, seed: 0, rlimit: gate, query: gate, who: solver::Asker::Gate, stop: false, jobs: Vec::new() };
            let pg0: encode_spec::Prog = encode_spec::prog_of(&fe.ck);
            let mut incr: Option<incremental::Session> = match cache_dir {
                None => None,
                Some(dir0) => Some(incremental::new(dir0.as_str(), incremental::compiler_id().as_str(), &fe.ck, &pg0.pr, &opts.only, false, false)),
            };
            let base: prove::Outcome = prove::run_cached(&fe.ck, &pg0, &opts, &mut store, &mut incr, &mut z3, &mut diags);
            match incremental::save_slot(&mut incr) {
                None => {},
                Some(why) => { match cache_dir { None => {}, Some(dir1) => { eprint_str("bmb: cannot write incremental cache in "); eprint_str(dir1.as_str()); eprint_str(": "); eprint_str(why.as_str()); eprint_str("\n"); }, } },
            }
            statuses = base.statuses;
        }
        let mut out: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let mut ok: bool = true;
        for i in 0..diags.items.len()
            invariant 0 <= i && i <= diags.items.len(),
        {
            if diags.items[i].code == "E0812" {
                out.push(diags.items[i].clone());
                ok = false;
            }
        }
        let mut defs: table::Table<ast::FnDef> = table::new::<ast::FnDef>();
        for m in 0..fe.ck.program.mods.len()
            invariant 0 <= m && m <= fe.ck.program.mods.len(),
        {
            if !stdlib::is_std(&fe.ck.program.mods[m]) {
                mutate::collect(&fe.ck.program.mods[m], "", &mut defs, 1000000);
            }
        }
        let mut spans: table::Table<source::Span> = table::new::<source::Span>();
        let mut exec: Vec<String> = Vec::new();
        for n in 0..defs.len()
            invariant 0 <= n,
        {
            match defs.nth(n) {
                None => {},
                Some(dn) => { let path: String = defs.key(n); spans.insert(path.as_str(), defs.items[dn].span); if mutate::is_exec(&defs.items[dn]) { exec.push(path.clone()); } },
            }
        }
        let pg: encode_spec::Prog = encode_spec::prog_of(&fe.ck);
        let sds: Vec<encode_spec::SpecDecl> = encode_spec::spec_decls(&pg);
        let dts: Vec<encode_decls::Decl> = encode_decls::datatypes(&pg.pr.t, pg.pr.inst_types.as_slice());
        let advisory: u64 = solver::query_rlimit(solver::Asker::Refutations);
        let mut unsat: Vec<String> = Vec::new();
        let mut pre_cost: Option<sat::Cost> = None;
        if needs_pre {
            let pres: sat::Pres = sat::preconditions(&fe.ck, &pg, sds.as_slice(), dts.as_slice(), &mut z3, solver::Asker::Refutations, advisory, gate);
            for i in 0..pres.rows.len()
                invariant 0 <= i && i <= pres.rows.len(),
            {
                if pres.rows[i].verdict == 0 {
                    if types::has(select, "W0901") {
                        let p: String = pres.rows[i].path.clone();
                        let mut msg: String = types::cat3("the preconditions of `", p.as_str(), "` cannot hold together (with the definitions its #[uses] reveals): no call can satisfy them, and every proof about `");
                        msg.push_str(p.as_str());
                        msg.push_str("` holds vacuously");
                        out.push(diag::fix(diag::new("W0901", pres.rows[i].span, msg.as_str()), "weaken or correct the preconditions", None));
                    }
                    unsat.push(pres.rows[i].path.clone());
                }
            }
            pre_cost = Some(pres.cost);
        }
        let mut det_cost: Option<sat::Cost> = None;
        if types::has(select, "W0918") {
            let dets: sat::Dets = sat::determined(&fe.ck, &pg, sds.as_slice(), dts.as_slice(), &mut z3, solver::Asker::Refutations, advisory, gate);
            for i in 0..dets.rows.len()
                invariant 0 <= i && i <= dets.rows.len(),
            {
                let p: String = dets.rows[i].path.clone();
                if dets.rows[i].kind == 1 && !types::has(unsat.as_slice(), p.as_str()) && defs.has(p.as_str()) {
                    let at_input: String = if dets.rows[i].input.len() == 0 {
                        String::new()
                    } else {
                        types::cat2(" at ", dets.rows[i].input.as_str())
                    };
                    let mut msg: String = types::cat5("the postconditions of `", p.as_str(), "` allow two results for one input", at_input.as_str(), ": ");
                    msg.push_str(types::cat4(dets.rows[i].first.as_str(), " and ", dets.rows[i].second.as_str(), " both hold").as_str());
                    out.push(diag::fix(diag::new("W0918", dets.rows[i].span, msg.as_str()), "if one result is meant, state what tells them apart; if the freedom is meant, this is information", None));
                }
            }
            det_cost = Some(dets.cost);
        }
        let mut reach_cost: Option<sat::Cost> = None;
        if types::has(select, "W0905") {
            let pts: sat::Points = sat::vacuous(&fe.ck, &pg, sds.as_slice(), dts.as_slice(), &mut z3, solver::Asker::Refutations, advisory, gate);
            for i in 0..pts.rows.len()
                invariant 0 <= i && i <= pts.rows.len(),
            {
                let p: String = pts.rows[i].path.clone();
                let mut one: Vec<String> = Vec::new();
                one.push(p.clone());
                if !types::has(unsat.as_slice(), p.as_str()) && !types::has(fe.ck.b.external.as_slice(), p.as_str()) && clean(statuses.as_slice(), diags.items.as_slice(), &spans, one.as_slice()) {
                    let mut msg: String = types::cat5("the ", pts.rows[i].what.as_str(), " of `", p.as_str(), "` is unreachable in its proof: every obligation after it holds vacuously");
                    out.push(diag::fix(diag::new("W0905", pts.rows[i].span, msg.as_str()), "look for a contradiction in the loop invariants, the callees' postconditions and the revealed definitions", None));
                }
            }
            reach_cost = Some(pts.cost);
        }
        let mut verifications: usize = 0;
        let mut skipped: usize = 0;
        let mut trials: usize = 0;
        let mut trap: bool = false;
        if types::has(select, "W0902") {
            for x in 0..exec.len()
                invariant 0 <= x && x <= exec.len(),
            {
                let path: String = exec[x].clone();
                let mut one: Vec<String> = Vec::new();
                one.push(path.clone());
                match defs.find(path.as_str()) {
                    None => {},
                    Some(di) => { let count: usize = defs.items[di].pre.len(); if count > 0 && !types::has(unsat.as_slice(), path.as_str()) && !types::has(fe.ck.b.external.as_slice(), path.as_str()) && clean(statuses.as_slice(), diags.items.as_slice(), &spans, one.as_slice()) { for i in 0..count invariant 0 <= i && i <= count, { if trials == 32 { skipped = skipped.saturating_add(1); } else if i < defs.items[di].pre.len() { trials = trials.saturating_add(1); verifications = verifications.saturating_add(1); let mut changed: body::Checked = fe.ck.clone(); mutate::edit(&mut changed.program, path.as_str(), 0, i, ""); if proves(&changed, one.as_slice(), &mut store, &mut z3, gate, advisory, &spans) { let sp: source::Span = defs.items[di].pre[i].span; let mut msg: String = types::cat3("precondition `", lexer::cut(source_text(files, sp.file).as_str(), sp.lo as usize, sp.hi as usize).as_str(), "` is not needed by this function's proof: `"); msg.push_str(path.as_str()); msg.push_str("` verifies without it"); out.push(diag::fix(diag::new("W0902", sp, msg.as_str()), "remove or weaken it if it does not state intent; callers then have less to prove", None)); } } } } },
                }
            }
        }
        if types::has(select, "W0903") {
            let mut idn: map::Idents = map::idents(&fe.ck);
            let mut pr: fmt::Printer = fmt::identity(fe.ck.b.c.fns.clone(), fe.ck.b.c.adts.clone(), fe.ck.b.types.clone(), idn.traits.clone());
            let ix: map::Index = map::build(&fe.ck, &sm, &mut idn, &mut pr);
            let mut callers: table::Table<Vec<String>> = table::new::<Vec<String>>();
            for e in 0..ix.edges.items.len()
                invariant 0 <= e && e <= ix.edges.items.len(),
            {
                if ix.edges.items[e].kind == "calls" && defs.has(ix.edges.items[e].from.as_str()) {
                    match callers.find(ix.edges.items[e].to.as_str()) {
                        None => { let mut from: Vec<String> = Vec::new(); from.push(ix.edges.items[e].from.clone()); callers.insert(ix.edges.items[e].to.as_str(), from); },
                        Some(known) => callers.items[known].push(ix.edges.items[e].from.clone()),
                    }
                }
            }
            trials = 0;
            for x in 0..exec.len()
                invariant 0 <= x && x <= exec.len(),
            {
                let path: String = exec[x].clone();
                match callers.find(path.as_str()) {
                    None => {},
                    Some(known2) => { let cs: Vec<String> = body::sorted_set(callers.items[known2].as_slice()); match defs.find(path.as_str()) { None => {}, Some(di) => { let count: usize = defs.items[di].post.len(); if count > 0 && clean(statuses.as_slice(), diags.items.as_slice(), &spans, cs.as_slice()) { for i in 0..count invariant 0 <= i && i <= count, { if trials == 32 { skipped = skipped.saturating_add(1); } else if i < defs.items[di].post.len() { trials = trials.saturating_add(1); verifications = verifications.saturating_add(1); let mut changed: body::Checked = fe.ck.clone(); mutate::edit(&mut changed.program, path.as_str(), 1, i, ""); if proves(&changed, cs.as_slice(), &mut store, &mut z3, gate, advisory, &spans) { let sp: source::Span = defs.items[di].post[i].span; let mut msg: String = types::cat3("postcondition `", lexer::cut(source_text(files, sp.file).as_str(), sp.lo as usize, sp.hi as usize).as_str(), "` is not used by any caller's proof: "); std::num::push_u64(&mut msg, cs.len() as u64); if cs.len() == 1 { msg.push_str(" caller of `"); } else { msg.push_str(" callers of `"); } msg.push_str(path.as_str()); if cs.len() == 1 { msg.push_str("` verifies without it"); } else { msg.push_str("` verify without it"); } out.push(diag::fix(diag::new("W0903", sp, msg.as_str()), "keep it if it states intent for future callers; otherwise it can be removed or weakened", None)); } } } } }, } },
                }
            }
        }
        let mut mutants: usize = 0;
        let mut surviving: usize = 0;
        let mut mutants_skipped: usize = 0;
        if types::has(select, "W0904") {
            let mut plan: Vec<Plan> = Vec::new();
            let mut rounds: usize = 0;
            for x in 0..exec.len()
                invariant 0 <= x && x <= exec.len(),
            {
                let path: String = exec[x].clone();
                let mut one: Vec<String> = Vec::new();
                one.push(path.clone());
                match defs.find(path.as_str()) {
                    None => {},
                    Some(di) => { if defs.items[di].post.len() > 0 && !types::has(unsat.as_slice(), path.as_str()) && !types::has(fe.ck.b.external.as_slice(), path.as_str()) && clean(statuses.as_slice(), diags.items.as_slice(), &spans, one.as_slice()) { let file: usize = defs.items[di].span.file as usize; if file < files.len() { let ss: Vec<mutate::Site> = mutate::sites(&defs.items[di], files[file].text.as_str(), &mut trap); if ss.len() > rounds { rounds = ss.len(); } plan.push(Plan { path: path.clone(), file: file, sites: ss }); } else { trap = true; } } },
                }
            }
            if !trap {
                let mut total: usize = 0;
                for k in 0..rounds
                    invariant 0 <= k && k <= rounds,
                {
                    for i in 0..plan.len()
                        invariant 0 <= i && i <= plan.len(),
                    {
                        if k < plan[i].sites.len() {
                            if total >= 64 {
                                mutants_skipped = mutants_skipped.saturating_add(1);
                            } else if plan[i].file < files.len() {
                                total = total + 1;
                                let mut changed: body::Checked = fe.ck.clone();
                                if !mutate::edit(&mut changed.program, plan[i].path.as_str(), 2, k, files[plan[i].file].text.as_str()) {
                                    trap = true;
                                }
                                let mut one: Vec<String> = Vec::new();
                                one.push(plan[i].path.clone());
                                if !trap && proves(&changed, one.as_slice(), &mut store, &mut z3, gate, advisory, &spans) {
                                    surviving = surviving.saturating_add(1);
                                    let mut msg: String = types::cat5("the specification does not distinguish this change: `", plan[i].sites[k].before.as_str(), "` -> `", plan[i].sites[k].after.as_str(), "` (`");
                                    msg.push_str(plan[i].path.as_str());
                                    msg.push_str("` still verifies with it)");
                                    out.push(diag::fix(diag::new("W0904", plan[i].sites[k].span, msg.as_str()), "strengthen the postcondition so that it rules this change out, unless the change is equivalent on every input the precondition allows", None));
                                }
                            }
                        }
                    }
                }
                mutants = total;
            }
        }
        if types::has(select, "W0906") {
            let mut found: Vec<diag::Diag> = Vec::new();
            for n in 0..defs.len()
                invariant 0 <= n,
            {
                match defs.nth(n) {
                    None => {},
                    Some(dn) => { let file: usize = defs.items[dn].span.file as usize; if file < files.len() { lint_syntax::self_matching(&defs.items[dn], files[file].text.as_str(), &mut found, &mut trap); } else { trap = true; } },
                }
            }
            push_all(&mut out, found.as_slice());
        }
        if types::has(select, "W0907") {
            push_all(&mut out, lint_syntax::canonical_loops(&fe.ck.program, files, &mut trap).as_slice());
        }
        for i in 0..diags.aliases.len()
            invariant 0 <= i && i <= diags.aliases.len(),
        {
            if types::has(select, diags.aliases[i].code.as_str()) && (diags.aliases[i].span.file as usize) < files.len() {
                out.push(diags.aliases[i].clone());
            }
        }
        let walked: Vec<codegen::Def> = if types::has(select, "W0916") || types::has(select, "W1001") {
            defs_of(&fe.ck)
        } else {
            Vec::new()
        };
        if types::has(select, "W0916") {
            let low: lowered::Tables = lowered::tables(&fe.ck);
            let context: table::Table<Vec<String>> = encode_decls::default_contexts(&fe.ck.program, &low);
            push_all(&mut out, lint_syntax::default_uses(walked.as_slice(), &context, &fe.ck.b.c.fns, files, &mut trap).as_slice());
        }
        if types::has(select, "W0915") {
            push_all(&mut out, lint_syntax::conversions(&fe.source, files).as_slice());
        }
        if types::has(select, "W0911") {
            push_all(&mut out, lint_syntax::method_calls(&fe.source, &fe.ck, files).as_slice());
        }
        if types::has(select, "W0909") {
            push_all(&mut out, lint_syntax::unneeded_effects(&fe.ck, &defs).as_slice());
        }
        if types::has(select, "W0910") {
            push_all(&mut out, lint_syntax::io_loop_cores(&fe.ck, &defs).as_slice());
        }
        if types::has(select, "W1001") {
            push_all(&mut out, lint_syntax::unconfirmed_rationales(walked.as_slice(), &fe.ck.b.c.fns).as_slice());
        }
        if types::has(select, "W1002") {
            for i in 0..statuses.len()
                invariant 0 <= i && i <= statuses.len(),
            {
                if statuses[i].failed == 0 && statuses[i].trust == 0 {
                    match defs.find(statuses[i].path.as_str()) {
                        None => {},
                        Some(d) => { let es: escape::DefEscapes = escape::of(&defs.items[d]); for a in 0..es.assumes.len() invariant 0 <= a && a <= es.assumes.len(), { out.push(diag::fix(diag::new("W1002", es.assumes[a], types::cat3("`", statuses[i].path.as_str(), "` is proved without this `assume`: the escape is not needed").as_str()), "remove it (and its rationale)", Some(String::new()))); } },
                    }
                }
            }
        }
        match cache_dir {
            None => {},
            Some(dir) => { match &store { None => {}, Some(kept) => { match cache::save(kept, dir.as_str()) { Ok(u) => {}, Err(why) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(dir.as_str()); eprint_str(": "); eprint_str(why.as_str()); eprint_str("\n"); }, } }, } },
        }
        let mut reports: usize = 0;
        for i in 0..out.items.len()
            invariant 0 <= i && i <= out.items.len(),
        {
            if encode_terms::starts_at(out.items[i].code.as_str(), 0, "W") {
                reports = reports.saturating_add(1);
            }
        }
        let mut text: String = out.to_jsonl(&sm);
        text.push_str("{\"summary\":true,\"defs\":");
        std::num::push_u64(&mut text, exec.len() as u64);
        text.push_str(",\"reports\":");
        std::num::push_u64(&mut text, reports as u64);
        text.push_str(",\"verifications\":");
        std::num::push_u64(&mut text, verifications as u64);
        text.push_str(",\"skipped\":");
        std::num::push_u64(&mut text, skipped as u64);
        text.push_str(",\"mutants\":");
        std::num::push_u64(&mut text, mutants as u64);
        text.push_str(",\"surviving\":");
        std::num::push_u64(&mut text, surviving as u64);
        text.push_str(",\"mutants_skipped\":");
        std::num::push_u64(&mut text, mutants_skipped as u64);
        cost_fields(&mut text, "pre", &pre_cost);
        cost_fields(&mut text, "reach", &reach_cost);
        cost_fields(&mut text, "det", &det_cost);
        text.push_str("}\n");
        Linted { checked: true, ok: ok, text: text, trap: trap }
    }

    #[summary("The text of source file file among the inputs; empty for a file of the library")]
    #[effects(alloc)]
    fn source_text(files: &[lib::Input], file: u32) -> String {
        if (file as usize) < files.len() {
            files[file as usize].text.clone()
        } else {
            String::new()
        }
    }
}
