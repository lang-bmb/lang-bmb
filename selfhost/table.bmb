#[summary("Table keyed by text: can be iterated in key order and values are read by slot. Stands in for stage0's BTreeMap<String, V>: std's BTreeMap hands out values by copy (ADR-0097) and its insertion is O(n). The index is a height-balanced tree (AVL) and the nodes are in one Vec: lookup·insertion·n-th in order are all O(log n)")]
mod table {
    #[summary("Tree node: the value of key key is items[at]. l·r are the node numbers of the left·right children (index in nodes + 1, 0 if none), h is the height, n is the number of keys under this node")]
    struct Node { key: String, at: usize, l: usize, r: usize, h: usize, n: usize }

    #[summary("nodes is the nodes of the index (in insertion order), root is the node number of the root (0 for an empty table). Inserting the same key again replaces the value in its slot")]
    struct Table<V> { nodes: Vec<Node>, root: usize, items: Vec<V> }

    impl<V> Table<V> {
        #[summary("Slot of the value of key k (index in items): a slot is given only as the slot of a node whose key is k (keyed)")]
        #[effects(pure)]
        #[uses(keyed, names, node_of, within)]
        fn find(self: &Table<V>, k: &str) -> (r: Option<usize>)
            ensures within(r, self.items.len()), keyed(self.nodes.as_slice(), k, r),
        {
            let t: usize = seek(self.nodes.as_slice(), self.root, k);
            if t == 0 || t > self.nodes.len() {
                return None;
            }
            let i: usize = self.nodes[t - 1].at;
            if i < self.items.len() {
                Some(i)
            } else {
                None
            }
        }

        #[summary("Whether key k is present")]
        #[effects(pure)]
        fn has(self: &Table<V>, k: &str) -> bool {
            seek(self.nodes.as_slice(), self.root, k) != 0
        }

        #[summary("Sets k to v. Replaces the value if the key was present")]
        #[effects(alloc)]
        fn insert(self: &mut Table<V>, k: &str, v: V) -> () {
            let t: usize = seek(self.nodes.as_slice(), self.root, k);
            if t != 0 && t <= self.nodes.len() {
                let i: usize = self.nodes[t - 1].at;
                if i < self.items.len() {
                    self.items[i] = v;
                } else {
                    let again: usize = self.items.len();
                    self.items.push(v);
                    self.nodes[t - 1].at = again;
                }
                return;
            }
            let at: usize = self.items.len();
            self.items.push(v);
            let root: usize = self.root;
            self.root = put(&mut self.nodes, root, k, at, 1000000000);
        }

        #[summary("The n-th key in key order. Empty text if out of range")]
        #[effects(alloc)]
        fn key(self: &Table<V>, n: usize) -> String {
            let t: usize = pick(self.nodes.as_slice(), self.root, n);
            if t == 0 || t > self.nodes.len() {
                return String::new();
            }
            self.nodes[t - 1].key.clone()
        }

        #[summary("Number of keys")]
        #[effects(pure)]
        fn len(self: &Table<V>) -> usize {
            self.nodes.len()
        }

        #[summary("Slot of the n-th value in key order (index in items)")]
        #[effects(pure)]
        #[uses(within)]
        fn nth(self: &Table<V>, n: usize) -> (r: Option<usize>)
            ensures within(r, self.items.len()),
        {
            let t: usize = pick(self.nodes.as_slice(), self.root, n);
            if t == 0 || t > self.nodes.len() {
                return None;
            }
            let i: usize = self.nodes[t - 1].at;
            if i < self.items.len() {
                Some(i)
            } else {
                None
            }
        }
    }

    #[summary("Number of keys under node t. 0 for an absent node")]
    #[effects(pure)]
    fn count(ns: &[Node], t: usize) -> usize {
        if t == 0 || t > ns.len() {
            0
        } else {
            ns[t - 1].n
        }
    }

    #[summary("Height of node t. 0 for an absent node")]
    #[effects(pure)]
    fn height(ns: &[Node], t: usize) -> usize {
        if t == 0 || t > ns.len() {
            0
        } else {
            ns[t - 1].h
        }
    }

    #[summary("A slot r, if present, is the slot of a node of ns whose key is k (node_of): what a lookup by key may give")]
    spec fn keyed(ns: &[Node], k: &str, r: Option<usize>) -> bool {
        match r {
            None => true,
            Some(i) => node_of(ns, k, i),
        }
    }

    #[summary("Rotates to rebalance if the heights of the two children of node t differ by two or more. Number of the new root")]
    #[effects(pure)]
    fn level(ns: &mut Vec<Node>, t: usize) -> usize
        ensures ns.len() == old(ns).len(),
    {
        if t == 0 || t > ns.len() {
            return t;
        }
        renew(ns, t);
        let l: usize = ns[t - 1].l;
        let r: usize = ns[t - 1].r;
        let hl: usize = height(ns.as_slice(), l);
        let hr: usize = height(ns.as_slice(), r);
        if hl > hr && hl - hr > 1 && l != 0 && l <= ns.len() {
            if height(ns.as_slice(), ns[l - 1].l) < height(ns.as_slice(), ns[l - 1].r) {
                let nl: usize = turn_left(ns, l);
                if t <= ns.len() {
                    ns[t - 1].l = nl;
                }
            }
            return turn_right(ns, t);
        }
        if hr > hl && hr - hl > 1 && r != 0 && r <= ns.len() {
            if height(ns.as_slice(), ns[r - 1].r) < height(ns.as_slice(), ns[r - 1].l) {
                let nr: usize = turn_right(ns, r);
                if t <= ns.len() {
                    ns[t - 1].r = nr;
                }
            }
            return turn_left(ns, t);
        }
        t
    }

    #[summary("A node number t, if not 0, is that of a node of ns whose key is k")]
    spec fn names(ns: &[Node], t: usize, k: &str) -> bool {
        t == 0 || t <= ns.len() && ns[t - 1].key == k
    }

    #[summary("Empty table")]
    #[effects(alloc)]
    fn new<V>() -> Table<V> {
        let items: Vec<V> = Vec::new();
        let nodes: Vec<Node> = Vec::new();
        Table { nodes: nodes, root: 0, items: items }
    }

    #[summary("Whether slot i is the slot of a node of ns whose key is k. A caller of a lookup sees this by name only, so the lookup's contract costs it nothing; a proof about keys reveals it")]
    spec fn node_of(ns: &[Node], k: &str, i: usize) -> bool {
        exists|j: usize| j < ns.len() && #[trigger] ns[j].key == k && ns[j].at == i
    }

    #[summary("Number of the n-th node in key order under root root. 0 if out of range")]
    #[effects(pure)]
    fn pick(ns: &[Node], root: usize, n: usize) -> usize {
        let mut t: usize = root;
        let mut rest: usize = n;
        let mut f: usize = 1000000000;
        while t != 0 && t <= ns.len() && f > 0
            decreases f,
        {
            let before: usize = count(ns, ns[t - 1].l);
            if rest < before {
                t = ns[t - 1].l;
            } else if rest == before {
                return t;
            } else {
                rest = rest - before - 1;
                t = ns[t - 1].r;
            }
            f = f - 1;
        }
        0
    }

    #[summary("Inserts new key k (value slot at) under root t. Number of the new root. If the key is present, only replaces its slot. Fuel f is greater than the depth of the tree (the height is the logarithm of the number of keys)")]
    #[effects(alloc)]
    fn put(ns: &mut Vec<Node>, t: usize, k: &str, at: usize, f: usize) -> usize
        decreases f,
    {
        if t == 0 || t > ns.len() || f == 0 {
            ns.push(Node { key: String::from(k), at: at, l: 0, r: 0, h: 1, n: 1 });
            return ns.len();
        }
        if k < ns[t - 1].key.as_str() {
            let l: usize = ns[t - 1].l;
            let nl: usize = put(ns, l, k, at, f - 1);
            if t <= ns.len() {
                ns[t - 1].l = nl;
            }
        } else if ns[t - 1].key.as_str() < k {
            let r: usize = ns[t - 1].r;
            let nr: usize = put(ns, r, k, at, f - 1);
            if t <= ns.len() {
                ns[t - 1].r = nr;
            }
        } else {
            ns[t - 1].at = at;
            return t;
        }
        level(ns, t)
    }

    #[summary("Recounts the height and number of keys of node t from its children")]
    #[effects(pure)]
    fn renew(ns: &mut Vec<Node>, t: usize) -> ()
        ensures ns.len() == old(ns).len(),
    {
        if t == 0 || t > ns.len() {
            return;
        }
        let l: usize = ns[t - 1].l;
        let r: usize = ns[t - 1].r;
        let hl: usize = height(ns.as_slice(), l);
        let hr: usize = height(ns.as_slice(), r);
        let top: usize = if hl < hr {
            hr
        } else {
            hl
        };
        ns[t - 1].h = top.saturating_add(1);
        ns[t - 1].n = count(ns.as_slice(), l).saturating_add(count(ns.as_slice(), r)).saturating_add(1);
    }

    #[summary("Node number of key k. 0 if absent. A number other than 0 is that of a node whose key is k (names): the text order has no two different texts of which neither is before the other")]
    #[effects(pure)]
    #[uses(names)]
    fn seek(ns: &[Node], root: usize, k: &str) -> (r: usize)
        ensures names(ns, r, k),
    {
        let mut t: usize = root;
        let mut f: usize = 1000000000;
        while t != 0 && t <= ns.len() && f > 0
            decreases f,
        {
            if k < ns[t - 1].key.as_str() {
                t = ns[t - 1].l;
            } else if ns[t - 1].key.as_str() < k {
                t = ns[t - 1].r;
            } else {
                return t;
            }
            f = f - 1;
        }
        0
    }

    #[summary("Left rotation: the right child of t comes to t's place and t becomes its left child. Number of the new root")]
    #[effects(pure)]
    fn turn_left(ns: &mut Vec<Node>, t: usize) -> usize
        ensures ns.len() == old(ns).len(),
    {
        if t == 0 || t > ns.len() {
            return t;
        }
        let r: usize = ns[t - 1].r;
        if r == 0 || r > ns.len() {
            return t;
        }
        let mid: usize = ns[r - 1].l;
        ns[t - 1].r = mid;
        ns[r - 1].l = t;
        renew(ns, t);
        renew(ns, r);
        r
    }

    #[summary("Right rotation: the left child of t comes to t's place and t becomes its right child. Number of the new root")]
    #[effects(pure)]
    fn turn_right(ns: &mut Vec<Node>, t: usize) -> usize
        ensures ns.len() == old(ns).len(),
    {
        if t == 0 || t > ns.len() {
            return t;
        }
        let l: usize = ns[t - 1].l;
        if l == 0 || l > ns.len() {
            return t;
        }
        let mid: usize = ns[l - 1].r;
        ns[t - 1].l = mid;
        ns[l - 1].r = t;
        renew(ns, t);
        renew(ns, l);
        l
    }

    #[summary("r, if present, is less than n")]
    spec fn within(r: Option<usize>, n: usize) -> bool {
        match r {
            None => true,
            Some(i) => i < n,
        }
    }
}
