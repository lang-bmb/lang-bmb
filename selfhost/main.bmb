#[summary("Driver of the compiler written in BMB (port of stage0 compiler/src/main.rs). Commands grow with each phase: for now codes, dump tokens, dump parse, dump std, dump lower, dump decls, dump types, dump moves, dump texts, dump lowered, dump layout, dump smt-decls, dump smt, dump smt-queries, check, fmt, hash, verify (with the proof cache and the proof side of the per-definition cache), lint --select (the satisfiability checks), examples, stability, emit-llvm and build, without or with --all-checks (ported syntax only: for the rest, writes the reasons and exits 2)")]
mod main {
    #[effects(alloc, io, nondet)]
    fn main() -> () {
        let args: Vec<String> = std::env::args();
        if args.len() > 1 && args[1] == "codes" {
            if args.len() > 2 && args[2] == "--md" {
                print_str(diag::codes_markdown().as_str());
            } else {
                print_str(diag::codes_jsonl().as_str());
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && args[2] == "tokens" {
            let files: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let r: lib::Outcome = lib::dump_tokens(files.as_slice());
            print_str(r.text.as_str());
            if !r.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && args[2] == "parse" {
            let sources: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let pr: lib::Outcome = lib::format_parsed(sources.as_slice());
            print_str(pr.text.as_str());
            if !pr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && (args[2] == "std" || args[2] == "lower" || args[2] == "decls" || args[2] == "types" || args[2] == "moves" || args[2] == "texts" || args[2] == "lowered" || args[2] == "layout" || args[2] == "smt-decls" || args[2] == "smt" || args[2] == "smt-queries") {
            let inputs: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let sr: lib::Outcome = lib::dump_stage(args[2].as_str(), inputs.as_slice(), solver::rlimit());
            print_str(sr.text.as_str());
            if !sr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "check" {
            let checked: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let cr: lib::Outcome = lib::check(checked.as_slice());
            print_str(cr.text.as_str());
            if !cr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "fmt" {
            let only_check: bool = args[2] == "--check";
            let from: usize = if only_check {
                3
            } else {
                2
            };
            let given: Vec<lib::Input> = read_files(args.as_slice(), from);
            let fr: lib::Outcome = lib::format(given.as_slice());
            if !fr.ok {
                print_str(fr.text.as_str());
                std::process::exit(1);
            }
            if !only_check {
                print_str(fr.text.as_str());
                return;
            }
            let mut written: String = String::new();
            let mut g: usize = 0;
            while g < given.len()
                decreases given.len() - g,
            {
                if g > 0 {
                    written.push_str("\n");
                }
                written.push_str(given[g].text.as_str());
                g = g + 1;
            }
            if written != fr.text {
                eprint_str("bmb: not in normal form\n");
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 1 && (args[1] == "emit-llvm" || args[1] == "build") {
            let building: bool = args[1] == "build";
            let mut pos: usize = 2;
            while pos < args.len() && args[pos] != "-o"
                invariant 2 <= pos && pos <= args.len(),
                decreases args.len() - pos,
            {
                pos = pos + 1;
            }
            if pos + 1 >= args.len() {
                eprint_str("usage: stage1 emit-llvm [--cache DIR] [--stats FILE] [--audit] [--all-checks] FILE.. -o OUT.ll | build [--cache DIR] [--stats FILE] [--audit] FILE.. -o OUT\n");
                std::process::exit(2);
            }
            let out_path: String = args[pos + 1].clone();
            let mut emit_args: Vec<String> = Vec::new();
            for a in 2..args.len()
                invariant 2 <= a && a <= args.len(),
            {
                if a != pos && a != pos + 1 {
                    emit_args.push(args[a].clone());
                }
            }
            let cache_dir: Option<String> = take_value(&mut emit_args, "--cache");
            let stats: Option<String> = take_value(&mut emit_args, "--stats");
            let all_checks: bool = !building && take_flag(&mut emit_args, "--all-checks");
            let audit: bool = take_flag(&mut emit_args, "--audit");
            let units: Vec<lib::Input> = read_files(emit_args.as_slice(), 0);
            let er: lib::Emitted = lib::emit_llvm(units.as_slice(), all_checks, &cache_dir, audit);
            match &er.cache_error {
                None => {},
                Some(cache_why) => { match &cache_dir { None => {}, Some(cd) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(cd.as_str()); eprint_str(": "); eprint_str(cache_why.as_str()); eprint_str("\n"); }, } },
            }
            match &er.incr_error {
                None => {},
                Some(incr_why) => { match &cache_dir { None => {}, Some(cd2) => { eprint_str("bmb: cannot write incremental cache in "); eprint_str(cd2.as_str()); eprint_str(": "); eprint_str(incr_why.as_str()); eprint_str("\n"); }, } },
            }
            match &stats {
                None => {},
                Some(sf) => { let none: incremental::Stats = incremental::no_stats(); let line: String = match &er.incr { None => incremental::checks_line(&none, er.hits, er.misses, er.checks), Some(ist) => incremental::checks_line(ist, er.hits, er.misses, er.checks), }; write_or_exit(sf.as_str(), line.as_str()); },
            }
            print_str(er.output.as_str());
            if !er.built {
                std::process::exit(1);
            }
            if er.todo.len() > 0 {
                eprint_str("stage1: emit-llvm: not ported yet, nothing written:\n");
                for q in 0..er.todo.len()
                    invariant 0 <= q && q <= er.todo.len(),
                {
                    eprint_str("  ");
                    eprint_str(er.todo[q].as_str());
                    eprint_str("\n");
                }
                std::process::exit(2);
            }
            if !building {
                write_or_exit(out_path.as_str(), er.ir.as_str());
                if !er.ok {
                    std::process::exit(1);
                }
                return;
            }
            if !er.ok || er.checks > 0 {
                eprint_str("bmb: build refused: the program is not fully proved\n");
                std::process::exit(1);
            }
            if !er.has_main {
                eprint_str("bmb: build needs a `main`\n");
                std::process::exit(1);
            }
            match toolchain::build_executable(er.ir.as_str(), out_path.as_str()) {
                Ok(built) => {},
                Err(why) => { eprint_str("bmb: "); eprint_str(why.as_str()); eprint_str("\n"); std::process::exit(1); },
            }
            return;
        }
        if args.len() > 2 && args[1] == "verify" {
            let mut emit: Option<String> = None;
            let mut cache_dir: Option<String> = None;
            let mut stats: Option<String> = None;
            let mut bounded: bool = false;
            let mut defs: Vec<String> = Vec::new();
            let mut audit: bool = false;
            let mut at: usize = 2;
            while at < args.len()
                decreases args.len() - at,
            {
                let left: usize = args.len() - at;
                if args[at] == "--audit" && left > 1 {
                    audit = true;
                    at = at + 1;
                } else if args[at] == "--bounded-search" && left > 1 {
                    bounded = true;
                    at = at + 1;
                } else if args[at] == "--emit-smt" && left > 2 {
                    emit = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--cache" && left > 2 {
                    cache_dir = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--stats" && left > 2 {
                    stats = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--def" && left > 2 {
                    defs.push(args[at + 1].clone());
                    at = at + 2;
                } else {
                    break;
                }
            }
            let sources: Vec<lib::Input> = read_files(args.as_slice(), at);
            let only: Vec<String> = body::sorted_set(defs.as_slice());
            let reuse: bool = match &emit {
                None => true,
                Some(e0) => false,
            };
            let vr: lib::Proved = lib::verify(sources.as_slice(), &cache_dir, only.as_slice(), bounded, reuse, audit);
            match &vr.cache_error {
                None => {},
                Some(cache_why) => { match &cache_dir { None => {}, Some(cd) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(cd.as_str()); eprint_str(": "); eprint_str(cache_why.as_str()); eprint_str("\n"); }, } },
            }
            match &vr.incr_error {
                None => {},
                Some(incr_why) => { match &cache_dir { None => {}, Some(cd2) => { eprint_str("bmb: cannot write incremental cache in "); eprint_str(cd2.as_str()); eprint_str(": "); eprint_str(incr_why.as_str()); eprint_str("\n"); }, } },
            }
            if vr.missing.len() > 0 {
                eprint_str("bmb: no definition ");
                eprint_str(encode_terms::join(vr.missing.as_slice(), ", ").as_str());
                eprint_str("\n");
                std::process::exit(2);
            }
            match &emit {
                None => {},
                Some(dir) => { match std::fs::create_dir_all(dir.as_str()) { Ok(made) => {}, Err(e1) => { eprint_str("bmb: cannot create "); eprint_str(dir.as_str()); eprint_str(": "); eprint_str(e1.message.as_str()); eprint_str("\n"); std::process::exit(2); }, } for i in 0..vr.scripts.len() invariant 0 <= i && i <= vr.scripts.len(), { let cs: encode_query::Script = encode_query::canonical_script(vr.scripts[i].b.as_str()); let file: String = types::cat4(dir.as_str(), "/", encode_terms::replace(vr.scripts[i].a.as_str(), "::", ".").as_str(), ".smt2"); write_or_exit(file.as_str(), cs.text.as_str()); write_or_exit(types::cat2(file.as_str(), ".legend").as_str(), cs.legend.as_str()); } },
            }
            match &stats {
                None => {},
                Some(sf) => { let none: incremental::Stats = incremental::no_stats(); let line: String = match &vr.incr { None => incremental::stats_line(&none, vr.hits, vr.misses), Some(ist) => incremental::stats_line(ist, vr.hits, vr.misses), }; write_or_exit(sf.as_str(), line.as_str()); },
            }
            print_str(vr.output.as_str());
            if !vr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "stability" {
            let mut seeds: u64 = 5;
            let mut from: usize = 2;
            if args[2] == "--seeds" && args.len() > 4 {
                match stability::parse_seeds(args[3].as_str()) {
                    None => { eprint_str("bmb: --seeds takes a number\n"); std::process::exit(2); },
                    Some(n) => { seeds = n; },
                }
                from = 4;
            }
            let proved: Vec<lib::Input> = read_files(args.as_slice(), from);
            let st: lib::Outcome = stability::run(proved.as_slice(), seeds);
            print_str(st.text.as_str());
            if !st.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 1 && args[1] == "examples" {
            let mut count: usize = 3;
            let mut at: usize = 2;
            if args.len() > 3 && args[2] == "--count" {
                match lib::parse_count(args[3].as_str()) {
                    None => { eprint_str("bmb: --count takes a number from 1 to 64\n"); std::process::exit(2); },
                    Some(k) => { count = k; },
                }
                at = 4;
            }
            let mut sep: usize = at;
            while sep < args.len() && args[sep] != "--"
                invariant at <= sep,
                decreases args.len() - sep,
            {
                sep = sep + 1;
            }
            if sep >= args.len() {
                eprint_str("bmb: put `--` between the definitions and the files\n");
                std::process::exit(2);
            }
            if sep == at || sep + 1 >= args.len() {
                eprint_str("usage: stage1 examples [--count N] DEF.. -- FILE..\n");
                std::process::exit(2);
            }
            let mut defs: Vec<String> = Vec::new();
            for d in at..sep
                invariant at <= d && d <= sep,
            {
                defs.push(args[d].clone());
            }
            let shown: Vec<lib::Input> = read_files(args.as_slice(), sep + 1);
            let xr: lib::Outcome = lib::examples(shown.as_slice(), defs.as_slice(), count);
            print_str(xr.text.as_str());
            if !xr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 1 && args[1] == "lint" {
            let mut cache_dir: Option<String> = None;
            let mut select: Vec<String> = Vec::new();
            let mut selected: bool = false;
            let mut at: usize = 2;
            while at < args.len()
                decreases args.len() - at,
            {
                if args[at] == "--cache" && at + 1 < args.len() {
                    cache_dir = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--select" && at + 1 < args.len() {
                    select = Vec::new();
                    selected = true;
                    let known: Vec<String> = lint::codes();
                    let asked: Vec<String> = encode_terms::split(args[at + 1].as_str(), 44);
                    for c in 0..asked.len()
                        invariant 0 <= c && c <= asked.len(),
                    {
                        if !types::has(known.as_slice(), asked[c].as_str()) {
                            eprint_str("bmb: lint has no check ");
                            eprint_str(lint::debug_str(asked[c].as_str()).as_str());
                            eprint_str(" (the checks are ");
                            eprint_str(encode_terms::join(known.as_slice(), ", ").as_str());
                            eprint_str(")\n");
                            std::process::exit(2);
                        }
                        select.push(asked[c].clone());
                    }
                    at = at + 2;
                } else {
                    break;
                }
            }
            if at >= args.len() {
                eprint_str("usage: stage1 lint [--cache DIR] --select CODES FILE..\n");
                std::process::exit(2);
            }
            if !selected {
                eprint_str("stage1: lint without --select: only W0901, W0902, W0905 and W0918 are ported yet\n");
                std::process::exit(2);
            }
            for c2 in 0..select.len()
                invariant 0 <= c2 && c2 <= select.len(),
            {
                if !lint::ported(select[c2].as_str()) {
                    eprint_str("stage1: lint: ");
                    eprint_str(select[c2].as_str());
                    eprint_str(" is not ported yet (W0901, W0902, W0905 and W0918 are)\n");
                    std::process::exit(2);
                }
            }
            let linted: Vec<lib::Input> = read_files(args.as_slice(), at);
            let lr: lint::Linted = lint::run(linted.as_slice(), &cache_dir, select.as_slice());
            print_str(lr.text.as_str());
            if !lr.checked || !lr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "hash" {
            let hashed: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let hr: lib::Outcome = lib::hash(hashed.as_slice());
            print_str(hr.text.as_str());
            if !hr.ok {
                std::process::exit(1);
            }
            return;
        }
        eprint_str("usage: stage1 codes [--md] | dump tokens FILE.. | dump parse FILE.. | dump std FILE.. | dump lower FILE.. | dump decls FILE.. | dump types FILE.. | dump moves FILE.. | dump texts FILE.. | dump lowered FILE.. | dump layout FILE.. | dump smt-decls FILE.. | dump smt FILE.. | dump smt-queries FILE.. | check FILE.. | fmt [--check] FILE.. | hash FILE.. | verify [--emit-smt DIR] [--cache DIR] [--stats FILE] [--audit] [--bounded-search] [--def PATH].. FILE.. | stability [--seeds N] FILE.. | emit-llvm [--cache DIR] [--stats FILE] [--audit] [--all-checks] FILE.. -o OUT.ll | build [--cache DIR] [--stats FILE] [--audit] FILE.. -o OUT\n");
        std::process::exit(2);
    }

    #[summary("Reads the files of the arguments. If one cannot be read, writes that with the system's reason to standard error and exit code 2")]
    #[effects(alloc, io, nondet)]
    fn read_files(args: &[String], from: usize) -> Vec<lib::Input> {
        let mut files: Vec<lib::Input> = Vec::new();
        let mut i: usize = from;
        while i < args.len()
            decreases args.len() - i,
        {
            match std::fs::read_to_string(args[i].as_str()) {
                Ok(text) => files.push(lib::Input { name: args[i].clone(), text: text }),
                Err(e) => { eprint_str("bmb: cannot read "); eprint_str(args[i].as_str()); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); std::process::exit(2); },
            }
            i = i + 1;
        }
        files
    }

    #[summary("Removes the first argument that is flag and gives whether there was one (stage0's position and remove)")]
    #[effects(alloc)]
    fn take_flag(args: &mut Vec<String>, flag: &str) -> bool {
        let mut out: Vec<String> = Vec::new();
        let mut found: bool = false;
        for i in 0..args.len()
            invariant 0 <= i && i <= args.len(),
        {
            if !found && args[i] == flag {
                found = true;
            } else {
                out.push(args[i].clone());
            }
        }
        *args = out;
        found
    }

    #[summary("Removes the first argument that is flag and the argument after it, and gives that one, when flag is not the last argument (stage0's position, `c + 1 < len` and remove); otherwise leaves the arguments as they are")]
    #[effects(alloc)]
    fn take_value(args: &mut Vec<String>, flag: &str) -> Option<String> {
        let mut at: usize = 0;
        while at < args.len() && args[at] != flag
            invariant at <= args.len(),
            decreases args.len() - at,
        {
            at = at + 1;
        }
        if at + 1 >= args.len() {
            return None;
        }
        let value: String = args[at + 1].clone();
        let mut out: Vec<String> = Vec::new();
        for i in 0..args.len()
            invariant 0 <= i && i <= args.len(),
        {
            if i != at && i != at + 1 {
                out.push(args[i].clone());
            }
        }
        *args = out;
        Some(value)
    }

    #[summary("Writes text to the file path. If it cannot be written, writes to standard error and exit code 2")]
    #[effects(alloc, io)]
    fn write_or_exit(path: &str, text: &str) -> () {
        match std::fs::write(path, text.as_bytes()) {
            Ok(done) => {},
            Err(e) => { eprint_str("bmb: cannot write "); eprint_str(path); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); std::process::exit(2); },
        }
    }
}
