#[summary("Driver of the compiler written in BMB (port of stage0 compiler/src/main.rs). Commands grow with each phase: for now codes, dump tokens, dump parse, dump std, dump lower, dump decls, dump types, dump moves, dump texts, dump lowered, dump layout, dump smt-decls, dump smt, dump smt-queries, check, fmt, hash, verify (with the proof cache and the proof side of the per-definition cache), lint (every check, alone or with others under --select, with the caches), mutate (every body mutation of the lint as a program), examples, stability, fix (the mechanical fixes and, with --induction, the induction lemma drafts the gate proves), uses (the search for a minimal #[uses] list), probe (candidate loop invariants), reads (each definition's proof key as rows), weaken (the contracts of two versions compared, and the reader's comparison), doctor, dump runtime, map (the three levels, with the caches and the window flags), query (every read query, with the caches and the window flags), import and apply (the workspace and its transactions; every command reads a workspace directory among its files), ast (the syntax tree as a JSON document), mcp (the MCP server over standard input and output, with every flag of stage0), emit-llvm and build, without or with --all-checks (ported syntax only: for the rest, writes the reasons and exits 2)")]
mod main {
    #[summary("The line apply ends with: whether the transaction was committed, the definitions whose text changed or was added and those removed")]
    #[effects(alloc)]
    fn commit_line(c: &workspace::Commit) -> String {
        let mut out: String = String::from("{\"committed\":");
        if c.ok {
            out.push_str("true");
        } else {
            out.push_str("false");
        }
        out.push_str(",\"changed\":[");
        for i in 0..c.changed.len()
            invariant 0 <= i && i <= c.changed.len(),
        {
            if i > 0 {
                out.push_str(",");
            }
            std::json::push_string(&mut out, c.changed[i].as_str());
        }
        out.push_str("],\"removed\":[");
        for j in 0..c.removed.len()
            invariant 0 <= j && j <= c.removed.len(),
        {
            if j > 0 {
                out.push_str(",");
            }
            std::json::push_string(&mut out, c.removed[j].as_str());
        }
        out.push_str("]}");
        out
    }

    #[summary("Whether a result is no error")]
    #[effects(pure)]
    fn is_ok(r: &Result<String, String>) -> bool {
        match r {
            Ok(v) => true,
            Err(e) => false,
        }
    }

    #[effects(alloc, io, nondet)]
    fn main() -> () {
        let args: Vec<String> = std::env::args();
        if args.len() > 1 && args[1] == "codes" {
            if args.len() > 2 && args[2] == "--md" {
                print_str(diag::codes_markdown().as_str());
            } else {
                print_str(diag::codes_jsonl().as_str());
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && args[2] == "tokens" {
            let files: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let r: lib::Outcome = lib::dump_tokens(files.as_slice());
            print_str(r.text.as_str());
            if !r.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && args[2] == "parse" {
            let sources: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let pr: lib::Outcome = lib::format_parsed(sources.as_slice());
            print_str(pr.text.as_str());
            if !pr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && (args[2] == "std" || args[2] == "lower" || args[2] == "decls" || args[2] == "types" || args[2] == "moves" || args[2] == "texts" || args[2] == "lowered" || args[2] == "layout" || args[2] == "smt-decls" || args[2] == "smt" || args[2] == "smt-queries") {
            let inputs: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let sr: lib::Outcome = lib::dump_stage(args[2].as_str(), inputs.as_slice(), solver::rlimit());
            print_str(sr.text.as_str());
            if !sr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "check" {
            let checked: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let cr: lib::Outcome = lib::check(checked.as_slice());
            print_str(cr.text.as_str());
            if !cr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "fmt" {
            let only_check: bool = args[2] == "--check";
            let from: usize = if only_check {
                3
            } else {
                2
            };
            let given: Vec<lib::Input> = read_files(args.as_slice(), from);
            let fr: lib::Formatted = lib::format(given.as_slice());
            if !fr.ok {
                print_str(fr.text.as_str());
                std::process::exit(1);
            }
            if !only_check {
                print_str(fr.text.as_str());
                return;
            }
            let mut normal: bool = fr.files.len() == given.len();
            for g in 0..given.len()
                invariant 0 <= g && g <= given.len(),
            {
                if g < fr.files.len() && given[g].text != fr.files[g] {
                    normal = false;
                }
            }
            if !normal {
                eprint_str("bmb: not in normal form\n");
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 1 && (args[1] == "emit-llvm" || args[1] == "build") {
            let building: bool = args[1] == "build";
            let mut pos: usize = 2;
            while pos < args.len() && args[pos] != "-o"
                invariant 2 <= pos && pos <= args.len(),
                decreases args.len() - pos,
            {
                pos = pos + 1;
            }
            if pos + 1 >= args.len() {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let out_path: String = args[pos + 1].clone();
            let mut emit_args: Vec<String> = Vec::new();
            for a in 2..args.len()
                invariant 2 <= a && a <= args.len(),
            {
                if a != pos && a != pos + 1 {
                    emit_args.push(args[a].clone());
                }
            }
            let cache_dir: Option<String> = take_value(&mut emit_args, "--cache");
            let stats: Option<String> = take_value(&mut emit_args, "--stats");
            let all_checks: bool = !building && take_flag(&mut emit_args, "--all-checks");
            let audit: bool = take_flag(&mut emit_args, "--audit");
            let units: Vec<lib::Input> = read_files(emit_args.as_slice(), 0);
            let er: lib::Emitted = lib::emit_llvm(units.as_slice(), all_checks, &cache_dir, audit);
            match &er.cache_error {
                None => {},
                Some(cache_why) => { match &cache_dir { None => {}, Some(cd) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(cd.as_str()); eprint_str(": "); eprint_str(cache_why.as_str()); eprint_str("\n"); }, } },
            }
            match &er.incr_error {
                None => {},
                Some(incr_why) => { match &cache_dir { None => {}, Some(cd2) => { eprint_str("bmb: cannot write incremental cache in "); eprint_str(cd2.as_str()); eprint_str(": "); eprint_str(incr_why.as_str()); eprint_str("\n"); }, } },
            }
            match &stats {
                None => {},
                Some(sf) => { let none: incremental::Stats = incremental::no_stats(); let line: String = match &er.incr { None => incremental::checks_line(&none, er.hits, er.misses, er.checks), Some(ist) => incremental::checks_line(ist, er.hits, er.misses, er.checks), }; write_or_exit(sf.as_str(), line.as_str()); },
            }
            print_str(er.output.as_str());
            if !er.built {
                std::process::exit(1);
            }
            if er.todo.len() > 0 {
                eprint_str("stage1: emit-llvm: not ported yet, nothing written:\n");
                for q in 0..er.todo.len()
                    invariant 0 <= q && q <= er.todo.len(),
                {
                    eprint_str("  ");
                    eprint_str(er.todo[q].as_str());
                    eprint_str("\n");
                }
                std::process::exit(2);
            }
            if !building {
                write_or_exit(out_path.as_str(), er.ir.as_str());
                if !er.ok {
                    std::process::exit(1);
                }
                return;
            }
            if !er.ok || er.checks > 0 {
                eprint_str("bmb: build refused: the program is not fully proved\n");
                std::process::exit(1);
            }
            if !er.has_main {
                eprint_str("bmb: build needs a `main`\n");
                std::process::exit(1);
            }
            match toolchain::build_executable(er.ir.as_str(), out_path.as_str()) {
                Ok(built) => {},
                Err(why) => { eprint_str("bmb: "); eprint_str(why.as_str()); eprint_str("\n"); std::process::exit(1); },
            }
            return;
        }
        if args.len() > 2 && args[1] == "verify" {
            let mut emit: Option<String> = None;
            let mut cache_dir: Option<String> = None;
            let mut stats: Option<String> = None;
            let mut bounded: bool = false;
            let mut defs: Vec<String> = Vec::new();
            let mut audit: bool = false;
            let mut at: usize = 2;
            while at < args.len()
                decreases args.len() - at,
            {
                let left: usize = args.len() - at;
                if args[at] == "--audit" && left > 1 {
                    audit = true;
                    at = at + 1;
                } else if args[at] == "--bounded-search" && left > 1 {
                    bounded = true;
                    at = at + 1;
                } else if args[at] == "--emit-smt" && left > 2 {
                    emit = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--cache" && left > 2 {
                    cache_dir = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--stats" && left > 2 {
                    stats = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--def" && left > 2 {
                    defs.push(args[at + 1].clone());
                    at = at + 2;
                } else {
                    break;
                }
            }
            let sources: Vec<lib::Input> = read_files(args.as_slice(), at);
            let only: Vec<String> = body::sorted_set(defs.as_slice());
            let reuse: bool = match &emit {
                None => true,
                Some(e0) => false,
            };
            let vr: lib::Proved = lib::verify(sources.as_slice(), &cache_dir, only.as_slice(), bounded, reuse, audit);
            match &vr.cache_error {
                None => {},
                Some(cache_why) => { match &cache_dir { None => {}, Some(cd) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(cd.as_str()); eprint_str(": "); eprint_str(cache_why.as_str()); eprint_str("\n"); }, } },
            }
            match &vr.incr_error {
                None => {},
                Some(incr_why) => { match &cache_dir { None => {}, Some(cd2) => { eprint_str("bmb: cannot write incremental cache in "); eprint_str(cd2.as_str()); eprint_str(": "); eprint_str(incr_why.as_str()); eprint_str("\n"); }, } },
            }
            if vr.missing.len() > 0 {
                eprint_str("bmb: no definition ");
                eprint_str(encode_terms::join(vr.missing.as_slice(), ", ").as_str());
                eprint_str("\n");
                std::process::exit(2);
            }
            match &emit {
                None => {},
                Some(dir) => { match std::fs::create_dir_all(dir.as_str()) { Ok(made) => {}, Err(e1) => { eprint_str("bmb: cannot create "); eprint_str(dir.as_str()); eprint_str(": "); eprint_str(e1.message.as_str()); eprint_str("\n"); std::process::exit(2); }, } for i in 0..vr.scripts.len() invariant 0 <= i && i <= vr.scripts.len(), { let cs: encode_query::Script = encode_query::canonical_script(vr.scripts[i].b.as_str()); let file: String = types::cat4(dir.as_str(), "/", encode_terms::replace(vr.scripts[i].a.as_str(), "::", ".").as_str(), ".smt2"); write_or_exit(file.as_str(), cs.text.as_str()); write_or_exit(types::cat2(file.as_str(), ".legend").as_str(), cs.legend.as_str()); } },
            }
            match &stats {
                None => {},
                Some(sf) => { let none: incremental::Stats = incremental::no_stats(); let line: String = match &vr.incr { None => incremental::stats_line(&none, vr.hits, vr.misses), Some(ist) => incremental::stats_line(ist, vr.hits, vr.misses), }; write_or_exit(sf.as_str(), line.as_str()); },
            }
            print_str(vr.output.as_str());
            if !vr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "stability" {
            let mut seeds: u64 = 5;
            let mut from: usize = 2;
            if args[2] == "--seeds" && args.len() > 4 {
                match stability::parse_seeds(args[3].as_str()) {
                    None => { eprint_str("bmb: --seeds takes a number\n"); std::process::exit(2); },
                    Some(n) => { seeds = n; },
                }
                from = 4;
            }
            let proved: Vec<lib::Input> = read_files(args.as_slice(), from);
            let st: lib::Outcome = stability::run(proved.as_slice(), seeds);
            print_str(st.text.as_str());
            if !st.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "examples" {
            let mut count: usize = 3;
            let mut at: usize = 2;
            if args.len() > 3 && args[2] == "--count" {
                match lib::parse_count(args[3].as_str()) {
                    None => { eprint_str("bmb: --count takes a number from 1 to 64\n"); std::process::exit(2); },
                    Some(k) => { count = k; },
                }
                at = 4;
            }
            let mut sep: usize = at;
            while sep < args.len() && args[sep] != "--"
                invariant at <= sep,
                decreases args.len() - sep,
            {
                sep = sep + 1;
            }
            if sep >= args.len() {
                eprint_str("bmb: put `--` between the definitions and the files\n");
                std::process::exit(2);
            }
            if sep == at || sep + 1 >= args.len() {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let mut defs: Vec<String> = Vec::new();
            for d in at..sep
                invariant at <= d && d <= sep,
            {
                defs.push(args[d].clone());
            }
            let shown: Vec<lib::Input> = read_files(args.as_slice(), sep + 1);
            let xr: lib::Outcome = lib::examples(shown.as_slice(), defs.as_slice(), count);
            print_str(xr.text.as_str());
            if !xr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "lint" {
            let mut cache_dir: Option<String> = None;
            let mut select: Vec<String> = lint::default_codes();
            let mut at: usize = 2;
            while at < args.len()
                decreases args.len() - at,
            {
                if args[at] == "--cache" && at + 1 < args.len() {
                    cache_dir = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--select" && at + 1 < args.len() {
                    select = Vec::new();
                    let known: Vec<String> = lint::codes();
                    let asked: Vec<String> = encode_terms::split(args[at + 1].as_str(), 44);
                    for c in 0..asked.len()
                        invariant 0 <= c && c <= asked.len(),
                    {
                        if !types::has(known.as_slice(), asked[c].as_str()) {
                            eprint_str("bmb: lint has no check ");
                            eprint_str(lint::debug_str(asked[c].as_str()).as_str());
                            eprint_str(" (the checks are ");
                            eprint_str(encode_terms::join(known.as_slice(), ", ").as_str());
                            eprint_str(")\n");
                            std::process::exit(2);
                        }
                        select.push(asked[c].clone());
                    }
                    at = at + 2;
                } else {
                    break;
                }
            }
            if at >= args.len() {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let linted: Vec<lib::Input> = read_files(args.as_slice(), at);
            let lr: lint::Linted = lint::run(linted.as_slice(), &cache_dir, select.as_slice());
            if lr.trap {
                eprint_str("stage1: lint: a node's position is not in its file's text\n");
                std::process::exit(101);
            }
            print_str(lr.text.as_str());
            if !lr.checked || !lr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "mutate" {
            let mut mutated: Vec<String> = Vec::new();
            let mut at: usize = 2;
            while at < args.len() && args.len() - at > 1 && args[at] == "--def"
                decreases args.len() - at,
            {
                mutated.push(args[at + 1].clone());
                at = at + 2;
            }
            if mutated.len() == 0 || at >= args.len() {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let sources: Vec<lib::Input> = read_files(args.as_slice(), at);
            let mu: mutate::Mutants = mutate::sources(sources.as_slice(), mutated.as_slice());
            if mu.trap {
                eprint_str("stage1: mutate: a node's position is not in its file's text\n");
                std::process::exit(101);
            }
            if !mu.ok {
                print_str(mu.text.as_str());
                std::process::exit(1);
            }
            for mrow in 0..mu.rows.len()
                invariant 0 <= mrow && mrow <= mu.rows.len(),
            {
                print_str(mutate::row(&mu.rows[mrow]).as_str());
            }
            let mut last: String = String::from("{\"summary\":true,\"mutants\":");
            std::num::push_u64(&mut last, mu.rows.len() as u64);
            last.push_str("}\n");
            print_str(last.as_str());
            return;
        }
        if args.len() > 2 && args[1] == "map" {
            let mut at: usize = 2;
            let mut map_cache: Option<String> = None;
            if args.len() - at >= 2 && args[at] == "--cache" {
                map_cache = Some(args[at + 1].clone());
                at = at + 2;
            }
            let wf: map::Windowed = map::window_flags(args.as_slice(), at);
            match &wf.why {
                None => {},
                Some(flag_why) => { eprint_str("bmb: "); eprint_str(flag_why.as_str()); eprint_str("\n"); std::process::exit(2); },
            }
            at = wf.next;
            if at >= args.len() {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let mut level: String = String::from("all");
            if map::is_level(args[at].as_str()) {
                level = args[at].clone();
                at = at + 1;
            }
            let mapped: Vec<lib::Input> = read_files(args.as_slice(), at);
            let mr: map::Mapped = map::run(mapped.as_slice(), level.as_str(), &map_cache);
            match &mr.cache_error {
                None => {},
                Some(map_why) => { match &map_cache { None => {}, Some(md) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(md.as_str()); eprint_str(": "); eprint_str(map_why.as_str()); eprint_str("\n"); }, } },
            }
            match &mr.incr_error {
                None => {},
                Some(map_incr_why) => { match &map_cache { None => {}, Some(md2) => { eprint_str("bmb: cannot write incremental cache in "); eprint_str(md2.as_str()); eprint_str(": "); eprint_str(map_incr_why.as_str()); eprint_str("\n"); }, } },
            }
            if !mr.ok {
                print_str(mr.text.as_str());
                std::process::exit(1);
            }
            match &wf.window {
                None => print_str(mr.text.as_str()),
                Some(w) => print_str(map::bound(mr.text.as_str(), w).as_str()),
            }
            return;
        }
        if args.len() > 3 && args[1] == "query" {
            let mut at: usize = 2;
            let mut query_cache: Option<String> = None;
            if args.len() - at >= 2 && args[at] == "--cache" {
                query_cache = Some(args[at + 1].clone());
                at = at + 2;
            }
            let wf: map::Windowed = map::window_flags(args.as_slice(), at);
            match &wf.why {
                None => {},
                Some(flag_why) => { eprint_str("bmb: "); eprint_str(flag_why.as_str()); eprint_str("\n"); std::process::exit(2); },
            }
            at = wf.next;
            let mut sep: usize = at;
            while sep < args.len() && args[sep] != "--"
                invariant at <= sep,
                decreases args.len() - sep,
            {
                sep = sep + 1;
            }
            if sep >= args.len() {
                eprint_str("bmb: put `--` between the query and the files\n");
                std::process::exit(2);
            }
            let queried: Vec<lib::Input> = read_files(args.as_slice(), sep + 1);
            let mut req: Vec<String> = Vec::new();
            for q in at..sep
                invariant at <= q && q <= sep,
            {
                req.push(args[q].clone());
            }
            let qr: query::Answer = query::run(queried.as_slice(), req.as_slice(), &query_cache);
            match &qr.cache_error {
                None => {},
                Some(query_why) => { match &query_cache { None => {}, Some(qd) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(qd.as_str()); eprint_str(": "); eprint_str(query_why.as_str()); eprint_str("\n"); }, } },
            }
            match &qr.incr_error {
                None => {},
                Some(query_incr_why) => { match &query_cache { None => {}, Some(qd2) => { eprint_str("bmb: cannot write incremental cache in "); eprint_str(qd2.as_str()); eprint_str(": "); eprint_str(query_incr_why.as_str()); eprint_str("\n"); }, } },
            }
            if qr.kind == 1 {
                print_str(qr.text.as_str());
                std::process::exit(1);
            }
            if qr.kind == 2 {
                eprint_str("bmb: ");
                eprint_str(qr.text.as_str());
                eprint_str("\n");
                std::process::exit(1);
            }
            match &wf.window {
                None => print_str(qr.text.as_str()),
                Some(w) => print_str(map::bound(qr.text.as_str(), w).as_str()),
            }
            return;
        }
        if args.len() == 4 && args[1] == "apply" {
            let mut ops_text: String = String::new();
            if args[3] == "-" {
                let mut input: Vec<u8> = Vec::new();
                let mut read: bool = true;
                match std::io::read_to_end(&mut input) {
                    Ok(got) => {},
                    Err(e_in) => { read = false; },
                }
                match String::from_utf8(input) {
                    Ok(text_in) => { ops_text = text_in; },
                    Err(not_text) => { read = false; },
                }
                if !read {
                    eprint_str("bmb: cannot read stdin\n");
                    std::process::exit(2);
                }
            } else {
                match std::fs::read_to_string(args[3].as_str()) {
                    Ok(text_of) => { ops_text = text_of; },
                    Err(e_ops) => { eprint_str("bmb: cannot read "); eprint_str(args[3].as_str()); eprint_str(": "); eprint_str(e_ops.message.as_str()); eprint_str("\n"); std::process::exit(2); },
                }
            }
            let ops: Vec<workspace::Op> = match workspace::parse_ops(ops_text.as_str()) {
                Ok(read_ops) => read_ops,
                Err(ops_why) => { eprint_str("bmb: "); eprint_str(ops_why.as_str()); eprint_str("\n"); std::process::exit(2); },
            };
            match workspace::commit(args[2].as_str(), ops.as_slice()) {
                Ok(tx) => { print_str(tx.diagnostics.as_str()); print_str(commit_line(&tx).as_str()); print_str("\n"); if !tx.ok { std::process::exit(1); } },
                Err(commit_why) => { eprint_str("bmb: "); eprint_str(commit_why.as_str()); eprint_str("\n"); std::process::exit(2); },
            }
            return;
        }
        if args.len() > 3 && args[1] == "import" {
            let imported: Vec<lib::Input> = read_files(args.as_slice(), 3);
            match workspace::normal_units(imported.as_slice()) {
                Ok(import_units) => { match workspace::write_units(args[2].as_str(), import_units.as_slice()) { Ok(import_done) => {}, Err(import_why) => { eprint_str("bmb: "); eprint_str(import_why.as_str()); eprint_str("\n"); std::process::exit(2); }, } },
                Err(import_diags) => { print_str(import_diags.as_str()); std::process::exit(1); },
            }
            return;
        }
        if args.len() > 2 && args[1] == "ast" {
            let ast_files: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let parsed: workspace::Parsed = workspace::parse_files(ast_files.as_slice());
            if parsed.diags.has_errors() {
                print_str(parsed.diags.to_jsonl(&parsed.sm).as_str());
                std::process::exit(1);
            }
            match ast_json::export(&parsed.program) {
                Ok(doc) => { print_str(json::to_json(&doc).as_str()); print_str("\n"); },
                Err(ast_why) => { eprint_str("bmb: "); eprint_str(ast_why.as_str()); eprint_str("\n"); std::process::exit(1); },
            }
            return;
        }
        if args.len() > 2 && args[1] == "mcp" {
            let known: Vec<String> = mcp::flag_names();
            let mut flags: Vec<String> = Vec::new();
            let mut all_known: bool = true;
            for g in 2..args.len() - 1
                invariant 2 <= g,
            {
                if g < args.len() {
                    if !types::has(known.as_slice(), args[g].as_str()) {
                        all_known = false;
                    }
                    flags.push(args[g].clone());
                }
            }
            if all_known {
                match mcp::serve(args[args.len() - 1].as_str(), flags.as_slice()) {
                    Ok(served) => {},
                    Err(serve_why) => { eprint_str("bmb: "); eprint_str(serve_why.as_str()); eprint_str("\n"); std::process::exit(2); },
                }
                return;
            }
        }
        if args.len() > 1 && args[1] == "doctor" {
            let z3: Result<String, String> = toolchain::check_z3_uncached();
            let llvm: Result<String, String> = toolchain::check_llvm();
            print_str(lib::tool_row("z3", toolchain::z3_version().as_str(), &z3).as_str());
            print_str(lib::tool_row("llvm", toolchain::llvm_major().as_str(), &llvm).as_str());
            if !is_ok(&z3) || !is_ok(&llvm) {
                std::process::exit(1);
            }
            return;
        }
        if args.len() == 3 && args[1] == "dump" && args[2] == "runtime" {
            print_str(lib::dump_runtime().as_str());
            return;
        }
        if args.len() > 2 && args[1] == "reads" {
            let keyed: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let rr: lib::Outcome = lib::reads(keyed.as_slice());
            print_str(rr.text.as_str());
            if !rr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "uses" {
            let mut write: bool = false;
            let mut uses_cache: Option<String> = None;
            let mut at: usize = 2;
            while at < args.len()
                decreases args.len() - at,
            {
                if args[at] == "--write" {
                    write = true;
                    at = at + 1;
                } else if args[at] == "--cache" && args.len() - at > 2 {
                    uses_cache = Some(args[at + 1].clone());
                    at = at + 2;
                } else {
                    break;
                }
            }
            if at >= args.len() {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let searched: Vec<lib::Input> = read_files(args.as_slice(), at);
            match uses_fill::fill_uses_limited(searched.as_slice(), &uses_cache, 32, false) {
                Ok(filled) => { print_str(lib::with_written(uses_fill::report(&filled, searched.as_slice()).as_str(), write).as_str()); if write { write_changed(searched.as_slice(), filled.files.as_slice()); } if !uses_fill::ok(&filled) { std::process::exit(1); } },
                Err(uses_diags) => { print_str(uses_diags.as_str()); std::process::exit(1); },
            }
            return;
        }
        if args.len() > 2 && args[1] == "probe" {
            let mut probed: Option<String> = None;
            let mut loop_at: usize = 0;
            let mut cands: Vec<String> = Vec::new();
            let mut at: usize = 2;
            while at < args.len() && args.len() - at >= 2
                decreases args.len() - at,
            {
                if args[at] == "--def" {
                    probed = Some(args[at + 1].clone());
                } else if args[at] == "--loop" {
                    match map::parse_usize(args[at + 1].as_str()) {
                        None => { eprint_str(usage().as_str()); std::process::exit(2); },
                        Some(k) => { loop_at = k; },
                    }
                } else if args[at] == "--candidate" {
                    cands.push(args[at + 1].clone());
                } else {
                    break;
                }
                at = at + 2;
            }
            let probe_def: String = match probed {
                None => { eprint_str(usage().as_str()); std::process::exit(2); },
                Some(pd) => pd,
            };
            if at >= args.len() || cands.len() == 0 {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let sources: Vec<lib::Input> = read_files(args.as_slice(), at);
            match probe::probe(sources.as_slice(), probe_def.as_str(), loop_at, cands.as_slice(), false) {
                Ok(answer) => print_str(answer.as_str()),
                Err(probe_why) => { print_str(probe_why.as_str()); print_str("\n"); std::process::exit(1); },
            }
            return;
        }
        if args.len() > 2 && args[1] == "fix" {
            let mut write: bool = false;
            let mut print_text: bool = false;
            let mut confirm: bool = false;
            let mut induction: bool = false;
            let mut at: usize = 2;
            while at < args.len()
                decreases args.len() - at,
            {
                if args[at] == "--write" {
                    write = true;
                } else if args[at] == "--print" {
                    print_text = true;
                } else if args[at] == "--confirm" {
                    confirm = true;
                } else if args[at] == "--induction" {
                    induction = true;
                } else {
                    break;
                }
                at = at + 1;
            }
            if at >= args.len() || write && print_text {
                eprint_str(usage().as_str());
                std::process::exit(2);
            }
            let broken: Vec<lib::Input> = read_files(args.as_slice(), at);
            let fixed: fix::Output = fix::run(broken.as_slice(), confirm, induction);
            if fixed.trap {
                eprint_str("stage1: fix: a position is not in its file's text\n");
                std::process::exit(101);
            }
            if print_text {
                for t in 0..fixed.files.len()
                    invariant 0 <= t && t <= fixed.files.len(),
                {
                    if t > 0 {
                        print_str("\n");
                    }
                    print_str(fixed.files[t].text.as_str());
                }
            } else {
                print_str(lib::with_written(fix::report(&fixed, broken.as_slice()).as_str(), write).as_str());
            }
            if write {
                write_changed(broken.as_slice(), fixed.files.as_slice());
            }
            if !fixed.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() == 4 && args[1] == "weaken" || args.len() == 6 && args[1] == "weaken" && args[2] == "--readers" {
            let mut readers: Option<Vec<weaken::Reader>> = None;
            let mut first: usize = 2;
            if args.len() == 6 {
                first = 4;
                let listed: String = match std::fs::read_to_string(args[3].as_str()) {
                    Ok(readers_text) => readers_text,
                    Err(e_readers) => { eprint_str("bmb: cannot read "); eprint_str(args[3].as_str()); eprint_str(": "); eprint_str(e_readers.message.as_str()); eprint_str("\n"); std::process::exit(2); },
                };
                match weaken::parse_readers(listed.as_str()) {
                    Ok(parsed_readers) => { readers = Some(parsed_readers); },
                    Err(readers_why) => { eprint_str("bmb: "); eprint_str(readers_why.as_str()); eprint_str("\n"); std::process::exit(2); },
                }
            }
            let before: Option<Vec<lib::Input>> = read_one(args[first].as_str());
            let after: Option<Vec<lib::Input>> = read_one(args[first + 1].as_str());
            let old_files: Vec<lib::Input> = match before {
                None => { std::process::exit(2); },
                Some(of) => of,
            };
            let new_files: Vec<lib::Input> = match after {
                None => { std::process::exit(2); },
                Some(nf) => nf,
            };
            match weaken::compare(old_files.as_slice(), new_files.as_slice(), &readers) {
                Ok(compared) => { print_str(weaken::report(&compared).as_str()); if !weaken::ok(&compared) { std::process::exit(1); } },
                Err(weaken_diags) => { print_str(weaken_diags.as_str()); std::process::exit(1); },
            }
            return;
        }
        if args.len() > 2 && args[1] == "hash" {
            let hashed: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let hr: lib::Outcome = lib::hash(hashed.as_slice());
            print_str(hr.text.as_str());
            if !hr.ok {
                std::process::exit(1);
            }
            return;
        }
        eprint_str(usage().as_str());
        std::process::exit(2);
    }

    #[summary("Reads the files of the arguments; a directory among them is read as a workspace (the .bmb files of its src/, or its own, in name order). If one cannot be read, writes that with the system's reason to standard error and exit code 2")]
    #[effects(alloc, io, nondet)]
    fn read_files(args: &[String], from: usize) -> Vec<lib::Input> {
        let mut files: Vec<lib::Input> = Vec::new();
        let mut i: usize = from;
        while i < args.len()
            decreases args.len() - i,
        {
            if workspace::is_dir(args[i].as_str()) {
                match workspace::read_dir_sources(args[i].as_str()) {
                    Ok(found) => { for j in 0..found.len() invariant 0 <= j && j <= found.len(), { files.push(found[j].clone()); } },
                    Err(why) => { eprint_str("bmb: "); eprint_str(why.as_str()); eprint_str("\n"); std::process::exit(2); },
                }
            } else {
                match std::fs::read_to_string(args[i].as_str()) {
                    Ok(text) => files.push(lib::Input { name: args[i].clone(), text: text }),
                    Err(e) => { eprint_str("bmb: cannot read "); eprint_str(args[i].as_str()); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); std::process::exit(2); },
                }
            }
            i = i + 1;
        }
        files
    }

    #[summary("Reads one argument as read_files reads it, a file or a workspace directory. If it cannot be read, writes that to standard error and gives nothing (stage0's weaken reads both versions before it ends for either)")]
    #[effects(alloc, io, nondet)]
    fn read_one(path: &str) -> Option<Vec<lib::Input>> {
        let mut files: Vec<lib::Input> = Vec::new();
        if workspace::is_dir(path) {
            match workspace::read_dir_sources(path) {
                Ok(found) => { for j in 0..found.len() invariant 0 <= j && j <= found.len(), { files.push(found[j].clone()); } },
                Err(why) => { eprint_str("bmb: "); eprint_str(why.as_str()); eprint_str("\n"); return None; },
            }
        } else {
            match std::fs::read_to_string(path) {
                Ok(text) => files.push(lib::Input { name: String::from(path), text: text }),
                Err(e) => { eprint_str("bmb: cannot read "); eprint_str(path); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); return None; },
            }
        }
        Some(files)
    }

    #[summary("Removes the first argument that is flag and gives whether there was one (stage0's position and remove)")]
    #[effects(alloc)]
    fn take_flag(args: &mut Vec<String>, flag: &str) -> bool {
        let mut out: Vec<String> = Vec::new();
        let mut found: bool = false;
        for i in 0..args.len()
            invariant 0 <= i && i <= args.len(),
        {
            if !found && args[i] == flag {
                found = true;
            } else {
                out.push(args[i].clone());
            }
        }
        *args = out;
        found
    }

    #[summary("Removes the first argument that is flag and the argument after it, and gives that one, when flag is not the last argument (stage0's position, `c + 1 < len` and remove); otherwise leaves the arguments as they are")]
    #[effects(alloc)]
    fn take_value(args: &mut Vec<String>, flag: &str) -> Option<String> {
        let mut at: usize = 0;
        while at < args.len() && args[at] != flag
            invariant at <= args.len(),
            decreases args.len() - at,
        {
            at = at + 1;
        }
        if at + 1 >= args.len() {
            return None;
        }
        let value: String = args[at + 1].clone();
        let mut out: Vec<String> = Vec::new();
        for i in 0..args.len()
            invariant 0 <= i && i <= args.len(),
        {
            if i != at && i != at + 1 {
                out.push(args[i].clone());
            }
        }
        *args = out;
        Some(value)
    }

    #[summary("The usage text of the command line with its line end (stage0 USAGE as eprintln writes it)")]
    #[effects(alloc)]
    fn usage() -> String {
        String::from("usage:\n  bmb check <file.bmb>...   check sources; diagnostics as JSONL on stdout\n  bmb verify [--emit-smt DIR] [--cache DIR] [--stats FILE] [--audit] [--bounded-search] [--def PATH]... <file.bmb>...\n                            check and prove; diagnostics and per-definition status as JSONL;\n                            --def proves only the named definitions (the whole program is\n                            still checked; each gets its whole-program status);\n                            --cache keeps proved obligations in DIR and skips them next time,\n                            and reuses unchanged definitions without encoding them;\n                            --stats writes what the caches did as one JSON line to FILE\n                            (definitions encoded, reused, lowered, IR reused, proof cache\n                            hits and misses, damaged cache lines; emit-llvm and build take\n                            it too, and add the runtime checks the IR keeps);\n                            --audit proves each definition the cache would reuse anyway and\n                            compares (script as the solver receives it, status, proved\n                            obligations); --stats then lists the differences (audit_mismatches);\n                            --bounded-search asks each undecided obligation once more with the\n                            inputs bounded (|integers| <= 8, lengths <= 4, ADR-0108): a model is\n                            a counterexample, none is the E0811 field `bounded`\n  bmb stability [--seeds N] <file.bmb>...\n                            prove under solver seeds 0..N (default 5); per-definition verdicts\n                            and rlimit as JSONL; fails if a verdict depends on the seed\n  bmb emit-llvm [--cache DIR] [--stats FILE] [--audit] [--all-checks] <file.bmb>... -o OUT.ll\n                            LLVM IR; unproved obligations keep runtime checks;\n                            --all-checks skips the proof and keeps every check;\n                            --audit as for verify, also for the IR the cache would reuse\n  bmb build [--cache DIR] [--stats FILE] [--audit] <file.bmb>... -o OUT\n                            check, prove (all obligations) and build an executable\n  bmb fmt [--check] <file.bmb>...\n                            print the normal form (ADR-0019); --check fails unless each file\n                            is the normal form of the units it declares\n  bmb fix [--write|--print] [--confirm] [--induction] <file.bmb>...\n                            apply mechanical fixes (diagnostic replacements, and on a program\n                            that checks the canonical `for` of counting `while` loops, W0907,\n                            and the hash of each `#[rationale(..)]` that carries none;\n                            --confirm also rewrites the hashes that are no longer current, W1001)\n                            and re-check until none applies; JSONL report of applied fixes,\n                            remaining diagnostics\n                            and a summary; --write rewrites changed files in place, --print\n                            prints the fixed text instead of the report; fails if errors remain;\n                            --induction also runs the prover: for a function it does not\n                            prove, the `proof fn` from a recursive predicate to a predicate\n                            of the same parameters that a postcondition reaches, and its\n                            call, written only when the gate proves both (ADR-0135)\n  bmb uses [--write] [--cache DIR] <file.bmb>...\n                            for each definition that fails to prove, find a minimal #[uses(..)]\n                            list from its current entries and the hidden predicates its\n                            diagnostics name; JSONL row per definition (status proved, unchanged\n                            or not_found, with the attribute replacement) and a summary;\n                            --write rewrites changed files; fails if a definition stays unproved;\n                            --cache uses and updates the caches in DIR as `verify --cache` does\n  bmb lint [--cache DIR] [--select CODES] <file.bmb>...\n                            contract lint (warnings W09xx as JSONL, then a summary): preconditions\n                            that cannot hold together, preconditions the function's proof does\n                            not need, postconditions no caller's proof uses, body mutations the\n                            specification does not distinguish; re-verifications and mutants are\n                            capped; the summary also gives the rlimit and undecided count of the\n                            W0901 and W0905 satisfiability checks; fails only if the program does\n                            not check or the gate cannot run; --cache uses and updates the caches\n                            in DIR as `verify --cache` does; --select W0901,W0905 runs only the\n                            listed checks; W0918 (postconditions that allow two results for one\n                            input, with the witness) runs only when --select names it\n  bmb probe --def PATH [--loop K] --candidate EXPR [--candidate EXPR].. <file.bmb>...\n                            candidate invariants for loop K (from 0, source order) of PATH,\n                            tried without changing the files (ADR-0109): per candidate its first\n                            answer on entry and kept by the body, then the largest subset that\n                            is inductive together (Houdini) and whether PATH proves with it\n  bmb examples [--count N] DEF.. -- <file.bmb>...\n                            examples of each named function's contract, from `requires` and\n                            `ensures` alone (the body is not read, the program is checked, not\n                            proved), as JSONL in a fixed order: per input (N of them, default 3,\n                            each different from the earlier ones, small values first) a row\n                            `allowed` (input and a result the contract allows), a second\n                            `allowed` row when it allows another result for that input, and a\n                            row `rejected` (a result it rejects for that input); then `rejected`\n                            rows at other inputs while fewer than N are shown, then up to N rows\n                            `excluded` (inputs `requires` rejects), then a summary row (rows per\n                            kind, undecided queries, rlimit); `after` holds the values behind\n                            `&mut` parameters; values are models of the gate's encoding, printed\n                            as counterexamples are, lengths at most 4; a query that is not\n                            decided by the solver is asked again at written small inputs, and\n                            if still not decided shows nothing and is counted; the spec fns\n                            a contract names are read by their definitions, in `#[uses]` or\n                            not; a definition whose values cannot be shown in full gets only\n                            a summary row with `reason`\n  bmb mutate --def PATH [--def PATH].. <file.bmb>...\n                            every W0904 body mutation of the named functions, unproved, as\n                            JSONL rows with the changed unit's normal form, then a summary\n  bmb weaken OLD NEW        compare the contracts of two versions (each a file or a workspace):\n                            per definition same, refined, compatible, weakened, undecided,\n                            signature, added or removed, by SMT implication with counterexamples;\n                            W0908 for each weakened contract, then a summary; fails if a\n                            contract got weaker or a comparison was not decided\n  bmb weaken --readers FILE OLD NEW\n                            the same comparison for each reader in FILE (JSONL lines\n                            {\"def\",\"uses\"}), revealing only the spec fns that reader reveals,\n                            forward direction only; one row per reader, in order\n  bmb reads <file.bmb>...   each definition's proof key as rows (the read set of its proof:\n                            own text, callee contracts, revealed spec fns, declarations, types)\n                            and each type's digest, as JSONL\n  bmb hash <file.bmb>...    nameless identities and hashes (id, body, iface) as JSONL\n  bmb map [--cache DIR] [--budget BYTES] [--offset ROWS] [--limit ROWS] [L0|L1|L2|all] <file.bmb>...\n                            standard maps as JSONL (ADR-0020); the window flags as for query\n  bmb query [--cache DIR] [--budget BYTES] [--offset ROWS] [--limit ROWS]\n            <units|overview|surface|edges|slice|find|contracts|status|impact|duplicates|effects|effect|tests|text> [args] -- <file.bmb>...\n                            read queries as JSONL (ADR-0020); --cache as for verify (only\n                            the L1 rows, `surface` and `status` prove);\n                            units, status, duplicates, effects, effect E and tests take paths\n                            (units, definitions, types) and answer for what those hold alone\n                            (status and tests then prove only that; duplicates: the groups a\n                            named definition is in; effects with one definition: what it\n                            reaches); edges DEF [out|in|both] [DEPTH] [KIND,..] follows only\n                            the edges of the listed kinds (calls, contract, uses, writes ..);\n                            text PATTERN [PATH..] lists the lines of the normal form that\n                            hold PATTERN as written (path, line, the text around it; ADR-0146);\n                            overview [PATH..] lists units with counts in place of their\n                            definitions; --budget, --offset and --limit print a window of\n                            the response (ADR-0127): the rows from the offset, whole rows\n                            within the budget, and a last `truncated` row (rows shown, rows\n                            and bytes of the whole response, `next`) when rows are left out\n  bmb import DIR <file.bmb>...\n                            create or replace workspace DIR from files, in normal form\n  bmb apply DIR OPS.json    commit a transaction (JSON array of unit/put/remove/remove_unit/\n                            rename/expect/move ops)\n                            to workspace DIR; rejected as a whole on any structural or type error\n  bmb mcp [--write-tool] [--compact] [--tool-docs] [--file-tools] [--ast-tools] [--item-docs] [--stats] [--bounded|--bounded-16k] [--rename-ops] DIR\n                            MCP server (stdio) for workspace DIR: query, map, verify, build, tx_*;\n                            --write-tool also offers `write` (unit, definitions, removals,\n                            commit and proof in one call); --compact shows results in the\n                            compact agent view (surfaces as Rust-shaped text without hashes\n                            or positions, verified definitions as a count); --tool-docs gives\n                            tool descriptions that document the tools on their own (what\n                            each query returns, `write` as the only way to write);\n                            --file-tools offers `read_file` and `edit_file` (a unified diff,\n                            committed and proved in one call); --ast-tools offers `read_ast`\n                            and `edit_ast` (a JSON Patch on the JSON syntax tree, committed and\n                            proved in one call) and gives positions as pointers into the tree;\n                            --bounded gives `query` and `map` results as windows of at most\n                            32768 bytes with `offset` and `limit` arguments (ADR-0127);\n                            --bounded-16k is the same at 16384 bytes (the default is\n                            measured); --rename-ops offers `tx_rename` and\n                            `tx_expect`, and `rename` and `expect` lists in `write` (checked\n                            and applied before the items; a write may only rename)\n  bmb ast <file.bmb>...     the syntax tree as one JSON document (the JSON AST edit surface's,\n                            keyed by unit; positions are not part of it)\n  bmb dump tokens <file.bmb>...\n                            the lexer's tokens as JSONL (file, span, kind, normal text, value)\n  bmb dump parse <file.bmb>...\n                            the parsed program in normal form, before any check\n  bmb dump std|lower|decls <file.bmb>...\n                            the stages before the checker's bodies: diagnostics so far, `---`,\n                            then the program with the library units it names (std), after\n                            function values and constants are lowered (lower, with the names\n                            made and each constant's value), or the declarations the checker\n                            collects as JSONL (decls)\n  bmb dump types|moves <file.bmb>...\n                            what the checker's bodies compute: diagnostics, `---`, then the\n                            resolved program and per definition its locals, the type of every\n                            expression, type arguments, call edges, effects and recursion\n                            (types), or where each function drops its owned values (moves)\n  bmb dump texts <file.bmb>...\n                            the qualified texts the incremental keys read, when the program\n                            checks: per definition its qualified normal form and the surface\n                            a caller reads, then every item's qualified hash\n  bmb dump lowered <file.bmb>...\n                            the tables the code generator reads (text as bytes, a `char` as\n                            a `u32`): signatures, data types, locals, the type of every\n                            expression, the spans that are text, and each type's fields or\n                            variants\n  bmb dump layout <file.bmb>...\n                            how the code generator lays the types out, when the program\n                            checks: each type's LLVM types, size and alignment, what the\n                            module's head depends on, and the LLVM type definitions\n  bmb dump smt-decls <file.bmb>...\n                            what the proof encoder derives before it reads a body, when the\n                            program checks, with no solver: the spec fn instances, each\n                            function's sorts and SMT functions, the datatype declarations,\n                            which values are text, and each definition's default context\n  bmb dump smt <file.bmb>...\n                            what the proof encoder builds of each definition, when the\n                            program checks, with no solver: the declarations of spec fns,\n                            each definition's proof context and what it reveals, a spec fn's\n                            definition as the queries take it and its termination obligations\n  bmb dump smt-queries <file.bmb>...\n                            what `verify --emit-smt` writes of each definition before the\n                            solver's first answer, with no solver: its script and legend,\n                            then every form its reach points may be asked in\n  bmb dump runtime          the code generator's constant IR texts by name, as JSONL\n  bmb codes [--md]          list diagnostic codes as JSONL (or the Markdown reference page)\n\nAny <file.bmb> argument may also be a workspace directory (its src/*.bmb).\n  bmb doctor                check the pinned toolchain (z3, LLVM) as JSONL\n")
    }

    #[summary("Writes each file of fixed whose text differs from the one read, in input order (the --write of stage0's fix and uses). If one cannot be written, writes that to standard error and exit code 2")]
    #[effects(alloc, io)]
    fn write_changed(original: &[lib::Input], fixed: &[lib::Input]) -> () {
        for i in 0..fixed.len()
            invariant 0 <= i && i <= fixed.len(),
        {
            if i < original.len() && fixed[i].text != original[i].text {
                write_or_exit(fixed[i].name.as_str(), fixed[i].text.as_str());
            }
        }
    }

    #[summary("Writes text to the file path. If it cannot be written, writes to standard error and exit code 2")]
    #[effects(alloc, io)]
    fn write_or_exit(path: &str, text: &str) -> () {
        match std::fs::write(path, text.as_bytes()) {
            Ok(done) => {},
            Err(e) => { eprint_str("bmb: cannot write "); eprint_str(path); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); std::process::exit(2); },
        }
    }
}
