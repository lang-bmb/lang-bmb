#[summary("Driver of the compiler written in BMB (port of stage0 compiler/src/main.rs). Commands grow with each phase: for now codes, dump tokens, dump parse, dump std, dump lower, dump decls, dump types, dump moves, dump texts, dump lowered, dump layout, dump smt-decls, dump smt, dump smt-queries, check, fmt, hash, verify (without the per-definition cache: --cache needs --emit-smt), emit-llvm --all-checks (ported syntax only: for the rest, writes the reasons and exits 2)")]
mod main {
    #[effects(alloc, io, nondet)]
    fn main() -> () {
        let args: Vec<String> = std::env::args();
        if args.len() > 1 && args[1] == "codes" {
            if args.len() > 2 && args[2] == "--md" {
                print_str(diag::codes_markdown().as_str());
            } else {
                print_str(diag::codes_jsonl().as_str());
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && args[2] == "tokens" {
            let files: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let r: lib::Outcome = lib::dump_tokens(files.as_slice());
            print_str(r.text.as_str());
            if !r.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && args[2] == "parse" {
            let sources: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let pr: lib::Outcome = lib::format_parsed(sources.as_slice());
            print_str(pr.text.as_str());
            if !pr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 3 && args[1] == "dump" && (args[2] == "std" || args[2] == "lower" || args[2] == "decls" || args[2] == "types" || args[2] == "moves" || args[2] == "texts" || args[2] == "lowered" || args[2] == "layout" || args[2] == "smt-decls" || args[2] == "smt" || args[2] == "smt-queries") {
            let inputs: Vec<lib::Input> = read_files(args.as_slice(), 3);
            let sr: lib::Outcome = lib::dump_stage(args[2].as_str(), inputs.as_slice(), solver::rlimit());
            print_str(sr.text.as_str());
            if !sr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "check" {
            let checked: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let cr: lib::Outcome = lib::check(checked.as_slice());
            print_str(cr.text.as_str());
            if !cr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "fmt" {
            let only_check: bool = args[2] == "--check";
            let from: usize = if only_check {
                3
            } else {
                2
            };
            let given: Vec<lib::Input> = read_files(args.as_slice(), from);
            let fr: lib::Outcome = lib::format(given.as_slice());
            if !fr.ok {
                print_str(fr.text.as_str());
                std::process::exit(1);
            }
            if !only_check {
                print_str(fr.text.as_str());
                return;
            }
            let mut written: String = String::new();
            let mut g: usize = 0;
            while g < given.len()
                decreases given.len() - g,
            {
                if g > 0 {
                    written.push_str("\n");
                }
                written.push_str(given[g].text.as_str());
                g = g + 1;
            }
            if written != fr.text {
                eprint_str("bmb: not in normal form\n");
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 1 && args[1] == "emit-llvm" {
            let mut srcs: Vec<String> = Vec::new();
            let mut ir_path: Option<String> = None;
            let mut all_checks: bool = false;
            let mut a: usize = 2;
            while a < args.len()
                decreases args.len() - a,
            {
                if args[a] == "-o" && a + 1 < args.len() {
                    ir_path = Some(args[a + 1].clone());
                    a = a + 2;
                } else {
                    if args[a] == "--all-checks" {
                        all_checks = true;
                    } else {
                        srcs.push(args[a].clone());
                    }
                    a = a + 1;
                }
            }
            match ir_path {
                None => {},
                Some(to) => { if all_checks && srcs.len() > 0 { let units: Vec<lib::Input> = read_files(srcs.as_slice(), 0); let er: lib::Emitted = lib::emit_llvm(units.as_slice()); print_str(er.diags.as_str()); if !er.ok { std::process::exit(1); } if er.todo.len() > 0 { eprint_str("stage1: emit-llvm: not ported yet, nothing written:\n"); for q in 0..er.todo.len() invariant 0 <= q && q <= er.todo.len(), { eprint_str("  "); eprint_str(er.todo[q].as_str()); eprint_str("\n"); } std::process::exit(2); } match std::fs::write(to.as_str(), er.ir.as_bytes()) { Ok(done) => {}, Err(why) => { eprint_str("bmb: cannot write "); eprint_str(to.as_str()); eprint_str("\n"); std::process::exit(2); }, } return; } },
            }
            eprint_str("usage: stage1 emit-llvm --all-checks FILE.. -o OUT.ll\n");
            std::process::exit(2);
        }
        if args.len() > 2 && args[1] == "verify" {
            let mut emit: Option<String> = None;
            let mut cache_dir: Option<String> = None;
            let mut stats: Option<String> = None;
            let mut bounded: bool = false;
            let mut defs: Vec<String> = Vec::new();
            let mut at: usize = 2;
            while at < args.len()
                decreases args.len() - at,
            {
                let left: usize = args.len() - at;
                if args[at] == "--audit" && left > 1 {
                    at = at + 1;
                } else if args[at] == "--bounded-search" && left > 1 {
                    bounded = true;
                    at = at + 1;
                } else if args[at] == "--emit-smt" && left > 2 {
                    emit = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--cache" && left > 2 {
                    cache_dir = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--stats" && left > 2 {
                    stats = Some(args[at + 1].clone());
                    at = at + 2;
                } else if args[at] == "--def" && left > 2 {
                    defs.push(args[at + 1].clone());
                    at = at + 2;
                } else {
                    break;
                }
            }
            if per_definition(&cache_dir, &emit) {
                eprint_str("stage1: verify --cache without --emit-smt: the per-definition cache is not ported yet\n");
                std::process::exit(2);
            }
            let sources: Vec<lib::Input> = read_files(args.as_slice(), at);
            let only: Vec<String> = body::sorted_set(defs.as_slice());
            let vr: lib::Proved = lib::verify(sources.as_slice(), &cache_dir, only.as_slice(), bounded);
            match &vr.cache_error {
                None => {},
                Some(cache_why) => { match &cache_dir { None => {}, Some(cd) => { eprint_str("bmb: cannot write proof cache in "); eprint_str(cd.as_str()); eprint_str(": "); eprint_str(cache_why.as_str()); eprint_str("\n"); }, } },
            }
            if vr.missing.len() > 0 {
                eprint_str("bmb: no definition ");
                eprint_str(encode_terms::join(vr.missing.as_slice(), ", ").as_str());
                eprint_str("\n");
                std::process::exit(2);
            }
            match &emit {
                None => {},
                Some(dir) => { match std::fs::create_dir_all(dir.as_str()) { Ok(made) => {}, Err(e1) => { eprint_str("bmb: cannot create "); eprint_str(dir.as_str()); eprint_str(": "); eprint_str(e1.message.as_str()); eprint_str("\n"); std::process::exit(2); }, } for i in 0..vr.scripts.len() invariant 0 <= i && i <= vr.scripts.len(), { let cs: encode_query::Script = encode_query::canonical_script(vr.scripts[i].b.as_str()); let file: String = types::cat4(dir.as_str(), "/", encode_terms::replace(vr.scripts[i].a.as_str(), "::", ".").as_str(), ".smt2"); write_or_exit(file.as_str(), cs.text.as_str()); write_or_exit(types::cat2(file.as_str(), ".legend").as_str(), cs.legend.as_str()); } },
            }
            match &stats {
                None => {},
                Some(sf) => { let mut line: String = String::from("{\"encoded\":[],\"reused\":[],\"lowered\":[],\"ir_reused\":[],\"proof_cache_hits\":"); std::num::push_u64(&mut line, vr.hits as u64); line.push_str(",\"proof_cache_misses\":"); std::num::push_u64(&mut line, vr.misses as u64); line.push_str(",\"audit_mismatches\":[],\"damaged\":0}\n"); write_or_exit(sf.as_str(), line.as_str()); },
            }
            print_str(vr.output.as_str());
            if !vr.ok {
                std::process::exit(1);
            }
            return;
        }
        if args.len() > 2 && args[1] == "hash" {
            let hashed: Vec<lib::Input> = read_files(args.as_slice(), 2);
            let hr: lib::Outcome = lib::hash(hashed.as_slice());
            print_str(hr.text.as_str());
            if !hr.ok {
                std::process::exit(1);
            }
            return;
        }
        eprint_str("usage: stage1 codes [--md] | dump tokens FILE.. | dump parse FILE.. | dump std FILE.. | dump lower FILE.. | dump decls FILE.. | dump types FILE.. | dump moves FILE.. | dump texts FILE.. | dump lowered FILE.. | dump layout FILE.. | dump smt-decls FILE.. | dump smt FILE.. | dump smt-queries FILE.. | check FILE.. | fmt [--check] FILE.. | hash FILE.. | verify [--emit-smt DIR] [--cache DIR] [--stats FILE] [--audit] [--bounded-search] [--def PATH].. FILE.. | emit-llvm --all-checks FILE.. -o OUT.ll\n");
        std::process::exit(2);
    }

    #[summary("Whether a run of verify would use the per-definition cache (stage0 incremental.rs), which is not ported: with a cache directory and without --emit-smt, which encodes every definition")]
    #[effects(pure)]
    fn per_definition(cache_dir: &Option<String>, emit: &Option<String>) -> bool {
        match cache_dir {
            None => false,
            Some(dir) => match emit { None => true, Some(to) => false, },
        }
    }

    #[summary("Reads the files of the arguments. If one cannot be read, writes that with the system's reason to standard error and exit code 2")]
    #[effects(alloc, io, nondet)]
    fn read_files(args: &[String], from: usize) -> Vec<lib::Input> {
        let mut files: Vec<lib::Input> = Vec::new();
        let mut i: usize = from;
        while i < args.len()
            decreases args.len() - i,
        {
            match std::fs::read_to_string(args[i].as_str()) {
                Ok(text) => files.push(lib::Input { name: args[i].clone(), text: text }),
                Err(e) => { eprint_str("bmb: cannot read "); eprint_str(args[i].as_str()); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); std::process::exit(2); },
            }
            i = i + 1;
        }
        files
    }

    #[summary("Writes text to the file path. If it cannot be written, writes to standard error and exit code 2")]
    #[effects(alloc, io)]
    fn write_or_exit(path: &str, text: &str) -> () {
        match std::fs::write(path, text.as_bytes()) {
            Ok(done) => {},
            Err(e) => { eprint_str("bmb: cannot write "); eprint_str(path); eprint_str(": "); eprint_str(e.message.as_str()); eprint_str("\n"); std::process::exit(2); },
        }
    }
}
