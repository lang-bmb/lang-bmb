#[summary("코드 생성의 상수 IR 글: scripts/codegen_text.py가 stage0의 bmb dump runtime에서 만든다(손으로 고치지 않는다). stage0 codegen.rs의 문자열 상수의 자리 (백로그 4D-05c1)")]
mod codegen_text {
    #[effects(alloc)]
    fn head() -> String {
        String::from("; generated by bmb (ADR-0017 semantics; checks only where proofs are missing)\n@bmb.fmt = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"\ndeclare i32 @printf(ptr, ...)\ndeclare void @llvm.trap() noreturn nounwind\ndeclare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\ndeclare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)\n")
    }

    #[effects(alloc)]
    fn head_rest() -> String {
        String::from("declare i64 @llvm.umin.i64(i64, i64)\ndeclare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)\ndeclare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)\ndeclare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)\ndeclare i64 @llvm.sadd.sat.i64(i64, i64)\ndeclare i64 @llvm.ssub.sat.i64(i64, i64)\ndeclare {i64, i1} @llvm.uadd.with.overflow.i64(i64, i64)\ndeclare {i64, i1} @llvm.usub.with.overflow.i64(i64, i64)\ndeclare {i64, i1} @llvm.umul.with.overflow.i64(i64, i64)\ndeclare i64 @llvm.uadd.sat.i64(i64, i64)\ndeclare i64 @llvm.usub.sat.i64(i64, i64)\ndefine internal void @bmb_print_i64(i64 %x) {\n  %r = call i32 (ptr, ...) @printf(ptr @bmb.fmt, i64 %x)\n  %bad = icmp slt i32 %r, 0\n  call void @bmb_out_check(i1 %bad)\n  ret void\n}\n@bmb.fmtu = private unnamed_addr constant [6 x i8] c\"%llu\\0A\\00\"\ndefine internal void @bmb_print_u64(i64 %x) {\n  %r = call i32 (ptr, ...) @printf(ptr @bmb.fmtu, i64 %x)\n  %bad = icmp slt i32 %r, 0\n  call void @bmb_out_check(i1 %bad)\n  ret void\n}\n@stdout = external global ptr\ndeclare i64 @fwrite(ptr, i64, i64, ptr)\ndefine internal void @bmb_print_bytes(ptr %p, i64 %n) {\n  %f = load ptr, ptr @stdout\n  %w = call i64 @fwrite(ptr %p, i64 1, i64 %n, ptr %f)\n  %bad = icmp ne i64 %w, %n\n  call void @bmb_out_check(i1 %bad)\n  ret void\n}\ndeclare i32 @fflush(ptr)\ndeclare ptr @__errno_location()\ndeclare ptr @signal(i32, ptr)\ndeclare void @_exit(i32) noreturn\ndefine internal void @bmb_out_check(i1 %bad) {\nentry:\n  br i1 %bad, label %failed, label %ok\nfailed:\n  %ep = call ptr @__errno_location()\n  %e = load i32, ptr %ep\n  %pipe = icmp eq i32 %e, 32\n  br i1 %pipe, label %closed, label %ok\nclosed:\n  call void @_exit(i32 141)\n  unreachable\nok:\n  ret void\n}\ndefine internal void @bmb_flush_out() {\n  %o = load ptr, ptr @stdout\n  %r = call i32 @fflush(ptr %o)\n  %bad = icmp ne i32 %r, 0\n  call void @bmb_out_check(i1 %bad)\n  ret void\n}\ndefine internal void @bmb_trap() cold noreturn nounwind {\n  call i32 @fflush(ptr null)\n  call void @llvm.trap()\n  unreachable\n}\n")
    }

    #[effects(alloc)]
    fn heap_runtime() -> String {
        String::from("declare ptr @malloc(i64)\ndeclare void @free(ptr)\ndeclare void @abort() noreturn nounwind\ndefine internal ptr @bmb_box_alloc(i64 %size) {\nentry:\n  %p = call ptr @malloc(i64 %size)\n  %null = icmp eq ptr %p, null\n  br i1 %null, label %fail, label %ok\nfail:\n  call void @abort()\n  unreachable\nok:\n  ret ptr %p\n}\n")
    }

    #[effects(alloc)]
    fn print_f64() -> String {
        String::from("@bmb.fmtf = private unnamed_addr constant [6 x i8] c\"%.*f\\0A\\00\"\n@bmb.nan = private unnamed_addr constant [5 x i8] c\"NaN\\0A\\00\"\ndefine internal void @bmb_print_f64(double %x, i64 %d) {\n  %nan = fcmp uno double %x, %x\n  br i1 %nan, label %n, label %f\nn:\n  %rn = call i32 (ptr, ...) @printf(ptr @bmb.nan)\n  %badn = icmp slt i32 %rn, 0\n  call void @bmb_out_check(i1 %badn)\n  ret void\nf:\n  %p = trunc i64 %d to i32\n  %rf = call i32 (ptr, ...) @printf(ptr @bmb.fmtf, i32 %p, double %x)\n  %badf = icmp slt i32 %rf, 0\n  call void @bmb_out_check(i1 %badf)\n  ret void\n}\n")
    }

    #[effects(alloc)]
    fn sys_args() -> String {
        String::from("@bmb.argc = internal global i32 0\n@bmb.argv = internal global ptr null\n@bmb.args_bad = private unnamed_addr constant [48 x i8] c\"bmb: a command-line argument is not valid UTF-8\\0A\"\ndefine internal void @bmb_args(ptr %out) {\nentry:\n  %c32 = load i32, ptr @bmb.argc\n  %argc = sext i32 %c32 to i64\n  %argv = load ptr, ptr @bmb.argv\n  call void @bmb_vec_alloc(ptr %out, i64 %argc, i64 24)\n  %buf = load ptr, ptr %out\n  br label %head\nhead:\n  %i = phi i64 [0, %entry], [%i1, %ok]\n  %more = icmp ult i64 %i, %argc\n  br i1 %more, label %body, label %done\nbody:\n  %ap = getelementptr inbounds ptr, ptr %argv, i64 %i\n  %a = load ptr, ptr %ap\n  %n = call i64 @strlen(ptr %a)\n  %valid = call i1 @bmb_utf8_valid(ptr %a, i64 %n)\n  br i1 %valid, label %ok, label %bad\nbad:\n  call void @bmb_eprint_bytes(ptr @bmb.args_bad, i64 48)\n  call void @bmb_exit(i64 101)\n  unreachable\nok:\n  %h = getelementptr inbounds %bmb.vec, ptr %buf, i64 %i\n  call void @bmb_vec_alloc(ptr %h, i64 %n, i64 1)\n  %d = load ptr, ptr %h\n  call void @llvm.memcpy.p0.p0.i64(ptr %d, ptr %a, i64 %n, i1 false)\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  store i64 %n, ptr %lp\n  %i1 = add nuw i64 %i, 1\n  br label %head\ndone:\n  %olp = getelementptr inbounds %bmb.vec, ptr %out, i32 0, i32 1\n  store i64 %argc, ptr %olp\n  ret void\n}\n")
    }

    #[effects(alloc)]
    fn sys_child() -> String {
        String::from("declare ptr @fdopen(i32, ptr)\ndeclare i32 @fclose(ptr)\n@bmb.mode_w = private unnamed_addr constant [2 x i8] c\"w\\00\"\n@bmb.mode_r = private unnamed_addr constant [2 x i8] c\"r\\00\"\n@bmb.dev_null = private unnamed_addr constant [10 x i8] c\"/dev/null\\00\"\ndefine internal i64 @bmb_rt_process_spawn(ptr %out, ptr %p, i64 %pn, ptr %args, i64 %an, ptr %how) {\nentry:\n  %cprog = call ptr @bmb_cpath(ptr %p, i64 %pn)\n  %pnul = icmp eq ptr %cprog, null\n  br i1 %pnul, label %badprog, label %mkargv\nbadprog:\n  ret i64 -1001\nmkargv:\n  %cnt = add nuw i64 %an, 2\n  %bytes = mul nuw i64 %cnt, 8\n  %argv = call ptr @bmb_box_alloc(i64 %bytes)\n  store ptr %cprog, ptr %argv\n  br label %ahead\nahead:\n  %i = phi i64 [0, %mkargv], [%i1, %astore]\n  %amore = icmp ult i64 %i, %an\n  br i1 %amore, label %abody, label %aend\nabody:\n  %eh = getelementptr inbounds %bmb.vec, ptr %args, i64 %i\n  %ep = load ptr, ptr %eh\n  %elp = getelementptr inbounds %bmb.vec, ptr %eh, i32 0, i32 1\n  %el = load i64, ptr %elp\n  %ca = call ptr @bmb_cpath(ptr %ep, i64 %el)\n  %anul = icmp eq ptr %ca, null\n  br i1 %anul, label %badarg, label %astore\nbadarg:\n  %filled = add nuw i64 %i, 1\n  call void @bmb_argv_free(ptr %argv, i64 %filled)\n  ret i64 -1001\nastore:\n  %slot = add nuw i64 %i, 1\n  %sp = getelementptr inbounds ptr, ptr %argv, i64 %slot\n  store ptr %ca, ptr %sp\n  %i1 = add nuw i64 %i, 1\n  br label %ahead\naend:\n  %last = add nuw i64 %an, 1\n  %lastp = getelementptr inbounds ptr, ptr %argv, i64 %last\n  store ptr null, ptr %lastp\n  %fds = alloca [4 x i32]\n  %f_in = getelementptr inbounds [4 x i32], ptr %fds, i32 0, i32 0\n  %f_out = getelementptr inbounds [4 x i32], ptr %fds, i32 0, i32 2\n  %p1 = call i32 @pipe2(ptr %f_in, i32 524288)\n  %p1bad = icmp ne i32 %p1, 0\n  br i1 %p1bad, label %nopipe, label %second\nsecond:\n  %p2 = call i32 @pipe2(ptr %f_out, i32 524288)\n  %p2bad = icmp ne i32 %p2, 0\n  br i1 %p2bad, label %nopipe2, label %spawn\nnopipe2:\n  %pe2 = call i64 @bmb_errno()\n  %c_r = load i32, ptr %f_in\n  %c_wp = getelementptr inbounds [4 x i32], ptr %fds, i32 0, i32 1\n  %c_w = load i32, ptr %c_wp\n  call i32 @close(i32 %c_r)\n  call i32 @close(i32 %c_w)\n  call void @bmb_argv_free(ptr %argv, i64 %last)\n  ret i64 %pe2\nnopipe:\n  %pe = call i64 @bmb_errno()\n  call void @bmb_argv_free(ptr %argv, i64 %last)\n  ret i64 %pe\nspawn:\n  %in_r = load i32, ptr %f_in\n  %in_wp = getelementptr inbounds [4 x i32], ptr %fds, i32 0, i32 1\n  %in_w = load i32, ptr %in_wp\n  %out_r = load i32, ptr %f_out\n  %out_wp = getelementptr inbounds [4 x i32], ptr %fds, i32 0, i32 3\n  %out_w = load i32, ptr %out_wp\n  %fa = alloca [128 x i8]\n  call i32 @posix_spawn_file_actions_init(ptr %fa)\n  call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %in_r, i32 0)\n  call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %out_w, i32 1)\n  %tag = load i64, ptr %how\n  %quiet = icmp eq i64 %tag, 1\n  br i1 %quiet, label %null, label %spawnit\nnull:\n  %dn = call i32 (ptr, i32, ...) @open(ptr @bmb.dev_null, i32 524289)\n  %dnok = icmp sge i32 %dn, 0\n  br i1 %dnok, label %redirect, label %spawnit\nredirect:\n  call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %dn, i32 2)\n  br label %spawnit\nspawnit:\n  %devnull = phi i32 [-1, %spawn], [-1, %null], [%dn, %redirect]\n  %pid = alloca i32\n  %env = load ptr, ptr @environ\n  %attr = alloca [512 x i8], align 8\n  call void @bmb_spawn_attr(ptr %attr)\n  %rc = call i32 @posix_spawnp(ptr %pid, ptr %cprog, ptr %fa, ptr %attr, ptr %argv, ptr %env)\n  call i32 @posix_spawnattr_destroy(ptr %attr)\n  call i32 @posix_spawn_file_actions_destroy(ptr %fa)\n  call void @bmb_argv_free(ptr %argv, i64 %last)\n  call i32 @close(i32 %in_r)\n  call i32 @close(i32 %out_w)\n  %hasnull = icmp sge i32 %devnull, 0\n  br i1 %hasnull, label %closenull, label %after\nclosenull:\n  call i32 @close(i32 %devnull)\n  br label %after\nafter:\n  %spawnfail = icmp ne i32 %rc, 0\n  br i1 %spawnfail, label %nospawn, label %started\nnospawn:\n  call i32 @close(i32 %in_w)\n  call i32 @close(i32 %out_r)\n  %rc64 = sext i32 %rc to i64\n  %se = sub i64 -1, %rc64\n  ret i64 %se\nstarted:\n  %fin = call ptr @fdopen(i32 %in_w, ptr @bmb.mode_w)\n  %fout = call ptr @fdopen(i32 %out_r, ptr @bmb.mode_r)\n  %pidv = load i32, ptr %pid\n  %pp = getelementptr inbounds %\"std::process::Child\", ptr %out, i32 0, i32 0\n  store i32 %pidv, ptr %pp\n  %ip = getelementptr inbounds %\"std::process::Child\", ptr %out, i32 0, i32 1\n  %fini = ptrtoint ptr %fin to i64\n  store i64 %fini, ptr %ip\n  %op = getelementptr inbounds %\"std::process::Child\", ptr %out, i32 0, i32 2\n  %fouti = ptrtoint ptr %fout to i64\n  store i64 %fouti, ptr %op\n  ret i64 0\n}\ndefine internal ptr @bmb_child_file(ptr %c, i32 %k) {\n  %pi = getelementptr inbounds %\"std::process::Child\", ptr %c, i32 0, i32 1\n  %po = getelementptr inbounds %\"std::process::Child\", ptr %c, i32 0, i32 2\n  %isin = icmp eq i32 %k, 1\n  %fp = select i1 %isin, ptr %pi, ptr %po\n  %fi = load i64, ptr %fp\n  %f = inttoptr i64 %fi to ptr\n  ret ptr %f\n}\ndefine internal i64 @bmb_rt_child_write_all(ptr %c, ptr %d, i64 %n) {\nentry:\n  %f = call ptr @bmb_child_file(ptr %c, i32 1)\n  %none = icmp eq ptr %f, null\n  br i1 %none, label %badf, label %write\nbadf:\n  ret i64 -10\nwrite:\n  %w = call i64 @fwrite(ptr %d, i64 1, i64 %n, ptr %f)\n  %short = icmp ne i64 %w, %n\n  br i1 %short, label %err, label %flush\nflush:\n  %r = call i32 @fflush(ptr %f)\n  %bad = icmp ne i32 %r, 0\n  br i1 %bad, label %err, label %ok\nok:\n  ret i64 0\nerr:\n  %e = call i64 @bmb_errno()\n  ret i64 %e\n}\ndefine internal i64 @bmb_rt_child_read_line(ptr %c, ptr %h) {\nentry:\n  %f = call ptr @bmb_child_file(ptr %c, i32 2)\n  %none = icmp eq ptr %f, null\n  br i1 %none, label %badf, label %start\nbadf:\n  ret i64 -10\nstart:\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  %first = load i64, ptr %lp\n  br label %next\nnext:\n  %ch = call i32 @fgetc(ptr %f)\n  %eof = icmp slt i32 %ch, 0\n  br i1 %eof, label %end, label %byte\nbyte:\n  %len = load i64, ptr %lp\n  %cap = load i64, ptr %cp\n  %full = icmp eq i64 %len, %cap\n  br i1 %full, label %grow, label %put\ngrow:\n  call void @bmb_vec_grow(ptr %h, i64 1)\n  br label %put\nput:\n  %buf = load ptr, ptr %h\n  %at = getelementptr inbounds i8, ptr %buf, i64 %len\n  %b = trunc i32 %ch to i8\n  store i8 %b, ptr %at\n  %len1 = add nuw i64 %len, 1\n  store i64 %len1, ptr %lp\n  %nl = icmp eq i32 %ch, 10\n  br i1 %nl, label %check, label %next\nend:\n  %ferr = call i32 @ferror(ptr %f)\n  %isbad = icmp ne i32 %ferr, 0\n  br i1 %isbad, label %os, label %check\nos:\n  %ec = call i64 @bmb_errno()\n  %olen = load i64, ptr %lp\n  %on = sub nuw i64 %olen, %first\n  %obuf = load ptr, ptr %h\n  %ofrom = getelementptr inbounds i8, ptr %obuf, i64 %first\n  %okeep = call i1 @bmb_utf8_valid(ptr %ofrom, i64 %on)\n  br i1 %okeep, label %osdone, label %osdrop\nosdrop:\n  store i64 %first, ptr %lp\n  br label %osdone\nosdone:\n  ret i64 %ec\ncheck:\n  %len2 = load i64, ptr %lp\n  %n = sub nuw i64 %len2, %first\n  %buf2 = load ptr, ptr %h\n  %from = getelementptr inbounds i8, ptr %buf2, i64 %first\n  %valid = call i1 @bmb_utf8_valid(ptr %from, i64 %n)\n  br i1 %valid, label %done, label %invalid\ninvalid:\n  store i64 %first, ptr %lp\n  ret i64 -1\ndone:\n  ret i64 %n\n}\ndefine internal void @bmb_rt_child_drop(ptr %c) {\nentry:\n  %fin = call ptr @bmb_child_file(ptr %c, i32 1)\n  %hasin = icmp ne ptr %fin, null\n  br i1 %hasin, label %closein, label %out\nclosein:\n  call i32 @fclose(ptr %fin)\n  br label %out\nout:\n  %fout = call ptr @bmb_child_file(ptr %c, i32 2)\n  %hasout = icmp ne ptr %fout, null\n  br i1 %hasout, label %closeout, label %done\ncloseout:\n  call i32 @fclose(ptr %fout)\n  br label %done\ndone:\n  ret void\n}\ndefine internal i64 @bmb_rt_child_wait(ptr %c) {\nentry:\n  call void @bmb_rt_child_drop(ptr %c)\n  %pp = getelementptr inbounds %\"std::process::Child\", ptr %c, i32 0, i32 0\n  %pidv = load i32, ptr %pp\n  %st = alloca i32\n  store i32 0, ptr %st\n  br label %waiting\nwaiting:\n  %wp = call i32 @waitpid(i32 %pidv, ptr %st, i32 0)\n  %wbad = icmp slt i32 %wp, 0\n  br i1 %wbad, label %retry, label %reaped\nretry:\n  %wi = call i1 @bmb_interrupted()\n  br i1 %wi, label %waiting, label %failed\nfailed:\n  %we = call i64 @bmb_errno()\n  ret i64 %we\nreaped:\n  %s = load i32, ptr %st\n  %sig = and i32 %s, 127\n  %exited = icmp eq i32 %sig, 0\n  %code = lshr i32 %s, 8\n  %code8 = and i32 %code, 255\n  %bysig = add nuw i32 %sig, 128\n  %status = select i1 %exited, i32 %code8, i32 %bysig\n  %s64 = zext i32 %status to i64\n  ret i64 %s64\n}\ndefine internal i64 @bmb_child_id(ptr %c) {\n  %pp = getelementptr inbounds %\"std::process::Child\", ptr %c, i32 0, i32 0\n  %pidv = load i32, ptr %pp\n  %w = zext i32 %pidv to i64\n  ret i64 %w\n}\n")
    }

    #[effects(alloc)]
    fn sys_clock() -> String {
        String::from("declare i32 @clock_gettime(i32, ptr)\ndefine internal i64 @bmb_monotonic_ms() {\n  %ts = alloca [2 x i64]\n  call i32 @clock_gettime(i32 1, ptr %ts)\n  %s = load i64, ptr %ts\n  %np = getelementptr inbounds [2 x i64], ptr %ts, i32 0, i32 1\n  %ns = load i64, ptr %np\n  %ms = mul i64 %s, 1000\n  %frac = udiv i64 %ns, 1000000\n  %r = add i64 %ms, %frac\n  ret i64 %r\n}\n")
    }

    #[effects(alloc)]
    fn sys_cpath() -> String {
        String::from("declare ptr @memchr(ptr, i32, i64)\ndefine internal ptr @bmb_cpath(ptr %p, i64 %n) {\nentry:\n  %empty = icmp eq i64 %n, 0\n  br i1 %empty, label %copy, label %scan\nscan:\n  %nul = call ptr @memchr(ptr %p, i32 0, i64 %n)\n  %has = icmp ne ptr %nul, null\n  br i1 %has, label %bad, label %copy\nbad:\n  ret ptr null\ncopy:\n  %sz = add nuw i64 %n, 1\n  %c = call ptr @bmb_box_alloc(i64 %sz)\n  call void @llvm.memcpy.p0.p0.i64(ptr %c, ptr %p, i64 %n, i1 false)\n  %end = getelementptr inbounds i8, ptr %c, i64 %n\n  store i8 0, ptr %end\n  ret ptr %c\n}\n")
    }

    #[effects(alloc)]
    fn sys_dirs() -> String {
        String::from("declare i32 @rename(ptr, ptr)\ndeclare i32 @unlink(ptr)\ndeclare i32 @mkdir(ptr, i32)\ndeclare ptr @opendir(ptr)\ndeclare ptr @readdir(ptr)\ndeclare i32 @closedir(ptr)\ndeclare void @qsort(ptr, i64, i64, ptr)\ndefine internal i64 @bmb_rt_fs_rename(ptr %p, i64 %n, ptr %q, i64 %m) {\nentry:\n  %a = call ptr @bmb_cpath(ptr %p, i64 %n)\n  %b = call ptr @bmb_cpath(ptr %q, i64 %m)\n  %an = icmp eq ptr %a, null\n  %bn = icmp eq ptr %b, null\n  %either = or i1 %an, %bn\n  br i1 %either, label %badpath, label %go\nbadpath:\n  call void @free(ptr %a)\n  call void @free(ptr %b)\n  ret i64 -1001\ngo:\n  %r = call i32 @rename(ptr %a, ptr %b)\n  %fail = icmp ne i32 %r, 0\n  br i1 %fail, label %os, label %ok\nos:\n  %e = call i64 @bmb_errno()\n  call void @free(ptr %a)\n  call void @free(ptr %b)\n  ret i64 %e\nok:\n  call void @free(ptr %a)\n  call void @free(ptr %b)\n  ret i64 0\n}\ndefine internal i64 @bmb_rt_fs_remove_file(ptr %p, i64 %n) {\nentry:\n  %c = call ptr @bmb_cpath(ptr %p, i64 %n)\n  %nul = icmp eq ptr %c, null\n  br i1 %nul, label %badpath, label %go\nbadpath:\n  ret i64 -1001\ngo:\n  %r = call i32 @unlink(ptr %c)\n  %fail = icmp ne i32 %r, 0\n  br i1 %fail, label %os, label %ok\nos:\n  %e = call i64 @bmb_errno()\n  call void @free(ptr %c)\n  ret i64 %e\nok:\n  call void @free(ptr %c)\n  ret i64 0\n}\ndefine internal i1 @bmb_is_dir(ptr %c) {\nentry:\n  %fd = call i32 (ptr, i32, ...) @open(ptr %c, i32 2686976)\n  %ok = icmp sge i32 %fd, 0\n  br i1 %ok, label %yes, label %no\nyes:\n  call i32 @close(i32 %fd)\n  ret i1 true\nno:\n  ret i1 false\n}\ndefine internal i64 @bmb_mkdir_once(ptr %c, i64 %n) {\nentry:\n  %endp = getelementptr inbounds i8, ptr %c, i64 %n\n  %saved = load i8, ptr %endp\n  store i8 0, ptr %endp\n  %r = call i32 @mkdir(ptr %c, i32 511)\n  %fail = icmp ne i32 %r, 0\n  br i1 %fail, label %error, label %ok\nerror:\n  %e = call i64 @bmb_errno()\n  %dir = call i1 @bmb_is_dir(ptr %c)\n  store i8 %saved, ptr %endp\n  %res = select i1 %dir, i64 0, i64 %e\n  ret i64 %res\nok:\n  store i8 %saved, ptr %endp\n  ret i64 0\n}\ndefine internal i64 @bmb_parent_len(ptr %c, i64 %n) {\nentry:\n  br label %strip\nstrip:\n  %m0 = phi i64 [%n, %entry], [%m0d, %stripmore]\n  %s0 = icmp ugt i64 %m0, 0\n  br i1 %s0, label %stripchk, label %back\nstripchk:\n  %m0m = sub nuw i64 %m0, 1\n  %sp = getelementptr inbounds i8, ptr %c, i64 %m0m\n  %sb = load i8, ptr %sp\n  %slash = icmp eq i8 %sb, 47\n  br i1 %slash, label %stripmore, label %back\nstripmore:\n  %m0d = sub nuw i64 %m0, 1\n  br label %strip\nback:\n  %m1 = phi i64 [%m0, %strip], [%m0, %stripchk], [%m1d, %backmore]\n  %s1 = icmp ugt i64 %m1, 0\n  br i1 %s1, label %backchk, label %trim\nbackchk:\n  %m1m = sub nuw i64 %m1, 1\n  %bp = getelementptr inbounds i8, ptr %c, i64 %m1m\n  %bb = load i8, ptr %bp\n  %isslash = icmp eq i8 %bb, 47\n  br i1 %isslash, label %trim, label %backmore\nbackmore:\n  %m1d = sub nuw i64 %m1, 1\n  br label %back\ntrim:\n  %m2 = phi i64 [%m1, %back], [%m1, %backchk], [%m2d, %trimmore]\n  %s2 = icmp ugt i64 %m2, 1\n  br i1 %s2, label %trimchk, label %done\ntrimchk:\n  %m2m = sub nuw i64 %m2, 1\n  %tp = getelementptr inbounds i8, ptr %c, i64 %m2m\n  %tb = load i8, ptr %tp\n  %tslash = icmp eq i8 %tb, 47\n  br i1 %tslash, label %trimmore, label %done\ntrimmore:\n  %m2d = sub nuw i64 %m2, 1\n  br label %trim\ndone:\n  %m = phi i64 [%m2, %trim], [%m2, %trimchk]\n  ret i64 %m\n}\ndefine internal i64 @bmb_mkdir_all(ptr %c, i64 %n) {\nentry:\n  %empty = icmp eq i64 %n, 0\n  br i1 %empty, label %ok, label %try\ntry:\n  %endp = getelementptr inbounds i8, ptr %c, i64 %n\n  %saved = load i8, ptr %endp\n  store i8 0, ptr %endp\n  %r = call i32 @mkdir(ptr %c, i32 511)\n  %fail = icmp ne i32 %r, 0\n  br i1 %fail, label %error, label %made\nmade:\n  store i8 %saved, ptr %endp\n  br label %ok\nerror:\n  %e = call i64 @bmb_errno()\n  %dir = call i1 @bmb_is_dir(ptr %c)\n  store i8 %saved, ptr %endp\n  br i1 %dir, label %ok, label %why\nwhy:\n  %enoent = icmp eq i64 %e, -3\n  br i1 %enoent, label %parent, label %fail2\nfail2:\n  ret i64 %e\nparent:\n  %m = call i64 @bmb_parent_len(ptr %c, i64 %n)\n  %pr = call i64 @bmb_mkdir_all(ptr %c, i64 %m)\n  %pbad = icmp slt i64 %pr, 0\n  br i1 %pbad, label %pfail, label %again\npfail:\n  ret i64 %pr\nagain:\n  %r2 = call i64 @bmb_mkdir_once(ptr %c, i64 %n)\n  ret i64 %r2\nok:\n  ret i64 0\n}\ndefine internal i64 @bmb_rt_fs_create_dir_all(ptr %p, i64 %n) {\nentry:\n  %c = call ptr @bmb_cpath(ptr %p, i64 %n)\n  %nul = icmp eq ptr %c, null\n  br i1 %nul, label %badpath, label %go\nbadpath:\n  ret i64 -1001\ngo:\n  %r = call i64 @bmb_mkdir_all(ptr %c, i64 %n)\n  call void @free(ptr %c)\n  ret i64 %r\n}\ndefine internal i32 @bmb_name_cmp(ptr %a, ptr %b) {\nentry:\n  %ap = load ptr, ptr %a\n  %alp = getelementptr inbounds %bmb.vec, ptr %a, i32 0, i32 1\n  %al = load i64, ptr %alp\n  %bp = load ptr, ptr %b\n  %blp = getelementptr inbounds %bmb.vec, ptr %b, i32 0, i32 1\n  %bl = load i64, ptr %blp\n  %r = call i32 @bmb_str_cmp(ptr %ap, i64 %al, ptr %bp, i64 %bl)\n  ret i32 %r\n}\ndefine internal void @bmb_names_free(ptr %h) {\nentry:\n  %buf = load ptr, ptr %h\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %len = load i64, ptr %lp\n  br label %head\nhead:\n  %i = phi i64 [0, %entry], [%i1, %body]\n  %more = icmp ult i64 %i, %len\n  br i1 %more, label %body, label %done\nbody:\n  %e = getelementptr inbounds %bmb.vec, ptr %buf, i64 %i\n  %eb = load ptr, ptr %e\n  call void @free(ptr %eb)\n  %i1 = add nuw i64 %i, 1\n  br label %head\ndone:\n  call void @free(ptr %buf)\n  ret void\n}\ndefine internal i64 @bmb_rt_fs_read_dir(ptr %out, ptr %p, i64 %n) {\nentry:\n  call void @bmb_vec_alloc(ptr %out, i64 0, i64 24)\n  %c = call ptr @bmb_cpath(ptr %p, i64 %n)\n  %nul = icmp eq ptr %c, null\n  br i1 %nul, label %badpath, label %open\nbadpath:\n  ret i64 -1001\nopen:\n  %d = call ptr @opendir(ptr %c)\n  %fail = icmp eq ptr %d, null\n  br i1 %fail, label %oserr, label %go\noserr:\n  %e = call i64 @bmb_errno()\n  call void @free(ptr %c)\n  ret i64 %e\ngo:\n  call void @free(ptr %c)\n  %lp = getelementptr inbounds %bmb.vec, ptr %out, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %out, i32 0, i32 2\n  br label %next\nnext:\n  %ep = call ptr @__errno_location()\n  store i32 0, ptr %ep\n  %ent = call ptr @readdir(ptr %d)\n  %end = icmp eq ptr %ent, null\n  br i1 %end, label %ended, label %got\ngot:\n  %name = getelementptr inbounds i8, ptr %ent, i64 19\n  %nlen = call i64 @strlen(ptr %name)\n  %c0 = load i8, ptr %name\n  %dot = icmp eq i8 %c0, 46\n  %short = icmp ule i64 %nlen, 2\n  %maybe = and i1 %dot, %short\n  br i1 %maybe, label %dots, label %keep\ndots:\n  %one = icmp eq i64 %nlen, 1\n  %c1p = getelementptr inbounds i8, ptr %name, i64 1\n  %c1 = load i8, ptr %c1p\n  %dot2 = icmp eq i8 %c1, 46\n  %skip = or i1 %one, %dot2\n  br i1 %skip, label %next, label %keep\nkeep:\n  %valid = call i1 @bmb_utf8_valid(ptr %name, i64 %nlen)\n  br i1 %valid, label %push, label %notutf\nnotutf:\n  call i32 @closedir(ptr %d)\n  call void @bmb_names_free(ptr %out)\n  ret i64 -1\npush:\n  %len = load i64, ptr %lp\n  %cap = load i64, ptr %cp\n  %full = icmp eq i64 %len, %cap\n  br i1 %full, label %grow, label %put\ngrow:\n  call void @bmb_vec_grow(ptr %out, i64 24)\n  br label %put\nput:\n  %buf = load ptr, ptr %out\n  %slot = getelementptr inbounds %bmb.vec, ptr %buf, i64 %len\n  call void @bmb_vec_alloc(ptr %slot, i64 %nlen, i64 1)\n  %sb = load ptr, ptr %slot\n  call void @llvm.memcpy.p0.p0.i64(ptr %sb, ptr %name, i64 %nlen, i1 false)\n  %slp = getelementptr inbounds %bmb.vec, ptr %slot, i32 0, i32 1\n  store i64 %nlen, ptr %slp\n  %len1 = add nuw i64 %len, 1\n  store i64 %len1, ptr %lp\n  br label %next\nended:\n  %ep2 = call ptr @__errno_location()\n  %err = load i32, ptr %ep2\n  %bad = icmp ne i32 %err, 0\n  br i1 %bad, label %rderr, label %sort\nrderr:\n  %re = call i64 @bmb_errno()\n  call i32 @closedir(ptr %d)\n  call void @bmb_names_free(ptr %out)\n  ret i64 %re\nsort:\n  call i32 @closedir(ptr %d)\n  %all = load i64, ptr %lp\n  %base = load ptr, ptr %out\n  %some = icmp ugt i64 %all, 1\n  br i1 %some, label %qs, label %done\nqs:\n  call void @qsort(ptr %base, i64 %all, i64 24, ptr @bmb_name_cmp)\n  br label %done\ndone:\n  ret i64 0\n}\n")
    }

    #[effects(alloc)]
    fn sys_eprint() -> String {
        String::from("@stderr = external global ptr\ndefine internal void @bmb_eprint_bytes(ptr %p, i64 %n) {\n  %o = load ptr, ptr @stdout\n  %fr = call i32 @fflush(ptr %o)\n  %bad = icmp ne i32 %fr, 0\n  call void @bmb_out_check(i1 %bad)\n  %f = load ptr, ptr @stderr\n  call i64 @fwrite(ptr %p, i64 1, i64 %n, ptr %f)\n  ret void\n}\n")
    }

    #[effects(alloc)]
    fn sys_exit() -> String {
        String::from("declare void @exit(i32) noreturn\ndefine internal void @bmb_exit(i64 %c) cold noreturn {\n  call void @bmb_flush_out()\n  %w = trunc i64 %c to i32\n  call void @exit(i32 %w)\n  unreachable\n}\n")
    }

    #[effects(alloc)]
    fn sys_fs() -> String {
        String::from("declare i32 @open(ptr, i32, ...)\ndeclare i64 @read(i32, ptr, i64)\ndeclare i64 @write(i32, ptr, i64)\ndeclare i32 @close(i32)\ndefine internal i64 @bmb_fd_read_all(i32 %fd, ptr %h) {\nentry:\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  br label %next\nnext:\n  %len = load i64, ptr %lp\n  %cap = load i64, ptr %cp\n  %full = icmp eq i64 %len, %cap\n  br i1 %full, label %grow, label %read\ngrow:\n  call void @bmb_vec_grow(ptr %h, i64 1)\n  br label %read\nread:\n  %len1 = load i64, ptr %lp\n  %cap1 = load i64, ptr %cp\n  %room = sub nuw i64 %cap1, %len1\n  %buf = load ptr, ptr %h\n  %at = getelementptr inbounds i8, ptr %buf, i64 %len1\n  %got = call i64 @read(i32 %fd, ptr %at, i64 %room)\n  %fail = icmp slt i64 %got, 0\n  br i1 %fail, label %error, label %some\nerror:\n  %intr = call i1 @bmb_interrupted()\n  br i1 %intr, label %next, label %os\nos:\n  %r = call i64 @bmb_errno()\n  ret i64 %r\nsome:\n  %none = icmp eq i64 %got, 0\n  br i1 %none, label %done, label %more\nmore:\n  %len2 = add nuw i64 %len1, %got\n  store i64 %len2, ptr %lp\n  br label %next\ndone:\n  ret i64 0\n}\ndefine internal i64 @bmb_rt_fs_read(ptr %out, ptr %p, i64 %n) {\nentry:\n  call void @bmb_vec_alloc(ptr %out, i64 0, i64 1)\n  %c = call ptr @bmb_cpath(ptr %p, i64 %n)\n  %nul = icmp eq ptr %c, null\n  br i1 %nul, label %badpath, label %open\nbadpath:\n  ret i64 -1001\nopen:\n  %fd = call i32 (ptr, i32, ...) @open(ptr %c, i32 524288)\n  %fail = icmp slt i32 %fd, 0\n  br i1 %fail, label %oserr, label %go\noserr:\n  %e = call i64 @bmb_errno()\n  call void @free(ptr %c)\n  ret i64 %e\ngo:\n  call void @free(ptr %c)\n  %r = call i64 @bmb_fd_read_all(i32 %fd, ptr %out)\n  call i32 @close(i32 %fd)\n  %bad = icmp slt i64 %r, 0\n  br i1 %bad, label %drop, label %ok\ndrop:\n  %b = load ptr, ptr %out\n  call void @free(ptr %b)\n  ret i64 %r\nok:\n  ret i64 0\n}\ndefine internal i64 @bmb_rt_fs_read_to_string(ptr %out, ptr %p, i64 %n) {\nentry:\n  %r = call i64 @bmb_rt_fs_read(ptr %out, ptr %p, i64 %n)\n  %bad = icmp slt i64 %r, 0\n  br i1 %bad, label %fail, label %check\nfail:\n  ret i64 %r\ncheck:\n  %buf = load ptr, ptr %out\n  %lp = getelementptr inbounds %bmb.vec, ptr %out, i32 0, i32 1\n  %len = load i64, ptr %lp\n  %valid = call i1 @bmb_utf8_valid(ptr %buf, i64 %len)\n  br i1 %valid, label %ok, label %invalid\ninvalid:\n  call void @free(ptr %buf)\n  ret i64 -1\nok:\n  ret i64 0\n}\ndefine internal i64 @bmb_rt_fs_write(ptr %p, i64 %n, ptr %d, i64 %dn) {\n  %r = call i64 @bmb_fs_write_with(ptr %p, i64 %n, ptr %d, i64 %dn, i32 524865)\n  ret i64 %r\n}\ndefine internal i64 @bmb_rt_fs_write_new(ptr %p, i64 %n, ptr %d, i64 %dn) {\n  %r = call i64 @bmb_fs_write_with(ptr %p, i64 %n, ptr %d, i64 %dn, i32 524481)\n  ret i64 %r\n}\ndefine internal i64 @bmb_fs_write_with(ptr %p, i64 %n, ptr %d, i64 %dn, i32 %flags) {\nentry:\n  %c = call ptr @bmb_cpath(ptr %p, i64 %n)\n  %nul = icmp eq ptr %c, null\n  br i1 %nul, label %badpath, label %open\nbadpath:\n  ret i64 -1001\nopen:\n  %fd = call i32 (ptr, i32, ...) @open(ptr %c, i32 %flags, i32 438)\n  %fail = icmp slt i32 %fd, 0\n  br i1 %fail, label %oserr, label %go\noserr:\n  %e = call i64 @bmb_errno()\n  call void @free(ptr %c)\n  ret i64 %e\ngo:\n  call void @free(ptr %c)\n  br label %next\nnext:\n  %off = phi i64 [0, %go], [%off, %again], [%off1, %wrote]\n  %left = sub nuw i64 %dn, %off\n  %more = icmp ugt i64 %left, 0\n  br i1 %more, label %put, label %done\nput:\n  %at = getelementptr inbounds i8, ptr %d, i64 %off\n  %w = call i64 @write(i32 %fd, ptr %at, i64 %left)\n  %wfail = icmp slt i64 %w, 0\n  br i1 %wfail, label %error, label %wrote\nerror:\n  %intr = call i1 @bmb_interrupted()\n  br i1 %intr, label %again, label %os\nagain:\n  br label %next\nos:\n  %r = call i64 @bmb_errno()\n  call i32 @close(i32 %fd)\n  ret i64 %r\nwrote:\n  %off1 = add nuw i64 %off, %w\n  br label %next\ndone:\n  call i32 @close(i32 %fd)\n  ret i64 0\n}\n")
    }

    #[effects(alloc)]
    fn sys_io_common() -> String {
        String::from("define internal i64 @bmb_errno() {\n  %ep = call ptr @__errno_location()\n  %e = load i32, ptr %ep\n  %w = sext i32 %e to i64\n  %neg = sub i64 -1, %w\n  ret i64 %neg\n}\ndefine internal i1 @bmb_interrupted() {\n  %ep = call ptr @__errno_location()\n  %e = load i32, ptr %ep\n  %i = icmp eq i32 %e, 4\n  ret i1 %i\n}\ndeclare ptr @strerror(i32)\ndeclare i32 @snprintf(ptr, i64, ptr, ...)\n@bmb.os_error = private unnamed_addr constant [17 x i8] c\"%s (os error %d)\\00\"\n@bmb.not_utf8 = private unnamed_addr constant [34 x i8] c\"stream did not contain valid UTF-8\"\n@bmb.nul_path = private unnamed_addr constant [42 x i8] c\"file name contained an unexpected NUL byte\"\ndefine internal void @bmb_io_text(ptr %h, ptr %t, i64 %n) {\n  call void @bmb_vec_alloc(ptr %h, i64 %n, i64 1)\n  %b = load ptr, ptr %h\n  call void @llvm.memcpy.p0.p0.i64(ptr %b, ptr %t, i64 %n, i1 false)\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  store i64 %n, ptr %lp\n  ret void\n}\ndefine internal void @bmb_io_message(ptr %h, i64 %code) {\nentry:\n  %tmp = alloca [160 x i8]\n  %z = icmp eq i64 %code, 0\n  br i1 %z, label %utf, label %notutf\nutf:\n  call void @bmb_io_text(ptr %h, ptr @bmb.not_utf8, i64 34)\n  ret void\nnotutf:\n  %np = icmp eq i64 %code, 1000\n  br i1 %np, label %nul, label %os\nnul:\n  call void @bmb_io_text(ptr %h, ptr @bmb.nul_path, i64 42)\n  ret void\nos:\n  %c32 = trunc i64 %code to i32\n  %s = call ptr @strerror(i32 %c32)\n  %w = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %tmp, i64 160, ptr @bmb.os_error, ptr %s, i32 %c32)\n  %w64 = sext i32 %w to i64\n  %over = icmp ugt i64 %w64, 159\n  %n = select i1 %over, i64 159, i64 %w64\n  call void @bmb_io_text(ptr %h, ptr %tmp, i64 %n)\n  ret void\n}\n")
    }

    #[effects(alloc)]
    fn sys_meta() -> String {
        String::from("declare i32 @stat(ptr, ptr)\ndeclare i32 @lstat(ptr, ptr)\ndefine internal i64 @bmb_fs_meta(ptr %out, ptr %p, i64 %n, i1 %follow) {\nentry:\n  %c = call ptr @bmb_cpath(ptr %p, i64 %n)\n  %nul = icmp eq ptr %c, null\n  br i1 %nul, label %badpath, label %go\nbadpath:\n  ret i64 -1001\ngo:\n  %st = alloca [144 x i8], align 8\n  br i1 %follow, label %s, label %l\ns:\n  %rs = call i32 @stat(ptr %c, ptr %st)\n  br label %got\nl:\n  %rl = call i32 @lstat(ptr %c, ptr %st)\n  br label %got\ngot:\n  %r = phi i32 [%rs, %s], [%rl, %l]\n  %fail = icmp ne i32 %r, 0\n  br i1 %fail, label %oserr, label %ok\noserr:\n  %e = call i64 @bmb_errno()\n  call void @free(ptr %c)\n  ret i64 %e\nok:\n  call void @free(ptr %c)\n  %mp = getelementptr inbounds i8, ptr %st, i64 24\n  %mode = load i32, ptr %mp\n  %fmt = and i32 %mode, 61440\n  %d = icmp eq i32 %fmt, 16384\n  %f = icmp eq i32 %fmt, 32768\n  %k = icmp eq i32 %fmt, 40960\n  %sp = getelementptr inbounds i8, ptr %st, i64 48\n  %size = load i64, ptr %sp\n  %d8 = zext i1 %d to i8\n  %f8 = zext i1 %f to i8\n  %k8 = zext i1 %k to i8\n  %od = getelementptr inbounds %\"std::fs::Metadata\", ptr %out, i32 0, i32 0\n  store i8 %d8, ptr %od\n  %of = getelementptr inbounds %\"std::fs::Metadata\", ptr %out, i32 0, i32 1\n  store i8 %f8, ptr %of\n  %ok8 = getelementptr inbounds %\"std::fs::Metadata\", ptr %out, i32 0, i32 2\n  store i8 %k8, ptr %ok8\n  %ol = getelementptr inbounds %\"std::fs::Metadata\", ptr %out, i32 0, i32 3\n  store i64 %size, ptr %ol\n  ret i64 0\n}\ndefine internal i64 @bmb_rt_fs_metadata(ptr %out, ptr %p, i64 %n) {\n  %r = call i64 @bmb_fs_meta(ptr %out, ptr %p, i64 %n, i1 true)\n  ret i64 %r\n}\ndefine internal i64 @bmb_rt_fs_symlink_metadata(ptr %out, ptr %p, i64 %n) {\n  %r = call i64 @bmb_fs_meta(ptr %out, ptr %p, i64 %n, i1 false)\n  ret i64 %r\n}\n")
    }

    #[effects(alloc)]
    fn sys_proc() -> String {
        String::from("declare i32 @pipe2(ptr, i32)\ndeclare i32 @posix_spawnattr_init(ptr)\ndeclare i32 @posix_spawnattr_destroy(ptr)\ndeclare i32 @posix_spawnattr_setflags(ptr, i16)\ndeclare i32 @posix_spawnattr_setsigdefault(ptr, ptr)\ndeclare i32 @sigemptyset(ptr)\ndeclare i32 @sigaddset(ptr, i32)\ndefine internal void @bmb_spawn_attr(ptr %attr) {\n  %ss = alloca [128 x i8], align 8\n  call i32 @posix_spawnattr_init(ptr %attr)\n  call i32 @sigemptyset(ptr %ss)\n  call i32 @sigaddset(ptr %ss, i32 13)\n  call i32 @posix_spawnattr_setsigdefault(ptr %attr, ptr %ss)\n  call i32 @posix_spawnattr_setflags(ptr %attr, i16 4)\n  ret void\n}\ndeclare i32 @posix_spawn_file_actions_init(ptr)\ndeclare i32 @posix_spawn_file_actions_destroy(ptr)\ndeclare i32 @posix_spawn_file_actions_adddup2(ptr, i32, i32)\ndeclare i32 @posix_spawnp(ptr, ptr, ptr, ptr, ptr, ptr)\ndeclare i32 @poll(ptr, i64, i32)\ndeclare i32 @waitpid(i32, ptr, i32)\n@environ = external global ptr\ndefine internal i64 @bmb_fd_read_some(i32 %fd, ptr %h) {\nentry:\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  %len = load i64, ptr %lp\n  %cap = load i64, ptr %cp\n  %full = icmp eq i64 %len, %cap\n  br i1 %full, label %grow, label %read\ngrow:\n  call void @bmb_vec_grow(ptr %h, i64 1)\n  br label %read\nread:\n  %len1 = load i64, ptr %lp\n  %cap1 = load i64, ptr %cp\n  %room = sub nuw i64 %cap1, %len1\n  %buf = load ptr, ptr %h\n  %at = getelementptr inbounds i8, ptr %buf, i64 %len1\n  %got = call i64 @read(i32 %fd, ptr %at, i64 %room)\n  %fail = icmp slt i64 %got, 0\n  br i1 %fail, label %error, label %some\nerror:\n  %intr = call i1 @bmb_interrupted()\n  %again = select i1 %intr, i64 1, i64 -1\n  ret i64 %again\nsome:\n  %len2 = add nuw i64 %len1, %got\n  store i64 %len2, ptr %lp\n  ret i64 %got\n}\ndefine internal void @bmb_argv_free(ptr %argv, i64 %n) {\nentry:\n  br label %head\nhead:\n  %i = phi i64 [0, %entry], [%i1, %body]\n  %more = icmp ult i64 %i, %n\n  br i1 %more, label %body, label %done\nbody:\n  %ap = getelementptr inbounds ptr, ptr %argv, i64 %i\n  %a = load ptr, ptr %ap\n  call void @free(ptr %a)\n  %i1 = add nuw i64 %i, 1\n  br label %head\ndone:\n  call void @free(ptr %argv)\n  ret void\n}\n")
    }

    #[effects(alloc)]
    fn sys_run() -> String {
        String::from("define internal i64 @bmb_rt_process_run(ptr %out, ptr %p, i64 %pn, ptr %args, i64 %an, ptr %in, i64 %inn) {\nentry:\n  %cprog = call ptr @bmb_cpath(ptr %p, i64 %pn)\n  %pnul = icmp eq ptr %cprog, null\n  br i1 %pnul, label %badprog, label %mkargv\nbadprog:\n  ret i64 -1001\nmkargv:\n  %cnt = add nuw i64 %an, 2\n  %bytes = mul nuw i64 %cnt, 8\n  %argv = call ptr @bmb_box_alloc(i64 %bytes)\n  store ptr %cprog, ptr %argv\n  br label %ahead\nahead:\n  %i = phi i64 [0, %mkargv], [%i1, %astore]\n  %amore = icmp ult i64 %i, %an\n  br i1 %amore, label %abody, label %aend\nabody:\n  %eh = getelementptr inbounds %bmb.vec, ptr %args, i64 %i\n  %ep = load ptr, ptr %eh\n  %elp = getelementptr inbounds %bmb.vec, ptr %eh, i32 0, i32 1\n  %el = load i64, ptr %elp\n  %ca = call ptr @bmb_cpath(ptr %ep, i64 %el)\n  %anul = icmp eq ptr %ca, null\n  br i1 %anul, label %badarg, label %astore\nbadarg:\n  %filled = add nuw i64 %i, 1\n  call void @bmb_argv_free(ptr %argv, i64 %filled)\n  ret i64 -1001\nastore:\n  %slot = add nuw i64 %i, 1\n  %sp = getelementptr inbounds ptr, ptr %argv, i64 %slot\n  store ptr %ca, ptr %sp\n  %i1 = add nuw i64 %i, 1\n  br label %ahead\naend:\n  %last = add nuw i64 %an, 1\n  %lastp = getelementptr inbounds ptr, ptr %argv, i64 %last\n  store ptr null, ptr %lastp\n  %fds = alloca [6 x i32]\n  %f_in = getelementptr inbounds [6 x i32], ptr %fds, i32 0, i32 0\n  %f_out = getelementptr inbounds [6 x i32], ptr %fds, i32 0, i32 2\n  %f_err = getelementptr inbounds [6 x i32], ptr %fds, i32 0, i32 4\n  %p1 = call i32 @pipe2(ptr %f_in, i32 524288)\n  %p2 = call i32 @pipe2(ptr %f_out, i32 524288)\n  %p3 = call i32 @pipe2(ptr %f_err, i32 524288)\n  %p12 = or i32 %p1, %p2\n  %p123 = or i32 %p12, %p3\n  %pipefail = icmp ne i32 %p123, 0\n  br i1 %pipefail, label %nopipe, label %spawn\nnopipe:\n  %pe = call i64 @bmb_errno()\n  call void @bmb_argv_free(ptr %argv, i64 %last)\n  ret i64 %pe\nspawn:\n  %in_r = load i32, ptr %f_in\n  %in_wp = getelementptr inbounds [6 x i32], ptr %fds, i32 0, i32 1\n  %in_w = load i32, ptr %in_wp\n  %out_r = load i32, ptr %f_out\n  %out_wp = getelementptr inbounds [6 x i32], ptr %fds, i32 0, i32 3\n  %out_w = load i32, ptr %out_wp\n  %err_r = load i32, ptr %f_err\n  %err_wp = getelementptr inbounds [6 x i32], ptr %fds, i32 0, i32 5\n  %err_w = load i32, ptr %err_wp\n  %fa = alloca [128 x i8]\n  call i32 @posix_spawn_file_actions_init(ptr %fa)\n  call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %in_r, i32 0)\n  call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %out_w, i32 1)\n  call i32 @posix_spawn_file_actions_adddup2(ptr %fa, i32 %err_w, i32 2)\n  %pid = alloca i32\n  %env = load ptr, ptr @environ\n  %attr = alloca [512 x i8], align 8\n  call void @bmb_spawn_attr(ptr %attr)\n  %rc = call i32 @posix_spawnp(ptr %pid, ptr %cprog, ptr %fa, ptr %attr, ptr %argv, ptr %env)\n  call i32 @posix_spawnattr_destroy(ptr %attr)\n  call i32 @posix_spawn_file_actions_destroy(ptr %fa)\n  call void @bmb_argv_free(ptr %argv, i64 %last)\n  call i32 @close(i32 %in_r)\n  call i32 @close(i32 %out_w)\n  call i32 @close(i32 %err_w)\n  %spawnfail = icmp ne i32 %rc, 0\n  br i1 %spawnfail, label %nospawn, label %started\nnospawn:\n  call i32 @close(i32 %in_w)\n  call i32 @close(i32 %out_r)\n  call i32 @close(i32 %err_r)\n  %rc64 = sext i32 %rc to i64\n  %se = sub i64 -1, %rc64\n  ret i64 %se\nstarted:\n  %so = getelementptr inbounds %\"std::process::Output\", ptr %out, i32 0, i32 1\n  %sr = getelementptr inbounds %\"std::process::Output\", ptr %out, i32 0, i32 2\n  call void @bmb_vec_alloc(ptr %so, i64 0, i64 1)\n  call void @bmb_vec_alloc(ptr %sr, i64 0, i64 1)\n  %win = alloca i32\n  %rout = alloca i32\n  %rerr = alloca i32\n  %off = alloca i64\n  store i32 %in_w, ptr %win\n  store i32 %out_r, ptr %rout\n  store i32 %err_r, ptr %rerr\n  store i64 0, ptr %off\n  %pfd = alloca [24 x i8]\n  %noinput = icmp eq i64 %inn, 0\n  br i1 %noinput, label %closein0, label %loop\nclosein0:\n  call i32 @close(i32 %in_w)\n  store i32 -1, ptr %win\n  br label %loop\nloop:\n  %w0 = load i32, ptr %win\n  %o0 = load i32, ptr %rout\n  %e0 = load i32, ptr %rerr\n  %wo = and i32 %w0, %o0\n  %woe = and i32 %wo, %e0\n  %allshut = icmp eq i32 %woe, -1\n  br i1 %allshut, label %wait, label %poll\npoll:\n  store i32 %w0, ptr %pfd\n  %ev0 = getelementptr inbounds i8, ptr %pfd, i64 4\n  store i16 4, ptr %ev0\n  %re0 = getelementptr inbounds i8, ptr %pfd, i64 6\n  store i16 0, ptr %re0\n  %fd1 = getelementptr inbounds i8, ptr %pfd, i64 8\n  store i32 %o0, ptr %fd1\n  %ev1 = getelementptr inbounds i8, ptr %pfd, i64 12\n  store i16 1, ptr %ev1\n  %re1 = getelementptr inbounds i8, ptr %pfd, i64 14\n  store i16 0, ptr %re1\n  %fd2 = getelementptr inbounds i8, ptr %pfd, i64 16\n  store i32 %e0, ptr %fd2\n  %ev2 = getelementptr inbounds i8, ptr %pfd, i64 20\n  store i16 1, ptr %ev2\n  %re2 = getelementptr inbounds i8, ptr %pfd, i64 22\n  store i16 0, ptr %re2\n  %pr = call i32 @poll(ptr %pfd, i64 3, i32 -1)\n  %pbad = icmp slt i32 %pr, 0\n  br i1 %pbad, label %loop, label %step_in\nstep_in:\n  %r0 = load i16, ptr %re0\n  %has0 = icmp ne i16 %r0, 0\n  %live0 = icmp sge i32 %w0, 0\n  %go0 = and i1 %has0, %live0\n  br i1 %go0, label %write, label %step_out\nwrite:\n  %o = load i64, ptr %off\n  %left = sub nuw i64 %inn, %o\n  %big = icmp ugt i64 %left, 4096\n  %chunk = select i1 %big, i64 4096, i64 %left\n  %at = getelementptr inbounds i8, ptr %in, i64 %o\n  %wr = call i64 @write(i32 %w0, ptr %at, i64 %chunk)\n  %wfail = icmp slt i64 %wr, 0\n  br i1 %wfail, label %werr, label %wrote\nwerr:\n  %wintr = call i1 @bmb_interrupted()\n  br i1 %wintr, label %step_out, label %closein\nwrote:\n  %o1 = add nuw i64 %o, %wr\n  store i64 %o1, ptr %off\n  %alldone = icmp eq i64 %o1, %inn\n  br i1 %alldone, label %closein, label %step_out\nclosein:\n  call i32 @close(i32 %w0)\n  store i32 -1, ptr %win\n  br label %step_out\nstep_out:\n  %r1 = load i16, ptr %re1\n  %has1 = icmp ne i16 %r1, 0\n  %live1 = icmp sge i32 %o0, 0\n  %go1 = and i1 %has1, %live1\n  br i1 %go1, label %readout, label %step_err\nreadout:\n  %g1 = call i64 @bmb_fd_read_some(i32 %o0, ptr %so)\n  %end1 = icmp sle i64 %g1, 0\n  br i1 %end1, label %closeout, label %step_err\ncloseout:\n  call i32 @close(i32 %o0)\n  store i32 -1, ptr %rout\n  br label %step_err\nstep_err:\n  %r2 = load i16, ptr %re2\n  %has2 = icmp ne i16 %r2, 0\n  %live2 = icmp sge i32 %e0, 0\n  %go2 = and i1 %has2, %live2\n  br i1 %go2, label %readerr, label %loop\nreaderr:\n  %g2 = call i64 @bmb_fd_read_some(i32 %e0, ptr %sr)\n  %end2 = icmp sle i64 %g2, 0\n  br i1 %end2, label %closeerr, label %loop\ncloseerr:\n  call i32 @close(i32 %e0)\n  store i32 -1, ptr %rerr\n  br label %loop\nwait:\n  %st = alloca i32\n  store i32 0, ptr %st\n  %pidv = load i32, ptr %pid\n  br label %waiting\nwaiting:\n  %wp = call i32 @waitpid(i32 %pidv, ptr %st, i32 0)\n  %wbad = icmp slt i32 %wp, 0\n  br i1 %wbad, label %waitretry, label %reaped\nwaitretry:\n  %wi = call i1 @bmb_interrupted()\n  br i1 %wi, label %waiting, label %reaped\nreaped:\n  %s = load i32, ptr %st\n  %sig = and i32 %s, 127\n  %exited = icmp eq i32 %sig, 0\n  %code = lshr i32 %s, 8\n  %code8 = and i32 %code, 255\n  %bysig = add nuw i32 %sig, 128\n  %status = select i1 %exited, i32 %code8, i32 %bysig\n  %stp = getelementptr inbounds %\"std::process::Output\", ptr %out, i32 0, i32 0\n  store i32 %status, ptr %stp\n  ret i64 0\n}\n")
    }

    #[effects(alloc)]
    fn sys_stdin() -> String {
        String::from("@stdin = external global ptr\ndeclare i32 @fgetc(ptr)\ndeclare i32 @ferror(ptr)\ndefine internal i1 @bmb_stdin_closed() {\n  %ep = call ptr @__errno_location()\n  %e = load i32, ptr %ep\n  %badf = icmp eq i32 %e, 9\n  ret i1 %badf\n}\ndefine internal i64 @bmb_stdin_line(ptr %h) {\nentry:\n  %f = load ptr, ptr @stdin\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  %start = load i64, ptr %lp\n  br label %next\nnext:\n  %c = call i32 @fgetc(ptr %f)\n  %eof = icmp slt i32 %c, 0\n  br i1 %eof, label %end, label %byte\nbyte:\n  %len = load i64, ptr %lp\n  %cap = load i64, ptr %cp\n  %full = icmp eq i64 %len, %cap\n  br i1 %full, label %grow, label %put\ngrow:\n  call void @bmb_vec_grow(ptr %h, i64 1)\n  br label %put\nput:\n  %buf = load ptr, ptr %h\n  %at = getelementptr inbounds i8, ptr %buf, i64 %len\n  %b = trunc i32 %c to i8\n  store i8 %b, ptr %at\n  %len1 = add nuw i64 %len, 1\n  store i64 %len1, ptr %lp\n  %nl = icmp eq i32 %c, 10\n  br i1 %nl, label %check, label %next\nend:\n  %err = call i32 @ferror(ptr %f)\n  %bad = icmp ne i32 %err, 0\n  br i1 %bad, label %which, label %check\nwhich:\n  %closed = call i1 @bmb_stdin_closed()\n  br i1 %closed, label %check, label %os\nos:\n  %ec = call i64 @bmb_errno()\n  %olen = load i64, ptr %lp\n  %on = sub nuw i64 %olen, %start\n  %obuf = load ptr, ptr %h\n  %ofrom = getelementptr inbounds i8, ptr %obuf, i64 %start\n  %okeep = call i1 @bmb_utf8_valid(ptr %ofrom, i64 %on)\n  br i1 %okeep, label %osdone, label %osdrop\nosdrop:\n  store i64 %start, ptr %lp\n  br label %osdone\nosdone:\n  ret i64 %ec\ncheck:\n  %len2 = load i64, ptr %lp\n  %n = sub nuw i64 %len2, %start\n  %buf2 = load ptr, ptr %h\n  %from = getelementptr inbounds i8, ptr %buf2, i64 %start\n  %valid = call i1 @bmb_utf8_valid(ptr %from, i64 %n)\n  br i1 %valid, label %done, label %invalid\ninvalid:\n  store i64 %start, ptr %lp\n  ret i64 -1\ndone:\n  ret i64 %n\n}\ndeclare i64 @fread(ptr, i64, i64, ptr)\ndefine internal i64 @bmb_stdin_all(ptr %h) {\nentry:\n  %f = load ptr, ptr @stdin\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  %start = load i64, ptr %lp\n  br label %next\nnext:\n  %len = load i64, ptr %lp\n  %cap = load i64, ptr %cp\n  %full = icmp eq i64 %len, %cap\n  br i1 %full, label %grow, label %read\ngrow:\n  call void @bmb_vec_grow(ptr %h, i64 1)\n  br label %read\nread:\n  %len1 = load i64, ptr %lp\n  %cap1 = load i64, ptr %cp\n  %room = sub nuw i64 %cap1, %len1\n  %buf = load ptr, ptr %h\n  %at = getelementptr inbounds i8, ptr %buf, i64 %len1\n  %got = call i64 @fread(ptr %at, i64 1, i64 %room, ptr %f)\n  %len2 = add nuw i64 %len1, %got\n  store i64 %len2, ptr %lp\n  %none = icmp eq i64 %got, 0\n  br i1 %none, label %end, label %next\nend:\n  %err = call i32 @ferror(ptr %f)\n  %bad = icmp ne i32 %err, 0\n  br i1 %bad, label %which, label %done\nwhich:\n  %closed = call i1 @bmb_stdin_closed()\n  br i1 %closed, label %done, label %os\nos:\n  %ec = call i64 @bmb_errno()\n  ret i64 %ec\ndone:\n  %len3 = load i64, ptr %lp\n  %n = sub nuw i64 %len3, %start\n  ret i64 %n\n}\n")
    }

    #[effects(alloc)]
    fn text_cmp() -> String {
        String::from("declare i32 @memcmp(ptr, ptr, i64)\ndefine internal i32 @bmb_str_cmp(ptr %a, i64 %la, ptr %b, i64 %lb) {\nentry:\n  %short = icmp ult i64 %la, %lb\n  %m = select i1 %short, i64 %la, i64 %lb\n  %z = icmp eq i64 %m, 0\n  br i1 %z, label %len, label %cmp\ncmp:\n  %c = call i32 @memcmp(ptr %a, ptr %b, i64 %m)\n  %ne = icmp ne i32 %c, 0\n  br i1 %ne, label %bytes, label %len\nbytes:\n  %neg = icmp slt i32 %c, 0\n  %r0 = select i1 %neg, i32 -1, i32 1\n  ret i32 %r0\nlen:\n  %long = icmp ugt i64 %la, %lb\n  %r1 = select i1 %short, i32 -1, i32 0\n  %r = select i1 %long, i32 1, i32 %r1\n  ret i32 %r\n}\n")
    }

    #[effects(alloc)]
    fn text_grow() -> String {
        String::from("define internal void @bmb_str_append(ptr %h, ptr %src, i64 %n) {\nentry:\n  %z = icmp eq i64 %n, 0\n  br i1 %z, label %done, label %go\ngo:\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  %len = load i64, ptr %lp\n  %cap = load i64, ptr %cp\n  %buf0 = load ptr, ptr %h\n  %b0 = ptrtoint ptr %buf0 to i64\n  %s0 = ptrtoint ptr %src to i64\n  %off = sub i64 %s0, %b0\n  %inside = icmp ult i64 %off, %cap\n  %need = add nuw i64 %len, %n\n  %fits = icmp ule i64 %need, %cap\n  br i1 %fits, label %copy, label %grow\ngrow:\n  %huge = icmp ugt i64 %need, 9223372036854775807\n  br i1 %huge, label %fail, label %room\nroom:\n  %d = shl i64 %cap, 1\n  %big = icmp ugt i64 %need, %d\n  %w0 = select i1 %big, i64 %need, i64 %d\n  %over = icmp ugt i64 %w0, 9223372036854775807\n  %w = select i1 %over, i64 9223372036854775807, i64 %w0\n  %small = icmp ult i64 %w, 8\n  %new = select i1 %small, i64 8, i64 %w\n  %p = call ptr @realloc(ptr %buf0, i64 %new)\n  %null = icmp eq ptr %p, null\n  br i1 %null, label %fail, label %grown\nfail:\n  call void @abort()\n  unreachable\ngrown:\n  store ptr %p, ptr %h\n  store i64 %new, ptr %cp\n  br label %copy\ncopy:\n  %buf = load ptr, ptr %h\n  %moved = getelementptr i8, ptr %buf, i64 %off\n  %from = select i1 %inside, ptr %moved, ptr %src\n  %dst = getelementptr inbounds i8, ptr %buf, i64 %len\n  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %from, i64 %n, i1 false)\n  store i64 %need, ptr %lp\n  br label %done\ndone:\n  ret void\n}\ndefine internal void @bmb_str_push_char(ptr %h, i64 %c) {\nentry:\n  %e = alloca [4 x i8]\n  %e1 = getelementptr inbounds [4 x i8], ptr %e, i64 0, i64 1\n  %e2 = getelementptr inbounds [4 x i8], ptr %e, i64 0, i64 2\n  %e3 = getelementptr inbounds [4 x i8], ptr %e, i64 0, i64 3\n  %x6 = lshr i64 %c, 6\n  %x12 = lshr i64 %c, 12\n  %x18 = lshr i64 %c, 18\n  %m0 = and i64 %c, 63\n  %m6 = and i64 %x6, 63\n  %m12 = and i64 %x12, 63\n  %k0 = or i64 %m0, 128\n  %k6 = or i64 %m6, 128\n  %k12 = or i64 %m12, 128\n  %t0 = trunc i64 %k0 to i8\n  %t6 = trunc i64 %k6 to i8\n  %t12 = trunc i64 %k12 to i8\n  %c1 = icmp ult i64 %c, 128\n  br i1 %c1, label %one, label %t2\none:\n  %a = trunc i64 %c to i8\n  store i8 %a, ptr %e\n  br label %put\nt2:\n  %c2 = icmp ult i64 %c, 2048\n  br i1 %c2, label %two, label %t3\ntwo:\n  %h2 = or i64 %x6, 192\n  %h2b = trunc i64 %h2 to i8\n  store i8 %h2b, ptr %e\n  store i8 %t0, ptr %e1\n  br label %put\nt3:\n  %c3 = icmp ult i64 %c, 65536\n  br i1 %c3, label %three, label %four\nthree:\n  %h3 = or i64 %x12, 224\n  %h3b = trunc i64 %h3 to i8\n  store i8 %h3b, ptr %e\n  store i8 %t6, ptr %e1\n  store i8 %t0, ptr %e2\n  br label %put\nfour:\n  %h4 = or i64 %x18, 240\n  %h4b = trunc i64 %h4 to i8\n  store i8 %h4b, ptr %e\n  store i8 %t12, ptr %e1\n  store i8 %t6, ptr %e2\n  store i8 %t0, ptr %e3\n  br label %put\nput:\n  %n = phi i64 [1, %one], [2, %two], [3, %three], [4, %four]\n  call void @bmb_str_append(ptr %h, ptr %e, i64 %n)\n  ret void\n}\n")
    }

    #[effects(alloc)]
    fn text_utf8() -> String {
        String::from("define internal i1 @bmb_utf8_valid(ptr %p, i64 %n) {\nentry:\n  br label %head\nhead:\n  %i = phi i64 [0, %entry], [%i1, %ascii], [%end, %next]\n  %fin = icmp uge i64 %i, %n\n  br i1 %fin, label %yes, label %lead\nlead:\n  %q0 = getelementptr inbounds i8, ptr %p, i64 %i\n  %b8 = load i8, ptr %q0\n  %b = zext i8 %b8 to i32\n  %i1 = add nuw i64 %i, 1\n  %isa = icmp ult i32 %b, 128\n  br i1 %isa, label %ascii, label %multi\nascii:\n  br label %head\nmulti:\n  %ge2 = icmp uge i32 %b, 194\n  %le2 = icmp ule i32 %b, 223\n  %l2 = and i1 %ge2, %le2\n  %ge3 = icmp uge i32 %b, 224\n  %le3 = icmp ule i32 %b, 239\n  %l3 = and i1 %ge3, %le3\n  %ge4 = icmp uge i32 %b, 240\n  %le4 = icmp ule i32 %b, 244\n  %l4 = and i1 %ge4, %le4\n  %s4 = select i1 %l4, i64 4, i64 0\n  %s3 = select i1 %l3, i64 3, i64 %s4\n  %len = select i1 %l2, i64 2, i64 %s3\n  %bad = icmp eq i64 %len, 0\n  br i1 %bad, label %no, label %fit\nfit:\n  %end = add nuw i64 %i, %len\n  %over = icmp ugt i64 %end, %n\n  br i1 %over, label %no, label %second\nsecond:\n  %e0 = icmp eq i32 %b, 224\n  %f0 = icmp eq i32 %b, 240\n  %ed = icmp eq i32 %b, 237\n  %f4 = icmp eq i32 %b, 244\n  %lo1 = select i1 %f0, i32 144, i32 128\n  %lo = select i1 %e0, i32 160, i32 %lo1\n  %hi1 = select i1 %f4, i32 143, i32 191\n  %hi = select i1 %ed, i32 159, i32 %hi1\n  %q1 = getelementptr inbounds i8, ptr %p, i64 %i1\n  %c18 = load i8, ptr %q1\n  %c1 = zext i8 %c18 to i32\n  %okl = icmp uge i32 %c1, %lo\n  %okh = icmp ule i32 %c1, %hi\n  %ok1 = and i1 %okl, %okh\n  br i1 %ok1, label %third, label %no\nthird:\n  %need3 = icmp uge i64 %len, 3\n  br i1 %need3, label %t3, label %next\nt3:\n  %i2 = add nuw i64 %i, 2\n  %q2 = getelementptr inbounds i8, ptr %p, i64 %i2\n  %c28 = load i8, ptr %q2\n  %c2 = and i8 %c28, -64\n  %ok2 = icmp eq i8 %c2, -128\n  br i1 %ok2, label %fourth, label %no\nfourth:\n  %need4 = icmp eq i64 %len, 4\n  br i1 %need4, label %t4, label %next\nt4:\n  %i3 = add nuw i64 %i, 3\n  %q3 = getelementptr inbounds i8, ptr %p, i64 %i3\n  %c38 = load i8, ptr %q3\n  %c3 = and i8 %c38, -64\n  %ok3 = icmp eq i8 %c3, -128\n  br i1 %ok3, label %next, label %no\nnext:\n  br label %head\nyes:\n  ret i1 true\nno:\n  ret i1 false\n}\n")
    }

    #[effects(alloc)]
    fn vec_runtime() -> String {
        String::from("declare ptr @realloc(ptr, i64)\ndefine internal i64 @bmb_vec_bytes(i64 %n, i64 %size) {\nentry:\n  %p = call {i64, i1} @llvm.umul.with.overflow.i64(i64 %n, i64 %size)\n  %b = extractvalue {i64, i1} %p, 0\n  %o = extractvalue {i64, i1} %p, 1\n  %big = icmp ugt i64 %b, 9223372036854775807\n  %bad = or i1 %o, %big\n  br i1 %bad, label %fail, label %ok\nfail:\n  call void @abort()\n  unreachable\nok:\n  ret i64 %b\n}\ndefine internal void @bmb_vec_alloc(ptr %h, i64 %n, i64 %size) {\nentry:\n  %lp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 1\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  store i64 0, ptr %lp\n  %z = icmp eq i64 %n, 0\n  br i1 %z, label %empty, label %some\nempty:\n  store ptr null, ptr %h\n  store i64 0, ptr %cp\n  ret void\nsome:\n  %b = call i64 @bmb_vec_bytes(i64 %n, i64 %size)\n  %p = call ptr @malloc(i64 %b)\n  %null = icmp eq ptr %p, null\n  br i1 %null, label %fail, label %ok\nfail:\n  call void @abort()\n  unreachable\nok:\n  store ptr %p, ptr %h\n  store i64 %n, ptr %cp\n  ret void\n}\ndefine internal void @bmb_vec_grow(ptr %h, i64 %size) {\nentry:\n  %cp = getelementptr inbounds %bmb.vec, ptr %h, i32 0, i32 2\n  %cap = load i64, ptr %cp\n  %z = icmp eq i64 %cap, 0\n  %d = shl i64 %cap, 1\n  %new = select i1 %z, i64 4, i64 %d\n  %b = call i64 @bmb_vec_bytes(i64 %new, i64 %size)\n  %buf = load ptr, ptr %h\n  %p = call ptr @realloc(ptr %buf, i64 %b)\n  %null = icmp eq ptr %p, null\n  br i1 %null, label %fail, label %ok\nfail:\n  call void @abort()\n  unreachable\nok:\n  store ptr %p, ptr %h\n  store i64 %new, ptr %cp\n  ret void\n}\ndefine internal void @bmb_vec_clone(ptr %dst, ptr %src, i64 %size) {\nentry:\n  %slp = getelementptr inbounds %bmb.vec, ptr %src, i32 0, i32 1\n  %len = load i64, ptr %slp\n  call void @bmb_vec_alloc(ptr %dst, i64 %len, i64 %size)\n  %db = load ptr, ptr %dst\n  %sb = load ptr, ptr %src\n  %bytes = mul nuw i64 %len, %size\n  call void @llvm.memcpy.p0.p0.i64(ptr %db, ptr %sb, i64 %bytes, i1 false)\n  %dlp = getelementptr inbounds %bmb.vec, ptr %dst, i32 0, i32 1\n  store i64 %len, ptr %dlp\n  ret void\n}\n")
    }
}
