#[summary("unit u7")]
mod u7 {
    spec fn d079(a: &[i64], n: usize) -> bool {
        forall|k: usize| k + 1 < n ==> #[trigger] a[k] <= a[k + 1]
    }

    spec fn d080(a: &[i64], r: bool) -> bool {
        r == (forall|k: usize| k + 1 < a.len() ==> #[trigger] a[k] <= a[k + 1])
    }

    #[effects(pure)]
    #[uses(d082)]
    fn d081(a: &[i64]) -> (r: usize)
        ensures d082(a, r),
    {
        let mut c: usize = 0;
        let mut k: usize = 1;
        while k < a.len()
            invariant 1 <= k, c < k, k <= a.len() || k == 1,
            decreases a.len() - k,
        {
            if a[k - 1] > a[k] {
                c = c + 1;
            }
            k = k + 1;
        }
        c
    }

    spec fn d082(a: &[i64], r: usize) -> bool {
        r <= a.len()
    }

    spec fn d083(a: &[i64], from: usize) -> bool {
        from < a.len()
    }

    #[effects(pure)]
    #[uses(d079, d080)]
    fn d084(a: &[i64]) -> (r: bool)
        ensures d080(a, r),
    {
        let mut k: usize = 1;
        while k < a.len() && a[k - 1] <= a[k]
            invariant 1 <= k, k <= a.len() || a.len() == 0, d079(a, k),
            decreases a.len() - k,
        {
            k = k + 1;
        }
        k >= a.len()
    }

    spec fn d085(a: &[i64], from: usize, n: usize, r: usize) -> bool {
        from <= r && r < n && (forall|k: usize| from <= k && k < n ==> a[r] <= #[trigger] a[k])
    }

    #[effects(pure)]
    #[uses(d083, d085, d087)]
    fn d086(a: &[i64], from: usize) -> (r: usize)
        requires d083(a, from),
        ensures d087(a, from, r),
    {
        let mut best: usize = from;
        let mut k: usize = from + 1;
        while k < a.len()
            invariant k <= a.len(), d085(a, from, k, best),
            decreases a.len() - k,
        {
            if a[k] < a[best] {
                best = k;
            }
            k = k + 1;
        }
        best
    }

    spec fn d087(a: &[i64], from: usize, r: usize) -> bool {
        from <= r && r < a.len() && (forall|k: usize| from <= k && k < a.len() ==> a[r] <= #[trigger] a[k])
    }

    #[effects(pure)]
    #[uses(u3::d028, d083, d087)]
    fn d088(a: &mut [i64], i: usize) -> ()
        requires d083(a, i),
    {
        let j: usize = d086(a, i);
        u3::d035(a, i, j);
    }

    #[effects(pure)]
    #[uses(d083)]
    fn d089(a: &mut [i64]) -> () {
        let mut i: usize = 0;
        while i < a.len()
            invariant i <= a.len(),
            decreases a.len() - i,
        {
            d088(a, i);
            i = i + 1;
        }
    }

    spec fn d090(a: &[i64]) -> bool {
        forall|i: usize, j: usize| i < j && j < a.len() ==> #[trigger] a[i] <= #[trigger] a[j]
    }
}
