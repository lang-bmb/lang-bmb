#[summary("unit u6")]
mod u6 {
    #[effects(pure)]
    #[uses(d066, d077)]
    fn d062(x: i64) -> (r: i64)
        requires d077(x),
        ensures d066(x, r),
    {
        if x < 0 {
            0 - x
        } else {
            x
        }
    }

    #[effects(pure)]
    #[uses(d069, d077)]
    fn d063(a: i64, b: i64) -> (r: i64)
        requires d077(a), d077(b),
        ensures d069(a, b, r),
    {
        a + b
    }

    #[effects(pure)]
    #[uses(d065, d074)]
    fn d064(x: i64, lo: i64, hi: i64) -> (r: i64)
        requires d074(lo, hi),
        ensures d065(r, lo, hi),
    {
        if x < lo {
            lo
        } else {
            if x > hi {
                hi
            } else {
                x
            }
        }
    }

    spec fn d065(x: i64, lo: i64, hi: i64) -> bool {
        lo <= x && x <= hi
    }

    spec fn d066(x: i64, r: i64) -> bool {
        r >= 0 && (r == x || r == -x)
    }

    spec fn d067(a: i64, b: i64, r: i64) -> bool {
        r >= a && r >= b && (r == a || r == b)
    }

    spec fn d068(a: i64, b: i64, r: i64) -> bool {
        r <= a && r <= b && (r == a || r == b)
    }

    spec fn d069(a: i64, b: i64, r: i64) -> bool {
        r == a + b
    }

    #[effects(pure)]
    #[uses(d067)]
    fn d070(a: i64, b: i64) -> (r: i64)
        ensures d067(a, b, r),
    {
        if a >= b {
            a
        } else {
            b
        }
    }

    #[effects(pure)]
    #[uses(d065, d074, d077)]
    fn d071(lo: i64, hi: i64) -> (r: i64)
        requires d077(lo), d077(hi), d074(lo, hi),
        ensures d065(r, lo, hi),
    {
        lo + (hi - lo) / 2
    }

    #[effects(pure)]
    #[uses(d068)]
    fn d072(a: i64, b: i64) -> (r: i64)
        ensures d068(a, b, r),
    {
        if a <= b {
            a
        } else {
            b
        }
    }

    spec fn d073(x: i64) -> bool {
        x >= 0
    }

    spec fn d074(lo: i64, hi: i64) -> bool {
        lo <= hi
    }

    #[effects(pure)]
    #[uses(d076)]
    fn d075(x: i64) -> (r: i64)
        ensures d076(x, r),
    {
        if x > 0 {
            1
        } else {
            if x < 0 {
                -1
            } else {
                0
            }
        }
    }

    spec fn d076(x: i64, r: i64) -> bool {
        (x > 0 ==> r == 1) && (x == 0 ==> r == 0) && (x < 0 ==> r == -1)
    }

    spec fn d077(x: i64) -> bool {
        -1000000000 <= x && x <= 1000000000
    }

    #[effects(pure)]
    #[uses(d077)]
    fn d078(a: i64, b: i64) -> i64
        requires d077(a), d077(b),
    {
        a - b
    }
}
