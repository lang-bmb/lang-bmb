{"id": "t17-isqrt", "arm": "bmb", "agent": "openai:qwen3.8-27b", "success": true, "defect": false, "delivered": true, "verified": true, "domain_ok": true, "cases": 442, "passed": 442, "failed": 0, "fail_kinds": {}, "failing": [], "tool_calls": 17, "tool_seconds": 0.55, "checks": 2, "last_check_ok": true, "limit_hit": null, "tool_counts": {"query": 4, "tx_begin": 2, "tx_unit": 1, "tx_put": 6, "tx_commit": 2, "verify": 2}, "commits_ok": 2, "commits_rejected": 0, "final_check_ok": true, "final_sources": {"src/tasks.bmb": "#[summary(\"integer square root: isqrt(n) is the largest r >= 0 with r*r <= n\")]\nmod tasks {\n    spec fn hi_ok(n: i64, hi: i64) -> bool {\n        hi <= 3037000500 && n < hi * hi\n    }\n\n    #[effects(pure)]\n    #[uses(hi_ok, isqrt_spec, lo_ok, nonneg)]\n    fn isqrt(n: i64) -> (r: i64)\n        requires nonneg(n),\n        ensures isqrt_spec(n, r),\n    {\n        let mut lo: i64 = 0;\n        let mut hi: i64 = 3037000500;\n        while lo + 1 < hi\n            invariant lo_ok(n, lo), hi_ok(n, hi), lo < hi,\n            decreases hi - lo,\n        {\n            let mid: i64 = (lo + hi) / 2;\n            if mid * mid <= n {\n                lo = mid;\n            } else {\n                hi = mid;\n            }\n        }\n        lo\n    }\n\n    spec fn isqrt_spec(n: i64, r: i64) -> bool {\n        r >= 0 && r * r <= n && (r + 1) * (r + 1) > n\n    }\n\n    spec fn lo_ok(n: i64, lo: i64) -> bool {\n        lo >= 0 && lo * lo <= n\n    }\n\n    spec fn nonneg(n: i64) -> bool {\n        n >= 0\n    }\n}\n"}, "test_code": {"test_needed_defs": 0, "test_sites": 0, "test_lines": 0}, "session_seconds": 619.73, "judge_seconds": 0.53, "model_usage": {"input_tokens": 43602, "output_tokens": 61665, "requests": 12, "visible_output_tokens": 1188}, "total_tokens": 105267, "agent_settings": {"model": "qwen3.8-27b", "api": "openai-chat", "max_tokens": 32768, "reasoning": "model default", "length": "continue once per turn"}, "stop": "stop"}
