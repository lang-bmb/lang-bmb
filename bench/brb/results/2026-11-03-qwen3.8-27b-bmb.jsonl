{"id": "t01-clamp", "arm": "bmb", "agent": "openai:qwen3.8-27b", "success": true, "defect": false, "delivered": true, "verified": true, "domain_ok": true, "cases": 436, "passed": 436, "failed": 0, "fail_kinds": {}, "failing": [], "tool_calls": 18, "tool_seconds": 0.08, "checks": 1, "last_check_ok": true, "limit_hit": null, "tool_counts": {"tx_begin": 2, "query": 4, "tx_unit": 2, "tx_put": 6, "tx_commit": 2, "map": 1, "verify": 1}, "commits_ok": 1, "commits_rejected": 1, "final_check_ok": true, "final_sources": {"src/tasks.bmb": "#[summary(\"clamp: limit x to the closed range [lo, hi]\")]\nmod tasks {\n    #[effects(pure)]\n    #[uses(clamped, lo_le_hi)]\n    fn clamp(x: i64, lo: i64, hi: i64) -> (r: i64)\n        requires lo_le_hi(lo, hi),\n        ensures clamped(r, x, lo, hi),\n    {\n        if x < lo {\n            lo\n        } else if x > hi {\n            hi\n        } else {\n            x\n        }\n    }\n\n    spec fn clamped(r: i64, x: i64, lo: i64, hi: i64) -> bool {\n        x < lo && r == lo || x > hi && r == hi || lo <= x && x <= hi && r == x\n    }\n\n    spec fn lo_le_hi(lo: i64, hi: i64) -> bool {\n        lo <= hi\n    }\n}\n"}, "test_code": {"test_needed_defs": 0, "test_sites": 0, "test_lines": 0}, "session_seconds": 66.9, "judge_seconds": 2.52, "model_usage": {"input_tokens": 57127, "output_tokens": 5440, "requests": 17, "visible_output_tokens": 786}, "total_tokens": 62567, "agent_settings": {"model": "qwen3.8-27b", "api": "openai-chat", "max_tokens": 32768, "reasoning": "model default", "length": "continue once per turn"}, "stop": "stop"}
{"id": "t02-midpoint", "arm": "bmb", "agent": "openai:qwen3.8-27b", "success": true, "defect": false, "delivered": true, "verified": true, "domain_ok": true, "cases": 810, "passed": 810, "failed": 0, "fail_kinds": {}, "failing": [], "tool_calls": 13, "tool_seconds": 0.44, "checks": 1, "last_check_ok": true, "limit_hit": null, "tool_counts": {"query": 1, "tx_begin": 2, "tx_unit": 2, "tx_put": 5, "tx_commit": 2, "verify": 1}, "commits_ok": 1, "commits_rejected": 1, "final_check_ok": true, "final_sources": {"src/tasks.bmb": "#[summary(\"Exact floored midpoint of two i64 values\")]\nmod tasks {\n    spec fn is_mid(a: i64, b: i64, r: i64) -> bool {\n        2 * r <= a + b && a + b < 2 * r + 2\n    }\n\n    #[effects(pure)]\n    #[uses(is_mid)]\n    fn midpoint(a: i64, b: i64) -> (r: i64)\n        ensures is_mid(a, b, r),\n    {\n        let da: i64 = a / 2;\n        let db: i64 = b / 2;\n        let ra: i64 = a % 2;\n        let rb: i64 = b % 2;\n        let s: i64 = ra + rb;\n        let adj: i64 = if s < 0 {\n            (s - 1) / 2\n        } else {\n            s / 2\n        };\n        da + db + adj\n    }\n}\n"}, "test_code": {"test_needed_defs": 0, "test_sites": 0, "test_lines": 0}, "session_seconds": 445.74, "judge_seconds": 0.54, "model_usage": {"input_tokens": 45726, "output_tokens": 42625, "requests": 13, "visible_output_tokens": 1250}, "total_tokens": 88351, "agent_settings": {"model": "qwen3.8-27b", "api": "openai-chat", "max_tokens": 32768, "reasoning": "model default", "length": "continue once per turn"}, "stop": "stop"}
{"id": "t03-sat-sum", "arm": "bmb", "agent": "openai:qwen3.8-27b", "success": true, "defect": false, "delivered": true, "verified": true, "domain_ok": true, "cases": 289, "passed": 289, "failed": 0, "fail_kinds": {}, "failing": [], "tool_calls": 30, "tool_seconds": 0.36, "checks": 1, "last_check_ok": true, "limit_hit": null, "tool_counts": {"tx_begin": 3, "tx_unit": 2, "tx_put": 18, "tx_commit": 3, "tx_abort": 1, "verify": 1, "query": 2}, "commits_ok": 1, "commits_rejected": 2, "final_check_ok": true, "final_sources": {"src/tasks.bmb": "#[summary(\"Saturating left-to-right sum of an i64 slice\")]\nmod tasks {\n    #[uses(sat_add_spec)]\n    spec fn fold_sat(a: &[i64], n: usize) -> i64\n        decreases n,\n    {\n        if n == 0 {\n            0\n        } else {\n            sat_add_spec(fold_sat(a, n - 1), a[n - 1])\n        }\n    }\n\n    spec fn inv_acc(a: &[i64], acc: i64, i: usize) -> bool {\n        acc == fold_sat(a, i)\n    }\n\n    spec fn inv_range(a: &[i64], i: usize) -> bool {\n        i <= a.len()\n    }\n\n    spec fn sat_add_spec(x: i64, y: i64) -> i64 {\n        if x > 0 {\n            if y > i64::MAX - x {\n                i64::MAX\n            } else {\n                x + y\n            }\n        } else if x < 0 {\n            if y < i64::MIN - x {\n                i64::MIN\n            } else {\n                x + y\n            }\n        } else {\n            y\n        }\n    }\n\n    #[effects(pure)]\n    #[uses(fold_sat, inv_acc, inv_range, sat_add_spec, sat_sum_res)]\n    fn sat_sum(a: &[i64]) -> (r: i64)\n        ensures sat_sum_res(a, r),\n    {\n        let mut acc: i64 = 0;\n        let mut i: usize = 0;\n        while i < a.len()\n            invariant inv_range(a, i), inv_acc(a, acc, i),\n            decreases a.len() - i,\n        {\n            let y: i64 = a[i];\n            let cur: i64 = acc;\n            if cur > 0 {\n                if y > i64::MAX - cur {\n                    acc = i64::MAX;\n                } else {\n                    acc = cur + y;\n                }\n            } else if cur < 0 {\n                if y < i64::MIN - cur {\n                    acc = i64::MIN;\n                } else {\n                    acc = cur + y;\n                }\n            } else {\n                acc = cur + y;\n            }\n            assert(acc == sat_add_spec(cur, y));\n            i = i + 1;\n        }\n        acc\n    }\n\n    spec fn sat_sum_res(a: &[i64], r: i64) -> bool {\n        r == fold_sat(a, a.len())\n    }\n}\n"}, "test_code": {"test_needed_defs": 0, "test_sites": 0, "test_lines": 0}, "session_seconds": 706.16, "judge_seconds": 0.62, "model_usage": {"input_tokens": 79122, "output_tokens": 67816, "requests": 15, "visible_output_tokens": 2807}, "total_tokens": 146938, "agent_settings": {"model": "qwen3.8-27b", "api": "openai-chat", "max_tokens": 32768, "reasoning": "model default", "length": "continue once per turn"}, "stop": "stop"}
