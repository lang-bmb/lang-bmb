#[summary("유계 정수 산술")]
mod num {
    #[effects(pure)]
    #[uses(is_abs, small)]
    fn abs_small(x: i64) -> (r: i64)
        requires small(x),
        ensures is_abs(x, r),
    {
        if x < 0 {
            0 - x
        } else {
            x
        }
    }

    #[effects(pure)]
    #[uses(is_sum, small)]
    fn add_small(a: i64, b: i64) -> (r: i64)
        requires small(a), small(b),
        ensures is_sum(a, b, r),
    {
        a + b
    }

    #[effects(pure)]
    #[uses(in_closed, ordered)]
    fn clamp(x: i64, lo: i64, hi: i64) -> (r: i64)
        requires ordered(lo, hi),
        ensures in_closed(r, lo, hi),
    {
        if x < lo {
            lo
        } else {
            if x > hi {
                hi
            } else {
                x
            }
        }
    }

    spec fn in_closed(x: i64, lo: i64, hi: i64) -> bool {
        lo <= x && x <= hi
    }

    spec fn is_abs(x: i64, r: i64) -> bool {
        r >= 0 && (r == x || r == -x)
    }

    spec fn is_max2(a: i64, b: i64, r: i64) -> bool {
        r >= a && r >= b && (r == a || r == b)
    }

    spec fn is_min2(a: i64, b: i64, r: i64) -> bool {
        r <= a && r <= b && (r == a || r == b)
    }

    spec fn is_sum(a: i64, b: i64, r: i64) -> bool {
        r == a + b
    }

    #[effects(pure)]
    #[uses(is_max2)]
    fn max2(a: i64, b: i64) -> (r: i64)
        ensures is_max2(a, b, r),
    {
        if a >= b {
            a
        } else {
            b
        }
    }

    #[effects(pure)]
    #[uses(in_closed, ordered, small)]
    fn mid(lo: i64, hi: i64) -> (r: i64)
        requires small(lo), small(hi), ordered(lo, hi),
        ensures in_closed(r, lo, hi),
    {
        lo + (hi - lo) / 2
    }

    #[effects(pure)]
    #[uses(is_min2)]
    fn min2(a: i64, b: i64) -> (r: i64)
        ensures is_min2(a, b, r),
    {
        if a <= b {
            a
        } else {
            b
        }
    }

    spec fn nonneg(x: i64) -> bool {
        x >= 0
    }

    spec fn ordered(lo: i64, hi: i64) -> bool {
        lo <= hi
    }

    #[effects(pure)]
    #[uses(sign_ok)]
    fn sign(x: i64) -> (r: i64)
        ensures sign_ok(x, r),
    {
        if x > 0 {
            1
        } else {
            if x < 0 {
                -1
            } else {
                0
            }
        }
    }

    spec fn sign_ok(x: i64, r: i64) -> bool {
        (x > 0 ==> r == 1) && (x == 0 ==> r == 0) && (x < 0 ==> r == -1)
    }

    spec fn small(x: i64) -> bool {
        -1000000000 <= x && x <= 1000000000
    }

    #[effects(pure)]
    #[uses(small)]
    fn sub_small(a: i64, b: i64) -> i64
        requires small(a), small(b),
    {
        a - b
    }
}
