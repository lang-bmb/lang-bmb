      {"what": "m1b-write-lean, bvb-write-lean", "model": "sonnet", "times": 1, "like": ["bench/m1b-write/results/*sonnet*.jsonl", "bench/bvb-write/results/*sonnet*.jsonl"], "sum": true, "proxy": "원판"}
    ]},
    {"task": "T0-15", "tier": "조정 가설", "runs": [
