      {"what": "brb-write 반복 1~5", "model": "qwen", "times": 5, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"]},
      {"what": "bvb 반복 1~5", "model": "qwen", "times": 5, "like": ["bench/bvb/results/*-qwen3.8-27b.jsonl"]},
      {"what": "brb BMB 팔 반복 1~5", "model": "qwen", "times": 5, "like": ["bench/brb/results/*qwen*-bmb.jsonl"]}
    ]},
    {"task": "T0-37", "tier": "조정 가설", "runs": [
      {"what": "bvb-write 원판(같은 커밋)", "model": "qwen", "times": 1, "like": ["bench/bvb-write/results/*qwen*.jsonl"]},
      {"what": "bvb-write-{undecided,probe,stateless}", "model": "qwen", "times": 3, "like": ["bench/bvb-write/results/*qwen*.jsonl"], "proxy": "bvb-write"},
      {"what": "brb-write 원판(같은 커밋)", "model": "qwen", "times": 1, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"]},
      {"what": "brb-write-{undecided,probe,stateless}", "model": "qwen", "times": 3, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"], "proxy": "brb-write"}
    ]},
    {"task": "2D-39", "tier": "조정 가설", "runs": [
      {"what": "BNB N=10,000 원판과 창 16K·32K", "model": "qwen", "times": 3, "like": ["bench/bnb/results/3a06/qwen-bmb-10k*.jsonl"], "proxy": "BNB 원판"},
      {"what": "BNB N=10,000 원판과 창 16K·32K", "model": "sonnet", "times": 3, "like": ["bench/bnb/results/3a06/sonnet-bmb-10k*.jsonl"], "proxy": "BNB 원판"}
    ]},
    {"task": "T0-17", "tier": "조정 가설", "runs": [
