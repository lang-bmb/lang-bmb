{
  "_about": "What waits for the measurement machine, in the order of docs/ROADMAP.md \"우선순위\" 1 (backlog INF-39). `like` names committed result files of the same kind of run; a run's tokens are estimated as their mean. `proxy` says those files are another set or surface, not this one.",
  "entries": [
    {"task": "T0-08", "tier": "임계 경로(관문 B)", "runs": [
      {"what": "brb-hard BMB 팔, 반복 3", "model": "qwen", "times": 1, "like": ["bench/brb-hard/results/*-qwen-r*-bmb.jsonl"]},
      {"what": "brb-hard Rust 팔, 반복 3", "model": "qwen", "times": 1, "like": ["bench/brb-hard/results/*-qwen-r*-rust.jsonl"]}
    ]},
    {"task": "2A-14e", "tier": "임계 경로(관문 B)", "runs": [
      {"what": "BCB N=1,000 (모델 없음, CPU)", "model": "-", "times": 1, "cpu": true}
    ]},
    {"task": "T1-41", "tier": "임계 경로(관문 B)", "runs": [
      {"what": "m1b-diff", "model": "qwen", "times": 1, "like": ["bench/m1b-write/results/*qwen*.jsonl"], "proxy": "m1b-write"},
      {"what": "m1b-ast", "model": "qwen", "times": 1, "like": ["bench/m1b-write/results/*qwen*.jsonl"], "proxy": "m1b-write"},
      {"what": "bvb-diff", "model": "qwen", "times": 1, "like": ["bench/bvb-write/results/*qwen*.jsonl"], "proxy": "bvb-write"},
      {"what": "bvb-ast", "model": "qwen", "times": 1, "like": ["bench/bvb-write/results/*qwen*.jsonl"], "proxy": "bvb-write"},
      {"what": "brb-diff", "model": "qwen", "times": 1, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"], "proxy": "brb-write"},
      {"what": "brb-ast", "model": "qwen", "times": 1, "like": ["bench/brb-write/results/*qwen*-bmb.jsonl"], "proxy": "brb-write"}
    ]},
    {"task": "T0-41", "tier": "관문 B의 판정 품질", "runs": [
      {"what": "m1b-write 반복 2~4", "model": "sonnet", "times": 3, "like": ["bench/m1b-write/results/*sonnet*.jsonl"]}
    ]},
    {"task": "T0-33", "tier": "관문 B의 판정 품질", "runs": [
