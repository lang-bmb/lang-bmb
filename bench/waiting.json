      {"what": "m1b-write-compact, bvb-write-compact와 원판", "model": "sonnet", "times": 2, "like": ["bench/m1b-write/results/*sonnet*.jsonl", "bench/bvb-write/results/*sonnet*.jsonl"], "sum": true, "proxy": "원판"}
    ]},
    {"task": "T1-44", "tier": "보조 가설", "runs": [
