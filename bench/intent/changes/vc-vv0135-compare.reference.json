 "after": "#[summary(\"과제 구현\")]\nmod tasks {\n    spec fn result_ok(a: i64, b: i64, r: bool) -> bool { (a == b ==> r == true) && (a != b ==> r == false) }\n\n    #[effects(pure)]\n    #[uses(result_ok)]\n    fn compare(a: i64, b: i64) -> (r: bool)\n        ensures result_ok(a, b, r),\n    {\n        a == b\n    }\n}\n",
