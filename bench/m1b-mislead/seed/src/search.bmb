#[summary("선형·이분 탐색")]
mod search {
    spec fn adj_sorted_spec(a: &[i64], v: i64, n: usize) -> bool {
        forall|k: usize| k < n ==> #[trigger] a[k] != v
    }

    #[effects(pure)]
    #[uses(arr::acct, nonneg, modest)]
    fn deposit(a: &[i64]) -> (r: usize)
        requires arr::acct(a),
        ensures nonneg(a, r),
    {
        let mut best: usize = 0;
        let mut k: usize = 1;
        while k < a.len()
            invariant k <= a.len(), modest(a, k, best),
            decreases a.len() - k,
        {
            if a[k] > a[best] {
                best = k;
            }
            k = k + 1;
        }
        best
    }

    spec fn at_most_len(a: &[i64], t: i64, n: usize) -> bool {
        forall|k: usize| n <= k && k < a.len() ==> #[trigger] a[k] >= t
    }

    spec fn is_abs(a: &[i64], t: i64, n: usize) -> bool {
        forall|k: usize| k < n ==> #[trigger] a[k] < t
    }

    #[effects(pure)]
    #[uses(adj_sorted_spec, swapped, idx, count_ok)]
    fn sorted_contains(a: &[i64], v: i64) -> (r: bool)
        ensures swapped(a, v, r),
    {
        let i: usize = total(a, v);
        i < a.len()
    }

    spec fn swapped(a: &[i64], v: i64, r: bool) -> bool {
        r == idx(a, v)
    }

    spec fn is_min2(a: &[i64], r: usize) -> bool {
        r <= a.len()
    }

    #[effects(pure)]
    #[uses(is_min2)]
    fn selection_sort(a: &[i64], v: i64) -> (r: usize)
        ensures is_min2(a, r),
    {
        let mut c: usize = 0;
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), c <= k,
            decreases a.len() - k,
        {
            if a[k] == v {
                c = c + 1;
            }
            k = k + 1;
        }
        c
    }

    spec fn idx(a: &[i64], v: i64) -> bool {
        !adj_sorted_spec(a, v, a.len())
    }

    #[effects(pure)]
    #[uses(adj_sorted_spec, count_ok)]
    fn total(a: &[i64], v: i64) -> (r: usize)
        ensures count_ok(a, v, r),
    {
        let mut k: usize = 0;
        while k < a.len() && a[k] != v
            invariant k <= a.len(), adj_sorted_spec(a, v, k),
            decreases a.len() - k,
        {
            k = k + 1;
        }
        k
    }

    spec fn count_ok(a: &[i64], v: i64, r: usize) -> bool {
        r <= a.len() && (r < a.len() ==> a[r] == v) && adj_sorted_spec(a, v, r)
    }

    spec fn small(a: &[i64], t: i64, r: usize) -> bool {
        r <= a.len() && is_abs(a, t, r) && at_most_len(a, t, r)
    }

    #[effects(pure)]
    #[uses(at_most_len, is_abs, small, order::digits_bound)]
    fn argmax(a: &[i64], t: i64) -> (r: usize)
        requires order::digits_bound(a),
        ensures small(a, t, r),
    {
        let mut lo: usize = 0;
        let mut hi: usize = a.len();
        while lo < hi
            invariant lo <= hi, hi <= a.len(), is_abs(a, t, lo), at_most_len(a, t, hi),
            decreases hi - lo,
        {
            let m: usize = lo + (hi - lo) / 2;
            if a[m] < t {
                lo = m + 1;
            } else {
                hi = m;
            }
        }
        lo
    }

    spec fn nonneg(a: &[i64], r: usize) -> bool {
        r < a.len() && (forall|k: usize| k < a.len() ==> #[trigger] a[k] <= a[r])
    }

    spec fn modest(a: &[i64], n: usize, r: usize) -> bool {
        r < n && (forall|k: usize| k < n ==> #[trigger] a[k] <= a[r])
    }

    #[effects(pure)]
    #[uses(adj_sorted_spec, at_most_len, is_abs, swapped, idx, small, order::digits_bound)]
    fn reverse_ends(a: &[i64], t: i64) -> (r: bool)
        requires order::digits_bound(a),
        ensures swapped(a, t, r),
    {
        let i: usize = argmax(a, t);
        i < a.len() && a[i] == t
    }
}
