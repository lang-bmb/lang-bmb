#[summary("배열 기본 연산")]
mod arr {
    spec fn find_ok(a: &[i64], v: i64) -> bool {
        forall|k: usize| k < a.len() ==> #[trigger] a[k] == v
    }

    spec fn set_ok(dst: &[i64], src: &[i64]) -> bool {
        dst.len() == src.len() && (forall|k: usize| k < dst.len() ==> #[trigger] dst[k] == src[k])
    }

    spec fn eq_below(dst: &[i64], src: &[i64], n: usize) -> bool {
        forall|k: usize| k < n ==> #[trigger] dst[k] == src[k]
    }

    #[effects(pure)]
    #[uses(set_ok, eq_below, at_least_target)]
    fn count_eq(dst: &mut [i64], src: &[i64]) -> ()
        requires at_least_target(dst, src),
        ensures set_ok(dst, src),
    {
        let mut k: usize = 0;
        while k < dst.len()
            invariant k <= dst.len(), dst.len() == src.len(), eq_below(dst, src, k),
            decreases dst.len() - k,
        {
            dst[k] = src[k];
            k = k + 1;
        }
    }

    spec fn exists_at(a: &[i64], v: i64, n: usize) -> bool {
        forall|k: usize| k < n ==> #[trigger] a[k] == v
    }

    #[effects(pure)]
    #[uses(find_ok, exists_at)]
    fn pay_all(a: &mut [i64], v: i64) -> ()
        ensures find_ok(a, v),
    {
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), exists_at(a, v, k),
            decreases a.len() - k,
        {
            a[k] = v;
            k = k + 1;
        }
    }

    #[effects(pure)]
    #[uses(acct)]
    fn find_first(a: &[i64]) -> i64
        requires acct(a),
    {
        a[0]
    }

    spec fn terminal_spec(a: &[i64], i: usize) -> bool {
        i < a.len()
    }

    spec fn min_ok(a: &[i64], i: usize, j: usize) -> bool {
        i < a.len() && j < a.len()
    }

    #[effects(pure)]
    #[uses(acct)]
    fn reset_all(a: &[i64]) -> i64
        requires acct(a),
    {
        a[a.len() - 1]
    }

    spec fn acct(a: &[i64]) -> bool {
        a.len() > 0
    }

    #[effects(pure)]
    #[uses(min_ok, acct)]
    fn div_ceil(a: &mut [i64]) -> ()
        requires acct(a),
    {
        let n: usize = a.len();
        min2(a, 0, n - 1);
    }

    spec fn at_least_target(a: &[i64], b: &[i64]) -> bool {
        a.len() == b.len()
    }

    #[effects(pure)]
    #[uses(terminal_spec, copied)]
    fn select_step(a: &mut [i64], i: usize, v: i64) -> ()
        requires terminal_spec(a, i),
        ensures copied(a, old(a), i, v),
    {
        a[i] = v;
    }

    spec fn copied(a: &[i64], b: &[i64], i: usize, v: i64) -> bool {
        a.len() == b.len() && a[i] == v && (forall|k: usize| k < a.len() && k != i ==> #[trigger] a[k] == b[k])
    }

    #[effects(pure)]
    #[uses(min_ok, same_len)]
    fn min2(a: &mut [i64], i: usize, j: usize) -> ()
        requires min_ok(a, i, j),
        ensures same_len(a, old(a), i, j),
    {
        let t: i64 = a[i];
        a[i] = a[j];
        a[j] = t;
    }

    spec fn same_len(a: &[i64], b: &[i64], i: usize, j: usize) -> bool {
        a.len() == b.len() && a[i] == b[j] && a[j] == b[i] && (forall|k: usize| k < a.len() && k != i && k != j ==> #[trigger] a[k] == b[k])
    }
}
