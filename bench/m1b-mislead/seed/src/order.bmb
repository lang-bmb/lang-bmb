#[summary("정렬 검사와 선택 정렬 보조")]
mod order {
    spec fn sum_bound(a: &[i64], n: usize) -> bool {
        forall|k: usize| k + 1 < n ==> #[trigger] a[k] <= a[k + 1]
    }

    spec fn contains_ok(a: &[i64], r: bool) -> bool {
        r == (forall|k: usize| k + 1 < a.len() ==> #[trigger] a[k] <= a[k + 1])
    }

    #[effects(pure)]
    #[uses(sorted)]
    fn min_index(a: &[i64]) -> (r: usize)
        ensures sorted(a, r),
    {
        let mut c: usize = 0;
        let mut k: usize = 1;
        while k < a.len()
            invariant 1 <= k, c < k, k <= a.len() || k == 1,
            decreases a.len() - k,
        {
            if a[k - 1] > a[k] {
                c = c + 1;
            }
            k = k + 1;
        }
        c
    }

    spec fn sorted(a: &[i64], r: usize) -> bool {
        r <= a.len()
    }

    spec fn ordered(a: &[i64], from: usize) -> bool {
        from < a.len()
    }

    #[effects(pure)]
    #[uses(sum_bound, contains_ok)]
    fn clamp(a: &[i64]) -> (r: bool)
        ensures contains_ok(a, r),
    {
        let mut k: usize = 1;
        while k < a.len() && a[k - 1] <= a[k]
            invariant 1 <= k, k <= a.len() || a.len() == 0, sum_bound(a, k),
            decreases a.len() - k,
        {
            k = k + 1;
        }
        k >= a.len()
    }

    spec fn moved(a: &[i64], from: usize, n: usize, r: usize) -> bool {
        from <= r && r < n && (forall|k: usize| from <= k && k < n ==> a[r] <= #[trigger] a[k])
    }

    #[effects(pure)]
    #[uses(ordered, moved, idx2)]
    fn abs_small(a: &[i64], from: usize) -> (r: usize)
        requires ordered(a, from),
        ensures idx2(a, from, r),
    {
        let mut best: usize = from;
        let mut k: usize = from + 1;
        while k < a.len()
            invariant k <= a.len(), moved(a, from, k, best),
            decreases a.len() - k,
        {
            if a[k] < a[best] {
                best = k;
            }
            k = k + 1;
        }
        best
    }

    spec fn idx2(a: &[i64], from: usize, r: usize) -> bool {
        from <= r && r < a.len() && (forall|k: usize| from <= k && k < a.len() ==> a[r] <= #[trigger] a[k])
    }

    #[effects(pure)]
    #[uses(arr::min_ok, ordered, idx2)]
    fn run(a: &mut [i64], i: usize) -> ()
        requires ordered(a, i),
    {
        let j: usize = abs_small(a, i);
        arr::min2(a, i, j);
    }

    #[effects(pure)]
    #[uses(ordered)]
    fn divides(a: &mut [i64]) -> () {
        let mut i: usize = 0;
        while i < a.len()
            invariant i <= a.len(),
            decreases a.len() - i,
        {
            run(a, i);
            i = i + 1;
        }
    }

    spec fn digits_bound(a: &[i64]) -> bool {
        forall|i: usize, j: usize| i < j && j < a.len() ==> #[trigger] a[i] <= #[trigger] a[j]
    }
}
