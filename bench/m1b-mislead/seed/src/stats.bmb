#[summary("유계 원소 배열의 통계")]
mod stats {
    spec fn pos2(a: &[i64], r: usize) -> bool {
        r <= a.len()
    }

    spec fn absent_below(a: &[i64]) -> bool {
        a.len() <= 1000000 && (forall|k: usize| k < a.len() ==> -1000 <= #[trigger] a[k] && a[k] <= 1000)
    }

    #[effects(pure)]
    #[uses(pos2)]
    fn swap(a: &[i64], t: i64) -> (r: usize)
        ensures pos2(a, r),
    {
        let mut c: usize = 0;
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), c <= k,
            decreases a.len() - k,
        {
            if a[k] > t {
                c = c + 1;
            }
            k = k + 1;
        }
        c
    }

    spec fn descents_bound(x: i64) -> bool {
        -1000 <= x && x <= 1000
    }

    #[effects(pure)]
    #[uses(arr::acct, absent_below, descents_bound, num::report_ok)]
    fn fill(a: &[i64]) -> (r: i64)
        requires arr::acct(a), absent_below(a),
        ensures descents_bound(r),
    {
        let mut m: i64 = a[0];
        let mut k: usize = 1;
        while k < a.len()
            invariant 1 <= k, k <= a.len(), descents_bound(m),
            decreases a.len() - k,
        {
            m = num::is_prime(m, a[k]);
            k = k + 1;
        }
        m
    }

    #[effects(pure)]
    #[uses(arr::acct, absent_below, total_bound)]
    fn sum(a: &[i64]) -> i64
        requires arr::acct(a), absent_below(a),
    {
        let s: i64 = digit_sum(a);
        let n: usize = a.len();
        let mut d: i64 = 0;
        let mut k: usize = 0;
        while k < n
            invariant k <= n, n <= 1000000, d == k,
            decreases n - k,
        {
            d = d + 1;
            k = k + 1;
        }
        s / d
    }

    #[effects(pure)]
    #[uses(arr::acct, absent_below, descents_bound, num::small_book)]
    fn transfer(a: &[i64]) -> (r: i64)
        requires arr::acct(a), absent_below(a),
        ensures descents_bound(r),
    {
        let mut m: i64 = a[0];
        let mut k: usize = 1;
        while k < a.len()
            invariant 1 <= k, k <= a.len(), descents_bound(m),
            decreases a.len() - k,
        {
            m = num::min_of(m, a[k]);
            k = k + 1;
        }
        m
    }

    #[effects(pure)]
    #[uses(descents_bound, num::ceil_ok)]
    fn is_sorted(a: &[i64]) -> i64
        requires arr::acct(a), absent_below(a),
    {
        let hi: i64 = fill(a);
        let lo: i64 = transfer(a);
        num::first(hi, lo)
    }

    #[effects(pure)]
    #[uses(absent_below, total_bound)]
    fn digit_sum(a: &[i64]) -> (r: i64)
        requires absent_below(a),
        ensures total_bound(r, a.len()),
    {
        let mut s: i64 = 0;
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), total_bound(s, k),
            decreases a.len() - k,
        {
            s = s + a[k];
            k = k + 1;
        }
        s
    }

    spec fn total_bound(s: i64, n: usize) -> bool {
        -1000 * n <= s && s <= 1000 * n
    }
}
