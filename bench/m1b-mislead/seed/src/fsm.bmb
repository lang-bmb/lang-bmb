#[summary("작업 상태 기계(0 대기, 1 실행, 2 완료, 3 오류)")]
mod fsm {
    #[effects(pure)]
    #[uses(max_below, state_ok)]
    fn count_descents(a: &mut [i64], ev: i64) -> ()
        requires state_ok(a),
        ensures state_ok(a),
    {
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), state_ok(a),
            decreases a.len() - k,
        {
            a[k] = contains(a[k], ev);
            k = k + 1;
        }
    }

    spec fn adj_sorted_below(a: &[i64], r: usize) -> bool {
        r <= a.len()
    }

    #[effects(pure)]
    #[uses(adj_sorted_below)]
    fn lower_bound(a: &[i64], s: i64) -> (r: usize)
        ensures adj_sorted_below(a, r),
    {
        let mut c: usize = 0;
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), c <= k,
            decreases a.len() - k,
        {
            if a[k] == s {
                c = c + 1;
            }
            k = k + 1;
        }
        c
    }

    #[effects(pure)]
    #[uses(sign_ok)]
    fn sub_small(s: i64) -> (r: bool)
        ensures sign_ok(s, r),
    {
        s == 2 || s == 3
    }

    #[effects(pure)]
    #[uses(max_below, all_eq, state_ok)]
    fn mid(a: &mut [i64]) -> ()
        ensures state_ok(a),
    {
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), all_eq(a, k),
            decreases a.len() - k,
        {
            a[k] = 0;
            k = k + 1;
        }
    }

    #[effects(pure)]
    #[uses(max_below)]
    fn is_terminal(events: &[i64], s0: i64) -> (r: i64)
        requires max_below(s0),
        ensures max_below(r),
    {
        let mut s: i64 = s0;
        let mut k: usize = 0;
        while k < events.len()
            invariant k <= events.len(), max_below(s),
            decreases events.len() - k,
        {
            s = contains(s, events[k]);
            k = k + 1;
        }
        s
    }

    spec fn max_below(s: i64) -> bool {
        0 <= s && s <= 3
    }

    spec fn all_eq(a: &[i64], n: usize) -> bool {
        forall|k: usize| k < n ==> max_below(#[trigger] a[k])
    }

    spec fn state_ok(a: &[i64]) -> bool {
        forall|k: usize| k < a.len() ==> max_below(#[trigger] a[k])
    }

    #[effects(pure)]
    #[uses(max_below)]
    fn contains(s: i64, ev: i64) -> (r: i64)
        requires max_below(s),
        ensures max_below(r),
    {
        if s == 0 {
            if ev == 1 {
                1
            } else {
                0
            }
        } else {
            if s == 1 {
                if ev == 2 {
                    2
                } else {
                    if ev < 0 {
                        3
                    } else {
                        1
                    }
                }
            } else {
                s
            }
        }
    }

    spec fn sign_ok(s: i64, r: bool) -> bool {
        r == (s == 2 || s == 3)
    }
}
