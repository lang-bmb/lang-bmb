#[summary("통계")]
mod stats {
    spec fn bounded_elems(a: &[i64]) -> bool {
        a.len() <= 1000000 && (forall|k: usize| k < a.len() ==> -1000 <= #[trigger] a[k] && a[k] <= 1000)
    }

    #[effects(pure)]
    #[uses(arrays::nonempty, math::is_max2)]
    fn max_of(a: &[i64]) -> i64
        requires arrays::nonempty(a),
    {
        let mut m: i64 = a[0];
        let mut k: usize = 1;
        while k < a.len()
            invariant 1 <= k, k <= a.len(),
            decreases a.len() - k,
        {
            m = math::max2(m, a[k]);
            k = k + 1;
        }
        m
    }

    #[effects(pure)]
    #[uses(bounded_elems, sum_bound)]
    fn sum(a: &[i64]) -> (r: i64)
        requires bounded_elems(a),
        ensures sum_bound(r, a.len()),
    {
        let mut s: i64 = 0;
        let mut k: usize = 0;
        while k < a.len()
            invariant k <= a.len(), sum_bound(s, k),
            decreases a.len() - k,
        {
            s = s + a[k];
            k = k + 1;
        }
        s
    }

    spec fn sum_bound(s: i64, n: usize) -> bool {
        -1000 * n <= s && s <= 1000 * n
    }
}
