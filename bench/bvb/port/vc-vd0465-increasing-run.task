}

@@ verus.signature
fn longest_increasing_subsequence(nums: &Vec<i32>) -> (max: i32)

@@ verus.target: longest_increasing_subsequence
@@ verus.specs
spec fn bvb_ref_find_max(x: int, y: int) -> int {
    if x > y { x } else { y }
}

@@ verus.pre
1 <= nums.len() <= 2500,
        forall|i: int| 0 <= i < nums.len() ==> #[trigger] nums[i] >= -10000 && #[trigger] nums[i] <= 10000

@@ verus.post
