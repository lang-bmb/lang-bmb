@@ id: vc-va0523-min-abs-diff
@@ benchmark: Vericoding
@@ origin: apps apps_test_4295
@@ origin_path: jsonl/verus_tasks.jsonl#VA0523
@@ rules: T2
@@ description
Implement `solve`: `n` and `k` are 8-bit integers (in [-128, 127]) with n >= 0 and k >= 1. Repeatedly replacing n by |n - k| can reach any value; return the minimum, which is the smaller of n % k and k - n % k. The contract must state that the result equals that minimum and lies in [0, k).

@@ signature
fn solve(n: i64, k: i64) -> (r: i64)

@@ accept.specs
spec fn ref_pre(n: i64, k: i64) -> bool { -128 <= n && n <= 127 && -128 <= k && k <= 127 && n >= 0 && k >= 1 }
spec fn ref_post(n: i64, k: i64, r: i64) -> bool { r == (if n % k <= k - n % k { n % k } else { k - n % k }) && r >= 0 && r < k }

@@ accept.pre: ref_pre(n, k)
@@ accept.post: ref_post(n, k, r)
@@ accept.args: n, k
@@ reference
spec fn input_ok(n: i64, k: i64) -> bool { -128 <= n && n <= 127 && -128 <= k && k <= 127 && n >= 0 && k >= 1 }

spec fn result_ok(n: i64, k: i64, r: i64) -> bool { r == (if n % k <= k - n % k { n % k } else { k - n % k }) && r >= 0 && r < k }

#[effects(pure)]
#[uses(input_ok, result_ok)]
fn solve(n: i64, k: i64) -> (r: i64)
    requires input_ok(n, k),
    ensures result_ok(n, k, r),
{
    let m: i64 = n % k;
    if m <= k - m {
        m
    } else {
        k - m
    }
}

