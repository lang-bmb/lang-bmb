spec fn input_ok(lst: &[i64]) -> bool { lst.len() > 0 }

spec fn result_ok(lst: &[i64], r: i64) -> bool { forall|j: usize| j < lst.len() ==> #[trigger] lst[j] <= r }

#[effects(pure)]
#[uses(input_ok, result_ok, max_upto)]
fn max_of_list(lst: &[i64]) -> (r: i64)
    requires input_ok(lst),
    ensures result_ok(lst, r),
{
    let mut m: i64 = lst[0];
    let mut p: usize = 0;
    let mut idx: usize = 1;
    while idx < lst.len()
        invariant 1 <= idx, idx <= lst.len(), max_upto(lst, m, p, idx),
        decreases lst.len() - idx,
    {
        if lst[idx] > m {
            m = lst[idx];
            p = idx;
        }
        idx = idx + 1;
    }
    m
}

@@ verus.signature
fn max_of_list(lst: Vec<i32>) -> (result: i32)

@@ verus.target: max_of_list
@@ verus.specs


@@ verus.pre
lst.len() > 0

@@ verus.post
exists|i: int| 0 <= i < lst.len() && lst[i] == result,
        forall|i: int| 0 <= i < lst.len() ==> lst[i] <= result

@@ verus.args: lst
@@ verus.reference_origin: upstream
@@ verus.reference
// <vc-preamble>
use vstd::prelude::*;

verus! {
// </vc-preamble>

// <vc-helpers>
/* helper modified by LLM (iteration 3): max2 returns the larger of two i32 values */
fn max2(a: i32, b: i32) -> i32 {
    if a >= b { a } else { b }
}
// </vc-helpers>

// <vc-spec>
fn max_of_list(lst: Vec<i32>) -> (result: i32)
    requires lst.len() > 0,
    ensures
        exists|i: int| 0 <= i < lst.len() && lst[i] == result,
        forall|i: int| 0 <= i < lst.len() ==> lst[i] <= result,
// </vc-spec>
// <vc-code>
{
    /* code modified by LLM (iteration 3): implemented max search using usize loop and spec-level invariants */
    let mut i: usize = 1;
    let mut cur: i32 = lst[0];
    while i < lst.len()
        invariant
            0 <= (i as int),
            (i as int) <= lst.len() as int,
            forall |k: int| 0 <= k && k < (i as int) ==> lst@[k] <= cur,
            exists |j: int| 0 <= j && j < (i as int) && lst@[j] == cur,
        decreases (lst.len() as int) - (i as int)
    {
        let v = lst[i];
        if v > cur {
            cur = v;
        }
        i = i + 1;
    }
    cur
}
// </vc-code>

}
fn main() {}
