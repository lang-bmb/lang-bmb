spec fn result_ok(v: &[i64], r: usize) -> bool { r <= v.len() && (r != v.len() ==> v[r] == 0) }

#[effects(pure)]
#[uses(result_ok, nonzero_below)]
fn mfirst_cero(v: &[i64]) -> (r: usize)
    ensures result_ok(v, r),
{
    let mut i: usize = 0;
    while i < v.len() && v[i] != 0
        invariant i <= v.len(), nonzero_below(v, i),
        decreases v.len() - i,
    {
        i = i + 1;
    }
    i
}

@@ verus.signature
fn mfirst_cero(v: &[i32]) -> (i: usize)

@@ verus.target: mfirst_cero
@@ verus.specs


@@ verus.pre
none

@@ verus.post
i <= v.len(),
        forall|j: int| 0 <= j < i as int ==> v@[j] != 0,
        i != v.len() ==> v@[i as int] == 0

@@ verus.args: v
@@ verus.reference_origin: bvb
@@ verus.reference
use vstd::prelude::*;

verus! {

fn mfirst_cero(v: &[i32]) -> (i: usize)
    ensures
        i <= v.len(),
        forall|j: int| 0 <= j < i as int ==> v@[j] != 0,
        i != v.len() ==> v@[i as int] == 0,
{
    let mut i: usize = 0;
    while i < v.len() && v[i] != 0
        invariant
            i <= v.len(),
            forall|j: int| 0 <= j < i as int ==> v@[j] != 0,
        decreases v.len() - i,
    {
        i = i + 1;
    }
    i
}

}
fn main() {}
