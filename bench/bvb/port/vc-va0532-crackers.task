@@ id: vc-va0532-crackers
@@ benchmark: Vericoding
@@ origin: apps apps_test_4308
@@ origin_path: jsonl/verus_tasks.jsonl#VA0532
@@ rules: T2
@@ description
Implement `solve`: `n` and `k` are between 1 and 100. N crackers are shared among K users as evenly as possible; return the smallest possible difference between the largest and the smallest share (0 if k divides n, else 1). The contract must state the result exactly, including that it is 0 exactly when n % k == 0 and 1 exactly when n % k != 0.

@@ signature
fn solve(n: i64, k: i64) -> (r: i64)

@@ accept.specs
spec fn ref_pre(n: i64, k: i64) -> bool { n >= 1 && k >= 1 && n <= 100 && k <= 100 }
spec fn ref_post(n: i64, k: i64, r: i64) -> bool { r == (if n % k == 0 { 0 } else { 1 }) && ((r == 0) == (n % k == 0)) && ((r == 1) == (n % k != 0)) }

@@ accept.pre: ref_pre(n, k)
@@ accept.post: ref_post(n, k, r)
@@ accept.args: n, k
@@ reference
spec fn input_ok(n: i64, k: i64) -> bool { n >= 1 && k >= 1 && n <= 100 && k <= 100 }

spec fn result_ok(n: i64, k: i64, r: i64) -> bool { r == (if n % k == 0 { 0 } else { 1 }) && ((r == 0) == (n % k == 0)) && ((r == 1) == (n % k != 0)) }

#[effects(pure)]
#[uses(input_ok, result_ok)]
fn solve(n: i64, k: i64) -> (r: i64)
    requires input_ok(n, k),
    ensures result_ok(n, k, r),
{
    if n % k == 0 {
        0
    } else {
        1
    }
}

