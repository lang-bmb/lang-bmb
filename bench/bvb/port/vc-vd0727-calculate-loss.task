@@ id: vc-vd0727-calculate-loss
@@ benchmark: Vericoding
@@ origin: dafnybench dafny-synthesis_task_id_452_CalculateLoss
@@ origin_path: jsonl/verus_tasks.jsonl#VD0727
@@ rules: T2
@@ description
Implement `calculate_loss`: `cost_price` and `selling_price` are non-negative 32-bit integers. Return the loss: cost_price - selling_price when the cost exceeds the selling price, otherwise 0. The contract must state the result exactly in both cases.

@@ signature
fn calculate_loss(cost_price: i64, selling_price: i64) -> (r: i64)

@@ accept.specs
spec fn ref_pre(cost_price: i64, selling_price: i64) -> bool { -2147483648 <= cost_price && cost_price <= 2147483647 && -2147483648 <= selling_price && selling_price <= 2147483647 && cost_price >= 0 && selling_price >= 0 }
spec fn ref_post(cost_price: i64, selling_price: i64, r: i64) -> bool { (cost_price > selling_price ==> r == cost_price - selling_price) && (cost_price <= selling_price ==> r == 0) }

@@ accept.pre: ref_pre(cost_price, selling_price)
@@ accept.post: ref_post(cost_price, selling_price, r)
@@ accept.args: cost_price, selling_price
@@ reference
spec fn input_ok(cost_price: i64, selling_price: i64) -> bool { -2147483648 <= cost_price && cost_price <= 2147483647 && -2147483648 <= selling_price && selling_price <= 2147483647 && cost_price >= 0 && selling_price >= 0 }

spec fn result_ok(cost_price: i64, selling_price: i64, r: i64) -> bool { (cost_price > selling_price ==> r == cost_price - selling_price) && (cost_price <= selling_price ==> r == 0) }

#[effects(pure)]
#[uses(input_ok, result_ok)]
fn calculate_loss(cost_price: i64, selling_price: i64) -> (r: i64)
    requires input_ok(cost_price, selling_price),
    ensures result_ok(cost_price, selling_price, r),
{
    if cost_price > selling_price {
        cost_price - selling_price
    } else {
        0
    }
}

@@ weak
