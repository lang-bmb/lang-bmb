@@ id: vc-va0399-late-brother
@@ benchmark: Vericoding
@@ origin: apps apps_test_2183
@@ origin_path: jsonl/verus_tasks.jsonl#VA0399
@@ rules: T2
@@ description
Implement `solve`: three brothers are numbered 1, 2 and 3; `a` and `b` are the two different brothers who arrived on time. Return the number of the brother who was late. The contract must state that the result is in [1, 3], differs from a and b, and equals 6 - a - b.

@@ signature
fn solve(a: i64, b: i64) -> (r: i64)

@@ accept.specs
spec fn ref_pre(a: i64, b: i64) -> bool { 1 <= a && a <= 3 && 1 <= b && b <= 3 && a != b }
spec fn ref_post(a: i64, b: i64, r: i64) -> bool { (1 <= r && r <= 3 && r != a && r != b) && r == 6 - a - b }

@@ accept.pre: ref_pre(a, b)
@@ accept.post: ref_post(a, b, r)
@@ accept.args: a, b
@@ reference
spec fn input_ok(a: i64, b: i64) -> bool { 1 <= a && a <= 3 && 1 <= b && b <= 3 && a != b }

spec fn result_ok(a: i64, b: i64, r: i64) -> bool { (1 <= r && r <= 3 && r != a && r != b) && r == 6 - a - b }

#[effects(pure)]
#[uses(input_ok, result_ok)]
fn solve(a: i64, b: i64) -> (r: i64)
    requires input_ok(a, b),
    ensures result_ok(a, b, r),
{
    6 - a - b
}

@@ weak
spec fn input_ok(a: i64, b: i64) -> bool { 1 <= a && a <= 3 && 1 <= b && b <= 3 && a != b }

