@@ id: vc-vd0791-month-30-days
@@ benchmark: Vericoding
@@ origin: dafnybench dafny-synthesis_task_id_762_IsMonthWith30Days
@@ origin_path: jsonl/verus_tasks.jsonl#VD0791
@@ rules: T2
@@ description
Implement `is_month_with_30_days`: `month` is between 1 and 12. Return whether that month has 30 days (April, June, September or November). The contract must state the result exactly.

@@ signature
fn is_month_with_30_days(month: i64) -> (r: bool)

@@ accept.specs
spec fn ref_pre(month: i64) -> bool { 1 <= month && month <= 12 }
spec fn ref_post(month: i64, r: bool) -> bool { r == (month == 4 || month == 6 || month == 9 || month == 11) }

@@ accept.pre: ref_pre(month)
@@ accept.post: ref_post(month, r)
@@ accept.args: month
@@ reference
spec fn input_ok(month: i64) -> bool { 1 <= month && month <= 12 }

spec fn result_ok(month: i64, r: bool) -> bool { r == (month == 4 || month == 6 || month == 9 || month == 11) }

#[effects(pure)]
#[uses(input_ok, result_ok)]
fn is_month_with_30_days(month: i64) -> (r: bool)
    requires input_ok(month),
    ensures result_ok(month, r),
{
    month == 4 || month == 6 || month == 9 || month == 11
}

@@ weak
spec fn input_ok(month: i64) -> bool { 1 <= month && month <= 12 }

spec fn result_ok(month: i64, r: bool) -> bool { r ==> (month == 4 || month == 6 || month == 9 || month == 11) }

#[effects(pure)]
#[uses(input_ok, result_ok)]
fn is_month_with_30_days(month: i64) -> (r: bool)
    requires input_ok(month),
    ensures result_ok(month, r),
{
    month == 4 || month == 6 || month == 9 || month == 11
}

@@ verus.signature
fn is_month_with_30_days(month: i32) -> (result: bool)

@@ verus.target: is_month_with_30_days
@@ verus.specs


@@ verus.pre
1 <= month <= 12

@@ verus.post
result <==> (month == 4 || month == 6 || month == 9 || month == 11)

@@ verus.args: month
@@ verus.reference_origin: upstream
@@ verus.reference
