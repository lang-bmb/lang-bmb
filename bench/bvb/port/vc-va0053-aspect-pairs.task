@@ id: vc-va0053-aspect-pairs
@@ benchmark: Vericoding
@@ origin: apps apps_test_204
@@ origin_path: jsonl/verus_tasks.jsonl#VA0053
@@ rules: T2 G1
@@ description
Implement `solve`: `a`, `b`, `x` and `y` are positive 8-bit integers (in [1, 127]). Count the pairs (w, h) with 1 <= w <= a, 1 <= h <= b and w / h = x / y. With g the greatest common divisor of x and y (the given specification function), this is the smaller of a / (x / g) and b / (y / g). The contract must state that the result is non-negative and equals that value.

@@ frozen: given::gcd
@@ given
spec fn gcd(a: u64, b: u64) -> u64
    decreases b,
{
    if b == 0 { a } else { gcd(b, a % b) }
}

@@ signature
fn solve(a: i64, b: i64, x: i64, y: i64) -> (r: i64)

@@ accept.specs
spec fn ref_expected(a: i64, b: i64, x: i64, y: i64) -> i64 { if a / (x / given::gcd(x, y)) <= b / (y / given::gcd(x, y)) { a / (x / given::gcd(x, y)) } else { b / (y / given::gcd(x, y)) } }
spec fn ref_pre(a: i64, b: i64, x: i64, y: i64) -> bool { 1 <= a && a <= 127 && 1 <= b && b <= 127 && 1 <= x && x <= 127 && 1 <= y && y <= 127 }
spec fn ref_post(a: i64, b: i64, x: i64, y: i64, r: i64) -> bool { r >= 0 && r == ref_expected(a, b, x, y) }

@@ accept.pre: ref_pre(a, b, x, y)
@@ accept.post: ref_post(a, b, x, y, r)
@@ accept.args: a, b, x, y
@@ reference
spec fn both_nonneg(a: i64, b: i64) -> bool { a >= 0 && b >= 0 && a <= 127 && b <= 127 }

spec fn gcd_ok(a: i64, b: i64, r: i64) -> bool { r == given::gcd(a, b) && (a > 0 ==> r <= a) && (b > 0 ==> r <= b) && ((a > 0 || b > 0) ==> r >= 1) }

spec fn expected(a: i64, b: i64, x: i64, y: i64) -> i64 { if a / (x / given::gcd(x, y)) <= b / (y / given::gcd(x, y)) { a / (x / given::gcd(x, y)) } else { b / (y / given::gcd(x, y)) } }

#[effects(pure)]
#[uses(both_nonneg, gcd_ok, given::gcd)]
fn gcd_exec(a: i64, b: i64) -> (r: i64)
    requires both_nonneg(a, b),
    ensures gcd_ok(a, b, r),
    decreases b,
{
    if b == 0 {
        a
    } else {
        gcd_exec(b, a % b)
    }
}

spec fn input_ok(a: i64, b: i64, x: i64, y: i64) -> bool { 1 <= a && a <= 127 && 1 <= b && b <= 127 && 1 <= x && x <= 127 && 1 <= y && y <= 127 }

spec fn result_ok(a: i64, b: i64, x: i64, y: i64, r: i64) -> bool { r >= 0 && r == expected(a, b, x, y) }

#[effects(pure)]
#[uses(input_ok, result_ok, both_nonneg, gcd_ok, expected, given::gcd)]
fn solve(a: i64, b: i64, x: i64, y: i64) -> (r: i64)
    requires input_ok(a, b, x, y),
    ensures result_ok(a, b, x, y, r),
{
    let g: i64 = gcd_exec(x, y);
    let p: i64 = a / (x / g);
    let q: i64 = b / (y / g);
    if p <= q {
        p
    } else {
        q
    }
}

