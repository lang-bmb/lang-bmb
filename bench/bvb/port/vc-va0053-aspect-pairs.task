@@ verus.signature
fn solve(a: i8, b: i8, x: i8, y: i8) -> (result: i8)

@@ verus.target: solve
@@ verus.given
spec fn gcd(a: int, b: int) -> int
  recommends a >= 0 && b >= 0
  decreases b when b >= 0
{
  if b == 0 { a } else { gcd(b, a % b) }
}

@@ verus.specs
spec fn bvb_ref_valid_input(a: int, b: int, x: int, y: int) -> bool {
  a > 0 && b > 0 && x > 0 && y > 0
}

spec fn bvb_ref_min(a: int, b: int) -> int {
  if a <= b { a } else { b }
}

spec fn bvb_ref_expected_result(a: int, b: int, x: int, y: int) -> int
  recommends bvb_ref_valid_input(a, b, x, y)
{
  let g = gcd(x, y);
  let x_reduced = x / g;
  let y_reduced = y / g;
  bvb_ref_min(a / x_reduced, b / y_reduced)
}

@@ verus.pre
bvb_ref_valid_input(a as int, b as int, x as int, y as int)

@@ verus.post
result as int >= 0,
  result as int == bvb_ref_expected_result(a as int, b as int, x as int, y as int)

@@ verus.args: a, b, x, y
@@ verus.reference_origin: bvb
@@ verus.reference
use vstd::prelude::*;

verus! {

spec fn valid_input(a: int, b: int, x: int, y: int) -> bool {
  a > 0 && b > 0 && x > 0 && y > 0
}

spec fn gcd(a: int, b: int) -> int
  recommends a >= 0 && b >= 0
  decreases b when b >= 0
{
  if b == 0 { a } else { gcd(b, a % b) }
}

spec fn min(a: int, b: int) -> int {
  if a <= b { a } else { b }
}

spec fn expected_result(a: int, b: int, x: int, y: int) -> int
  recommends valid_input(a, b, x, y)
{
  let g = gcd(x, y);
  let x_reduced = x / g;
  let y_reduced = y / g;
  min(a / x_reduced, b / y_reduced)
}

fn gcd_exec(a: i8, b: i8) -> (r: i8)
    requires
        a >= 0,
        b >= 0,
    ensures
        r as int == gcd(a as int, b as int),
        a > 0 ==> r <= a,
        b > 0 ==> r <= b,
        (a > 0 || b > 0) ==> r >= 1,
    decreases b,
{
    if b == 0 {
        a
    } else {
        let m = ((a as u8) % (b as u8)) as i8;
        assert(m as int == (a as int) % (b as int));
        assert(gcd(a as int, b as int) == gcd(b as int, (a as int) % (b as int)));
        if a < b {
            assert((a as int) % (b as int) == a as int) by (nonlinear_arith)
                requires 0 <= a < b;
        }
        gcd_exec(b, m)
    }
}

fn solve(a: i8, b: i8, x: i8, y: i8) -> (result: i8)
requires
  valid_input(a as int, b as int, x as int, y as int)
ensures
  result as int >= 0,
  result as int == expected_result(a as int, b as int, x as int, y as int)
{
    let g = gcd_exec(x, y);
    let xr = x / g;
    let yr = y / g;
    assert(xr >= 1) by (nonlinear_arith)
        requires 1 <= g <= x, xr == x / g;
    assert(yr >= 1) by (nonlinear_arith)
        requires 1 <= g <= y, yr == y / g;
    let p = a / xr;
    let q = b / yr;
    if p <= q { p } else { q }
}

}

fn main() {}
