}

@@ verus.signature
fn solve(n: i8) -> (result: i8)

@@ verus.target: solve
@@ verus.specs
spec fn bvb_ref_valid_input(n: int) -> bool {
    n >= 10 || n <= -10
}

spec fn bvb_ref_max_balance_after_operation(n: int) -> int
    recommends bvb_ref_valid_input(n)
{
    if n >= 0 {
        n
    } else {
        /* For negative numbers, we need to delete either the last digit
           or the digit before the last digit to maximize the balance.
           Since this involves string operations that are not easily
           expressible in pure logic, we use a simplified specification. */
        let option1 = n / 10;
        let option2 = (n / 100) * 10 + (n % 10);
        if option1 > option2 { option1 } else { option2 }
    }
}

@@ verus.pre
bvb_ref_valid_input(n as int)

@@ verus.post
result as int == bvb_ref_max_balance_after_operation(n as int)

@@ verus.args: n
@@ verus.reference_origin: bvb
@@ verus.reference
use vstd::prelude::*;

verus! {
spec fn valid_input(n: int) -> bool {
    n >= 10 || n <= -10
}

spec fn max_balance_after_operation(n: int) -> int
    recommends valid_input(n)
{
    if n >= 0 {
        n
    } else {
        /* For negative numbers, we need to delete either the last digit
           or the digit before the last digit to maximize the balance.
           Since this involves string operations that are not easily
           expressible in pure logic, we use a simplified specification. */
        let option1 = n / 10;
        let option2 = (n / 100) * 10 + (n % 10);
        if option1 > option2 { option1 } else { option2 }
    }
}

fn solve(n: i8) -> (result: i8)
    requires valid_input(n as int)
    ensures result as int == max_balance_after_operation(n as int)
{
    if n >= 0 {
        n
    } else {
        let m: i16 = n as i16;
        let r10: i16 = ((m % 10) + 10) % 10;
        let q10: i16 = (m - r10) / 10;
        let r100: i16 = ((m % 100) + 100) % 100;
        let q100: i16 = (m - r100) / 100;
        assert(r10 as int == (n as int) % 10);
        assert(q10 as int == (n as int) / 10);
        assert(q100 as int == (n as int) / 100);
        let o2: i16 = q100 * 10 + r10;
        if q10 > o2 {
            q10 as i8
        } else {
            o2 as i8
        }
    }
}

}

fn main() {}
