spec fn input_ok(n: i64) -> bool { -128 <= n && n <= 127 && (n >= 10 || n <= -10) }

spec fn result_ok(n: i64, r: i64) -> bool { r >= n }

#[effects(pure)]
#[uses(input_ok, result_ok, fmod, fdiv, balance)]
