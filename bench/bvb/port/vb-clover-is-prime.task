@@ id: vb-clover-is-prime
@@ benchmark: Verus-Bench
@@ origin: CloverBench
@@ origin_path: benchmarks/Verus-Bench/CloverBench/verified/is_prime.rs
@@ rules: T2 G1
@@ description
Implement `test_prime`: `candidate` is greater than 1. Return whether `candidate` is prime (no factor f with 1 < f < candidate divides it). The contract must state the result exactly using the given specification functions.

@@ frozen: given::divides given::is_prime
@@ given
spec fn divides(factor: u64, candidate: u64) -> bool {
    candidate % factor == 0
}

spec fn is_prime(candidate: u64) -> bool {
    1 < candidate && (forall|factor: u64| 1 < factor && factor < candidate ==> !#[trigger] divides(factor, candidate))
}

@@ signature
fn test_prime(candidate: u64) -> (r: bool)

@@ accept.specs
spec fn ref_pre(candidate: u64) -> bool { 1 < candidate }
spec fn ref_post(candidate: u64, r: bool) -> bool { r == given::is_prime(candidate) }

@@ accept.pre: ref_pre(candidate)
@@ accept.post: ref_post(candidate, r)
@@ accept.args: candidate
@@ reference
spec fn above_one(candidate: u64) -> bool { 1 < candidate }

spec fn stopped(candidate: u64, f: u64) -> bool { f >= candidate || given::divides(f, candidate) }

spec fn no_factor_below(candidate: u64, m: u64) -> bool { forall|f: u64| 1 < f && f < m ==> !(#[trigger] given::divides(f, candidate)) }

spec fn prime_ok(candidate: u64, r: bool) -> bool { r == given::is_prime(candidate) }

#[effects(pure)]
#[uses(above_one, stopped, no_factor_below, prime_ok, given::divides, given::is_prime)]
fn test_prime(candidate: u64) -> (r: bool)
    requires above_one(candidate),
    ensures prime_ok(candidate, r),
{
    let mut f: u64 = 2;
    while f < candidate && candidate % f != 0
        invariant 2 <= f, f <= candidate, no_factor_below(candidate, f),
        decreases candidate - f,
    {
        f = f + 1;
    }
    assert(stopped(candidate, f));
    f >= candidate
}

@@ weak
spec fn above_one(candidate: u64) -> bool { 1 < candidate }

spec fn stopped(candidate: u64, f: u64) -> bool { f >= candidate || given::divides(f, candidate) }

spec fn no_factor_below(candidate: u64, m: u64) -> bool { forall|f: u64| 1 < f && f < m ==> !(#[trigger] given::divides(f, candidate)) }

spec fn prime_if(candidate: u64, r: bool) -> bool { r ==> given::is_prime(candidate) }

#[effects(pure)]
#[uses(above_one, stopped, no_factor_below, prime_if, given::divides, given::is_prime)]
fn test_prime(candidate: u64) -> (r: bool)
    requires above_one(candidate),
    ensures prime_if(candidate, r),
{
    let mut f: u64 = 2;
    while f < candidate && candidate % f != 0
        invariant 2 <= f, f <= candidate, no_factor_below(candidate, f),
        decreases candidate - f,
    {
        f = f + 1;
    }
    assert(stopped(candidate, f));
    f >= candidate
}

@@ verus.signature
fn test_prime(candidate: u64) -> (result: bool)

@@ verus.target: test_prime
@@ verus.given
spec fn divides(factor: nat, candidate: nat) -> bool {
    candidate % factor == 0
}

spec fn is_prime(candidate: nat) -> bool {
    &&& 1 < candidate
    &&& forall|factor: nat| 1 < factor && factor < candidate ==> !divides(factor, candidate)
}

@@ verus.specs


@@ verus.pre
1 < candidate

@@ verus.post
result == is_prime(candidate as nat)

@@ verus.args: candidate
@@ verus.reference_origin: upstream
@@ verus.reference
use vstd::prelude::*;

fn main() {}
verus! {

spec fn divides(factor: nat, candidate: nat) -> bool {
    candidate % factor == 0
}

spec fn is_prime(candidate: nat) -> bool {
    &&& 1 < candidate
    &&& forall|factor: nat| 1 < factor && factor < candidate ==> !divides(factor, candidate)
}

fn test_prime(candidate: u64) -> (result: bool)
    requires
        1 < candidate,
    ensures
        result == is_prime(candidate as nat),
{
    let mut factor: u64 = 2;
    while factor < candidate
        invariant
            1 < factor <= candidate,
            forall|smallerfactor: nat|
                1 < smallerfactor < factor ==> !divides(smallerfactor, candidate as nat),
        decreases candidate - factor,
    {
        if candidate % factor == 0 {
            assert(divides(factor as nat, candidate as nat));
            assert(!is_prime(candidate as nat));
            return false;
        }
        factor = factor + 1;
    }
    true
}

} // verus!
