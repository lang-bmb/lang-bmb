#[summary("vm: the stack and its operations; each returns 0 or an error code")]
mod vm {
    // Error codes: 1 stack underflow, 2 overflow, 3 division by zero,
    // 4 unknown token (main), 5 stack full.

    /// The most values the stack holds.
    const LIMIT: usize = 4096;

    #[effects(alloc)]
    fn push(st: &mut Vec<i64>, v: i64) -> u8 {
        if st.len() >= LIMIT {
            return 5;
        }
        st.push(v);
        0
    }

    /// `a op b` for op 1 add, 2 sub, 3 mul, 4 div; None when the result does
    /// not fit or b is 0 for div.
    #[effects(pure)]
    fn apply(op: u8, a: i64, b: i64) -> Option<i64> {
        if op == 1 {
            a.checked_add(b)
        } else if op == 2 {
            a.checked_sub(b)
        } else if op == 3 {
            a.checked_mul(b)
        } else {
            a.checked_div(b)
        }
    }

    /// Replaces the two top values a, b (b on top) with `a op b`. On an
    /// error the stack is left as it was.
    #[effects(alloc)]
    fn binary(st: &mut Vec<i64>, op: u8) -> u8 {
        if st.len() < 2 {
            return 1;
        }
        let b: i64 = match st.pop() {
            None => 0,
            Some(x) => x,
        };
        let a: i64 = match st.pop() {
            None => 0,
            Some(x) => x,
        };
        match apply(op, a, b) {
            None => {
                st.push(a);
                st.push(b);
                if op == 4 && b == 0 { 3 } else { 2 }
            }
            Some(v) => {
                st.push(v);
                0
            }
        }
    }

    #[effects(alloc)]
    fn dup(st: &mut Vec<i64>) -> u8 {
        if st.len() >= LIMIT {
            return 5;
        }
        match st.pop() {
            None => 1,
            Some(x) => {
                st.push(x);
                st.push(x);
                0
            }
        }
    }

    #[effects(alloc)]
    fn swap(st: &mut Vec<i64>) -> u8 {
        if st.len() < 2 {
            return 1;
        }
        let b: i64 = match st.pop() {
            None => 0,
            Some(x) => x,
        };
        let a: i64 = match st.pop() {
            None => 0,
            Some(x) => x,
        };
        st.push(b);
        st.push(a);
        0
    }

    #[effects(alloc)]
    fn drop(st: &mut Vec<i64>) -> u8 {
        match st.pop() {
            None => 1,
            Some(x) => 0,
        }
    }

    /// Prints the top value on a line of its own.
    #[effects(alloc, io)]
    fn print(st: &mut Vec<i64>) -> u8 {
        match st.pop() {
            None => 1,
            Some(x) => {
                let mut s: String = String::new();
                std::num::push_i64(&mut s, x);
                s.push_str("\n");
                print_str(s.as_str());
                st.push(x);
                0
            }
        }
    }
}
