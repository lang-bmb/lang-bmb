#[summary("lex: the tokens of a line, as byte ranges")]
mod lex {
    /// A space between tokens: space, tab or carriage return.
    #[effects(pure)]
    fn space(b: u8) -> bool {
        b == 32 || b == 9 || b == 13
    }

    /// The end of the token that starts at `lo`: the first space at or
    /// after it, or `hi`.
    #[effects(pure)]
    fn token_end(s: &[u8], lo: usize, hi: usize) -> (r: usize)
        requires lo < hi && hi <= s.len(),
        ensures lo < r && r <= hi,
    {
        let mut i: usize = lo + 1;
        while i < hi && !space(s[i])
            invariant lo < i && i <= hi && hi <= s.len(),
            decreases hi - i,
        {
            i = i + 1;
        }
        i
    }

    /// Whether `s[lo..hi]` is the word `w`.
    #[effects(pure)]
    fn is(s: &[u8], lo: usize, hi: usize, w: &str) -> bool
        requires lo <= hi && hi <= s.len(),
    {
        if hi - lo != w.len() {
            return false;
        }
        for k in 0..w.len()
            invariant lo + w.len() == hi && hi <= s.len(),
        {
            if s[lo + k] != w.as_bytes()[k] {
                return false;
            }
        }
        true
    }
}
