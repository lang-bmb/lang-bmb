#[summary("main: runs the commands of standard input, line by line, on one stack")]
mod main {
    /// One token: a command word or an integer to push.
    #[effects(alloc, io)]
    fn step(s: &[u8], lo: usize, hi: usize, st: &mut Vec<i64>) -> u8
        requires lo <= hi && hi <= s.len(),
    {
        if lex::is(s, lo, hi, "add") {
            vm::binary(st, 1)
        } else if lex::is(s, lo, hi, "sub") {
            vm::binary(st, 2)
        } else if lex::is(s, lo, hi, "mul") {
            vm::binary(st, 3)
        } else if lex::is(s, lo, hi, "div") {
            vm::binary(st, 4)
        } else if lex::is(s, lo, hi, "dup") {
            vm::dup(st)
        } else if lex::is(s, lo, hi, "swap") {
            vm::swap(st)
        } else if lex::is(s, lo, hi, "drop") {
            vm::drop(st)
        } else if lex::is(s, lo, hi, "print") {
            vm::print(st)
        } else {
            match std::num::parse_i64_bytes(&s[lo..hi]) {
                None => 4,
                Some(v) => vm::push(st, v),
            }
        }
    }

    /// `error LINE: WHAT` for error `code` at token `s[lo..hi]`.
    #[effects(alloc, io)]
    fn report(line: u64, code: u8, s: &[u8], lo: usize, hi: usize) -> ()
        requires lo <= hi && hi <= s.len(),
    {
        let mut m: String = String::new();
        m.push_str("error ");
        std::num::push_u64(&mut m, line);
        if code == 1 {
            m.push_str(": stack underflow\n");
        } else if code == 2 {
            m.push_str(": overflow\n");
        } else if code == 3 {
            m.push_str(": division by zero\n");
        } else if code == 5 {
            m.push_str(": stack full\n");
        } else {
            m.push_str(": unknown token ");
        }
        print_str(m.as_str());
        if code == 4 {
            print_bytes(&s[lo..hi]);
            print_str("\n");
        }
    }

    /// Runs the tokens of line `s[lo..hi]`; the first error ends the line.
    #[effects(alloc, io)]
    fn run_line(s: &[u8], lo: usize, hi: usize, st: &mut Vec<i64>, line: u64) -> ()
        requires lo <= hi && hi <= s.len(),
    {
        let mut i: usize = lo;
        while i < hi
            invariant lo <= i && i <= hi && hi <= s.len(),
            decreases hi - i,
        {
            if lex::space(s[i]) {
                i = i + 1;
            } else {
                let e: usize = lex::token_end(s, i, hi);
                let code: u8 = step(s, i, e, st);
                if code != 0 {
                    report(line, code, s, i, e);
                    return;
                }
                i = e;
            }
        }
    }

    #[effects(alloc, io, nondet)]
    fn main() -> () {
        let mut input: Vec<u8> = Vec::new();
        match std::io::read_to_end(&mut input) {
            Ok(n) => {}
            Err(e) => {
                eprint_str(e.message.as_str());
                eprint_str("\n");
                std::process::exit(1);
            }
        }
        let mut st: Vec<i64> = Vec::new();
        let mut line: u64 = 1;
        let mut start: usize = 0;
        for i in 0..input.len()
            invariant start <= i,
        {
            if input[i] == 10 {
                run_line(input.as_slice(), start, i, &mut st, line);
                line = line.saturating_add(1);
                start = i + 1;
            }
        }
        if start < input.len() {
            run_line(input.as_slice(), start, input.len(), &mut st, line);
        }
        let mut m: String = String::new();
        m.push_str("depth ");
        std::num::push_u64(&mut m, st.len() as u64);
        m.push_str("\n");
        print_str(m.as_str());
    }
}
