#[summary("정렬된 모음(Rust `BTreeSet`·`BTreeMap`의 이름과 뜻): 정렬된 Vec 위의 집합과 맵, 키는 오름차순이고 유일하다. 넣기·빼기는 배열이 어떻게 바뀌는지 정확히 말한다 (ADR-0092 §2, backlog 4B-02)")]
mod collections {
    // The keys are strictly ascending, so each occurs once.
    spec fn strictly<K: Copy + Ord>(v: &[K]) -> bool {
        forall |i: usize, j: usize| i < j && j < v.len() ==> #[trigger] v[i] < #[trigger] v[j]
    }

    // A set of keys in ascending order (Rust's `BTreeSet<K>`).
    #[invariant(set_sound)]
    struct BTreeSet<K: Copy + Ord> { keys: Vec<K> }

    spec fn set_sound<K: Copy + Ord>(s: &BTreeSet<K>) -> bool {
        strictly::<K>(s.keys.as_slice()) && s.keys.len() < 1152921504606846975
    }

    // `k` is in the set.
    spec fn holds<K: Copy + Ord>(s: &BTreeSet<K>, k: K) -> bool {
        exists |i: usize| i < s.keys.len() && #[trigger] s.keys[i] == k
    }

    spec fn contained<K: Copy + Ord>(r: bool, s: &BTreeSet<K>, k: K) -> bool {
        r == holds::<K>(s, k)
    }

    // Where `k` is, or where it would go: the keys before it are below it,
    // the keys from it on are not.
    spec fn place<K: Copy + Ord>(v: &[K], k: K, p: usize) -> bool {
        p <= v.len()
            && (forall |a: usize| a < p ==> #[trigger] v[a] < k)
            && (forall |b: usize| p <= b && b < v.len() ==> k <= #[trigger] v[b])
    }

    // The place of `k` in ascending keys, by bisection.
    #[effects(pure)]
    #[uses(place, strictly)]
    fn locate<K: Copy + Ord>(v: &[K], k: K) -> (p: usize)
        requires strictly::<K>(v),
        ensures place::<K>(v, k, p),
    {
        let mut lo: usize = 0;
        let mut hi: usize = v.len();
        while lo < hi
            invariant lo <= hi, hi <= v.len(), place::<K>(v, k, lo) || lo < hi,
                forall |a: usize| a < lo ==> #[trigger] v[a] < k,
                forall |b: usize| hi <= b && b < v.len() ==> k <= #[trigger] v[b],
            decreases hi - lo,
        {
            let mid: usize = lo + (hi - lo) / 2;
            if v[mid] < k {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }

    impl<K: Copy + Ord> BTreeSet<K> {
        // An empty set.
        #[effects(alloc)]
        #[uses(empty_set, set_sound, strictly)]
        fn new() -> (r: BTreeSet<K>)
            ensures empty_set::<K>(&r),
        {
            let v: Vec<K> = Vec::new();
            BTreeSet { keys: v }
        }

        // The number of keys (Rust's `len`).
        #[effects(pure)]
        #[uses(set_size)]
        fn len(self: &BTreeSet<K>) -> (r: usize)
            ensures set_size::<K>(r, self),
        {
            self.keys.len()
        }

        // Whether `k` is in the set (Rust's `contains`).
        #[effects(pure)]
        #[uses(contained, holds, place, set_sound, strictly)]
        fn contains(self: &BTreeSet<K>, k: K) -> (r: bool)
            ensures contained::<K>(r, self, k),
        {
            let p: usize = locate::<K>(self.keys.as_slice(), k);
            p < self.keys.len() && self.keys[p] == k
        }

        // `k` is at position `i` (Rust's ordered iteration: `iter().nth(i)`).
        #[effects(pure)]
        #[uses(at_pos, set_sound, strictly)]
        fn at(self: &BTreeSet<K>, i: usize) -> (r: K)
            requires at_pos::<K>(self, i),
        {
            self.keys[i]
        }

        // Adds `k`; whether it was new (Rust's `insert`).
        #[effects(alloc)]
        #[uses(added, holds, in_order, insert_pre, inserted_at, kept_set, place, room_set, set_grew, set_sound, shifted, strictly)]
        fn insert(self: &mut BTreeSet<K>, k: K) -> (r: bool)
            requires room_set::<K>(self),
            ensures added::<K>(r, self, old(self), k), set_grew::<K>(self, old(self)),
        {
            let p: usize = locate::<K>(self.keys.as_slice(), k);
            if p < self.keys.len() && self.keys[p] == k {
                return false;
            }
            // Shifted outside the set: its keys are in order at every loop head.
            let mut v: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());
            let n: usize = v.len();
            v.push(k);
            let mut j: usize = n;
            while j > p
                invariant p <= j, j <= n, v.len() == n + 1, old(self).keys.len() == n,
                    shifted::<K>(v.as_slice(), old(self).keys.as_slice(), j),
                decreases j,
            {
                v[j] = v[j - 1];
                j = j - 1;
            }
            v[p] = k;
            proof {
                insert_keeps_order::<K>(v.as_slice(), old(self).keys.as_slice(), p, k);
            }
            assert(inserted_at::<K>(v.as_slice(), old(self).keys.as_slice(), p, k));
            self.keys = v;
            true
        }

        // Takes `k` out; whether it was there (Rust's `remove`).
        #[effects(alloc)]
        #[uses(dropped, holds, in_order, kept_set, place, remove_pre, removed_at, set_shrank, set_sound, strictly, unshifted)]
        fn remove(self: &mut BTreeSet<K>, k: K) -> (r: bool)
            ensures dropped::<K>(r, self, old(self), k), set_shrank::<K>(self, old(self)),
        {
            let p: usize = locate::<K>(self.keys.as_slice(), k);
            if p >= self.keys.len() || self.keys[p] != k {
                return false;
            }
            let mut v: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());
            let n: usize = v.len();
            let mut j: usize = p;
            while j + 1 < n
                invariant p <= j, j < n, v.len() == n, old(self).keys.len() == n,
                    unshifted::<K>(v.as_slice(), old(self).keys.as_slice(), p, j),
                decreases n - j,
            {
                v[j] = v[j + 1];
                j = j + 1;
            }
            v.truncate(n - 1);
            proof {
                remove_keeps_order::<K>(v.as_slice(), old(self).keys.as_slice(), p);
            }
            assert(removed_at::<K>(v.as_slice(), old(self).keys.as_slice(), p));
            self.keys = v;
            true
        }
    }

    // During the left shift: the old keys before `j` with the one at `p`
    // left out, the old keys from `j` on.
    spec fn unshifted<K: Copy>(v: &[K], w: &[K], p: usize, j: usize) -> bool {
        p <= j && j < w.len() && v.len() == w.len()
            && (forall |i: usize| i < p ==> #[trigger] v[i] == w[i])
            && (forall |m: usize| p <= m && m < j ==> #[trigger] v[m] == w[m + 1])
            && (forall |q: usize| j <= q && q < w.len() ==> #[trigger] v[q] == w[q])
    }

    // `v` is `w` without its key at `p`.
    spec fn removed_at<K: Copy>(v: &[K], w: &[K], p: usize) -> bool {
        p < w.len() && v.len() + 1 == w.len()
            && (forall |i: usize| i < p ==> #[trigger] v[i] == w[i])
            && (forall |m: usize| p <= m && m < v.len() ==> #[trigger] v[m] == w[m + 1])
    }

    spec fn remove_pre<K: Copy + Ord>(v: &[K], w: &[K], p: usize) -> bool {
        strictly::<K>(w) && removed_at::<K>(v, w, p)
    }

    // Taking a key out keeps the keys strictly ascending.
    #[uses(in_order, remove_pre, removed_at, strictly)]
    proof fn remove_keeps_order<K: Copy + Ord>(v: &[K], w: &[K], p: usize)
        requires remove_pre::<K>(v, w, p),
        ensures in_order::<K>(v),
    {
    }

    // `remove`'s result: there and taken out from its place, or not there
    // and nothing changed.
    spec fn dropped<K: Copy + Ord>(r: bool, s: &BTreeSet<K>, t: &BTreeSet<K>, k: K) -> bool {
        (r && holds::<K>(t, k) && exists |p: usize| p < t.keys.len() && t.keys[p] == k && #[trigger] removed_at::<K>(s.keys.as_slice(), t.keys.as_slice(), p))
            || (!r && !holds::<K>(t, k) && kept_set::<K>(s, t))
    }

    spec fn insert_pre<K: Copy + Ord>(v: &[K], w: &[K], p: usize, k: K) -> bool {
        strictly::<K>(w) && place::<K>(w, k, p) && (p == w.len() || w[p] != k) && inserted_at::<K>(v, w, p, k)
    }

    spec fn in_order<K: Copy + Ord>(v: &[K]) -> bool {
        strictly::<K>(v)
    }

    // Inserting a new key at its place keeps the keys strictly ascending.
    #[uses(in_order, insert_pre, inserted_at, place, shifted, strictly)]
    proof fn insert_keeps_order<K: Copy + Ord>(v: &[K], w: &[K], p: usize, k: K)
        requires insert_pre::<K>(v, w, p, k),
        ensures in_order::<K>(v),
    {
    }

    spec fn empty_set<K: Copy + Ord>(s: &BTreeSet<K>) -> bool {
        s.keys.len() == 0
    }

    spec fn set_size<K: Copy + Ord>(r: usize, s: &BTreeSet<K>) -> bool {
        r == s.keys.len()
    }

    // The set has at most one key more (what a caller needs to insert again).
    spec fn set_grew<K: Copy + Ord>(s: &BTreeSet<K>, t: &BTreeSet<K>) -> bool {
        t.keys.len() <= s.keys.len() && s.keys.len() <= t.keys.len() + 1
    }

    spec fn set_shrank<K: Copy + Ord>(s: &BTreeSet<K>, t: &BTreeSet<K>) -> bool {
        s.keys.len() <= t.keys.len()
    }

    spec fn at_pos<K: Copy + Ord>(s: &BTreeSet<K>, i: usize) -> bool {
        i < s.keys.len()
    }

    spec fn room_set<K: Copy + Ord>(s: &BTreeSet<K>) -> bool {
        s.keys.len() + 1 < 1152921504606846975
    }

    // During the shift: before `j` the old keys, after `j` the old keys one
    // place on.
    spec fn shifted<K: Copy>(v: &[K], w: &[K], j: usize) -> bool {
        j <= w.len() && w.len() + 1 == v.len()
            && (forall |i: usize| i < j ==> #[trigger] v[i] == w[i])
            && (forall |m: usize| j < m && m <= w.len() ==> #[trigger] v[m] == w[m - 1])
    }

    // `v` is `w` with `k` at `p`.
    spec fn inserted_at<K: Copy>(v: &[K], w: &[K], p: usize, k: K) -> bool {
        p <= w.len() && v[p] == k && shifted::<K>(v, w, p)
    }

    spec fn kept_set<K: Copy + Ord>(s: &BTreeSet<K>, t: &BTreeSet<K>) -> bool {
        s.keys.len() == t.keys.len() && forall |i: usize| i < s.keys.len() ==> #[trigger] s.keys[i] == t.keys[i]
    }

    // `insert`'s result: new and inserted in order, or there already and
    // nothing changed.
    spec fn added<K: Copy + Ord>(r: bool, s: &BTreeSet<K>, t: &BTreeSet<K>, k: K) -> bool {
        (r && !holds::<K>(t, k) && exists |p: usize| place::<K>(t.keys.as_slice(), k, p) && #[trigger] inserted_at::<K>(s.keys.as_slice(), t.keys.as_slice(), p, k))
            || (!r && holds::<K>(t, k) && kept_set::<K>(s, t))
    }

    // ---------- maps ----------

    // A map from keys in ascending order to values (Rust's `BTreeMap<K, V>`):
    // the value of `keys[i]` is `vals[i]`.
    #[invariant(map_sound)]
    struct BTreeMap<K: Copy + Ord, V: Copy> { keys: Vec<K>, vals: Vec<V> }

    spec fn map_sound<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>) -> bool {
        strictly::<K>(m.keys.as_slice()) && m.keys.len() == m.vals.len() && m.keys.len() < 1152921504606846975
    }

    // `m` maps `k` to `v`.
    spec fn maps<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>, k: K, v: V) -> bool {
        exists |i: usize| i < m.keys.len() && #[trigger] m.keys[i] == k && m.vals[i] == v
    }

    // `m` has the key `k`.
    spec fn has_key<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>, k: K) -> bool {
        exists |i: usize| i < m.keys.len() && #[trigger] m.keys[i] == k
    }

    spec fn got<K: Copy + Ord, V: Copy>(r: Option<V>, m: &BTreeMap<K, V>, k: K) -> bool {
        match r {
            None => !has_key::<K, V>(m, k),
            Some(v) => maps::<K, V>(m, k, v),
        }
    }

    spec fn key_pos<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>, i: usize) -> bool {
        i < m.keys.len()
    }

    spec fn map_room<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>) -> bool {
        m.keys.len() + 1 < 1152921504606846975
    }

    // `v` is `w` with `x` at `p` instead.
    spec fn replaced<V: Copy>(v: &[V], w: &[V], p: usize, x: V) -> bool {
        p < w.len() && v.len() == w.len() && v[p] == x
            && forall |i: usize| i < w.len() && i != p ==> #[trigger] v[i] == w[i]
    }

    spec fn kept_map<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {
        m.keys.len() == n.keys.len()
            && (forall |i: usize| i < m.keys.len() ==> #[trigger] m.keys[i] == n.keys[i])
            && (forall |j: usize| j < m.vals.len() ==> #[trigger] m.vals[j] == n.vals[j])
    }

    spec fn same_keys<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {
        m.keys.len() == n.keys.len() && forall |i: usize| i < m.keys.len() ==> #[trigger] m.keys[i] == n.keys[i]
    }

    // `insert`'s result: a new key in its place with its value, or the old
    // value of the key, replaced.
    spec fn put<K: Copy + Ord, V: Copy>(r: Option<V>, m: &BTreeMap<K, V>, n: &BTreeMap<K, V>, k: K, x: V) -> bool {
        match r {
            None => !has_key::<K, V>(n, k)
                && exists |p: usize| place::<K>(n.keys.as_slice(), k, p)
                    && #[trigger] inserted_at::<K>(m.keys.as_slice(), n.keys.as_slice(), p, k)
                    && inserted_at::<V>(m.vals.as_slice(), n.vals.as_slice(), p, x),
            Some(y) => exists |q: usize| q < n.keys.len() && n.keys[q] == k && n.vals[q] == y
                && same_keys::<K, V>(m, n) && #[trigger] replaced::<V>(m.vals.as_slice(), n.vals.as_slice(), q, x),
        }
    }

    // `remove`'s result: the key's value, the key taken out from its place,
    // or none and nothing changed.
    spec fn took<K: Copy + Ord, V: Copy>(r: Option<V>, m: &BTreeMap<K, V>, n: &BTreeMap<K, V>, k: K) -> bool {
        match r {
            None => !has_key::<K, V>(n, k) && kept_map::<K, V>(m, n),
            Some(y) => exists |p: usize| p < n.keys.len() && n.keys[p] == k && n.vals[p] == y
                && #[trigger] removed_at::<K>(m.keys.as_slice(), n.keys.as_slice(), p)
                && removed_at::<V>(m.vals.as_slice(), n.vals.as_slice(), p),
        }
    }

    impl<K: Copy + Ord, V: Copy> BTreeMap<K, V> {
        // An empty map.
        #[effects(alloc)]
        #[uses(empty_map, map_sound, strictly)]
        fn new() -> (r: BTreeMap<K, V>)
            ensures empty_map::<K, V>(&r),
        {
            let k: Vec<K> = Vec::new();
            let v: Vec<V> = Vec::new();
            BTreeMap { keys: k, vals: v }
        }

        // The number of keys (Rust's `len`).
        #[effects(pure)]
        #[uses(map_size)]
        fn len(self: &BTreeMap<K, V>) -> (r: usize)
            ensures map_size::<K, V>(r, self),
        {
            self.keys.len()
        }

        // The value of `k` (Rust's `get`, the value copied).
        #[effects(pure)]
        #[uses(got, has_key, map_sound, maps, place, strictly)]
        fn get(self: &BTreeMap<K, V>, k: K) -> (r: Option<V>)
            ensures got::<K, V>(r, self, k),
        {
            let p: usize = locate::<K>(self.keys.as_slice(), k);
            if p < self.keys.len() && self.keys[p] == k {
                return Some(self.vals[p]);
            }
            None
        }

        // Whether the map has `k` (Rust's `contains_key`).
        #[effects(pure)]
        #[uses(has_key, has_result, map_sound, place, strictly)]
        fn contains_key(self: &BTreeMap<K, V>, k: K) -> (r: bool)
            ensures has_result::<K, V>(r, self, k),
        {
            let p: usize = locate::<K>(self.keys.as_slice(), k);
            p < self.keys.len() && self.keys[p] == k
        }

        // The key at position `i` in ascending order (Rust's `iter().nth(i)`).
        #[effects(pure)]
        #[uses(key_pos, map_sound)]
        fn key_at(self: &BTreeMap<K, V>, i: usize) -> K
            requires key_pos::<K, V>(self, i),
        {
            self.keys[i]
        }

        // The value at position `i` in the order of the keys.
        #[effects(pure)]
        #[uses(key_pos, map_sound)]
        fn value_at(self: &BTreeMap<K, V>, i: usize) -> V
            requires key_pos::<K, V>(self, i),
        {
            self.vals[i]
        }

        // Maps `k` to `x`; the old value (Rust's `insert`).
        #[effects(alloc)]
        #[uses(has_key, in_order, insert_pre, inserted_at, map_grew, map_room, map_sound, place, put, replaced, same_keys, shifted, strictly)]
        fn insert(self: &mut BTreeMap<K, V>, k: K, x: V) -> (r: Option<V>)
            requires map_room::<K, V>(self),
            ensures put::<K, V>(r, self, old(self), k, x), map_grew::<K, V>(self, old(self)),
        {
            let p: usize = locate::<K>(self.keys.as_slice(), k);
            if p < self.keys.len() && self.keys[p] == k {
                let y: V = self.vals[p];
                self.vals[p] = x;
                assert(replaced::<V>(self.vals.as_slice(), old(self).vals.as_slice(), p, x));
                return Some(y);
            }
            let mut ks: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());
            let mut vs: Vec<V> = std::mem::replace(&mut self.vals, Vec::new());
            let n: usize = ks.len();
            ks.push(k);
            vs.push(x);
            let mut j: usize = n;
            while j > p
                invariant p <= j, j <= n, ks.len() == n + 1, vs.len() == n + 1,
                    old(self).keys.len() == n, old(self).vals.len() == n,
                    shifted::<K>(ks.as_slice(), old(self).keys.as_slice(), j),
                    shifted::<V>(vs.as_slice(), old(self).vals.as_slice(), j),
                decreases j,
            {
                ks[j] = ks[j - 1];
                vs[j] = vs[j - 1];
                j = j - 1;
            }
            ks[p] = k;
            vs[p] = x;
            proof {
                insert_keeps_order::<K>(ks.as_slice(), old(self).keys.as_slice(), p, k);
            }
            assert(inserted_at::<K>(ks.as_slice(), old(self).keys.as_slice(), p, k));
            assert(inserted_at::<V>(vs.as_slice(), old(self).vals.as_slice(), p, x));
            self.keys = ks;
            self.vals = vs;
            None
        }

        // Takes `k` out; its value (Rust's `remove`).
        #[effects(alloc)]
        #[uses(has_key, in_order, kept_map, map_shrank, map_sound, place, remove_pre, removed_at, strictly, took, unshifted)]
        fn remove(self: &mut BTreeMap<K, V>, k: K) -> (r: Option<V>)
            ensures took::<K, V>(r, self, old(self), k), map_shrank::<K, V>(self, old(self)),
        {
            let p: usize = locate::<K>(self.keys.as_slice(), k);
            if p >= self.keys.len() || self.keys[p] != k {
                return None;
            }
            let y: V = self.vals[p];
            let mut ks: Vec<K> = std::mem::replace(&mut self.keys, Vec::new());
            let mut vs: Vec<V> = std::mem::replace(&mut self.vals, Vec::new());
            let n: usize = ks.len();
            let mut j: usize = p;
            while j + 1 < n
                invariant p <= j, j < n, ks.len() == n, vs.len() == n,
                    old(self).keys.len() == n, old(self).vals.len() == n,
                    unshifted::<K>(ks.as_slice(), old(self).keys.as_slice(), p, j),
                    unshifted::<V>(vs.as_slice(), old(self).vals.as_slice(), p, j),
                decreases n - j,
            {
                ks[j] = ks[j + 1];
                vs[j] = vs[j + 1];
                j = j + 1;
            }
            ks.truncate(n - 1);
            vs.truncate(n - 1);
            proof {
                remove_keeps_order::<K>(ks.as_slice(), old(self).keys.as_slice(), p);
            }
            assert(removed_at::<K>(ks.as_slice(), old(self).keys.as_slice(), p));
            self.keys = ks;
            self.vals = vs;
            Some(y)
        }
    }

    spec fn empty_map<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>) -> bool {
        m.keys.len() == 0
    }

    spec fn map_size<K: Copy + Ord, V: Copy>(r: usize, m: &BTreeMap<K, V>) -> bool {
        r == m.keys.len()
    }

    // The map has at most one key more.
    spec fn map_grew<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {
        n.keys.len() <= m.keys.len() && m.keys.len() <= n.keys.len() + 1
    }

    spec fn map_shrank<K: Copy + Ord, V: Copy>(m: &BTreeMap<K, V>, n: &BTreeMap<K, V>) -> bool {
        m.keys.len() <= n.keys.len()
    }

    spec fn has_result<K: Copy + Ord, V: Copy>(r: bool, m: &BTreeMap<K, V>, k: K) -> bool {
        r == has_key::<K, V>(m, k)
    }
}
