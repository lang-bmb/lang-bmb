#[summary("UTF-8 검증(T4-02): Unicode 표 3-7의 잘 짜인 바이트 시퀀스. 결과는 Rust str::from_utf8의 valid_up_to와 같다")]
mod utf8 {
    spec fn cont(b: u8) -> bool { 128 <= b && b <= 191 }

    // The second byte of a three-byte sequence led by `a` (table 3-7: E0 A0..BF, ED 80..9F, else 80..BF).
    spec fn second3(a: u8, b: u8) -> bool {
        (a == 224 && 160 <= b && b <= 191) || (a == 237 && 128 <= b && b <= 159) || (a != 224 && a != 237 && cont(b))
    }

    // The second byte of a four-byte sequence led by `a` (table 3-7: F0 90..BF, F4 80..8F, else 80..BF).
    spec fn second4(a: u8, b: u8) -> bool {
        (a == 240 && 144 <= b && b <= 191) || (a == 244 && 128 <= b && b <= 143) || (a != 240 && a != 244 && cont(b))
    }

    // Length of the well-formed sequence that starts at `i`, 0 when none does (ill-formed or cut off).
    spec fn seq_len(s: &[u8], i: usize) -> usize {
        if i >= s.len() {
            0
        } else if s[i] <= 127 {
            1
        } else if s[i] < 194 {
            0
        } else if s[i] <= 223 {
            if i + 1 < s.len() && cont(s[i + 1]) { 2 } else { 0 }
        } else if s[i] <= 239 {
            if i + 2 < s.len() && second3(s[i], s[i + 1]) && cont(s[i + 2]) { 3 } else { 0 }
        } else if s[i] <= 244 {
            if i + 3 < s.len() && second4(s[i], s[i + 1]) && cont(s[i + 2]) && cont(s[i + 3]) { 4 } else { 0 }
        } else {
            0
        }
    }

    // `s[i..n]` is a concatenation of well-formed sequences: the scan from `i` reaches `n` exactly.
    spec fn parses(s: &[u8], i: usize, n: usize) -> bool
        decreases n - i,
    {
        if i >= n { i == n } else { 0 < seq_len(s, i) && i + seq_len(s, i) <= n && parses(s, i + seq_len(s, i), n) }
    }

    // `s[0..n]` is a concatenation of well-formed sequences.
    spec fn valid_upto(s: &[u8], n: usize) -> bool { n <= s.len() && parses(s, 0, n) }

    // Where the scan stops: the end, or a byte that starts no well-formed sequence.
    spec fn stops(s: &[u8], r: usize) -> bool { r == s.len() || seq_len(s, r) == 0 }

    spec fn step_ok(s: &[u8], a: usize, i: usize) -> bool {
        a <= i && parses(s, a, i) && 0 < seq_len(s, i) && i + seq_len(s, i) <= s.len()
    }

    spec fn extended(s: &[u8], a: usize, i: usize) -> bool { parses(s, a, i + seq_len(s, i)) }

    // A concatenation followed by one more well-formed sequence is a concatenation: induction on
    // the sequences of `s[a..i]` (ADR-0062).
    #[uses(extended, parses, step_ok)]
    proof fn parses_extend(s: &[u8], a: usize, i: usize)
        requires step_ok(s, a, i),
        ensures extended(s, a, i),
        decreases i - a,
    {
        if a < i {
            parses_extend(s, a + seq_len(s, a), i);
        }
    }

    spec fn two_ends(s: &[u8], a: usize, r: usize, n: usize) -> bool {
        a <= r && r < n && parses(s, a, r) && parses(s, a, n)
    }

    spec fn goes_on(s: &[u8], r: usize) -> bool { 0 < seq_len(s, r) }

    // The scan is deterministic: a concatenation that reaches `r` and one that reaches past it
    // agree up to `r`, so a sequence starts at `r`.
    #[uses(goes_on, parses, two_ends)]
    proof fn parse_goes_on(s: &[u8], a: usize, r: usize, n: usize)
        requires two_ends(s, a, r, n),
        ensures goes_on(s, r),
        decreases r - a,
    {
        if a < r {
            parse_goes_on(s, a + seq_len(s, a), r, n);
        }
    }

    spec fn width_result(s: &[u8], i: usize, w: usize) -> bool { w == seq_len(s, i) }

    spec fn at(s: &[u8], i: usize) -> bool { i < s.len() }

    // `seq_len(s, i)` computed.
    #[effects(pure)]
    #[uses(width_result, seq_len, cont, second3, second4, at)]
    fn width(s: &[u8], i: usize) -> (w: usize)
        requires at(s, i),
        ensures width_result(s, i, w),
    {
        let b: u8 = s[i];
        if b <= 127 {
            1
        } else if b < 194 {
            0
        } else if b <= 223 {
            if i + 1 < s.len() && s[i + 1] >= 128 && s[i + 1] <= 191 { 2 } else { 0 }
        } else if b <= 239 {
            if i + 2 < s.len() {
                let c: u8 = s[i + 1];
                let ok: bool = if b == 224 {
                    c >= 160 && c <= 191
                } else if b == 237 {
                    c >= 128 && c <= 159
                } else {
                    c >= 128 && c <= 191
                };
                if ok && s[i + 2] >= 128 && s[i + 2] <= 191 { 3 } else { 0 }
            } else {
                0
            }
        } else if b <= 244 {
            if i + 3 < s.len() {
                let d: u8 = s[i + 1];
                let fits: bool = if b == 240 {
                    d >= 144 && d <= 191
                } else if b == 244 {
                    d >= 128 && d <= 143
                } else {
                    d >= 128 && d <= 191
                };
                if fits && s[i + 2] >= 128 && s[i + 2] <= 191 && s[i + 3] >= 128 && s[i + 3] <= 191 { 4 } else { 0 }
            } else {
                0
            }
        } else {
            0
        }
    }

    // The length of the longest prefix of `s` that is well-formed UTF-8 (Rust: `Utf8Error::valid_up_to`,
    // or `s.len()` when `str::from_utf8(s)` succeeds).
    #[effects(pure)]
    #[uses(valid_upto, stops, parses, extended, step_ok, seq_len, width_result, at)]
    fn valid_up_to(s: &[u8]) -> (r: usize)
        ensures valid_upto(s, r), stops(s, r),
    {
        let mut i: usize = 0;
        while i < s.len()
            invariant valid_upto(s, i),
            decreases s.len() - i,
        {
            let w: usize = width(s, i);
            if w == 0 {
                break;
            }
            proof {
                parses_extend(s, 0, i);
            }
            i = i + w;
        }
        i
    }

    spec fn valid(s: &[u8]) -> bool { valid_upto(s, s.len()) }

    spec fn valid_result(s: &[u8], r: bool) -> bool { (r && valid(s)) || (!r && !valid(s)) }

    // Whether all of `s` is well-formed UTF-8 (Rust: `str::from_utf8(s).is_ok()`).
    #[effects(pure)]
    #[uses(valid, valid_result, valid_upto, stops, goes_on, two_ends)]
    fn is_valid(s: &[u8]) -> (r: bool)
        ensures valid_result(s, r),
    {
        let n: usize = valid_up_to(s);
        // Stopped early: no concatenation reaches the end (it would go on at `n`).
        proof {
            if n < s.len() && valid(s) {
                parse_goes_on(s, 0, n, s.len());
            }
        }
        n == s.len()
    }
}
