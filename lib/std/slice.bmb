#[summary("슬라이스 연산(Rust `slice`의 이름과 뜻): 키의 안정 정렬 순서와 이진 탐색. 정렬은 위치의 순열로 돌려준다 (ADR-0092 §2, backlog 4B-02)")]
mod slice {
    // ---------- sorted order ----------

    // Every index of `r` is below `n`.
    spec fn below(r: &[usize], n: usize) -> bool {
        forall |i: usize| i < r.len() ==> #[trigger] r[i] < n
    }

    // Position `x` comes before position `y` in a stable sort by `keys`:
    // a smaller key, or the same key and a smaller position.
    spec fn before<T: Ord>(keys: &[T], x: usize, y: usize) -> bool {
        keys[x] < keys[y] || (keys[x] == keys[y] && x < y)
    }

    // The positions `r[0..n]` are in stable order by `keys`, except that
    // position `j` of `r` is left out (`n` when none is).
    spec fn ordered_but<T: Ord>(keys: &[T], r: &[usize], j: usize, n: usize) -> bool {
        n <= r.len()
            && forall |a: usize, b: usize| a < b && b < n && a != j && b != j
                ==> before::<T>(keys, #[trigger] r[a], #[trigger] r[b])
    }

    // `r` lists the positions of `keys` in stable order: a permutation of
    // `0..n`, since stable order holds no position twice (two equal ones
    // would need `x < x`).
    spec fn sorted_order<T: Ord>(r: &[usize], keys: &[T]) -> bool {
        r.len() == keys.len() && below(r, keys.len()) && ordered_but::<T>(keys, r, r.len(), r.len())
    }

    // A `Vec<usize>` of `keys.len()` positions fits (eight bytes each).
    spec fn bounded<T: Ord>(keys: &[T]) -> bool {
        keys.len() < 1152921504606846975
    }

    // Every position of `r` but `j` is below `x`.
    spec fn others_below(r: &[usize], j: usize, n: usize, x: usize) -> bool {
        n <= r.len() && forall |a: usize| a < n && a != j ==> #[trigger] r[a] < x
    }

    // The keys of `r` after position `j` are above `keys[x]`.
    spec fn above<T: Ord>(keys: &[T], r: &[usize], j: usize, n: usize, x: usize) -> bool {
        n <= r.len() && forall |b: usize| j < b && b < n ==> keys[x] < keys[#[trigger] r[b]]
    }

    // The positions of `keys` in the order of their keys, equal keys in the
    // order of their positions: the order Rust's stable `sort_by_key` puts
    // the items in (`v[r[0]], v[r[1]], ..` is the sorted `v`).
    #[effects(alloc)]
    #[uses(before)]
    fn sort_indices<T: Ord>(keys: &[T]) -> (out: Vec<usize>)
        requires bounded::<T>(keys),
        ensures sorted_order::<T>(out.as_slice(), keys),
    {
        let mut r: Vec<usize> = Vec::new();
        let mut i: usize = 0;
        while i < keys.len()
            invariant i <= keys.len(), r.len() == i, below(r.as_slice(), i),
                ordered_but::<T>(keys, r.as_slice(), i, i),
            decreases keys.len() - i,
        {
            r.push(i);
            // Move `i` back past every position with a larger key.
            let mut j: usize = i;
            while j > 0 && keys[r[j - 1]] > keys[i]
                invariant j <= i, r.len() == i + 1, i < keys.len(), r[j] == i, below(r.as_slice(), i + 1),
                    others_below(r.as_slice(), j, i + 1, i),
                    ordered_but::<T>(keys, r.as_slice(), j, i + 1), above::<T>(keys, r.as_slice(), j, i + 1, i),
                decreases j,
            {
                let t: usize = r[j - 1];
                r[j - 1] = i;
                r[j] = t;
                j = j - 1;
            }
            i = i + 1;
        }
        r
    }

    // No position of `r` occurs twice.
    spec fn distinct(r: &[usize]) -> bool {
        forall |i: usize, j: usize| i < j && j < r.len() ==> #[trigger] r[i] != #[trigger] r[j]
    }

    spec fn order_of<T: Ord>(r: &[usize], keys: &[T]) -> bool {
        sorted_order::<T>(r, keys)
    }

    // A stable order of `keys` is a permutation of its positions: each
    // below the length, none twice.
    #[uses(before, below, ordered_but, sorted_order)]
    proof fn sorted_is_perm<T: Ord>(r: &[usize], keys: &[T])
        requires order_of::<T>(r, keys),
        ensures distinct(r),
    {
    }

    // ---------- binary search ----------

    spec fn ascending<T: Copy + Ord>(v: &[T]) -> bool {
        forall |i: usize, j: usize| i < j && j < v.len() ==> #[trigger] v[i] <= #[trigger] v[j]
    }

    // `x` is not in `v` before `a` nor from `b`.
    spec fn outside<T: Copy + Ord>(v: &[T], x: T, a: usize, b: usize) -> bool {
        a <= b && b <= v.len()
            && (forall |k: usize| k < a ==> #[trigger] v[k] < x)
            && (forall |m: usize| b <= m && m < v.len() ==> x < #[trigger] v[m])
    }

    // Rust's `binary_search` on a sorted slice: `Ok(i)` where `v[i] == x`
    // (any of them when several are), `Err(i)` where inserting `x` keeps the
    // order (everything before is below it, everything after above).
    spec fn searched<T: Copy + Ord>(r: Result<usize, usize>, v: &[T], x: T) -> bool {
        match r {
            Ok(i) => i < v.len() && v[i] == x,
            Err(j) => outside::<T>(v, x, j, j),
        }
    }

    #[effects(pure)]
    fn binary_search<T: Copy + Ord>(v: &[T], x: T) -> (r: Result<usize, usize>)
        requires ascending::<T>(v),
        ensures searched::<T>(r, v, x),
    {
        let mut lo: usize = 0;
        let mut hi: usize = v.len();
        while lo < hi
            invariant outside::<T>(v, x, lo, hi),
            decreases hi - lo,
        {
            let mid: usize = lo + (hi - lo) / 2;
            if v[mid] < x {
                lo = mid + 1;
            } else if x < v[mid] {
                hi = mid;
            } else {
                return Ok(mid);
            }
        }
        Err(lo)
    }
}
