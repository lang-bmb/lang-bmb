#[summary("base64(T4-03): RFC 4648 §4의 표준 알파벳과 '=' 채우기. encode는 명세 enc_at과 같고 정규형이며 dec_byte로 되읽힘, decode는 정규형(§3.5: 버리는 비트가 0)만 받고 명세 dec_byte와 같음이 증명된다. 왕복 decode(encode(s)) == Some(s)도 증명된다")]
mod base64 {
    // ---------- the alphabet (§4, table 1) ----------

    // The character of the 6-bit value `x`.
    spec fn alpha(x: u8) -> u8 {
        if x < 26 { x + 65 } else if x < 52 { x + 71 } else if x < 62 { x - 4 } else if x == 62 { 43 } else { 47 }
    }

    // The value of character `c`: 0..64 for the alphabet, 64 for any other byte.
    spec fn val(c: u8) -> u8 {
        if 65 <= c && c <= 90 { c - 65 } else if 97 <= c && c <= 122 { c - 71 } else if 48 <= c && c <= 57 { c + 4 } else if c == 43 { 62 } else if c == 47 { 63 } else { 64 }
    }

    spec fn sym(c: u8) -> bool { val(c) < 64 }

    // ---------- encoding (§4) ----------

    // The four 6-bit values of a 24-bit group of bytes `a`, `b`, `c`, most
    // significant first.
    spec fn e0(a: u8) -> u8 { a / 4 }

    spec fn e1(a: u8, b: u8) -> u8 { a % 4 * 16 + b / 16 }

    spec fn e2(b: u8, c: u8) -> u8 { b % 16 * 4 + c / 64 }

    spec fn e3(c: u8) -> u8 { c % 64 }

    // Byte `k` of `s`, zero past the end.
    spec fn at0(s: &[u8], k: usize) -> u8 { if k < s.len() { s[k] } else { 0 } }

    spec fn enc_len(n: usize) -> usize { (n + 2) / 3 * 4 }

    // Character `i` of the encoding of `s`: group `i / 4` holds bytes
    // `3 * (i / 4)` to `3 * (i / 4) + 2` (zero past the end), and a group
    // of one byte ends in `==`, of two in `=`.
    spec fn enc_at(s: &[u8], i: usize) -> u8 {
        if i % 4 == 0 {
            alpha(e0(at0(s, 3 * (i / 4))))
        } else if i % 4 == 1 {
            alpha(e1(at0(s, 3 * (i / 4)), at0(s, 3 * (i / 4) + 1)))
        } else if i % 4 == 2 {
            if 3 * (i / 4) + 1 >= s.len() { 61 } else { alpha(e2(at0(s, 3 * (i / 4) + 1), at0(s, 3 * (i / 4) + 2))) }
        } else {
            if 3 * (i / 4) + 2 >= s.len() { 61 } else { alpha(e3(at0(s, 3 * (i / 4) + 2))) }
        }
    }

    spec fn encoded(s: &[u8], t: &[u8]) -> bool {
        t.len() == enc_len(s.len()) && forall|i: usize| i < t.len() ==> #[trigger] t[i] == enc_at(s, i)
    }

    // ---------- decoding (§3.3, §3.5) ----------

    // The number of `=` at the end (at most two count).
    spec fn pads(t: &[u8]) -> usize {
        if t.len() >= 1 && t[t.len() - 1] == 61 { if t.len() >= 2 && t[t.len() - 2] == 61 { 2 } else { 1 } } else { 0 }
    }

    // A canonical encoding: whole groups of four, characters of the
    // alphabet but for one or two `=` at the end, and the bits the padding
    // drops are zero (§3.5), so no two byte strings have one encoding.
    spec fn well_formed(t: &[u8]) -> bool {
        t.len() % 4 == 0 && (forall|i: usize| i < t.len() ==> sym(#[trigger] t[i]) || (t[i] == 61 && i + pads(t) >= t.len())) && (pads(t) != 1 || val(t[t.len() - 2]) % 4 == 0) && (pads(t) != 2 || val(t[t.len() - 3]) % 16 == 0)
    }

    spec fn valid_result(t: &[u8], r: bool) -> bool { (r && well_formed(t)) || (!r && !well_formed(t)) }

    // A character's value, `=` counting as zero.
    spec fn vz(c: u8) -> u8 { if c == 61 { 0 } else { val(c) } }

    // The bytes of four 6-bit values `x`, `y`, `z`, `w`.
    spec fn d0(x: u8, y: u8) -> u8 { x * 4 + y / 16 }

    spec fn d1(y: u8, z: u8) -> u8 { y % 16 * 16 + z / 4 }

    spec fn d2(z: u8, w: u8) -> u8 { z % 4 * 64 + w }

    // Byte `k` of the decoding of `t`: from the characters of group `k / 3`.
    spec fn dec_byte(t: &[u8], k: usize) -> u8 {
        if k % 3 == 0 {
            d0(vz(t[4 * (k / 3)]), vz(t[4 * (k / 3) + 1]))
        } else if k % 3 == 1 {
            d1(vz(t[4 * (k / 3) + 1]), vz(t[4 * (k / 3) + 2]))
        } else {
            d2(vz(t[4 * (k / 3) + 2]), vz(t[4 * (k / 3) + 3]))
        }
    }

    spec fn dec_len(t: &[u8]) -> usize { t.len() / 4 * 3 - pads(t) }

    // `v` is the decoding of `t`.
    spec fn decodes(t: &[u8], v: &[u8]) -> bool {
        v.len() == dec_len(t) && forall|k: usize| k < v.len() ==> dec_byte(t, k) == #[trigger] v[k]
    }

    spec fn decoded(t: &[u8], r: Option<Vec<u8>>) -> bool {
        match r {
            None => !well_formed(t),
            Some(v) => well_formed(t) && decodes(t, v.as_slice()),
        }
    }

    // ---------- code: characters ----------

    spec fn six(x: u8) -> bool { x < 64 }

    // The character of `x`, whose value is `x` again.
    spec fn char_result(x: u8, r: u8) -> bool { r == alpha(x) && sym(r) && vz(r) == x }

    spec fn is_vz(c: u8, r: u8) -> bool { r == vz(c) }

    // The character of a 6-bit value.
    #[effects(pure)]
    #[uses(char_result, alpha, sym, val, vz, six)]
    fn char_of(x: u8) -> (r: u8)
        requires six(x),
        ensures char_result(x, r),
    {
        if x < 26 {
            x + 65
        } else if x < 52 {
            x + 71
        } else if x < 62 {
            x - 4
        } else if x == 62 {
            43
        } else {
            47
        }
    }

    // A character's value, `=` counting as zero, 64 for a byte outside the alphabet.
    #[effects(pure)]
    #[uses(is_vz, vz, val)]
    fn value(c: u8) -> (r: u8)
        ensures is_vz(c, r),
    {
        if c >= 65 && c <= 90 {
            c - 65
        } else if c >= 97 && c <= 122 {
            c - 71
        } else if c >= 48 && c <= 57 {
            c + 4
        } else if c == 43 {
            62
        } else if c == 47 {
            63
        } else if c == 61 {
            0
        } else {
            64
        }
    }

    // ---------- code: bit fields ----------

    spec fn is_e0(a: u8, r: u8) -> bool { r == e0(a) && r < 64 }

    spec fn is_e1(a: u8, b: u8, r: u8) -> bool { r == e1(a, b) && r < 64 }

    spec fn is_e2(b: u8, c: u8, r: u8) -> bool { r == e2(b, c) && r < 64 }

    spec fn is_e3(c: u8, r: u8) -> bool { r == e3(c) && r < 64 }

    #[effects(pure)]
    #[uses(is_e0, e0)]
    fn field0(a: u8) -> (r: u8)
        ensures is_e0(a, r),
    {
        a >> 2
    }

    // Two bits of `a`, four of `b`.
    #[effects(pure)]
    #[uses(is_e1, e1)]
    fn field1(a: u8, b: u8) -> (r: u8)
        ensures is_e1(a, b, r),
    {
        ((a & 3) << 4) | (b >> 4)
    }

    // Four bits of `b`, two of `c`.
    #[effects(pure)]
    #[uses(is_e2, e2)]
    fn field2(b: u8, c: u8) -> (r: u8)
        ensures is_e2(b, c, r),
    {
        ((b & 15) << 2) | (c >> 6)
    }

    #[effects(pure)]
    #[uses(is_e3, e3)]
    fn field3(c: u8) -> (r: u8)
        ensures is_e3(c, r),
    {
        c & 63
    }

    spec fn is_d0(x: u8, y: u8, r: u8) -> bool { r == d0(x, y) }

    spec fn is_d1(y: u8, z: u8, r: u8) -> bool { r == d1(y, z) }

    spec fn is_d2(z: u8, w: u8, r: u8) -> bool { r == d2(z, w) }

    // `x` and two bits of `y`.
    #[effects(pure)]
    #[uses(is_d0, d0, six)]
    fn byte0(x: u8, y: u8) -> (r: u8)
        requires six(x), six(y),
        ensures is_d0(x, y, r),
    {
        (x << 2) | (y >> 4)
    }

    // Four bits of `y`, four of `z`.
    #[effects(pure)]
    #[uses(is_d1, d1, six)]
    fn byte1(y: u8, z: u8) -> (r: u8)
        requires six(y), six(z),
        ensures is_d1(y, z, r),
    {
        ((y & 15) << 4) | (z >> 2)
    }

    // Two bits of `z`, and `w`.
    #[effects(pure)]
    #[uses(is_d2, d2, six)]
    fn byte2(z: u8, w: u8) -> (r: u8)
        requires six(z), six(w),
        ensures is_d2(z, w, r),
    {
        ((z & 3) << 6) | w
    }

    // ---------- encode ----------

    spec fn fits(s: &[u8]) -> bool { s.len() <= 4611686018427387903 }

    spec fn kept(v: &[u8], w: &[u8]) -> bool {
        w.len() <= v.len() && forall|k: usize| k < w.len() ==> #[trigger] v[k] == w[k]
    }

    spec fn groups_done(t: &[u8], g: usize) -> bool { t.len() == 4 * g }

    spec fn grown(t: &[u8], u: &[u8], g: usize) -> bool { u.len() == 4 * g && t.len() == 4 * g + 4 && kept(t, u) }

    spec fn group_in(s: &[u8], g: usize) -> bool { 3 * g + 3 <= s.len() }

    spec fn tail_at(s: &[u8], g: usize, k: usize) -> bool { 3 * g + k == s.len() }

    // Character `j` of group `g` is its encoding.
    spec fn enc_c(s: &[u8], t: &[u8], g: usize, j: usize) -> bool { t[4 * g + j] == enc_at(s, 4 * g + j) }

    // Byte `r` of group `g`, where `s` has it, decodes back.
    spec fn dec_b(s: &[u8], t: &[u8], g: usize, r: usize) -> bool { 3 * g + r >= s.len() || dec_byte(t, 3 * g + r) == s[3 * g + r] }

    spec fn syms4(t: &[u8], g: usize) -> bool { sym(t[4 * g]) && sym(t[4 * g + 1]) && sym(t[4 * g + 2]) && sym(t[4 * g + 3]) }

    // A last group of one byte: `xx==`, the bits dropped zero.
    spec fn last1(t: &[u8], g: usize) -> bool {
        sym(t[4 * g]) && sym(t[4 * g + 1]) && t[4 * g + 2] == 61 && t[4 * g + 3] == 61 && val(t[4 * g + 1]) % 16 == 0
    }

    // A last group of two bytes: `xxx=`, the bits dropped zero.
    spec fn last2(t: &[u8], g: usize) -> bool {
        sym(t[4 * g]) && sym(t[4 * g + 1]) && sym(t[4 * g + 2]) && t[4 * g + 3] == 61 && val(t[4 * g + 2]) % 4 == 0
    }

    // Appends the encoding of the whole group `g` of `s`.
    #[effects(pure)]
    #[uses(fits, groups_done, grown, kept, group_in, enc_c, dec_b, syms4, enc_at, at0, dec_byte, char_result, is_e0, is_e1, is_e2, is_e3, d0, d1, d2, e0, e1, e2, e3, six)]
    fn push_group(t: &mut Vec<u8>, s: &[u8], g: usize) -> ()
        requires fits(s), group_in(s, g), groups_done(t.as_slice(), g),
        ensures grown(t.as_slice(), old(t).as_slice(), g), enc_c(s, t.as_slice(), g, 0), enc_c(s, t.as_slice(), g, 1), enc_c(s, t.as_slice(), g, 2), enc_c(s, t.as_slice(), g, 3), dec_b(s, t.as_slice(), g, 0), dec_b(s, t.as_slice(), g, 1), dec_b(s, t.as_slice(), g, 2), syms4(t.as_slice(), g),
    {
        let b0: u8 = s[3 * g];
        let b1: u8 = s[3 * g + 1];
        let b2: u8 = s[3 * g + 2];
        t.push(char_of(field0(b0)));
        t.push(char_of(field1(b0, b1)));
        t.push(char_of(field2(b1, b2)));
        t.push(char_of(field3(b2)));
    }

    // Appends the encoding of the last group `g` of `s`, of one byte.
    #[effects(pure)]
    #[uses(fits, groups_done, grown, kept, tail_at, enc_c, dec_b, last1, enc_at, at0, dec_byte, char_result, is_e0, is_e1, d0, d1, d2, e0, e1, six, vz, val, sym)]
    fn push_one(t: &mut Vec<u8>, s: &[u8], g: usize) -> ()
        requires fits(s), tail_at(s, g, 1), groups_done(t.as_slice(), g),
        ensures grown(t.as_slice(), old(t).as_slice(), g), enc_c(s, t.as_slice(), g, 0), enc_c(s, t.as_slice(), g, 1), enc_c(s, t.as_slice(), g, 2), enc_c(s, t.as_slice(), g, 3), dec_b(s, t.as_slice(), g, 0), last1(t.as_slice(), g),
    {
        let c0: u8 = s[3 * g];
        t.push(char_of(field0(c0)));
        t.push(char_of(field1(c0, 0)));
        t.push(b'=');
        t.push(b'=');
    }

    // Appends the encoding of the last group `g` of `s`, of two bytes.
    #[effects(pure)]
    #[uses(fits, groups_done, grown, kept, tail_at, enc_c, dec_b, last2, enc_at, at0, dec_byte, char_result, is_e0, is_e1, is_e2, d0, d1, d2, e0, e1, e2, six, vz, val, sym)]
    fn push_two(t: &mut Vec<u8>, s: &[u8], g: usize) -> ()
        requires fits(s), tail_at(s, g, 2), groups_done(t.as_slice(), g),
        ensures grown(t.as_slice(), old(t).as_slice(), g), enc_c(s, t.as_slice(), g, 0), enc_c(s, t.as_slice(), g, 1), enc_c(s, t.as_slice(), g, 2), enc_c(s, t.as_slice(), g, 3), dec_b(s, t.as_slice(), g, 0), dec_b(s, t.as_slice(), g, 1), last2(t.as_slice(), g),
    {
        let d0: u8 = s[3 * g];
        let d1: u8 = s[3 * g + 1];
        t.push(char_of(field0(d0)));
        t.push(char_of(field1(d0, d1)));
        t.push(char_of(field2(d1, 0)));
        t.push(b'=');
    }

    spec fn enc_upto(s: &[u8], t: &[u8], g: usize) -> bool {
        t.len() == 4 * g && forall|i: usize| i < 4 * g ==> #[trigger] t[i] == enc_at(s, i) && sym(t[i])
    }

    spec fn dec_upto(t: &[u8], s: &[u8], m: usize) -> bool {
        m <= s.len() && forall|k: usize| k < m ==> dec_byte(t, k) == #[trigger] s[k]
    }

    spec fn round_trip(s: &[u8], t: &[u8]) -> bool { encoded(s, t) && well_formed(t) && decodes(t, s) }

    // The base64 encoding of `s` (RFC 4648 §4, with padding). It is
    // canonical and decodes back to `s`.
    #[effects(pure)]
    #[uses(fits, round_trip, encoded, enc_len, enc_upto, dec_upto, decodes, dec_len, dec_byte, well_formed, pads, sym, val, groups_done, grown, kept, group_in, tail_at, enc_c, dec_b, syms4, last1, last2)]
    fn encode(s: &[u8]) -> (r: Vec<u8>)
        requires fits(s),
        ensures encoded(s, r.as_slice()), well_formed(r.as_slice()), decodes(r.as_slice(), s),
    {
        let n: usize = s.len();
        let full: usize = n / 3;
        let mut t: Vec<u8> = Vec::with_capacity((n + 2) / 3 * 4);
        for g in 0..full
            invariant full * 3 <= n, enc_upto(s, t.as_slice(), g), dec_upto(t.as_slice(), s, 3 * g),
        {
            push_group(&mut t, s, g);
        }
        if n - 3 * full == 1 {
            push_one(&mut t, s, full);
        } else if n - 3 * full == 2 {
            push_two(&mut t, s, full);
        }
        t
    }

    // ---------- decode ----------

    spec fn ok_upto(t: &[u8], n: usize) -> bool {
        n <= t.len() && forall|i: usize| i < n ==> sym(#[trigger] t[i]) || (t[i] == 61 && i + pads(t) >= t.len())
    }

    spec fn bad_at(t: &[u8], i: usize) -> bool { i < t.len() && !sym(t[i]) && (t[i] != 61 || i + pads(t) < t.len()) }

    // Whether `t` is a canonical encoding.
    #[effects(pure)]
    #[uses(valid_result, well_formed, pads, sym, val, vz, is_vz, ok_upto, bad_at)]
    fn is_valid(t: &[u8]) -> (r: bool)
        ensures valid_result(t, r),
    {
        let m: usize = t.len();
        if m % 4 != 0 {
            return false;
        }
        let p: usize = if m >= 1 && t[m - 1] == b'=' {
            if m >= 2 && t[m - 2] == b'=' { 2 } else { 1 }
        } else {
            0
        };
        let mut ok: bool = true;
        let mut i: usize = 0;
        while i < m && ok
            invariant i <= m, ok ==> ok_upto(t, i), !ok ==> (0 < i && bad_at(t, i - 1)),
            decreases m - i,
        {
            let c: u8 = t[i];
            let v: u8 = value(c);
            if !(v < 64 && c != b'=') && !(c == b'=' && i + p >= m) {
                ok = false;
            }
            i = i + 1;
        }
        if !ok {
            return false;
        }
        if p == 1 && value(t[m - 2]) % 4 != 0 {
            return false;
        }
        if p == 2 && value(t[m - 3]) % 16 != 0 {
            return false;
        }
        true
    }

    spec fn digits(t: &[u8], g: usize) -> bool {
        4 * g + 4 <= t.len() && vz(t[4 * g]) < 64 && vz(t[4 * g + 1]) < 64 && vz(t[4 * g + 2]) < 64 && vz(t[4 * g + 3]) < 64
    }

    spec fn appended(v: &[u8], w: &[u8], t: &[u8], g: usize, c: usize) -> bool {
        v.len() == w.len() + c && kept(v, w) && (c < 1 || v[w.len()] == dec_byte(t, 3 * g)) && (c < 2 || v[w.len() + 1] == dec_byte(t, 3 * g + 1)) && (c < 3 || v[w.len() + 2] == dec_byte(t, 3 * g + 2))
    }

    spec fn count_ok(c: usize) -> bool { 1 <= c && c <= 3 }

    spec fn room(v: &[u8]) -> bool { v.len() + 3 <= 9223372036854775807 }

    // Appends the first `c` bytes the characters of group `g` encode.
    #[effects(pure)]
    #[uses(digits, appended, kept, count_ok, room, dec_byte, six, is_vz, is_d0, is_d1, is_d2)]
    fn push_bytes(v: &mut Vec<u8>, t: &[u8], g: usize, c: usize) -> ()
        requires digits(t, g), count_ok(c), room(v.as_slice()),
        ensures appended(v.as_slice(), old(v).as_slice(), t, g, c),
    {
        let x0: u8 = value(t[4 * g]);
        let x1: u8 = value(t[4 * g + 1]);
        let x2: u8 = value(t[4 * g + 2]);
        let x3: u8 = value(t[4 * g + 3]);
        v.push(byte0(x0, x1));
        if c >= 2 {
            v.push(byte1(x1, x2));
        }
        if c >= 3 {
            v.push(byte2(x2, x3));
        }
    }

    spec fn dec_prefix(t: &[u8], v: &[u8], n: usize) -> bool {
        v.len() == n && forall|k: usize| k < n ==> dec_byte(t, k) == #[trigger] v[k]
    }

    // The bytes `t` encodes, or `None` when it is not a canonical encoding.
    #[effects(pure)]
    #[uses(decoded, decodes, valid_result, well_formed, pads, sym, val, vz, dec_len, dec_prefix, digits, appended, kept, count_ok, room)]
    fn decode(t: &[u8]) -> (r: Option<Vec<u8>>)
        ensures decoded(t, r),
    {
        if !is_valid(t) {
            return None;
        }
        let m: usize = t.len();
        let groups: usize = m / 4;
        let p: usize = if m >= 1 && t[m - 1] == b'=' {
            if m >= 2 && t[m - 2] == b'=' { 2 } else { 1 }
        } else {
            0
        };
        let mut v: Vec<u8> = Vec::new();
        if groups > 0 {
            let last: usize = groups - 1;
            for g in 0..last
                invariant m == t.len(), groups * 4 == m, well_formed(t), dec_prefix(t, v.as_slice(), 3 * g),
            {
                push_bytes(&mut v, t, g, 3);
            }
            push_bytes(&mut v, t, last, 3 - p);
        }
        Some(v)
    }

    spec fn back(s: &[u8], r: Option<Vec<u8>>) -> bool {
        match r {
            None => false,
            Some(v) => v.len() == s.len() && forall|k: usize| k < s.len() ==> #[trigger] v[k] == s[k],
        }
    }

    // The round trip (RFC 4648 §3): decoding the encoding of `s` gives `s`.
    // Proved from the two contracts alone; it runs both.
    #[effects(pure)]
    #[uses(fits, back, round_trip, decoded, decodes)]
    fn round(s: &[u8]) -> (r: Option<Vec<u8>>)
        requires fits(s),
        ensures back(s, r),
    {
        let t: Vec<u8> = encode(s);
        decode(t.as_slice())
    }
}
