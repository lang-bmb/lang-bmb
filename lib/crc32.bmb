#[summary("CRC-32(T4-04): ISO-HDLC/zlib의 반사 CRC-32(다항식 0xedb88320, 초기값·최종 xor 0xffffffff). 결과는 비트 단위 정의 reg와 같음이 증명된다. Rust crc32fast·Python zlib.crc32와 같은 값")]
mod crc32 {
    // One bit of the register: shift right, and xor the reflected polynomial
    // when the bit shifted out is set.
    spec fn bit(c: u32) -> u32 {
        if c & 1 == 1 { (c >> 1) ^ 0xedb88320 } else { c >> 1 }
    }

    // One byte: xor it into the low bits, then eight bit steps.
    spec fn byte(c: u32, b: u8) -> u32 {
        bit(bit(bit(bit(bit(bit(bit(bit(c ^ b))))))))
    }

    // The register after feeding `s[0..n]` to the register `c`.
    spec fn run(c: u32, s: &[u8], n: usize) -> u32
        decreases n,
    {
        if n == 0 || n > s.len() { c } else { byte(run(c, s, n - 1), s[n - 1]) }
    }

    spec fn bit_result(c: u32, r: u32) -> bool { r == bit(c) }

    spec fn byte_result(c: u32, b: u8, r: u32) -> bool { r == byte(c, b) }

    spec fn ran(c: u32, s: &[u8], n: usize, r: u32) -> bool { n <= s.len() && r == run(c, s, n) }

    // zlib's `crc32(crc, s)`: the checksum `crc` of some bytes continued
    // with `s`. The register holds the complement of the checksum.
    spec fn continued(crc: u32, s: &[u8], r: u32) -> bool { r == !run(!crc, s, s.len()) }

    spec fn checksum_of(s: &[u8], r: u32) -> bool { r == !run(0xffffffff, s, s.len()) }

    // zlib's table: entry `k` is the register after the byte `k` from 0.
    spec fn tabulated(t: &[u32]) -> bool {
        t.len() == 256 && forall|k: usize| k < 256 ==> #[trigger] t[k] == byte(k, 0)
    }

    spec fn filled(t: &[u32], n: usize) -> bool {
        t.len() == 256 && n <= 256 && forall|k: usize| k < n ==> #[trigger] t[k] == byte(k, 0)
    }

    // One byte by the table: the low byte of `c ^ b` picks the entry, and
    // the rest of the register moves down a byte.
    spec fn by_table(c: u32, b: u8) -> bool { byte(c, b) == byte((c ^ b) & 0xff, 0) ^ (c >> 8) }

    #[effects(pure)]
    #[uses(bit_result, bit)]
    fn bit_step(c: u32) -> (r: u32)
        ensures bit_result(c, r),
    {
        if c & 1 == 1 { (c >> 1) ^ 0xedb88320 } else { c >> 1 }
    }

    // The register after one byte, bit by bit (it fills the table).
    #[effects(pure)]
    #[uses(byte_result, byte, bit_result)]
    fn byte_step(c: u32, b: u8) -> (r: u32)
        ensures byte_result(c, b, r),
    {
        let x0: u32 = c ^ u32::try_from(b).unwrap();
        let x1: u32 = bit_step(x0);
        let x2: u32 = bit_step(x1);
        let x3: u32 = bit_step(x2);
        let x4: u32 = bit_step(x3);
        let x5: u32 = bit_step(x4);
        let x6: u32 = bit_step(x5);
        let x7: u32 = bit_step(x6);
        bit_step(x7)
    }

    // The table step is the bitwise one: a fact of the bits of `c` and `b`
    // alone, proved over bit-vectors (backlog 2N-03; the mixed encoding did
    // not decide it within rlimit 5,000,000).
    #[uses(by_table, byte, bit)]
    proof fn table_lemma(c: u32, b: u8)
        ensures by_table(c, b),
    {
        assert(byte(c, b) == byte((c ^ b) & 0xff, 0) ^ (c >> 8)) by (bit_vector);
    }

    // zlib's 256-entry table.
    #[effects(pure)]
    #[uses(tabulated, filled, byte_result)]
    fn table() -> (t: [u32; 256])
        ensures tabulated(&t),
    {
        let mut e: [u32; 256] = [0; 256];
        for k in 0..e.len()
            invariant filled(&e, k),
        {
            e[k] = byte_step(u32::try_from(k).unwrap(), 0);
        }
        e
    }

    // The register after one byte by the table.
    #[effects(pure)]
    #[uses(byte_result, tabulated, by_table)]
    fn table_step(t: &[u32], c: u32, b: u8) -> (r: u32)
        requires tabulated(t),
        ensures byte_result(c, b, r),
    {
        proof {
            table_lemma(c, b);
        }
        t[usize::try_from((c ^ u32::try_from(b).unwrap()) & 0xff).unwrap()] ^ (c >> 8)
    }

    // The checksum `crc` of some bytes, continued with `s`, by the table `t`
    // (from `table()`: one table serves any number of checksums).
    #[effects(pure)]
    #[uses(run, ran, continued, byte_result, tabulated)]
    fn update_with(t: &[u32], crc: u32, s: &[u8]) -> (r: u32)
        requires tabulated(t),
        ensures continued(crc, s, r),
    {
        let mut c: u32 = !crc;
        for i in 0..s.len()
            invariant ran(!crc, s, i, c),
        {
            c = table_step(t, c, s[i]);
        }
        !c
    }

    // The checksum `crc` of some bytes, continued with `s` (zlib
    // `crc32(crc, s)`; `update(0, s)` is the checksum of `s`).
    #[effects(pure)]
    #[uses(continued, tabulated)]
    fn update(crc: u32, s: &[u8]) -> (r: u32)
        ensures continued(crc, s, r),
    {
        let t: [u32; 256] = table();
        update_with(&t, crc, s)
    }

    // The CRC-32 of `s` (`"123456789"` gives `0xcbf43926`).
    #[effects(pure)]
    #[uses(checksum_of, continued)]
    fn checksum(s: &[u8]) -> (r: u32)
        ensures checksum_of(s, r),
    {
        update(0, s)
    }
}
