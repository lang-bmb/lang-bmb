#[summary("&mut parameters in ensures")]
mod m {
    #[effects(pure)]
    fn bump(x: &mut i64) -> ()
        requires *x < 100,
        ensures *x == *old(x) + 1,
    {
        *x = *x + 1;
    }

    #[effects(pure)]
    fn stale(x: &mut i64) -> ()
        requires *x < 100,
        ensures *x == *old(x),
    {
        *x = *x + 1;
    }
}
