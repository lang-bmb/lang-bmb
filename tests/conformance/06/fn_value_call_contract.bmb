#[summary("function value contracts")]
mod m {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    fn unchecked<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
        f(x)
    }
}
