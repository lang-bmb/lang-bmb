#[summary("uses entries")]
mod m {
    spec fn pos(x: i64) -> bool { x > 0 }

    #[effects(pure)]
    fn helper(x: i64) -> i64 { x }

    #[effects(pure)]
    #[uses(helper)]
    fn names_code() -> () {}

    #[effects(pure)]
    #[uses(missing)]
    fn names_nothing() -> () {}

    #[effects(pure)]
    #[uses(pos)]
    fn names_spec() -> () {}
}
