#[summary("function items as values")]
mod m {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    fn inc(x: i64) -> (r: i64)
        requires x < 1000,
        ensures r == x + 1,
    {
        x + 1
    }

    #[effects(pure)]
    fn good() -> i64 {
        let a: i64 = apply::<_>(inc, 10);
        assert(a == 11);
        a
    }

    #[effects(pure)]
    fn bad() -> i64 {
        apply::<_>(inc, 5000)
    }
}
