#[summary("invariant attributes")]
mod m {
    #[invariant(missing)]
    struct A { x: i64 }

    #[invariant(by_value)]
    struct C { x: i64 }

    spec fn by_value(c: C) -> bool { c.x > 0 }

    #[invariant(number)]
    struct F { x: i64 }

    spec fn number(f: &F) -> i64 { f.x }

    #[invariant(nothing)]
    struct G { x: i64 }

    spec fn nothing(g: &G) -> bool { true }

    #[invariant(low)]
    #[invariant(high)]
    struct H { x: i64 }

    spec fn low(h: &H) -> bool { h.x > 0 }

    spec fn high(h: &H) -> bool { h.x < 9 }

    #[invariant(pos)]
    struct Good { x: i64 }

    spec fn pos(k: &Good) -> bool { k.x > 0 }
}
