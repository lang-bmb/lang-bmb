#[summary("closure contracts")]
mod m {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    fn good() -> i64 {
        let d: i64 = apply::<_>(|x: i64| -> (y: i64) requires x < 100 && x > -100, ensures y == x + x, { x + x }, 21);
        assert(d == 42);
        d
    }

    #[effects(pure)]
    fn bad() -> i64 {
        apply::<_>(|x: i64| -> (y: i64) requires x < 100 && x > -100, ensures y == x + x, { x + x }, 500)
    }
}
