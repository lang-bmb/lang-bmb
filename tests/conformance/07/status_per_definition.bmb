#[summary("one status per definition")]
mod m {
    #[effects(pure)]
    fn none(x: i64) -> i64 { x }

    #[effects(pure)]
    fn proved(x: u8) -> u64 {
        let y: u64 = x as u64;
        y + 1
    }

    #[effects(pure)]
    fn broken(x: u64) -> u64 {
        x + 1
    }

    #[effects(pure)]
    fn after(x: u64) -> u64
        requires x < 10,
    {
        x + 1
    }
}
