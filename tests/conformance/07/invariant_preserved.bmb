#[summary("E0807")]
mod m {
    #[effects(pure)]
    fn bad(n: u64) -> u64
        requires n < 1000,
    {
        let mut i: u64 = 0;
        while i < n
            invariant i <= 5,
            decreases n - i,
        {
            i = i + 1;
        }
        i
    }

    #[effects(pure)]
    fn bad_continue(n: u64) -> u64
        requires n < 1000,
    {
        let mut i: u64 = 0;
        let mut k: u64 = 0;
        while i < n
            invariant k == 0,
            decreases n - i,
        {
            i = i + 1;
            if i == 3 {
                k = 1;
                continue;
            }
        }
        k
    }

    #[effects(pure)]
    fn good(n: u64) -> u64
        requires n < 1000,
    {
        let mut i: u64 = 0;
        while i < n
            invariant i <= n,
            decreases n - i,
        {
            i = i + 1;
        }
        i
    }
}
