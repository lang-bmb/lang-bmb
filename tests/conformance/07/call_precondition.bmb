#[summary("E0801")]
mod m {
    #[effects(pure)]
    fn needs(x: i64) -> i64
        requires x > 0,
    {
        x
    }

    #[effects(pure)]
    fn good(x: i64) -> i64 {
        if x > 0 { needs(x) } else { needs(1) }
    }

    #[effects(pure)]
    fn bad(x: i64) -> i64 {
        needs(x)
    }
}
