#[summary("E0805: ranges")]
mod m {
    #[effects(pure)]
    fn size(a: &[i64]) -> usize { a.len() }

    #[effects(pure)]
    fn sub(a: &[i64], lo: usize, hi: usize) -> usize {
        size(&a[lo..hi])
    }

    #[effects(pure)]
    fn copy(a: &mut [i64], d: usize) -> () {
        if a.len() > 2 {
            a.copy_within(0..2, d);
        }
    }

    #[effects(pure)]
    fn guarded(a: &mut [i64]) -> usize {
        if a.len() > 4 {
            a.copy_within(0..2, 1);
            size(&a[1..3])
        } else {
            0
        }
    }
}
