#[summary("several faults in one rationale")]
mod m {
    spec fn small(x: i64) -> bool { 0 <= x && x <= 10 }

    #[effects(panic)]
    fn f(x: i64) -> i64 {
        #[rationale(kind = boundary, kind = nonlinear, "one", "two")]
        assume(small(x));
        x
    }

    #[rationale(kind = habit)]
    #[external_body]
    #[effects(panic)]
    fn g() -> i64 { 0 }
}
