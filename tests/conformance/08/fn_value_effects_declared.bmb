#[summary("declared effects of a function value")]
mod m {
    #[effects(io)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(io)]
    fn shout(x: i64) -> i64 {
        print_i64(x);
        x
    }

    #[effects(io)]
    fn main() -> () {
        print_i64(apply::<_>(shout, 1));
        print_i64(apply::<_>(|x: i64| -> i64 { print_i64(x); x }, 2));
    }
}
