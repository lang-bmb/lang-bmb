#[summary("missing effects")]
mod m {
    fn free(x: i64) -> i64 {
        x
    }

    trait Make {
        fn make(self: &Self) -> i64;
    }

    struct A { x: i64 }

    impl A {
        fn get(self: &A) -> i64 {
            self.x
        }
    }

    #[effects(pure)]
    fn ok(x: i64) -> i64 { x }
}
