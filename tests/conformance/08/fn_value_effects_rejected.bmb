#[summary("effects of passed functions")]
mod m {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(io)]
    fn shout(x: i64) -> i64 {
        print_i64(x);
        x
    }

    #[effects(pure)]
    fn quiet(x: i64) -> i64 { x }

    #[effects(io)]
    fn item() -> i64 {
        apply::<_>(shout, 1)
    }

    #[effects(pure)]
    fn fine() -> i64 {
        apply::<_>(quiet, 1)
    }
}
