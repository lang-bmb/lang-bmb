#[summary("reference positions")]
mod m {
    struct Holder { r: &i64 }

    enum Maybe { No, Yes(&i64) }

    #[effects(pure)]
    fn ret(x: &i64) -> &i64 {
        x
    }

    #[effects(pure)]
    fn arg(o: Option<&i64>) -> usize {
        0
    }

    #[effects(pure)]
    fn ok(x: &i64, a: &[i64], s: &str, m: &mut i64) -> i64 {
        *x
    }
}
