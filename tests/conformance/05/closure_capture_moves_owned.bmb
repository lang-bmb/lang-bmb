#[summary("captures are value uses")]
mod m {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(x) }

    #[effects(pure)]
    fn owned(v: Vec<i64>) -> usize {
        let r: i64 = apply::<_>(move |x: i64| -> i64 { if v.len() > 0 { x } else { 0 } }, 1);
        v.len()
    }

    #[effects(pure)]
    fn copied(k: i64) -> i64 {
        let r: i64 = apply::<_>(move |x: i64| -> i64 { x.wrapping_add(k) }, 1);
        r.wrapping_add(k)
    }
}
