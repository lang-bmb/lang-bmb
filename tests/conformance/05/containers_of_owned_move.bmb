#[summary("containers of owned values move")]
mod m {
    struct Buf { data: Vec<i64>, n: i64 }

    enum Msg { Empty, Data(Vec<i64>) }

    #[effects(alloc)]
    fn of_struct() -> i64 {
        let b: Buf = Buf { data: Vec::new(), n: 1 };
        let c: Buf = b;
        b.n
    }

    #[effects(alloc)]
    fn of_enum() -> Msg {
        let e: Msg = Msg::Data(Vec::new());
        let f: Msg = e;
        e
    }

    #[effects(alloc)]
    fn of_option() -> Option<Box<i64>> {
        let o: Option<Box<i64>> = Some(Box::new(1));
        let p: Option<Box<i64>> = o;
        o
    }

    #[effects(alloc)]
    fn of_array() -> usize {
        let a: [Buf; 1] = [Buf { data: Vec::new(), n: 1 }];
        let b: [Buf; 1] = a;
        a[0].data.len()
    }
}
