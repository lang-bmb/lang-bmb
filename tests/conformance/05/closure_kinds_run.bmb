#[summary("closures")]
mod m {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    fn consume<F: FnOnce(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(alloc)]
    fn caps(k: i64) -> i64 {
        let v: Vec<i64> = Vec::new();
        let a: i64 = apply::<_>(move |x: i64| -> i64 { x.wrapping_add(k) }, 1);
        apply::<_>(move |x: i64| -> i64 { if v.len() > 0 { x } else { a } }, k)
    }

    #[effects(alloc, io)]
    fn main() -> () {
        print_i64(caps(3));
        let w: Vec<i64> = Vec::new();
        print_i64(consume::<_>(move |x: i64| -> i64 { if w.len() > 0 { 0 } else { x } }, 3));
        let k: i64 = 4;
        print_i64(apply::<_>(move |x: i64| -> i64 { x.wrapping_add(k) }, 5));
    }
}
