#[summary("slice arguments")]
mod m {
    #[effects(pure)]
    fn size(a: &[i64]) -> usize { a.len() }

    #[effects(pure)]
    fn pass(a: &[i64]) -> usize { size(a) }

    #[effects(pure)]
    fn pass_mut(a: &mut [i64]) -> usize { size(a) }

    #[effects(pure)]
    fn put(a: &mut [i64]) -> ()
        requires a.len() > 0,
    {
        a[0] = 9;
    }

    #[effects(pure)]
    fn put_again(a: &mut [i64]) -> ()
        requires a.len() > 0,
    {
        put(a);
    }

    #[effects(alloc, io)]
    fn main() -> () {
        let mut arr: [i64; 3] = [1, 2, 3];
        let mut v: Vec<i64> = Vec::new();
        v.push(4);
        print_u64(size(&arr) as u64);
        print_u64(size(v.as_slice()) as u64);
        print_u64(size(&arr[1..3]) as u64);
        print_u64(pass(&arr) as u64);
        print_u64(pass_mut(&mut arr) as u64);
        put(&mut arr);
        print_i64(arr[0]);
        put_again(v.as_mut_slice());
        print_i64(v[0]);
    }
}
