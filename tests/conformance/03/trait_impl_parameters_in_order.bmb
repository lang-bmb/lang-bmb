#[summary("s")]
mod a {
    struct Two<A, B> { a: A, b: B }

    trait Tr {
        #[effects(pure)]
        fn m(self: &Self) -> i64;
    }

    trait Fst {
        #[effects(pure)]
        fn fst(self: &Self) -> i64;
    }

    trait Same {
        #[effects(pure)]
        fn same(self: &Self) -> i64;
    }

    impl<A, B> Tr for Two<B, A> {
        #[effects(pure)]
        fn m(self: &Two<B, A>) -> i64 { 2 }
    }

    impl<T> Fst for Two<T, i64> {
        #[effects(pure)]
        fn fst(self: &Two<T, i64>) -> i64 { self.b }
    }

    impl<T> Same for Two<T, T> {
        #[effects(pure)]
        fn same(self: &Two<T, T>) -> i64 { 3 }
    }
}
