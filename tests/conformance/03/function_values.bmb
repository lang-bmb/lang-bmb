#[summary("s")]
mod a {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64
        requires f.requires(x),
    { f(x) }

    #[effects(pure)]
    fn apply_mut<F: FnMut(i64) -> i64>(f: F, x: i64) -> i64
        requires f.requires(x),
    { f(x) }

    #[effects(pure)]
    fn apply_once<F: FnOnce(i64) -> i64>(f: F, x: i64) -> i64
        requires f.requires(x),
    { f(x) }

    #[effects(pure)]
    fn inc(x: i64) -> i64 { x.wrapping_add(1) }

    #[effects(io)]
    fn main() -> () {
        print_i64(apply::<_>(inc, 10));
        print_i64(apply_mut::<_>(|x: i64| -> i64 { x.wrapping_mul(2) }, 10));
        let k: i64 = 5;
        print_i64(apply_once::<_>(move |x: i64| -> i64 { x.wrapping_add(k) }, 10));
    }
}
