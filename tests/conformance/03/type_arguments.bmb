#[summary("s")]
mod a {
    struct Cell<T> { v: T }

    impl<T> Cell<T> {
        #[effects(pure)]
        fn new(v: T) -> Cell<T> { Cell { v: v } }
    }

    #[effects(pure)]
    fn id<T>(x: T) -> T { x }

    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(x) }

    #[effects(pure)]
    fn same(x: i64) -> i64 { x }

    #[effects(pure)]
    fn ok() -> i64 {
        let c: Cell<u64> = Cell::<u64>::new(1);
        let d: Cell<i64> = Cell { v: 2 };
        let o: Option<i64> = None;
        apply::<_>(same, id::<i64>(d.v))
    }

    #[effects(pure)]
    fn e1() -> i64 { id(1) }

    #[effects(pure)]
    fn e2() -> i64 { let d: Cell<i64> = Cell::<i64> { v: 2 }; d.v }

    #[effects(pure)]
    fn e3() -> i64 {
        match None {
            None => 1,
            Some(v) => 2,
        }
    }
}
