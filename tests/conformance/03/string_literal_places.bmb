#[summary("s")]
mod a {
    #[effects(pure)]
    fn len(t: &str) -> usize { t.len() }

    #[effects(pure)]
    fn ok(t: &str) -> bool { len("abc") == 3 && t == "abc" }

    #[effects(alloc)]
    fn e1() -> usize {
        let t: String = "x";
        t.len()
    }

    #[effects(pure)]
    fn e2() -> usize { "x".len() }
}
