#[summary("s")]
mod a {
    struct P { x: i64 }

    enum E { A, B }

    spec fn same(a: P, b: P) -> bool { a == b }

    #[effects(pure)]
    fn e1(a: P, b: P) -> bool { a == b }

    #[effects(pure)]
    fn e2(a: E, b: E) -> bool { a != b }

    #[effects(pure)]
    fn e3(a: [i64; 2], b: [i64; 2]) -> bool { a == b }

    #[effects(alloc)]
    fn e4(a: Vec<i64>, b: Vec<i64>) -> bool { a == b }
}
