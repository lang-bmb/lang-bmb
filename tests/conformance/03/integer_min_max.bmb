#[summary("s")]
mod a {
    #[effects(io)]
    fn main() -> () {
        print_i64(i8::MIN as i64);
        print_i64(i8::MAX as i64);
        print_u64(u8::MAX as u64);
        print_i64(i16::MIN as i64);
        print_u64(u16::MAX as u64);
        print_i64(i32::MIN as i64);
        print_u64(u32::MAX as u64);
        print_i64(i64::MAX);
        print_i64(i64::MIN);
        print_u64(u64::MAX);
        print_u64(usize::MAX as u64);
        print_i64(isize::MIN as i64);
    }
}
