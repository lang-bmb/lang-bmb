#[summary("s")]
mod a {
    struct P { x: i64 }

    #[effects(pure)]
    fn ok(a: u8, b: i64) -> bool { a as i64 == b }

    #[effects(pure)]
    fn e1(a: u8, b: i64) -> bool { a == b }

    #[effects(pure)]
    fn e2(a: u32, b: i32) -> bool { a < b }

    #[effects(pure)]
    fn e3(a: i16, b: i8) -> i16 { a.wrapping_add(b) }

    #[effects(pure)]
    fn e4(a: u64) -> u64 { -a }

    #[effects(pure)]
    fn e5(a: P, b: P) -> bool { a == b }
}
