#[summary("s")]
mod a {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64
        requires f.requires(x),
    { f(x) }

    #[effects(pure)]
    fn e1() -> i64 { apply::<_>(|x| -> i64 { x }, 1) }

    #[effects(pure)]
    fn e2() -> i64 { apply::<_>(|x: i64| x, 1) }

    #[effects(pure)]
    fn e3() -> i64 {
        let f: i64 = |x: i64| -> i64 { x };
        1
    }
}
