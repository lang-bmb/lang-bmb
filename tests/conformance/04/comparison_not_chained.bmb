#[summary("s")]
mod a {
    #[effects(pure)]
    fn e1(a: i64, b: i64, c: i64) -> bool { a < b < c }

    #[effects(pure)]
    fn e2(a: i64, b: i64) -> bool { a == b == true }

    #[effects(pure)]
    fn e3(a: bool, b: bool) -> bool { a ==> b }

    #[effects(pure)]
    fn ok(a: i64, b: i64, c: i64) -> bool { a < b && b < c }
}
