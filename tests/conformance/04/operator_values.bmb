#[summary("s")]
mod a {
    #[effects(io)]
    fn flag(b: bool) -> () { if b { print_i64(1) } else { print_i64(0) } }

    #[effects(pure)]
    fn shl(x: i64, n: u8) -> i64
        requires n < 8 && 0 <= x && x < 100,
    { x << n }

    #[effects(io)]
    fn main() -> () {
        print_i64(-7 / 2);
        print_i64(-7 % 2);
        print_i64(7 % -2);
        print_i64(!5);
        print_u64(!(250 as u8) as u64);
        flag(!true);
        flag(false < true);
        flag(true <= false);
        flag(true & false | true ^ false);
        flag('a' < 'b');
        flag(1.5 < 2.5);
        print_i64(shl(1, 3));
        print_u64((200 as u8 >> 1) as u64);
        print_i64(-16 >> 2);
    }
}
