#[summary("s")]
mod a {
    #[effects(io)]
    fn num(n: i64) -> (r: i64)
        ensures r == n,
    {
        print_i64(n);
        n
    }

    #[effects(io)]
    fn main() -> () {
        let mut i: i64 = 0;
        while i < 3
            invariant 0 <= i && i <= 3,
            decreases 3 - i,
        {
            i = i + 1;
        }
        print_i64(i);
        for j in 0..3 { print_i64(j); }
        for j in 1..=3 { print_i64(j); }
        for j in num(10)..num(12) { print_i64(j); }
        for j in 5..5 { print_i64(j); }
        let a: u8 = 254;
        for k in a..=255 { print_u64(k as u64); }
        let mut n: i64 = 0;
        let r: i64 = loop
            invariant 0 <= n && n <= 4,
            decreases 4 - n,
        {
            if n == 4 { break n * 10; }
            n = n + 1;
        };
        print_i64(r);
    }
}
