#[summary("s")]
mod a {
    trait T {
        #[effects(pure)]
        fn m(self: &Self) -> i64;

        #[effects(pure)]
        fn d(self: &Self) -> i64 { 7 }
    }

    struct S { x: i64 }

    struct P { x: i64 }

    impl T for S {
        #[effects(pure)]
        fn m(self: &S) -> i64 { self.x }
    }

    impl T for P {
        #[effects(pure)]
        fn m(self: &P) -> i64 { self.x }

        #[effects(pure)]
        fn d(self: &P) -> i64 { 8 }
    }

    #[effects(io)]
    fn main() -> () {
        let s: S = S { x: 1 };
        let p: P = P { x: 2 };
        print_i64(s.m());
        print_i64(s.d());
        print_i64(p.d());
    }
}
