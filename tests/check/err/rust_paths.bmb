#[summary("Rust path prefixes and closures: Rust-habit diagnostics that come with a fix")]
mod outer {
    #[effects(pure)]
    fn g(x: i64) -> i64 { x }

    #[summary("A sub-unit")]
    mod inner {
        #[effects(pure)]
        fn from_super(x: i64) -> i64 { super::g(x) }
    }

    #[effects(pure)]
    fn from_crate(x: i64) -> i64 { crate::outer::g(x) }

    #[effects(pure)]
    fn from_self(x: i64) -> i64 { self::g(x) }

    #[effects(pure)]
    fn closure(x: i64) -> i64 {
        let add = |y: i64| y + 1;
        x
    }
}
