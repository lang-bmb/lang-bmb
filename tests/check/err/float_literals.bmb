#[summary("부동소수 리터럴의 꼴: 점 양쪽의 숫자, 지수 숫자, 접미사, 범위, f32와 as (ADR-0061 §1·§2, backlog T2-03)")]
mod fl {
    #[effects(pure)]
    fn shapes() -> f64 {
        let a: f64 = 1.;
        let b: f64 = .5;
        let c: f64 = 1e5;
        let d: f64 = 2.5E-3;
        let e: f64 = 1.0e;
        let f: f64 = 3.0f64;
        let g: f64 = 1.5x;
        let h: f64 = 1.0e400;
        a + b + c + d + e + f + g + h
    }

    #[effects(pure)]
    fn single(x: f32) -> f64 {
        0.0
    }

    #[effects(pure)]
    fn cast(n: i32) -> f64 {
        n as f64
    }

    #[effects(pure)]
    fn ranges(n: usize) -> usize {
        let mut s: usize = 0;
        for i in 0..n {
            s = s + 1;
        }
        s
    }
}
