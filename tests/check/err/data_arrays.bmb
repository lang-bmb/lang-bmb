#[summary("배열 원소의 경계: `Vec`은 원소가 될 수 없다 (backlog 2B-14, 2V-04b, ADR-0047 제안)")]
mod da {
    struct Bufs { v: [Vec<i64>; 2] }

    #[effects(alloc)]
    fn local() -> usize {
        let w: [Vec<i64>; 2] = [Vec::new(), Vec::new()];
        0
    }

    #[effects(alloc)]
    fn vecs() -> usize {
        let v: Vec<i64> = Vec::new();
        [v][0].len()
    }
}

#[summary("배열 타입을 적는 모든 자리의 원소 규칙: 매개변수, 결과, 타입 인자 (backlog 2V-21)")]
mod dp {
    #[effects(pure)]
    fn param(a: [Vec<i64>; 2], b: [String; 2]) -> usize {
        0
    }

    #[effects(alloc)]
    fn nested(a: Option<[String; 2]>) -> [Vec<i64>; 2] {
        [Vec::new(), Vec::new()]
    }
}

#[summary("배열 값의 원소 규칙은 배열 타입의 원소 규칙과 같다: `String`, `()`, 참조 (backlog 2V-22)")]
mod dl {
    struct P { x: i64 }

    #[effects(alloc)]
    fn text() -> usize {
        let s: String = String::new();
        [s].len()
    }

    #[effects(alloc)]
    fn repeat() -> usize {
        let s: String = String::new();
        [s; 2].len()
    }

    #[effects(alloc)]
    fn inner() -> usize {
        let s: String = String::new();
        [[s]].len()
    }

    #[effects(pure)]
    fn unit() -> usize {
        [()].len()
    }

    #[effects(pure)]
    fn refs(a: &[i64], p: &P) -> usize {
        [a].len() + [p].len()
    }
}
