#[summary("Edges of array elements: a `Vec` cannot be an element (ADR-0047 proposal)")]
mod da {
    struct Bufs { v: [Vec<i64>; 2] }

    #[effects(alloc)]
    fn local() -> usize {
        let w: [Vec<i64>; 2] = [Vec::new(), Vec::new()];
        0
    }

    #[effects(alloc)]
    fn vecs() -> usize {
        let v: Vec<i64> = Vec::new();
        [v][0].len()
    }
}

#[summary("The element rule in every place an array type is written: parameters, results, type arguments")]
mod dp {
    #[effects(pure)]
    fn param(a: [Vec<i64>; 2], b: [String; 2]) -> usize {
        0
    }

    #[effects(alloc)]
    fn nested(a: Option<[String; 2]>) -> [Vec<i64>; 2] {
        [Vec::new(), Vec::new()]
    }
}

#[summary("The element rule of array values is that of array types: `String`, `()`, references")]
mod dl {
    struct P { x: i64 }

    #[effects(alloc)]
    fn text() -> usize {
        let s: String = String::new();
        [s].len()
    }

    #[effects(alloc)]
    fn repeat() -> usize {
        let s: String = String::new();
        [s; 2].len()
    }

    #[effects(alloc)]
    fn inner() -> usize {
        let s: String = String::new();
        [[s]].len()
    }

    #[effects(pure)]
    fn unit() -> usize {
        [()].len()
    }

    #[effects(pure)]
    fn refs(a: &[i64], p: &P) -> usize {
        [a].len() + [p].len()
    }
}
