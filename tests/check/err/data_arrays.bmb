#[summary("배열 원소의 경계: `Vec`은 원소가 될 수 없다 (backlog 2B-14, 2V-04b, ADR-0047 제안)")]
mod da {
    struct Bufs { v: [Vec<i64>; 2] }

    #[effects(alloc)]
    fn local() -> usize {
        let w: [Vec<i64>; 2] = [Vec::new(), Vec::new()];
        0
    }

    #[effects(alloc)]
    fn vecs() -> usize {
        let v: Vec<i64> = Vec::new();
        [v][0].len()
    }
}

#[summary("배열 타입을 적는 모든 자리의 원소 규칙: 매개변수, 결과, 타입 인자 (backlog 2V-21)")]
mod dp {
    #[effects(pure)]
    fn param(a: [Vec<i64>; 2], b: [String; 2]) -> usize {
        0
    }

    #[effects(alloc)]
    fn nested(a: Option<[String; 2]>) -> [Vec<i64>; 2] {
        [Vec::new(), Vec::new()]
    }
}
