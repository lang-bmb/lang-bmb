#[summary("배열 원소의 경계: `Vec`은 원소가 될 수 없다 (backlog 2B-14, 2V-04b, ADR-0047 제안)")]
mod da {
    struct Bufs { v: [Vec<i64>; 2] }

    #[effects(pure)]
    fn local() -> usize {
        let w: [Vec<i64>; 2] = [Vec::new(), Vec::new()];
        0
    }

    #[effects(pure)]
    fn vecs() -> usize {
        let v: Vec<i64> = Vec::new();
        [v][0].len()
    }
}
