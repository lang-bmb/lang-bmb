#[summary("A type parameter as a Vec element: in every instance the type argument must be a Vec element")]
mod ve {
    struct Bag<T: Copy> { items: Vec<T> }

    #[effects(alloc)]
    fn make<T: Copy>(x: T) -> Bag<T> {
        let mut v: Vec<T> = Vec::new();
        v.push(x);
        Bag { items: v }
    }

    #[effects(alloc)]
    fn use_it() -> () {
        let b: Bag<i64> = make::<i64>(3);
        let c: Bag<[i64; 2]> = make::<[i64; 2]>([1, 2]);
    }
}
