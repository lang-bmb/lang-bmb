#[summary("Check errors of function values (ADR-0053): passing a function with an effect the generic function does not declare is E0608, a closure that captures without move E0262, an untyped closure parameter E0263, capture of a local whose type is not written E0262, using a capture after it moved into a closure is E0413, a closure in a place that is not a function pointer type or an Fn bound E0264, impl Fn in argument position E0265, a capture conversion in a closure contract E0513 (the replacement is `k` as written)")]
mod fve {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(io)]
    fn shout(x: i64) -> i64 {
        print_i64(x);
        x
    }

    #[effects(io)]
    fn main() -> () {
        print_i64(apply::<_>(shout, 1));
    }

    #[effects(pure)]
    fn captures(k: i64) -> i64 {
        apply::<_>(|x: i64| -> i64 { x + k }, 1)
    }

    #[effects(pure)]
    fn untyped() -> i64 {
        apply::<_>(|x| -> i64 { x }, 1)
    }

    #[effects(pure)]
    fn loop_var() -> i64 {
        let mut t: i64 = 0;
        for i in 0..2 {
            t = apply::<_>(move |x: i64| -> i64 { if i > 0 { x } else { 0 } }, 1);
        }
        t
    }

    #[effects(alloc)]
    fn moved_away() -> usize {
        let mut v: Vec<i64> = Vec::new();
        v.push(1);
        let r: i64 = apply::<_>(move |x: i64| -> i64 { if v.len() > 0 { x } else { 0 } }, 1);
        v.len()
    }

    #[effects(pure)]
    fn pointer(f: fn(i64) -> i64) -> i64 { 0 }

    #[effects(pure)]
    fn impl_arg(f: impl Fn(i64) -> i64) -> i64 { 0 }

    #[effects(pure)]
    fn id(x: i64) -> i64 { x }

    #[effects(pure)]
    fn not_bounded() -> i64 {
        id(|x: i64| -> i64 { x })
    }

    #[effects(pure)]
    fn spec_cast() -> i64 {
        let k: u64 = 3;
        apply::<_>(move |x: i64| -> (y: i64) requires x < 10 && x > -10 && k < 10, ensures y == x + (k as i64), { x + (k as i64) }, 1)
    }

    #[effects(pure)]
    fn unwritten() -> i64 {
        apply(|x: i64| -> (y: i64) requires x == 1, ensures y == x, { x }, 1)
    }
}
