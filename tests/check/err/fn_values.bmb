#[summary("함수 값의 검사 오류(ADR-0053, backlog 2V-20a): 제네릭 함수가 선언하지 않은 효과의 함수를 넘기면 E0608, move 없이 캡처하는 클로저 E0262, 타입 없는 클로저 매개변수 E0263")]
mod fve {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(io)]
    fn shout(x: i64) -> i64 {
        print_i64(x);
        x
    }

    #[effects(io)]
    fn main() -> () {
        print_i64(apply::<_>(shout, 1));
    }

    #[effects(pure)]
    fn captures(k: i64) -> i64 {
        apply::<_>(|x: i64| -> i64 { x + k }, 1)
    }

    #[effects(pure)]
    fn untyped() -> i64 {
        apply::<_>(|x| -> i64 { x }, 1)
    }
}
