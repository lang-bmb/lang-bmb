#[summary("함수 값의 검사 오류(ADR-0053, backlog 2V-20a): 제네릭 함수가 선언하지 않은 효과의 함수를 넘기면 E0608, move 없이 캡처하는 클로저 E0262, 타입 없는 클로저 매개변수 E0263, 타입이 적히지 않은 지역의 캡처 E0262, 클로저로 옮긴 캡처를 뒤에서 쓰면 E0413, 함수 포인터 타입·Fn 경계 아닌 자리의 클로저 E0264, 인자 위치 impl Fn E0265, 클로저 계약의 캡처 변환 E0513(대체문은 쓴 대로 `k`, 2V-20g)")]
mod fve {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(io)]
    fn shout(x: i64) -> i64 {
        print_i64(x);
        x
    }

    #[effects(io)]
    fn main() -> () {
        print_i64(apply::<_>(shout, 1));
    }

    #[effects(pure)]
    fn captures(k: i64) -> i64 {
        apply::<_>(|x: i64| -> i64 { x + k }, 1)
    }

    #[effects(pure)]
    fn untyped() -> i64 {
        apply::<_>(|x| -> i64 { x }, 1)
    }

    #[effects(pure)]
    fn loop_var() -> i64 {
        let mut t: i64 = 0;
        for i in 0..2 {
            t = apply::<_>(move |x: i64| -> i64 { if i > 0 { x } else { 0 } }, 1);
        }
        t
    }

    #[effects(alloc)]
    fn moved_away() -> usize {
        let mut v: Vec<i64> = Vec::new();
        v.push(1);
        let r: i64 = apply::<_>(move |x: i64| -> i64 { if v.len() > 0 { x } else { 0 } }, 1);
        v.len()
    }

    #[effects(pure)]
    fn pointer(f: fn(i64) -> i64) -> i64 { 0 }

    #[effects(pure)]
    fn impl_arg(f: impl Fn(i64) -> i64) -> i64 { 0 }

    #[effects(pure)]
    fn id(x: i64) -> i64 { x }

    #[effects(pure)]
    fn not_bounded() -> i64 {
        id(|x: i64| -> i64 { x })
    }

    #[effects(pure)]
    fn spec_cast() -> i64 {
        let k: u64 = 3;
        apply::<_>(move |x: i64| -> (y: i64) requires x < 10 && x > -10 && k < 10, ensures y == x + (k as i64), { x + (k as i64) }, 1)
    }
}
