#[summary("Places of attributes and type arguments: a duplicate unit summary, attributes before an impl block, reference arguments of the built-in Option and Result, a rationale on a function without an escape hatch")]
#[summary("extra")]
mod attr_places {
    struct P {
        x: i64,
    }

    #[bogus]
    impl P {
        #[effects(pure)]
        fn get(self: &P) -> i64 {
            self.x
        }
    }

    /// A doc line.
    impl P {
        #[effects(pure)]
        fn twice(self: &P) -> i64
            requires self.x < 1000 && self.x > -1000,
        {
            self.x + self.x
        }
    }

    #[effects(pure)]
    fn first(o: Option<&P>) -> i64 {
        0
    }

    #[effects(pure)]
    fn text(r: Result<&str, i64>) -> i64 {
        0
    }

    #[rationale(kind = boundary, "nothing")]
    #[effects(pure)]
    fn lone() -> i64 {
        0
    }
}
