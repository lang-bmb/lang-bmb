#[summary("Errors of definition summaries (ADR-0117): one string, once, only before a definition")]
mod sm {
    #[summary(one, two)]
    const A: i64 = 1;

    #[summary("a")]
    #[summary("b")]
    struct S { x: i64 }

    #[effects(pure)]
    fn f(x: i64) -> i64 {
        /// not before a definition
        x
    }

    //// four slashes stay a comment
    #[other("z")]
    const B: i64 = 2;
}
