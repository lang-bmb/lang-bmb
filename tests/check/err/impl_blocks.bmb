#[summary("One inherent impl block per list of bounds (ADR-0097): two blocks with the same bounds E0308, the same name across blocks E0302, an instance that does not satisfy the block's bounds E0428")]
mod ibe {
    struct Cell<T> { v: Vec<T> }

    impl<T> Cell<T> {
        #[effects(pure)]
        fn size(self: &Cell<T>) -> usize { self.v.len() }
    }

    impl<T> Cell<T> {
        #[effects(pure)]
        fn other(self: &Cell<T>) -> usize { 0 }
    }

    impl<T: Copy> Cell<T> {
        #[effects(pure)]
        fn size(self: &Cell<T>) -> usize { 1 }

        #[effects(pure)]
        fn first(self: &Cell<T>) -> Option<T> {
            if self.v.len() > 0 { Some(self.v[0]) } else { None }
        }
    }

    #[effects(pure)]
    fn moved(c: &Cell<Box<u8>>) -> Option<Box<u8>> {
        c.first()
    }
}
