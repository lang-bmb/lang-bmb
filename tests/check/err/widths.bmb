#[summary("Edges of integer widths: negating an unsigned number, out-of-range literals, mixed widths, 128 bits")]
mod wc {
    #[effects(pure)]
    fn negate(x: u32) -> u32 {
        -x
    }

    #[effects(pure)]
    fn literal() -> i8 {
        200
    }

    #[effects(pure)]
    fn mixed(a: i16, b: i32) -> i32 {
        a + b
    }

    #[effects(pure)]
    fn wide(x: i128) -> i128 {
        x
    }

    #[effects(pure)]
    fn negative() -> u16 {
        -1
    }
}
