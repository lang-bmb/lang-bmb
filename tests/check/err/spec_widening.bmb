#[summary("What is not integer widening in specs (ADR-0099): narrowing and arms whose ranges do not overlap are E0401, a narrowing conversion is E0513")]
mod swe {
    spec fn small(x: u64) -> u8 { x }

    spec fn cut(x: u64) -> u8 { x as u8 }

    spec fn mixed(c: bool, a: i64, b: u64) -> u64 { if c { a } else { b } }
}
