#[summary("내장 이름과 튜플 타입(백로그 5A-03): 타입·trait·상수는 내장 이름과 기본 타입 이름을 쓰지 못하고, 튜플 타입은 튜플 값과 같은 진단을 받는다")]
mod t {
    const Box: i64 = 1;

    trait Option {
        #[effects(pure)]
        fn f(self: &Self) -> i64;
    }

    struct i64 { v: u8 }

    enum bool { A }

    #[effects(pure)]
    fn tup(a: (u8, u8)) -> u8 { 0 }

    #[effects(pure)]
    fn conv(x: u8) -> u32 { u32::from(x) }
}
