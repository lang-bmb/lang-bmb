#[summary("Built-in names and tuple types: types, traits and constants cannot use built-in names or primitive type names, and a tuple type gets the same diagnostic as a tuple value")]
mod t {
    const Box: i64 = 1;

    trait Option {
        #[effects(pure)]
        fn f(self: &Self) -> i64;
    }

    struct i64 { v: u8 }

    enum bool { A }

    #[effects(pure)]
    fn tup(a: (u8, u8)) -> u8 { 0 }

    #[effects(pure)]
    fn conv(x: u8) -> u32 { u32::from(x) }
}
