#[summary("Edges of range for: iterators, decreases, assigning the variable, a non-integer range, the variable outside the loop, specs")]
mod rc {
    #[effects(pure)]
    fn iterator(v: &[i64]) -> i64 {
        let mut s: i64 = 0;
        for x in v.iter() {
            s = s + x;
        }
        s
    }

    #[effects(pure)]
    fn measure(n: u64) -> () {
        for i in 0..n
            decreases n - i,
        {
        }
    }

    #[effects(pure)]
    fn assigns(n: u64) -> () {
        for i in 0..n {
            i = i + 1;
        }
    }

    #[effects(pure)]
    fn bools(b: bool) -> () {
        for i in false..b {
        }
    }

    #[effects(pure)]
    fn mixed(n: u64, m: i64) -> () {
        for i in n..m {
        }
    }

    #[effects(pure)]
    fn after(n: u64) -> u64 {
        for i in 0..n {
        }
        i
    }

    #[effects(pure)]
    fn unknown_label(n: u64) -> () {
        'a: for i in 0..n {
            continue 'b;
        }
    }

    spec fn in_spec(n: u64) -> bool {
        for i in 0..n {
        }
        true
    }
}
