#[summary("Edges of nested Vecs and move elements (ADR-0047)")]
mod ne {
    // Recursion through a `Vec` is fine.
    struct Node { v: i64, kids: Vec<Node> }

    enum Tree { Leaf(i64), Many(Vec<Tree>) }

    #[effects(pure)]
    fn take(v: Vec<i64>) -> usize { v.len() }

    // An element cannot be moved out.
    #[effects(pure)]
    fn out_of(g: Vec<Vec<i64>>) -> usize {
        take(g[0])
    }

    // The elements' type may own memory and is not known here (ADR-0141 §2).
    #[effects(alloc)]
    fn copy<T>(g: &Vec<T>) -> usize {
        let h: Vec<T> = g.clone();
        h.len()
    }

    // Writing an element needs a mutable place.
    #[effects(alloc)]
    fn immutable(g: Vec<Vec<i64>>) -> usize {
        g[0].push(1);
        g.len()
    }
}
