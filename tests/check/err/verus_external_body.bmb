// The Verus spelling of `#[external_body]` is read as BMB's (E0216), so the
// faults of the definition under it come in the same round: the missing
// rationale (E1001) and the effect it needs (E0606). They are the
// program's after the spelling is fixed, not a cascade (2V-23).
#[summary("t")]
mod t {
    #[effects(pure)]
    #[verifier::external_body]
    fn f(x: i64) -> i64 {
        x
    }
}
