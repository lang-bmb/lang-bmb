#[summary("정렬된 배열에서 값 찾기")]
mod search {
    spec fn is_sorted(a: &[i64]) -> bool {
        forall|i: usize, j: usize| i < j && j < a.len() ==> #[trigger] a[i] <= #[trigger] a[j]
    }

    spec fn in_bounds(a: &[i64], r: usize) -> bool {
        r <= a.len()
    }

    spec fn found_or_end(a: &[i64], target: i64, r: usize) -> bool {
        r == a.len() || a[r] == target
    }

    spec fn absent_before(a: &[i64], target: i64, k: usize) -> bool {
        forall|i: usize| i < k ==> #[trigger] a[i] != target
    }

    #[effects(pure)]
    #[uses(in_bounds, found_or_end, absent_before)]
    fn index_of(a: &[i64], target: i64) -> (r: usize)
        requires is_sorted(a),
        ensures in_bounds(a, r), found_or_end(a, target, r),
    {
        let mut k: usize = 0;
        while k < a.len() && a[k] != target
            invariant k <= a.len(), absent_before(a, target, k),
            decreases a.len() - k,
        {
            k = k + 1;
        }
        k
    }
}

#[summary("수열 계산")]
mod series {
    spec fn bounded(n: u64) -> bool {
        n <= 1000
    }

    spec fn tri_spec(n: u64) -> u64
        decreases n,
    {
        if n == 0 { 0 } else { n + tri_spec(n - 1) }
    }

    spec fn is_tri(n: u64, r: u64) -> bool {
        r == tri_spec(n)
    }

    spec fn tri_bound(n: u64, r: u64) -> bool {
        r <= 1000 * n
    }

    #[effects(pure)]
    #[uses(bounded, is_tri, tri_spec, tri_bound)]
    fn tri(n: u64) -> (r: u64)
        requires bounded(n),
        ensures is_tri(n, r), tri_bound(n, r),
        decreases n,
    {
        if n == 0 { 0 } else { n + tri(n - 1) }
    }

    spec fn all_zero_from(a: &[i64], k: usize) -> bool {
        forall|i: usize| k <= i && i < a.len() ==> #[trigger] a[i] == 0
    }

    spec fn zero_below(a: &[i64], k: usize) -> bool {
        forall|i: usize| i < k ==> #[trigger] a[i] == 0
    }

    spec fn same_len(a: &[i64], b: &[i64]) -> bool {
        a.len() == b.len()
    }

    #[effects(pure)]
    #[uses(all_zero_from, same_len, zero_below)]
    fn clear(a: &mut [i64]) -> ()
        ensures all_zero_from(a, 0), same_len(a, old(a)),
    {
        let mut i: usize = 0;
        while i < a.len()
            invariant i <= a.len(), zero_below(a, i),
            decreases a.len() - i,
        {
            a[i] = 0;
            i = i + 1;
        }
    }
}

#[summary("진입점")]
mod app {
    #[effects(io)]
    #[uses(search::is_sorted, series::bounded)]
    fn main() -> () {
        let mut data: [i64; 4] = [1, 3, 5, 7];
        let r: usize = search::index_of(&data, 5);
        let t: u64 = series::tri(10);
        print_i64(-1);
        series::clear(&mut data);
    }
}

#[summary("별칭 검사: 다른 변수만 쓰는 블록 인자는 허용")]
mod alias_ok {
    #[effects(pure)]
    fn put(a: &mut [i64], v: i64) -> () {}

    #[effects(pure)]
    fn caller(c: bool) -> () {
        let mut x: [i64; 2] = [0, 0];
        let y: [i64; 2] = [1, 2];
        put(&mut x, if c { y[0] } else { y[1] });
        put(&mut x, { let t: i64 = y[1]; t });
    }
}
