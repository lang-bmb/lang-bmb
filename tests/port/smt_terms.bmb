#[summary("Differential test: calls the term builders of the port's proof encoder (selfhost/encode_terms.bmb) over a fixed grid of arguments written out here and prints one JSONL row per call (the builder, its arguments, its result). The reference is smt_terms_ref.rs, which does the same job with stage0's builders over the same grid")]
mod app {
    #[summary("Every operation, in declaration order")]
    #[effects(alloc)]
    fn all_ops() -> Vec<ast::BinOp> {
        let mut v: Vec<ast::BinOp> = Vec::new();
        v.push(ast::BinOp::Add);
        v.push(ast::BinOp::Sub);
        v.push(ast::BinOp::Mul);
        v.push(ast::BinOp::Div);
        v.push(ast::BinOp::Rem);
        v.push(ast::BinOp::Eq);
        v.push(ast::BinOp::Ne);
        v.push(ast::BinOp::Lt);
        v.push(ast::BinOp::Le);
        v.push(ast::BinOp::Gt);
        v.push(ast::BinOp::Ge);
        v.push(ast::BinOp::And);
        v.push(ast::BinOp::Or);
        v.push(ast::BinOp::Implies);
        v.push(ast::BinOp::BitAnd);
        v.push(ast::BinOp::BitOr);
        v.push(ast::BinOp::BitXor);
        v.push(ast::BinOp::Shl);
        v.push(ast::BinOp::Shr);
        v
    }

    #[summary("JSON of a truth value")]
    #[effects(alloc)]
    fn bool_text(b: bool) -> String {
        if b {
            return String::from("true");
        }
        String::from("false")
    }

    #[summary("The rows (rows of smt_terms_ref.rs): the term builders that need no encoder state, each over a fixed grid of arguments, as JSONL (the builder, its arguments, its result). The grid is written out here as it is in the reference: the numeral and text readers over grid_nums and grid_texts; the integer builders at every integer type; the bit operations over grid_pairs and the bit methods over grid_amounts; the f64 builders; the lemma templates; the builders of text; the value builders over shapes; and the builders that read the tables at each parameter type of the program of source, which ck is the checked form of")]
    #[effects(alloc)]
    fn dump(ck: &body::Checked) -> String {
        let mut out: String = String::new();
        dump_readers(&mut out);
        dump_ints(&mut out);
        dump_f64(&mut out);
        dump_lemmas(&mut out);
        let xs: Vec<encode_terms::Val> = shapes("x");
        let ys: Vec<encode_terms::Val> = shapes("y");
        dump_vals(&mut out, xs.as_slice(), ys.as_slice());
        let pr: encode_decls::Prepared = encode_decls::prepared(ck);
        let tys: Vec<ast::TypeKind> = match pr.t.fns.find("g::sig") {
            None => Vec::new(),
            Some(at) => pr.t.fns.items[at].params.clone(),
        };
        for i in 0..tys.len()
            invariant 0 <= i && i <= tys.len(),
        {
            dump_type(&mut out, &tys[i], &pr.t);
        }
        dump_places(&mut out, xs.as_slice(), ys.as_slice(), tys.as_slice(), &pr.t);
        dump_sub(&mut out, ck);
        out
    }

    #[summary("The rows of the f64 builders")]
    #[effects(alloc)]
    fn dump_f64(out: &mut String) -> () {
        let funs: Vec<encode_terms::F64Fun> = encode_terms::f64_funs();
        let mut all: Vec<String> = Vec::new();
        for i in 0..funs.len()
            invariant 0 <= i && i <= funs.len(),
        {
            all.push(types::cat3("(", funs[i].name.as_str(), " a)"));
        }
        let mut uses: Vec<String> = encode_terms::split("(+ a b)\n(f64.add a b)\n(f64.lt (f64.neg a) (f64.from 1))\n(f64.is_finite a)\n(f64.is_nan a) (f64.is_finite a)\n(f64.addx a) f64.sub (f64.)", b'\n');
        uses.push(encode_terms::join(all.as_slice(), " "));
        for u in 0..uses.len()
            invariant 0 <= u && u <= uses.len(),
        {
            row(out, "f64_decls", types::cat2("false ", uses[u].as_str()).as_str(), quoted(encode_terms::f64_decls(uses[u].as_str(), false).as_str()).as_str());
            row(out, "f64_decls", types::cat2("true ", uses[u].as_str()).as_str(), quoted(encode_terms::f64_decls(uses[u].as_str(), true).as_str()).as_str());
        }
        let bits: Vec<u64> = grid_f64();
        for b in 0..bits.len()
            invariant 0 <= b && b <= bits.len(),
        {
            row(out, "f64_lit", encode_terms::dec(bits[b]).as_str(), quoted(encode_terms::f64_lit(bits[b]).as_str()).as_str());
        }
        let ops: Vec<ast::BinOp> = all_ops();
        for o in 0..ops.len()
            invariant 0 <= o && o <= ops.len(),
        {
            row(out, "f64_binary", op_name(ops[o]).as_str(), opt_text(&encode_terms::f64_binary(ops[o], "a", "b")).as_str());
        }
        row(out, "f64_method", "sqrt", quoted(encode_terms::f64_method("sqrt", "a", &None).as_str()).as_str());
        row(out, "f64_method", "min", quoted(encode_terms::f64_method("min", "a", &Some(String::from("b"))).as_str()).as_str());
        row(out, "F64_EXACT", "", quoted(encode_terms::f64_exact().as_str()).as_str());
        row(out, "bool_bit", "BitAnd", quoted(encode_terms::bool_bit(ast::BinOp::BitAnd, "a", "b").as_str()).as_str());
        row(out, "bool_bit", "BitOr", quoted(encode_terms::bool_bit(ast::BinOp::BitOr, "a", "b").as_str()).as_str());
        row(out, "bool_bit", "BitXor", quoted(encode_terms::bool_bit(ast::BinOp::BitXor, "a", "b").as_str()).as_str());
    }

    #[summary("The rows of the integer builders at one integer type")]
    #[effects(alloc)]
    fn dump_int(out: &mut String, i: ast::IntTy) -> () {
        let name: String = body::int_text(i);
        let xs: Vec<String> = encode_terms::split("x\n(- 5)", b'\n');
        for x in 0..xs.len()
            invariant 0 <= x && x <= xs.len(),
        {
            let args: String = types::cat3(name.as_str(), " ", xs[x].as_str());
            row(out, "range_int", args.as_str(), quoted(encode_terms::range_int(i, xs[x].as_str()).as_str()).as_str());
            row(out, "wrap_int", args.as_str(), quoted(encode_terms::wrap_int(i, xs[x].as_str()).as_str()).as_str());
            row(out, "to_bv", args.as_str(), quoted(encode_terms::to_bv(i, xs[x].as_str()).as_str()).as_str());
            row(out, "from_bv", args.as_str(), quoted(encode_terms::from_bv(i, xs[x].as_str()).as_str()).as_str());
            row(out, "not_term", args.as_str(), quoted(encode_terms::not_term(i, xs[x].as_str()).as_str()).as_str());
            row(out, "bv_value", args.as_str(), quoted(encode_terms::bv_value(i, xs[x].as_str()).as_str()).as_str());
        }
        let ops: Vec<ast::BinOp> = all_ops();
        let pairs: Vec<String> = encode_terms::split(grid_pairs().as_str(), b'\n');
        for o in 0..ops.len()
            invariant 0 <= o && o <= ops.len(),
        {
            if encode_terms::bit_kind(ops[o]) == 0 {
                continue;
            }
            let on: String = types::cat3(op_name(ops[o]).as_str(), " ", name.as_str());
            for p in 0..pairs.len()
                invariant 0 <= p && p <= pairs.len(),
            {
                let ab: Vec<String> = encode_terms::split(pairs[p].as_str(), b';');
                if ab.len() == 2 {
                    let r: encode_terms::Term = encode_terms::bit_op(ops[o], i, ab[0].as_str(), ab[1].as_str());
                    row(out, "bit_op", types::cat5(on.as_str(), " ", ab[0].as_str(), " ", ab[1].as_str()).as_str(), term_text(&r).as_str());
                }
            }
            row(out, "bv_term", on.as_str(), quoted(encode_terms::bv_term(ops[o], i, "xa", "xb").as_str()).as_str());
            row(out, "bit_facts", on.as_str(), list_text(encode_terms::bit_facts(ops[o], i, "a", "b", "r").as_slice()).as_str());
        }
        for l in 0..ops.len()
            invariant 0 <= l && l <= ops.len(),
        {
            row(out, "linear_bit", types::cat3(op_name(ops[l]).as_str(), " ", name.as_str()).as_str(), opt_text(&encode_terms::linear_bit(ops[l], i, "a", "3")).as_str());
        }
        let methods: Vec<String> = encode_terms::split("wrapping_shl\nwrapping_shr\nrotate_left\nrotate_right\nswap_bytes\ncount_ones\ncount_zeros\nleading_zeros\ntrailing_zeros\nleading_ones\ntrailing_ones\nreverse_bits", b'\n');
        let amounts: Vec<String> = encode_terms::split(grid_amounts().as_str(), b'\n');
        for m in 0..methods.len()
            invariant 0 <= m && m <= methods.len(),
        {
            let mn: String = types::cat4(methods[m].as_str(), " ", name.as_str(), " ");
            if m < 4 {
                for n in 0..amounts.len()
                    invariant 0 <= n && n <= amounts.len(),
                {
                    let r: encode_terms::Term = encode_terms::bit_method(methods[m].as_str(), i, "a", &Some(amounts[n].clone()));
                    row(out, "bit_method", types::cat2(mn.as_str(), amounts[n].as_str()).as_str(), term_text(&r).as_str());
                }
            } else {
                let r: encode_terms::Term = encode_terms::bit_method(methods[m].as_str(), i, "a", &None);
                row(out, "bit_method", types::cat2(mn.as_str(), "-").as_str(), term_text(&r).as_str());
            }
        }
        let bytes: u32 = encode_terms::width(i) / 8;
        for e in 0..2
            invariant 0 <= e && e <= 2,
        {
            let le: bool = e == 1;
            let nl: String = if le {
                types::cat2(name.as_str(), " true")
            } else {
                types::cat2(name.as_str(), " false")
            };
            let mut bs: Vec<String> = Vec::new();
            for k in 0..bytes
                invariant 0 <= k && k <= bytes,
            {
                row(out, "byte_term", types::cat3(nl.as_str(), " ", encode_terms::dec(k as u64).as_str()).as_str(), quoted(encode_terms::byte_term(i, le, "a", k).as_str()).as_str());
                bs.push(types::cat2("b", encode_terms::dec(k as u64).as_str()));
            }
            row(out, "from_bytes_term", nl.as_str(), quoted(encode_terms::from_bytes_term(i, le, bs.as_slice()).as_str()).as_str());
            let bv: encode_terms::Val = encode_terms::bytes_val(i, le, "a");
            row(out, "bytes_val", nl.as_str(), val_text(&bv, 100000).as_str());
            row(out, "from_bytes_val", nl.as_str(), val_text(&encode_terms::from_bytes_val(i, le, &bv), 100000).as_str());
        }
        let kinds: Vec<String> = encode_terms::split("wrapping\nsaturating\nchecked", b'\n');
        let bases: Vec<String> = encode_terms::split("add\nsub\nmul\ndiv\nrem", b'\n');
        for kd in 0..kinds.len()
            invariant 0 <= kd && kd <= kinds.len(),
        {
            for bn in 0..bases.len()
                invariant 0 <= bn && bn <= bases.len(),
            {
                let op: String = types::cat3(kinds[kd].as_str(), "_", bases[bn].as_str());
                let im: encode_terms::IntMethod = encode_terms::int_method(op.as_str(), i, "a", "b");
                let value: String = if im.checked {
                    types::cat7("{\"ok\":", quoted(im.ok.as_str()).as_str(), ",\"v\":", quoted(im.v.as_str()).as_str(), ",\"lemmas\":", list_text(im.lemmas.as_slice()).as_str(), "}")
                } else {
                    types::cat3("{\"value\":", quoted(im.v.as_str()).as_str(), "}")
                };
                row(out, "int_method", types::cat3(op.as_str(), " ", name.as_str()).as_str(), value.as_str());
            }
        }
    }

    #[summary("The rows of the integer builders at every integer type")]
    #[effects(alloc)]
    fn dump_ints(out: &mut String) -> () {
        dump_int(out, ast::IntTy::I8);
        dump_int(out, ast::IntTy::I16);
        dump_int(out, ast::IntTy::I32);
        dump_int(out, ast::IntTy::I64);
        dump_int(out, ast::IntTy::Isize);
        dump_int(out, ast::IntTy::U8);
        dump_int(out, ast::IntTy::U16);
        dump_int(out, ast::IntTy::U32);
        dump_int(out, ast::IntTy::U64);
        dump_int(out, ast::IntTy::Usize);
    }

    #[summary("The rows of the lemma templates, the prelude, byte strings and the builders of text. The placeholders are replaced one after another: a replacement that holds a later placeholder is read again")]
    #[effects(alloc)]
    fn dump_lemmas(out: &mut String) -> () {
        let sl: Vec<String> = encode_terms::signed_div_lemmas();
        for k in 0..sl.len()
            invariant 0 <= k && k <= sl.len(),
        {
            row(out, "instantiate", types::cat2("signed ", encode_terms::dec(k as u64).as_str()).as_str(), quoted(encode_terms::instantiate(sl[k].as_str(), "x", "(- y)", "(bmb_tdiv x (- y))", "{a}{q}").as_str()).as_str());
        }
        let ul: Vec<String> = encode_terms::unsigned_div_lemmas();
        for k in 0..ul.len()
            invariant 0 <= k && k <= ul.len(),
        {
            row(out, "instantiate", types::cat2("unsigned ", encode_terms::dec(k as u64).as_str()).as_str(), quoted(encode_terms::instantiate(ul[k].as_str(), "x", "(- y)", "(bmb_tdiv x (- y))", "{a}{q}").as_str()).as_str());
        }
        row(out, "instantiate", "nested", quoted(encode_terms::instantiate("{a} {b} {q} {r} {a}", "{b}", "{q}", "{r}", "{a}").as_str()).as_str());
        let mut ml: Vec<String> = encode_terms::mul_lemmas();
        ml.push(encode_terms::mul_bound_lemma());
        for k in 0..ml.len()
            invariant 0 <= k && k <= ml.len(),
        {
            row(out, "instantiate_mul", encode_terms::dec(k as u64).as_str(), quoted(encode_terms::instantiate_mul(ml[k].as_str(), "x", "(- y)", "(* x (- y))", "7", "{a}").as_str()).as_str());
        }
        row(out, "PRELUDE", "", quoted(encode_terms::prelude().as_str()).as_str());
        let mut bytes: Vec<u8> = Vec::new();
        row(out, "byte_array", "0", quoted(encode_terms::byte_array(bytes.as_slice()).as_str()).as_str());
        bytes.push(0);
        row(out, "byte_array", "1", quoted(encode_terms::byte_array(bytes.as_slice()).as_str()).as_str());
        bytes.truncate(0);
        bytes.push(1);
        bytes.push(2);
        bytes.push(255);
        row(out, "byte_array", "3", quoted(encode_terms::byte_array(bytes.as_slice()).as_str()).as_str());
        row(out, "boundary", "a n i", quoted(encode_terms::boundary("a", "n", "i").as_str()).as_str());
        row(out, "scalar", "c", quoted(encode_terms::scalar("c").as_str()).as_str());
        row(out, "utf8_len", "c", quoted(encode_terms::utf8_len("c").as_str()).as_str());
        row(out, "utf8_at", "a n k", quoted(encode_terms::utf8_at("a", "n", "k").as_str()).as_str());
        row(out, "utf8_before", "a n i", quoted(encode_terms::utf8_before("a", "n", "i").as_str()).as_str());
    }

    #[summary("The rows of assignment to a place (set_at). A step into a recursive struct makes a new value of it: a constant and the facts of its fields. tys are the parameter types of the grid's program: the recursive struct is the sixteenth")]
    #[effects(alloc)]
    fn dump_places(out: &mut String, xs: &[encode_terms::Val], ys: &[encode_terms::Val], tys: &[ast::TypeKind], tb: &lowered::Tables) -> () {
        if xs.len() < 9 || ys.len() < 9 || tys.len() < 16 {
            return;
        }
        let r: ast::TypeKind = tys[15].clone();
        let new: encode_terms::Val = encode_terms::Val::S(String::from("new"));
        let rv: encode_terms::Val = encode_terms::Val::S(String::from("r"));
        let mut fr: encode_terms::Fresh = encode_terms::Fresh { counters: table::new::<u64>(), decls: Vec::new() };
        let mut st: Vec<encode_terms::Step> = Vec::new();
        place(out, 0, &xs[0], st.as_slice(), &new, tb, &mut fr);
        st.push(encode_terms::Step::Field(0));
        place(out, 1, &xs[4], st.as_slice(), &new, tb, &mut fr);
        st.truncate(0);
        st.push(encode_terms::Step::Field(1));
        st.push(encode_terms::Step::Index(String::from("i")));
        place(out, 2, &xs[4], st.as_slice(), &new, tb, &mut fr);
        st.truncate(0);
        st.push(encode_terms::Step::Field(2));
        place(out, 3, &xs[4], st.as_slice(), &ys[2], tb, &mut fr);
        st.truncate(0);
        st.push(encode_terms::Step::Index(String::from("i")));
        place(out, 4, &xs[2], st.as_slice(), &new, tb, &mut fr);
        let mut two: Vec<encode_terms::Val> = Vec::new();
        two.push(encode_terms::Val::S(String::from("n0")));
        two.push(encode_terms::Val::S(String::from("n1")));
        place(out, 5, &xs[5], st.as_slice(), &encode_terms::Val::Struct(two), tb, &mut fr);
        st.push(encode_terms::Step::Field(1));
        place(out, 6, &xs[5], st.as_slice(), &new, tb, &mut fr);
        st.truncate(1);
        st.push(encode_terms::Step::Field(2));
        st.push(encode_terms::Step::Index(String::from("j")));
        place(out, 7, &xs[6], st.as_slice(), &new, tb, &mut fr);
        st.truncate(1);
        st.push(encode_terms::Step::Field(1));
        place(out, 8, &xs[6], st.as_slice(), &ys[1], tb, &mut fr);
        st.truncate(1);
        st.push(encode_terms::Step::Index(String::from("j")));
        st.push(encode_terms::Step::Field(0));
        place(out, 9, &xs[7], st.as_slice(), &new, tb, &mut fr);
        st.truncate(0);
        st.push(encode_terms::Step::Field(1));
        place(out, 10, &xs[8], st.as_slice(), &encode_terms::Val::Unit, tb, &mut fr);
        st.truncate(0);
        st.push(encode_terms::Step::DataField(0, r.clone()));
        place(out, 11, &rv, st.as_slice(), &new, tb, &mut fr);
        st.truncate(0);
        st.push(encode_terms::Step::DataField(1, r.clone()));
        st.push(encode_terms::Step::Index(String::from("i")));
        place(out, 12, &rv, st.as_slice(), &encode_terms::Val::S(String::from("kid")), tb, &mut fr);
        st.push(encode_terms::Step::DataField(0, r.clone()));
        place(out, 13, &rv, st.as_slice(), &new, tb, &mut fr);
        st.truncate(0);
        st.push(encode_terms::Step::Index(String::from("i")));
        st.push(encode_terms::Step::DataField(1, r.clone()));
        place(out, 14, &encode_terms::Val::A(String::from("rs"), String::from("n")), st.as_slice(), &ys[2], tb, &mut fr);
    }

    #[summary("The rows of the numeral and text readers, of the connectives, of substitution and of the upper bounds a path condition states")]
    #[effects(alloc)]
    fn dump_readers(out: &mut String) -> () {
        let nums: Vec<String> = encode_terms::split(grid_nums().as_str(), b'\n');
        for i in 0..nums.len()
            invariant 0 <= i && i <= nums.len(),
        {
            let t: String = nums[i].clone();
            row(out, "is_numeral", t.as_str(), bool_text(encode_terms::is_numeral(t.as_str())).as_str());
            let n: Option<String> = match encode_terms::numeral(t.as_str()) {
                None => None,
                Some(v) => Some(encode_terms::num(&v)),
            };
            row(out, "numeral", t.as_str(), opt_text(&n).as_str());
            row(out, "fixed_len", t.as_str(), bool_text(encode_terms::fixed_len(t.as_str())).as_str());
            row(out, "select_len", t.as_str(), quoted(encode_terms::select_len(t.as_str(), "i").as_str()).as_str());
            row(out, "store_len", t.as_str(), quoted(encode_terms::store_len(t.as_str(), "i", "x").as_str()).as_str());
        }
        let texts: Vec<String> = encode_terms::split(grid_texts().as_str(), b'\n');
        for i in 0..texts.len()
            invariant 0 <= i && i <= texts.len(),
        {
            let t: String = texts[i].clone();
            row(out, "bool_depth", t.as_str(), encode_terms::dec(encode_terms::bool_depth(t.as_str()) as u64).as_str());
            row(out, "implication", t.as_str(), pair_text(&encode_terms::implication(t.as_str())).as_str());
            row(out, "first_term", t.as_str(), opt_text(&encode_terms::first_term(t.as_str())).as_str());
            row(out, "select_app", t.as_str(), pair_text(&encode_terms::select_app(t.as_str())).as_str());
            row(out, "sel_app", t.as_str(), pair_text(&encode_terms::sel_app(t.as_str())).as_str());
            let printed: Option<String> = match encode_terms::parse(t.as_str()) {
                None => None,
                Some(e) => Some(encode_terms::print(&e, 100000)),
            };
            row(out, "parse", t.as_str(), opt_text(&printed).as_str());
            row(out, "text_decls", t.as_str(), quoted(encode_terms::text_decls(t.as_str()).as_str()).as_str());
        }
        let mut counts: Vec<usize> = Vec::new();
        counts.push(0);
        counts.push(1);
        counts.push(2);
        counts.push(5);
        counts.push(texts.len());
        for c in 0..counts.len()
            invariant 0 <= c && c <= counts.len(),
        {
            let mut facts: Vec<String> = Vec::new();
            for i in 0..texts.len()
                invariant 0 <= i && i <= texts.len(),
            {
                if i + counts[c] >= texts.len() {
                    facts.push(texts[i].clone());
                }
            }
            let cn: String = encode_terms::dec(counts[c] as u64);
            row(out, "and", cn.as_str(), quoted(encode_terms::and(facts.as_slice()).as_str()).as_str());
            row(out, "guarded", cn.as_str(), list_text(encode_terms::guarded("c", facts.as_slice()).as_slice()).as_str());
        }
        row(out, "ite", "c a a", quoted(encode_terms::ite("c", "a", "a").as_str()).as_str());
        row(out, "ite", "c a b", quoted(encode_terms::ite("c", "a", "b").as_str()).as_str());
        row(out, "sym", "a b", quoted(encode_decls::sym("a b").as_str()).as_str());
        let mut m: table::Table<encode_terms::Sexp> = table::new::<encode_terms::Sexp>();
        let names: Vec<String> = encode_terms::split("a\nb\n|c d|\nf", b'\n');
        let with: Vec<String> = encode_terms::split("(+ x 1)\na\n7\ng", b'\n');
        for i in 0..names.len()
            invariant 0 <= i && i <= names.len(),
        {
            if i < with.len() {
                match encode_terms::parse(with[i].as_str()) {
                    None => {},
                    Some(e) => m.insert(names[i].as_str(), e),
                }
            }
        }
        for i in 0..texts.len()
            invariant 0 <= i && i <= texts.len(),
        {
            match encode_terms::parse(texts[i].as_str()) {
                None => {},
                Some(e) => row(out, "subst_atoms", texts[i].as_str(), quoted(encode_terms::print(&encode_terms::subst_atoms(&e, &m, 100000), 100000).as_str()).as_str()),
            }
        }
        let mut pcs: Vec<Vec<String>> = Vec::new();
        pcs.push(Vec::new());
        pcs.push(encode_terms::split("(< x 5)\n(<= x n)\n(> 9 x)", b'\n'));
        pcs.push(encode_terms::split("(and (< x a) (and (>= b x) (< y x)))\n(or (< x 1) (< x 2))", b'\n'));
        pcs.push(encode_terms::split("(< x 5)\n(and\n(< x 5)\n(<= (f x) |a b|)", b'\n'));
        pcs.push(encode_terms::split("(< x 1 2)\n(<= x)\nx\n(>= m x)\n(> (+ m 1) x)\n(< x 3)", b'\n'));
        let terms: Vec<String> = encode_terms::split("x\n(f x)\ny", b'\n');
        for k in 0..pcs.len()
            invariant 0 <= k && k <= pcs.len(),
        {
            for j in 0..terms.len()
                invariant 0 <= j && j <= terms.len(),
            {
                row(out, "upper_bounds", types::cat3(encode_terms::dec(k as u64).as_str(), " ", terms[j].as_str()).as_str(), list_text(encode_terms::upper_bounds(pcs[k].as_slice(), terms[j].as_str()).as_slice()).as_str());
            }
        }
    }

    #[summary("The rows of the sub-proof translations (sub_rows of smt_terms_ref.rs): bit_vector, bit_vector_int and bit_vector_sat over grid_sub, the bit helpers' definitions, and the readers of model values (model_int at every integer type, render_value), the text of a sub-proof's counterexample, canonical scripts with their legends, the canonical text of a query and the solver's answers named back. No spec fn unfolds here, as in the reference; the encoder state the translation is handed is unused")]
    #[effects(alloc)]
    fn dump_sub(out: &mut String, ck: &body::Checked) -> () {
        let pg: encode_spec::Prog = encode_spec::prog_of(ck);
        let mut enc: encode_spec::Enc = encode_spec::new_enc(&pg, "g::sig", "g");
        let lines: Vec<String> = encode_terms::split(grid_sub().as_str(), b'\n');
        let none: Vec<String> = Vec::new();
        for i in 0..lines.len()
            invariant 0 <= i && i <= lines.len(),
        {
            let parts: Vec<String> = encode_terms::split(lines[i].as_str(), b';');
            if parts.len() == 2 {
                let specs: Vec<String> = encode_terms::split(parts[0].as_str(), b' ');
                let mut sorts: Vec<encode_sub::Var> = Vec::new();
                let mut consts: Vec<encode_sub::Named> = Vec::new();
                for k in 0..specs.len()
                    invariant 0 <= k && k <= specs.len(),
                {
                    let nv: Vec<String> = encode_terms::split(specs[k].as_str(), b':');
                    if nv.len() == 2 {
                        if nv[1].as_str() == "bool" {
                            sorts.push(encode_sub::Var { sym: nv[0].clone(), sort: encode_sub::Sort::Bool });
                            consts.push(encode_sub::Named { sym: nv[0].clone(), c: encode_sub::Const::Bool });
                        } else if nv[1].as_str() == "f64" {
                            sorts.push(encode_sub::Var { sym: nv[0].clone(), sort: encode_sub::Sort::F64 });
                        } else if encode_terms::starts_at(nv[1].as_str(), 0, "bv") {
                            match encode_sub::parse_u32(lexer::cut(nv[1].as_str(), 2, nv[1].len()).as_str()) {
                                None => {},
                                Some(bw) => consts.push(encode_sub::Named { sym: nv[0].clone(), c: encode_sub::Const::Bv(bw) }),
                            }
                        } else {
                            match int_named(nv[1].as_str()) {
                                None => {},
                                Some(it) => { sorts.push(encode_sub::Var { sym: nv[0].clone(), sort: encode_sub::Sort::Int(it) }); consts.push(encode_sub::Named { sym: nv[0].clone(), c: encode_sub::Const::Int(it) }); },
                            }
                        }
                    }
                }
                match encode_terms::parse(parts[1].as_str()) {
                    None => {},
                    Some(e) => { let bv: String = match encode_sub::bit_vector(&e, sorts.as_slice(), none.as_slice(), &mut enc, &pg) { Ok(b) => { let mut t: String = String::from("{\"logic\":"); t.push_str(quoted(b.logic.as_str()).as_str()); t.push_str(",\"decls\":"); t.push_str(list_text(b.decls.as_slice()).as_str()); t.push_str(",\"hyps\":"); t.push_str(list_text(b.hyps.as_slice()).as_str()); t.push_str(",\"goal\":"); t.push_str(quoted(b.goal.as_str()).as_str()); t.push_str(",\"guards\":"); t.push_str(list_text(b.guards.as_slice()).as_str()); t.push_str("}"); t }, Err(r) => err_text(r.why.as_str()), }; row(out, "bit_vector", lines[i].as_str(), bv.as_str()); let bi: String = match encode_sub::bit_vector_int(&e, sorts.as_slice(), &mut enc, &pg) { Ok(ib) => types::cat5("[", quoted(ib.t.as_str()).as_str(), ",", encode_terms::dec(ib.w).as_str(), "]"), Err(why) => err_text(why.as_str()), }; row(out, "bit_vector_int", lines[i].as_str(), bi.as_str()); let mut one: Vec<encode_terms::Sexp> = Vec::new(); one.push(e.clone()); let bs: String = match encode_sub::bit_vector_sat(one.as_slice(), consts.as_slice(), &mut enc, &pg) { Ok(sq) => types::cat5("{\"script\":", quoted(sq.script.as_str()).as_str(), ",\"exact\":", bool_text(sq.exact).as_str(), "}"), Err(why) => err_text(why.as_str()), }; row(out, "bit_vector_sat", lines[i].as_str(), bs.as_str()); },
                }
            }
        }
        let names: Vec<String> = encode_terms::split(grid_helpers().as_str(), b'\n');
        for i in 0..names.len()
            invariant 0 <= i && i <= names.len(),
        {
            let hv: String = match encode_sub::helper_def(names[i].as_str()) {
                None => String::from("null"),
                Some(h) => types::cat5("[", quoted(h.def.as_str()).as_str(), ",", encode_terms::dec(h.w).as_str(), "]"),
            };
            row(out, "helper_def", names[i].as_str(), hv.as_str());
        }
        let texts: Vec<String> = encode_terms::split(grid_helper_texts().as_str(), b'\n');
        for i in 0..texts.len()
            invariant 0 <= i && i <= texts.len(),
        {
            row(out, "helper_defs", texts[i].as_str(), quoted(encode_sub::helper_defs(texts[i].as_str()).as_str()).as_str());
        }
        let values: Vec<String> = encode_terms::split(grid_values().as_str(), b'\n');
        for i in 0..values.len()
            invariant 0 <= i && i <= values.len(),
        {
            let rv: Option<String> = match encode_terms::parse(values[i].as_str()) {
                None => None,
                Some(e) => Some(encode_terms::render_value(&e, 100000)),
            };
            row(out, "render_value", values[i].as_str(), opt_text(&rv).as_str());
        }
        let models: Vec<String> = encode_terms::split(grid_models().as_str(), b'\n');
        let tys: Vec<ast::IntTy> = int_tys();
        for i in 0..models.len()
            invariant 0 <= i && i <= models.len(),
        {
            for k in 0..tys.len()
                invariant 0 <= k && k <= tys.len(),
            {
                let mv: Option<String> = match encode_sub::model_int(models[i].as_str(), tys[k]) {
                    None => None,
                    Some(x) => Some(if x.neg { types::cat2("-", encode_sub::unsigned_text(x.mag).as_str()) } else { encode_sub::unsigned_text(x.mag) }),
                };
                row(out, "model_int", types::cat3(models[i].as_str(), ";", body::int_text(tys[k]).as_str()).as_str(), opt_text(&mv).as_str());
                let mut vars: Vec<encode_sub::Var> = Vec::new();
                vars.push(encode_sub::Var { sym: String::from("|x@0|"), sort: encode_sub::Sort::Int(tys[k]) });
                vars.push(encode_sub::Var { sym: String::from("||b||"), sort: encode_sub::Sort::Bool });
                vars.push(encode_sub::Var { sym: String::from("f"), sort: encode_sub::Sort::F64 });
                vars.push(encode_sub::Var { sym: String::from("|z|"), sort: encode_sub::Sort::Int(tys[k]) });
                let mut vals: Vec<String> = Vec::new();
                vals.push(models[i].clone());
                vals.push(String::from("true"));
                vals.push(models[i].clone());
                row(out, "sub_values", types::cat3(models[i].as_str(), ";", body::int_text(tys[k]).as_str()).as_str(), quoted(encode_query::sub_values(vars.as_slice(), vals.as_slice()).as_str()).as_str());
            }
        }
        let scripts: Vec<String> = encode_terms::split(grid_scripts().as_str(), b'^');
        for i in 0..scripts.len()
            invariant 0 <= i && i <= scripts.len(),
        {
            let cs: encode_query::Script = encode_query::canonical_script(scripts[i].as_str());
            let mut v: String = String::from("{\"text\":");
            v.push_str(quoted(cs.text.as_str()).as_str());
            v.push_str(",\"legend\":");
            v.push_str(quoted(cs.legend.as_str()).as_str());
            v.push_str("}");
            row(out, "canonical_script", scripts[i].as_str(), v.as_str());
        }
        for i in 0..scripts.len()
            invariant 0 <= i && i <= scripts.len(),
        {
            row(out, "canonical", scripts[i].as_str(), quoted(encode_query::canonical(scripts[i].as_str()).as_str()).as_str());
        }
        let mut canon: encode_query::Canon = encode_query::Canon { fwd: table::new::<String>(), names: Vec::new() };
        encode_query::forward(&mut canon, grid_canon().as_str());
        let answers: Vec<String> = encode_terms::split(grid_answers().as_str(), b'\n');
        for i in 0..answers.len()
            invariant 0 <= i && i <= answers.len(),
        {
            row(out, "canon_back", answers[i].as_str(), quoted(encode_query::back(&canon, answers[i].as_str()).as_str()).as_str());
        }
        let unnamed: encode_query::Canon = encode_query::Canon { fwd: table::new::<String>(), names: Vec::new() };
        row(out, "canon_back", "none: $0 |$0|", quoted(encode_query::back(&unnamed, "$0 |$0|").as_str()).as_str());
    }

    #[summary("The rows of the builders that read the tables, at type t")]
    #[effects(alloc)]
    fn dump_type(out: &mut String, t: &ast::TypeKind, tb: &lowered::Tables) -> () {
        let name: String = types::text(t);
        row(out, "range", name.as_str(), opt_text(&encode_terms::range(t, "x")).as_str());
        row(out, "len_max", name.as_str(), quoted(encode_terms::len_max(t).as_str()).as_str());
        row(out, "default_of", name.as_str(), quoted(encode_terms::default_of(t).as_str()).as_str());
        row(out, "ord_term", types::cat2("Lt ", name.as_str()).as_str(), quoted(encode_terms::ord_term(ast::BinOp::Lt, t, "a", "b").as_str()).as_str());
        row(out, "ord_term", types::cat2("Le ", name.as_str()).as_str(), quoted(encode_terms::ord_term(ast::BinOp::Le, t, "a", "b").as_str()).as_str());
        row(out, "ord_term", types::cat2("Gt ", name.as_str()).as_str(), quoted(encode_terms::ord_term(ast::BinOp::Gt, t, "a", "b").as_str()).as_str());
        row(out, "ord_term", types::cat2("Ge ", name.as_str()).as_str(), quoted(encode_terms::ord_term(ast::BinOp::Ge, t, "a", "b").as_str()).as_str());
        match body::int_of(t) {
            None => {},
            Some(it) => row(out, "wrap", name.as_str(), quoted(encode_terms::wrap_int(it, "x").as_str()).as_str()),
        }
        row(out, "default_val", name.as_str(), val_text(&encode_terms::default_val(t, tb, 100000), 100000).as_str());
        let mut ls: Vec<encode_decls::NamedLeaf> = Vec::new();
        encode_decls::leaves(t, tb, "v", &mut ls, 100000);
        let mut names: Vec<String> = Vec::new();
        for i in 0..ls.len()
            invariant 0 <= i && i <= ls.len(),
        {
            row(out, "leaf_fact", types::cat3(name.as_str(), " ", ls[i].name.as_str()).as_str(), opt_text(&encode_terms::leaf_fact(&ls[i].leaf, ls[i].name.as_str())).as_str());
            names.push(ls[i].name.clone());
        }
        let mut pos: usize = 0;
        let built: encode_terms::Val = encode_terms::build(t, tb, names.as_slice(), &mut pos, 100000);
        row(out, "build", name.as_str(), val_text(&built, 100000).as_str());
        let mut flat: Vec<String> = Vec::new();
        encode_terms::flatten(&built, &mut flat, 100000);
        row(out, "flatten", name.as_str(), list_text(flat.as_slice()).as_str());
        if encode_decls::is_array(t) {
            let e: ast::TypeKind = encode_decls::elem_ty(t);
            let d: encode_terms::Val = encode_terms::elem_default(&e, tb, 100000);
            row(out, "agg_elem", name.as_str(), bool_text(encode_decls::agg_elem(&e, tb)).as_str());
            row(out, "elem_default", name.as_str(), val_text(&d, 100000).as_str());
            row(out, "const_elems", name.as_str(), val_text(&encode_terms::const_elems(&e, &d, tb, 100000), 100000).as_str());
            let mut of: Vec<String> = Vec::new();
            encode_terms::flatten_elem_of(&d, &e, tb, &mut of, 100000);
            row(out, "flatten_elem_of", name.as_str(), list_text(of.as_slice()).as_str());
            let mut el: Vec<encode_decls::Fun> = Vec::new();
            encode_decls::elem_leaves(&e, tb, "", &mut el, 100000);
            let mut tn: Vec<String> = Vec::new();
            for i in 0..el.len()
                invariant 0 <= i && i <= el.len(),
            {
                tn.push(types::cat2("t", el[i].name.as_str()));
            }
            let mut tp: usize = 0;
            let template: encode_terms::Val = encode_terms::elem_template(&e, tb, tn.as_slice(), &mut tp, 100000);
            row(out, "elem_template", name.as_str(), val_text(&template, 100000).as_str());
            let mut fe: Vec<String> = Vec::new();
            encode_terms::flatten_elem(&template, &mut fe, 100000);
            row(out, "flatten_elem", name.as_str(), list_text(fe.as_slice()).as_str());
            let mut facts: Vec<String> = Vec::new();
            encode_terms::inner_len_facts(&template, &e, tb, &mut facts, 100000);
            row(out, "inner_len_facts", name.as_str(), list_text(facts.as_slice()).as_str());
        }
        if encode_decls::dt_struct(t, tb) {
            row(out, "dt_fields", name.as_str(), vals_text(encode_terms::dt_fields(t, "x", tb).as_slice(), 100000).as_str());
        }
    }

    #[summary("The rows of the value builders that need no type, over the shapes xs and ys. The unit value is no element template: shapes 3 and 8 are left out where one is read")]
    #[effects(alloc)]
    fn dump_vals(out: &mut String, xs: &[encode_terms::Val], ys: &[encode_terms::Val]) -> () {
        for k in 0..xs.len()
            invariant 0 <= k && k <= xs.len(),
        {
            let kn: String = encode_terms::dec(k as u64);
            let mut flat: Vec<String> = Vec::new();
            encode_terms::flatten(&xs[k], &mut flat, 100000);
            row(out, "flatten", kn.as_str(), list_text(flat.as_slice()).as_str());
            let mut fe: Vec<String> = Vec::new();
            encode_terms::flatten_elem(&xs[k], &mut fe, 100000);
            row(out, "flatten_elem", kn.as_str(), list_text(fe.as_slice()).as_str());
            if k == 0 || k == 3 {
                row(out, "s", kn.as_str(), quoted(encode_terms::scalar_of(&xs[k]).as_str()).as_str());
            }
            match encode_terms::parts(&xs[k]) {
                None => {},
                Some(p) => { let mut two: Vec<String> = Vec::new(); two.push(p.a.clone()); two.push(p.b.clone()); row(out, "parts", kn.as_str(), list_text(two.as_slice()).as_str()); },
            }
            if k != 3 && k != 8 && k < ys.len() {
                row(out, "select_val", kn.as_str(), val_text(&encode_terms::select_val(&xs[k], "i", 100000), 100000).as_str());
                row(out, "store_val", kn.as_str(), val_text(&encode_terms::store_val(&xs[k], "i", &ys[k], 100000), 100000).as_str());
                let mut pairs: Vec<encode_terms::Pair> = Vec::new();
                encode_terms::leaf_pairs(&xs[k], &ys[k], &mut pairs, 100000);
                let mut both: Vec<String> = Vec::new();
                for q in 0..pairs.len()
                    invariant 0 <= q && q <= pairs.len(),
                {
                    both.push(types::cat3(pairs[q].a.as_str(), " ", pairs[q].b.as_str()));
                }
                row(out, "leaf_pairs", kn.as_str(), list_text(both.as_slice()).as_str());
            }
            for j in 0..ys.len()
                invariant 0 <= j && j <= ys.len(),
            {
                row(out, "ite_val", types::cat3(kn.as_str(), " ", encode_terms::dec(j as u64).as_str()).as_str(), val_text(&encode_terms::ite_val("c", &xs[k], &ys[j], 100000), 100000).as_str());
            }
            row(out, "ite_val", types::cat2(kn.as_str(), " same").as_str(), val_text(&encode_terms::ite_val("c", &xs[k], &xs[k], 100000), 100000).as_str());
        }
    }

    #[summary("JSON of a refusal")]
    #[effects(alloc)]
    fn err_text(why: &str) -> String {
        types::cat3("{\"err\":", quoted(why).as_str(), "}")
    }

    #[summary("The amounts the bit methods that take one are shown at, one per line")]
    #[effects(alloc)]
    fn grid_amounts() -> String {
        String::from("n\n0\n1\n3\n7\n8\n9\n16\n31\n32\n33\n63\n64\n67\n(- 1)\n(- 3)\n(- 64)\n18446744073709551616\n(+ n 1)")
    }

    #[summary("The solver's answers back is shown at (TERM_ANSWERS of smt_terms_ref.rs), one per line: bare and quoted canonical symbols, values of an uninterpreted sort, symbols that need quoting again, numbers past the symbols and past a machine word, a `$` after a symbol character, tokens that are no canonical symbol, a bar left open, and text without a `$`")]
    #[effects(alloc)]
    fn grid_answers() -> String {
        String::from("(($2 7))\n((x $1))\n$4!val!0\n|$4|\n$x $99 a$1 |$q|\n$\n$5\n|$5|\n$6 $7 $8\n|$9|\n$9\n$10\n|$3| |$3\né$1 $1é\n$18446744073709551616\n$00001\n(_ $2 $0)\n\"$1\"\n$3$4\n|$4!val!1| |$5!x|\n$4|$3|\n(no symbols)\n|\n$1|")
    }

    #[summary("The text whose symbols back names answers after (TERM_CANON of smt_terms_ref.rs)")]
    #[effects(alloc)]
    fn grid_canon() -> String {
        String::from("(declare-datatypes ((|Option<i64>| 0)) (((|Option<i64>::None|) (|Option<i64>::Some| (|v| Int)))))\n(declare-sort |T| 0) |x y| |9lives| |a.b| || |open")
    }

    #[summary("The f64 bit patterns f64_lit is shown at: both zeros, one and minus one, the infinities, quiet, signalling and negative NaNs, the smallest and largest subnormals, the smallest normal and the largest finite value, and a value with every field mixed")]
    #[effects(alloc)]
    fn grid_f64() -> Vec<u64> {
        let mut v: Vec<u64> = Vec::new();
        v.push(0x0);
        v.push(0x8000000000000000);
        v.push(0x3ff0000000000000);
        v.push(0xbff0000000000000);
        v.push(0x7ff0000000000000);
        v.push(0xfff0000000000000);
        v.push(0x7ff8000000000000);
        v.push(0x7ff0000000000001);
        v.push(0xfff8000000000000);
        v.push(0x1);
        v.push(0xfffffffffffff);
        v.push(0x10000000000000);
        v.push(0x7fefffffffffffff);
        v.push(0x400921fb54442d18);
        v
    }

    #[summary("The texts helper_defs is shown at (TERM_HELPER_TEXTS of smt_terms_ref.rs)")]
    #[effects(alloc)]
    fn grid_helper_texts() -> String {
        String::from("\n(bmb_ctpop8 x)\n(bmb_rotr64 a b) (bmb_brev16 x) (bmb_clz8 y) (bmb_clz8 z)\nbmb_ctpop8\n(bmb_foo8 x)\n(bmb_ctpop8)\n(and (= (bmb_bswap64 x) (bmb_bswap32 y)) (bmb_ctz8 z) (bmb_rotl16 a b) (bmb_ctpop32 c))")
    }

    #[summary("The names helper_def is shown at (TERM_HELPERS of smt_terms_ref.rs): every helper at every width, widths that have none, and names that are no helper's")]
    #[effects(alloc)]
    fn grid_helpers() -> String {
        String::from("bmb_ctpop8\nbmb_ctpop16\nbmb_ctpop32\nbmb_ctpop64\nbmb_ctpop7\nbmb_ctpop128\nbmb_clz8\nbmb_clz16\nbmb_clz32\nbmb_clz64\nbmb_clz7\nbmb_clz128\nbmb_ctz8\nbmb_ctz16\nbmb_ctz32\nbmb_ctz64\nbmb_ctz7\nbmb_ctz128\nbmb_brev8\nbmb_brev16\nbmb_brev32\nbmb_brev64\nbmb_brev7\nbmb_brev128\nbmb_bswap8\nbmb_bswap16\nbmb_bswap32\nbmb_bswap64\nbmb_bswap7\nbmb_bswap128\nbmb_rotl8\nbmb_rotl16\nbmb_rotl32\nbmb_rotl64\nbmb_rotl7\nbmb_rotl128\nbmb_rotr8\nbmb_rotr16\nbmb_rotr32\nbmb_rotr64\nbmb_rotr7\nbmb_rotr128\nbmb_foo8\nbmb_foo16\nbmb_foo32\nbmb_foo64\nbmb_foo7\nbmb_foo128\nbmb_\nbmb_8\nctpop8\nbmb_ctpop\nbmb_ctpop08\nbmb_ctpop8x\nbmb_ctpop+8\n\nbmb\nbmb_c8t\nbmb_rotl4294967296")
    }

    #[summary("The model values model_int is shown at (TERM_MODELS of smt_terms_ref.rs): the three forms of a bit-vector literal, values on both sides of each type's sign bit and of the sign bit of 128 bits, and text that is no literal")]
    #[effects(alloc)]
    fn grid_models() -> String {
        String::from("#x0f\n#xff\n#xFF\n#x80\n#x100\n#b101\n#b\n#x\n#x+f\n#xg\n#b102\n#x7fffffffffffffff\n#x8000000000000000\n#xffffffffffffffff\n#xffffffffffffffffffffffffffffffff\n#x80000000000000000000000000000000\n#x1ffffffffffffffffffffffffffffffff\n(_ bv5 8)\n(_ bv255 8)\n(_ bv128 8)\n(_ bv127 8)\n(_ bv5)\n(_ bv 5)\n(_ bv)\n(_ bv5 8\n5\n\n(_ bv340282366920938463463374607431768211455 128)\n(_ bv340282366920938463463374607431768211456 128)\n(_ bv170141183460469231731687303715884105728 128)\n(_ bv18446744073709551615 64)\n(_ bv9223372036854775808 64)\n(_ bv-5 8)\n(_ bv+5 8)\n(_ bv65535 16)\n(_ bv4294967295 32)\n(_ bv2147483648 32)\n(_ bv5\t8)")
    }

    #[summary("Terms the numeral readers are shown at, one per line: numerals of both signs, the ends of 64 and 128 bits and one past them, leading zeros and a leading sign, and text that is no numeral")]
    #[effects(alloc)]
    fn grid_nums() -> String {
        String::from("x\n0\n1\n3\n5\n7\n8\n15\n16\n63\n64\n67\n127\n128\n255\n256\n65535\n007\n+5\n-3\n(- 0)\n(- 1)\n(- 3)\n(- 5)\n(- 64)\n(- x)\n(- )\n(-  5)\n(- 5) \n\n12a\n(+ a b)\n4294967295\n9223372036854775807\n9223372036854775808\n(- 9223372036854775808)\n18446744073709551615\n18446744073709551616\n170141183460469231731687303715884105727\n(- 170141183460469231731687303715884105727)\n170141183460469231731687303715884105728\n(- 170141183460469231731687303715884105728)\n340282366920938463463374607431768211455\n340282366920938463463374607431768211456\n99999999999999999999999999999999999999999")
    }

    #[summary("The operand pairs the bit operations are shown at, `a;b` one per line: terms, a zero and constant amounts on both sides of each width, masks 2^k - 1 up to each type's largest value on either side, constants that are no mask, and negative constants")]
    #[effects(alloc)]
    fn grid_pairs() -> String {
        String::from("a;b\na;0\na;1\na;3\na;7\na;8\na;15\na;16\na;31\na;32\na;63\na;64\na;100\na;127\na;128\na;255\na;32767\na;65535\na;2147483647\na;4294967295\na;9223372036854775807\na;18446744073709551615\na;18446744073709551616\na;(- 1)\na;(- 8)\n255;b\n0;b\n6;b\n(+ a 1);(- b)\n(- 0);b\na;(- 0)")
    }

    #[summary("The scripts canonical_script is shown at (TERM_SCRIPTS of smt_terms_ref.rs), separated by `^`: symbols used twice, comment lines and a comment after a command, a string literal, a `(reset)` among white space and one with text after it, a symbol and a string left open at the end of a line, text before the first `(reset)`, a last line without a line feed, and the empty script")]
    #[effects(alloc)]
    fn grid_scripts() -> String {
        String::from("(reset)\n(declare-const |a| Int)\n(assert (> |a| |b c|))\n(assert (> |b c| |a|))\n(check-sat)\n^; comment |x| stays\n(reset)\n(echo \"|s|\") |x| ; tail |y|\n|y|\n  (reset)  \n|y| |x|\n^(reset)\n|unclosed\n|next|\n^no reset |a|\n   ; indented comment |a|\n\t(reset)\t\n|a|^(reset)\n\"open string |a|\n|a|\n(reset) x\n|b|\n(reset\n|c|\n^^|a|\n^ (reset) \n|a| |é|\n\u{b}(reset)\u{c}\n|é|\n^(reset)\n(reset)\n|a|\n(reset)\n")
    }

