    #[summary("Terms the text readers are shown at, one per line: applications of select and of one-argument symbols, quoted symbols holding spaces, parentheses and a character outside ASCII, implications, connectives nested to each depth around the lift depth, white space that is a tab or outside ASCII, and unbalanced text")]
    #[effects(alloc)]
    fn grid_texts() -> String {
        String::from("x\n\n|a b|\n(select a i)\n(select (store a 0 1) (+ i 1))\n(select |a b| |i (|)\n(select a)\n(select a i j)\n(select  a i)\n(select a i\n(f a)\n(f (g a))\n(f a b)\n(f)\n(|f g| a)\n(|f g| (h |) (|))\n(|f a)\n(|é| |é é|)\n( a)\n(f a )\n(=> g x)\n(=> (and a b) (or c d))\n(=> g x y)\n(=> g)\n(=> |g h| (=> a (and b (or c d))))\n(=> g (and a (=> b (and c d))))\n(=> g x) \n(f\ta b c)\n(and a b)\n(and a (or b (=> c d)))\n(and (and (and (and a b) c) d) (or e f))\n(not (and a (or b c)))\n(f |(and (or| (and a b))\n(andy (ore a b))\n(and\n) (\n(a))\na b\n (a)\n|a")
    }

    #[summary("The model values render_value is shown at (TERM_VALUES of smt_terms_ref.rs): numerals, a negation, a value of a type parameter's sort, lists, and f64 values in each form")]
    #[effects(alloc)]
    fn grid_values() -> String {
        String::from("5\n(- 3)\ntrue\n|'T!val!1|\n|'T!val!|\n|'|\n|'T|\n|'a b!val!12|\nx\n(- (- 3))\n(- 3 4)\n(a b (c))\n()\n(-)\n(fp #b0 #b01111111111 #x0000000000000)\n(fp #b1 #b10000000000 #x921fb54442d18)\n(fp #b0 #b11111111111 #x0000000000000)\n(fp #b1 #b11111111111 #x0000000000000)\n(fp #b0 #b11111111111 #x8000000000000)\n(fp #b1 #b11111111111 #x0000000000001)\n(fp #b0 #b00000000000 #x0000000000001)\n(fp #b0 #b00000000000 #x0000000000000)\n(fp #b1 #b00000000000 #x0000000000000)\n(_ +zero 11 53)\n(_ -zero 11 53)\n(_ +oo 11 53)\n(_ -oo 11 53)\n(_ NaN 11 53)\n(_ NaN 8 24)\n(_ foo 11 53)\n(_ NaN 11)\n(fp #b0 #b0111111111 #x0000000000000)\n(fp #x0 #b01111111111 #x0000000000000)\n(fp #b0 #x3ff #x0000000000000)\n(fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000001)\n(fp a b c)\n(fp #b2 #b01111111111 #x0000000000000)\n(fp #b0 #b01111111111 #x000000000000g)\n(fp #b0 #b01111111111 #x+00000000000A)\n(fp #b0 #b01111111111 #x0000000000000 x)\n(fp #b0 (b) #x0000000000000)\n(fp #b0 #b10000000000 #x0000000000000)\n(fp #b0 #b01111111011 #x999999999999a)\n(fp #b0 #b10001000100 #xb1ae4d6e2ef50)\n(fp #b0 #b01111100111 #xad7f29abcaf48)\n(fp #b0 #b11111111110 #xfffffffffffff)\n((x 5) (y (- 3)) (b true) (v |'T!val!1|) (f (fp #b0 #b01111111111 #x8000000000000)))")
    }

    #[summary("The integer type named s")]
    #[effects(alloc)]
    fn int_named(s: &str) -> Option<ast::IntTy> {
        let tys: Vec<ast::IntTy> = int_tys();
        for i in 0..tys.len()
            invariant 0 <= i && i <= tys.len(),
        {
            if body::int_text(tys[i]).as_str() == s {
                return Some(tys[i]);
            }
        }
        None
    }

    #[summary("Every integer type, in declaration order")]
    #[effects(alloc)]
    fn int_tys() -> Vec<ast::IntTy> {
        let mut v: Vec<ast::IntTy> = Vec::new();
        v.push(ast::IntTy::I8);
        v.push(ast::IntTy::I16);
        v.push(ast::IntTy::I32);
        v.push(ast::IntTy::I64);
        v.push(ast::IntTy::Isize);
        v.push(ast::IntTy::U8);
        v.push(ast::IntTy::U16);
        v.push(ast::IntTy::U32);
        v.push(ast::IntTy::U64);
        v.push(ast::IntTy::Usize);
        v
    }

    #[summary("JSON of a list of texts")]
    #[effects(alloc)]
    fn list_text(xs: &[String]) -> String {
        let mut s: String = String::from("[");
        for i in 0..xs.len()
            invariant 0 <= i && i <= xs.len(),
        {
            if i > 0 {
                s.push_str(",");
            }
            std::json::push_string(&mut s, xs[i].as_str());
        }
        s.push_str("]");
        s
    }

    #[summary("Checks the program of source and prints the rows. If it does not check, prints the diagnostics and exits 1")]
    #[effects(alloc, io)]
    fn main() -> () {
        let mut sm: source::SourceMap = source::SourceMap { files: Vec::new() };
        let mut diags: diag::Diags = diag::Diags { items: Vec::new(), aliases: Vec::new() };
        let mut files: Vec<lib::Input> = Vec::new();
        files.push(lib::Input { name: String::from("terms.bmb"), text: source() });
        let fe: lib::Front = lib::frontend(files.as_slice(), &mut sm, &mut diags);
        if diags.has_errors() {
            print_str(diags.to_jsonl(&sm).as_str());
            std::process::exit(1);
        }
        print_str(dump(&fe.ck).as_str());
    }

    #[summary("The Rust name of an operation")]
    #[effects(alloc)]
    fn op_name(op: ast::BinOp) -> String {
        match op {
            ast::BinOp::Add => String::from("Add"),
            ast::BinOp::Sub => String::from("Sub"),
            ast::BinOp::Mul => String::from("Mul"),
            ast::BinOp::Div => String::from("Div"),
            ast::BinOp::Rem => String::from("Rem"),
            ast::BinOp::Eq => String::from("Eq"),
            ast::BinOp::Ne => String::from("Ne"),
            ast::BinOp::Lt => String::from("Lt"),
            ast::BinOp::Le => String::from("Le"),
            ast::BinOp::Gt => String::from("Gt"),
            ast::BinOp::Ge => String::from("Ge"),
            ast::BinOp::And => String::from("And"),
            ast::BinOp::Or => String::from("Or"),
            ast::BinOp::Implies => String::from("Implies"),
            ast::BinOp::BitAnd => String::from("BitAnd"),
            ast::BinOp::BitOr => String::from("BitOr"),
            ast::BinOp::BitXor => String::from("BitXor"),
            ast::BinOp::Shl => String::from("Shl"),
            ast::BinOp::Shr => String::from("Shr"),
        }
    }

    #[summary("JSON of an optional text: null or a string")]
    #[effects(alloc)]
    fn opt_text(x: &Option<String>) -> String {
        match x {
            None => String::from("null"),
            Some(s) => quoted(s.as_str()),
        }
    }

    #[summary("JSON of an optional pair of texts: null or a list of two strings")]
    #[effects(alloc)]
    fn pair_text(x: &Option<encode_terms::Pair>) -> String {
        match x {
            None => String::from("null"),
            Some(p) => types::cat5("[", quoted(p.a.as_str()).as_str(), ",", quoted(p.b.as_str()).as_str(), "]"),
        }
    }

    #[summary("One row of set_at: place number k, the steps, the new value and the declarations and facts it made")]
    #[effects(alloc)]
    fn place(out: &mut String, k: u64, v: &encode_terms::Val, steps: &[encode_terms::Step], new: &encode_terms::Val, tb: &lowered::Tables, fr: &mut encode_terms::Fresh) -> () {
        let from: usize = fr.decls.len();
        let mut args: String = encode_terms::dec(k);
        args.push_str(" ");
        for i in 0..steps.len()
            invariant 0 <= i && i <= steps.len(),
        {
            if i > 0 {
                args.push_str(" ");
            }
            match &steps[i] {
                encode_terms::Step::Field(n) => args.push_str(types::cat3("Field(", encode_terms::dec(*n as u64).as_str(), ")").as_str()),
                encode_terms::Step::DataField(n, t) => args.push_str(types::cat5("DtField(", encode_terms::dec(*n as u64).as_str(), ",", types::text(t).as_str(), ")").as_str()),
                encode_terms::Step::Index(x) => args.push_str(types::cat3("Index(", x.as_str(), ")").as_str()),
            }
        }
        let nv: encode_terms::Val = encode_terms::set_at(v, steps, 0, new, tb, fr);
        let mut made: Vec<String> = Vec::new();
        for d in 0..fr.decls.len()
            invariant 0 <= d && d <= fr.decls.len(),
        {
            if d >= from {
                made.push(fr.decls[d].clone());
            }
        }
        row(out, "set_at", args.as_str(), types::cat5("{\"val\":", val_text(&nv, 100000).as_str(), ",\"decls\":", list_text(made.as_slice()).as_str(), "}").as_str());
    }

    #[summary("JSON of a text")]
    #[effects(alloc)]
    fn quoted(s: &str) -> String {
        let mut out: String = String::new();
        std::json::push_string(&mut out, s);
        out
    }

    #[summary("One row of the dump: the builder, its arguments and its result (JSON)")]
    #[effects(alloc)]
    fn row(out: &mut String, f: &str, args: &str, value: &str) -> () {
        out.push_str("{\"fn\":");
        std::json::push_string(out, f);
        out.push_str(",\"args\":");
        std::json::push_string(out, args);
        out.push_str(",\"out\":");
        out.push_str(value);
        out.push_str("}\n");
    }

    #[summary("The value shapes the builders that need no type are shown at, their terms named after p: a scalar, arrays of a fixed and of a variable length, the unit value, a struct, slices of structs of a fixed and of a variable length (the element's inner arrays likewise), an array of arrays of structs, and a struct with a unit field")]
    #[effects(alloc)]
    fn shapes(p: &str) -> Vec<encode_terms::Val> {
        let mut v: Vec<encode_terms::Val> = Vec::new();
        v.push(encode_terms::Val::S(types::cat2(p, "s")));
        v.push(encode_terms::Val::A(types::cat2(p, "a"), String::from("3")));
        v.push(encode_terms::Val::A(types::cat2(p, "b"), types::cat2(p, "n")));
        v.push(encode_terms::Val::Unit);
        let mut st: Vec<encode_terms::Val> = Vec::new();
        st.push(encode_terms::Val::S(types::cat2(p, "p")));
        st.push(encode_terms::Val::A(types::cat2(p, "q"), String::from("2")));
        st.push(encode_terms::Val::A(types::cat2(p, "r"), types::cat2(p, "m")));
        v.push(encode_terms::Val::Struct(st));
        let mut e: Vec<encode_terms::Val> = Vec::new();
        e.push(encode_terms::Val::S(types::cat2(p, "e0")));
        e.push(encode_terms::Val::S(types::cat2(p, "e1")));
        v.push(encode_terms::Val::Arr(Box::new(encode_terms::Val::Struct(e)), String::from("2")));
        let mut g: Vec<encode_terms::Val> = Vec::new();
        g.push(encode_terms::Val::S(types::cat2(p, "f0")));
        g.push(encode_terms::Val::A(types::cat2(p, "f1"), String::from("4")));
        g.push(encode_terms::Val::A(types::cat2(p, "f2"), types::cat2(p, "fl")));
        v.push(encode_terms::Val::Arr(Box::new(encode_terms::Val::Struct(g)), types::cat2(p, "n")));
        let mut h: Vec<encode_terms::Val> = Vec::new();
        h.push(encode_terms::Val::S(types::cat2(p, "g")));
        v.push(encode_terms::Val::Arr(Box::new(encode_terms::Val::Arr(Box::new(encode_terms::Val::Struct(h)), types::cat2(p, "gl"))), String::from("2")));
        let mut u: Vec<encode_terms::Val> = Vec::new();
        u.push(encode_terms::Val::S(types::cat2(p, "u")));
        u.push(encode_terms::Val::Unit);
        v.push(encode_terms::Val::Struct(u));
        v
    }

    #[summary("The program whose types the dump shows the builders at (TERMS_SOURCE of the reference): the parameters of g::sig, in order. Every integer type, the other scalars, a struct, a struct with an array, a Vec and an enum, a recursive struct (a datatype with selector functions), enums, arrays and slices of scalars, structs, arrays and Vecs, a type parameter, text and a built-in enum")]
    #[effects(alloc)]
    fn source() -> String {
        String::from("#[summary(\"The types the term builders are shown at\")]\nmod g {\n    enum E { A, B(i64), C(P) }\n\n    enum L { Nil, Cons(i32, Box<L>) }\n\n    struct P { x: i32, on: bool }\n\n    struct Q { p: P, a: [u8; 3], v: Vec<u16>, e: E }\n\n    struct R { n: u64, kids: Vec<R> }\n\n    struct W { ps: Vec<P>, grid: [[i8; 2]; 2], vv: Vec<Vec<u32>> }\n\n    #[effects(pure)]\n    fn sig<T: Ord + Copy>(a: i8, b: i16, c: i32, d: i64, e: isize, f: u8, g: u16, h: u32, i: u64, j: usize, k: bool, l: f64, m: (), n: P, o: &Q, p: &R, q: E, r: &L, s: [u8; 4], t: &[i64], u: [P; 2], v: &[P], w: &Vec<Vec<u8>>, x: [[u16; 2]; 3], y: &[W], z: T, aa: [T; 2], ab: &str, ac: Option<u32>, ad: &[R], ae: &[E], af: &[bool], ag: &[f64], ah: &[T], ai: &mut P, aj: &Vec<P>, al: &[[P; 2]]) -> () {}\n}\n")
    }

    #[summary("JSON of a term with its facts: a list of the term and the list of facts")]
    #[effects(alloc)]
    fn term_text(r: &encode_terms::Term) -> String {
        types::cat5("[", quoted(r.t.as_str()).as_str(), ",", list_text(r.facts.as_slice()).as_str(), "]")
    }

    #[summary("JSON of a value: its shape and the terms at its leaves")]
    #[effects(alloc)]
    fn val_text(v: &encode_terms::Val, f: usize) -> String
        decreases f,
    {
        if f == 0 {
            return String::new();
        }
        match v {
            encode_terms::Val::S(t) => types::cat3("{\"s\":", quoted(t.as_str()).as_str(), "}"),
            encode_terms::Val::A(elems, len) => types::cat5("{\"a\":", quoted(elems.as_str()).as_str(), ",\"len\":", quoted(len.as_str()).as_str(), "}"),
            encode_terms::Val::Unit => String::from("\"unit\""),
            encode_terms::Val::Struct(fs) => types::cat3("{\"struct\":", vals_text(fs.as_slice(), f - 1).as_str(), "}"),
            encode_terms::Val::Arr(elem, alen) => types::cat5("{\"arr\":", val_text(&**elem, f - 1).as_str(), ",\"len\":", quoted(alen.as_str()).as_str(), "}"),
        }
    }

    #[summary("JSON of a list of values")]
    #[effects(alloc)]
    fn vals_text(vs: &[encode_terms::Val], f: usize) -> String
        decreases f,
    {
        let mut s: String = String::from("[");
        if f == 0 {
            return s;
        }
        for i in 0..vs.len()
            invariant 0 <= i && i <= vs.len(),
        {
            if i > 0 {
                s.push_str(",");
            }
            s.push_str(val_text(&vs[i], f - 1).as_str());
        }
        s.push_str("]");
        s
    }
}
