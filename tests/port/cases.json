{
  "builds": {
    "sha256_files": {
      "bmb": "tests/port/sha256_files.bmb"
    },
    "json_roundtrip": {
      "bmb": "tests/port/json_roundtrip.bmb"
    },
    "json_ref": {
      "rustc": "tests/port/json_ref.rs"
    },
    "std_num": {
      "bmb": "tests/run/std_num.bmb"
    },
    "std_num_ref": {
      "rustc": "tests/run/std_num_ref.rs"
    },
    "stage1": {
      "bmb": [
        "selfhost/*.bmb"
      ]
    },
    "unicode_ref": {
      "rustc": "tests/port/unicode_ref.rs"
    },
    "unicode_classes": {
      "bmb": [
        "selfhost/unicode.bmb",
        "tests/port/unicode_classes.bmb"
      ]
    }
  },
  "cases": [
    {
      "name": "sha256",
      "component": "C0",
      "a": [
        "sha256sum",
        "{inputs}"
      ],
      "b": [
        "{build:sha256_files}",
        "{inputs}"
      ],
      "inputs": {
        "files": [
          "*"
        ],
        "chunk": 200
      }
    },
    {
      "name": "json-lines",
      "component": "C0",
      "a": [
        "{build:json_ref}"
      ],
      "b": [
        "{build:json_roundtrip}"
      ],
      "inputs": {
        "stdin_lines_of": [
          "*.jsonl"
        ]
      }
    },
    {
      "name": "json-edges",
      "component": "C0",
      "a": [
        "{build:json_ref}"
      ],
      "b": [
        "{build:json_roundtrip}"
      ],
      "inputs": {
        "stdin": [
          "tests/port/json_edge.txt"
        ]
      }
    },
    {
      "name": "integers",
      "component": "C0",
      "a": [
        "{build:std_num_ref}"
      ],
      "b": [
        "{build:std_num}"
      ],
      "inputs": {
        "none": true
      }
    },
    {
      "name": "codes",
      "component": "C0",
      "a": [
        "{bmb}",
        "codes"
      ],
      "b": [
        "{build:stage1}",
        "codes"
      ],
      "inputs": {
        "none": true
      }
    },
    {
      "name": "codes-md",
      "component": "C0",
      "a": [
        "{bmb}",
        "codes",
        "--md"
      ],
      "b": [
        "{build:stage1}",
        "codes",
        "--md"
      ],
      "inputs": {
        "none": true
      }
    },
    {
      "name": "unicode-classes",
      "component": "C1",
      "a": [
        "{build:unicode_ref}"
      ],
      "b": [
        "{build:unicode_classes}"
      ],
      "inputs": {
        "none": true
      }
    },
    {
      "name": "tokens",
      "component": "C1",
      "a": [
        "{bmb}",
        "dump",
        "tokens",
        "{inputs}"
      ],
      "b": [
        "{build:stage1}",
        "dump",
        "tokens",
        "{inputs}"
      ],
      "inputs": {
        "files": [
          "*.bmb"
        ],
        "chunk": 1
      }
    },
    {
      "name": "tokens-together",
      "component": "C1",
      "a": [
        "{bmb}",
        "dump",
        "tokens",
        "{inputs}"
      ],
      "b": [
        "{build:stage1}",
        "dump",
        "tokens",
        "{inputs}"
      ],
      "inputs": {
        "files": [
          "tests/run/*.bmb",
          "lib/std/*.bmb",
          "selfhost/*.bmb"
        ],
        "chunk": 40
      }
    },
    {
      "name": "tokens-edges",
      "component": "C1",
      "a": [
        "{bmb}",
        "dump",
        "tokens",
        "{inputs}"
      ],
      "b": [
        "{build:stage1}",
        "dump",
        "tokens",
        "{inputs}"
      ],
      "inputs": {
        "files": [
          "tests/port/lexer/*.txt"
        ],
        "chunk": 1
      }
    }
  ]
}
