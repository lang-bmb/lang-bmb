#[summary("루프 의무 위반")]
mod loops {
    #[effects(pure)]
    fn entry(n: u64) -> u64 {
        let mut i: u64 = 0;
        while i < n
            invariant i == 1,
            decreases n - i,
        {
            i = i + 1;
        }
        i
    }

    #[effects(pure)]
    fn preserve(n: u64) -> u64 {
        let mut i: u64 = 0;
        while i < n
            invariant i <= 1,
            decreases n - i,
        {
            i = i + 1;
        }
        i
    }

    #[effects(pure)]
    fn no_progress(n: u64) -> u64 {
        let mut i: u64 = 0;
        let mut s: u64 = 0;
        while i < n
            invariant i <= n,
            decreases n - i,
        {
            s = 0;
        }
        i
    }

    #[effects(pure)]
    fn negative_measure(n: i64) -> i64 {
        let mut i: i64 = 10;
        while i > n
            invariant true,
            decreases i,
        {
            i = i.wrapping_sub(1);
        }
        i
    }

    spec fn first_len(a: &[i64]) -> bool { a.len() > 0 }

    #[effects(pure)]
    #[uses(first_len)]
    fn zero_first(a: &mut [i64]) -> ()
        requires first_len(a),
    {
        a[0] = 0;
    }

    // A `&mut` parameter passed on inside a loop is havocked at the loop
    // head: what was written before the loop is gone (backlog 1B-38).
    #[effects(pure)]
    #[uses(first_len)]
    fn passed_on_in_loop(a: &mut [i64]) -> ()
        requires first_len(a),
    {
        a[0] = 5;
        let mut i: i64 = 0;
        while i < 3
            invariant 0 <= i, i <= 3, first_len(a),
            decreases 3 - i,
        {
            zero_first(a);
            i = i + 1;
        }
        assert(a[0] == 5);
    }

    enum Cell { Empty, Full(i64) }

    spec fn zero(c: &Cell) -> bool {
        match c {
            Cell::Empty => false,
            Cell::Full(v) => *v == 0,
        }
    }

    // An assignment in a `match` arm in the body is havocked at the loop
    // head (it was not: the assertion was proved, found in 2K-01a).
    #[effects(pure)]
    fn arm_assigns(o: Option<i64>) -> i64 {
        let mut x: i64 = 0;
        let mut i: u64 = 0;
        while i < 10
            invariant i <= 10,
            decreases 10 - i,
        {
            match o {
                None => {}
                Some(v) => {
                    x = 5;
                }
            }
            i = i + 1;
        }
        assert(x == 0);
        x
    }

    // So is a write through a `&mut` match binding on a `&mut` parameter.
    #[effects(pure)]
    #[uses(zero)]
    fn binding_writes(c: &mut Cell) -> ()
        requires zero(c),
    {
        let mut i: u64 = 0;
        while i < 3
            invariant i <= 3,
            decreases 3 - i,
        {
            match c {
                Cell::Empty => {}
                Cell::Full(v) => {
                    *v = 7;
                }
            }
            i = i + 1;
        }
        assert(zero(c));
    }
}
