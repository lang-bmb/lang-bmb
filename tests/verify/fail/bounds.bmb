#[summary("인덱스 의무 위반")]
mod bounds {
    #[effects(pure)]
    fn read_any(a: &[i64], i: usize) -> i64 { a[i] }

    #[effects(pure)]
    fn read_len(a: &[i64]) -> i64 { a[a.len()] }

    #[effects(pure)]
    fn write_any(a: &mut [i64], i: usize) -> () { a[i] = 0; }

    #[effects(pure)]
    fn local_array() -> i64 {
        let x: [i64; 3] = [1, 2, 3];
        x[3]
    }

    // Regression: values after a short array in a counterexample belong to
    // the next parameter (here x must be 7).
    spec fn one_and_seven(a: &[i64], x: i64) -> bool { a.len() == 1 && x == 7 }

    spec fn not_seven(r: i64) -> bool { r != 7 }

    #[effects(pure)]
    #[uses(one_and_seven, not_seven)]
    fn cex_after_array(a: &[i64], x: i64) -> (r: i64)
        requires one_and_seven(a, x),
        ensures not_seven(r),
    {
        x
    }
}
