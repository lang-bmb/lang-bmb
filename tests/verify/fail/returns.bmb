#[summary("조기 반환의 틀린 프로그램: 반환 지점의 사후 조건, 남은 경로의 조건 (backlog 2K-01a)")]
mod rf {
    spec fn nonneg(r: i64) -> bool { r >= 0 }

    spec fn at(a: &[i64], x: i64, r: usize) -> bool { r < a.len() && a[r] == x }

    // The early value breaks the postcondition.
    #[effects(pure)]
    #[uses(nonneg)]
    fn early(x: i64) -> (r: i64)
        ensures nonneg(r),
    {
        if x < 0 {
            return x;
        }
        x
    }

    // The value returned is checked like any other.
    #[effects(pure)]
    fn grows(x: i64) -> i64 {
        if x > 0 {
            return x + 1;
        }
        0
    }

    // After `if x > 0 { return .. }` the rest runs only for `x <= 0`.
    #[effects(pure)]
    fn rest(x: u64) -> u64 {
        if x > 0 {
            return 1;
        }
        10 / x
    }

    // The value found in the loop is returned; the end of the body is
    // reached when nothing was found.
    #[effects(pure)]
    #[uses(at)]
    fn find(a: &[i64], x: i64) -> (r: usize)
        ensures at(a, x, r),
    {
        let mut i: usize = 0;
        while i < a.len()
            invariant i <= a.len(),
            decreases a.len() - i,
        {
            if a[i] == x {
                return i;
            }
            i = i + 1;
        }
        0
    }

    // A `return` in a `match` arm.
    #[effects(pure)]
    #[uses(nonneg)]
    fn arm(o: Option<i64>) -> (r: i64)
        ensures nonneg(r),
    {
        let v: i64 = match o {
            None => return -1,
            Some(x) => x,
        };
        0
    }
}
