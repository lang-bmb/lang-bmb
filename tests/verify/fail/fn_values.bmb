#[summary("함수 값의 계약 실패(ADR-0053, backlog 2V-20a): 넘긴 함수의 requires가 호출에서 성립하지 않으면 f.requires(x)의 E0801, 클로저 몸의 의무는 그 계약 아래에서")]
mod fvf {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    // An `FnMut` closure's `ensures` reads its captures before the call:
    // `count` is 0 there and 1 after, so `y == x + count` fails at its
    // clause (backlog 2V-20f; it would hold of the state after).
    #[effects(pure)]
    fn counted() -> i64 {
        let mut count: u64 = 0;
        once::<_>(move |x: i64| -> (y: i64) requires count < 100 && x < 100 && x > -100, ensures y == x + count, { count = count + 1; x + count as i64 }, 5)
    }

    // The closure's `requires` bounds `x` above only: `x * 2` may overflow.
    #[effects(pure)]
    fn doubled() -> i64 {
        apply::<_>(|x: i64| -> (y: i64) requires x < 100, ensures y == x * 2, { x * 2 }, 21)
    }

    #[effects(pure)]
    fn inc(x: i64) -> (r: i64)
        requires x < 1000,
        ensures r == x + 1,
    {
        x + 1
    }

    // The inner closure claims one more than it returns: reported as
    // `fvf::nested::{closure#0}::{closure#0}` with its capture `k`
    // (backlog 2V-20g); the outer one fails with it.
    #[effects(pure)]
    fn nested() -> i64 {
        apply::<_>(|x: i64| -> (y: i64) requires x == 5, ensures y == x + 3, { let k: i64 = x; apply::<_>(move |z: i64| -> (w: i64) requires z == 3, k == 5, ensures w == z + k + 1, { z + k }, 3) }, 5)
    }

    #[effects(pure)]
    fn once<F: FnMut(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    // `inc` needs `x < 1000`.
    #[effects(pure)]
    fn too_big() -> i64 {
        apply::<_>(inc, 5000)
    }

    // The closure's body doubles, its second `ensures` claims three times:
    // E0802 at that clause (backlog 2V-20f), not at the generated `call`.
    #[effects(pure)]
    fn tripled() -> i64 {
        apply::<_>(|x: i64| -> (y: i64) requires x < 100 && x > -100, ensures y % 2 == 0, y == x * 3, { x * 2 }, 21)
    }

    // `inc`'s result is `x + 1`, not `x`.
    #[effects(pure)]
    fn wrong_result() -> (r: i64)
        ensures r == 10,
    {
        apply::<_>(inc, 10)
    }
}
