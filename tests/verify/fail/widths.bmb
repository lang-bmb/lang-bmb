#[summary("Wrong programs of integer widths: overflow of narrow types, the range of conversions, MIN % -1")]
mod wf {
    // `127 + 1` leaves `i8`.
    #[effects(pure)]
    fn inc(x: i8) -> i8 {
        x + 1
    }

    // `0 - 1` leaves `u16`.
    #[effects(pure)]
    fn dec(x: u16) -> u16 {
        x - 1
    }

    // `x * 65536` leaves `i32` from `x = 32768` on.
    #[effects(pure)]
    fn scale(x: i32) -> i32 {
        x * 65536
    }

    // Not every `i32` is an `i16`.
    #[effects(pure)]
    fn narrow(x: i32) -> i16 {
        x as i16
    }

    // `i16::MIN % -1` overflows.
    #[effects(pure)]
    fn rem(n: i16, d: i16) -> i16
        requires nonzero(d),
    {
        n % d
    }

    spec fn nonzero(d: i16) -> bool {
        d != 0
    }

    // A negative `isize` is not a `usize`.
    #[effects(pure)]
    fn index(i: isize) -> usize {
        i as usize
    }
}
