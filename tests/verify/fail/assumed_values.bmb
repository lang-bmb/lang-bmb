#[summary("A counterexample under a spec fn the proof sees only by name says so and shows the values the model gave it (ADR-0161)")]
mod opaque {
    spec fn off(x: &[u8], n: usize) -> usize
        decreases n,
    {
        if n == 0 || n > x.len() { 0 } else { off(x, n - 1) + (if x[n - 1] == 1 { 3 } else { 1 }) }
    }

    spec fn nonneg(x: &[u8], n: usize) -> bool {
        off(x, n) + 1 > 0
    }

    // `off` is not revealed: the model gives it a value no `usize` has
    // (spec values are not held to their declared types, ADR-0090), and
    // the inputs alone are no counterexample under its definition.
    #[uses(nonneg)]
    proof fn by_name(x: &[u8], n: usize)
        ensures nonneg(x, n),
    {
    }
}
