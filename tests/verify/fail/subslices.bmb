#[summary("Bounds failures of subslices: the end past the length, the start greater than the end")]
mod sf {
    #[effects(pure)]
    fn count(b: &[u8]) -> usize {
        b.len()
    }

    #[effects(pure)]
    fn past_the_end(b: &[u8], hi: usize) -> usize {
        count(&b[0..hi])
    }

    #[effects(pure)]
    fn backwards(b: &[u8], lo: usize) -> usize {
        if lo <= b.len() {
            count(&b[lo..1])
        } else {
            0
        }
    }
}
