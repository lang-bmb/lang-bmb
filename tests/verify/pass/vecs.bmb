#[summary("Vec proved: push, pop, truncate, clone, moves, &mut Vec contracts, handles (ADR-0031 §3, §5, backlog 2G-03)")]
mod vp {
    spec fn room(a: &[i64]) -> bool { a.len() < 1000 }

    spec fn grew(a: &[i64], b: &[i64], x: i64) -> bool {
        a.len() == b.len() + 1 && a[b.len()] == x && forall|k: usize| k < b.len() ==> #[trigger] a[k] == b[k]
    }

    // The callee's contract is all the caller knows of the new length.
    #[effects(pure)]
    #[uses(room, grew)]
    fn push_one(v: &mut Vec<i64>, x: i64) -> ()
        requires room(v.as_slice()),
        ensures grew(v.as_slice(), old(v).as_slice(), x),
    {
        v.push(x);
    }

    spec fn small(n: usize) -> bool { n <= 1000 }

    spec fn triples(a: &[i64], n: usize) -> bool {
        a.len() == n && forall|k: usize| k < n ==> #[trigger] a[k] == 3 * k
    }

    #[effects(pure)]
    #[uses(small, triples)]
    fn first_triples(n: usize) -> (r: Vec<i64>)
        requires small(n),
        ensures triples(r.as_slice(), n),
    {
        let mut v: Vec<i64> = Vec::with_capacity(n);
        let mut i: usize = 0;
        while i < n
            invariant i <= n, v.len() == i, triples(v.as_slice(), i),
            decreases n - i,
        {
            let k: i64 = i64::try_from(i).unwrap();
            v.push(3 * k);
            i = i + 1;
        }
        v
    }

    // A result's contract gives its length: the index is proved.
    #[effects(pure)]
    #[uses(small, triples, room, grew)]
    fn use_result() -> i64 {
        let mut v: Vec<i64> = first_triples(5);
        push_one(&mut v, 7);
        v[4] + v[5]
    }

    spec fn shrank(a: &[i64], b: &[i64]) -> bool {
        (b.len() == 0 && a.len() == 0) || a.len() + 1 == b.len()
    }

    spec fn popped(r: i64, b: &[i64]) -> bool { b.len() == 0 || r == b[b.len() - 1] }

    #[effects(pure)]
    #[uses(shrank, popped)]
    fn pop_or_zero(v: &mut Vec<i64>) -> (r: i64)
        ensures shrank(v.as_slice(), old(v).as_slice()), popped(r, old(v).as_slice()),
    {
        match v.pop() {
            None => 0,
            Some(x) => x,
        }
    }

    spec fn at_most(a: &[i64], b: &[i64], n: usize) -> bool { a.len() <= n && a.len() <= b.len() }

    #[effects(pure)]
    #[uses(at_most)]
    fn cut(v: &mut Vec<i64>, n: usize) -> ()
        ensures at_most(v.as_slice(), old(v).as_slice(), n),
    {
        v.truncate(n);
    }

    // A clone is the same value; a move carries it on.
    #[effects(pure)]
    fn copies() -> i64 {
        let mut v: Vec<i64> = Vec::new();
        v.push(3);
        let w: Vec<i64> = v.clone();
        let u: Vec<i64> = v;
        w[0] + u[0]
    }

    struct Point { x: i64, y: i64 }

    struct Id { i: usize }

    spec fn valid(h: Id, s: &[Point]) -> bool { h.i < s.len() }

    spec fn kept(s: &[Point], t: &[Point]) -> bool {
        t.len() <= s.len() && forall|k: usize| k < t.len() ==> #[trigger] s[k] == t[k]
    }

    spec fn store_room(s: &[Point]) -> bool { s.len() < 1000 }

    spec fn added(h: Id, s: &[Point], t: &[Point], p: Point) -> bool {
        h.i == t.len() && s.len() == t.len() + 1 && s[t.len()] == p
    }

    // The handle pattern: a store that only grows keeps old handles valid.
    #[effects(pure)]
    #[uses(valid, kept, store_room, added)]
    fn add(s: &mut Vec<Point>, p: Point) -> (h: Id)
        requires store_room(s.as_slice()),
        ensures valid(h, s.as_slice()), kept(s.as_slice(), old(s).as_slice()), added(h, s.as_slice(), old(s).as_slice(), p),
    {
        let i: usize = s.len();
        s.push(p);
        Id { i: i }
    }

    #[effects(pure)]
    #[uses(valid, kept, store_room, added)]
    fn two_points() -> i64 {
        let mut s: Vec<Point> = Vec::new();
        let a: Id = add(&mut s, Point { x: 1, y: 2 });
        let b: Id = add(&mut s, Point { x: 3, y: 4 });
        s[a.i].x + s[b.i].y
    }
}
