#[summary("trait 계약: spec 메서드, 경계 호출, `&mut` 수신자의 정제 (ADR-0046 §4)")]
mod tr {
    trait Area {
        #[effects(pure)]
        fn area(self: &Self) -> (r: i64)
            requires nonneg(self.model()),
            ensures is_model(r, self.model());

        #[effects(pure)]
        fn grow(self: &mut Self) -> ()
            ensures not_less((old(self)).model(), self.model());

        spec fn model(self: &Self) -> i64;
    }

    struct Sq { s: i64 }

    impl Area for Sq {
        #[effects(pure)]
        fn area(self: &Sq) -> (r: i64)
            ensures is_model(r, self.model()),
        {
            self.s
        }

        #[effects(pure)]
        fn grow(self: &mut Sq) -> ()
            ensures not_less((old(self)).model(), self.model()),
        {
            if self.s < 1000 {
                self.s = self.s + 1;
            }
        }

        spec fn model(self: &Sq) -> i64 {
            self.s
        }
    }

    #[effects(pure)]
    fn get<T: Copy + Area>(x: T) -> (r: i64)
        requires nonneg(x.model()),
        ensures is_model(r, x.model()),
    {
        x.area()
    }

    spec fn is_model(r: i64, m: i64) -> bool {
        r == m
    }

    #[effects(pure)]
    fn known(q: Sq) -> (r: i64)
        requires nonneg(q.s),
        ensures is_model(r, q.s),
    {
        get::<Sq>(q)
    }

    spec fn nonneg(x: i64) -> bool {
        x >= 0
    }

    spec fn not_less(a: i64, b: i64) -> bool {
        a <= b
    }
}
