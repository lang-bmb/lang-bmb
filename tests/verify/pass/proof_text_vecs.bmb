#[summary("Even when a proof fn's parameter is a struct holding Vec<String>, the parameter facts (E0819) use the array of inner lengths: regression test for the defect where the outer length was used as an array and the query was ill-sorted (E0812)")]
mod proof_text_vecs {
    struct Bag { keys: Vec<String> }

    #[effects(alloc)]
    fn caller(b: &mut Bag) -> ()
        requires small(b),
    {
        proof {
            kept(b);
        }
    }

    proof fn kept(b: &Bag)
        requires small(b),
        ensures small(b),
    {}

    spec fn small(b: &Bag) -> bool {
        b.keys.len() < 10
    }
}
