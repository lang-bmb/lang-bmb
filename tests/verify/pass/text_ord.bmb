#[summary("String은 Ord다: 제네릭 정의는 정렬 위 비해석 전순서로 한 번 증명되고, String 인스턴스의 호출자는 Rust의 바이트 사전순으로 결과를 안다 (backlog 4B-04)")]
mod text_ord {
    #[effects(alloc)]
    fn caller() -> () {
        let a: String = String::from("B");
        let b: String = String::from("a");
        let c: String = String::from("ab");
        let d: String = String::from("é");
        let r0: bool = lt::<String>(&a, &b);
        assert(holds(r0));
        let r1: bool = lt::<String>(&b, &c);
        assert(holds(r1));
        let r2: bool = lt::<String>(&c, &d);
        assert(holds(r2));
        let r3: bool = lt::<String>(&b, &b);
        assert(holds(!r3));
        let r4: bool = lt::<String>(&d, &a);
        assert(holds(!r4));
    }

    spec fn holds(b: bool) -> bool {
        b
    }

    spec fn less<T: Ord>(a: &T, b: &T) -> bool {
        *a < *b
    }

    #[effects(pure)]
    fn lt<T: Ord>(a: &T, b: &T) -> (r: bool)
        ensures same(r, less::<T>(a, b)),
    {
        *a < *b
    }

    spec fn same(r: bool, b: bool) -> bool {
        r == b
    }
}
