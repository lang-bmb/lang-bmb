#[summary("Integer widening in specs (ADR-0099): arms and results have the same type when the range fits")]
mod sw {
    // A byte as a `u64` result, and a branch of the wider type.
    spec fn byte_at(msg: &[u8], i: usize) -> u64 {
        if i < msg.len() { msg[i] } else { 256 }
    }

    // The join of `u8` and `u32` branches is `u32`.
    spec fn pick(c: bool, a: u8, b: u32) -> u32 {
        if c { a } else { b }
    }

    enum Size { Small, Mid, Big }

    // A `match` joins its arms the same way.
    spec fn bound(s: Size, x: u8, k: u16) -> u32 {
        match s {
            Size::Small => x,
            Size::Mid => k,
            Size::Big => 70000,
        }
    }

    #[effects(pure)]
    fn first(msg: &[u8]) -> (r: u64)
        requires msg.len() > 0,
        ensures r == byte_at(msg, 0), r < 256,
    {
        msg[0] as u64
    }

    // A literal of a specification has up to 128 bits: above the largest
    // `i128` it keeps its value in a query, negated or not.
    #[effects(pure)]
    fn wide_literals(x: u64, y: u64) -> (r: u64)
        ensures r == x,
    {
        assert(x * 18446744073709551616 + y <= 340282366920938463463374607431768211455);
        assert(x + 170141183460469231731687303715884105728 > 170141183460469231731687303715884105727);
        assert(0 - x > -340282366920938463463374607431768211455);
        x
    }
}
