#[summary("Proofs of the ? operator: the return-point postcondition of the None·Err arms, the payload facts of the continuing arm (ADR-0049 §3)")]
mod tp {
    spec fn below(r: Option<u64>, n: u64) -> bool {
        match r {
            None => true,
            Some(v) => v <= n,
        }
    }

    #[effects(pure)]
    fn half(x: u64) -> (r: Option<u64>)
        ensures below(r, x),
    {
        if x % 2 == 0 { Some(x / 2) } else { None }
    }

    // The payload carries the callee's postcondition into the next step.
    #[effects(pure)]
    fn quarter(x: u64) -> (r: Option<u64>)
        ensures below(r, x),
    {
        let h: u64 = half(x)?;
        let q: u64 = half(h)?;
        Some(q)
    }

    spec fn code_ok(r: Result<u64, u64>) -> bool {
        match r {
            Ok(v) => v < 100,
            Err(c) => c >= 400,
        }
    }

    #[effects(pure)]
    fn status(x: u64) -> (r: Result<u64, u64>)
        ensures code_ok(r),
    {
        if x < 100 { Ok(x) } else { Err(404) }
    }

    // The `Err` path returns the operand's error: the postcondition holds
    // at the `?` with that value.
    #[effects(pure)]
    fn both(a: u64, b: u64) -> (r: Result<u64, u64>)
        ensures code_ok(r),
    {
        let x: u64 = status(a)?;
        let y: u64 = status(b)?;
        if x + y < 100 { Ok(x + y) } else { Err(413) }
    }

    // `?` inside a loop leaves the loop and the function.
    #[effects(pure)]
    fn all(a: &[u64]) -> (r: Result<u64, u64>)
        ensures code_ok(r),
    {
        let mut last: u64 = 0;
        for i in 0..a.len()
            invariant last < 100,
        {
            last = status(a[i])?;
        }
        Ok(last)
    }
}
