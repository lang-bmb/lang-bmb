#[summary("색인 술어 적용을 트리거로 쓴 존재 꼴이 같은 뜻의 원소 꼴과 서로 증명된다(백로그 T0-24, ADR-0075)")]
mod index_preds {
    spec fn hit_at(arr: &[i64], k: i64, j: usize) -> bool { j < arr.len() && arr[j] == k }

    spec fn post(arr: &[i64], k: i64, r: bool) -> bool { r == !(forall|j: usize| !#[trigger] hit_at(arr, k, j)) }

    spec fn inv(arr: &[i64], k: i64, i: usize, found: bool) -> bool { i <= arr.len() && found == !(forall|j: usize| j < i ==> !#[trigger] hit_at(arr, k, j)) }

    spec fn elem_post(arr: &[i64], k: i64, r: bool) -> bool { r == !(forall|i: usize| i < arr.len() ==> !(#[trigger] arr[i] == k)) }

    #[effects(pure)]
    #[uses(hit_at)]
    fn contains_k(arr: &[i64], k: i64) -> (r: bool)
        ensures post(arr, k, r),
    {
        let mut i: usize = 0;
        let mut found: bool = false;
        while i < arr.len()
            invariant inv(arr, k, i, found),
            decreases arr.len() - i,
        {
            if arr[i] == k {
                found = true;
            }
            i = i + 1;
        }
        found
    }

    // The index form implies the element form: the element form's witness
    // `i` has no `hit_at(arr, k, i)` term to trigger the callee's quantifier.
    #[effects(pure)]
    #[uses(hit_at)]
    fn same_meaning(arr: &[i64], k: i64) -> (r: bool)
        ensures elem_post(arr, k, r),
    {
        contains_k(arr, k)
    }

    spec fn is_odd_index(v: &[u64], i: usize) -> bool { i < v.len() && v[i] % 2 == 1 }

    spec fn odd_at_or_after(v: &[u64], i: usize) -> bool { !(forall|j: usize| i <= j ==> !#[trigger] is_odd_index(v, j)) }

    #[effects(pure)]
    fn choose_odd(v: &[u64]) -> (r: usize)
        requires odd_at_or_after(v, 0),
        ensures is_odd_index(v, r),
    {
        let mut j: usize = 0;
        while j < v.len() && v[j] % 2 != 1
            invariant j <= v.len(), odd_at_or_after(v, j),
            decreases v.len() - j,
        {
            j = j + 1;
        }
        j
    }

    spec fn has_odd(v: &[u64]) -> bool { !(forall|i: usize| i < v.len() ==> !(#[trigger] v[i] % 2 == 1)) }

    // The element form establishes the index form the callee requires.
    #[effects(pure)]
    fn pick(v: &[u64]) -> (r: usize)
        requires has_odd(v),
        ensures is_odd_index(v, r),
    {
        choose_odd(v)
    }
}
