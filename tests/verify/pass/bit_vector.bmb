#[summary("`assert(e) by (bit_vector)` 하위 증명과 비트 메서드(ADR-0048 §2·§4, backlog 2N-03): 실행 코드·proof 블록·proof fn의 하위 증명, 펼치는 spec fn, 회전·개수·바이트 뒤집기·감싸는 시프트의 계약")]
mod bvp {
    spec fn low_byte(x: u32) -> u32 { x & 0xff }

    spec fn is_low(x: u32, r: u32) -> bool { r == low_byte(x) }

    // A sub-proof in code: masking twice is masking once. The variables
    // range over their types; the enclosing proof assumes the fact.
    #[effects(pure)]
    #[uses(is_low, low_byte)]
    fn mask_twice(x: u32) -> (r: u32)
        ensures is_low(x, r),
    {
        assert((x & 0xffff) & 0xff == x & 0xff) by (bit_vector);
        (x & 0xffff) & 0xff
    }

    spec fn parity_step(x: u32, r: u32) -> bool { r & 1 == (x ^ (x >> 16)) & 1 }

    // In a `proof` block, with an antecedent written into the assertion.
    #[effects(pure)]
    #[uses(parity_step)]
    fn fold(x: u32) -> (r: u32)
        ensures parity_step(x, r),
    {
        let y: u32 = x ^ (x >> 16);
        proof {
            assert(x < 65536 ==> x ^ (x >> 16) == x) by (bit_vector);
        }
        y
    }

    spec fn swapped(a: u8, b: u8) -> bool { (a ^ b) ^ b == a }

    // A lemma proved by a sub-proof, used by its caller.
    #[uses(swapped)]
    proof fn xor_twice(a: u8, b: u8)
        ensures swapped(a, b),
    {
        assert((a ^ b) ^ b == a) by (bit_vector);
    }

    spec fn same(a: u8, r: u8) -> bool { r == a }

    #[effects(pure)]
    #[uses(same, swapped)]
    fn round_trip(a: u8, b: u8) -> (r: u8)
        ensures same(a, r),
    {
        proof {
            xor_twice(a, b);
        }
        (a ^ b) ^ b
    }

    // A spec fn unfolded by the sub-proof; its argument may leave `u8`,
    // so the fact holds under the guard that it does not.
    spec fn next(x: u8) -> u8 { x + 1 }

    #[effects(pure)]
    #[uses(next)]
    fn guarded(x: u8) -> u8 {
        assert(x < 255 ==> next(x) & 0 == 0) by (bit_vector);
        x
    }

    // Signed values and `bool` variables.
    #[effects(pure)]
    fn signs(x: i16, neg: bool) -> i16 {
        assert(neg == (x < 0) ==> (neg == ((x >> 15) == -1))) by (bit_vector);
        x
    }

    spec fn rotated(x: u32, k: u32, r: u32) -> bool { r == x.rotate_left(k) }

    #[effects(pure)]
    #[uses(rotated)]
    fn rotl(x: u32, k: u32) -> (r: u32)
        ensures rotated(x, k, r),
    {
        x.rotate_left(k)
    }

    spec fn counted(x: u64, r: u32) -> bool { r <= 64 && (r == 0) == (x == 0) }

    #[effects(pure)]
    #[uses(counted)]
    fn ones(x: u64) -> (r: u32)
        ensures counted(x, r),
    {
        x.count_ones()
    }

    spec fn below_width(x: u16, r: u32) -> bool { x != 0 ==> r < 16 }

    #[effects(pure)]
    #[uses(below_width)]
    fn lowest_set(x: u16) -> (r: u32)
        ensures below_width(x, r),
    {
        x.trailing_zeros()
    }

    // A count used as a shift amount: below the width when `x` is not 0.
    #[effects(pure)]
    fn top_bit(x: u32) -> u32 {
        if x == 0 {
            0
        } else {
            1 << (31 - x.leading_zeros())
        }
    }

    spec fn rotation(x: u32, r: u32) -> bool { r == x.rotate_right(8) }

    // Constant rotations are linear; the same rotation written as shifts
    // is equal to it over bit-vectors.
    #[effects(pure)]
    #[uses(rotation)]
    fn ror8(x: u32) -> (r: u32)
        ensures rotation(x, r),
    {
        assert((x >> 8) | (x << 24) == x.rotate_right(8)) by (bit_vector);
        (x >> 8) | (x << 24)
    }

    spec fn bswapped(x: u32, r: u32) -> bool { r == x.swap_bytes() }

    #[effects(pure)]
    #[uses(bswapped)]
    fn big_endian(x: u32) -> (r: u32)
        ensures bswapped(x, r),
    {
        x.swap_bytes()
    }

    // Wrapping shifts take the amount modulo the width: no obligation.
    #[effects(pure)]
    fn shifts(x: i8, k: u32) -> i8 {
        x.wrapping_shl(k) ^ x.wrapping_shr(k)
    }

    // The ones counts (backlog 2N-09): every bit set is the width, at 255
    // unsigned and at -1 signed.
    spec fn all_ones(x: u8, r: u32) -> bool { r <= 8 && (r == 8) == (x == 255) }

    #[effects(pure)]
    #[uses(all_ones)]
    fn ones_from_top(x: u8) -> (r: u32)
        ensures all_ones(x, r),
    {
        x.leading_ones()
    }

    spec fn low_run(x: i16, r: u32) -> bool { (r == 16) == (x == -1) }

    #[effects(pure)]
    #[uses(low_run)]
    fn low_ones(x: i16) -> (r: u32)
        ensures low_run(x, r),
    {
        x.trailing_ones()
    }

    // `reverse_bits` twice is the identity.
    spec fn mirrored(x: u32, r: u32) -> bool { r == x.reverse_bits() }

    #[effects(pure)]
    #[uses(mirrored)]
    fn mirror(x: u32) -> (r: u32)
        ensures mirrored(x, r),
    {
        assert(x.reverse_bits().reverse_bits() == x) by (bit_vector);
        x.reverse_bits()
    }

    // A bit operation's operand outside its type (specification arithmetic,
    // ADR-0022) is its two's complement image (ADR-0090): a constant shift
    // agrees with the same variable one, `!` and a rotation with their
    // masked operand.
    spec fn same_halves(x: u8, y: u8, k: u32) -> bool {
        k == 1 ==> (x + y) >> k == (x + y) >> 1
    }

    #[uses(same_halves)]
    proof fn shift_image(x: u8, y: u8, k: u32)
        ensures same_halves(x, y, k),
    {
    }

    spec fn same_not(x: u8, y: u8) -> bool {
        !(x + y) == !((x + y) & 255) && (x + y).rotate_left(1) == ((x + y) & 255).rotate_left(1)
    }

    #[uses(same_not)]
    proof fn not_image(x: u8, y: u8)
        ensures same_not(x, y),
    {
    }

    // `checked_shl` is `Some` exactly when the amount is below the width, of
    // the wrapping shift; a power of two has one bit set (backlog 2N-09b).
    spec fn shifted(x: u16, k: u32, r: Option<u16>) -> bool {
        match r {
            None => k >= 16,
            Some(v) => k < 16 && v == x.wrapping_shl(k),
        }
    }

    #[effects(pure)]
    #[uses(shifted)]
    fn try_shift(x: u16, k: u32) -> (r: Option<u16>)
        ensures shifted(x, k, r),
    {
        x.checked_shl(k)
    }

    spec fn one_bit(x: u32, r: bool) -> bool { r == (x.count_ones() == 1) && (r ==> x != 0) }

    #[effects(pure)]
    #[uses(one_bit)]
    fn single(x: u32) -> (r: bool)
        ensures one_bit(x, r),
    {
        x.is_power_of_two()
    }

    // An integer's bytes and back (backlog 2N-09c): the big-endian bytes
    // read back are the value, the first is the top byte, and a value read
    // from little-endian bytes gives them back.
    spec fn same_value(x: u32, r: u32) -> bool { r == x }

    #[effects(pure)]
    #[uses(same_value)]
    fn bytes_back(x: u32) -> (r: u32)
        ensures same_value(x, r),
    {
        u32::from_be_bytes(x.to_be_bytes())
    }

    spec fn ends(x: u32, b: [u8; 4]) -> bool { b[0] == x >> 24 && b[3] == x & 255 }

    #[effects(pure)]
    #[uses(ends)]
    fn big_end(x: u32) -> (b: [u8; 4])
        ensures ends(x, b),
    {
        x.to_be_bytes()
    }

    spec fn same_bytes(b: [u8; 2], r: i16) -> bool {
        r.to_le_bytes()[0] == b[0] && r.to_le_bytes()[1] == b[1]
    }

    #[effects(pure)]
    #[uses(same_bytes)]
    fn from_little(b: [u8; 2]) -> (r: i16)
        ensures same_bytes(b, r),
    {
        i16::from_le_bytes(b)
    }

    // Signed division and division by a variable (backlog 2N-11): Rust's
    // truncating `/` and `%`; a divisor that may be zero is an antecedent of
    // the assumed fact. A variable divisor is a divider circuit for the
    // solver: cheap at 8 bits, undecided within the limit from 32.
    #[effects(pure)]
    fn divisions(x: i32, y: i8, z: i8, u: u8, v: u8) -> i32 {
        assert(x / 2 <= x || x < 0) by (bit_vector);
        assert(x % 3 <= 0 || x > 0) by (bit_vector);
        assert(z != 0 ==> y % z == 0 || (y % z < 0) == (y < 0)) by (bit_vector);
        assert(v != 0 ==> u % v < v && u / v <= u) by (bit_vector);
        x
    }
}
