#[summary("A name bound by an arm ends with that match: even when another arm returns, a for inside an arm of a later match can use the same name as its variable (the prover used to crash)")]
mod an {
    enum K { A(Vec<u8>), B(u8) }

    #[effects(alloc)]
    fn pick(o: Option<usize>, k: &K) -> Vec<u8> {
        let mut out: Vec<u8> = Vec::new();
        let at: usize = match o {
            None => { return out; },
            Some(i) => i,
        };
        match k {
            K::A(fs) => { for i in 0..fs.len() invariant 0 <= i && i <= fs.len(), { out.push(fs[i]); } },
            K::B(q4_b) => {},
        }
        out
    }
}
