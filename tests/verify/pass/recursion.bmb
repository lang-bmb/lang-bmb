#[summary("재귀와 상호 재귀")]
mod rec {
    spec fn parity(n: u64) -> u64 { n % 2 }

    spec fn is_parity(n: u64, r: u64) -> bool { r == parity(n) }

    #[effects(pure)]
    #[uses(is_parity, parity)]
    fn even_odd(n: u64) -> (r: u64)
        ensures is_parity(n, r),
        decreases n,
    {
        if n == 0 { 0 } else { 1 - odd_even(n - 1) }
    }

    #[effects(pure)]
    #[uses(is_parity, parity)]
    fn odd_even(n: u64) -> (r: u64)
        ensures is_parity(n, r),
        decreases n,
    {
        if n == 0 { 0 } else { 1 - even_odd(n - 1) }
    }

    spec fn fib_spec(n: u64) -> u64
        decreases n,
    {
        if n < 2 { n } else { fib_spec(n - 1) + fib_spec(n - 2) }
    }
}

#[summary("forall 안의 재귀 호출: 묶인 변수마다 측도가 준다 (backlog 2V-05)")]
mod frec {
    spec fn below(n: usize) -> bool
        decreases n,
    {
        n == 0 || (forall|k: usize| k < n ==> #[trigger] below(k))
    }

    #[effects(pure)]
    #[uses(below)]
    fn base() -> bool
        ensures below(0),
    {
        true
    }
}

#[summary("forall 안의 재귀 호출과 다른 항 (backlog 2V-05, 이전 fail/unsupported)")]
mod allpos {
    spec fn all_pos(a: &[i64], n: usize) -> bool
        decreases n,
    {
        if n == 0 {
            true
        } else {
            forall|i: usize| i < n ==> #[trigger] a[i] > 0 && all_pos(a, n - 1)
        }
    }
}
