#[summary("구조체: 필드 분해 인코딩 (ADR-0027 §1, backlog 2B-05a)")]
mod geo {
    struct Point { x: i64, y: i64 }

    struct Seg { a: Point, b: Point, w: [i64; 2] }

    spec fn small(p: Point) -> bool { -1000 <= p.x && p.x <= 1000 && -1000 <= p.y && p.y <= 1000 }

    spec fn small_d(d: i64) -> bool { -1000 <= d && d <= 1000 }

    spec fn moved(p: Point, q: Point, d: i64) -> bool { q.x == p.x + d && q.y == p.y }

    spec fn same(p: Point, q: Point) -> bool { p == q }

    spec fn either(r: Point, p: Point, q: Point) -> bool { r == p || r == q }

    spec fn ends(s: Seg, p: Point, q: Point) -> bool { s.a == p && s.b == q }

    // A struct result is one SMT function per field (backlog 2B-05d).
    spec fn diag(a: i64) -> Point { Point { x: a, y: a } }

    spec fn on_diag(p: Point) -> bool { p == diag(p.x) }

    // `==` on an array field compares the elements below its length.
    spec fn same_seg(s: Seg, t: Seg) -> bool { s == t }

    impl Point {
        #[effects(pure)]
        #[uses(small)]
        fn sum(self: &Point) -> i64
            requires small(*self),
        {
            self.x + self.y
        }

        #[effects(pure)]
        #[uses(small, small_d, moved)]
        fn shift(self: &mut Point, d: i64) -> ()
            requires small(*self), small_d(d),
            ensures moved(*old(self), *self, d),
        {
            self.x = self.x + d;
        }
    }

    // A callee's `&mut` effect is its `ensures`, nothing more.
    #[effects(pure)]
    #[uses(small, small_d, moved)]
    fn twice(p: Point, d: i64) -> (r: Point)
        requires small(p), small_d(d),
        ensures moved(p, r, d + d),
    {
        let mut q: Point = p;
        Point::shift(&mut q, d);
        let mut z: Point = Point { y: q.y, x: q.x };
        z.x = z.x + d;
        z
    }

    // Nested fields: writing one leaves the others.
    #[effects(pure)]
    #[uses(ends)]
    fn reshape(p: Point, q: Point) -> (r: Seg)
        ensures ends(r, p, q),
    {
        let mut s: Seg = Seg { a: p, b: p, w: [1, 2] };
        s.b = q;
        s.a.y = s.a.y;
        s
    }

    #[effects(pure)]
    #[uses(either)]
    fn pick(c: bool, p: Point, q: Point) -> (r: Point)
        ensures either(r, p, q),
    {
        let m: Point = if c { p } else { q };
        m
    }

    // A loop that writes a field keeps only what its invariant says.
    #[effects(pure)]
    #[uses(small)]
    fn count(n: i64) -> (r: Point)
        ensures small(r),
    {
        let mut p: Point = Point { x: 0, y: 0 };
        let mut i: i64 = 0;
        while i < 10
            invariant 0 <= i, i <= 10, small(p), p.x == i, p.y == 0,
            decreases 10 - i,
        {
            p.x = p.x + 1;
            i = i + 1;
        }
        p
    }

    #[effects(pure)]
    #[uses(on_diag, diag)]
    fn square(a: i64) -> (r: Point)
        ensures on_diag(r),
    {
        Point { x: a, y: a }
    }

    #[effects(pure)]
    #[uses(same_seg)]
    fn rebuild(s: Seg) -> (r: Seg)
        ensures same_seg(s, r),
    {
        Seg { a: s.a, b: s.b, w: [s.w[0], s.w[1]] }
    }

    #[effects(pure)]
    #[uses(small)]
    fn replace(p: &mut Point) -> ()
        ensures small(*p),
    {
        *p = Point { x: 1, y: -1 };
    }
}

#[summary("다른 단위에서 전체 경로로")]
mod user {
    #[effects(pure)]
    #[uses(geo::small)]
    fn far(p: geo::Point) -> i64
        requires geo::small(p),
    {
        geo::Point::sum(&p)
    }
}

#[summary("구조체와 열거형의 배열: 지역, 필드, 반복, 복사 (backlog 2B-14)")]
mod arrs {
    struct Point { x: i64, y: i64 }

    enum Cell { Empty, Coin(i64) }

    struct Path { p: [Point; 3], n: usize }

    spec fn is(v: i64, w: i64) -> bool { v == w }

    spec fn below(i: usize, n: usize) -> bool { i < n }

    // A copy is not changed by a later write to the original.
    #[effects(pure)]
    #[uses(is)]
    fn copied() -> (r: i64)
        ensures is(r, 514),
    {
        let mut a: [Point; 2] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
        let b: [Point; 2] = a;
        a[0].x = 5;
        a[1] = Point { x: 0, y: 0 };
        b[0].x * 10 + b[1].y + a[0].x * 100 + a[1].y
    }

    // A repeat gives every element the value; the length is fixed.
    #[effects(pure)]
    #[uses(is, below)]
    fn repeated(i: usize) -> (r: i64)
        requires below(i, 4),
        ensures is(r, 7),
    {
        let z: [Point; 4] = [Point { x: 7, y: 0 }; 4];
        z[i].x + i64::try_from(z.len()).unwrap() - 4
    }

    // Elements of an enum array literal are known.
    #[effects(pure)]
    #[uses(is)]
    fn cells() -> (r: i64)
        ensures is(r, 9),
    {
        let c: [Cell; 3] = [Cell::Empty, Cell::Coin(9), Cell::Empty];
        match c[1] {
            Cell::Empty => 0,
            Cell::Coin(v) => v,
        }
    }

    // A parameter's array field has its declared length.
    #[effects(pure)]
    fn last(q: &Path) -> i64 {
        q.p[2].x
    }

    // An array field has its declared length; a whole-array assignment
    // swaps elements as read before the first write.
    #[effects(pure)]
    #[uses(is)]
    fn field(q: Path) -> (r: i64)
        ensures is(r, 3),
    {
        let mut t: Path = q;
        t.p = [Point { x: 1, y: 0 }, Point { x: 2, y: 0 }, Point { x: 3, y: 0 }];
        t.p = [t.p[2], t.p[1], t.p[0]];
        t.p[0].x + i64::try_from(t.p.len()).unwrap() - 3
    }
}
