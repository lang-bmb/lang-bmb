#[summary("Proof context of closures (ADR-0114): the spec fns of clauses written on a closure are in the default context, and the closure inherits the enclosing function's `#[uses(..)]`")]
mod cctx {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    #[uses(bounded, small)]
    fn both(k: i64) -> (r: i64)
        requires bounded(k),
        ensures r == k + k,
    {
        apply::<_>(move |x: i64| -> (y: i64) requires x < 100, x > -100, bounded(k), ensures y == x + k, { x + k }, k)
    }

    spec fn bounded(x: i64) -> bool {
        small(x)
    }

    #[effects(pure)]
    fn own(k: i64) -> (r: i64)
        requires small(k),
        ensures r == k + k,
    {
        apply::<_>(move |x: i64| -> (y: i64) requires small(x), small(k), ensures y == x + k, { x + k }, k)
    }

    spec fn small(x: i64) -> bool {
        x < 100 && x > -100
    }
}
