#[summary("Run: differential test of the UTF-8 validation library. The count of valid strings and the sum of valid_up_to over every byte string of length 1~3 and the boundary combinations of length 4. The expected output is utf8_ref.rs, which does the same enumeration with Rust str::from_utf8")]
mod app {
    struct Tally { valid: u64, sum: u64 }

    // One input: count it when all of it is well-formed, and add its valid prefix length.
    #[effects(pure)]
    fn add(t: Tally, s: &[u8]) -> Tally {
        let r: usize = std::utf8::valid_up_to(s);
        let v: u64 = if r == s.len() { 1 } else { 0 };
        Tally { valid: t.valid.saturating_add(v), sum: t.sum.saturating_add(r as u64) }
    }

    // `<length> <valid> <sum>` on one line.
    #[effects(alloc, io)]
    #[uses(std::bytes::kept)]
    fn show(len: u64, t: Tally) -> () {
        let mut out: Vec<u8> = Vec::new();
        std::bytes::push_u64(&mut out, len);
        out.push(b' ');
        std::bytes::push_u64(&mut out, t.valid);
        out.push(b' ');
        std::bytes::push_u64(&mut out, t.sum);
        out.push(b'\n');
        print_bytes(out.as_slice());
    }

    #[effects(pure)]
    fn len1() -> Tally {
        let n: usize = 256;
        let mut t: Tally = Tally { valid: 0, sum: 0 };
        let mut a: [u8; 1] = [0];
        for b0 in 0..n {
            a[0] = b0 as u8;
            t = add(t, &a);
        }
        t
    }

    #[effects(pure)]
    fn len2() -> Tally {
        let n: usize = 256;
        let mut t: Tally = Tally { valid: 0, sum: 0 };
        let mut a: [u8; 2] = [0, 0];
        for b0 in 0..n {
            for b1 in 0..n {
                a[0] = b0 as u8;
                a[1] = b1 as u8;
                t = add(t, &a);
            }
        }
        t
    }

    #[effects(pure)]
    fn len3() -> Tally {
        let n: usize = 256;
        let mut t: Tally = Tally { valid: 0, sum: 0 };
        let mut a: [u8; 3] = [0, 0, 0];
        for b0 in 0..n {
            for b1 in 0..n {
                for b2 in 0..n {
                    a[0] = b0 as u8;
                    a[1] = b1 as u8;
                    a[2] = b2 as u8;
                    t = add(t, &a);
                }
            }
        }
        t
    }

    // Four bytes: every first byte, and the edges of table 3-7 for the other three.
    #[effects(pure)]
    fn len4() -> Tally {
        let n: usize = 256;
        let m: usize = 10;
        let edge: [u8; 10] = [0, 127, 128, 143, 144, 159, 160, 191, 192, 255];
        let mut t: Tally = Tally { valid: 0, sum: 0 };
        let mut a: [u8; 4] = [0, 0, 0, 0];
        for b0 in 0..n {
            for i in 0..m {
                for j in 0..m {
                    for k in 0..m {
                        a[0] = b0 as u8;
                        a[1] = edge[i];
                        a[2] = edge[j];
                        a[3] = edge[k];
                        t = add(t, &a);
                    }
                }
            }
        }
        t
    }

    #[effects(alloc, io)]
    #[uses(std::bytes::room, std::bytes::grew_by, std::bytes::kept)]
    fn main() -> () {
        show(1, len1());
        show(2, len2());
        show(3, len3());
        show(4, len4());
    }
}
