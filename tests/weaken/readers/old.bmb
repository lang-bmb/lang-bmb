#[summary("contracts whose refinement depends on what the reader reveals")]
mod m {
    spec fn pos(x: i64) -> bool { x > 0 }

    spec fn gt0(x: i64) -> bool { x > 0 }

    spec fn big(x: i64) -> bool { x > 10 }

    spec fn mid(x: i64) -> bool { x > 5 }

    // The contracts name these (every caller reveals them, ADR-0095 A1);
    // what they wrap is revealed only by a reader's `#[uses]`.
    spec fn w_pos(x: i64) -> bool { pos(x) }

    spec fn w_gt0(x: i64) -> bool { gt0(x) }

    spec fn w_big(x: i64) -> bool { big(x) }

    spec fn w_mid(x: i64) -> bool { mid(x) }

    // `w_pos(x)` becomes `w_gt0(x)`: the same for a proof that reveals both,
    // which `dec` itself does. A caller that reveals `pos` alone, or
    // nothing, proved `pos(x)` and cannot prove `gt0(x)` from it.
    #[effects(pure)]
    #[uses(pos, gt0)]
    fn dec(x: i64) -> i64
        requires w_pos(x),
    {
        x - 1
    }

    // `w_big(x)` becomes `w_mid(x)`: weaker for a proof that reveals both.
    #[effects(pure)]
    #[uses(big, mid)]
    fn half(x: i64) -> i64
        requires w_big(x),
    {
        x / 2
    }

    // A clause goes: weaker for every reader.
    #[effects(pure)]
    #[uses(pos)]
    fn third(x: i64) -> i64
        requires w_pos(x), w_big(x),
    {
        x / 3 + 1
    }

    // `w_pos(x)` becomes `w_gt0(x)`, `pos` and `gt0` revealed by nobody: one `id` (the two
    // predicates have one body) but two symbols for every proof.
    #[effects(pure)]
    fn quarter(x: i64) -> i64
        requires w_pos(x),
    {
        x / 4
    }
}
