#[summary("a rewrite through spec fns neither version reveals")]
mod m {
    spec fn pos(x: i64) -> bool { x > 0 }

    spec fn nonneg(x: i64) -> bool { x >= 0 }

    spec fn nonzero(x: i64) -> bool { x != 0 }

    spec fn small(x: i64) -> bool { x < 100 }

    spec fn both(x: i64) -> bool { nonneg(x) && nonzero(x) }

    // `pos` written as `both`, the conjunction of `nonneg` and `nonzero`,
    // which the new version does not reveal (`both` is in its default
    // context, ADR-0095 A1, its body's predicates are not): a caller that
    // proves `pos(x)` cannot prove `both(x)` without revealing them, so the
    // comparison, which sees the spec fns as the proofs do, reports it.
    #[effects(pure)]
    #[uses(small, pos)]
    fn inc(x: i64) -> i64
        requires small(x), pos(x),
    {
        x + 1
    }
}
