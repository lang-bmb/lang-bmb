#[summary("Contracts in method syntax: a renamed spec method and its call (ADR-0051)")]
mod m {
    struct C { n: u64, cap: u64 }

    impl C {
        spec fn room(self: &C) -> bool {
            self.n < self.cap
        }

        spec fn full(self: &C) -> bool {
            self.n == self.cap
        }

        #[effects(pure)]
        #[uses(C::room)]
        fn tick(self: &mut C) -> ()
            requires self.room(),
        {
            self.n = self.n + 1;
        }

        #[effects(pure)]
        #[uses(C::full)]
        fn fill(self: &mut C) -> ()
            ensures self.full(),
        {
            self.n = self.cap;
        }

        #[effects(pure)]
        #[uses(C::room)]
        fn step(self: &mut C) -> ()
            requires self.room(),
        {
            self.tick();
        }
    }
}
