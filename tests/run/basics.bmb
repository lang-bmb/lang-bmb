#[summary("실행 예제: 정수, 나눗셈, 재귀, 배열")]
mod basics {
    spec fn small(n: i64) -> bool { 0 <= n && n <= 1000 }

    spec fn tri_bound(n: i64, r: i64) -> bool { 0 <= r && r <= 1000 * n }

    #[effects(pure)]
    #[uses(small, tri_bound)]
    fn tri(n: i64) -> (r: i64)
        requires small(n),
        ensures tri_bound(n, r),
        decreases n,
    {
        if n == 0 { 0 } else { n + tri(n - 1) }
    }

    spec fn positive(a: i64, b: i64) -> bool { a > 0 && b >= 0 }

    #[effects(pure)]
    #[uses(positive)]
    fn gcd(a: i64, b: i64) -> i64
        requires positive(a, b),
        decreases b,
    {
        if b == 0 { a } else { gcd(b, a % b) }
    }

    spec fn nonempty(a: &[i64]) -> bool { a.len() > 0 }

    #[effects(pure)]
    #[uses(nonempty)]
    fn max_of(a: &[i64]) -> i64
        requires nonempty(a),
    {
        let mut best: i64 = a[0];
        for i in 1..a.len()
            invariant i <= a.len(),
        {
            if a[i] > best {
                best = a[i];
            }
        }
        best
    }

    #[effects(pure)]
    fn fill(a: &mut [i64], v: i64) -> () {
        let mut i: usize = 0;
        while i < a.len()
            invariant i <= a.len(),
            decreases a.len() - i,
        {
            a[i] = v;
            i = i + 1;
        }
    }
}

#[summary("진입점: 결과를 한 줄씩 출력")]
mod app {
    #[effects(io)]
    #[uses(basics::small, basics::positive, basics::nonempty)]
    fn main() -> () {
        print_i64(basics::tri(10));
        print_i64(basics::gcd(48, 18));
        let a: i64 = -7;
        let b: i64 = 2;
        print_i64(a / b);
        print_i64(a % b);
        print_i64(9223372036854775807.wrapping_add(1));
        let mut xs: [i64; 3] = [3, 9, 2];
        print_i64(basics::max_of(&xs));
        basics::fill(&mut xs, -4);
        print_i64(basics::max_of(&xs));
        let flag: bool = xs[0] == -4 && xs[2] == -4;
        if flag { print_i64(1) } else { print_i64(0) }
    }
}
