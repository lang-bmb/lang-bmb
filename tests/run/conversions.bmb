#[summary("integer conversions at run time (ADR-0028, backlog 2C-02)")]
mod conv {
    #[effects(pure)]
    fn index_or_max(k: i64) -> usize {
        match usize::try_from(k).ok() {
            None => 18446744073709551615,
            Some(i) => i,
        }
    }

    #[effects(pure)]
    fn as_signed(n: u64) -> i64 {
        match i64::try_from(n).ok() {
            None => -1,
            Some(v) => v,
        }
    }

    #[effects(pure)]
    fn clamp(x: i64) -> u64 {
        if x < 0 { 0 } else { u64::try_from(x).unwrap() }
    }

    #[effects(io)]
    fn main() -> () {
        print_u64(u64::try_from(index_or_max(-3)).unwrap());
        print_u64(u64::try_from(index_or_max(42)).unwrap());
        print_i64(as_signed(18446744073709551615));
        print_i64(as_signed(9223372036854775807));
        print_u64(clamp(-7));
        print_u64(clamp(7));
        let a: [i64; 3] = [10, 20, 30];
        let k: i64 = 2;
        print_i64(a[usize::try_from(k).unwrap()]);
    }
}
