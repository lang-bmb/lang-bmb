#[summary("Names reused in disjoint scopes (ADR-0095 A3): two `for i`, `let w` in both branches, `k` and `j` in match arms")]
mod scopes {
    enum Pick { A(u64), B(u64), C }

    #[effects(alloc, io)]
    fn main() -> () {
        let mut v: Vec<u64> = Vec::new();
        v.push(4);
        let mut t: u64 = 0;
        for i in 0..3
            invariant t <= i,
        {
            t = t + 1;
        }
        for i in 0..2
            invariant t <= 3 + 2 * i,
        {
            t = t + 2;
        }
        if t > 3 {
            let w: Vec<u64> = v;
            print_u64(w.len() as u64);
        } else {
            let w: Vec<u64> = Vec::new();
            print_u64(t);
        }
        let p: Pick = Pick::B(5);
        match p {
            Pick::A(k) => { print_u64(k); },
            Pick::B(k) => { let j: u64 = k + 1; print_u64(j); },
            Pick::C => { let j: u64 = 9; print_u64(j); },
        }
    }
}
