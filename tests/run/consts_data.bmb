#[summary("배열·구조체·열거형 const(ADR-0052 §2, backlog 2V-19b): 표, 구조체, 변형, 인덱스·필드·match로 만든 상수, 명세와 실행 코드 양쪽")]
mod kd {
    struct Point { x: i64, y: i64 }

    enum Mode { Fast, Slow(u8) }

    const PRIMES: [u64; 5] = [2, 3, 5, 7, 11];
    const ORIGIN: Point = Point { x: -3, y: 4 };
    const MODES: [Mode; 2] = [Mode::Fast, Mode::Slow(9)];
    const THIRD: u64 = PRIMES[2];
    const SLOW: u8 = match MODES[1] {
        Mode::Fast => 0,
        Mode::Slow(k) => k,
    };
    const MAYBE: Option<u16> = Some(400);
    const COUNT: usize = 3;
    const ZEROS: [u8; COUNT] = [0; COUNT];
    const GRID: [[u8; 2]; 2] = [[1, 2], [3, 4]];
    const LEFT: i64 = ORIGIN.x - 1;

    #[effects(io)]
    fn main() -> () {
        print_u64(PRIMES[4]);
        print_u64(THIRD);
        print_i64(ORIGIN.x);
        print_i64(ORIGIN.y);
        print_i64(LEFT);
        print_u64(SLOW as u64);
        print_u64(maybe());
        print_u64(GRID[1][0] as u64);
        print_u64(ZEROS.len() as u64);
        print_u64(lookup(3));
        print_u64(mode_cost(MODES[0]));
        print_u64(mode_cost(MODES[1]));
        print_i64(far(ORIGIN));
    }

    #[effects(pure)]
    fn maybe() -> u64 {
        match MAYBE {
            None => 0,
            Some(v) => v as u64,
        }
    }

    #[effects(pure)]
    fn lookup(i: usize) -> (r: u64)
        requires i < 5,
        ensures r == PRIMES[i], r >= 2,
    {
        PRIMES[i]
    }

    #[effects(pure)]
    fn mode_cost(m: Mode) -> u64 {
        match m {
            Mode::Fast => 1,
            Mode::Slow(k) => k as u64,
        }
    }

    #[effects(pure)]
    fn far(p: Point) -> (r: i64)
        requires p.x == ORIGIN.x, p.y == ORIGIN.y,
        ensures r == 7,
    {
        p.y - p.x
    }
}
