#[summary("A temporary made by an else if condition dies right after the condition is evaluated: it is not dropped again in an iteration that does not enter that arm (regression test for the defect where code generation dropped the condition's temporary where the whole if ended)")]
mod eit {
    #[effects(pure)]
    fn long(s: &str) -> bool {
        s.len() > 3
    }

    #[effects(alloc, io)]
    fn main() -> () {
        let mut kept: Vec<String> = Vec::new();
        let mut i: usize = 0;
        let mut s: u64 = 0;
        while i < 12
            decreases 12 - i,
        {
            if i % 2 == 0 {
                kept.push(word(i + 1));
                s = s.wrapping_add(1);
            } else if long(word(i).as_str()) {
                s = s.wrapping_add(10);
            } else {
                s = s.wrapping_add(100);
            }
            i = i + 1;
        }
        print_u64(s);
        let mut k: usize = 0;
        while k < kept.len()
            decreases kept.len() - k,
        {
            print_str(kept[k].as_str());
            print_str("\n");
            k = k + 1;
        }
    }

    #[effects(alloc)]
    fn word(k: usize) -> String {
        if k % 3 == 1 {
            String::from("let")
        } else {
            String::from("static")
        }
    }
}
