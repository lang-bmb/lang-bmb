#[summary("run")]
mod app {
    #[effects(io, panic)]
    fn main() -> () {
        print_i64(collatz::steps(1));
        print_i64(collatz::steps(6));
        print_i64(collatz::steps(27));
        let l: collatz::Longest = collatz::longest(10000);
        print_i64(l.at);
        print_i64(l.most);
        print_i64(collatz::total(10000));
    }
}

#[summary("Collatz stopping times: an open problem behind an external body")]
mod collatz {
    struct Longest { at: i64, most: i64 }

    spec fn best(m: i64, i: i64, at: i64, most: i64) -> bool {
        1 <= i && i <= m + 1 && 1 <= at && at <= m && bounded(most)
    }

    spec fn bounded(r: i64) -> bool {
        0 <= r && r <= 261
    }

    #[effects(panic)]
    fn longest(m: i64) -> Longest
        requires upto(m),
    {
        let mut at: i64 = 1;
        let mut most: i64 = 0;
        let mut i: i64 = 1;
        while i <= m
            invariant best(m, i, at, most),
            decreases m + 1 - i,
        {
            let s: i64 = steps(i);
            if s > most {
                most = s;
                at = i;
            }
            i = i + 1;
        }
        Longest { at: at, most: most }
    }

    spec fn small(n: i64) -> bool {
        1 <= n && n <= 10000
    }

    #[rationale(kind = boundary, hash = "da34e6510158acd8", "termination of the Collatz map is an open problem; the bound was found by running every n up to 10000")]
    #[external_body]
    #[effects(panic)]
    fn steps(n: i64) -> (r: i64)
        requires small(n),
        ensures bounded(r),
    {
        let mut v: i64 = n;
        let mut k: i64 = 0;
        while v != 1
            decreases v,
        {
            if v % 2 == 0 {
                v = v / 2;
            } else {
                v = 3 * v + 1;
            }
            k = k + 1;
        }
        k
    }

    #[effects(panic)]
    fn total(m: i64) -> i64
        requires upto(m),
    {
        let mut sum: i64 = 0;
        let mut i: i64 = 1;
        while i <= m
            invariant total_so_far(m, i, sum),
            decreases m + 1 - i,
        {
            sum = sum + steps(i);
            i = i + 1;
        }
        sum
    }

    spec fn total_so_far(m: i64, i: i64, sum: i64) -> bool {
        1 <= i && i <= m + 1 && 0 <= sum && sum <= 261 * (i - 1)
    }

    spec fn upto(m: i64) -> bool {
        1 <= m && m <= 10000
    }
}
