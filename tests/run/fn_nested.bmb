#[summary("A closure inside a closure (ADR-0053): the inner closure is lowered in the round after the outer closure's body became its own `call`. The inner one captures a local of the outer body")]
mod nest {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    fn twice() -> (r: i64)
        ensures r == 8,
    {
        apply::<_>(
            |x: i64| -> (y: i64) requires x == 5, ensures y == x + 3, {
                let k: i64 = x;
                apply::<_>(move |z: i64| -> (w: i64) requires z == 3, k == 5, ensures w == z + k, { z + k }, 3)
            },
            5,
        )
    }

    #[effects(io)]
    fn main() -> () {
        print_i64(twice());
    }
}
