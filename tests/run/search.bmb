#[summary("실행 예제: 이분 탐색, 재귀, 최댓값, &mut 갱신")]
mod alg {
    spec fn is_sorted(a: &[i64]) -> bool {
        forall|i: usize, j: usize| i < j && j < a.len() ==> #[trigger] a[i] <= #[trigger] a[j]
    }

    spec fn below_target(a: &[i64], t: i64, k: usize) -> bool {
        forall|i: usize| i < k ==> #[trigger] a[i] < t
    }

    spec fn at_least_target(a: &[i64], t: i64, k: usize) -> bool {
        forall|i: usize| k <= i && i < a.len() ==> #[trigger] a[i] >= t
    }

    spec fn lower_bound(a: &[i64], t: i64, r: usize) -> bool {
        r <= a.len() && below_target(a, t, r) && at_least_target(a, t, r)
    }

    #[effects(pure)]
    #[uses(is_sorted, below_target, at_least_target, lower_bound)]
    fn lower_bound_of(a: &[i64], t: i64) -> (r: usize)
        requires is_sorted(a),
        ensures lower_bound(a, t, r),
    {
        let mut lo: usize = 0;
        let mut hi: usize = a.len();
        while lo < hi
            invariant lo <= hi, hi <= a.len(), below_target(a, t, lo), at_least_target(a, t, hi),
            decreases hi - lo,
        {
            let mid: usize = lo + (hi - lo) / 2;
            if a[mid] < t {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }

    spec fn pos(a: u64, b: u64) -> bool { a > 0 && b > 0 }

    spec fn bounded_by_input(g: u64, a: u64, b: u64) -> bool { g > 0 && (g <= a || g <= b) }

    #[effects(pure)]
    #[uses(pos, bounded_by_input)]
    fn gcd(a: u64, b: u64) -> (g: u64)
        requires pos(a, b),
        ensures bounded_by_input(g, a, b),
        decreases b,
    {
        if a % b == 0 { if b <= a { b } else { a } } else { gcd(b, a % b) }
    }

    spec fn digit_sum_bound(n: u64, r: u64) -> bool { r <= n }

    #[effects(pure)]
    #[uses(digit_sum_bound)]
    fn digit_sum(n: u64) -> (r: u64)
        ensures digit_sum_bound(n, r),
        decreases n,
    {
        if n < 10 { n } else { n % 10 + digit_sum(n / 10) }
    }

    spec fn nonempty(a: &[i64]) -> bool { a.len() > 0 }

    spec fn is_max_index(a: &[i64], r: usize) -> bool {
        r < a.len() && forall|i: usize| i < a.len() ==> #[trigger] a[i] <= a[r]
    }

    spec fn max_below(a: &[i64], k: usize, r: usize) -> bool {
        r < k && forall|i: usize| i < k ==> #[trigger] a[i] <= a[r]
    }

    #[effects(pure)]
    #[uses(nonempty, is_max_index, max_below)]
    fn max_index(a: &[i64]) -> (r: usize)
        requires nonempty(a),
        ensures is_max_index(a, r),
    {
        let mut best: usize = 0;
        let mut i: usize = 1;
        while i < a.len()
            invariant i <= a.len(), max_below(a, i, best),
            decreases a.len() - i,
        {
            if a[i] > a[best] {
                best = i;
            }
            i = i + 1;
        }
        best
    }

    spec fn same_len(a: &[i64], b: &[i64]) -> bool { a.len() == b.len() }

    spec fn incremented(a: &[i64], b: &[i64]) -> bool {
        a.len() == b.len() && forall|i: usize| i < a.len() ==> #[trigger] a[i] == b[i] + 1
    }

    spec fn incremented_below(a: &[i64], b: &[i64], k: usize) -> bool {
        forall|i: usize| i < k ==> #[trigger] a[i] == b[i] + 1
    }

    spec fn unchanged_from(a: &[i64], b: &[i64], k: usize) -> bool {
        forall|i: usize| k <= i && i < a.len() ==> #[trigger] a[i] == b[i]
    }

    spec fn all_small(a: &[i64]) -> bool {
        forall|i: usize| i < a.len() ==> #[trigger] a[i] < 1000000
    }

    #[effects(pure)]
    #[uses(incremented, incremented_below, unchanged_from, all_small, same_len)]
    fn increment_all(a: &mut [i64]) -> ()
        requires all_small(a),
        ensures incremented(a, old(a)),
    {
        let mut i: usize = 0;
        while i < a.len()
            invariant i <= a.len(), same_len(a, old(a)), incremented_below(a, old(a), i),
                unchanged_from(a, old(a), i),
            decreases a.len() - i,
        {
            a[i] = a[i] + 1;
            i = i + 1;
        }
    }
}

#[summary("진입점")]
mod app {
    spec fn printable_size(n: usize) -> bool { n <= 1000000 }

    // A size printed as `i64`: the conversion's range follows from the
    // precondition (ADR-0028 §1, E0815).
    #[effects(pure)]
    #[uses(printable_size)]
    fn show_size(n: usize) -> i64
        requires printable_size(n),
    {
        i64::try_from(n).unwrap()
    }

    #[effects(io)]
    #[uses(alg::is_sorted, alg::pos, alg::nonempty, alg::all_small, alg::lower_bound, alg::is_max_index, alg::bounded_by_input, alg::digit_sum_bound, printable_size)]
    fn main() -> () {
        let mut xs: [i64; 6] = [-5, -1, 0, 3, 3, 9];
        print_i64(show_size(alg::lower_bound_of(&xs, 3)));
        print_i64(show_size(alg::lower_bound_of(&xs, 10)));
        print_i64(show_size(alg::lower_bound_of(&xs, -100)));
        print_u64(alg::gcd(84, 36));
        print_u64(alg::digit_sum(98765));
        print_i64(show_size(alg::max_index(&xs)));
        alg::increment_all(&mut xs);
        print_i64(xs[0]);
        print_i64(xs[5]);
    }
}
