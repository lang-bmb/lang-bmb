#[summary("비트 연산과 리터럴 진법: &·|·^·!·<<·>>(부호 있는 타입의 산술 시프트), 0x·0o·0b·_, bool의 &·|·^ (ADR-0048 §2·§3, backlog 2N-02)")]
mod bits {
    spec fn amount(k: u32) -> bool {
        0 < k && k < 32
    }

    // A rotation: two shifts whose amounts are below the width.
    #[effects(pure)]
    fn rotl(x: u32, k: u32) -> u32
        requires amount(k),
    {
        (x << k) | (x >> (32 - k))
    }

    // SHA-256's small sigma 0: constant rotations and a shift.
    #[effects(pure)]
    fn sigma0(x: u32) -> u32 {
        ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3)
    }

    // The parity of a word by folding it with `^`.
    #[effects(pure)]
    fn parity(x: u32) -> u32 {
        let a: u32 = x ^ (x >> 16);
        let b: u32 = a ^ (a >> 8);
        let c: u32 = b ^ (b >> 4);
        let d: u32 = c ^ (c >> 2);
        (d ^ (d >> 1)) & 1
    }

    // Set bits, one shift per position: the amount is the loop index.
    #[effects(pure)]
    fn ones(x: u64) -> u32 {
        let mut c: u32 = 0;
        for k in 0..64
            invariant c <= k,
        {
            c = c + ((x >> k) & 1) as u32;
        }
        c
    }

    spec fn four(b: &[u8]) -> bool {
        b.len() == 4
    }

    // Four bytes, big-endian.
    #[effects(pure)]
    fn pack(b: &[u8]) -> u32
        requires four(b),
    {
        let b0: u32 = b[0] as u32;
        let b1: u32 = b[1] as u32;
        let b2: u32 = b[2] as u32;
        let b3: u32 = b[3] as u32;
        (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }

    // A byte read as `i8`: shifting left and back right is arithmetic.
    #[effects(pure)]
    fn sign_extend(b: u8) -> i32 {
        ((b as i32) << 24) >> 24
    }

    spec fn below(k: u32, w: u32) -> bool {
        k < w
    }

    #[effects(pure)]
    fn shr16(x: i16, k: u32) -> i16
        requires below(k, 16),
    {
        x >> k
    }

    #[effects(pure)]
    fn shl8(x: u8, k: u32) -> u8
        requires below(k, 8),
    {
        x << k
    }

    #[effects(io)]
    fn main() -> () {
        // Literals in four bases, with separators.
        print_u64(0xff);
        print_u64(0o777);
        print_u64(0b1010_1010);
        print_u64(1_000_000);
        print_u64(0xffff_ffff_ffff_ffff);
        print_i64(-0x80);
        // `&`, `|`, `^`, `!` on unsigned and signed values.
        let x: u32 = 0x12345678;
        print_u64((x & 0xff00) as u64);
        print_u64((x | 0xf) as u64);
        print_u64((x ^ 0xffffffff) as u64);
        print_u64(!x as u64);
        let n: i16 = -1000;
        print_i64((n & 0x7ff) as i64);
        print_i64((n | 7) as i64);
        print_i64((n ^ -1) as i64);
        print_i64(!n as i64);
        let s: i8 = 0;
        print_i64(!s as i64);
        let m: u16 = 5;
        print_u64(!m as u64);
        // Shifts: wrapping out of the width, arithmetic `>>` on signed values.
        print_u64(rotl(x, 8) as u64);
        print_u64(sigma0(x) as u64);
        print_u64(parity(x) as u64);
        print_u64(ones(0xf0f0_0000_0000_0001) as u64);
        let word: [u8; 4] = [0xde, 0xad, 0xbe, 0xef];
        print_u64(pack(&word) as u64);
        print_i64(sign_extend(0xf0) as i64);
        print_i64(sign_extend(0x7f) as i64);
        print_i64(shr16(-7, 1) as i64);
        print_i64(shr16(-32768, 15) as i64);
        print_u64(shl8(0b1011_0001, 3) as u64);
        let big: i64 = -100;
        print_i64(big >> 2);
        print_i64(big << 60);
        // `&`, `|`, `^` on `bool` evaluate both sides.
        let p: bool = x > 5;
        let q: bool = n > 5;
        if p ^ q {
            print_i64(1);
        }
        if p & q {
            print_i64(2);
        }
        if p | q {
            print_i64(3);
        }
    }
}
