#[summary("Array literal assignment: the right side reads the values before the assignment")]
mod arr {
    spec fn swapped(r: i64) -> bool { r == 1 }

    #[effects(pure)]
    fn swap_back() -> (r: i64)
        ensures swapped(r),
    {
        let mut a: [i64; 2] = [1, 2];
        a = [a[1], a[0]];
        a[1]
    }

    #[effects(pure)]
    fn rotate() -> i64 {
        let mut a: [i64; 3] = [1, 2, 3];
        a = [a[2], a[0], a[1]];
        a[0] * 100 + a[1] * 10 + a[2]
    }
}

#[summary("Entry point")]
mod app {
    #[effects(io)]
    fn main() -> () {
        print_i64(arr::swap_back());
        print_i64(arr::rotate());
    }
}
