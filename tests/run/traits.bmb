#[summary("trait: 도형 넓이의 정적 호출 (ADR-0046 §5)")]
mod tr {
    trait Shape {
        #[effects(pure)]
        fn area(self: &Self) -> i64;

        #[effects(pure)]
        fn sides(self: &Self) -> u64;
    }

    struct Sq { s: i64 }

    struct Tri { b: i64, h: i64 }

    struct Pair<A: Copy, B: Copy> { a: A, b: B }

    impl Shape for Sq {
        #[effects(pure)]
        fn area(self: &Sq) -> i64 {
            self.s.saturating_mul(self.s)
        }

        #[effects(pure)]
        fn sides(self: &Sq) -> u64 {
            4
        }
    }

    impl Shape for Tri {
        #[effects(pure)]
        fn area(self: &Tri) -> i64 {
            self.b.saturating_mul(self.h) / 2
        }

        #[effects(pure)]
        fn sides(self: &Tri) -> u64 {
            3
        }
    }

    impl<A: Copy + Shape, B: Copy + Shape> Shape for Pair<A, B> {
        #[effects(pure)]
        fn area(self: &Pair<A, B>) -> i64 {
            self.a.area().saturating_add(self.b.area())
        }

        #[effects(pure)]
        fn sides(self: &Pair<A, B>) -> u64 {
            self.a.sides().saturating_add(self.b.sides())
        }
    }

    #[effects(pure)]
    fn largest<T: Copy + Shape>(xs: &[T]) -> i64 {
        let mut best: i64 = 0;
        for i in 0..xs.len()
            invariant i <= xs.len(),
        {
            let a: i64 = xs[i].area();
            if a > best {
                best = a;
            }
        }
        best
    }

    #[effects(io)]
    fn main() -> () {
        let q: Sq = Sq { s: 3 };
        let t: Tri = Tri { b: 4, h: 5 };
        print_i64(q.area());
        print_i64(t.area());
        print_u64(t.sides());
        let p: Pair<Sq, Tri> = Pair { a: q, b: t };
        print_i64(p.area());
        print_u64(p.sides());
        let pp: Pair<Pair<Sq, Tri>, Sq> = Pair { a: p, b: Sq { s: 1 } };
        print_i64(pp.area());
        let qs: [Sq; 3] = [Sq { s: 2 }, Sq { s: 7 }, Sq { s: 5 }];
        print_i64(largest::<Sq>(&qs));
        let ts: [Tri; 2] = [Tri { b: 10, h: 1 }, Tri { b: 2, h: 2 }];
        print_i64(largest::<Tri>(&ts));
    }
}
