#[summary("정수 폭: i8·i16·i32·isize·u16·u32의 산술, 배열·Vec·필드의 제 폭 저장, 변환, MIN/MAX, 되감기·포화·검사 메서드 (ADR-0048 §1, backlog 2N-01b)")]
mod wd {
    struct Pixel {
        r: u8,
        g: u16,
        depth: i32,
        delta: i8,
    }

    spec fn small16(v: &[i16]) -> bool {
        v.len() <= 100 && (forall|k: usize| k < v.len() ==> -300 <= #[trigger] v[k] && v[k] <= 300)
    }

    // Each element stays within `i16` and the sum within `i32`.
    #[effects(pure)]
    fn sum16(v: &[i16]) -> i32
        requires small16(v),
    {
        let mut s: i32 = 0;
        for k in 0..v.len()
            invariant -300 * k <= s && s <= 300 * k,
        {
            s = s + v[k] as i32;
        }
        s
    }

    #[effects(pure)]
    fn mix(p: &Pixel) -> i64 {
        let a: i64 = p.r as i64;
        let b: i64 = p.g as i64;
        let c: i64 = p.depth as i64;
        let d: i64 = p.delta as i64;
        a + b + c + d
    }

    #[effects(alloc, io)]
    fn main() -> () {
        // Bounds and negative values of the signed types.
        let lo: i8 = i8::MIN;
        let hi: i8 = i8::MAX;
        print_i64(lo as i64);
        print_i64(hi as i64);
        let x: i16 = -12345;
        let y: i16 = x / 7;
        let z: i16 = x % 7;
        print_i64(y as i64);
        print_i64(z as i64);
        print_i64(lo.wrapping_sub(1) as i64);
        print_i64(hi.saturating_add(100) as i64);
        let c: Option<i8> = lo.checked_sub(1);
        match c {
            None => print_i64(-1),
            Some(c1) => print_i64(c1 as i64),
        }
        // Unsigned widths.
        let m: u32 = u32::MAX;
        print_u64(m as u64);
        print_u64(m.wrapping_add(2) as u64);
        let w: u16 = 65000;
        print_u64(w.saturating_add(1000) as u64);
        // Conversions between widths, with range checks.
        let big: i32 = 70000;
        let fits: Option<i16> = i16::try_from(big).ok();
        match fits {
            None => print_i64(0),
            Some(f1) => print_i64(f1 as i64),
        }
        let neg: i32 = -5;
        let as_u: Option<u32> = u32::try_from(neg).ok();
        match as_u {
            None => print_i64(0),
            Some(u1) => print_u64(u1 as u64),
        }
        let s: isize = -3;
        print_i64(s as i64);
        // Narrow elements in arrays and vectors, signed comparison.
        let a: [i16; 4] = [-300, 200, -7, 300];
        print_i64(sum16(&a) as i64);
        let mut v: Vec<i8> = Vec::new();
        v.push(-128);
        v.push(127);
        v.push(-1);
        let mut least: i8 = 0;
        for k in 0..v.len() {
            if v[k] < least {
                least = v[k];
            }
        }
        print_i64(least as i64);
        let p: Pixel = Pixel { r: 200, g: 60000, depth: -100000, delta: -5 };
        print_i64(mix(&p));
    }
}
