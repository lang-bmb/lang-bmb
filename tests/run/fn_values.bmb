#[summary("Function values (ADR-0053): a type parameter with an Fn bound, the call f(x), the contracts f.requires·f.ensures, passing function items and closures (no capture, move capture: copy·move; Fn·FnMut·FnOnce) as values (the type argument is _)")]
mod fv {
    #[effects(pure)]
    fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    fn consume<F: FnOnce(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }

    #[effects(pure)]
    fn halve(x: i64) -> (r: i64)
        requires x >= 0,
        ensures r <= x,
    {
        x / 2
    }

    #[effects(pure)]
    fn inc(x: i64) -> (r: i64)
        requires x < 1000,
        ensures r == x + 1,
    {
        x + 1
    }

    #[effects(alloc, io)]
    fn main() -> () {
        let a: i64 = apply::<_>(inc, 10);
        assert(a == 11);
        print_i64(a);
        print_i64(apply::<_>(halve, 41));
        let d: i64 = apply::<_>(|x: i64| -> (y: i64) requires x < 100 && x > -100, ensures y == x * 2, { x * 2 }, 21);
        assert(d == 42);
        print_i64(d);
        let k: i64 = 3;
        let e: i64 = apply::<_>(move |x: i64| -> (y: i64) requires k < 10 && k > -10 && x < 10 && x > -10, ensures y == x + k, { x + k }, 4);
        assert(e == 7);
        print_i64(e);
        let mut v: Vec<i64> = Vec::new();
        v.push(5);
        print_i64(apply::<_>(move |x: i64| -> i64 { if v.len() > 0 { x } else { 0 } }, 2));
        let mut count: u64 = 0;
        let m: i64 = once::<_>(move |x: i64| -> (y: i64) requires count < 100, ensures y == x, { count = count + 1; x }, 5);
        assert(m == 5);
        print_i64(m);
        let mut w: Vec<i64> = Vec::new();
        w.push(9);
        print_i64(consume::<_>(move |x: i64| -> i64 { if w.len() > 0 { x } else { 0 } }, 3));
    }

    #[effects(pure)]
    fn once<F: FnMut(i64) -> i64>(f: F, x: i64) -> (r: i64)
        requires f.requires(x),
        ensures f.ensures(x, r),
    {
        f(x)
    }
}
